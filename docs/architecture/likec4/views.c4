views {
  view index {
    title 'Agentstration system context'
    description 'Canonical C4 L1 view of the Agentstration boundary, its users, and optional external systems'

    include *
  }

  view containers of agentstration {
    title 'Agentstration containers'
    description 'Canonical C4 L2 view of authoritative hosts, client-facing shells, persistent stores, and external integrations'

    include *
    include endUser -> agentstration.workplace
    include operator -> agentstration.console
    include apiConsumer -> agentstration.server
    include agentstration.server -> aepExtensions
    include agentstration.server -> identityProvider
  }

  view serverComponents of agentstration.server {
    title 'Authoritative server components'
    description 'Canonical responsibility-oriented C4 L3 view of the authoritative server and API'

    include *
    include agentstration.server.identity -> agentstration.identityData
    include agentstration.server.resources -> agentstration.managementData
    include agentstration.server.work -> agentstration.workData
    include agentstration.server.flow -> agentstration.flowData
    include agentstration.server.runtime -> agentstration.runtimeData
    include agentstration.server.identity -> identityProvider
    include agentstration.server.resources -> aepExtensions
    include agentstration.server.runtime -> aepExtensions
    include agentstration.server.tools -> aepExtensions
  }
}
