{
  "name": "agentstration-docs",
  "version": "0.0.0-private",
  "private": true,
  "scripts": {
    "decisions:validate": "node scripts/validate-adrs.mjs",
    "architecture:validate": "likec4 validate ../architecture/likec4",
    "architecture:generate": "likec4 codegen webcomponent --webcomponent-prefix agentstration-c4 --outfile static/generated/agentstration-likec4.js ../architecture/likec4",
    "architecture:build": "npm run architecture:validate && npm run architecture:generate",
    "architecture:preview": "likec4 start ../architecture/likec4",
    "prestart": "npm run decisions:validate && npm run architecture:build",
    "start": "docusaurus start",
    "prebuild": "npm run decisions:validate && npm run architecture:build",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "@mermaid-js/layout-elk": "0.1.9",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=20.0"
  },
  "devDependencies": {
    "likec4": "1.59.4",
    "picomatch": "^4.0.7"
  }
}
