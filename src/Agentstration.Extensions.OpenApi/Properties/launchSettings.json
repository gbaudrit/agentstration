{
  "$schema": "http://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://localhost:5310",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "OpenApi__AllowedDomains__0": "example.test"
      }
    },
    "existing-instance": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://localhost:5311",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Aep__EnrollmentMode": "PairingCode",
        "Aep__PairingCode__AuthorityUrl": "http://localhost:5100",
        "Aep__PairingCode__PublicEndpoint": "http://localhost:5311",
        "Aep__PairingCode__StateFile": "../../.agentstration/slots/main/aep-pairing/openapi-standalone.json",
        "Aep__PairingCode__AllowInsecureHttp": "true",
        "OpenApi__AllowedDomains__0": "example.test"
      }
    }
  }
}
