@namespace Agentstration.Web.Components
@using Agentstration.Web.Components.Pages
@inject Microsoft.Extensions.Localization.IStringLocalizer<ExtensionStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared

<div class="extension-resource-summary" data-testid="extension-summary">
    @if (QuickActions is not null) { <ResourceQuickActions Title="@Shared["QuickActions"]" TestId="extension-quick-actions">@QuickActions</ResourceQuickActions> }
    @OperationalContent
    @if (Identity is not null) { @Identity }
    else
    {
        <ResourceIdentitySummary DisplayName="@DisplayName" TechnicalName="@(Resource?.Name ?? Item?.ExtensionId ?? string.Empty)" Namespace="@Resource?.Namespace.Value"
            Version="@KnownVersion" VersionDescription="@Localizer["ObservedVersion"]" ResourceUid="Resource?.Uid" Description="@Item?.Extension?.Extension?.Description" Labels="Resource?.Metadata.Tags" CopyFacts Collapsible="true" InitiallyCollapsed="false" TestId="extension-identity-summary">
            <Scope>@if (Resource?.ScopeRef is { } owner) { <ResourceScopeBadge ScopeRef="owner" /> }</Scope>
            <Badges><ManagedResourceBadge IsManaged="@(Resource?.Governance.IsManaged == true)" IsReadOnly="ReadOnly" /></Badges>
            <AdditionalContent>@if (Resource?.ScopeRef is { } owner) { <ExtensionManagedResourcePanel Governance="Resource.Governance" ScopeRef="owner" Namespace="Resource.Namespace" Kind="@Resource.Kind" Name="@Resource.Name" Uid="Resource.Uid" Embedded /> }</AdditionalContent>
        </ResourceIdentitySummary>
    }
    <FormSection Title="@Shared["Configuration"]" Class="resource-configuration-summary" Collapsible InitiallyCollapsed="ConfigurationInitiallyCollapsed" TestId="extension-configuration-summary">
        <CollectionView TItem="SavedSetting" Items="SavedConfiguration" IdentityLabel="@Shared["Configuration"]" InformationLabels="@(new[] { Shared["Saved"].Value })" ShowViewSwitch="ShowConfigurationViewSwitch">
            <Identity Context="setting"><strong class="configuration-key">@setting.Label</strong></Identity>
            <Information Context="setting"><CollectionValue Label="@Shared["Saved"]"><span class="configuration-value">@if (setting.Href is { } href) { <a class="text-button" href="@href" target="_blank" rel="noopener noreferrer">@setting.Value</a> } else { @setting.Value }</span></CollectionValue></Information>
        </CollectionView>
    </FormSection>
</div>

@code {
    [Parameter, EditorRequired] public Resource? Resource { get; set; }
    [Parameter] public ExtensionInventoryItemResponse? Item { get; set; }
    [Parameter] public RenderFragment? Identity { get; set; }
    [Parameter] public RenderFragment? OperationalContent { get; set; }
    [Parameter] public RenderFragment? QuickActions { get; set; }
    [Parameter] public bool ConfigurationInitiallyCollapsed { get; set; } = true;
    [Parameter] public bool ShowConfigurationViewSwitch { get; set; } = true;
    [Parameter] public bool ReadOnly { get; set; }
    private string? KnownVersion => Resource is AepEnrollmentRequestResource enrollment ? enrollment.Definition.ExtensionVersion : Item?.Version;
    private string DisplayName => Resource switch
    {
        ExtensionRegistrationResource registration => registration.Definition.DisplayName,
        AepEnrollmentRequestResource enrollment => enrollment.Definition.ExtensionName,
        _ => Item?.DisplayName ?? string.Empty
    };
    private string T(string key) => Localizer[key];
    private sealed record SavedSetting(string Label, string Value, string? Href = null);
    private IReadOnlyList<SavedSetting> SavedConfiguration
    {
        get
        {
            var registration = Resource as ExtensionRegistrationResource;
            var endpoint = registration?.Definition.Endpoint ?? (Resource as AepEnrollmentRequestResource)?.Definition.Endpoint ?? Item?.Endpoint;
            var values = new List<SavedSetting>();
            if (Item is { } item)
            {
                values.Add(new(T("ExtensionId"), item.ExtensionId));
                values.Add(new(T("ObservedVersion"), item.Version ?? "—"));
                values.Add(new(T("Availability"), T($"Status.{item.AvailabilityStatus}")));
                values.Add(new(T("Enrollment"), item.EnrollmentStatus is { } state ? T($"EnrollmentStatus.{state}") : "—"));
                if (item.AnnouncedAt is { } announced) values.Add(new(T("AnnouncedAt"), announced.LocalDateTime.ToString("g")));
            }
            if (Resource is AepEnrollmentRequestResource enrollment)
            {
                var enrollmentDefinition = enrollment.Definition;
                if (Item is null) { values.Add(new(T("ExtensionId"), enrollmentDefinition.ExtensionId)); values.Add(new(T("ObservedVersion"), enrollmentDefinition.ExtensionVersion)); }
                values.Add(new(T("EnrollmentInstance"), enrollmentDefinition.InstanceId.ToString("D")));
                values.Add(new(T("EnrollmentState"), T($"EnrollmentStatus.{enrollmentDefinition.State}")));
                values.Add(new(T("AnnouncedAt"), enrollmentDefinition.AnnouncedAt.ToLocalTime().ToString("g")));
                if (enrollmentDefinition.TargetScopeRef is { } target) values.Add(new(Shared["Scope"], target.Value));
                if (enrollmentDefinition.RegistrationName is { } name) values.Add(new(T("Registration"), name));
                if (enrollmentDefinition.Outcome is { } outcome) values.Add(new(T("Outcome"), outcome));
            }
            if (endpoint is not null) values.Add(new(T("AepEndpoint"), endpoint.AbsoluteUri, endpoint.AbsoluteUri));
            if (registration is { } saved)
            {
                values.Add(new(T("Origin"), T($"Source.{JsonNamingPolicy.CamelCase.ConvertName(saved.Definition.Source.ToString())}")));
                values.Add(new(T("Discovery"), T(saved.Definition.Enabled ? "Enabled" : "Disabled")));
                values.Add(new(T("Registration"), $"{saved.Namespace}/{saved.Name}"));
                values.Add(new(T("ExpectedExtensionId"), saved.Definition.ExpectedExtensionId ?? "—"));
                values.Add(new(T("AuthenticationMode"), T($"Authentication.{saved.Definition.AuthenticationMode}")));
                if (saved.Definition.Credential is { } credential)
                    values.Add(new(T("CredentialName"), $"{credential.ScopeRef?.Value ?? saved.ScopeRef?.Value}/{credential.Namespace ?? saved.Namespace}/{credential.Name}"));
            }
            else if (Item is { } observed)
            {
                values.Add(new(T("Origin"), T($"Source.{observed.RegistrationSource}")));
                values.Add(new(T("Discovery"), T(observed.RegistrationEnabled ? "Enabled" : "Disabled")));
            }
            return values;
        }
    }
}
