@using Agentstration.Bootstrap.Contracts
@inject Microsoft.Extensions.Localization.IStringLocalizer<BootstrapStartupStrings> Localizer

<section>
    <h2>@Localizer["Stage_" + StepId]</h2>
    <p>@Localizer["Explanation_" + StepId]</p>
    @if (Snapshot.ActiveStepId == StepId && Snapshot.Activity is { } activity)
    {
        @if (activity.WaitReason is not null) { <p class="inline-warning" role="status">@Localizer[activity.WaitReason switch { "required_model_missing" => "ModelMissing", "contribution_unavailable" => "ContributionMissing", _ => "ProviderUnavailable" }]</p> }
        <dl class="resource-details">
            @if (activity.ResourceName is not null) { <dt>@Localizer["Resource"]</dt><dd>@activity.ResourceKind / @activity.ResourceName</dd> }
            @if (activity.ProviderName is not null) { <dt>@Localizer["Provider"]</dt><dd>@activity.ProviderName</dd> }
            @if (activity.ModelName is not null) { <dt>@Localizer["ExpectedModel"]</dt><dd>@activity.ModelName</dd> }
            @if (activity.ExtensionId is not null) { <dt>@Localizer["Extension"]</dt><dd>@activity.ExtensionId</dd> }
            @if (activity.ContributionId is not null) { <dt>@Localizer["Contribution"]</dt><dd>@activity.ContributionId</dd> }
        </dl>
        @if (activity.ProviderName is { } provider)
        {
            var providerUrl = ConsoleResourceUrls.Resource("/modelproviders", provider, ResourceNamespace.Parse(activity.ProviderNamespace),
                activity.ProviderScopeRef is { } scope ? ResourceScopeRef.Parse(scope) : null);
            <a class="button-secondary" href="@providerUrl">@Localizer["OpenProvider"]</a>
        }
    }
    @if (StepId == "resources")
    {
        <dl class="resource-details"><dt>@Localizer["Created"]</dt><dd>@Snapshot.Created</dd><dt>@Localizer["Skipped"]</dt><dd>@Snapshot.Skipped</dd><dt>@Localizer["Conflicts"]</dt><dd>@Snapshot.Conflicts</dd><dt>@Localizer["ResourceFailures"]</dt><dd>@Snapshot.Failed</dd></dl>
    }
</section>

@code {
    [Parameter, EditorRequired] public BootstrapStartupSnapshot Snapshot { get; set; } = default!;
    [Parameter, EditorRequired] public string StepId { get; set; } = string.Empty;
}
