@using Agentstration.Bootstrap.Contracts
@inject Microsoft.Extensions.Localization.IStringLocalizer<BootstrapStartupStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<StepProgressStrings> StepLocalizer

<section class="startup-step-content">
    <header class="startup-step-heading">
        <h2>@(GroupTitle ?? (Kind is null ? Localizer["Stage_" + StepId].Value : FamilyLabel(Kind)))</h2>
        <StatusBadge Text="@StepLocalizer[PresentationState.ToString()]" Status="@BadgeStatus" />
    </header>
    @if (Kind is null) { <p class="startup-step-description">@Localizer["Explanation_" + StepId]</p> }
    @if (!HasResourceRows && Snapshot.ActiveStepId == StepId && Snapshot.Activity is { } activity && (GroupId is null || activity.GroupId == GroupId) && (Kind is null || Kind == activity.ResourceKind || StepId == "extensions" && Kind == "ExtensionContribution"))
    {
        <BootstrapStartupActivityDetails Activity="@activity" AttemptId="@Snapshot.AttemptId" Failed="@(Snapshot.State == "failed")" />
    }
    @if (HasResourceRows)
    {
        <BootstrapStartupResourceList Snapshot="@Snapshot" StepId="@StepId" Kind="@Kind" GroupId="@GroupId" FollowCurrent="@FollowCurrent" FollowCurrentChanged="@FollowCurrentChanged" />
    }

</section>

@code {
    [Parameter] public bool FollowCurrent { get; set; }
    [Parameter] public EventCallback<bool> FollowCurrentChanged { get; set; }
    [Parameter, EditorRequired] public BootstrapStartupSnapshot Snapshot { get; set; } = default!;
    [Parameter, EditorRequired] public string StepId { get; set; } = string.Empty;
    [Parameter] public string? Kind { get; set; }
    [Parameter] public string? GroupId { get; set; }
    [Parameter] public string? GroupTitle { get; set; }
    private bool HasResourceRows => Snapshot.Families.Any(family => family.StepId == StepId
        && (Kind is null || family.Kind == Kind) && (GroupId is null || family.GroupId == GroupId));
    private BootstrapStartupFamily? SelectedFamily => Snapshot.Families.FirstOrDefault(family => family.StepId == StepId && family.Kind == Kind && (GroupId is null || family.GroupId == GroupId));
    private string FamilyLabel(string kind)
    {
        var label = Localizer["Family_" + kind];
        return label.ResourceNotFound ? kind : label.Value;
    }
    private ProgressStepStatus PresentationState => (SelectedFamily?.State ?? Snapshot.Steps.First(step => step.Id == StepId).State) switch
    {
        "succeeded" => ProgressStepStatus.Succeeded,
        "waiting" => ProgressStepStatus.Waiting,
        "running" => ProgressStepStatus.Running,
        "failed" => ProgressStepStatus.Failed,
        "skipped" => ProgressStepStatus.Skipped,
        "blocked" => ProgressStepStatus.Interrupted,
        _ => ProgressStepStatus.Pending
    };
    private UiStatus BadgeStatus => PresentationState switch
    {
        ProgressStepStatus.Succeeded => UiStatus.Success,
        ProgressStepStatus.Failed => UiStatus.Danger,
        ProgressStepStatus.Waiting => UiStatus.Warning,
        ProgressStepStatus.Running => UiStatus.Info,
        _ => UiStatus.Neutral
    };
}
