@namespace Agentstration.Web.Components
@using System.Text.Json
@using Agentstration.Web.Components.Pages
@inject Microsoft.Extensions.Localization.IStringLocalizer<FunctionStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@using Agentstration.Functions.Contracts

<ResourceSummary TestId="transformation-function-summary">
    @if (QuickActions is not null) { <ResourceQuickActions Title="@Shared["QuickActions"]">@QuickActions</ResourceQuickActions> }
    @if (Identity is not null) { @Identity }
    else
    {
        <ResourceIdentitySummary DisplayName="@Resource.Definition.DisplayName" TechnicalName="@Resource.Name" Namespace="@Resource.Namespace.Value"
            ResourceUid="Resource.Uid" Description="@Resource.Definition.Description" Labels="Resource.Metadata.Tags" CopyFacts Collapsible="true" InitiallyCollapsed="false" TestId="transformation-function-identity-summary">
            <Scope><ResourceScopeBadge ScopeRef="Resource.ScopeRef" /></Scope>
            <Badges><ManagedResourceBadge IsManaged="Resource.Governance.IsManaged" IsReadOnly="ReadOnly" /></Badges>
            <AdditionalContent>@if (Resource.ScopeRef is { } owner) { <ExtensionManagedResourcePanel Governance="Resource.Governance" ScopeRef="owner" Namespace="Resource.Namespace" Kind="@Resource.Kind" Name="@Resource.Name" Uid="Resource.Uid" Embedded /> }</AdditionalContent>
        </ResourceIdentitySummary>
    }
    <FormSection Title="@Shared["Configuration"]" Class="resource-configuration-summary" Collapsible InitiallyCollapsed="ConfigurationInitiallyCollapsed" TestId="transformation-function-configuration-summary">
        <CollectionView TItem="ConfigurationEntry" Items="SavedConfiguration" IdentityLabel="@Shared["Configuration"]" InformationLabels="@(new[] { Shared["Saved"].Value })" ShowViewSwitch="ShowConfigurationViewSwitch"><Identity Context="entry"><strong class="configuration-key">@entry.Label</strong></Identity><Information Context="entry"><CollectionValue Label="@Shared["Saved"]"><span class="configuration-value">@entry.Value</span></CollectionValue></Information></CollectionView>
    </FormSection>
    @AdditionalContent
    @if (Resource?.Definition.Versions.Any(v => v.TransformationSnapshot is not null) == true)
    {
        <section class="panel form-section function-transformation-evidence" data-testid="function-transformation-evidence">
            <h2>@T("TransformationEvidence")</h2><p>@T("TransformationPinnedHelp")</p>
            @foreach (var item in Resource.Definition.Versions.Where(v => v.TransformationSnapshot is not null))
            {
                <details><summary>@item.Version</summary><pre>@JsonSerializer.Serialize(item.TransformationSnapshot, new JsonSerializerOptions(JsonSerializerDefaults.Web) { WriteIndented = true })</pre></details>
            }
        </section>
    }
</ResourceSummary>

@code {
    [Parameter, EditorRequired] public TransformationFunctionResource Resource { get; set; } = null!;
    [Parameter] public RenderFragment? Identity { get; set; }
    [Parameter] public RenderFragment? QuickActions { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool ConfigurationInitiallyCollapsed { get; set; } = true;
    [Parameter] public bool ShowConfigurationViewSwitch { get; set; } = true;
    private string T(string key) => Localizer[key];
    private sealed record ConfigurationEntry(string Label, string Value);
    private IReadOnlyList<ConfigurationEntry> SavedConfiguration =>  [
        new(T("Enabled"), T(Resource.Definition.Enabled ? "Enabled" : "Disabled")),
        new(T("Versions"), string.Join("\n", Resource.Definition.Versions.Select(v => $"{v.Version} · {v.FunctionKind.ScopeRef ?? Resource.ScopeRef} · {v.FunctionKind.Namespace ?? Resource.Namespace}/{v.FunctionKind.Name}@{v.FunctionKind.Version} · {v.Configuration.GetRawText()}")))];
    [Parameter] public RenderFragment? AdditionalContent { get; set; }

}
