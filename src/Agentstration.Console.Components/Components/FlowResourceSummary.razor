@namespace Agentstration.Web.Components
@using Agentstration.Web.Components.Pages
@inject Microsoft.Extensions.Localization.IStringLocalizer<FlowDetailsStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<FlowsStrings> FlowLabels
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared

<div class="flow-resource-summary" data-testid="flow-summary">
    @if (QuickActions is not null) { <ResourceQuickActions Title="@Shared["QuickActions"]" TestId="flow-quick-actions">@QuickActions</ResourceQuickActions> }
    <FormSection Title="@T("ExecutionPreview")" Class="flow-overview-preview" Collapsible>
        <Actions>@if (Resource.Definition is OrchestrationFlowDefinition orchestration) { <StatusBadge Text="@Localizer[$"Strategy.{orchestration.Strategy}"]" Status="UiStatus.Info" /> }</Actions>
        <ChildContent><FlowTopologyViewer Graph="@FlowTopologyProjector.ProjectPreview(Resource.Definition, Resource.Graph)" Title="@T("FlowTopology")" InitiallyFit="true" /></ChildContent>
    </FormSection>
    @if (Identity is not null) { @Identity }
    else
    {
    <ResourceIdentitySummary DisplayName="@(Resource.DisplayName ?? Resource.Name)" TechnicalName="@Resource.Id" Namespace="@Resource.Namespace.Value"
        Description="@Resource.Description" ResourceUid="Resource.Uid" Labels="Resource.Metadata" HeaderOwnsIdentity="HeaderOwnsIdentity" CopyFacts="@(!HeaderOwnsIdentity)" Collapsible="true" InitiallyCollapsed="HeaderOwnsIdentity"
        Version="@(HeaderOwnsIdentity ? null : EffectivePublishedVersion)" VersionDescription="@T("PublishedVersion")" TestId="flow-identity-summary">
        <Badges><ManagedResourceBadge IsManaged="Resource.Governance.IsManaged" IsReadOnly="ReadOnly" /></Badges>
        <Scope><ResourceScopeBadge ScopeRef="Resource.ScopeRef" /></Scope>
        <AdditionalContent>@if (Resource.ScopeRef is { } owner) { <ExtensionManagedResourcePanel Governance="Resource.Governance" ScopeRef="owner" Namespace="Resource.Namespace" Kind="@FlowResourceKinds.Flow" Name="@Resource.Id" Uid="Resource.Uid" Embedded /> }</AdditionalContent>
    </ResourceIdentitySummary>
    }
    <FormSection Title="@Shared["Configuration"]" Class="resource-configuration-summary" Collapsible InitiallyCollapsed="ConfigurationInitiallyCollapsed" TestId="flow-configuration-summary">
        <CollectionView TItem="SavedSetting" Items="SavedConfiguration" IdentityLabel="@Shared["Configuration"]" InformationLabels="@(new[] { Shared["Saved"].Value })" ShowViewSwitch="ShowConfigurationViewSwitch">
            <Identity Context="setting"><strong class="configuration-key">@setting.Label</strong></Identity>
            <Information Context="setting"><CollectionValue Label="@Shared["Saved"]"><span class="configuration-value">@setting.Value</span></CollectionValue></Information>
        </CollectionView>
    </FormSection>
</div>

@code {
    [Parameter, EditorRequired] public FlowResponse Resource { get; set; } = null!;
    [Parameter] public RenderFragment? QuickActions { get; set; }
    [Parameter] public RenderFragment? Identity { get; set; }
    [Parameter] public bool HeaderOwnsIdentity { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool ShowConfigurationViewSwitch { get; set; } = true;
    [Parameter] public bool ConfigurationInitiallyCollapsed { get; set; } = true;
    [Parameter] public string? PublishedVersion { get; set; }
    [Parameter] public DateTimeOffset? LastPublication { get; set; }
    [Parameter] public bool ShowLastPublication { get; set; } = true;
    private string? EffectivePublishedVersion => PublishedVersion ?? Resource.ActiveVersion;
    private string T(string key) => Localizer[key];
    private sealed record SavedSetting(string Label, string Value);
    private IReadOnlyList<SavedSetting> SavedConfiguration =>
    [
        new(T("Kind"), FlowLabels[$"Kind.{Resource.Definition.Kind}"]),
        new(Shared["Enabled"], Shared[Resource.Enabled ? "Enabled" : "Disabled"]),
        new(T("PublishedVersion"), EffectivePublishedVersion ?? "—"),
        .. ShowLastPublication ? new[] { new SavedSetting(T("LastPublication"), LastPublication?.LocalDateTime.ToString("g") ?? "—") } : []
    ];
}
