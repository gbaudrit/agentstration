@namespace Agentstration.Web.Components.Values
@implements IDisposable
@inject ISecretsClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<ContextualValueCreatorStrings> Localizer

@if (IsOpen && Context is not null)
{
    <div class="dialog-backdrop" role="presentation" @onclick="CancelAsync">
        <section class="dialog contextual-value-dialog" role="dialog" aria-modal="true" aria-labelledby="contextual-secret-title" @onclick:stopPropagation data-testid="contextual-secret-creator">
            <h2 id="contextual-secret-title">@T("Secret.Title")</h2>
            <p>@T("Secret.Help")</p>
            @if (error is not null) { <div class="form-alert form-alert-danger" role="alert">@error.Message</div> }
            <EditForm Model="model" OnValidSubmit="CreateAsync" FormName="contextual-secret-creator-form">
                <DataAnnotationsValidator /><ValidationSummary />
                <div class="form-grid">
                    <label><span>@T("Name")</span><InputText Value="model.Name" ValueChanged="NameChanged" ValueExpression="() => model.Name" data-testid="contextual-secret-name" /></label>
                    <label><span>@T("DisplayName")</span><InputText @bind-Value="model.DisplayName" data-testid="contextual-secret-display-name" /></label>
                    <label class="form-span-2"><span>@T("Description")</span><InputTextArea @bind-Value="model.Description" /></label>
                    <label><span>@T("Scope")</span><ResourceScopeBadge ScopeRef="Context.ScopeRef" /></label>
                    <label><span>@T("Vault")</span><select value="@vaultSelection" @onchange="VaultChanged" data-testid="contextual-secret-vault"><option value="">@T("SelectVault")</option>@foreach (var vault in eligibleVaults) { <option value="@VaultKey(vault.Resource)">@vault.Resource.Definition.DisplayName — @vault.Resource.ScopeRef</option> }</select></label>
                    <label><span>@T("VaultKey")</span><InputText @bind-Value="model.Key" data-testid="contextual-secret-key" /></label>
                    <label class="form-span-2"><span>@T("SecretValue")</span><input type="password" @bind="secretValue" autocomplete="new-password" spellcheck="false" data-testid="contextual-secret-value" /></label>
                </div>
                @if (eligibleVaults.Count == 0) { <p class="inline-warning">@T("NoEligibleVault")</p> }
                <p class="inline-info">@T("Secret.WriteOnly")</p>
                <div class="dialog-actions"><button type="button" class="button-secondary" @onclick="CancelAsync">@T("Cancel")</button><button type="submit" class="button-primary" disabled="@(busy || eligibleVaults.Count == 0 || string.IsNullOrEmpty(secretValue))" data-testid="contextual-secret-create">@(busy ? T("Creating") : T("CreateAndUse"))</button></div>
            </EditForm>
        </section>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public ContextualValueCreationContext? Context { get; set; }
    [Parameter] public EventCallback<ScopedResourceAddress> OnCreated { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private readonly CancellationTokenSource cancellation = new();
    private SecretEditorModel model = new();
    private IReadOnlyList<VaultResponse> eligibleVaults = [];
    private ContextualValueCreationContext? initializedContext;
    private string vaultSelection = string.Empty;
    private string? secretValue;
    private Exception? error;
    private bool busy;
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;

    protected override async Task OnParametersSetAsync()
    {
        if (!IsOpen) { initializedContext = null; return; }
        if (Context is null || ReferenceEquals(initializedContext, Context)) return;
        initializedContext = Context;
        model = new SecretEditorModel { Name = Context.SuggestedName, DisplayName = Context.SuggestedDisplayName, Description = Context.Description, Key = Context.SuggestedName };
        secretValue = null; error = null;
        try
        {
            var vaults = await Client.GetVaultsAsync(cancellation.Token);
            eligibleVaults = vaults.Where(value => CanUse(value.Resource, Context.ScopeRef)).ToArray();
            SetVault(eligibleVaults.Count == 1 ? eligibleVaults[0].Resource : null);
        }
        catch (Exception exception) { eligibleVaults = []; error = exception; }
    }

    private async Task CreateAsync()
    {
        if (Context is null || busy || string.IsNullOrEmpty(secretValue)) return;
        busy = true; error = null;
        try
        {
            if (Context.EffectiveNamespace != ResourceNamespace.Default)
                throw new ArgumentException(T("DefaultNamespaceOnly"));
            var vault = eligibleVaults.Select(value => value.Resource).SingleOrDefault(value => VaultKey(value) == vaultSelection)
                ?? throw new ArgumentException(T("SelectVault"));
            model.VaultName = vault.Name; model.VaultNamespace = vault.Namespace; model.VaultScopeRef = vault.ScopeRef;
            var snapshot = await Client.CreateSecretAsync(new(model.Name, model.Properties(Context.ScopeRef), Context.ScopeRef), cancellation.Token);
            try
            {
                await Client.SetSecretValueAsync(snapshot.Value.Name, Context.ScopeRef, secretValue, cancellation.Token);
            }
            catch (Exception exception)
            {
                throw new InvalidOperationException(T("Secret.ValueWriteFailed", snapshot.Value.Name), exception);
            }
            secretValue = null;
            await OnCreated.InvokeAsync(ScopedResourceAddress.Create(Context.ScopeRef, snapshot.Value.Namespace, snapshot.Value.Kind, snapshot.Value.Name));
        }
        catch (Exception exception) { error = exception; }
        finally { secretValue = null; busy = false; }
    }

    private void NameChanged(string value) { var previous = model.Name; model.Name = value; if (string.IsNullOrWhiteSpace(model.Key) || model.Key == previous) model.Key = value; }
    private void VaultChanged(ChangeEventArgs args) => SetVault(eligibleVaults.Select(value => value.Resource).SingleOrDefault(value => VaultKey(value) == args.Value?.ToString()));
    private void SetVault(VaultResource? vault)
    {
        vaultSelection = vault is null ? string.Empty : VaultKey(vault);
        model.VaultName = vault?.Name ?? string.Empty;
        model.VaultNamespace = vault?.Namespace;
        model.VaultScopeRef = vault?.ScopeRef;
    }
    private static string VaultKey(VaultResource vault) => $"{vault.ScopeRef!.Value.Value}|{vault.Namespace.Value}|{vault.Name}";
    private static bool CanUse(VaultResource vault, ResourceScopeRef consumer)
    {
        if (vault.ScopeRef is not { } owner) return false;
        if (owner == consumer) return true;
        if (owner.Kind >= consumer.Kind) return false;
        return vault.Definition.UsePolicy.Grants.Any(grant => grant.ScopeRef == consumer
            || grant.IncludeDescendants && grant.ScopeRef.Kind < consumer.Kind);
    }
    private Task CancelAsync() { secretValue = null; return OnCancel.InvokeAsync(); }
    public void Dispose() { secretValue = null; cancellation.Cancel(); cancellation.Dispose(); }
}
