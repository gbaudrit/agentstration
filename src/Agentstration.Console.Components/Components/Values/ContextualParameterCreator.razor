@namespace Agentstration.Web.Components.Values
@implements IDisposable
@inject IParametersClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<ContextualValueCreatorStrings> Localizer

@if (IsOpen && Context is { } creationContext)
{
    <ModalFrame IsOpen="true" TitleId="contextual-parameter-title" Class="contextual-value-dialog" Busy="@busy" OnClose="CancelAsync">
        <div data-testid="contextual-parameter-creator">
            <h2 id="contextual-parameter-title">@T("Parameter.Title")</h2>
            <p>@T("Parameter.Help")</p>
            @if (error is not null) { <div class="form-alert form-alert-danger" role="alert">@error.Message</div> }
            <EditForm Model="model" OnValidSubmit="CreateAsync" FormName="contextual-parameter-creator-form">
                <DataAnnotationsValidator /><ValidationSummary />
                <FormGrid>
                    <ResourceIdentityFields @bind-DisplayName="model.DisplayName" @bind-TechnicalName="model.Name" Policy="ResourceNamePolicy.Parameter" IsNew="true" DisplayNameTestId="contextual-parameter-display-name" TechnicalNameTestId="contextual-parameter-name" />
                    <FormField Label="@T("Description")" Class="form-span-2"><ChildContent><ClearableText UpdateOnInput="false" Multiline="true" @bind-Value="model.Description" /></ChildContent></FormField>
                    <label><span>@T("Scope")</span><ResourceScopeBadge ScopeRef="creationContext.ScopeRef" /></label>
                    <FormField Label="@T("ValueType")"><ChildContent><ClearableSelect @bind-Value="model.ValueType" disabled="@(creationContext.ValueType is not null)" data-testid="contextual-parameter-value-type">@foreach (var type in Enum.GetValues<ParameterValueType>()) { <option value="@type">@T($"ValueType.{type}")</option> }</ClearableSelect></ChildContent></FormField>
                    @if (!string.IsNullOrWhiteSpace(creationContext.Format)) { <p class="form-span-2 inline-info">@T("ExpectedFormat", creationContext.Format)</p> }
                    <FormField Label="@T("Value")" Class="form-span-2">
                        @if (creationContext.AllowedValues is { Count: > 0 } allowedValues)
                        {
                            <ClearableSelect @bind-Value="model.Value" data-testid="contextual-parameter-value">
                                @foreach (var value in allowedValues) { <option value="@EditorValue(value)">@EditorValue(value)</option> }
                            </ClearableSelect>
                        }
                        else
                        {
                            <ClearableText UpdateOnInput="false" @bind-Value="model.Value" data-testid="contextual-parameter-value" />
                        }
                    </FormField>
                </FormGrid>
                <FormActions Class="dialog-actions"><button type="button" class="button-secondary" disabled="@busy" @onclick="CancelAsync">@T("Cancel")</button><button type="submit" class="button-primary" disabled="@busy" data-testid="contextual-parameter-create">@(busy ? T("Creating") : T("CreateAndUse"))</button></FormActions>
            </EditForm>
        </div>
    </ModalFrame>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public ContextualValueCreationContext? Context { get; set; }
    [Parameter] public EventCallback<ScopedResourceAddress> OnCreated { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private readonly CancellationTokenSource cancellation = new();
    private ParameterEditorModel model = new();
    private ContextualValueCreationContext? initializedContext;
    private Exception? error;
    private bool busy;
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;

    protected override void OnParametersSet()
    {
        if (!IsOpen) { initializedContext = null; return; }
        if (Context is null || ReferenceEquals(initializedContext, Context)) return;
        initializedContext = Context;
        model = new ParameterEditorModel
        {
            Name = Context.SuggestedName,
            DisplayName = Context.SuggestedDisplayName,
            Description = Context.Description,
            ValueType = Context.ValueType ?? ParameterValueType.Text,
            Value = Context.AllowedValues is { Count: > 0 } ? EditorValue(Context.AllowedValues[0]) : string.Empty
        };
        error = null;
    }

    private async Task CreateAsync()
    {
        if (Context is null || busy) return;
        busy = true; error = null;
        try
        {
            if (Context.EffectiveNamespace != ResourceNamespace.Default)
                throw new ArgumentException(T("DefaultNamespaceOnly"));
            var snapshot = await Client.CreateParameterAsync(new(model.Name, model.Properties(), Context.ScopeRef), cancellation.Token);
            await OnCreated.InvokeAsync(ScopedResourceAddress.Create(Context.ScopeRef, snapshot.Value.Namespace, snapshot.Value.Kind, snapshot.Value.Name));
        }
        catch (Exception exception) { error = exception; }
        finally { busy = false; }
    }

    private Task CancelAsync() => OnCancel.InvokeAsync();
    private static string EditorValue(System.Text.Json.JsonElement value) => value.ValueKind == System.Text.Json.JsonValueKind.String
        ? value.GetString() ?? string.Empty
        : value.GetRawText();
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
