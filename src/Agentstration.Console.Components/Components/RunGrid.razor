@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@inject Microsoft.Extensions.Localization.IStringLocalizer<Agentstration.Web.Components.Pages.FlowRunsStrings> Localizer
<CollectionView TItem="FlowRun" Items="Runs" InformationLabels="@(new string[] { T("Started"), T("Duration"), T("Version"), T("Deployment"), T("Trigger"), T("StartedBy") })" IdentityLabel="@T("Flow")" StateLabel="@T("Status")">
        <Identity Context="run">
<CollectionIdentity DisplayName="@run.FlowId.Value" Name="@run.Id" Href="@RunUrl(run)" IconName="workflow" /></Identity>
        <Scope Context="run"><ResourceScopeBadge ScopeRef="run.ExecutionScopeRef" /></Scope>
        <State Context="run">
<StatusBadge Text="@StatusLabel(run.Status)" Status="@PlatformDashboardService.ToStatus(run.Status.ToString())" /></State>
        <Information Context="run">
            <CollectionValue Label="@T("Started")">@(run.StartedAt?.LocalDateTime.ToString("g") ?? T("Pending"))</CollectionValue>
            <CollectionValue Label="@T("Duration")">@Duration(run)</CollectionValue>
            <CollectionValue Label="@T("Version")">@run.FlowVersion</CollectionValue>
            <CollectionValue Label="@T("Deployment")">@(run.DeploymentResourceId ?? "—")</CollectionValue>
            <CollectionValue Label="@T("Trigger")">@TriggerLabel(run.Trigger)</CollectionValue>
            <CollectionValue Label="@T("StartedBy")">@(run.StartedBy ?? "—")</CollectionValue>
        </Information>
        <Actions Context="run"><CollectionActions ResourceName="@run.Id"><a href="@RunUrl(run)">@Shared["OpenItem"]</a></CollectionActions></Actions>
    </CollectionView>
@code {
    [Parameter,EditorRequired] public IReadOnlyList<FlowRun> Runs {get;set;}=[];
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string StatusLabel(FlowRunStatus value) => Localizer[$"Status.{value}"];
    private string TriggerLabel(FlowRunTrigger value) => Localizer[$"Trigger.{value}"];
    private static string ShortId(string id)=>id.Length>18?$"{id[..18]}…":id;
    private static string RunUrl(FlowRun run) => $"/flow-runs/{Uri.EscapeDataString(run.Id)}?scopeRef={Uri.EscapeDataString(run.ExecutionScopeRef.Value)}";
    private static string Duration(FlowRun run){if(run.StartedAt is null)return "—";var end=run.CompletedAt??DateTimeOffset.UtcNow;var value=end-run.StartedAt.Value;return value.TotalSeconds>=1?$"{value.TotalSeconds:0.##} s":$"{value.TotalMilliseconds:0} ms";}
}
