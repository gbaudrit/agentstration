@using System.Text.Json.Nodes
@inject Microsoft.Extensions.Localization.IStringLocalizer<SchemaDocumentEditorStrings> Localizer

<article class="schema-property-card" data-testid="schema-property-row" data-schema-depth="@Depth">
    <div class="schema-property-grid">
        <label><span>@Localizer["PropertyName"]</span><input value="@Name" disabled="@Disabled" data-testid="schema-property-name" @onchange="RenameAsync" /></label>
        <label><span>@Localizer["Type"]</span><select value="@(Text(Schema, "type", "string"))" disabled="@Disabled" data-testid="schema-property-type" @onchange="ChangeTypeAsync">@foreach (var type in Types) { <option value="@type">@type</option> }</select></label>
        <label class="schema-required"><input type="checkbox" checked="@IsRequired(ParentSchema, Name)" disabled="@Disabled" @onchange="ChangeRequiredAsync" /> <span>@Localizer["Required"]</span></label>
        <label class="schema-property-wide"><span>@Localizer["Description"]</span><input value="@(Text(Schema, "description"))" disabled="@Disabled" @onchange="@(args => SetTextAsync("description", args.Value?.ToString()))" /></label>
        <label><span>@Localizer["Default"]</span><input value="@(Raw(Schema, "default"))" disabled="@Disabled" @onchange="@(args => SetJsonAsync("default", args.Value?.ToString()))" /></label>
        <label><span>@Localizer["Enum"]</span><textarea rows="3" disabled="@Disabled" @onchange="SetEnumAsync">@EnumText(Schema)</textarea></label>
        @if (Text(Schema, "type") is "integer" or "number")
        {
            <label><span>@Localizer["Minimum"]</span><input type="number" value="@(Raw(Schema, "minimum"))" disabled="@Disabled" @onchange="@(args => SetNumberAsync("minimum", args.Value?.ToString()))" /></label>
            <label><span>@Localizer["Maximum"]</span><input type="number" value="@(Raw(Schema, "maximum"))" disabled="@Disabled" @onchange="@(args => SetNumberAsync("maximum", args.Value?.ToString()))" /></label>
        }
        @if (Text(Schema, "type") == "string")
        {
            <label><span>@Localizer["MinimumLength"]</span><input type="number" min="0" value="@(Raw(Schema, "minLength"))" disabled="@Disabled" @onchange="@(args => SetIntegerAsync("minLength", args.Value?.ToString()))" /></label>
            <label><span>@Localizer["MaximumLength"]</span><input type="number" min="0" value="@(Raw(Schema, "maxLength"))" disabled="@Disabled" @onchange="@(args => SetIntegerAsync("maxLength", args.Value?.ToString()))" /></label>
        }
    </div>

    @if (Text(Schema, "type") == "object")
    {
        <details class="schema-property-children" open>
            <summary>@Localizer["NestedProperties"]</summary>
            <div class="schema-property-children-toolbar">
                <label class="schema-additional-properties"><input type="checkbox" checked="@AdditionalProperties" disabled="@Disabled" @onchange="ChangeAdditionalPropertiesAsync" /> <span>@Localizer["AdditionalProperties"]</span></label>
                <button type="button" class="button-secondary" disabled="@Disabled" data-testid="schema-add-child-property" @onclick="AddChildAsync">@Localizer["AddChildProperty"]</button>
            </div>
            <div class="schema-property-tree">
                @if (Properties.Count == 0)
                {
                    <p class="muted">@Localizer["EmptyNestedProperties"]</p>
                }
                @foreach (var property in Properties)
                {
                    var childSchema = (JsonObject)property.Value!;
                    <SchemaPropertyNode @key="childSchema" ParentSchema="Schema" Name="@property.Key" Schema="childSchema" Depth="@(Depth + 1)" Disabled="Disabled" Changed="Changed" Error="Error" />
                }
            </div>
        </details>
    }

    <button type="button" class="text-button text-danger schema-remove-property" disabled="@Disabled" @onclick="RemoveAsync">@Localizer["Remove"]</button>
</article>

@code {
    [Parameter, EditorRequired] public JsonObject ParentSchema { get; set; } = null!;
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter, EditorRequired] public JsonObject Schema { get; set; } = null!;
    [Parameter] public int Depth { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback<string> Error { get; set; }

    private static readonly string[] Types = ["string", "integer", "number", "boolean", "object", "array"];
    private JsonObject Properties => Schema["properties"] as JsonObject ?? [];
    private bool AdditionalProperties => Schema["additionalProperties"]?.GetValue<bool>() ?? true;

    private async Task RenameAsync(ChangeEventArgs args)
    {
        var nextName = args.Value?.ToString()?.Trim();
        if (string.IsNullOrWhiteSpace(nextName))
        {
            await Error.InvokeAsync(Localizer["PropertyNameRequired"]);
            return;
        }
        if (string.Equals(nextName, Name, StringComparison.Ordinal)) return;

        var properties = EnsureProperties(ParentSchema);
        if (properties.ContainsKey(nextName))
        {
            await Error.InvokeAsync(Localizer["PropertyNameAlreadyExists", nextName]);
            return;
        }

        var required = IsRequired(ParentSchema, Name);
        properties.Remove(Name);
        properties[nextName] = Schema;
        SetRequired(ParentSchema, Name, false);
        SetRequired(ParentSchema, nextName, required);
        await NotifyChangedAsync();
    }

    private async Task ChangeTypeAsync(ChangeEventArgs args)
    {
        var type = args.Value?.ToString();
        if (!Types.Contains(type, StringComparer.Ordinal)) return;
        Schema["type"] = type;
        if (type == "object") Schema["properties"] ??= new JsonObject();
        if (type == "array") Schema["items"] ??= new JsonObject { ["type"] = "string" };
        await NotifyChangedAsync();
    }

    private async Task ChangeRequiredAsync(ChangeEventArgs args)
    {
        SetRequired(ParentSchema, Name, args.Value is true);
        await NotifyChangedAsync();
    }

    private async Task ChangeAdditionalPropertiesAsync(ChangeEventArgs args)
    {
        Schema["additionalProperties"] = args.Value is true;
        await NotifyChangedAsync();
    }

    private async Task AddChildAsync()
    {
        var properties = EnsureProperties(Schema);
        var index = 1;
        while (properties.ContainsKey($"field{index}")) index++;
        properties[$"field{index}"] = new JsonObject { ["type"] = "string" };
        await NotifyChangedAsync();
    }

    private async Task RemoveAsync()
    {
        EnsureProperties(ParentSchema).Remove(Name);
        SetRequired(ParentSchema, Name, false);
        await NotifyChangedAsync();
    }

    private async Task SetTextAsync(string keyword, string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) Schema.Remove(keyword); else Schema[keyword] = value;
        await NotifyChangedAsync();
    }

    private async Task SetJsonAsync(string keyword, string? value)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(value)) Schema.Remove(keyword); else Schema[keyword] = JsonNode.Parse(value);
            await NotifyChangedAsync();
        }
        catch (JsonException exception)
        {
            await Error.InvokeAsync(Localizer["InvalidJson", exception.Message]);
        }
    }

    private async Task SetEnumAsync(ChangeEventArgs args)
    {
        var values = (args.Value?.ToString() ?? string.Empty).Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (values.Length == 0) Schema.Remove("enum");
        else Schema["enum"] = new JsonArray(values.Select(item => (JsonNode?)JsonValue.Create(item)).ToArray());
        await NotifyChangedAsync();
    }

    private Task SetNumberAsync(string keyword, string? value) => SetNumericAsync(keyword, value, integer: false);
    private Task SetIntegerAsync(string keyword, string? value) => SetNumericAsync(keyword, value, integer: true);

    private async Task SetNumericAsync(string keyword, string? value, bool integer)
    {
        if (string.IsNullOrWhiteSpace(value)) Schema.Remove(keyword);
        else if (integer && int.TryParse(value, System.Globalization.NumberStyles.Integer,
            System.Globalization.CultureInfo.InvariantCulture, out var whole)) Schema[keyword] = whole;
        else if (!integer && decimal.TryParse(value, System.Globalization.NumberStyles.Number,
            System.Globalization.CultureInfo.InvariantCulture, out var number)) Schema[keyword] = number;
        else return;
        await NotifyChangedAsync();
    }

    private async Task NotifyChangedAsync()
    {
        await Error.InvokeAsync(string.Empty);
        await Changed.InvokeAsync();
    }

    private static JsonObject EnsureProperties(JsonObject schema)
    {
        if (schema["properties"] is JsonObject properties) return properties;
        properties = [];
        schema["type"] ??= "object";
        schema["properties"] = properties;
        return properties;
    }

    private static bool IsRequired(JsonObject parent, string name) => parent["required"] is JsonArray required
        && required.Any(item => string.Equals(item?.GetValue<string>(), name, StringComparison.Ordinal));

    private static void SetRequired(JsonObject parent, string name, bool required)
    {
        var values = parent["required"] as JsonArray ?? [];
        var existing = values.FirstOrDefault(item => string.Equals(item?.GetValue<string>(), name, StringComparison.Ordinal));
        if (required && existing is null) values.Add(name);
        if (!required && existing is not null) values.Remove(existing);
        if (values.Count == 0) parent.Remove("required"); else parent["required"] = values;
    }

    private static string? Text(JsonObject schema, string name, string? fallback = null) =>
        schema[name] is JsonValue value && value.TryGetValue<string>(out var text) ? text : fallback;
    private static string Raw(JsonObject schema, string name) => schema[name]?.ToJsonString() ?? string.Empty;
    private static string EnumText(JsonObject schema) => schema["enum"] is JsonArray values
        ? string.Join(Environment.NewLine, values.Select(value => value?.GetValue<string>())) : string.Empty;
}
