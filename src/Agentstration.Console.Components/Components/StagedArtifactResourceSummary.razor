@namespace Agentstration.Web.Components
@using Agentstration.Web.Components.Pages
@inject Microsoft.Extensions.Localization.IStringLocalizer<ArtifactsStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared

<ResourceSummary TestId="staged-artifact-summary">
    @if (QuickActions is not null) { <ResourceQuickActions Title="@Shared["QuickActions"]">@QuickActions</ResourceQuickActions> }
    @if (Identity is not null) { @Identity }
    else
    {
        <ResourceIdentitySummary DisplayName="@Resource.FileName" TechnicalName="@(Metadata?.Metadata.Name ?? Resource.ArtifactId.ToString())" Namespace="@(Metadata?.Metadata.Namespace.Value ?? ResourceNamespace.Default.Value)" ResourceUid="Metadata?.Uid"
            Version="@(Metadata?.Generation.ToString())" VersionDescription="@T("Generation")" Labels="Metadata?.Metadata.Tags" CopyFacts Collapsible="true" InitiallyCollapsed="false" TestId="staged-artifact-identity-summary">
            <Scope><ResourceScopeBadge ScopeRef="PresentationScopeRef" /></Scope>
            <Badges><ManagedResourceBadge IsManaged="@(Metadata?.Governance.IsManaged == true)" IsReadOnly="true" /></Badges>
            <AdditionalContent>@if (Metadata?.ScopeRef is { } owner) { <ExtensionManagedResourcePanel Governance="Metadata!.Governance" ScopeRef="owner" Namespace="Metadata!.Metadata.Namespace" Kind="@ArtifactResourceKinds.StagedArtifact" Name="@Metadata!.Metadata.Name" Uid="Metadata!.Uid" Embedded /> }</AdditionalContent>
        </ResourceIdentitySummary>
    }
    <FormSection Title="@Shared["Configuration"]" Class="resource-configuration-summary" Collapsible InitiallyCollapsed="ConfigurationInitiallyCollapsed" TestId="staged-artifact-configuration-summary">
        <CollectionView TItem="SavedSetting" Items="Settings" IdentityLabel="@Shared["Configuration"]" InformationLabels="@(new[] { Shared["Saved"].Value })" ShowViewSwitch="ShowConfigurationViewSwitch">
            <Identity Context="row"><strong class="configuration-key">@row.Label</strong></Identity>
            <Information Context="row"><CollectionValue Label="@Shared["Saved"]"><span class="configuration-value">@row.Value</span></CollectionValue></Information>
        </CollectionView>
    </FormSection>
    @AdditionalContent
</ResourceSummary>
@code {
    [Parameter, EditorRequired] public StagedArtifactView Resource { get; set; } = null!;
    [Parameter] public StagedArtifactSavedSummary? Metadata { get; set; }
    [Parameter] public ResourceScopeRef? PresentationScopeRef { get; set; }
    [Parameter] public RenderFragment? Identity { get; set; }
    [Parameter] public RenderFragment? QuickActions { get; set; }
    [Parameter] public RenderFragment? AdditionalContent { get; set; }
    [Parameter] public bool ConfigurationInitiallyCollapsed { get; set; } = true;
    [Parameter] public bool ShowConfigurationViewSwitch { get; set; } = true;
    private string T(string key, params object[] args) => Localizer[key, args];
    private sealed record SavedSetting(string Label, string Value);
    private IReadOnlyList<SavedSetting> Settings => [new(T("MediaType"), Resource.MediaType), new(T("Size"), T("ExactBytes", Resource.Length)), new("SHA-256", Resource.Sha256 ?? T("NotSealed")), new(T("Created"), Resource.CreatedAt.ToLocalTime().ToString("g")), new(T("ProducerId"), Resource.Producer.Id), new(T("State"), T($"Status.{Resource.Status}")), new(T("Expires"), Resource.ExpiresAt.ToLocalTime().ToString("g"))];
}
