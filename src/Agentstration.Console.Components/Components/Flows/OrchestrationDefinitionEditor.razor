@inject Microsoft.Extensions.Localization.IStringLocalizer<Agentstration.Web.Components.Pages.FlowOrchestrationEditorStrings> Localizer
<div class="orchestration-editor-grid">
    <fieldset class="orchestration-configuration" disabled="@IsReadOnly">
        <div class="orchestration-control-column">
            <section class="panel orchestration-participants-panel" data-testid="flow-participants-section">
                <div class="panel-header orchestration-section-header"><div><p class="eyebrow">@T("TeamEyebrow")</p><h2>@T("Participants")</h2><p>@T("ParticipantsHelp")</p></div><span class="selection-count">@SelectedCount(Model.ParticipantIds.Count)</span></div>
                @if (Agents.Count == 0)
                {
                    <div class="orchestration-empty"><span><UiIcon Name="agent" /></span><strong>@T("NoAgents")</strong><small>@T("NoAgentsHelp")</small></div>
                }
                else
                {
                    <FormField Label="@T("SearchAgents")" Class="agent-search"><LabelContent><UiIcon Name="search" /><span class="sr-only">@T("SearchAgents")</span></LabelContent><ChildContent><ClearableText Type="search" @bind-Value="agentSearch" placeholder="@T("SearchAgents")" /></ChildContent></FormField>
                    <div class="agent-picker">
                        @foreach (var agent in FilteredAgents)
                        {
                            var selected = Model.ParticipantIds.Contains(agent.Id, StringComparer.Ordinal);
                            <label class="agent-option @(selected ? "is-selected" : null)">
                                <span class="agent-avatar">@Initial(agent.Name)</span>
                                <span class="agent-copy"><strong>@agent.Name</strong><small><code>@agent.Id</code><span>@agent.ModelProfile</span></small></span>
                                <span class="agent-status">@agent.Status</span>
                                <FormCheckbox Value="@selected" aria-label="@agent.Name" data-testid="flow-participant" data-agent-id="@agent.Id" ValueChanged="changed => ToggleParticipant(agent.Id, new ChangeEventArgs { Value = changed })" />
                            </label>
                        }
                        @if (!FilteredAgents.Any())
                        {
                            <p class="muted agent-no-results">@T("NoMatchingAgents")</p>
                        }
                    </div>
                }

                @if (Model.ParticipantIds.Count > 0)
                {
                    <div class="participant-order-heading"><div><h3>@T("ExecutionOrder")</h3><p>@T("ExecutionOrderHelp")</p></div></div>
                    <ol class="participant-order">
                        @foreach (var participant in Model.ParticipantIds.ToArray())
                        {
                            var index = Model.ParticipantIds.IndexOf(participant);
                            <li>
                                <span class="order-index">@(index + 1)</span>
                                <span class="order-copy"><strong>@AgentName(participant)</strong><code>@participant</code></span>
                                <span class="order-actions"><button type="button" disabled="@(index == 0)" @onclick="() => Move(participant, -1)" aria-label="@T("MoveUp", participant)">↑</button><button type="button" disabled="@(index == Model.ParticipantIds.Count - 1)" @onclick="() => Move(participant, 1)" aria-label="@T("MoveDown", participant)">↓</button></span>
                            </li>
                        }
                    </ol>
                }
            </section>

            <section class="panel orchestration-strategy-panel" data-testid="flow-strategy-section">
                <div class="panel-header orchestration-section-header"><div><p class="eyebrow">@T("BehaviorEyebrow")</p><h2>@T("Strategy")</h2><p>@T("StrategyHelp")</p></div></div>
                <FormField Label="@T("StrategyMode")" Class="strategy-picker"><HelpContent>@T($"StrategyHelp.{Model.Strategy}")</HelpContent><ChildContent><ClearableSelect @bind-Value="Model.Strategy" @bind-Value:after="StrategyChanged" data-testid="flow-strategy">
                        @foreach (var strategy in Enum.GetValues<FlowOrchestrationStrategy>()) { <option value="@strategy">@Label(strategy)</option> }
                    </ClearableSelect>

                </ChildContent></FormField>

                <div class="strategy-options">
                    @switch (Model.Strategy)
                    {
                        case FlowOrchestrationStrategy.Sequential:
                            <label class="check-option"><FormCheckbox @bind-Value="Model.IncludeFullHistory" /><span><strong>@T("IncludeFullHistory")</strong><small>@T("IncludeFullHistoryHelp")</small></span></label>
                            break;
                        case FlowOrchestrationStrategy.Concurrent:
                            <p class="strategy-note"><UiIcon Name="activity" />@T("ConcurrentHelp")</p>
                            break;
                        case FlowOrchestrationStrategy.Handoff:
                            <FormField Label="@T("InitialParticipant")"><ChildContent><ClearableSelect @bind-Value="Model.InitialParticipant" data-testid="flow-initial-participant">@foreach (var id in Model.ParticipantIds) { <option value="@id">@AgentName(id)</option> }</ClearableSelect></ChildContent></FormField>
                            <div class="panel-header handoff-heading"><div><h3>@T("HandoffRoutes")</h3><p>@T("HandoffRoutesHelp")</p></div><button type="button" class="button-secondary" disabled="@(Model.ParticipantIds.Count < 2)" @onclick="AddRoute" data-testid="flow-add-route">@T("AddRoute")</button></div>
                            @for (var routeIndex = 0; routeIndex < Model.Handoffs.Count; routeIndex++)
                            {
                                var route = Model.Handoffs[routeIndex];
                                <div class="handoff-route" data-testid="flow-handoff-route" data-route-index="@routeIndex" @key="route">
                                    <ClearableSelect @bind-Value="route.From" data-testid="flow-handoff-from">@foreach (var id in Model.ParticipantIds) { <option value="@id">@AgentName(id)</option> }</ClearableSelect>
                                    <span>→</span>
                                    <ClearableSelect @bind-Value="route.To" data-testid="flow-handoff-to">@foreach (var id in Model.ParticipantIds) { <option value="@id">@AgentName(id)</option> }</ClearableSelect>
                                    <button type="button" class="button-danger" @onclick="() => Model.Handoffs.Remove(route)" aria-label="@T("DeleteRoute")" data-testid="flow-remove-route">×</button>
                                </div>
                            }
                            <label class="check-option"><FormCheckbox @bind-Value="Model.Autonomous" data-testid="flow-autonomous-handoffs" /><span><strong>@T("AutonomousHandoffs")</strong></span></label>
                            <FormField Label="@T("MaximumTurns")"><ChildContent><ClearableNumber @bind-Value="Model.MaximumTurnsPerParticipant" data-testid="flow-maximum-turns" /></ChildContent></FormField>
                            <FormField Label="@T("TerminationPhrase")"><ChildContent><ClearableText UpdateOnInput="false" @bind-Value="Model.TerminationPhrase" data-testid="flow-termination-phrase" /></ChildContent></FormField>
                            break;
                        case FlowOrchestrationStrategy.GroupChat:
                            <FormField Label="@T("MaximumIterations")"><ChildContent><ClearableNumber @bind-Value="Model.MaximumIterations" /></ChildContent></FormField>
                            break;
                        case FlowOrchestrationStrategy.Magentic:
                            <FormField Label="@T("Manager")"><ChildContent><ClearableSelect @bind-Value="Model.ManagerId"><option value="">@T("SelectAgent")</option>@foreach (var agent in AvailableManagers) { <option value="@agent.Id">@agent.Name (@agent.Id)</option> }</ClearableSelect>
                            </ChildContent></FormField>
                            <div class="form-columns"><FormField Label="@T("MaximumRounds")"><ChildContent><ClearableNumber @bind-Value="Model.MaximumRounds" /></ChildContent></FormField><FormField Label="@T("MaximumStalls")"><ChildContent><ClearableNumber @bind-Value="Model.MaximumStalls" /></ChildContent></FormField><FormField Label="@T("MaximumResets")"><ChildContent><ClearableNumber @bind-Value="Model.MaximumResets" /></ChildContent></FormField></div>
                            break;
                    }
                </div>
            </section>

        </div>
    </fieldset>
    <section class="panel orchestration-preview-panel" data-testid="flow-execution-preview">
        <div class="panel-header orchestration-preview-header"><div><h2>@T("ExecutionPreview")</h2><p>@T("ExecutionPreviewHelp")</p></div><StatusBadge Text="@Label(Model.Strategy)" Status="UiStatus.Info" /></div>
        <OrchestrationPreview Model="Model" Agents="Agents" />
    </section>
</div>

@code {
    [Parameter, EditorRequired] public OrchestrationEditorModel Model { get; set; } = null!;
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string SelectedCount(int count) => T(count == 1 ? "SelectedCount.One" : "SelectedCount.Many", count);
    [Parameter] public IReadOnlyList<AgentSummary> Agents { get; set; } = [];
    [Parameter] public bool IsReadOnly { get; set; }
    private string agentSearch = string.Empty;
    private IEnumerable<AgentSummary> FilteredAgents => string.IsNullOrWhiteSpace(agentSearch)
        ? Agents
        : Agents.Where(agent => agent.Name.Contains(agentSearch, StringComparison.OrdinalIgnoreCase) || agent.Id.Contains(agentSearch, StringComparison.OrdinalIgnoreCase));
    private IEnumerable<AgentSummary> AvailableManagers => Agents.Where(agent => !Model.ParticipantIds.Contains(agent.Id, StringComparer.Ordinal));
    private string AgentName(string id) => Agents.FirstOrDefault(agent => agent.Id == id)?.Name ?? id;
    private static string Initial(string name) => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();

    private void ToggleParticipant(string id, ChangeEventArgs eventArgs)
    {
        if (IsReadOnly) return;
        if (eventArgs.Value is true && !Model.ParticipantIds.Contains(id, StringComparer.Ordinal)) Model.ParticipantIds.Add(id);
        else if (eventArgs.Value is false) Model.ParticipantIds.Remove(id);
        Model.Handoffs.RemoveAll(route => !Model.ParticipantIds.Contains(route.From, StringComparer.Ordinal) || !Model.ParticipantIds.Contains(route.To, StringComparer.Ordinal));
        if (Model.ManagerId == id && Model.ParticipantIds.Contains(id, StringComparer.Ordinal)) Model.ManagerId = string.Empty;
        Model.EnsureStrategyDefaults();
    }

    private void Move(string id, int offset)
    {
        if (IsReadOnly) return;
        var index = Model.ParticipantIds.IndexOf(id); var target = index + offset;
        if (index < 0 || target < 0 || target >= Model.ParticipantIds.Count) return;
        Model.ParticipantIds.RemoveAt(index); Model.ParticipantIds.Insert(target, id);
    }

    private void StrategyChanged() { if (!IsReadOnly) Model.EnsureStrategyDefaults(); }
    private void AddRoute()
    {
        if (IsReadOnly) return;
        if (Model.ParticipantIds.Count >= 2) Model.Handoffs.Add(new FlowHandoffEditorRoute(Model.ParticipantIds[0], Model.ParticipantIds[1]));
    }
    private string Label(FlowOrchestrationStrategy strategy) => Localizer[$"Strategy.{strategy}"];
}
