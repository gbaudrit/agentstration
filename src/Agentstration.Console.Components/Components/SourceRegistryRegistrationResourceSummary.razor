@namespace Agentstration.Web.Components
@using Agentstration.Web.Components.Pages
@inject Microsoft.Extensions.Localization.IStringLocalizer<SourceRegistriesStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@using System.Globalization

<ResourceSummary TestId="source-registry-summary">
    @if (QuickActions is not null) { <ResourceQuickActions Title="@Shared["QuickActions"]">@QuickActions</ResourceQuickActions> }
    @if (Identity is not null) { @Identity }
    else
    {
        <ResourceIdentitySummary DisplayName="@Resource.Definition.DisplayName" TechnicalName="@Resource.Name" Namespace="@Resource.Namespace.Value"
            ResourceUid="Resource.Uid" Labels="Resource.Metadata.Tags" CopyFacts Collapsible="true" InitiallyCollapsed="false" TestId="source-registry-identity-summary">
            <Scope><ResourceScopeBadge ScopeRef="Resource.ScopeRef" /></Scope>
            <Badges><ManagedResourceBadge IsManaged="Resource.Governance.IsManaged" IsReadOnly="ReadOnly" /></Badges>
            <AdditionalContent>@if (Resource.ScopeRef is { } owner) { <ExtensionManagedResourcePanel Governance="Resource.Governance" ScopeRef="owner" Namespace="Resource.Namespace" Kind="@Resource.Kind" Name="@Resource.Name" Uid="Resource.Uid" Embedded /> }</AdditionalContent>
        </ResourceIdentitySummary>
    }
    <FormSection Title="@Shared["Configuration"]" Class="resource-configuration-summary" Collapsible InitiallyCollapsed="ConfigurationInitiallyCollapsed" TestId="source-registry-configuration-summary">
        <CollectionView TItem="Setting" Items="SavedSettings" IdentityLabel="@Shared["Configuration"]" InformationLabels="@(new[] { Shared["Saved"].Value })" ShowViewSwitch="ShowConfigurationViewSwitch"><Identity Context="row"><strong class="configuration-key">@row.Label</strong></Identity><Information Context="row"><CollectionValue Label="@Shared["Saved"]"><span class="configuration-value">@row.Value</span></CollectionValue></Information></CollectionView>
    </FormSection>
    @AdditionalContent
</ResourceSummary>

@code {
    [Parameter, EditorRequired] public SourceRegistryRegistrationResource Resource { get; set; } = null!;
    [Parameter] public RenderFragment? Identity { get; set; }
    [Parameter] public RenderFragment? QuickActions { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool ConfigurationInitiallyCollapsed { get; set; } = true;
    [Parameter] public bool ShowConfigurationViewSwitch { get; set; } = true;
    private string T(string key) => Localizer[key];
    private sealed record Setting(string Label, string Value);
    private IReadOnlyList<Setting> SavedSettings
    {
        get
        {
            var definition = Resource.Definition; var refresh = definition.RefreshPolicy;
            return [new(T("IndexUrl"), definition.IndexUrl.AbsoluteUri), new(T("Enabled"), BooleanLabel(definition.Enabled)), new(T("TrustPolicy"), TrustPolicy(definition.TrustPolicy)), new(T("Authentication"), T($"Authentication.{definition.AuthenticationMode}")), new(T("CredentialReference"), definition.Credential is { } credential ? ReferenceDisplay(credential.Name, credential.ScopeRef, credential.Namespace) : "—"), new(T("AllowHttp"), BooleanLabel(definition.EndpointPolicy.AllowHttp)), new(T("AllowPrivateNetwork"), BooleanLabel(definition.EndpointPolicy.AllowPrivateNetwork)), new(T("PeriodicRefresh"), BooleanLabel(refresh.PeriodicEnabled)), new(T("IntervalMinutes"), refresh.Interval.TotalMinutes.ToString(CultureInfo.CurrentCulture)), new(T("TimeoutSeconds"), refresh.Timeout.TotalSeconds.ToString(CultureInfo.CurrentCulture)), new(T("MaximumAttempts"), refresh.MaximumAttempts.ToString(CultureInfo.CurrentCulture)), new(T("InitialBackoffSeconds"), refresh.InitialBackoff.TotalSeconds.ToString(CultureInfo.CurrentCulture)), new(T("MaximumBackoffSeconds"), refresh.MaximumBackoff.TotalSeconds.ToString(CultureInfo.CurrentCulture)), new(T("JitterSeconds"), refresh.Jitter.TotalSeconds.ToString(CultureInfo.CurrentCulture)), new(T("StaleAfterMinutes"), refresh.StaleAfter.TotalMinutes.ToString(CultureInfo.CurrentCulture)), new(T("RetainedObservations"), definition.CachePolicy.RetainedObservations.ToString(CultureInfo.CurrentCulture))];
        }
    }
    private static string ReferenceDisplay(string name, ResourceScopeRef? scope, ResourceNamespace? ns) => $"{scope?.Value ?? "—"} · {(ns ?? ResourceNamespace.Default).Value}/{name}";
    private string TrustPolicy(SourceRegistryTrustPolicy value) => T($"TrustPolicy.{value}");
    private string BooleanLabel(bool value) => T(value ? "Yes" : "No");
    [Parameter] public RenderFragment? AdditionalContent { get; set; }

}
