@namespace Agentstration.Web.Components
@implements IDisposable
@inject IArtifactsClient Client
@inject ConsoleContextState Context
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@inject Microsoft.Extensions.Localization.IStringLocalizer<Pages.ArtifactsStrings> Localizer

<div aria-busy="@((loadState.Status == ResourceLoadStatus.Loading).ToString().ToLowerInvariant())" data-testid="staged-artifact-preview-body">
    @if (resource is null) { <ResourceLoadFeedback State="loadState" OnRetry="LoadAsync" RetryTestId="staged-artifact-preview-retry" /> }
    else
    {
        <StagedArtifactResourceSummary Resource="resource.Value" Metadata="resource" PresentationScopeRef="PresentationScope" ConfigurationInitiallyCollapsed="false" ShowConfigurationViewSwitch="false">
            <QuickActions>
                <a class="button-secondary" href="@OverviewHref" data-testid="staged-artifact-preview-open"><UiIcon Name="arrow-up-right" />@Shared["OpenItem"]</a>

            </QuickActions>
        </StagedArtifactResourceSummary>
    }
</div>

@code {
    [Parameter, EditorRequired] public ScopedResourceAddress Address { get; set; }
    [Parameter, EditorRequired] public string OverviewHref { get; set; } = string.Empty;
    private StagedArtifactSavedSummary? resource;
    private ResourceLoadState loadState = new(ResourceLoadStatus.Loading);
    private CancellationTokenSource? pending;
    private string? requestedKey;
    private long revision;
    private bool disposed;
    private string SelectionKey => $"{Context.Current?.UserId:D}|{Context.Current?.SelectedScopeRef}|{Context.Current?.WorkspaceId:D}|{(Address.ScopeRef == default ? string.Empty : Address.ScopeRef.Value)}|{Address.Namespace}|{Address.Kind}|{Address.Name}";
    private ResourceScopeRef? PresentationScope => Context.Current is { } context && context.WorkspaceId != Guid.Empty && Address.ScopeRef == ResourceScopeRef.Workspace(context.WorkspaceId)
        ? ResourceScopeRef.Parse(context.SelectedScopeRef) : Address.ScopeRef;
    protected override void OnInitialized() => Context.Changed += ContextChanged;
    private void ContextChanged() => _ = InvokeAsync(async () => { if (disposed) return; await LoadAsync(); if (!disposed) StateHasChanged(); });
    protected override Task OnParametersSetAsync() => requestedKey == SelectionKey ? Task.CompletedTask : LoadAsync();
    private async Task LoadAsync()
    {
        if (disposed) return;
        var target = Address;
        var key = requestedKey = SelectionKey;
        var requestRevision = ++revision;
        pending?.Cancel(); pending?.Dispose(); pending = new();
        var token = pending.Token;
        resource = null; loadState = new(ResourceLoadStatus.Loading);
        if (Context.Error is not null || (!Context.HasPermission(AuthorizationPermissions.ResourcesRead) || !Context.HasPermission(AuthorizationPermissions.ArtifactsInspect))) { loadState = new(ResourceLoadStatus.Forbidden); return; }
        if (target.Kind != ArtifactResourceKinds.StagedArtifact || target.ScopeRef == default || !target.Namespace.IsDefault || !Guid.TryParseExact(target.Name, "N", out _)) { loadState = new(ResourceLoadStatus.Failed); return; }
        try
        {
            var snapshot = await Client.GetStagedAtAddressAsync(target, token);
            if (!IsCurrent(requestRevision, key)) return;
            if (snapshot.ScopeRef != target.ScopeRef || snapshot.Metadata.Namespace != target.Namespace || snapshot.Metadata.Name != target.Name || snapshot.Value.ArtifactId.ToString() != target.Name)
            { loadState = new(ResourceLoadStatus.Forbidden); return; }
            resource = snapshot; loadState = new(ResourceLoadStatus.Ready) { HasContent = true };
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception error) when (error is HttpRequestException or AgentstrationApiException or OperationCanceledException)
        {
            if (!IsCurrent(requestRevision, key)) return;
            var status = error is AgentstrationApiException api ? api.StatusCode : (error as HttpRequestException)?.StatusCode;
            loadState = new(status switch
            {
                System.Net.HttpStatusCode.NotFound => ResourceLoadStatus.NotFound,
                System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden => ResourceLoadStatus.Forbidden,
                _ => ResourceLoadStatus.Failed
            }) { ErrorId = (error as AgentstrationApiException)?.ErrorId };
        }
    }
    private bool IsCurrent(long requestRevision, string key) => !disposed && revision == requestRevision && key == SelectionKey
        && Context.Error is null && Context.HasPermission(AuthorizationPermissions.ResourcesRead) && Context.HasPermission(AuthorizationPermissions.ArtifactsInspect);
    public void Dispose()
    {
        if (disposed) return;
        disposed = true; revision++; Context.Changed -= ContextChanged; pending?.Cancel(); pending?.Dispose(); GC.SuppressFinalize(this);
    }
}
