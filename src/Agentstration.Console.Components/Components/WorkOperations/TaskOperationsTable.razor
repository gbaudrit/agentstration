@using Agentstration.Work.Contracts
@inject Microsoft.Extensions.Localization.IStringLocalizer<Agentstration.Web.Components.Pages.TasksStrings> Localizer
@if (Items.Count == 0)
{
    <EmptyState Title="@EmptyTitle" Message="@EmptyMessage" />
}
else
{
    <CollectionView TItem="WorkTaskOperationsSummary" Items="Items" InformationLabels="@(new string[] { T("Interaction"), T("CurrentActivity"), T("FlowRuns"), T("Results"), T("Artifacts"), T("Updated") })" IdentityLabel="@T("Task")" ScopeLabel="@T("Workspace")" StateLabel="@T("Status")">
        <Identity Context="item">
<CollectionIdentity DisplayName="@item.Title" Name="@item.Id.ToString()" Href="@($"/tasks/{item.Id}")" IconName="tasks" />@if(!string.IsNullOrWhiteSpace(item.Description)){<small class="table-secondary">@item.Description</small>}</Identity>
        <Scope Context="item">
@ShortResource(item.WorkspaceId)</Scope>
        <State Context="item">
<TaskStatusBadge Status="item.Status" /></State>
        <Information Context="item">
            <CollectionValue Label="@T("Interaction")"><code>@ShortId(item.InteractionId)</code></CollectionValue>
            <CollectionValue Label="@T("CurrentActivity")">@(item.CurrentActivity ?? "—")@if(item.PendingActionCount > 0){<small class="attention-count">@F("PendingCount", item.PendingActionCount)</small>}</CollectionValue>
            <CollectionValue Label="@T("FlowRuns")">@item.FlowRunCount</CollectionValue>
            <CollectionValue Label="@T("Results")">@item.ResultCount</CollectionValue>
            <CollectionValue Label="@T("Artifacts")">@item.ArtifactCount</CollectionValue>
            <CollectionValue Label="@T("Updated")"><time datetime="@item.UpdatedAt.ToString("O")" title="@item.UpdatedAt.ToLocalTime().ToString("F")">@Relative(item.UpdatedAt)</time></CollectionValue>
        </Information>
        <Actions Context="item">
<CollectionActions ResourceName="@(item.Title)"><a class="text-button" href="/tasks/@item.Id">@T("Inspect")</a></CollectionActions></Actions>
    </CollectionView>
}
@code {
    [Parameter, EditorRequired] public IReadOnlyList<WorkTaskOperationsSummary> Items { get; set; } = [];
    [Parameter] public bool Filtered { get; set; }
    private string EmptyTitle => Filtered ? T("FilteredEmptyTitle") : T("EmptyTitle");
    private string EmptyMessage => Filtered ? T("FilteredEmptyMessage") : T("EmptyMessage");
    private static string ShortResource(string value) => value[(value.LastIndexOf('/') + 1)..];
    private string ShortId(Guid? value) => value is null ? T("Autonomous") : value.Value.ToString("N")[..8];
    private string Relative(DateTimeOffset value) { var elapsed = DateTimeOffset.UtcNow - value.ToUniversalTime(); return elapsed.TotalMinutes < 1 ? T("JustNow") : elapsed.TotalHours < 1 ? F("MinutesAgo", (int)elapsed.TotalMinutes) : elapsed.TotalDays < 1 ? F("HoursAgo", (int)elapsed.TotalHours) : value.ToLocalTime().ToString("d MMM yyyy"); }
    private string T(string key) => Localizer[key];
    private string F(string key, params object[] arguments) => Localizer[key, arguments];
}
