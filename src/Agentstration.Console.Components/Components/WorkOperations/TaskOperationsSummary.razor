@using Agentstration.Work.Contracts
@inject Microsoft.Extensions.Localization.IStringLocalizer<Agentstration.Web.Components.Pages.TasksStrings> Localizer
<section class="task-summary-grid" aria-label="@Localizer["TaskStatusSummary"]">
    @foreach (var item in Items)
    {
        <article class="panel task-summary-card"><span>@item.Label</span><strong>@item.Value</strong></article>
    }
</section>
@code {
    [Parameter, EditorRequired] public WorkTaskOperationsCountersResponse Summary { get; set; } = new(0, 0, 0, 0, 0);
    private IReadOnlyList<(string Label, int Value)> Items => [(Localizer["Status.Running"], Summary.Running), (Localizer["Status.ActionRequired"], Summary.ActionRequired), (Localizer["Status.Paused"], Summary.Paused), (Localizer["Status.Failed"], Summary.Failed), (Localizer["Completed24h"], Summary.CompletedRecently)];
}
