@inject Microsoft.Extensions.Localization.IStringLocalizer<Agentstration.Web.Components.Pages.TasksStrings> Localizer
<EmptyState Title="@Localizer["UnavailableTitle"]" Message="@Localizer["UnavailableMessage"]">
    <button class="button-primary" type="button" @onclick="OnRetry">@Localizer["Retry"]</button>
</EmptyState>
@code { [Parameter] public EventCallback OnRetry { get; set; } }
