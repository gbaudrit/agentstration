@rendermode InteractiveServer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedUiStrings> Localizer
<Router AppAssembly="typeof(ConsoleRouteAssembly).Assembly">
    <Found Context="routeData">
        <Agentstration.Web.Components.Bootstrap.BootstrapStartupGate>
            <RouteContent Context="ready">
                <RouteView RouteData="routeData" DefaultLayout="@(ready ? typeof(Agentstration.Web.Components.MainLayout) : typeof(Agentstration.Web.Components.Bootstrap.BootstrapStartupLayout))" />
                <FocusOnNavigate RouteData="routeData" Selector="h1" />
            </RouteContent>
        </Agentstration.Web.Components.Bootstrap.BootstrapStartupGate>
    </Found>
    <NotFound><LayoutView Layout="typeof(Agentstration.Web.Components.MainLayout)"><EmptyState Title="@Localizer["PageNotFound"]" Message="@Localizer["PageNotFoundMessage"]" /></LayoutView></NotFound>
</Router>
