@rendermode InteractiveServer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedUiStrings> Localizer
<Router AppAssembly="typeof(ConsoleRouteAssembly).Assembly">
    <Found Context="routeData"><Agentstration.Web.Components.Bootstrap.BootstrapStartupGate><RouteView RouteData="routeData" DefaultLayout="typeof(Agentstration.Web.Components.MainLayout)" /><FocusOnNavigate RouteData="routeData" Selector="h1" /></Agentstration.Web.Components.Bootstrap.BootstrapStartupGate></Found>
    <NotFound><LayoutView Layout="typeof(Agentstration.Web.Components.MainLayout)"><EmptyState Title="@Localizer["PageNotFound"]" Message="@Localizer["PageNotFoundMessage"]" /></LayoutView></NotFound>
</Router>
