@namespace Agentstration.Web.Components
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared

<div class="resource-yaml-editor">
    @if (!string.IsNullOrWhiteSpace(Error)) { <div class="form-alert form-alert-danger" role="alert">@Error</div> }
    @Feedback
    <FormField Label="@(Label ?? Shared["Yaml"])" Class="resource-yaml-field">
        <ClearableText Multiline="true" class="form-code-editor runner-json" rows="28" Value="@Value" ValueChanged="ChangeAsync"
                       ReadOnly="@(ReadOnly || !ValueChanged.HasDelegate)" Disabled="Busy" data-testid="@InputTestId" />
    </FormField>
    @if (Actions is not null) { <FormActions Busy="Busy">@Actions</FormActions> }
</div>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string? InputTestId { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; } = true;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? Feedback { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    private Task ChangeAsync(string? value) => ReadOnly || Busy || !ValueChanged.HasDelegate ? Task.CompletedTask : ValueChanged.InvokeAsync(value ?? string.Empty);
}
