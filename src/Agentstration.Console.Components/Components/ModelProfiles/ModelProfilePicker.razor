@implements IDisposable
@inject IModelProfilesClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<ModelProfilePickerStrings> Localizer

<div class="model-profile-picker">
    <label>
        <span>@T("SearchModelProfiles")</span>
        <input value="@search" @oninput="SearchChanged" placeholder="@T("SearchPlaceholder")" aria-label="@T("SearchModelProfiles")" />
    </label>
    @if (loading)
    {
        <LoadingState Message="@T("Loading")" />
    }
    else if (error is not null)
    {
        <div class="form-alert form-alert-danger" role="alert">@error.Message <button type="button" class="text-button" @onclick="LoadAsync">@T("Retry")</button></div>
    }
    else if (filtered.Count == 0)
    {
        <EmptyState Title="@T("EmptyTitle")" Message="@T("EmptyMessage")" />
    }
    else
    {
        <label>
            <span>@T("ModelProfile")</span>
            <select value="@CurrentValue" @onchange="SelectAsync" aria-label="@T("ModelProfile")" data-testid="model-profile-select">
                <option value="">@T("SelectModelProfile")</option>
                @foreach (var profile in filtered)
                {
                    <option value="@ProfileValue(profile)" disabled="@ModelManagementUi.IsInvalid(profile)">@OptionLabel(profile)</option>
                }
            </select>
        </label>
    }

    @if (Selected is not null)
    {
        <article class="model-summary-card">
            <div><p class="eyebrow">@T("SelectedModelProfile")</p><span class="resource-name-with-scope"><strong>@Selected.Properties.DisplayName</strong><ResourceScopeBadge ScopeRef="@Selected.ScopeRef" Compact /></span><code>@Selected.Namespace/@Selected.Name</code></div>
            <dl class="compact-details">
                <dt>@T("Scope")</dt><dd><code>@(Selected.ScopeRef?.Value ?? T("Scope.Unknown"))</code></dd>
                <dt>@T("Provider")</dt><dd>@(Selected.Properties.Provider.DisplayName ?? Selected.Properties.Provider.Name)</dd>
                <dt>@T("Model")</dt><dd>@Selected.Properties.Model.Name</dd>
                <dt>@T("Status")</dt><dd><StatusBadge Text="@StatusLabel(Selected.Properties.Status)" Status="@ModelManagementUi.Status(Selected.Properties.Status)" /></dd>
            </dl>
            <a class="text-button" href="@ProfileUrl(Selected)">@T("ViewModelProfile") →</a>
            @if (string.Equals(Selected.Properties.Status, "providerUnavailable", StringComparison.OrdinalIgnoreCase))
            {
                <p class="inline-warning">@T("ProviderUnavailableMessage")</p>
            }
            else if (string.Equals(Selected.Properties.Status, "modelUnavailable", StringComparison.OrdinalIgnoreCase))
            {
                <p class="inline-warning">@T("ModelUnavailableMessage")</p>
            }
        </article>
    }
    else if (!loading)
    {
        <p class="resource-hint">@T("Hint")</p>
    }
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public string Namespace { get; set; } = ResourceNamespace.Default.Value;
    [Parameter] public ResourceScopeRef? ScopeRef { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public EventCallback<ModelProfileSummaryResponse?> SelectedChanged { get; set; }
    [Parameter] public bool SelectFirstWhenMissing { get; set; }

    private readonly CancellationTokenSource cancellation = new();
    private IReadOnlyList<ModelProfileSummaryResponse> profiles = [];
    private IReadOnlyList<ModelProfileSummaryResponse> filtered = [];
    private AgentstrationApiException? error;
    private string search = string.Empty;
    private bool loading;
    private string CurrentValue => Selected is { } selected ? ProfileValue(selected) : string.Empty;
    private ModelProfileSummaryResponse? Selected
    {
        get
        {
            var matches = profiles.Where(item =>
                string.Equals(item.Name, Value, StringComparison.OrdinalIgnoreCase)
                && string.Equals(item.Namespace, ResourceNamespace.Parse(Namespace).Value, StringComparison.Ordinal)
                && (ScopeRef is null || item.ScopeRef == ScopeRef)).ToArray();
            return matches.Length == 1 ? matches[0] : null;
        }
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            profiles = await Client.GetModelProfilesAsync(null, null, null, cancellation.Token);
            ApplyFilter();
            var selected = Selected;
            if (selected is null && SelectFirstWhenMissing)
            {
                selected = profiles.FirstOrDefault(profile => !ModelManagementUi.IsInvalid(profile));
                if (selected is not null) await ValueChanged.InvokeAsync(selected.Name);
            }
            await SelectedChanged.InvokeAsync(selected);
        }
        catch (AgentstrationApiException exception) { error = exception; }
        finally { loading = false; }
    }

    private void SearchChanged(ChangeEventArgs args)
    {
        search = args.Value?.ToString() ?? string.Empty;
        ApplyFilter();
    }

    private void ApplyFilter() => filtered = ModelManagementUi.FilterProfiles(profiles, search);

    private async Task SelectAsync(ChangeEventArgs args)
    {
        var value = args.Value?.ToString() ?? string.Empty;
        var selected = profiles.FirstOrDefault(item => string.Equals(ProfileValue(item), value, StringComparison.Ordinal));
        if (selected is not null && ModelManagementUi.IsInvalid(selected)) return;
        await ValueChanged.InvokeAsync(selected?.Name ?? string.Empty);
        await SelectedChanged.InvokeAsync(selected);
    }

    private string T(string key) => Localizer[key];
    private string StatusLabel(string? status) { var key = $"Status.{status ?? "unknown"}"; var localized = Localizer[key]; return localized.ResourceNotFound ? ModelManagementUi.Label(status) : localized.Value; }
    private string OptionLabel(ModelProfileSummaryResponse item) =>
        $"{item.Properties.DisplayName} — {ScopeLabel(item)} · {item.Namespace}/{item.Name} · {item.Properties.Provider.Name} / {item.Properties.Model.Name} · {StatusLabel(item.Properties.Status)}";

    private string ScopeLabel(ModelProfileSummaryResponse item) =>
        item.ScopeRef is null ? T("Scope.Unknown") : T($"Scope.{item.ScopeRef.Value.Kind}");

    private static string ProfileValue(ModelProfileSummaryResponse item) =>
        $"{item.ScopeRef?.Value ?? string.Empty}|{item.Namespace}|{item.Name}";

    private static string ProfileUrl(ModelProfileSummaryResponse item) =>
        ConsoleResourceUrls.ModelProfile(ResourceAddress.Create(ResourceNamespace.Parse(item.Namespace), ModelResourceKinds.ModelProfile, item.Name), item.ScopeRef);

    public void Dispose()
    {
        cancellation.Cancel();
        cancellation.Dispose();
    }
}
