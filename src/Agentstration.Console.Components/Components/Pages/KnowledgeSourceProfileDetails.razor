@page "/knowledge-source-profiles/{Name}"
@implements IDisposable
@inject IKnowledgeSourceProfilesClient Client
@inject IFlowApiClient Flows
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<KnowledgeSourceProfilesStrings> Localizer

<PageTitle>@(profile?.Definition.DisplayName ?? Name) · Agentstration</PageTitle>
<PageHeader Title="@(profile?.Definition.DisplayName ?? Name)" Description="@(profile?.Definition.Description ?? T("DetailsHelp"))" TestId="knowledge-source-profile-details">
    <Actions>@if (profile is not null) { <button class="button-danger" type="button" disabled="@busy" @onclick="() => confirmDelete = true">@T("Delete")</button> }<a class="button-secondary" href="/knowledge-source-profiles">@T("Back")</a></Actions>
</PageHeader>

@if (loading) { <LoadingState Message="@T("Loading")" /> }
else if (error is not null) { <ErrorState Message="@error" /> }
else if (profile is not null)
{
    @if (message is not null) { <div class="form-alert @(failed ? "form-alert-danger" : "form-alert-success")" role="status">@message</div> }
    <ResourceTabs Label="@T("Sections")">
        @foreach (var tab in Enum.GetValues<ProfileTab>()) { <button type="button" role="tab" class="@(activeTab == tab ? "active" : null)" aria-selected="@(activeTab == tab ? "true" : "false")" @onclick="() => SelectTab(tab)">@T($"Tab.{tab}")</button> }
    </ResourceTabs>

    @if (activeTab == ProfileTab.Overview)
    {
        <section class="metric-grid">
            <MetricCard Label="@T("ActiveVersion")" Value="@(profile.ActiveVersion ?? T("NoActiveVersion"))" Detail="@T("ImmutableRevision")" Status="@(profile.ActiveVersion is null ? UiStatus.Warning : UiStatus.Success)" />
            <MetricCard Label="@T("DraftVersion")" Value="@profile.Definition.Version" Detail="@T(profile.Definition.Enabled ? "Enabled" : "Disabled")" Status="@(profile.Definition.Enabled ? UiStatus.Info : UiStatus.Warning)" />
            <MetricCard Label="@T("Revisions")" Value="@revisions.Count.ToString()" Detail="@T("PublishedDependencies")" Status="@UiStatus.Neutral" />
            <MetricCard Label="@T("Routes")" Value="@((profile.Definition.ToolBindings.Count + profile.Definition.ToolSetRoutes.Count).ToString())" Detail="@T("GovernedRoutes")" Status="@UiStatus.Neutral" />
        </section>
        <section class="panel form-section"><div class="panel-header"><div><p class="eyebrow">@T("Dependencies")</p><h2>@T("FlowComposition")</h2></div></div>
            <dl class="resource-details"><dt>@T("IngestionFlow")</dt><dd><a class="resource-name-link" href="@FlowUrl(profile.Definition.IngestionFlow)">@FlowLabel(profile.Definition.IngestionFlow)</a></dd><dt>@T("RetrievalFlow")</dt><dd><a class="resource-name-link" href="@FlowUrl(profile.Definition.RetrievalFlow)">@FlowLabel(profile.Definition.RetrievalFlow)</a></dd><dt>@T("StorageFlows")</dt><dd>@profile.Definition.StorageFlows.Count</dd><dt>@T("DirectTools")</dt><dd>@profile.Definition.ToolBindings.Count</dd><dt>@T("ToolSetRoutes")</dt><dd>@profile.Definition.ToolSetRoutes.Count</dd></dl>
        </section>
    }
    else if (activeTab == ProfileTab.Definition)
    {
        <EditForm Model="this" OnValidSubmit="SaveDefinitionAsync" class="panel form-section">
            <div class="panel-header"><div><p class="eyebrow">@T("Definition")</p><h2>@T("DraftDefinition")</h2><p>@T("DefinitionHelp")</p></div></div>
            <div class="form-grid">
                <ResourceIdentityFields @bind-DisplayName="displayName" @bind-TechnicalName="technicalName" IsNew="false" />
                <label class="form-field-wide"><span>@T("DescriptionLabel")</span><textarea @bind="description" maxlength="2000"></textarea></label>
                <label><span>@T("Version")</span><input @bind="draftVersion" required /></label>
                <label><span>@T("IngestionFlow")</span><select @bind="ingestionKey" required>@foreach (var flow in flows) { <option value="@Key(flow.Namespace, flow.Id)">@FlowSummaryLabel(flow)</option> }</select></label>
                <label><span>@T("RetrievalFlow")</span><select @bind="retrievalKey" required>@foreach (var flow in flows) { <option value="@Key(flow.Namespace, flow.Id)">@FlowSummaryLabel(flow)</option> }</select></label>
                <label class="checkbox-row"><input type="checkbox" @bind="enabled" /><span>@T("Enabled")</span></label>
                <label class="form-field-wide"><span>@T("ConfigurationSchema")</span><textarea class="form-code-editor runner-json" rows="14" @bind="schemaJson"></textarea><small>@T("ConfigurationSchemaHelp")</small></label>
            </div>
            <div class="form-actions"><button class="button-primary" type="submit" disabled="@busy">@(busy ? T("Saving") : T("SaveDraft"))</button></div>
        </EditForm>
    }
    else if (activeTab == ProfileTab.Revisions)
    {
        <section class="panel form-section"><div class="panel-header"><div><p class="eyebrow">@T("Publication")</p><h2>@T("ImmutableRevisions")</h2><p>@T("RevisionHelp")</p></div></div>
            <div class="form-grid"><label><span>@T("Version")</span><input @bind="publishVersion" /></label><label class="checkbox-row"><input type="checkbox" @bind="activatePublished" /><span>@T("ActivateAfterPublish")</span></label></div>
            <div class="form-actions"><button class="button-primary" type="button" disabled="@busy" @onclick="PublishAsync">@T("Publish")</button></div>
            @if (revisions.Count == 0) { <p class="muted">@T("NoRevisions")</p> }
            else { <DataGrid TItem="KnowledgeSourceProfileRevisionResource" Items="revisions"><Header><tr><th>@T("Version")</th><th>@T("Published")</th><th>@T("DefinitionHash")</th><th>@T("State")</th><th></th></tr></Header><Row Context="revision"><tr><td><code>@revision.Version</code></td><td>@revision.PublishedAt.ToLocalTime().ToString("g")</td><td><code>@Short(revision.DefinitionHash)</code></td><td>@(revision.Version == profile.ActiveVersion ? T("Active") : T("Inactive"))</td><td>@if (revision.Version != profile.ActiveVersion) { <button class="text-button" type="button" disabled="@busy" @onclick="() => ActivateAsync(revision.Version)">@T("ActivateRollback")</button> }</td></tr></Row></DataGrid> }
        </section>
    }
    else if (activeTab == ProfileTab.Apply)
    {
        <section class="panel form-section"><div class="panel-header"><div><p class="eyebrow">@T("Apply")</p><h2>@T("ApplyPublishedProfile")</h2><p>@T("ApplyHelp")</p></div></div>
            <div class="form-grid"><label><span>@T("SourceProfile")</span><select @bind="sourceProfileKey"><option value="">@T("SelectProfile")</option>@foreach (var value in profiles.Where(value => value.Name != profile.Name || value.Namespace != profile.Namespace)) { <option value="@Key(value.Namespace, value.Name)">@value.Definition.DisplayName</option> }</select></label><label><span>@T("SourceVersion")</span><input @bind="sourceVersion" /></label><label><span>@T("TargetVersion")</span><input @bind="targetVersion" /></label><label class="form-field-wide"><span>@T("ConfigurationDefaults")</span><textarea class="form-code-editor runner-json" rows="8" @bind="defaultsJson"></textarea></label></div>
            <div class="form-actions"><button class="button-secondary" type="button" disabled="@busy" @onclick="PreviewAsync">@T("Preview")</button><button class="button-primary" type="button" disabled="@(busy || applicationPlan?.Ready != true)" @onclick="ApplyAsync">@T("ApplyAndPublish")</button></div>
            @if (applicationPlan is not null) { <div class="form-alert @(applicationPlan.Ready ? "form-alert-success" : "form-alert-danger")"><strong>@T(applicationPlan.Ready ? "ApplicationReady" : "ApplicationBlocked")</strong><div>@T("DependencyChanges", applicationPlan.DependencyChanges.Count) · @T("SourceImpacts", applicationPlan.Sources.Count)</div>@foreach (var issue in applicationPlan.Issues) { <div>@issue</div> }</div> }
        </section>
    }
    else
    {
        <section class="panel form-section"><div class="panel-header"><div><p class="eyebrow">@T("RawResource")</p><h2>@T("Yaml")</h2><p>@T("YamlHelp")</p></div></div>
            @if (yamlError is not null) { <div class="form-alert form-alert-danger">@yamlError</div> }
            <label><span>@T("Manifest")</span><textarea class="form-code-editor runner-json" rows="32" @bind="rawYaml" @bind:event="oninput"></textarea></label>
            <div class="form-actions"><button class="button-primary" type="button" disabled="@busy" @onclick="SaveYamlAsync">@T("SaveYaml")</button></div>
        </section>
    }
}

<ConfirmationDialog IsOpen="@confirmDelete" Title="@T("DeleteTitle")" Message="@T("DeleteHelp")" ConfirmLabel="@T("Delete")" OnConfirm="DeleteAsync" OnCancel="() => confirmDelete = false" />

@code {
    [Parameter] public string Name { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "namespace")] public string? Namespace { get; set; }
    private readonly CancellationTokenSource cancellation = new();
    private KnowledgeSourceProfileResource? profile;
    private IReadOnlyList<KnowledgeSourceProfileRevisionResource> revisions = [];
    private IReadOnlyList<KnowledgeSourceProfileResource> profiles = [];
    private IReadOnlyList<FlowSummary> flows = [];
    private KnowledgeSourceProfileApplicationPlan? applicationPlan;
    private ProfileTab activeTab;
    private bool loading = true, busy, failed, enabled, activatePublished = true, confirmDelete;
    private string technicalName = string.Empty, displayName = string.Empty, description = string.Empty, draftVersion = string.Empty, ingestionKey = string.Empty, retrievalKey = string.Empty, schemaJson = "{}", publishVersion = string.Empty, sourceProfileKey = string.Empty, sourceVersion = "1.0.0", targetVersion = "1.0.0", defaultsJson = "{}", rawYaml = string.Empty;
    private string? etag, error, message, yamlError;
    private ResourceNamespace ProfileNamespace => ResourceNamespace.Parse(Namespace);
    private string T(string key, params object[] args) => Localizer[key, args];
    protected override Task OnParametersSetAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        loading = true; error = null;
        try
        {
            var profileTask = Client.GetAsync(ProfileNamespace, Name, cancellation.Token); var revisionTask = Client.GetRevisionsAsync(ProfileNamespace, Name, cancellation.Token); var profilesTask = Client.GetAsync(cancellation.Token); var flowsTask = Flows.GetFlowsAsync(cancellation.Token);
            await Task.WhenAll(profileTask, revisionTask, profilesTask, flowsTask);
            var snapshot = await profileTask; profile = snapshot.Value; etag = snapshot.ETag; revisions = (await revisionTask).OrderByDescending(value => value.PublishedAt).ToArray(); profiles = await profilesTask; flows = await flowsTask; LoadForm();
        }
        catch (Exception exception) { error = exception.Message; }
        finally { loading = false; }
    }
    private void LoadForm() { technicalName = profile!.Name; displayName = profile.Definition.DisplayName; description = profile.Definition.Description ?? string.Empty; enabled = profile.Definition.Enabled; draftVersion = profile.Definition.Version; publishVersion = profile.Definition.Version; targetVersion = profile.Definition.Version; ingestionKey = Key(profile.Definition.IngestionFlow.Namespace ?? profile.Namespace, profile.Definition.IngestionFlow.Name); retrievalKey = Key(profile.Definition.RetrievalFlow.Namespace ?? profile.Namespace, profile.Definition.RetrievalFlow.Name); schemaJson = JsonSerializer.Serialize(profile.Definition.ConfigurationSchema, new JsonSerializerOptions { WriteIndented = true }); PrepareYaml(); }
    private KnowledgeSourceProfileProperties FormDefinition()
    {
        using var schema = JsonDocument.Parse(schemaJson);
        return profile!.Definition with { DisplayName = displayName.Trim(), Description = string.IsNullOrWhiteSpace(description) ? null : description.Trim(), Enabled = enabled, Version = draftVersion.Trim(), Publish = false, Activate = false, ConfigurationSchema = schema.RootElement.Clone(), IngestionFlow = Target(ingestionKey), RetrievalFlow = Target(retrievalKey) };
    }
    private async Task SaveDefinitionAsync() => await RunAsync(async () => { var saved = await Client.UpdateAsync(ProfileNamespace, Name, new(FormDefinition()), etag!, cancellation.Token); profile = saved.Value; etag = saved.ETag; LoadForm(); }, "Saved");
    private async Task PublishAsync() => await RunAsync(async () => { await Client.PublishAsync(ProfileNamespace, Name, new() { Version = publishVersion.Trim(), Activate = activatePublished }, cancellation.Token); await ReloadCurrentAsync(); }, "PublishedMessage");
    private async Task ActivateAsync(string version) => await RunAsync(async () => { var saved = await Client.ActivateAsync(ProfileNamespace, Name, new() { Version = version }, etag!, cancellation.Token); profile = saved.Value; etag = saved.ETag; revisions = await Client.GetRevisionsAsync(ProfileNamespace, Name, cancellation.Token); }, "ActivatedMessage");
    private PreviewKnowledgeSourceProfileApplicationRequest ApplicationRequest()
    {
        var parts = sourceProfileKey.Split('|', 2); using var defaults = JsonDocument.Parse(defaultsJson);
        return new() { SourceProfile = new(parts[1], null, ResourceNamespace.Parse(parts[0])), SourceVersion = sourceVersion.Trim(), TargetVersion = targetVersion.Trim(), ConfigurationDefaults = defaults.RootElement.Clone() };
    }
    private async Task PreviewAsync() => await RunAsync(async () => applicationPlan = await Client.PreviewApplicationAsync(ProfileNamespace, Name, ApplicationRequest(), cancellation.Token), "Previewed");
    private async Task ApplyAsync() => await RunAsync(async () => { await Client.ApplyAsync(ProfileNamespace, Name, ApplicationRequest(), etag!, cancellation.Token); await ReloadCurrentAsync(); applicationPlan = null; }, "AppliedMessage");
    private void SelectTab(ProfileTab tab) { activeTab = tab; if (tab == ProfileTab.Yaml) PrepareYaml(); }
    private void PrepareYaml() { yamlError = null; rawYaml = ResourceManifestSerializer.ToYaml(new RawProfile { ApiVersion = profile!.ApiVersion, Kind = profile.Kind, Metadata = profile.Metadata, Definition = profile.Definition }); }
    private async Task SaveYamlAsync()
    {
        yamlError = null;
        try { var raw = ResourceManifestSerializer.FromYaml<RawProfile>(rawYaml); if (raw.Kind != KnowledgeResourceKinds.KnowledgeSourceProfile || raw.Metadata.Name != Name || raw.Metadata.Namespace != ProfileNamespace) throw new ArgumentException(T("IdentityImmutable")); var saved = await Client.UpdateAsync(ProfileNamespace, Name, new(raw.Definition with { Publish = false, Activate = false }), etag!, cancellation.Token); profile = saved.Value; etag = saved.ETag; LoadForm(); message = T("Saved"); failed = false; }
        catch (Exception exception) { yamlError = exception.Message; }
    }
    private async Task ReloadCurrentAsync() { var snapshot = await Client.GetAsync(ProfileNamespace, Name, cancellation.Token); profile = snapshot.Value; etag = snapshot.ETag; revisions = (await Client.GetRevisionsAsync(ProfileNamespace, Name, cancellation.Token)).OrderByDescending(value => value.PublishedAt).ToArray(); LoadForm(); }
    private async Task RunAsync(Func<Task> action, string success) { if (busy) return; busy = true; message = null; failed = false; try { await action(); message = T(success); } catch (Exception exception) { failed = true; message = exception.Message; } finally { busy = false; } }
    private async Task DeleteAsync() { confirmDelete = false; await RunAsync(async () => { await Client.DeleteAsync(ProfileNamespace, Name, etag!, cancellation.Token); Navigation.NavigateTo("/knowledge-source-profiles"); }, "Deleted"); }
    private KnowledgeFlowTarget Target(string key) { var parts = key.Split('|', 2); return new() { Name = parts[1], Namespace = ResourceNamespace.Parse(parts[0]), UseActiveVersion = true }; }
    private static string Key(ResourceNamespace ns, string value) => $"{ns.Value}|{value}";
    private static string FlowSummaryLabel(FlowSummary flow) => $"{flow.Namespace}/{flow.Name} · {flow.ActiveVersion ?? flow.Version ?? "—"}";
    private string FlowLabel(KnowledgeFlowTarget flow) => $"{flow.Namespace ?? profile!.Namespace}/{flow.Name}:{flow.Version ?? "active"}";
    private string FlowUrl(KnowledgeFlowTarget flow) { var ns = flow.Namespace ?? profile!.Namespace; return ns.IsDefault ? $"/flows/{Uri.EscapeDataString(flow.Name)}" : $"/namespaces/{Uri.EscapeDataString(ns.Value)}/flows/{Uri.EscapeDataString(flow.Name)}"; }
    private static string Short(string value) => value.Length <= 16 ? value : value[..16];
    private sealed record RawProfile { public required string ApiVersion { get; init; } public required string Kind { get; init; } public required ResourceMetadata Metadata { get; init; } public required KnowledgeSourceProfileProperties Definition { get; init; } }
    private enum ProfileTab { Overview, Definition, Revisions, Apply, Yaml }
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
