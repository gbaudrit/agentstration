@page "/flow-runs"
@implements IDisposable
@inject IFlowApiClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<FlowRunsStrings> Localizer
<PageTitle>@T("Title") · Agentstration</PageTitle>
<PageHeader Title="@T("Title")" Description="@T("Description")"><Actions><a class="button-secondary" href="/flows">@T("Definitions")</a></Actions></PageHeader>
<nav class="section-tabs"><a href="/flows">@T("Definitions")</a><a class="active" href="/flow-runs">@T("Runs")</a><a href="/flows#deployments">@T("Deployments")</a></nav>
<div class="filter-bar"><SearchBox @bind-Value="search" Placeholder="@T("SearchPlaceholder")" /><select @bind="status"><option value="">@T("AllStatuses")</option>@foreach(var value in Enum.GetValues<FlowRunStatus>()){<option value="@value">@StatusLabel(value)</option>}</select><select @bind="trigger"><option value="">@T("AllTriggers")</option>@foreach(var value in Enum.GetValues<FlowRunTrigger>()){<option value="@value">@TriggerLabel(value)</option>}</select><input @bind="version" placeholder="@T("Version")" /><input @bind="deployment" placeholder="@T("Deployment")" /></div>
@if(runs is null){<LoadingState Message="@T("Loading")"/>}else if(Filtered.Count==0){<EmptyState Title="@T("EmptyTitle")" Message="@T("EmptyMessage")"/>}else{<RunGrid Runs="Filtered" />}
@code {
    private readonly CancellationTokenSource cancellation=new(); private IReadOnlyList<FlowRun>? runs; private string search="",status="",trigger="",version="",deployment="";
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string StatusLabel(FlowRunStatus value) => Localizer[$"Status.{value}"];
    private string TriggerLabel(FlowRunTrigger value) => Localizer[$"Trigger.{value}"];
    private IReadOnlyList<FlowRun> Filtered => runs?.Where(run => (string.IsNullOrWhiteSpace(search)||run.Id.Contains(search,StringComparison.OrdinalIgnoreCase)||run.FlowId.Value.Contains(search,StringComparison.OrdinalIgnoreCase))&&(string.IsNullOrWhiteSpace(status)||run.Status.ToString()==status)&&(string.IsNullOrWhiteSpace(trigger)||run.Trigger.ToString()==trigger)&&(string.IsNullOrWhiteSpace(version)||run.FlowVersion.Contains(version,StringComparison.OrdinalIgnoreCase))&&(string.IsNullOrWhiteSpace(deployment)||(run.DeploymentResourceId?.Contains(deployment,StringComparison.OrdinalIgnoreCase)??false))).ToArray() ?? [];
    protected override async Task OnInitializedAsync()=>runs=await Client.GetFlowRunsAsync(null,cancellation.Token);
    public void Dispose(){cancellation.Cancel();cancellation.Dispose();}
}
