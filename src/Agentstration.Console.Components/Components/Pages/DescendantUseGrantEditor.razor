@inject Microsoft.Extensions.Localization.IStringLocalizer<SecretStrings> Localizer

@if (OwnerScopeRef is { } owner && Candidates(owner).Count > 0)
{
    <section class="panel form-section">
        <div class="panel-header"><div><p class="eyebrow">@T("Scope")</p><h2>@T("DescendantAccess")</h2></div></div>
        <p>@T("DescendantAccessHelp")</p>
        @foreach (var grant in Grants)
        {
            <div class="form-grid" @key="grant.ScopeRef">
                <label><span>@T("TargetScope")</span><ResourceScopeBadge ScopeRef="grant.ScopeRef" /></label>
                <label><input type="checkbox" checked="@grant.IncludeDescendants" @onchange="args => SetIncludeDescendants(grant.ScopeRef, args.Value is true)" /> @T("IncludeDescendants")</label>
                <button type="button" class="button-secondary" @onclick="() => Remove(grant.ScopeRef)">@T("RemoveGrant")</button>
            </div>
        }
        <div class="form-grid">
            <label><span>@T("TargetScope")</span><select @bind="selectedScope"><option value="">@T("SelectScope")</option>@foreach (var target in Candidates(owner).Where(value => Grants.All(grant => grant.ScopeRef != value.ScopeRef))) { <option value="@target.ScopeRef.Value">@target.DisplayName</option> }</select></label>
            <button type="button" class="button-secondary" disabled="@string.IsNullOrWhiteSpace(selectedScope)" @onclick="Add">@T("AddGrant")</button>
        </div>
    </section>
}

@code {
    [Parameter] public ResourceScopeRef? OwnerScopeRef { get; set; }
    [Parameter] public IReadOnlyList<ResourceScopeTargetResponse> Targets { get; set; } = [];
    [Parameter] public List<DescendantUseGrant> Grants { get; set; } = [];
    private string selectedScope = string.Empty;
    private string T(string key) => Localizer[key].Value;
    private IReadOnlyList<ResourceScopeTargetResponse> Candidates(ResourceScopeRef owner) =>
        Targets.Where(value => value.Kind > owner.Kind && value.ScopeRef != owner).ToArray();
    private void Add()
    {
        if (!ResourceScopeRef.TryParse(selectedScope, out var scope) || Grants.Any(value => value.ScopeRef == scope)) return;
        Grants.Add(new(scope));
        selectedScope = string.Empty;
    }
    private void Remove(ResourceScopeRef scope) => Grants.RemoveAll(value => value.ScopeRef == scope);
    private void SetIncludeDescendants(ResourceScopeRef scope, bool includeDescendants)
    {
        var index = Grants.FindIndex(value => value.ScopeRef == scope);
        if (index >= 0) Grants[index] = Grants[index] with { IncludeDescendants = includeDescendants };
    }
}
