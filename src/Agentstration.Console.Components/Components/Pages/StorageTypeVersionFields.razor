@inject Microsoft.Extensions.Localization.IStringLocalizer<StorageStrings> Localizer

<section class="panel form-section">
    <h2>@T("Type.VersionContract")</h2><p>@T("Type.ImmutableHelp")</p>
    <div class="form-grid">
        <FormField Label="@T("Version")"><ClearableText @bind-Value="Draft.Version" maxlength="64" data-testid="storage-type-version" /></FormField>
        <FormField Label="@T("Type.RequiresService")"><FormCheckbox @bind-Value="Draft.RequiresConnectedService" /></FormField>
        <FormField Label="@T("Type.ConfigurationSchema")" Class="form-span-2"><ClearableText Multiline @bind-Value="Draft.ConfigurationSchema" class="form-code-editor" rows="8" maxlength="262144" data-testid="storage-type-configuration-schema" /></FormField>
        <FormField Label="@T("Type.EnvelopeSchema")" Class="form-span-2"><ClearableText Multiline @bind-Value="Draft.EnvelopeSchema" class="form-code-editor" rows="8" maxlength="262144" /></FormField>
        <FormField Label="@T("Type.Requirements")" Class="form-span-2"><ClearableText Multiline @bind-Value="Draft.Requirements" class="form-code-editor" rows="5" maxlength="65536" /></FormField>
    </div>
    <p>@T("Type.RequirementsHelp")</p><h3>@T("Capabilities")</h3><p>@T("Type.CapabilitiesHelp")</p>
    <div class="form-grid">
        <FormField Label="@T("Capability.List")"><FormCheckbox @bind-Value="Draft.List" /></FormField>
        <FormField Label="@T("Capability.Stat")"><FormCheckbox @bind-Value="Draft.Stat" /></FormField>
        <FormField Label="@T("Capability.Read")"><FormCheckbox @bind-Value="Draft.Read" /></FormField>
        <FormField Label="@T("Capability.Write")"><FormCheckbox @bind-Value="Draft.Write" /></FormField>
        <FormField Label="@T("Capability.Delete")"><FormCheckbox @bind-Value="Draft.Delete" /></FormField>
        <FormField Label="@T("Capability.StableVersions")"><FormCheckbox @bind-Value="Draft.StableVersions" /></FormField>
        <FormField Label="@T("Capability.DurableRetention")"><FormCheckbox @bind-Value="Draft.DurableRetention" /></FormField>
        <FormField Label="@T("Deprecated")"><FormCheckbox @bind-Value="Draft.Deprecated" /></FormField>
        <FormField Label="@T("Type.MaximumPageSize")"><ClearableNumber @bind-Value="Draft.MaximumPageSize" min="1" /></FormField>
        <FormField Label="@T("Type.MaximumReadBytes")"><ClearableNumber @bind-Value="Draft.MaximumReadBytes" min="1" /></FormField>
        <FormField Label="@T("Type.MaximumWriteBytes")"><ClearableNumber @bind-Value="Draft.MaximumWriteBytes" min="1" /></FormField>
    </div>
</section>
@code {
    [Parameter, EditorRequired] public StorageTypeVersionDraft Draft { get; set; } = new();
    private string T(string key) => Localizer[key].Value;
}
