@page "/parameters"
@implements IDisposable
@inject IParametersClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<ParameterStrings> Localizer

<PageTitle>@T("Parameters") · Agentstration</PageTitle>
<PageHeader Title="@T("Parameters")" Description="@T("Parameters.Description")" TestId="resource-parameters">
    <Actions><button class="button-secondary" @onclick="LoadAsync">@T("Refresh")</button><a class="button-primary" href="/parameters/new" data-testid="parameter-create">@T("CreateParameter")</a></Actions>
</PageHeader>
<div class="form-alert form-alert-info"><strong>@T("ReadableConfiguration")</strong><span>@T("SecretGuidance")</span></div>
<div class="toolbar"><input @bind="search" @bind:event="oninput" placeholder="@T("SearchParameters")" aria-label="@T("SearchParameters")" /></div>
@if (loading) { <LoadingState Message="@T("Loading")" /> }
else if (error is not null) { <div class="form-alert form-alert-danger" role="alert">@error.Message</div> }
else if (Filtered.Count == 0) { <EmptyState Title="@T("NoParameters")" Message="@T("NoParametersMessage")" /> }
else
{
    <CollectionView TItem="ParameterResource" Items="Filtered" InformationLabels="@(new string[] { T("ValueType"), T("Value") })" RowTestId="parameter-row">
        <Identity Context="item"><CollectionIdentity DisplayName="@item.Definition.DisplayName" Namespace="@item.Namespace.Value" Name="@item.Name" Href="@ResourceUrl(item)" IconName="settings" Domain="neutral" ><Badges><ManagedResourceBadge IsManaged="@item.Governance.IsManaged" /></Badges></CollectionIdentity></Identity>
        <Scope Context="item"><ResourceScopeBadge ScopeRef="item.ScopeRef" ShowName /></Scope>
        <Information Context="item">
            <CollectionValue Label="@T("ValueType")">@TypeLabel(item.Definition.ValueType)</CollectionValue>
            <CollectionValue Label="@T("Value")"><code>@VisibleValue(item)</code></CollectionValue>
        </Information>
        <Actions Context="item"><CollectionActions ResourceName="@($"{item.Definition.DisplayName} ({item.Namespace}/{item.Name}, {item.ScopeRef})")"><a href="@ResourceUrl(item)">@T("ManageArrow")</a></CollectionActions></Actions>
    </CollectionView>
}

@code {
    private readonly CancellationTokenSource cancellation = new();
    private IReadOnlyList<ParameterResource> items = [];
    private bool loading = true;
    private Exception? error;
    private string search = string.Empty;
    private IReadOnlyList<ParameterResource> Filtered => items.Where(item => string.IsNullOrWhiteSpace(search)
        || item.Name.Contains(search, StringComparison.OrdinalIgnoreCase)
        || item.Definition.DisplayName.Contains(search, StringComparison.OrdinalIgnoreCase)).ToArray();
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    private string TypeLabel(ParameterValueType type) => T($"ValueType.{type}");
    private static string VisibleValue(ParameterResource item) => item.Definition.Value.ValueKind == System.Text.Json.JsonValueKind.String
        ? item.Definition.Value.GetString() ?? string.Empty
        : item.Definition.Value.GetRawText();
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync() { loading = true; error = null; try { items = await Client.GetParametersAsync(cancellation.Token); } catch (Exception exception) { error = exception; } finally { loading = false; } }
    private static string ResourceUrl(ParameterResource resource) => $"/parameters/{Uri.EscapeDataString(resource.Name)}?scopeRef={Uri.EscapeDataString(resource.ScopeRef!.Value.Value)}";
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
