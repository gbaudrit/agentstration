@inject IServiceProvider Services
@page "/tools/sets"
@inject IToolSetsClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<ToolSetsStrings> Localizer

<PageTitle>@T("Title") · Agentstration</PageTitle>
<PageHeader Title="@T("Title")" Description="@T("Description")" TestId="resource-toolsets">
    <Actions><a class="button-secondary" href="/knowledge-sources">@T("KnowledgeSources")</a><button class="button-secondary" type="button" @onclick="LoadAsync">@T("Refresh")</button></Actions>
</PageHeader>
<ResourceTabs Label="@T("SectionsLabel")"><a href="/tools">@T("Catalog")</a><a class="active" href="/tools/sets">@T("ToolSets")</a><a href="/tools/categories">@T("Categories")</a><a href="/tools/definitions">@T("Definitions")</a><a href="/tools/providers">@T("Providers")</a></ResourceTabs>

@if (loading) { <LoadingState Message="@T("Loading")" /> }
else if (error is not null) { <ErrorState Message="@error" /> }
else if (toolSets.Count == 0) { <EmptyState Title="@T("EmptyTitle")" Message="@T("EmptyMessage")" /> }
else
{
    <CollectionView TItem="ToolSetResource" Items="toolSets" InformationLabels="@(new string[] { T("Version"), T("Members"), T("Category") })" RowTestId="toolset-row" IdentityLabel="@T("ToolSet")" StateLabel="@T("State")">
        <Identity Context="toolSet">
<CollectionIdentity DisplayName="@toolSet.Definition.DisplayName" Namespace="@toolSet.Namespace.Value" Name="@toolSet.Name" Href="@DetailsUrl(toolSet)" IconName="layers"><Badges><ManagedResourceBadge IsManaged="@toolSet.Governance.IsManaged" /></Badges></CollectionIdentity></Identity>
        <Scope Context="toolSet">
<ResourceScopeBadge ScopeRef="toolSet.ScopeRef" ShowName /></Scope>
        <State Context="toolSet">
<StatusBadge Text="@T(toolSet.Definition.Enabled ? "Enabled" : "Disabled")" Status="@(toolSet.Definition.Enabled ? UiStatus.Success : UiStatus.Warning)" /></State>
        <Information Context="toolSet">
            <CollectionValue Label="@T("Version")"><code>@toolSet.Definition.Version</code></CollectionValue>
            <CollectionValue Label="@T("Members")">@toolSet.Definition.Members.Count</CollectionValue>
            <CollectionValue Label="@T("Category")">@(toolSet.Definition.Category?.Name ?? "—")</CollectionValue>
        </Information>
        <Actions Context="toolSet">
<CollectionActions ResourceName="@($"{toolSet.Definition.DisplayName} ({toolSet.Namespace}/{toolSet.Name}, {toolSet.ScopeRef})")"><a class="text-button" href="@DetailsUrl(toolSet)">@T("Inspect")</a></CollectionActions></Actions>
    </CollectionView>
}

@code {
    private IReadOnlyList<ToolSetResource> toolSets = [];
    private bool loading = true;
    private string? error;
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try { toolSets = await Client.GetToolSetsAsync(); }
        catch (Exception exception) { error = exception.Message; }
        finally { loading = false; }
    }
    private string DetailsUrl(ToolSetResource value) => ResourceOwnershipContext.Resource(Services, "/tools/sets", value.Name, value.Namespace, value.ScopeRef);
}
