@page "/run-events"
@implements IDisposable
@inject IAgentstrationEventStream Stream
@inject Microsoft.Extensions.Localization.IStringLocalizer<RunEventsStrings> Localizer
<PageTitle>@T("PageTitle")</PageTitle><PageHeader Title="@T("Title")" Description="@T("Description")" />
<FilterBar><SearchBox Value="search" ValueChanged="value=>search=value" Placeholder="@T("SearchPlaceholder")" /><select @bind="level" aria-label="@T("LevelFilterLabel")"><option value="">@T("AllLevels")</option><option value="Information">@T("Level.Information")</option><option value="Warning">@T("Level.Warning")</option><option value="Error">@T("Level.Error")</option></select><StatusBadge Text="@T("PersistedJournals")" Status="UiStatus.Info" /></FilterBar>
@if(items is null){<LoadingState Message="@T("Loading")"/>}else{<article class="panel"><EventList Items="Filtered" /></article>}
@code{private readonly CancellationTokenSource cancellation=new();private IReadOnlyList<EventListItem>? items;private string search="",level="";private string T(string key)=>Localizer[key];private IReadOnlyList<EventListItem> Filtered=>items?.Where(item=>(string.IsNullOrWhiteSpace(search)||item.Summary.Contains(search,StringComparison.OrdinalIgnoreCase)||item.Source.Contains(search,StringComparison.OrdinalIgnoreCase)||item.Type.Contains(search,StringComparison.OrdinalIgnoreCase)||(item.CorrelationId?.Contains(search,StringComparison.OrdinalIgnoreCase)??false))&&(string.IsNullOrWhiteSpace(level)||item.Level==level)).ToArray()??[];protected override async Task OnInitializedAsync()=>items=await Stream.GetRecentEventsAsync(cancellation.Token);public void Dispose(){cancellation.Cancel();cancellation.Dispose();}}

