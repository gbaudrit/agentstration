@page "/storages/{Name}"
@implements IDisposable
@inject IStoragesClient Client
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@inject ConsoleContextState Context
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<StorageStrings> Localizer

<PageTitle>@(resource?.Definition.DisplayName ?? Name) · Agentstration</PageTitle>
@{ var presentations = Presentations; var editorIdentity = Identity; }
<ConsoleResourceDetailsTemplate CollectionHref="@BackUrl" CollectionLabel="@T("Storages")" Resource="resource" Name="@(resource?.Definition.DisplayName ?? Name ?? string.Empty)" ResourceType="@T("Storage")" Domain="storage" IconName="database" Description="@resource?.Definition.Description"
    Enabled="resource?.Definition.Enabled" EnabledChanged="ChangeEnabledAsync" EnabledDisabled="@(Busy || !CanWrite)" EnabledTestId="storage-enabled"
    StatusText="@AvailabilityLabel" Status="AvailabilityColor" ResourceIdentity="@(loadedKey ?? Name ?? string.Empty)" SectionState="sectionState" SectionPresentations="presentations" DefinitionSections="DefinitionSections" AdditionalSections="AdditionalSections"
    DefinitionReadOnlyReason="ExplicitReadOnlyReason" AllowAccess="IsOwner" EvaluateSavedAccess HasDraft="HasDraft"
    LoadState="loadState" OnRetry="RefreshAsync" OnRefresh="RefreshAsync" Busy="Busy" Yaml="@ResourceYaml" YamlLabel="@T("Yaml.Label")" YamlDescription="@T("Yaml.Help")" YamlInputTestId="storage-yaml"
    SectionTestIdPrefix="storage" TestId="storage-details">
    <Actions>@if (CanWrite) { <button class="button-secondary" type="button" disabled="@Busy" @onclick="RequestReconcile" data-testid="storage-reconcile">@T("Reconcile")</button> }</Actions>
    <Feedback><StorageError Error="error" />@if (newerBundle is not null) { <div class="form-alert form-alert-warning" role="status">@T("RefreshDraftConflict")</div> }</Feedback>
    <OverviewMetrics><MetricCard Label="@T("Availability")" Value="@AvailabilityLabel" Status="AvailabilityColor" /><MetricCard Label="@T("Generation")" Value="@(resource?.Generation.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—")" /></OverviewMetrics>
    <OverviewConfiguration>@ConfigurationSummary</OverviewConfiguration>
    <OverviewContent>@ConnectionSummary</OverviewContent>
    <DefinitionContent Context="path">
        @if (resource is { } saved)
        {
            <StorageEditor @ref="editor" @key="loadedKey" Name="@saved.Name" Embedded EmbeddedAddress="StorageLinks.Address(saved)"
                InitialSnapshot="@(new ResourceSnapshot<StorageResource>(saved, etag!))" ExternalActions ExternalBusy="changingState" SaveBlocked="loading" ReadOnlyReason="ExplicitReadOnlyReason"
                SectionState="sectionState" SectionPresentations="presentations" SectionRequested="ShowSection"
                DraftChanged="value => EditorDraftChanged(editorIdentity, value)" SavingChanged="value => EditorSavingChanged(editorIdentity, value)"
                SnapshotSaved="snapshot => DefinitionSaved(editorIdentity, snapshot)" />
        }
    </DefinitionContent>
    <AdditionalContent Context="path">@if (path == "diagnostics") { @Diagnostics } else if (path == "dependents") { @Dependents }</AdditionalContent>
    <DraftActions><button type="button" class="button-secondary" disabled="@Busy" @onclick="DiscardDefinition">@Shared["Discard"]</button><button type="submit" form="@editor?.FormId" class="button-primary" disabled="@(Busy || editor?.CanEdit != true)" data-testid="storage-save">@T("Save")</button></DraftActions>
</ConsoleResourceDetailsTemplate>
<StorageConfirmation IsOpen="confirmReconcile" Title="@T("Reconcile")" Message="@T("Reconcile.Confirm")" ConfirmLabel="@T("Reconcile")" TestId="storage-reconcile-confirmation" OnConfirm="ReconcileAsync" OnCancel="() => confirmReconcile = false" />
<StorageConfirmation IsOpen="confirmDeactivate" Title="@T("Deactivate")" Message="@T("Deactivate.Confirm")" ConfirmLabel="@T("Deactivate")" TestId="storage-deactivate-confirmation" OnConfirm="DeactivateAsync" OnCancel="() => confirmDeactivate = false" />
@code {
    [Parameter] public string? Name { get; set; }
    [SupplyParameterFromQuery(Name = "scopeRef")] public string? ScopeRefValue { get; set; }
    [SupplyParameterFromQuery(Name = "namespace")] public string? NamespaceValue { get; set; }
    [SupplyParameterFromQuery(Name = "context")] public string? ContextValue { get; set; }
    private static readonly JsonSerializerOptions SavedJson = new() { WriteIndented = true };
    private readonly ResourceSectionState sectionState = new();
    private readonly CancellationTokenSource cancellation = new();
    private readonly CancellationToken lifetimeToken;
    public StorageDetails() => lifetimeToken = cancellation.Token;
    private StorageResource? resource;
    private IReadOnlyList<StorageTypeResource> catalog = [];
    private IReadOnlyList<StorageUsage> usages = [];
    private bool usagesKnown;
    private DetailBundle? newerBundle;
    private string? etag, loadedKey;
    private bool loading, changingState, editorBusy, editorDirty, confirmReconcile, confirmDeactivate, disposed;
    private Exception? error;
    private ResourceLoadState loadState = new(ResourceLoadStatus.Loading);
    private long loadVersion;
    private StorageEditor? editor;
    private string Identity => $"{loadedKey}|{resource?.Uid}";
    private bool HasDraft => editor?.IsDirty ?? editorDirty;
    private bool Busy => loading || changingState || editorBusy;
    private ResourceScopeRef? CurrentContext => string.IsNullOrWhiteSpace(ContextValue) ? ResourceOwnershipContext.TryGetCurrent(Services) ?? (Context.Current is { } current ? ResourceScopeRef.Parse(current.SelectedScopeRef) : null) : ResourceScopeRef.Parse(ContextValue);
    private bool IsOwner => resource?.ScopeRef is { } owner && CurrentContext is { } current && owner == current;
    private bool HasWritePermission => Context.HasPermission("resources/write");
    private bool CanWrite => IsOwner && HasWritePermission && resource?.Governance.IsManaged == false;
    private ResourceReadOnlyReason? ExplicitReadOnlyReason => !HasWritePermission ? ResourceReadOnlyReason.InsufficientPermissions : resource is not null && !IsOwner ? ResourceReadOnlyReason.Inherited : null;
    private IReadOnlyDictionary<string, ResourceSectionPresentation> Presentations => new Dictionary<string, ResourceSectionPresentation>(StorageEditor.DefinitionPresentations(), StringComparer.Ordinal) { ["yaml"] = new() { ReadOnly = true } };
    private IReadOnlyList<ResourceNavigationItem> DefinitionSections => [new("definition/use-policy", T("DescendantUsePolicy"), "lock")];
    private IReadOnlyList<ResourceNavigationItem> AdditionalSections => [new("diagnostics", T("Diagnostics"), "activity"), new("dependents", T("Dependents"), "stack-2")];
    private string ResourceYaml => resource is null ? string.Empty : ResourceManifestSerializer.ToYaml(new RawStorage(resource.ApiVersion, resource.Kind, resource.Metadata, resource.ScopeRef, resource.Definition));
    private string AvailabilityLabel => resource?.ObservedState is { } observed ? T($"Availability.{observed.Availability}") : T("Availability.Unknown");
    private UiStatus AvailabilityColor => resource?.ObservedState?.Availability switch { StorageAvailability.Ready => UiStatus.Success, StorageAvailability.Unavailable or StorageAvailability.Stale => UiStatus.Warning, _ => UiStatus.Neutral };
    private StorageTypeChoice? TypeChoice => resource is null ? null : catalog.SelectMany(type => type.Definition.Versions.Select(version => new StorageTypeChoice(type, version))).FirstOrDefault(choice => choice.Matches(resource.Definition.Type));
    private string BackUrl => ResourceOwnershipContext.PreserveNavigation("/storages", Services);
    private string T(string key) => Localizer[key].Value;
    private Task ShowSection(string path) { Navigation.NavigateTo(Navigation.Uri.Split('#')[0] + "#" + path); return Task.CompletedTask; }
    protected override Task OnParametersSetAsync()
    {
        var key = $"{Name}|{ScopeRefValue}|{NamespaceValue}|{ContextValue}|{Context.Current?.SelectedScopeRef}";
        if (key == loadedKey) return Task.CompletedTask;
        loadedKey = key; ClearPrivate(); sectionState.Reset(key);
        return LoadAsync(false);
    }
    private void ClearPrivate()
    {
        resource = null; editor = null; newerBundle = null; catalog = []; usages = []; usagesKnown = false; etag = null; error = null;
        editorDirty = editorBusy = changingState = confirmReconcile = confirmDeactivate = false;
    }
    private Task RefreshAsync() => Busy ? Task.CompletedTask : LoadAsync(resource is not null);
    private async Task LoadAsync(bool refresh)
    {
        var request = ++loadVersion; var previous = resource; loading = true; error = null;
        loadState = new(refresh && resource is not null ? ResourceLoadStatus.Refreshing : ResourceLoadStatus.Loading) { HasContent = resource is not null };
        try
        {
            await Context.EnsureLoadedAsync(lifetimeToken);
            if (request != loadVersion || disposed) return;
            if (!Context.HasPermission("resources/read")) { ClearPrivate(); loadState = new(ResourceLoadStatus.Forbidden); return; }
            _ = CurrentContext;
            loadedKey = $"{Name}|{ScopeRefValue}|{NamespaceValue}|{ContextValue}|{Context.Current!.SelectedScopeRef}";
            var address = Address();
            var snapshot = await Client.GetAsync(address, lifetimeToken);
            if (request != loadVersion || disposed) return;
            if (!Matches(snapshot.Value, previous)) { ClearPrivate(); loadState = new(ResourceLoadStatus.NotFound); return; }
            var bundle = await ReadBundleAsync(snapshot, request);
            if (request != loadVersion || disposed) return;
            if (HasDraft)
            {
                catalog = bundle.Catalog; usages = bundle.Usages; usagesKnown = bundle.UsagesKnown;
                newerBundle = snapshot.ETag != etag || snapshot.Value.Generation != resource?.Generation ? bundle : null;
            }
            else Adopt(bundle);
            loadState = bundle.Failure is null ? new(ResourceLoadStatus.Ready) { HasContent = true }
                : new(ResourceLoadStatus.Failed) { HasContent = true, ErrorId = bundle.Failure.ErrorId };
        }
        catch (OperationCanceledException) when (lifetimeToken.IsCancellationRequested) { }
        catch (Exception exception)
        {
            if (request != loadVersion || disposed) return;
            var status = FailureStatus(exception);
            if (status is ResourceLoadStatus.Forbidden or ResourceLoadStatus.NotFound) ClearPrivate();
            loadState = new(status) { HasContent = resource is not null, ErrorId = (exception as AgentstrationApiException)?.ErrorId };
        }
        finally { if (request == loadVersion && !disposed) loading = false; }
    }
    private async Task<DetailBundle> ReadBundleAsync(ResourceSnapshot<StorageResource> snapshot, long request)
    {
        var types = resource is null ? [] : catalog; var references = resource is null ? [] : usages; var known = resource is not null && usagesKnown;
        AgentstrationApiException? failure = null;
        try { types = await Client.GetTypesAsync(CurrentContext ?? ResourceScopeRef.Parse(Context.Current!.SelectedScopeRef), lifetimeToken); }
        catch (AgentstrationApiException exception) when (FailureStatus(exception) == ResourceLoadStatus.Failed) { failure = exception; }
        if (request != loadVersion || disposed) return new(snapshot, [], [], false, null);
        try { references = await Client.GetUsagesAsync(Address(), lifetimeToken); known = true; }
        catch (AgentstrationApiException exception) when (FailureStatus(exception) == ResourceLoadStatus.Failed) { failure ??= exception; }
        return new(snapshot, types, references, known, failure);
    }
    private static ResourceLoadStatus FailureStatus(Exception exception) => exception is AgentstrationApiException api ? api.StatusCode switch
    {
        System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden => ResourceLoadStatus.Forbidden,
        System.Net.HttpStatusCode.NotFound => ResourceLoadStatus.NotFound,
        _ => ResourceLoadStatus.Failed
    } : ResourceLoadStatus.Failed;
    private ScopedResourceAddress Address() => ScopedResourceAddress.Create(ResourceScopeRef.Parse(ScopeRefValue ?? throw new ArgumentException("scopeRef")), ResourceNamespace.Parse(NamespaceValue), StorageResourceKinds.Storage, Name!);
    private bool Matches(StorageResource value, StorageResource? previous) => value.ScopeRef is not null && value.Kind == StorageResourceKinds.Storage && StorageLinks.Address(value) == Address() && (previous is null || value.Uid == previous.Uid);
    private void Adopt(DetailBundle bundle)
    {
        resource = bundle.Snapshot.Value; etag = bundle.Snapshot.ETag; catalog = bundle.Catalog; usages = bundle.Usages; usagesKnown = bundle.UsagesKnown; newerBundle = null;
    }
    private void DiscardDefinition()
    {
        if (Busy) return;
        if (newerBundle is { } latest) { Adopt(latest); editor?.ApplySnapshot(latest.Snapshot, discard: true); }
        else editor?.Discard();
        editorDirty = false; error = null;
    }
    private void EditorDraftChanged(string identity, bool value) { if (!disposed && identity == Identity) editorDirty = value; }
    private void EditorSavingChanged(string identity, bool value) { if (!disposed && identity == Identity) editorBusy = value; }
    private void DefinitionSaved(string identity, ResourceSnapshot<StorageResource> snapshot)
    {
        if (disposed || identity != Identity) return;
        if (!Matches(snapshot.Value, resource)) { ClearPrivate(); loadState = new(ResourceLoadStatus.NotFound); return; }
        Adopt(new(snapshot, catalog, usages, usagesKnown, null)); error = null;
        loadState = new(ResourceLoadStatus.Ready) { HasContent = true };
    }
    private Task ChangeEnabledAsync(bool value)
    {
        if (!CanWrite || Busy || resource is null || resource.Definition.Enabled == value) return Task.CompletedTask;
        if (!value) { confirmDeactivate = true; return Task.CompletedTask; }
        var saved = resource;
        return ExecuteAsync(() => Client.UpdateAsync(StorageLinks.Address(saved), new(saved.Definition with { Enabled = true }), etag!, lifetimeToken));
    }
    private void RequestReconcile() { if (!Busy && CanWrite) confirmReconcile = true; }
    private Task ReconcileAsync()
    {
        confirmReconcile = false;
        if (!CanWrite || resource is not { } saved) return Task.CompletedTask;
        return ExecuteAsync(() => Client.ReconcileAsync(StorageLinks.Address(saved), new(), etag!, lifetimeToken));
    }
    private Task DeactivateAsync()
    {
        confirmDeactivate = false;
        if (!CanWrite || resource is not { } saved) return Task.CompletedTask;
        return ExecuteAsync(() => Client.DeactivateAsync(StorageLinks.Address(saved), etag!, lifetimeToken));
    }
    private async Task ExecuteAsync(Func<Task<ResourceSnapshot<StorageResource>>> action)
    {
        if (Busy || !CanWrite || resource is not { } previous) return;
        var request = loadVersion; changingState = true; error = null;
        try
        {
            var saved = await action();
            if (request != loadVersion || disposed) return;
            if (!Matches(saved.Value, previous)) { ClearPrivate(); loadState = new(ResourceLoadStatus.NotFound); return; }
            Adopt(new(saved, catalog, usages, usagesKnown, null)); editor?.ApplyOperationalSnapshot(saved);
            loadState = new(ResourceLoadStatus.Ready) { HasContent = true };
        }
        catch (OperationCanceledException) when (lifetimeToken.IsCancellationRequested) { }
        catch (Exception exception) { if (request == loadVersion && !disposed) error = exception; }
        finally { if (request == loadVersion && !disposed) changingState = false; }
    }
    private string ServiceUrl(ConnectedServiceRevisionReference service) => ResourceOwnershipContext.Resource(Services, "/connected-services", service.Service.Address.Name, service.Service.Address.Namespace, service.Service.ScopeRef);
    private static string UsageUrl(StorageUsage usage) => usage.Url.StartsWith('/') && !usage.Url.StartsWith("//", StringComparison.Ordinal) && !usage.Url.Contains('\\') ? usage.Url : "#";
    public void Dispose() { if (disposed) return; disposed = true; ++loadVersion; cancellation.Cancel(); cancellation.Dispose(); }
    private sealed record DetailBundle(ResourceSnapshot<StorageResource> Snapshot, IReadOnlyList<StorageTypeResource> Catalog, IReadOnlyList<StorageUsage> Usages, bool UsagesKnown, AgentstrationApiException? Failure);
    private sealed record RawStorage(string ApiVersion, string Kind, ResourceMetadata Metadata, ResourceScopeRef? ScopeRef, StorageProperties Definition);
    private sealed record ConfigurationRow(string Name, string Value, string? Href = null);
    private IReadOnlyList<ConfigurationRow> ConfigurationRows => resource is not { } saved ? [] : [
        new(T("SavedType"), $"{TypeChoice?.Resource.Definition.DisplayName ?? saved.Definition.Type.Type.Name} · {saved.Definition.Type.Type.Namespace ?? saved.Namespace}/{saved.Definition.Type.Type.Name}", saved.Definition.Type.Type.ScopeRef is { } typeOwner ? ResourceOwnershipContext.Resource(Services, "/storage-types", saved.Definition.Type.Type.Name, saved.Definition.Type.Type.Namespace ?? saved.Namespace, typeOwner) : null),
        new(T("Version"), saved.Definition.Type.Version),
        new(T("Enabled"), T(saved.Definition.Enabled ? "Value.Yes" : "Value.No")),
        new(T("Configuration"), JsonSerializer.Serialize(saved.Definition.Configuration, SavedJson)),
        new(T("Envelope"), JsonSerializer.Serialize(saved.Definition.Envelope, SavedJson)),
        new(T("Documents.Collections"), JsonSerializer.Serialize(saved.Definition.Collections, SavedJson)),
        new(T("DescendantUsePolicy"), JsonSerializer.Serialize(saved.Definition.UsePolicy, SavedJson))];
    private RenderFragment ConfigurationSummary => @<CollectionView TItem="ConfigurationRow" Items="ConfigurationRows" IdentityLabel="@Shared["Configuration"]" InformationLabels="@(new[] { T("Type.Value") })">
        <Identity Context="row"><strong class="configuration-key">@row.Name</strong></Identity>
        <Information Context="row"><CollectionValue Label="@T("Type.Value")"><span class="configuration-value">@if (row.Href is { } href) { <a href="@href">@row.Value</a> } else { @row.Value }</span></CollectionValue></Information>
    </CollectionView>;
    private RenderFragment ConnectionSummary => @<FormSection Title="@T("ConnectedService")">
        @if (resource is { } saved)
        {
            @if (saved.Definition.ConnectedService is { } service)
            {
                <CollectionIdentity DisplayName="@service.Service.Address.Name" Name="@service.Service.Address.Name" Namespace="@service.Service.Address.Namespace.Value" Href="@ServiceUrl(service)" IconName="plug"><IconBadges><ResourceScopeBadge ScopeRef="service.Service.ScopeRef" IconOnly /></IconBadges></CollectionIdentity>
                <p>@T("Generation") · @service.Generation</p>
                @if (saved.Definition.ConnectedServiceType is { } serviceType) { <p>@T("ServiceType") · <code>@serviceType.Type.Namespace/@serviceType.Type.Name</code> · @T("Version") @serviceType.Version</p> }
            }
            else { <p>@T("LocalStorage")</p> }
            <h3>@T("Mappings")</h3>
            @if (saved.Definition.Bindings.Count == 0) { <p>@T("NoMappings")</p> }
            else
            {
                <CollectionView TItem="StorageExportBinding" Items="saved.Definition.Bindings" IdentityLabel="@T("Requirement")" InformationLabels="@(new[] { T("Export"), T("ValueType"), T("Protection") })" RowTestId="storage-mapping">
                    <Identity Context="binding"><strong class="configuration-key">@binding.RequirementId</strong></Identity>
                    <Information Context="binding"><CollectionValue Label="@T("Export")"><CopyableValue Value="@binding.Export.Id" /></CollectionValue><CollectionValue Label="@T("ValueType")">@T($"ValueType.{binding.Export.Type}")</CollectionValue><CollectionValue Label="@T("Protection")">@T($"Protection.{binding.Export.Protection}")</CollectionValue></Information>
                </CollectionView>
            }
        }
    </FormSection>;
    private RenderFragment Diagnostics => @<div class="resource-editor-view">
        <FormSection Title="@T("Diagnostics")">
            @if (resource?.ObservedState is { } state) { <p>@T("ObservedAt"): @state.ObservedAt.ToLocalTime().ToString("g")</p>@foreach (var diagnostic in state.Diagnostics.Take(16)) { <p><code>@diagnostic.Code</code> · @T(StorageErrorKey.For(new AgentstrationApiException(string.Empty, string.Empty, problemTitle: diagnostic.Code)))</p> } }
            else { <p>@T("NotObserved")</p> }
        </FormSection>
        <FormSection Title="@T("ExactType")">@if (TypeChoice is not { } choice) { <p role="status">@T("SavedTypeUnavailable")</p> } else { <StorageTypeEvidence Choice="choice" /> }</FormSection>
    </div>;
    private RenderFragment Dependents => @<FormSection Title="@T("Dependents")" Description="@T("Dependents.Help")">
        @if (!usagesKnown) { <p>@T("Type.UsagesUnknown")</p> }
        else if (usages.Count == 0) { <p>@T("NoDependents")</p> }
        else { <ul class="resource-links">@foreach (var usage in usages) { var usageIdentity = StorageLinks.UsageIdentity(usage); <li><CollectionIdentity DisplayName="@usage.DisplayName" Namespace="@usageIdentity.Namespace" Name="@usage.Name" Href="@UsageUrl(usage)" IconName="layers"><IconBadges>@if (usageIdentity.ScopeRef is { } usageScope) { <ResourceScopeBadge ScopeRef="usageScope" IconOnly /> }</IconBadges><Badges><span>@usage.Kind</span></Badges></CollectionIdentity></li> }</ul> }
        <nav class="management-links" aria-label="@T("RelatedJourneys")"><a href="@ResourceOwnershipContext.PreserveNavigation("/data-sources", Services)">@T("DataSources")</a><a href="@ResourceOwnershipContext.PreserveNavigation("/knowledge-sources", Services)">@T("KnowledgeSources")</a></nav>
    </FormSection>;
}
