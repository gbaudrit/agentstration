@page "/system-explorer"
@using Agentstration.SystemGraph.Contracts
@using Agentstration.Systems.Contracts
@using Agentstration.Web.SystemExplorer
@implements IDisposable
@inject ISystemExplorerClient Client
@inject IConsoleContextProvider ContextProvider
@inject IConsoleNavigationContext NavigationContext
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject Microsoft.Extensions.Localization.IStringLocalizer<SystemExplorerStrings> Localizer

<PageTitle>@T("Title") · Agentstration</PageTitle>
<PageHeader Title="@T("Title")" Description="@T("Description")" TestId="system-explorer">
    <Actions><button type="button" class="button-secondary" @onclick="RefreshAsync" disabled="@busy">@T("Refresh")</button></Actions>
</PageHeader>
<form @onsubmit="ApplyNamespace" @onsubmit:preventDefault>
    <label>@T("Namespace") <input @bind="namespaceInput" maxlength="63" /></label>
    <button class="button-secondary" type="submit">@T("Apply")</button>
</form>
@if (loading) { <LoadingState Message="@T("Loading")" /> }
else if (error is not null) { <ErrorState Message="@error" /> }
else if (page is not null)
{
    <p class="muted" role="status">@T("Partial") <time datetime="@(page.ObservedAt.ToString("O"))">@(page.ObservedAt.LocalDateTime.ToString("g"))</time></p>
    <p><code>@contextScope.Value</code> · <code>@resourceNamespace.Value</code></p>
    <div class="explorer-actions">
        <a class="button-secondary" href="@ExplorerUrl(null)">@T("AllResources")</a>
        @if (page.HasMore && page.NextCursor is not null) { <button class="button-secondary" type="button" @onclick="NextAsync" disabled="@busy">@T("Next")</button> }
        <button class="button-secondary" type="button" @onclick="ExportAsync">@T("Export")</button>
        <label><input type="checkbox" @bind="showDiagram" /> @T("Diagram")</label>
    </div>
    @if (actionError is not null) { <ErrorState Message="@actionError" /> }
    @if (page.Nodes.Count == 0) { <EmptyState Title="@T("Empty")" Message="@T("EmptyHelp")" /> }
    else
    {
        @if (showDiagram && !diagramFailed) { <SystemGraphDiagram @key="page" Page="page" RelationshipLabels="RelationshipLabels" Label="@T("DiagramLabel")" Selected="Select" Failed="DiagramFailed" /> }
        @if (diagramFailed) { <p role="status">@T("DiagramUnavailable")</p> }
        <section aria-label="@T("Resources")">
            <h2>@T("Resources")</h2>
            <div class="explorer-scroll"><table class="data-grid"><thead><tr><th>@T("Name")</th><th>@T("Kind")</th><th>@T("Owner")</th><th>@T("State")</th><th>@T("Evidence")</th><th></th></tr></thead><tbody>
            @foreach (var node in page.Nodes)
            {
                <tr @key="node.Id" data-testid="explorer-node" aria-selected="@(selected?.Id == node.Id)"><td><button type="button" class="text-button" @onclick="() => Select(node.Id)">@(node.DisplayName ?? node.Identity.Name)</button><br /><code>@node.Identity.Namespace/@node.Identity.Name</code></td><td><code>@node.Identity.Kind</code></td><td><code>@node.Identity.OwnerScope.Value</code></td><td>@NodeState(node.State)</td><td><code>@(node.Evidence?.Publication ?? node.Evidence?.Generation?.ToString() ?? "—")</code></td><td><a href="@ExplorerUrl(node.Id)">@T("Neighbors")</a></td></tr>
            }
            </tbody></table></div>
        </section>
        @if (selected is not null)
        {
            <section class="panel" aria-label="@T("Selection")" data-testid="explorer-selection">
                <h2>@(selected.DisplayName ?? selected.Identity.Name)</h2><p><code>@selected.Id</code></p>
                @if (DetailsUrl(selected) is { } url) { <a class="button-secondary" href="@url">@T("OpenDetails")</a> }
                @if (selected.Identity.Kind == "Flow") { <a class="button-secondary" href="@DetailsUrl(selected, true)">@T("OpenDesigner")</a> }
                <pre class="explorer-json">@JsonSerializer.Serialize(selected, JsonOptions)</pre>
                <h3>@T("Relations")</h3>
                <ul>@foreach (var edge in page.Relations.Where(edge => edge.Source == selected.Id || edge.Target == selected.Id))
                    { <li><code>@edge.Source</code> — @RelationKind(edge.Kind) → <code>@edge.Target</code><br /><code>@edge.SourceField</code> <code>@edge.Resolution</code> <code>@edge.Assessment</code></li> }</ul>
            </section>
        }
    }
    <section class="panel" aria-label="@T("Systems")">
        <h2>@T("Systems")</h2><p>@T("SystemsHelp")</p>
        <label>@T("Owner") <select value="@ownerScope.Value" @onchange="ChangeOwner">
            @foreach (var scope in page.Scopes) { <option value="@scope.Scope.Value">@scope.Scope.Value</option> }
        </select></label>
        @if (canWrite && ownerScope == contextScope)
        {
            <form @onsubmit="CreateAsync" @onsubmit:preventDefault><label>@T("NewSystem") <input @bind="newLabel" maxlength="200" required /></label><button class="button-primary" type="submit" disabled="@busy">@T("Create")</button></form>
        }
        <label>@T("System") <select value="@(system?.Uid.ToString() ?? "")" @onchange="ChangeSystem"><option value="">@T("ChooseSystem")</option>@foreach (var value in systems) { <option value="@value.Uid">@value.DisplayName</option> }</select></label>
        @if (system is not null)
        {
            <p><code>@system.Namespace/@system.Name</code> · <code>@system.Uid</code></p>
            @if (canWrite && ownerScope == contextScope)
            {
                <form @onsubmit="RenameAsync" @onsubmit:preventDefault><label>@T("Name") <input @bind="renameLabel" maxlength="200" required /></label><button class="button-secondary" type="submit" disabled="@busy">@T("Rename")</button></form>
                @if (selected is not null && selected.Id == SystemGraphIds.Definition(selected.Identity.ResourceUid) && selected.Identity.ResourceUid != system.Uid)
                { <button class="button-secondary" type="button" disabled="@busy" @onclick="AddMemberAsync">@T("AddSelected")</button> }
            }
            <ul>@foreach (var member in system.Members)
            { <li @key="member.Uid"><a href="@ExplorerUrl(SystemGraphIds.Definition(member.Uid))">@member.Kind · @member.Namespace/@member.Name</a> <code>@member.ScopeRef.Value</code>
                @if (canWrite && ownerScope == contextScope) { <button type="button" class="text-button" disabled="@busy" @onclick="() => RemoveMemberAsync(member.Uid)">@T("Remove")</button> }</li> }</ul>
            @if (canDelete && ownerScope == contextScope)
            {
                @if (!confirmDelete) { <button type="button" class="button-secondary" @onclick="() => confirmDelete = true">@T("Delete")</button> }
                else { <p>@T("DeleteHelp")</p><button type="button" class="button-danger" disabled="@busy" @onclick="DeleteAsync">@T("ConfirmDelete")</button><button type="button" class="button-secondary" @onclick="() => confirmDelete = false">@T("Cancel")</button> }
            }
        }
    </section>
}
