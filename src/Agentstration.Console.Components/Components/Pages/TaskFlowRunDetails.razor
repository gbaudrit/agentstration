@page "/tasks/{TaskId:guid}/flowruns/{RunId}"
@implements IDisposable
@inject IWorkApiClient Client
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@inject Microsoft.Extensions.Localization.IStringLocalizer<TaskFlowRunDetailsStrings> Localizer

<PageTitle>@(run is null ? T("Title") : run.Id) · Agentstration</PageTitle>
<div data-testid="flow-observability-task-run-details" data-task-id="@TaskId" data-run-id="@RunId">
    <ResourceDetailsTemplate Name="@(run?.Id ?? RunId)" ResourceType="@T("Title")" Domain="flow" IconName="sitemap"
                             StatusText="@(run is null ? null : Label("Status", run.Status))" Status="@(run is null ? UiStatus.Neutral : PlatformDashboardService.ToStatus(run.Status.ToString()))"
                             Sections="Sections" ResourceIdentity="@loadedKey" DefaultSection="overview" SectionState="sectionState" SelectionChanged="SelectSection"
                             LoadState="loadState" OnRetry="RetryAsync" OnRefresh="RefreshAsync">
        <Actions><a class="button-secondary" href="@ResourceOwnershipContext.PreserveNavigation($"/tasks/{TaskId:D}", Services)">@T("BackToTask")</a></Actions>
        <Content>
        @if (run is not null)
        {
        <div data-task-run-section="overview" hidden="@(!sectionState.Is("overview"))">
            <section class="metric-grid">
                <MetricCard Label="@T("Status")" Value="@Label("Status", run.Status)" Status="@PlatformDashboardService.ToStatus(run.Status.ToString())" />
                <MetricCard Label="@T("FlowVersion")" Value="@run.FlowVersion" Detail="@($"{run.FlowId.Namespace}/{run.FlowId.Value} · {Label("DefinitionState", run.DefinitionState)}")" />
            </section>
            <FormSection Title="@Shared["Identity"]"><dl class="resource-details">
                <dt>@T("RunId")</dt><dd><CopyableValue Value="@run.Id" /></dd>
                <dt>@T("Task")</dt><dd><a href="@ResourceOwnershipContext.PreserveNavigation($"/tasks/{TaskId:D}", Services)">@TaskId</a></dd>
                <dt>@T("CorrelationId")</dt><dd><CopyableValue Value="@(run.CorrelationId ?? "—")" /></dd>
                <dt>@T("ExecutionScope")</dt><dd><code>@run.ExecutionScopeRef</code></dd>
            </dl></FormSection>
            <FormSection Title="@Shared["Configuration"]"><dl class="resource-details">
                <dt>@T("FlowVersion")</dt><dd>@run.FlowId.Namespace/@run.FlowId.Value · @run.FlowVersion</dd>
                <dt>@T("DefinitionState")</dt><dd>@Label("DefinitionState", run.DefinitionState)</dd>
                <dt>@T("TriggerStartedBy")</dt><dd>@Label("Trigger", run.Trigger) · @(run.StartedBy ?? "—")</dd>
            </dl></FormSection>
        </div>
    @if (run.Error is not null)
    {
        <article class="panel run-error"><strong>@run.Error.Code</strong><p>@RunErrorMessage(run.Error)</p>@if (RunErrorDetail(run.Error) is { } detail) { <code>@detail</code> }</article>
    }
    @if (sectionState.HasVisited("execution"))
    {
    <div data-task-run-section="execution" hidden="@(!sectionState.Is("execution"))">
    <section class="designer-layout run-layout @(inspectorVisible ? null : "inspector-collapsed")">
        <div>
            <FlowTopologyViewer Graph="Topology" SelectedKey="selected?.StepName" SelectedKeyChanged="SelectStep"
                                ShowInspectorControl="true" InspectorVisible="inspectorVisible" InspectorVisibleChanged="SetInspectorVisible"
                                InitiallyFit="true" />
            <article class="panel io-panel"><div class="panel-header"><h2>@T("RunInputOutput")</h2></div><div class="io-grid"><div><span class="field-label">@T("Input")</span><pre>@Pretty(run.Input)</pre></div><div><span class="field-label">@T("Output")</span><pre>@Pretty(run.Output)</pre></div></div></article>
        </div>
        @if (inspectorVisible)
        {
        <article class="panel inspector step-inspector">
            <div class="panel-header"><h2>@T("StepDiagnostic")</h2></div>
            @if (selected is null) { <p class="muted">@T("SelectStep")</p> }
            else
            {
                <dl class="details-list"><dt>@T("Status")</dt><dd>@Label("Status", selected.Status)</dd><dt>@T("Type")</dt><dd>@selected.StepType</dd><dt>@T("Duration")</dt><dd>@Duration(selected.StartedAt, selected.CompletedAt)</dd><dt>@T("Attempt")</dt><dd>@selected.Attempt</dd><dt>@T("Transition")</dt><dd>@(selected.SelectedTransition ?? "—")</dd><dt>@T("Agent")</dt><dd>@(selected.AgentResourceId ?? "—")</dd><dt>@T("Provider")</dt><dd>@(selected.Provider ?? "—")</dd><dt>@T("Tokens")</dt><dd>@(selected.Usage is null ? "—" : $"{selected.Usage.InputTokens ?? 0} {T("In")} / {selected.Usage.OutputTokens ?? 0} {T("Out")}")</dd></dl>
                <span class="field-label">@T("DeclaredInput")</span><pre>@Pretty(selected.DeclaredInput)</pre><span class="field-label">@T("ResolvedInput")</span><pre>@Pretty(selected.ResolvedInput)</pre><span class="field-label">@T("Output")</span><pre>@Pretty(selected.Output)</pre><span class="field-label">@T("Logs")</span><pre>@string.Join(Environment.NewLine, selected.Logs)</pre>
            }
        </article>
        }
    </section>
    </div>
    }
        }
        </Content>
    </ResourceDetailsTemplate>

</div>
@code {
    [Parameter] public Guid TaskId { get; set; }
    [Parameter] public string RunId { get; set; } = string.Empty;
    private readonly CancellationTokenSource lifetime = new();
    private FlowRun? run;
    private FlowStepRun? selected;
    private bool inspectorVisible, loading;
    private readonly ResourceSectionState sectionState = new();
    private ResourceLoadState loadState = new(ResourceLoadStatus.Loading);
    private string? loadedKey;
    private long loadVersion;
    private IReadOnlyList<ResourceNavigationItem> Sections => [new("overview", Shared["Overview"], "home"), new("execution", T("FlowTopology"), "sitemap")];
    private void SelectSection(string? value) => sectionState.Select(value ?? "overview");
    private FlowTopologyGraph Topology => run is null ? new([], [], "horizontal", T("FlowTopology")) : FlowTopologyProjector.ProjectPreview(run);
    protected override Task OnParametersSetAsync()
    {
        var key = $"{TaskId}|{RunId}|{ResourceOwnershipContext.TryGetCurrent(Services)}";
        if (loadedKey == key) return Task.CompletedTask;
        loadedKey = key; ClearInspection(); sectionState.Reset(key);
        return LoadAsync(refresh: false);
    }
    private Task RetryAsync() => loading ? Task.CompletedTask : LoadAsync(refresh: run is not null);
    private Task RefreshAsync() => loading ? Task.CompletedTask : LoadAsync(refresh: true);
    private void ClearInspection() { run = null; selected = null; inspectorVisible = false; }
    private async Task LoadAsync(bool refresh)
    {
        var request = ++loadVersion; var requestedTask = TaskId; var requestedRun = RunId;
        var expectedScope = refresh ? run?.ExecutionScopeRef : null;
        loading = true;
        if (!refresh) ClearInspection();
        loadState = new(refresh && run is not null ? ResourceLoadStatus.Refreshing : ResourceLoadStatus.Loading) { HasContent = run is not null };
        try
        {
            var saved = await Client.GetTaskFlowRunAsync(requestedTask, requestedRun, lifetime.Token);
            if (request != loadVersion) return;
            if (saved.Id != requestedRun || !Guid.TryParse(saved.WorkTaskId, out var actualTask) || actualTask != requestedTask
                || expectedScope is { } scope && saved.ExecutionScopeRef != scope)
            {
                ClearInspection(); loadState = new(ResourceLoadStatus.NotFound) { Message = T("NotFoundMessage") }; return;
            }
            run = saved; selected = run.Steps.FirstOrDefault(value => value.StepName == selected?.StepName) ?? run.Steps.FirstOrDefault();
            loadState = new(ResourceLoadStatus.Ready) { HasContent = true };
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception)
        {
            if (request != loadVersion) return;
            var status = exception is AgentstrationApiException api ? api.StatusCode switch
            {
                System.Net.HttpStatusCode.NotFound => ResourceLoadStatus.NotFound,
                System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden => ResourceLoadStatus.Forbidden,
                _ => ResourceLoadStatus.Failed
            } : ResourceLoadStatus.Failed;
            if (status is ResourceLoadStatus.NotFound or ResourceLoadStatus.Forbidden) ClearInspection();
            loadState = new(status) { HasContent = run is not null, Message = status == ResourceLoadStatus.NotFound ? T("NotFoundMessage") : null, ErrorId = (exception as AgentstrationApiException)?.ErrorId };
        }
        finally { if (request == loadVersion) loading = false; }
    }
    private void SelectStep(string name) => selected = run?.Steps.FirstOrDefault(value => value.StepName == name);
    private void SetInspectorVisible(bool value) => inspectorVisible = value;
    private string T(string key) => Localizer[key];
    private string RunErrorMessage(FlowRunError error) => error.Code switch
    {
        "agent_model_profile_unavailable" => T("Error.AgentModelProfileUnavailable"),
        "model_output_token_limit" => T("Error.ModelOutputTokenLimit"),
        "model_empty_response" => T("Error.ModelEmptyResponse"),
        _ => error.Message
    };
    private static string? RunErrorDetail(FlowRunError error) => error.Code == "agent_model_profile_unavailable"
        ? error.Message : error.Details;
    private string Label(string prefix, object value) { var raw = value.ToString() ?? string.Empty; var localized = Localizer[$"{prefix}.{raw}"]; return localized.ResourceNotFound ? raw : localized.Value; }
    private static string Pretty(JsonElement value) => JsonSerializer.Serialize(value, new JsonSerializerOptions { WriteIndented = true });
    private static string Pretty(JsonElement? value) => value is null ? "—" : Pretty(value.Value);
    private static string Duration(DateTimeOffset? start, DateTimeOffset? end) { if (start is null) return "—"; var value = (end ?? DateTimeOffset.UtcNow) - start.Value; return value.TotalSeconds >= 1 ? $"{value.TotalSeconds:0.##} s" : $"{value.TotalMilliseconds:0} ms"; }
    public void Dispose() { ++loadVersion; lifetime.Cancel(); lifetime.Dispose(); }
}
