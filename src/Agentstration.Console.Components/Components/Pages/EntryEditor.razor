@page "/entries/{Name}"
@page "/namespaces/{EntryNamespace}/entries/{Name}"
@implements IDisposable
@using Agentstration.Resources
@rendermode InteractiveServer
@inject IEntryAdministrationApiClient Client
@inject NavigationManager Navigation
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<WorkplaceStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared

<UnsavedNavigationGuard IsDirty="HasDraft" HasUnsavedChanges="@(() => HasDraft)" />
<PageTitle>@(IsNew ? T("CreateEntry") : saved?.Value.DisplayName ?? Name) · Agentstration</PageTitle>
@{
    var presentations = Presentations;
    RenderFragment feedback = @<div>@if (!string.IsNullOrWhiteSpace(message)) { <div class="form-alert @(hasError ? "form-alert-danger" : "form-alert-success")" role="@(hasError ? "alert" : "status")" data-testid="entry-message">@message</div> }
        @if (newerEntry is not null) { <div class="form-alert form-alert-warning" role="status">@T("EntryRefreshDraftConflict")</div> }
        @if (HasRawDraft && !sectionState.Is("yaml")) { <div class="form-alert form-alert-warning" role="status">@Shared["YamlConflict"]<button type="button" class="text-button" @onclick="DiscardYaml">@Shared["DiscardYaml"]</button></div> }
        @if (validation is { IsValid: false }) { <div class="form-alert form-alert-danger" role="alert"><strong>@T("ValidationIssues")</strong><ul>@foreach (var issue in validation.Issues) { <li><code>@issue.Code</code> — @issue.Message</li> }</ul></div> }
        @if (!EntryResourceNamespace.IsDefault) { <p class="muted">@T(IsPackOwned ? "PackManagedEntryHelp" : "NamespacedEntryHelp")</p> }
    </div>;
    RenderFragment definition = @<ResourceDefinitionForm @ref="definitionForm" EditContext="formContext" FieldLabels="FieldLabels" Id="entry-resource-form" FormName="entry-definition"
        FieldsTestId="entry-definition-fields" data-interactive="@(interactive ? "true" : "false")" ReadOnly="@(!CanWrite)" Busy="busy" Disabled="HasRawDraft"
        SectionState="@(IsNew ? null : sectionState)" Sections="presentations" SectionContent="@(IsNew ? null : DefinitionContent)" SectionRequested="ShowSection" InvalidInputChanged="value => invalidInput = value" OnValidSubmit="SaveAsync">
        <ChildContent>@if (IsNew) { <p class="required-fields-note"><span aria-hidden="true">*</span> @Shared["RequiredFields"]</p><CreationWizard @ref="wizard" Steps="Steps" Busy="busy" OnFinish="FinishAsync" OnStepReady="StepReadyAsync" FinishLabel="@T("PublishPinnedVersion")" FinishTestId="entry-publish" /> }</ChildContent>
    </ResourceDefinitionForm>;
    RenderFragment yaml = @<ResourceYamlEditor Value="@rawYaml" ValueChanged="RawChanged" ReadOnly="@(!CanWrite)" Busy="busy" Error="@rawError" Label="@T("ResourceManifest")" />;
}
@if (IsNew)
{
    <PageHeader Title="@T("CreateEntry")" Description="@T("Entry.Description")"><Actions><a class="button-secondary" href="@BackUrl">@T("BackToEntries")</a></Actions></PageHeader>
    @if (loading) { <LoadingState Message="@T("LoadingEntry")" /> }
    else if (loadState.BlocksContent) { <ResourceLoadFeedback State="loadState" OnRetry="RefreshAsync" /> }
    else {
        @feedback
        <FormActions><button class="button-secondary" type="button" @onclick="ToggleYaml">@(sectionState.Is("yaml") ? T("EntryForm") : Shared["Yaml"])</button><button class="button-secondary" type="button" @onclick="SaveAsync" disabled="@(busy || !CanWrite || HasRawDraft)" data-testid="entry-save-draft">@T("SaveDraft")</button>@ValidateActions</FormActions>
        @if (sectionState.Is("yaml")) { <FormSection Title="@T("EntryYaml")" TestId="entry-yaml-editor">@yaml<FormActions>@YamlActions</FormActions></FormSection> }
        <div hidden="@sectionState.Is("yaml")">@definition</div>
    }
}
else
{
    <ResourceDetailsTemplate Name="@(saved?.Value.DisplayName ?? Name)" ResourceType="@T("WorkplaceEntry")" Description="@saved?.Value.Description" TechnicalName="@(saved?.Value.Name ?? Name)" Namespace="@EntryResourceNamespace.Value" Domain="work" IconName="layout-grid"
        ResourceIdentity="@($"{loadedKey}|{saved?.Value.WorkspaceId}")" SectionState="sectionState" SectionPresentations="presentations" DefinitionSections="DefinitionSections" AdditionalSections="AdditionalSections"
        LoadState="loadState" OnRetry="RefreshAsync" OnRefresh="RefreshAsync" HasDraft="HasDraft" Busy="busy" DefinitionReadOnlyReason="ReadOnlyReason"
        SelectionChanged="SelectSectionAsync" NavigationLabel="@T("EntrySections")" SectionTestIdPrefix="entry" TestId="resource-entry-editor" YamlTitle="@T("EntryYaml")" YamlDescription="@T(CanWrite ? "EntryYamlEditableHelp" : "EntryYamlReadOnlyHelp")">
        <Metadata><div class="entry-summary-bar" aria-label="@T("EntryStatus")" data-testid="entry-status" data-state="@(published is null ? "draft" : "published")"><StatusBadge Text="@T(published is null ? "Draft" : "Published")" Status="@(published is null ? UiStatus.Neutral : UiStatus.Success)" /><span>@(published is null ? T("Revision", draftRevision) : T("Version", published.Version))</span></div></Metadata>
        <PrimaryActions>@if (saved is not null && CanWrite) { <button class="button-primary" type="button" @onclick="PublishAsync" disabled="@(busy || loading || HasRawDraft)" data-testid="entry-publish">@T("PublishPinnedVersion")</button> }</PrimaryActions>
        <Actions>@if (published is not null) { <a class="button-secondary" href="@WorkspaceConfigurationUrl">@T("UseInWorkplace")</a> }<a class="button-secondary" href="@BackUrl">@T("BackToEntries")</a></Actions>
        <Feedback>@feedback</Feedback>
        <OverviewMetrics>@if (saved is not null) { <MetricCard Label="@T("DraftRevision")" Value="@draftRevision.ToString(System.Globalization.CultureInfo.CurrentCulture)" /><MetricCard Label="@T("PublishedVersionLabel")" Value="@(published?.Version.ToString(System.Globalization.CultureInfo.CurrentCulture) ?? "—")" /><MetricCard Label="@T("PublishedDashboards")" Value="@(usageLoaded ? PublishedUsages.Count.ToString(System.Globalization.CultureInfo.CurrentCulture) : "—")" /> }</OverviewMetrics>
        <IdentityDetails><dt>@T("EntryExecutionWorkspace")</dt><dd>@WorkspaceDisplayName</dd></IdentityDetails>
        <OverviewConfiguration><CollectionView TItem="ConfigurationEntry" Items="SavedConfiguration" IdentityLabel="@Shared["Configuration"]" InformationLabels="@(new[] { Shared["Saved"].Value })"><Identity Context="entry"><strong class="configuration-key">@entry.Label</strong></Identity><Information Context="entry"><CollectionValue Label="@Shared["Saved"]"><span class="configuration-value">@entry.Value</span></CollectionValue></Information></CollectionView></OverviewConfiguration>
        <DefinitionContent Context="path">@definition</DefinitionContent>
        <AdditionalContent Context="path">@if (path == "preview") { @Preview } else if (path == "usage") { @Usage } else { @Versions }</AdditionalContent>
        <YamlContent>@yaml</YamlContent>
        <DraftActions><button type="button" class="button-secondary" disabled="@(busy || loading)" @onclick="Discard">@Shared["Discard"]</button>@if (sectionState.Is("yaml")) { <button class="button-primary" type="button" @onclick="SaveRawAsync" disabled="@(busy || loading)">@T("SaveYamlDraft")</button> } else { <button class="button-primary" type="submit" form="entry-resource-form" disabled="@(busy || loading || HasRawDraft)" data-testid="entry-save-draft">@T("SaveDraft")</button> }</DraftActions>
    </ResourceDetailsTemplate>
}

@code {
    private RenderFragment IdentityFields => @<FormSection Title="@T("Identity")" TestId="entry-identity-section"><FormGrid>
        <ResourceIdentityFields DisplayName="@model.DisplayName" DisplayNameChanged="value => model.DisplayName = value" DisplayNameExpression="@(() => model.DisplayName)" TechnicalName="@model.Name" TechnicalNameChanged="value => model.Name = value" TechnicalNameExpression="@(() => model.Name)" Policy="ResourceNamePolicy.Entry" IsNew="IsNew" DisplayNameTestId="entry-display-name" TechnicalNameTestId="entry-name" />
        <FormField Label="@Shared["Namespace"]"><ClearableText Value="@EntryResourceNamespace.Value" Disabled /></FormField>
        <FormField Label="@T("EntryExecutionWorkspace")"><span class="resource-text">@WorkspaceDisplayName</span></FormField>
        <FormField Label="@T("Description")" Optional Class="form-span-2"><ClearableText Multiline @bind-Value="model.Description" rows="3" data-testid="entry-description" /></FormField>
    </FormGrid></FormSection>;
    private RenderFragment EntryExposureFields => @<div class="resource-editor-view"><FormField Class="form-span-2" Label="@T("EntryExposure")"><ChildContent><FormSection Title="@T("EntryExposure")" Eyebrow="@T("Exposure")" Description="@T("EntryExposureHelp")"><ChildContent>
                <div class="entry-toggle-list">
                    <label class="entry-toggle resource-enabled-toggle"><FormCheckbox role="switch" data-testid="exposure-workplace" @bind-Value="model.ExposeWorkplace" /><span><strong>@T("Exposure.Workplace")</strong><small>@T("Exposure.Workplace.Help")</small></span></label>
                    <div class="entry-toggle-card" data-testid="exposure-console-card">
                        <label class="entry-toggle resource-enabled-toggle"><FormCheckbox role="switch" data-testid="exposure-console" @bind-Value="model.ExposeConsole" /><span><strong>@T("Exposure.Console")</strong><small>@T("Exposure.Console.Help")</small></span></label>
                        @if (model.ExposeConsole)
                        {
                            <label class="entry-toggle entry-toggle-option resource-enabled-toggle"><FormCheckbox role="switch" data-testid="console-fallback" @bind-Value="model.ConsoleFallback" /><span><strong>@T("ConsoleRole.Fallback")</strong><small>@T("ConsoleRole.Fallback.Help")</small></span></label>
                        }
                    </div>
                </div>
                @if (model.ExposeWorkplace)
                {
                    <div class="entry-toggle-list">
                        <label class="entry-toggle resource-enabled-toggle"><FormCheckbox role="switch" data-testid="placement-owning-space" @bind-Value="model.ExposeOwningSpace" /><span><strong>@T("Placement.OwningSpace")</strong><small>@T("Placement.OwningSpace.Help")</small></span></label>
                        <label class="entry-toggle resource-enabled-toggle"><FormCheckbox role="switch" data-testid="placement-tenant-home" @bind-Value="model.ExposeTenantHome" /><span><strong>@T("Placement.TenantHome")</strong><small>@T("Placement.TenantHome.Help")</small></span></label>
                    </div>
                }
            </ChildContent></FormSection></ChildContent><Validation><ValidationMessage For="() => model.ExposeConsole" /><ValidationMessage For="() => model.ExposeOwningSpace" /></Validation></FormField></div>;
    private RenderFragment WorkplaceAppearanceFields => @<div class="resource-editor-view"><FormSection Title="@T("WorkplaceAppearance")" Eyebrow="@T("Presentation")" TestId="entry-appearance-section"><ChildContent>
                <FormGrid>
                <FormField Label="@T("Presentation")"><ClearableSelect TValue="EntryPresentationKind" data-testid="presentation-kind" @bind-Value="model.PresentationKind"><option value="Prompt">@T("Presentation.Prompt")</option><option value="Form">@T("Presentation.Form")</option></ClearableSelect></FormField>
                <FormField Label="@T("Placeholder")"><ClearableText @bind-Value="model.Placeholder" data-testid="entry-placeholder" /></FormField>
                <div class="form-span-2">
                    <IconPicker @bind-Value="model.Icon"
                                SelectedLabel="@T("SelectedIcon")"
                                NoneLabel="@T("NoIcon")"
                                ClearLabel="@T("ClearIcon")"
                                SearchLabel="@T("SearchIcons")"
                                SearchPlaceholder="@T("SearchIconsPlaceholder")"
                                ChoicesLabel="@T("IconChoices")"
                                NoResultsLabel="@T("NoIconsFound")"
                                MoreResultsLabel="@T("MoreIconsAvailable")" />
                </div>
                <label class="entry-toggle resource-enabled-toggle"><FormCheckbox role="switch" @bind-Value="model.AllowAttachments" /><span>@T("AllowAttachments")</span></label>
                <label class="entry-toggle resource-enabled-toggle"><FormCheckbox role="switch" @bind-Value="model.AllowVoiceInput" /><span>@T("AllowVoiceInput")</span></label>
                </FormGrid>
            </ChildContent></FormSection></div>;
    private RenderFragment InteractionPresentationFields => @<div class="resource-editor-view"><FormSection Title="@T("InteractionPresentation")" Eyebrow="@T("ExecutionExperience")" Description="@T("InteractionHelp")" TestId="entry-interaction-section"><ChildContent>
                <FormGrid>
                    <FormField Label="@T("AgentIdentities")" Help="@T("ParticipantVisibilityHelp")"><ClearableSelect TValue="EntryParticipantVisibility" data-testid="participants-visibility" @bind-Value="model.ParticipantsVisibility">@foreach (var value in Enum.GetValues<EntryParticipantVisibility>()) { <option value="@value">@EnumLabel("Participants", value)</option> }</ClearableSelect></FormField>
                    <FormField Label="@T("Progress")"><ClearableSelect TValue="EntryProgressVisibility" data-testid="progress-visibility" @bind-Value="model.ProgressVisibility">@foreach (var value in Enum.GetValues<EntryProgressVisibility>()) { <option value="@value">@EnumLabel("Progress", value)</option> }</ClearableSelect></FormField>
                    <FormField Label="@T("Task")"><ClearableSelect TValue="EntryTaskDisplay" data-testid="task-display" @bind-Value="model.TaskDisplay">@foreach (var value in Enum.GetValues<EntryTaskDisplay>()) { <option value="@value">@EnumLabel("TaskDisplay", value)</option> }</ClearableSelect></FormField>
                    <FormField Label="@T("Results")"><ClearableSelect TValue="EntryResultDisplay" data-testid="results-display" @bind-Value="model.ResultDisplay">@foreach (var value in Enum.GetValues<EntryResultDisplay>()) { <option value="@value">@EnumLabel("ResultDisplay", value)</option> }</ClearableSelect></FormField>
                </FormGrid>
            </ChildContent></FormSection></div>;
    private RenderFragment InputSchemaFields => @<div class="resource-editor-view"><FormField Class="form-span-2" Label="@T("InputSchema")"><ChildContent><FormSection Title="@T("InputSchema")" Eyebrow="@T("Fields")" TestId="entry-fields-section"><Actions><button class="button-secondary" data-testid="add-field" type="button" @onclick="AddField">@T("AddField")</button></Actions><ChildContent>
                <div class="entry-card-list">
                    @for (var index = 0; index < model.Fields.Count; index++)
                    {
                        var entryField = model.Fields[index];
                            <article class="entry-field-card" @key="entryField" data-testid="entry-field-card" data-field-index="@index">
                            <header><div><strong>@FieldTitle(entryField)</strong><span>@EnumLabel("FieldType", entryField.Type)</span></div>@if (entryField.Primary) { <StatusBadge Text="@T("PrimaryInput")" Status="UiStatus.Info" /> }</header>
                            <FormGrid>
                                <FormField Label="@T("Name")"><ClearableText @bind-Value="entryField.Name" data-testid="entry-field-name" /></FormField>
                                <FormField Label="@T("Label")"><ClearableText @bind-Value="entryField.Label" data-testid="entry-field-label" /></FormField>
                                <FormField Label="@T("Description")" Optional="true"><ClearableText @bind-Value="entryField.Description" data-testid="entry-field-description" /></FormField>
                                <FormField Label="@T("Placeholder")"><ClearableText @bind-Value="entryField.Placeholder" data-testid="entry-field-placeholder" /></FormField>
                                <FormField Label="@T("Type")"><ClearableSelect TValue="EntryFieldType" @bind-Value="entryField.Type" data-testid="entry-field-type">@foreach (var type in Enum.GetValues<EntryFieldType>()) { <option value="@type">@EnumLabel("FieldType", type)</option> }</ClearableSelect></FormField>
                                @if (entryField.Type is EntryFieldType.Choice or EntryFieldType.MultiChoice) { <FormField Label="@T("OptionsValueLabel")"><ClearableText @bind-Value="entryField.Options" /></FormField> }
                                <div class="entry-toggle-group">
                                    <label class="entry-toggle resource-enabled-toggle"><FormCheckbox role="switch" @bind-Value="entryField.Required" data-testid="entry-field-required" /><span>@T("Required")</span></label>
                                    <label class="entry-toggle resource-enabled-toggle"><input type="radio" name="primary-input" checked="@entryField.Primary" @onclick="() => SetPrimary(entryField)" data-testid="entry-field-primary" /><span>@T("PrimaryInput")</span></label>
                                </div>
                                <div class="entry-row-actions">
                                    <button type="button" class="button-secondary" title="@T("MoveUp")" aria-label="@T("MoveFieldUp")" @onclick="() => MoveField(entryField, -1)" disabled="@(index == 0)">↑</button>
                                    <button type="button" class="button-secondary" title="@T("MoveDown")" aria-label="@T("MoveFieldDown")" @onclick="() => MoveField(entryField, 1)" disabled="@(index == model.Fields.Count - 1)">↓</button>
                                    <button type="button" class="text-button entry-remove" @onclick="() => RemoveField(entryField)" disabled="@(model.Fields.Count == 1)">@T("Remove")</button>
                                </div>
                            </FormGrid>
                        </article>
                    }
                </div>
            </ChildContent></FormSection></ChildContent><Validation><ValidationMessage For="() => model.Fields" /></Validation></FormField></div>;
    private RenderFragment BindingAndResolvedTargetFields => @<div class="resource-editor-view"><FormSection Title="@T("BindingAndResolvedTarget")" Eyebrow="@T("Execution")" TestId="entry-binding-section"><ChildContent>
                <FormGrid>
                    <FormField Label="@T("TargetKind")"><ClearableSelect TValue="EntryBindingKind" data-testid="target-kind" Value="@model.BindingKind" ValueExpression="@(() => model.BindingKind)" ValueChanged="value => BindingKindChanged(new ChangeEventArgs { Value = value })"><option value="Agent">@T("Binding.Agent")</option><option value="Flow">@T("Flow")</option></ClearableSelect></FormField>
                    <FormField Required Label="@T("TargetResource")"><Validation><ValidationMessage For="() => model.ResourceId" /></Validation><ChildContent><ClearableSelect TValue="string" data-testid="target-resource" @bind-Value="model.ResourceId" @bind-Value:after="BindingSelectionChanged"><option value="">@T("SelectTarget", EnumLabel("Binding", model.BindingKind))</option>@if (SelectedResource is null && model.ResourceId.Length > 0) { <option value="@model.ResourceId">@model.ResourceId</option> }@foreach (var resource in resources) { <option value="@ResourceKey(resource)">@resource.Name · @resource.ScopeRef · @resource.Namespace · @resource.Version · @resource.State</option> }</ClearableSelect></ChildContent></FormField>
                </FormGrid>
                @if (model.BindingKind == EntryBindingKind.Agent) { <p class="resource-hint">@T("DirectAgentFlowHelp")</p> }
                <div class="entry-resolution-grid">
                    <article><h3>@T("DeclaredBinding")</h3><dl class="entry-facts"><dt>@T("Type")</dt><dd>@EnumLabel("Binding", model.BindingKind)</dd><dt>@T("Resource")</dt><dd>@BindingResourceName</dd><dt>@T("State")</dt><dd>@(SelectedResource?.State ?? T("NotSelected"))</dd>@if (SelectedModelProfile is not null) { <dt>@T("ModelProfile")</dt><dd>@SelectedModelProfile</dd> }</dl>@if (!string.IsNullOrWhiteSpace(model.ResourceId)) { <details><summary>@T("ResourceId")</summary><code>@model.ResourceId</code></details> }</article>
                    <article><h3>@T("ResolvedTarget")</h3><dl class="entry-facts"><dt>@T("Flow")</dt><dd>@ResolvedFlowName</dd><dt>@T("VersionLabel")</dt><dd>@(published?.ResolvedTarget.Version ?? T("ResolvedOnPublication"))</dd><dt>@T("Strategy")</dt><dd>@T("Pinned")</dd></dl>@if (published is not null) { <details><summary>@T("FlowResourceId")</summary><code>@published.ResolvedTarget.FlowResourceId</code></details> }</article>
                </div>
            </ChildContent></FormSection></div>;
    private RenderFragment ConversationAndExecutionFields => @<div class="resource-editor-view"><FormSection Title="@T("ConversationAndExecution")" Eyebrow="@T("Behavior")" TestId="entry-behavior-section"><ChildContent>
                <div class="entry-behavior-layout">
                    <FormField Label="@T("TaskCreation")"><ClearableSelect TValue="TaskCreationMode" @bind-Value="model.TaskMode" data-testid="entry-task-mode"><option value="Automatic">@T("TaskCreation.Automatic")</option><option value="OnDemand">@T("TaskCreation.OnDemand")</option><option value="Never">@T("TaskCreation.Never")</option></ClearableSelect></FormField>
                    <div class="entry-toggle-list">
                        <label class="entry-toggle resource-enabled-toggle"><FormCheckbox role="switch" @bind-Value="model.AllowConversation" data-testid="entry-allow-conversation" /><span><strong>@T("AllowConversation")</strong><small>@T("AllowConversationHelp")</small></span></label>
                        <label class="entry-toggle resource-enabled-toggle"><FormCheckbox role="switch" @bind-Value="model.StreamResponse" data-testid="entry-stream-response" /><span><strong>@T("StreamResponse")</strong><small>@T("StreamResponseHelp")</small></span></label>
                    </div>
                </div>
            </ChildContent></FormSection></div>;
    private RenderFragment SuggestionsFields => @<div class="resource-editor-view"><FormField Class="form-span-2" Label="@T("PromptStarters")"><ChildContent><FormSection Title="@T("PromptStarters")" Eyebrow="@T("Suggestions")" TestId="entry-suggestions-section"><Actions><button class="button-secondary" type="button" @onclick="AddSuggestion" data-testid="entry-add-suggestion">@T("AddSuggestion")</button></Actions><ChildContent>
                @if (model.Suggestions.Count == 0) { <p class="entry-empty-copy">@T("NoPromptStarters")</p> }
                else
                {
                    <div class="entry-card-list">
                        @foreach (var suggestion in model.Suggestions)
                        {
                            <article class="entry-suggestion-card" @key="suggestion" data-testid="entry-suggestion-card">
                                <div class="form-grid entry-suggestion-form">
                                    <FormField Label="@T("Label")" Class="entry-suggestion-label"><ClearableText @bind-Value="suggestion.Label" data-testid="entry-suggestion-label" /></FormField>
                                    <FormField Label="@T("Value")" Class="entry-suggestion-value"><ClearableText Multiline="true" @bind-Value="suggestion.Value" rows="3" data-testid="entry-suggestion-value"></ClearableText></FormField>
                                    <div class="entry-suggestion-actions">
                                        <button type="button"
                                                class="button-danger entry-suggestion-remove"
                                                data-testid="remove-suggestion"
                                                aria-label="@T("Remove")"
                                                title="@T("Remove")"
                                                @onclick="() => RemoveSuggestion(suggestion)">
                                            <UiIcon Name="trash" />
                                            <span>@T("Remove")</span>
                                        </button>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
            </ChildContent></FormSection></ChildContent><Validation><ValidationMessage For="() => model.Suggestions" /></Validation></FormField></div>;
    private RenderFragment Preview => @<div><FormSection Title="@T("WorkplaceRenderer")" Eyebrow="@T("Preview")" Description="@T("PreviewHelp")"><Actions><StatusBadge Text="@T("NoExecution")" Status="UiStatus.Info" /></Actions><ChildContent>
                <div class="entry-preview"><Agentstration.Workplace.Components.EntryRenderer Definition="PreviewDefinition" OnSubmit="PreviewSubmitted" Disabled="true" /></div>
            </ChildContent></FormSection></div>;
    private RenderFragment Usage => @<div>@if (!usageLoaded) { <ErrorState Message="@T("EntryUsageUnavailable")" /><button class="button-secondary" type="button" @onclick="RefreshAsync">@Shared["RefreshResource"]</button> } else { <section class="entry-usage-grid">
                <article class="panel form-section">
                    <div class="panel-header"><div><p class="eyebrow">@T("DependsOn")</p><h2>@T("ExecutionResources")</h2></div><StatusBadge Text="@dependencies.Count.ToString()" Status="UiStatus.Neutral" /></div>
                    @if (dependencies.Count == 0) { <p class="entry-empty-copy">@T("DependenciesAfterPublication")</p> }
                    else { <div class="entry-card-list">@foreach (var dependency in dependencies) { <article class="entry-usage-card"><CollectionIdentity DisplayName="@FriendlyResourceName(dependency.ResourceId)" Name="@dependency.ResourceId" IconName="layers" /><span>@dependency.ResourceType · @FriendlyRelationship(dependency.Relationship)</span><details><summary>@T("ResourceId")</summary><code>@dependency.ResourceId</code></details></article> }</div> }
                </article>
                <article class="panel form-section">
                    <div class="panel-header"><div><p class="eyebrow">@T("UsedBy")</p><h2>@T("PublishedDashboards")</h2></div><StatusBadge Text="@PublishedUsages.Count.ToString()" Status="UiStatus.Neutral" /></div>
                    @if (PublishedUsages.Count == 0) { <p class="entry-empty-copy">@T("NotUsedByDashboard")</p> }
                    else { <div class="entry-card-list">@foreach (var usage in PublishedUsages) { var reference = UsageReference(usage)!; <article class="entry-usage-card"><CollectionIdentity DisplayName="@usage.Published!.DisplayName" Name="@usage.Published.Id.Value" IconName="layout-grid" /><span>@EnumLabel("Role", reference.Role) · @T("Position", reference.Order + 1)</span><details><summary>@T("DashboardResourceId")</summary><code>@usage.Published.Id.Value</code></details></article> }</div> }
                </article>
            </section> }</div>;
    private RenderFragment Versions => @<div><FormSection Title="@T("PublishedEntry")" Eyebrow="@T("Versions")"><ChildContent>
                @if (published is null) { <p class="entry-empty-copy">@T("NoPublishedVersion")</p> }
                else
                {
                    <article class="entry-version-card"><div><StatusBadge Text="@T("Published")" Status="UiStatus.Success" /><strong>@T("Version", published.Version)</strong><span>@T("PublishedAt", FormatDate(published.PublishedAt))</span></div><dl class="entry-facts"><dt>@T("Binding")</dt><dd>@PublishedBindingSummary</dd><dt>@T("ResolvedFlow")</dt><dd>@FriendlyResourceName(published.ResolvedTarget.FlowResourceId)</dd><dt>@T("FlowVersion")</dt><dd>@published.ResolvedTarget.Version · @T("PinnedLower")</dd></dl><details><summary>@T("ResolvedFlowResourceId")</summary><code>@published.ResolvedTarget.FlowResourceId</code></details></article>
                }
            </ChildContent></FormSection></div>;
    private RenderFragment ConfigurationFields => @<div class="resource-editor-view">@EntryExposureFields @BindingAndResolvedTargetFields @ConversationAndExecutionFields</div>;
    private RenderFragment PresentationFields => @<div class="resource-editor-view">@WorkplaceAppearanceFields @InteractionPresentationFields</div>;
    private RenderFragment ValidateActions => @<button type="button" class="button-secondary" @onclick="ValidateAsync" disabled="@(busy || loading || HasRawDraft)" data-testid="entry-validate">@T("Validate")</button>;
    private RenderFragment Review => @<FormSection Title="@Shared["Verification"]"><CollectionView TItem="ConfigurationEntry" Items="DraftConfiguration" IdentityLabel="@Shared["Configuration"]" InformationLabels="@(new[] { T("Value") })"><Identity Context="entry"><strong class="configuration-key">@entry.Label</strong></Identity><Information Context="entry"><CollectionValue Label="@T("Value")"><span class="configuration-value">@entry.Value</span></CollectionValue></Information></CollectionView></FormSection>;
    private RenderFragment YamlActions => @<text>@if (CanWrite) { <button class="button-secondary" type="button" @onclick="ApplyRawAsync" disabled="@busy">@T("ApplyToForm")</button>@if (IsNew) { <button class="button-primary" type="button" @onclick="SaveRawAsync" disabled="@busy">@T("SaveYamlDraft")</button> } }</text>;
}
