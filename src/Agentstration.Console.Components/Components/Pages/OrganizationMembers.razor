@page "/settings/organization/members"
@inject Agentstration.Web.Console.IIdentityAdministrationApiClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<OrganizationStrings> Localizer

<PageTitle>@T("Members") · @T("Organization") · Agentstration</PageTitle>
<PageHeader Title="@T("Members")" Description="@T("Members.Description")" />
<OrganizationSettingsNav />
<div data-testid="console-admin-organization-members">

@if (canManageLocalAccounts)
{
    <FormSection Title="@T("LocalAccounts")" style="margin-bottom:18px"><ChildContent>
        @if (!string.IsNullOrWhiteSpace(accountMessage)) { <p class="form-alert @(accountError ? "form-alert-danger" : "form-alert-success")">@accountMessage</p> }
        <CascadingValue Value="AccountContext"><FormDraftMonitor InvalidInputChanged="value => invalidAccount = value" /><ValidationSummary />
        <FormGrid>
            <FormField Label="@T("Username")"><ChildContent><ClearableText UpdateOnInput="false" @bind-Value="newUserName" autocomplete="off" /></ChildContent></FormField>
            <FormField Label="@T("DisplayName")"><ChildContent><ClearableText UpdateOnInput="false" @bind-Value="newDisplayName" /></ChildContent></FormField>
            <FormField Label="@T("EmailOptional")"><ChildContent><ClearableText UpdateOnInput="false" @bind-Value="newEmail" Type="email" autocomplete="off" /></ChildContent></FormField>
            <FormField Label="@T("InitialPassword")"><ChildContent><ClearableText UpdateOnInput="false" @bind-Value="newPassword" Type="password" autocomplete="new-password" /></ChildContent></FormField>
            <FormField Label="@T("Workspace")"><ChildContent><ClearableSelect @bind-Value="newWorkspaceId">@foreach(var workspace in view?.Workspaces ?? []){<option value="@workspace.Id">@workspace.DisplayName</option>}</ClearableSelect></ChildContent></FormField>
            <FormField Label="@T("Role")"><ChildContent><ClearableSelect @bind-Value="newRole">@foreach(var role in Agentstration.Identity.Contracts.BuiltInIdentityRoleNames.All){<option value="@role">@role</option>}</ClearableSelect></ChildContent></FormField>
        </FormGrid>
        <FormActions><button class="button-primary" @onclick="CreateAccountAsync" disabled="@(savingAccount || invalidAccount)">@(savingAccount ? T("Creating") : T("CreateLocalAccount"))</button></FormActions>
        </CascadingValue>
        @if (localAccounts.Count > 0)
        {
            <CollectionView TItem="Agentstration.Identity.Contracts.LocalAccountResponse" Items="localAccounts" InformationLabels="@(new string[] { T("Principal"), T("InstanceRole") })" IdentityLabel="@T("Account")" StateLabel="@T("Status")">
        <Identity Context="account">
<CollectionIdentity DisplayName="@account.UserName" Name="@account.PrincipalId.ToString()" IconName="user" ><IconBadges><StatusBadge Text="@T($"Status.{account.PrincipalStatus}")" Status="@(account.PrincipalStatus == PrincipalStatus.Active ? UiStatus.Success : UiStatus.Warning)" IconOnly /></IconBadges></CollectionIdentity><small>@(account.Email ?? T("NoEmail"))</small></Identity>
        <Information Context="account">
            <CollectionValue Label="@T("Principal")">@account.DisplayName<br /><code>@account.PrincipalId</code></CollectionValue>
            <CollectionValue Label="@T("InstanceRole")">@(account.PlatformAdministrator ? T("PlatformAdministrator") : "—")</CollectionValue>
        </Information>
        <Actions Context="account">
<CollectionActions ResourceName="@(account.UserName)"><button class="text-button" @onclick="() => SetEnabledAsync(account, account.PrincipalStatus != PrincipalStatus.Active)">@(account.PrincipalStatus == PrincipalStatus.Active ? T("Disable") : T("Enable"))</button></CollectionActions></Actions>
    </CollectionView>
        }
    </ChildContent></FormSection>
}

@if (view is null) { <LoadingState Message="@T("LoadingMembers")" /> }
else if (view.Members.Count == 0) { <EmptyState Title="@T("NoMembers")" Message="@T("NoMembersMessage")" /> }
else
{
    <CollectionView TItem="Agentstration.Identity.Contracts.OrganizationMemberResponse" Items="view.Members" InformationLabels="@(new string[] { T("Identity"), T("AssignedAccess") })" IdentityLabel="@T("Member")" StateLabel="@T("Membership")">
        <Identity Context="member">
<CollectionIdentity DisplayName="@member.Principal.DisplayName" Name="@member.Principal.Id.ToString()" Href="@($"/settings/organization/members/{member.Principal.Id:D}")" IconName="user" ><IconBadges><StatusBadge Text="@T($"Status.{member.Membership.Status}")" Status="UiStatus.Success" IconOnly /></IconBadges></CollectionIdentity><small>@(member.Principal.Email ?? T("NoEmail"))</small></Identity>
        <Information Context="member">
            <CollectionValue Label="@T("Identity")">@(member.ExternalIdentities.Count == 0 ? T("Unlinked") : T("ExternalIdentityCount", member.ExternalIdentities.Count))</CollectionValue>
            <CollectionValue Label="@T("AssignedAccess")">@if(member.Roles.Count == 0){<span>@T("None")</span>}else{@foreach(var assigned in member.Roles){<div><strong>@assigned.Role.DisplayName</strong> <small>@ScopeLabel(assigned.Scope)</small></div>}}</CollectionValue>
        </Information>
    </CollectionView>
}
</div>

@code {
    private Agentstration.Identity.Contracts.OrganizationAdministrationResponse? view;
    private IReadOnlyList<Agentstration.Identity.Contracts.LocalAccountResponse> localAccounts = [];
    private bool canManageLocalAccounts; private bool savingAccount; private bool accountError;
    private string newUserName = ""; private string newDisplayName = ""; private string? newEmail; private string newPassword = "";
    private EditContext? accountContext;
    private EditContext AccountContext => accountContext ??= new(this);
    private bool invalidAccount;
    private Guid newWorkspaceId; private string newRole = Agentstration.Identity.Contracts.BuiltInIdentityRoleNames.Member; private string? accountMessage;
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    protected override async Task OnInitializedAsync()
    {
        view = await Client.GetOrganizationAsync(default);
        var capabilities = await Client.GetCapabilitiesAsync(default);
        newWorkspaceId = capabilities.WorkspaceId;
        canManageLocalAccounts = capabilities.SupportsLocalAccounts && capabilities.IsPlatformAdministrator;
        if (canManageLocalAccounts) localAccounts = await Client.GetLocalAccountsAsync(default);
    }
    private async Task CreateAccountAsync()
    {
        if (invalidAccount) return;
        savingAccount = true; accountMessage = null;
        try
        {
            var account = await Client.CreateLocalAccountAsync(new(newUserName, newPassword, newDisplayName, newEmail, newWorkspaceId, newRole), default);
            accountError = false; accountMessage = T("AccountCreated", account.UserName);
            newUserName = newDisplayName = newPassword = ""; newEmail = null;
            localAccounts = await Client.GetLocalAccountsAsync(default);
            view = await Client.GetOrganizationAsync(default);
        }
        catch (Agentstration.Web.Console.AgentstrationApiException exception) { accountError = true; accountMessage = exception.Message; }
        finally { savingAccount = false; }
    }
    private async Task SetEnabledAsync(Agentstration.Identity.Contracts.LocalAccountResponse account, bool enabled)
    {
        try { await Client.SetLocalAccountEnabledAsync(account.AccountId, enabled, default); localAccounts = await Client.GetLocalAccountsAsync(default); accountError = false; accountMessage = T(enabled ? "AccountEnabled" : "AccountDisabled", account.UserName); }
        catch (Agentstration.Web.Console.AgentstrationApiException exception) { accountError = true; accountMessage = exception.Message; }
    }
    private string ScopeLabel(string scope) => scope.StartsWith("/tenants/", StringComparison.Ordinal) ? T("TenantInherited") : view?.Workspaces.FirstOrDefault(workspace => scope == AuthorizationScopes.Workspace(workspace.Id)) is { } workspace ? T("WorkspaceScope", workspace.DisplayName) : scope;
}
