@page "/storage-types/{Name}"
@implements IDisposable
@inject IStorageTypesClient Client
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@inject ConsoleContextState Context
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<StorageStrings> Localizer

<PageTitle>@(resource?.Definition.DisplayName ?? Name) · Agentstration</PageTitle>
@{ var presentations = Presentations; var editorIdentity = Identity; }
<ConsoleResourceDetailsTemplate CollectionHref="@BackUrl" CollectionLabel="@T("TypeCatalog")" Resource="resource" Name="@(resource?.Definition.DisplayName ?? Name ?? string.Empty)" ResourceType="@T("Type")" Domain="storage" IconName="database" Description="@resource?.Definition.Description"
    Enabled="resource?.Definition.Enabled" EnabledChanged="ChangeEnabledAsync" EnabledDisabled="@(Busy || !CanWrite)" EnabledTestId="storage-type-enabled"
    ResourceIdentity="@(loadedKey ?? Name ?? string.Empty)" SectionState="sectionState" SectionPresentations="presentations" AdditionalSections="AdditionalSections"
    DefinitionReadOnlyReason="ExplicitReadOnlyReason" AllowAccess="IsOwner" EvaluateSavedAccess HasDraft="HasDraft"
    LoadState="loadState" OnRetry="RefreshAsync" OnRefresh="RefreshAsync" Busy="Busy" Yaml="@ResourceYaml" YamlLabel="@T("Type.Yaml")" YamlInputTestId="storage-type-yaml"
    SectionTestIdPrefix="storage-type" TestId="storage-type-details">
    <PrimaryActions>@if (CanWrite && resource is { } saved) { <a class="button-primary" href="@ResourceOwnershipContext.PreserveNavigation(StorageTypeLinks.Action(saved, "versions/new"), Services)" data-testid="storage-type-publish">@T("Type.Publish")</a> }</PrimaryActions>
    <Actions>@if (CanDelete) { <button class="button-danger" type="button" @onclick="RequestDelete" disabled="@Busy" data-testid="storage-type-delete">@T("Type.Delete")</button> }</Actions>
    <Feedback><StorageError Error="error" />@if (newerBundle is not null) { <div class="form-alert form-alert-warning" role="status">@T("RefreshDraftConflict")</div> }</Feedback>
    <OverviewMetrics><MetricCard Label="@T("Generation")" Value="@(resource?.Generation.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—")" /><MetricCard Label="@T("Type.PreferredVersion")" Value="@(resource?.Definition.PreferredVersion ?? "—")" /></OverviewMetrics>
    <OverviewSummary Context="identity">@if (resource is not null) { <StorageTypeResourceSummary Resource="resource" Identity="identity" AdditionalContent="Usages" /> }</OverviewSummary>
    <DefinitionContent Context="path">
        @if (resource is { ScopeRef: { } owner } saved)
        {
            <StorageTypeEditor @ref="editor" @key="loadedKey" Name="@saved.Name" Embedded EmbeddedAddress="@(new ScopedResourceAddress(owner, saved.Namespace, saved.Kind, saved.Name))"
                InitialSnapshot="@(new ResourceSnapshot<StorageTypeResource>(saved, etag!))" ExternalActions ExternalBusy="changingEnabled" SaveBlocked="loading" ReadOnlyReason="ExplicitReadOnlyReason"
                SectionState="sectionState" SectionPresentations="presentations" SectionRequested="ShowSection"
                DraftChanged="value => EditorDraftChanged(editorIdentity, value)" SavingChanged="value => EditorSavingChanged(editorIdentity, value)"
                SnapshotSaved="snapshot => DefinitionSaved(editorIdentity, snapshot)" SnapshotReviewed="snapshot => DefinitionSaved(editorIdentity, snapshot)" />
        }
    </DefinitionContent>
    <AdditionalContent Context="path">@if (path == "versions" && resource is not null) { @VersionContract }</AdditionalContent>
    <DraftActions><button type="button" class="button-secondary" disabled="@Busy" @onclick="DiscardDefinition">@Shared["Discard"]</button><button type="submit" form="@editor?.FormId" class="button-primary" disabled="@(Busy || editor?.CanEdit != true)" data-testid="storage-type-save">@T("Save")</button></DraftActions>
</ConsoleResourceDetailsTemplate>
<StorageConfirmation IsOpen="confirmDisable" Title="@T("Deactivate")" Message="@T("Type.DisableConfirm")" ConfirmLabel="@T("Deactivate")" TestId="storage-type-disable-confirmation" OnConfirm="DisableAsync" OnCancel="() => confirmDisable = false" />
<StorageConfirmation IsOpen="confirmDelete" Title="@T("Type.Delete")" Message="@T("Type.DeleteConfirm")" ConfirmLabel="@T("Type.Delete")" TestId="storage-type-delete-confirmation" OnConfirm="DeleteAsync" OnCancel="() => confirmDelete = false" />
@code {
    [Parameter] public string? Name { get; set; }
    [SupplyParameterFromQuery(Name = "scopeRef")] public string? ScopeRefValue { get; set; }
    [SupplyParameterFromQuery(Name = "namespace")] public string? NamespaceValue { get; set; }
    [SupplyParameterFromQuery(Name = "version")] public string? VersionQuery { get; set; }
    [SupplyParameterFromQuery(Name = "context")] public string? ContextValue { get; set; }
    private static readonly JsonSerializerOptions PrettyJson = new() { WriteIndented = true };
    private readonly ResourceSectionState sectionState = new();
    private readonly CancellationTokenSource cancellation = new();
    private readonly CancellationToken lifetimeToken;
    public StorageTypeDetails() => lifetimeToken = cancellation.Token;
    private StorageTypeResource? resource;
    private IReadOnlyList<StorageUsage> usages = [];
    private bool usagesKnown;
    private DetailBundle? newerBundle;
    private string? etag, loadedKey, selectedVersion, selectedQueryVersion, returnAfterDelete;
    private bool loading, changingEnabled, editorBusy, editorDirty, confirmDelete, confirmDisable, disposed;
    private Exception? error;
    private ResourceLoadState loadState = new(ResourceLoadStatus.Loading);
    private long loadVersion;
    private StorageTypeEditor? editor;
    private string Identity => $"{loadedKey}|{resource?.Uid}";
    private bool HasDraft => editor?.IsDirty ?? editorDirty;
    private bool Busy => loading || changingEnabled || editorBusy;
    private ResourceScopeRef? CurrentContext => string.IsNullOrWhiteSpace(ContextValue) ? ResourceOwnershipContext.TryGetCurrent(Services) ?? (Context.Current is { } current ? ResourceScopeRef.Parse(current.SelectedScopeRef) : null) : ResourceScopeRef.Parse(ContextValue);
    private bool IsOwner => resource?.ScopeRef is { } owner && CurrentContext is { } current && owner == current;
    private bool HasWritePermission => Context.HasPermission("resources/write");
    private bool CanWrite => IsOwner && HasWritePermission && resource?.Governance.IsManaged == false;
    private bool CanDelete => IsOwner && Context.HasPermission("resources/delete") && resource?.Governance.IsManaged == false;
    private ResourceReadOnlyReason? ExplicitReadOnlyReason => !HasWritePermission ? ResourceReadOnlyReason.InsufficientPermissions : resource is not null && !IsOwner ? ResourceReadOnlyReason.Inherited : null;
    private IReadOnlyDictionary<string, ResourceSectionPresentation> Presentations => new Dictionary<string, ResourceSectionPresentation>(StorageTypeEditor.DefinitionPresentations(), StringComparer.Ordinal) { ["yaml"] = new() { ReadOnly = true } };
    private IReadOnlyList<ResourceNavigationItem> AdditionalSections => [new("versions", T("Type.VersionContract"), "history")];
    private StorageTypeVersionDescriptor? SelectedVersion => resource?.Definition.Versions.FirstOrDefault(value => value.Version == selectedVersion);
    private string ResourceYaml => resource is null ? string.Empty : ResourceManifestSerializer.ToYaml(new RawType(resource.ApiVersion, resource.Kind, resource.Metadata, resource.ScopeRef, resource.Definition));
    private string BackUrl => ResourceOwnershipContext.PreserveNavigation("/storage-types", Services);
    private string T(string key) => Localizer[key].Value;
    private Task ShowSection(string path) { Navigation.NavigateTo(Navigation.Uri.Split('#')[0] + "#" + path); return Task.CompletedTask; }
    protected override Task OnParametersSetAsync()
    {
        var key = $"{Name}|{ScopeRefValue}|{NamespaceValue}|{ContextValue}|{Context.Current?.SelectedScopeRef}";
        if (key == loadedKey)
        {
            if (VersionQuery != selectedQueryVersion && resource?.Definition.Versions.Any(version => version.Version == VersionQuery) == true) selectedVersion = VersionQuery;
            selectedQueryVersion = VersionQuery; return Task.CompletedTask;
        }
        loadedKey = key; ClearPrivate(); sectionState.Reset(key); selectedQueryVersion = VersionQuery;
        return LoadAsync(false);
    }
    private void ClearPrivate()
    {
        resource = null; editor = null; newerBundle = null; usages = []; usagesKnown = false; etag = null; selectedVersion = null; error = null;
        editorDirty = editorBusy = changingEnabled = confirmDelete = confirmDisable = false;
    }
    private Task RefreshAsync() => Busy ? Task.CompletedTask : LoadAsync(resource is not null);
    private async Task LoadAsync(bool refresh)
    {
        var request = ++loadVersion; var previous = resource; loading = true; error = null;
        loadState = new(refresh && resource is not null ? ResourceLoadStatus.Refreshing : ResourceLoadStatus.Loading) { HasContent = resource is not null };
        try
        {
            await Context.EnsureLoadedAsync(lifetimeToken);
            if (request != loadVersion || disposed) return;
            if (!Context.HasPermission("resources/read")) { ClearPrivate(); loadState = new(ResourceLoadStatus.Forbidden); return; }
            _ = CurrentContext;
            loadedKey = $"{Name}|{ScopeRefValue}|{NamespaceValue}|{ContextValue}|{Context.Current!.SelectedScopeRef}";
            var address = Address();
            var snapshot = await Client.GetTypeAsync(address, lifetimeToken);
            if (request != loadVersion || disposed) return;
            if (!Matches(snapshot.Value, previous)) { ClearPrivate(); loadState = new(ResourceLoadStatus.NotFound); return; }
            IReadOnlyList<StorageUsage> references = previous is null ? [] : usages;
            var known = previous is not null && usagesKnown;
            AgentstrationApiException? failure = null;
            try { references = await Client.GetTypeUsagesAsync(address, lifetimeToken); known = true; }
            catch (AgentstrationApiException exception) when (FailureStatus(exception) == ResourceLoadStatus.Failed) { failure = exception; }
            if (request != loadVersion || disposed) return;
            var bundle = new DetailBundle(snapshot, references, known);
            if (HasDraft)
            {
                usages = references; usagesKnown = known;
                newerBundle = snapshot.ETag != etag || snapshot.Value.Generation != resource?.Generation ? bundle : null;
            }
            else Adopt(bundle);
            loadState = failure is null ? new(ResourceLoadStatus.Ready) { HasContent = true }
                : new(ResourceLoadStatus.Failed) { HasContent = true, ErrorId = failure.ErrorId };
        }
        catch (OperationCanceledException) when (lifetimeToken.IsCancellationRequested) { }
        catch (Exception exception)
        {
            if (request != loadVersion || disposed) return;
            var status = FailureStatus(exception);
            if (status is ResourceLoadStatus.Forbidden or ResourceLoadStatus.NotFound) ClearPrivate();
            loadState = new(status) { HasContent = resource is not null, ErrorId = (exception as AgentstrationApiException)?.ErrorId };
        }
        finally { if (request == loadVersion && !disposed) loading = false; }
    }
    private static ResourceLoadStatus FailureStatus(Exception exception) => exception is AgentstrationApiException api ? api.StatusCode switch
    {
        System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden => ResourceLoadStatus.Forbidden,
        System.Net.HttpStatusCode.NotFound => ResourceLoadStatus.NotFound,
        _ => ResourceLoadStatus.Failed
    } : ResourceLoadStatus.Failed;
    private ScopedResourceAddress Address() => ScopedResourceAddress.Create(ResourceScopeRef.Parse(ScopeRefValue ?? throw new ArgumentException("scopeRef")), ResourceNamespace.Parse(NamespaceValue), StorageResourceKinds.StorageType, Name!);
    private bool Matches(StorageTypeResource value, StorageTypeResource? previous)
    {
        var address = Address();
        return value.Name == address.Name && value.Namespace == address.Namespace && value.ScopeRef == address.ScopeRef && (previous is null || value.Uid == previous.Uid);
    }
    private void Adopt(DetailBundle bundle)
    {
        resource = bundle.Snapshot.Value; etag = bundle.Snapshot.ETag; usages = bundle.Usages; usagesKnown = bundle.UsagesKnown; newerBundle = null;
        selectedVersion = resource.Definition.Versions.FirstOrDefault(version => version.Version == selectedVersion)?.Version
            ?? resource.Definition.Versions.FirstOrDefault(version => version.Version == VersionQuery)?.Version ?? resource.Definition.PreferredVersion;
    }
    private void DiscardDefinition()
    {
        if (Busy) return;
        if (newerBundle is { } latest) { Adopt(latest); editor?.ApplySnapshot(latest.Snapshot, discard: true); }
        else editor?.Discard();
        editorDirty = false; error = null;
    }
    private void EditorDraftChanged(string identity, bool value) { if (!disposed && identity == Identity) editorDirty = value; }
    private void EditorSavingChanged(string identity, bool value) { if (!disposed && identity == Identity) editorBusy = value; }
    private void DefinitionSaved(string identity, ResourceSnapshot<StorageTypeResource> snapshot)
    {
        if (disposed || identity != Identity) return;
        if (!Matches(snapshot.Value, resource)) { ClearPrivate(); loadState = new(ResourceLoadStatus.NotFound); return; }
        Adopt(new(snapshot, usages, usagesKnown)); error = null;
        loadState = new(ResourceLoadStatus.Ready) { HasContent = true };
    }
    private Task ChangeEnabledAsync(bool value)
    {
        if (!CanWrite || Busy || resource is null || resource.Definition.Enabled == value) return Task.CompletedTask;
        if (!value) { confirmDisable = true; return Task.CompletedTask; }
        return SetEnabledAsync(true);
    }
    private Task DisableAsync() { confirmDisable = false; return SetEnabledAsync(false); }
    private async Task SetEnabledAsync(bool value)
    {
        if (!CanWrite || Busy || resource is not { } previous) return;
        var request = loadVersion; changingEnabled = true; error = null;
        try
        {
            var saved = await Client.UpdateTypeAsync(new(previous.ScopeRef!.Value, previous.Namespace, previous.Kind, previous.Name), new(previous.Definition with { Enabled = value }), etag!, lifetimeToken);
            if (request != loadVersion || disposed) return;
            if (!Matches(saved.Value, previous)) { ClearPrivate(); loadState = new(ResourceLoadStatus.NotFound); return; }
            Adopt(new(saved, usages, usagesKnown)); editor?.ApplyActivationSnapshot(saved);
            loadState = new(ResourceLoadStatus.Ready) { HasContent = true };
        }
        catch (OperationCanceledException) when (lifetimeToken.IsCancellationRequested) { }
        catch (Exception exception) { if (request == loadVersion && !disposed) error = exception; }
        finally { if (request == loadVersion && !disposed) changingEnabled = false; }
    }
    private void RequestDelete() { if (!Busy && CanDelete) confirmDelete = true; }
    private async Task DeleteAsync()
    {
        confirmDelete = false;
        if (Busy || !CanDelete || resource is not { } previous) return;
        var request = loadVersion; changingEnabled = true; error = null;
        try
        {
            await Client.DeleteTypeAsync(new(previous.ScopeRef!.Value, previous.Namespace, previous.Kind, previous.Name), etag!, lifetimeToken);
            if (request != loadVersion || disposed) return;
            ClearPrivate(); loadState = new(ResourceLoadStatus.NotFound); returnAfterDelete = BackUrl;
        }
        catch (OperationCanceledException) when (lifetimeToken.IsCancellationRequested) { }
        catch (Exception exception) { if (request == loadVersion && !disposed) error = exception; }
        finally { if (request == loadVersion && !disposed) changingEnabled = false; }
    }
    protected override void OnAfterRender(bool firstRender) { if (returnAfterDelete is { } destination) { returnAfterDelete = null; Navigation.NavigateTo(destination); } }
    private static string UsageUrl(StorageUsage usage) => usage.Url.StartsWith('/') && !usage.Url.StartsWith("//", StringComparison.Ordinal) && !usage.Url.Contains('\\') ? usage.Url : "#";
    public void Dispose() { if (disposed) return; disposed = true; ++loadVersion; cancellation.Cancel(); cancellation.Dispose(); }
    private sealed record DetailBundle(ResourceSnapshot<StorageTypeResource> Snapshot, IReadOnlyList<StorageUsage> Usages, bool UsagesKnown);
    private sealed record RawType(string ApiVersion, string Kind, ResourceMetadata Metadata, ResourceScopeRef? ScopeRef, StorageTypeProperties Definition);
    private RenderFragment Usages => @<FormSection Title="@T("Type.Usages")" Description="@T("Type.UsagesHelp")">
        @if (!usagesKnown) { <p>@T("Type.UsagesUnknown")</p> }
        else if (usages.Count == 0) { <p>@T("Type.NoUsages")</p> }
        <ul class="resource-links">@foreach (var usage in usages) { var usageIdentity = StorageLinks.UsageIdentity(usage); <li><CollectionIdentity DisplayName="@usage.DisplayName" Namespace="@usageIdentity.Namespace" Name="@usage.Name" Href="@UsageUrl(usage)" IconName="database" data-testid="storage-type-usage"><IconBadges>@if (usageIdentity.ScopeRef is { } usageScope) { <ResourceScopeBadge ScopeRef="usageScope" IconOnly /> }</IconBadges></CollectionIdentity></li> }</ul>
    </FormSection>;
    private RenderFragment VersionContract => @<FormSection Title="@T("Type.VersionContract")" Description="@T("Type.ImmutableHelp")">@if (resource is { } saved) {
                <FormField Label="@T("Version")"><ClearableSelect TValue="string" AllowClear="false" @bind-Value="selectedVersion" data-testid="storage-type-version-select">@foreach (var choice in saved.Definition.Versions) { <option value="@choice.Version">@choice.Version</option> }</ClearableSelect></FormField>
                @if (SelectedVersion is { } version)
                {
                    <p>@T("Availability"): @(saved.ObservedVersions.FirstOrDefault(value => value.Version == version.Version) is { } observed ? T($"Availability.{observed.Availability}") : T("NotObserved"))</p>
                    <StorageTypeEvidence Choice="new(saved, version)" />
                    <p>@T("Type.RequiresService"): @T(version.RequiresConnectedService ? "Yes" : "No")</p>
                    <h3>@T("Type.Requirements")</h3>
                    @foreach (var requirement in version.Requirements)
                    {
                        <p><code>@requirement.Id</code> · @T(requirement.Required ? "Required" : "Optional") · @T($"ValueType.{requirement.Type}") · @T($"Protection.{requirement.Protection}") <code>@requirement.Format</code></p>
                    }
                    <details><summary>@T("Type.ConfigurationSchema")</summary><pre>@JsonSerializer.Serialize(version.ConfigurationSchema, PrettyJson)</pre></details>
                    <details><summary>@T("Type.EnvelopeSchema")</summary><pre>@JsonSerializer.Serialize(version.EnvelopeSchema, PrettyJson)</pre></details>
                }
            }</FormSection>;
}
