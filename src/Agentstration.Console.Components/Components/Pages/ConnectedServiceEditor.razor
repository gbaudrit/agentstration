    private void ValidateOptions(EditContext context)
    {
        if (!ReferenceEquals(context.Model, model)) return;
        messages ??= new(context); messages.Clear();
        if (SelectedVariant is { } variant)
        {
            var missing = model.MissingRequiredBindings(variant.Version.Inputs);
            if (missing.Count > 0) messages.Add(context.Field(nameof(model.Bindings)), T("RequiredBindingsMissing", string.Join(", ", missing)));
            if (!optionsValid)
                messages.Add(context.Field(nameof(model.Options)), T("ConfigurationInvalid"));
