        ScopeRef="selectedScope" ScopeRefChanged="ScopeChanged" ScopeTargets="scopeTargets" IsNew="IsNew" ReadOnly="@(!CanMutate)"
        Description="@model.Description" DescriptionChanged="value => model.Description = value" DescriptionExpression="@(() => model.Description)" Labels="@model.Tags" LabelsExpression="@(() => model.Tags)" LabelsReadOnly="true"
        DisplayNameTestId="connected-service-display-name" TechnicalNameTestId="connected-service-name" TestId="connected-service-identity-editor">
