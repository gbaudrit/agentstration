@if (!Embedded) { <UnsavedNavigationGuard IsDirty="@(IsDirty || HasCreatorDraft)" HasUnsavedChanges="@(() => IsDirty || HasCreatorDraft)" /> }
@if (!Embedded)
{
    <PageTitle>@(IsNew ? T("Create") : T("EditConnectedService")) · Agentstration</PageTitle>
    <PageHeader Enabled="model.Enabled" EnabledChanged="SetEnabled" EnabledDisabled="@(!CanMutate || IsBusy)" EnabledTestId="connected-service-enabled" ScopeRef="selectedScope" Title="@(IsNew ? T("Create") : model.DisplayName)" Description="@T("Editor.Description")" TestId="connected-service-editor"><Actions><a class="button-secondary" href="@(IsNew ? "/connected-services" : DetailsUrl())">@T("Cancel")</a></Actions></PageHeader>
}
@if (loading || loadFailed) { <ResourceLoadFeedback State="loadState" OnRetry="RetryAsync" /> }
else
{
    @if (error is not null) { <div class="form-alert form-alert-danger" role="alert">@(error is AgentstrationApiException { IsConcurrencyConflict: true } ? T("ConcurrencyConflict") : error.Message)</div> }
    <ResourceDefinitionForm @key="editContext" @ref="definitionForm" EditContext="editContext" FieldLabels="FieldLabels" Id="@FormId" FormName="connected-service-editor"
        Sections="@(SectionPresentations ?? DefinitionPresentations())" SectionState="SectionState" SectionContent="@(SectionState is null ? null : DefinitionContent)" SectionRequested="SectionRequested"
        OnValidSubmit="SubmitAsync" OnInvalidSubmit="InvalidSubmitAsync" InvalidInputChanged="value => invalidInput = value" ReadOnly="@(!CanMutate)" Busy="IsBusy"
        FieldsTestId="connected-service-definition-fields" data-testid="connected-service-form" data-resource-etag="@etag" @oninput="MarkDirty" @onchange="MarkDirty">
        <ChildContent>
            @if (IsNew) { <p class="required-fields-hint"><span class="field-required" aria-hidden="true">*</span> @Shared["RequiredFields"]</p><CreationWizard @ref="wizard" Steps="Steps" OnFinish="FinishAsync" Busy="IsBusy" Disabled="@(!CanMutate)" FinishLabel="@T("Save")" FinishTestId="connected-service-save" /> }
            else if (SectionState is null) { @IdentityFields @ConfigurationFields @SharingFields }
        </ChildContent>
    </ResourceDefinitionForm>
    @if (!IsNew && !ExternalActions) { <FormActions Busy="@busy">@if (!Embedded) { <a class="button-secondary" href="@DetailsUrl()">@T("Cancel")</a> }<button type="submit" form="@FormId" class="button-primary" disabled="@(!CanSave)" data-testid="connected-service-save">@(busy ? T("Saving") : T("Save"))</button></FormActions> }
    @foreach (var binding in model.Bindings) { <Microsoft.AspNetCore.Components.Sections.SectionOutlet SectionId="@binding" /> }
}

