@page "/settings/organization/workspaces"
@implements IDisposable
@inject Agentstration.Web.Console.IIdentityAdministrationApiClient Client
@inject ConsoleContextState ContextState
@inject Microsoft.Extensions.Localization.IStringLocalizer<OrganizationStrings> Localizer

<PageTitle>@T("Workspaces") · @T("Organization") · Agentstration</PageTitle>
<PageHeader Title="@T("Workspaces")" Description="@T("Workspaces.Description")" />
<OrganizationSettingsNav />

@if (loading) { <LoadingState Message="@T("LoadingWorkspaces")" /> }
else if (!string.IsNullOrWhiteSpace(loadError)) { <ErrorState Title="@T("UnableLoadWorkspaces")" Message="@loadError" /> }
else
{
    @if (CanCreate)
    {
        <section class="panel workspace-create-panel" data-testid="workspace-create-form" data-interactive="@(interactive ? "true" : "false")">
            <div class="panel-header"><h2>@T("CreateWorkspace")</h2></div>
            <div class="workspace-create-form">
                <ResourceIdentityFields @key="identityVersion" @bind-DisplayName="displayName" @bind-TechnicalName="technicalName" Policy="ResourceNamePolicy.Workspace" IsNew="true" DisplayNameTestId="workspace-display-name" TechnicalNameTestId="workspace-technical-name" />
                <button class="button-primary" @onclick="CreateAsync" disabled="@(!CanSubmit)" data-testid="workspace-create">@(busy ? T("Creating") : T("CreateWorkspace"))</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(operationError)) { <p class="inline-warning" role="alert">@operationError</p> }
        </section>
    }
    <DataGrid TItem="Agentstration.Identity.Contracts.Workspace" Items="workspaces">
        <Header><tr><th>@T("Workspace")</th><th>@T("TechnicalName")</th><th>@T("Status")</th><th>@T("Created")</th><th>@T("Context")</th></tr></Header>
        <Row Context="workspace"><tr data-testid="workspace-row" data-workspace-id="@workspace.Id" data-workspace-name="@workspace.Name"><td><strong>@workspace.DisplayName</strong><br /><small>@workspace.Id</small></td><td><code>@workspace.Name</code></td><td><StatusBadge Text="@T($"Status.{workspace.Status}")" Status="UiStatus.Success" /></td><td>@workspace.CreatedAt.ToLocalTime().ToString("g")</td><td>@if(workspace.Id == ContextState.Current?.WorkspaceId){<StatusBadge Text="@T("Current")" Status="UiStatus.Info" />}</td></tr></Row>
    </DataGrid>
}

@code {
    private IReadOnlyList<Agentstration.Identity.Contracts.Workspace> workspaces = [];
    private string displayName = string.Empty;
    private string technicalName = string.Empty;
    private string? loadError;
    private string? operationError;
    private bool loading = true;
    private bool busy;
    private int identityVersion;
    private bool interactive;
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    private bool CanCreate => ContextState.HasPermission(AuthorizationPermissions.WorkspacesWrite);
    private bool CanSubmit => !busy && displayName.Trim().Length >= 2 && technicalName.Trim().Length >= 2;

    protected override async Task OnInitializedAsync()
    {
        ContextState.Changed += OnContextChanged;
        await ReloadAsync();
    }
    private void OnContextChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => ContextState.Changed -= OnContextChanged;
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        interactive = true;
        StateHasChanged();
    }
    private async Task ReloadAsync()
    {
        loading = true;
        loadError = null;
        try { workspaces = (await Client.GetOrganizationAsync(default)).Workspaces; }
        catch (Exception exception) { loadError = exception.Message; }
        finally { loading = false; }
    }
    private async Task CreateAsync()
    {
        if (busy) return;
        busy = true; operationError = null;
        try
        {
            await Client.CreateWorkspaceAsync(technicalName, displayName, default);
            displayName = technicalName = string.Empty;
            identityVersion++;
            await ReloadAsync();
            await ContextState.LoadAsync(default);
        }
        catch (Exception exception) { operationError = exception.Message; }
        finally { busy = false; }
    }
}
