@page "/extensions/{RegistrationName}"
@page "/extensions/enrollment/{EnrollmentInstanceId:guid}"
@implements IDisposable
@inject IExtensionsClient Client
@inject IModelProfilesClient ProfilesClient
@inject NotificationState Notifications
@inject IServiceProvider Services
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<ExtensionStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@inject Microsoft.Extensions.Localization.IStringLocalizer<ResourceIdentityFieldsStrings> IdentityLocalizer

<PageTitle>@SavedDisplayName · Agentstration</PageTitle>
@{
    var presentations = SectionPresentations;
    RenderFragment feedback = @<div>
        @if (commandError is not null) { <div class="form-alert form-alert-danger" role="alert">@commandError</div> }
        @if (newerBundle is not null) { <div class="form-alert form-alert-warning" role="status">@T("RefreshDraftConflict")</div> }
    </div>;
    RenderFragment? actions = !CanDeleteRegistration ? null : @<button type="button" class="button-danger" @onclick="() => confirmDelete = true" disabled="@Busy">@T("Delete")</button>;
    RenderFragment metrics = @<text><MetricCard Label="@T("Availability")" Value="@(item is null ? "—" : StatusLabel(item.AvailabilityStatus))" Status="@(item is null ? UiStatus.Neutral : ModelManagementUi.Status(item.AvailabilityStatus))" />
        @if (item?.Extension is { } extension) { <MetricCard Label="@T("Contributions")" Value="@extension.Contributions.Count.ToString(System.Globalization.CultureInfo.CurrentCulture)" /><MetricCard Label="@T("BundleInstallations")" Value="@((extension.BundleInstallations?.Count ?? 0).ToString(System.Globalization.CultureInfo.CurrentCulture))" /> }</text>;
}
@if (SavedResource is not null || loadState.BlocksContent)
{
    <ConsoleResourceDetailsTemplate Resource="SavedResource" Name="@SavedDisplayName" ResourceType="@(RegistrationName is null ? T("Enrollment") : T("Extension"))" Domain="extension" IconName="puzzle" Version="@item?.Version" VersionDescription="@T("ObservedVersion")"
        CollectionHref="@BackUrl" CollectionLabel="@T("BackToExtensions")"
        Description="@item?.Extension?.Extension?.Description" StatusText="@(item is null ? null : StatusLabel(item.AvailabilityStatus))" Status="@(item is null ? UiStatus.Neutral : ModelManagementUi.Status(item.AvailabilityStatus))"
        ResourceIdentity="@(loadedKey ?? string.Empty)" SectionState="sectionState" SectionPresentations="presentations" AdditionalSections="AdditionalSections" AdditionalContent="FamilySection"
        NavigationLabel="@T("ExtensionDetailsTabs")" NavigationTestId="extension-sections" SectionTestIdPrefix="extension" TestId="distribution-extension-details"
        HasDraft="HasDefinitionDraft" HasAdditionalDraft="@(migrationPreview is not null)" Busy="Busy" Feedback="feedback" LoadState="loadState" OnRefresh="RefreshAsync" OnRetry="RefreshAsync" ShowRefreshAction="true"
        DefinitionReadOnlyReason="@(CanEditRegistration ? null : RegistrationName is null ? ResourceReadOnlyReason.Unspecified : registration?.Value.Definition.Source is ExtensionRegistrationSource.Configuration or ExtensionRegistrationSource.Aspire ? ResourceReadOnlyReason.Managed : ResourceReadOnlyReason.InsufficientPermissions)" AllowAccess="@(RegistrationName is not null && registration is not null)"
        Enabled="@(RegistrationName is null ? null : registration?.Value.Definition.Enabled)" EnabledChanged="SetEnabledAsync" EnabledDisabled="@(!CanEditRegistration || Busy)" EnabledTestId="extension-enabled"
        Yaml="@SavedYaml" YamlTitle="@Shared["ResourceManifest"]" YamlDescription="@T("YamlReadOnlyProjection")" YamlReadOnly="true" MoreActions="actions">
        <OverviewMetrics>@metrics</OverviewMetrics>
        <OverviewSummary Context="identity"><ExtensionResourceSummary Resource="SavedResource" Item="item" Identity="identity"><OperationalContent>@FamilySection("connections")</OperationalContent></ExtensionResourceSummary></OverviewSummary>
        <IdentityDetails>@if (item is not null) { <dt>@T("ExtensionId")</dt><dd><CopyableValue Value="@item.ExtensionId" PlainText /></dd> }</IdentityDetails>
        <DefinitionContent Context="path">
            <ResourceDefinitionForm @key="form" @ref="definitionForm" EditContext="FormContext" FieldLabels="FieldLabels" Id="extension-registration-form" FormName="extension-registration"
                Sections="presentations" SectionState="sectionState" SectionContent="DefinitionSection" SectionRequested="ShowSection"
                OnValidSubmit="SaveAsync" InvalidInputChanged="value => invalidInput = value" Busy="Busy" ReadOnly="@(!CanEditRegistration)" data-testid="extension-registration-form" />
        </DefinitionContent>
        <DraftActions><button class="text-button" type="button" @onclick="Discard" disabled="@Busy">@Shared["Discard"]</button><button type="submit" form="extension-registration-form" class="button-primary" disabled="@Busy">@T("SaveChanges")</button></DraftActions>
    </ConsoleResourceDetailsTemplate>
}
else
{
    <UnsavedNavigationGuard IsDirty="@(migrationPreview is not null)" />
    <ResourceDetailsTemplate Name="@(item?.DisplayName ?? T("Extension"))" ResourceType="@T("Extension")" IconName="puzzle" CollectionHref="@BackUrl" CollectionLabel="@T("BackToExtensions")" Description="@item?.Extension?.Extension?.Description"
        ResourceIdentity="@(loadedKey ?? string.Empty)" SectionState="sectionState" Sections="OperationalSections" SelectionChanged="OperationalSectionSelected" DefaultSection="overview"
        NavigationLabel="@T("ExtensionDetailsTabs")" NavigationTestId="extension-sections" TestId="distribution-extension-details" LoadState="loadState" OnRefresh="RefreshAsync" OnRetry="RefreshAsync" Feedback="feedback" MoreActions="actions">
        <Content>@if (item is not null)
        {
            <div class="resource-editor-view" hidden="@(!sectionState.Is("overview"))">
                <div class="resource-overview-metrics">@metrics</div>
                <ExtensionResourceSummary Resource="SavedResource" Item="item" />
            </div>
            @foreach (var section in AdditionalSections.Where(value => sectionState.HasVisited(value.Path))) { <div hidden="@(!sectionState.Is(section.Path))">@FamilySection(section.Path)</div> }
        }</Content>
    </ResourceDetailsTemplate>
}
<ConfirmationDialog IsOpen="@confirmDelete" Title="@T("DeleteExtensionRegistration")" Message="@T("DeleteRegistrationMessage", registration?.Value.Namespace.Value ?? string.Empty, registration?.Value.Name ?? string.Empty)" ConfirmLabel="@T("DeleteRegistration")" OnConfirm="DeleteAsync" OnCancel="() => confirmDelete = false" />
<ConfirmationDialog IsOpen="@confirmUnenroll" Title="@T("UnenrollExtension")" Message="@T("UnenrollExtensionMessage")" ConfirmLabel="@T("ConfirmUnenrollExtension")" OnConfirm="UnenrollAsync" OnCancel="() => confirmUnenroll = false" />

<ResourceCollectionPreview @ref="toolPreview" ResourceKind="@ToolResourceKinds.Tool" ContextKey="@ToolPreviewContextKey" Enabled="@(contextState?.HasPermission(AuthorizationPermissions.ResourcesRead) == true && contextState.Error is null)">
    <ChildContent Context="address"><ToolResourcePreview Address="address" OverviewHref="@(ToolReferenceUrl(address.ScopeRef, new(address.Name, address.ScopeRef, address.Namespace)) + "#overview")" DefinitionHref="" /></ChildContent>
</ResourceCollectionPreview>

@code {
    private ResourceCollectionPreview? toolPreview;
    private RenderFragment IdentityFields => @<ResourceIdentityEditor ResourceKind="@(SavedResource?.Kind ?? ExtensionKinds.ExtensionRegistration)"
        DisplayName="@form.DisplayName" DisplayNameChanged="value => form.DisplayName = value" DisplayNameExpression="@(() => form.DisplayName)"
        TechnicalName="@form.Name" TechnicalNameExpression="@(() => form.Name)" Namespace="@form.Namespace" NamespaceExpression="@(() => form.Namespace)"
        ScopeRef="SavedResource?.ScopeRef" Description="@form.Description" DescriptionExpression="@(() => form.Description)" DescriptionReadOnly="true"
        Labels="@form.Tags" LabelsExpression="@(() => form.Tags)" LabelsReadOnly="true" ReadOnly="@(!CanEditRegistration)" TestId="extension-identity" DisplayNameTestId="extension-display-name" />;
    private RenderFragment ConfigurationFields => @<FormSection Title="@Shared["Configuration"]"><ChildContent>@if (RegistrationName is null)
    {
        <CollectionView TItem="ConfigurationEntry" Items="EnrollmentConfiguration" IdentityLabel="@Shared["Configuration"]" InformationLabels="@(new[] { Shared["Saved"].Value })">
            <Identity Context="entry"><strong class="configuration-key">@entry.Label</strong></Identity>
            <Information Context="entry"><CollectionValue Label="@Shared["Saved"]"><span class="configuration-value">@entry.Value</span></CollectionValue></Information>
        </CollectionView>
    }
    else
    {
    <FormGrid>
        <FormField Label="@T("AepEndpoint")" Required><ChildContent><ClearableText @bind-Value="form.Endpoint" data-testid="extension-endpoint" /></ChildContent><Validation><ValidationMessage For="() => form.Endpoint" /></Validation></FormField>
        <FormField Label="@T("ExpectedExtensionId")"><ChildContent><ClearableText @bind-Value="form.ExpectedExtensionId" data-testid="extension-expected-id" /></ChildContent><Validation><ValidationMessage For="() => form.ExpectedExtensionId" /></Validation></FormField>
        <FormField Label="@T("AuthenticationMode")"><span>@(registration is null ? "—" : T($"Authentication.{registration.Value.Definition.AuthenticationMode}"))</span></FormField>
        <FormField Label="@T("Origin")"><span>@(registration is null ? "—" : SourceLabel(registration.Value.Definition.Source.ToString()))</span></FormField>
    </FormGrid>
    }</ChildContent></FormSection>;
    private RenderFragment DefinitionSection(string path) => path == "definition/identity" ? IdentityFields : ConfigurationFields;
    private RenderFragment FamilySection(string path) => @<div class="resource-editor-view">@if (item is not null)
    {
    @if (path == "connections")
    {
        <section class="panel resource-section">
            <div class="panel-header"><div><p class="eyebrow">@T("Connection")</p><h2>@T("ConnectionDetails")</h2><p>@T("ConnectionDetails.Description")</p></div></div>
                <dl class="resource-details">
                    <dt>@T("AepEndpoint")</dt><dd><a href="@item.Endpoint.AbsoluteUri" target="_blank" rel="noopener noreferrer">@item.Endpoint</a></dd>
                    <dt>@T("Registration")</dt><dd>@(item.RegistrationName is null ? "—" : $"{item.RegistrationNamespace}/{item.RegistrationName}")</dd>
                    <dt>@T("Origin")</dt><dd>@SourceLabel(item.RegistrationSource)</dd>
                    <dt>@T("Discovery")</dt><dd>@(item.RegistrationEnabled ? T("Enabled") : T("Disabled"))</dd>
                    <dt>@T("AuthenticationMode")</dt><dd>@(registration is null ? "—" : T($"Authentication.{registration.Value.Definition.AuthenticationMode}"))</dd>
                    <dt>@T("Enrollment")</dt><dd>@if (item.EnrollmentStatus is { } state) { <StatusBadge Text="@EnrollmentStatusLabel(state)" Status="@EnrollmentStatus(state)" /> } else { <span>—</span> }</dd>
                    @if (item.AnnouncedAt is { } announced) { <dt>@T("AnnouncedAt")</dt><dd>@announced.ToLocalTime().ToString("g")</dd> }
                </dl>
                @if (item.Connections.Count > 0)
                {
                    <div class="panel-header"><div><h3>@T("Connections")</h3><p>@T("Connections.Description")</p></div><span>@T("ConnectionCount", item.Connections.Count)</span></div>
                    <CollectionView TItem="ExtensionInventoryConnectionResponse" Items="item.Connections" InformationLabels="@(new string[] { T("Endpoint"), T("Origin") })" IdentityLabel="@T("Registration")" StateLabel="@T("Availability")">
        <Identity Context="connection">
<strong>@connection.DisplayName</strong><br /><code>@connection.RegistrationNamespace/@connection.RegistrationName</code></Identity>
        <State Context="connection">
<StatusBadge Text="@StatusLabel(connection.AvailabilityStatus)" Status="@ModelManagementUi.Status(connection.AvailabilityStatus)" /></State>
        <Information Context="connection">
            <CollectionValue Label="@T("Endpoint")"><a href="@connection.Endpoint.AbsoluteUri" target="_blank" rel="noopener noreferrer">@connection.Endpoint</a></CollectionValue>
            <CollectionValue Label="@T("Origin")">@SourceLabel(connection.Source)</CollectionValue>
        </Information>
    </CollectionView>
                }
                @if (item.EnrollmentInstanceId.HasValue && CanAdminister) { <FormActions><a class="button-primary" href="@EnrollmentManagementUrl">@T("ManageEnrollment")</a></FormActions> }

        </section>
    }

    @if (path == "enrollment")
    {
        <section class="panel resource-section">
            <div class="panel-header">
                <div><p class="eyebrow">@T("Enrollment")</p><h2>@T("EnrollmentDetails")</h2><p>@T("EnrollmentDetails.Description")</p></div>
                @if (item.EnrollmentStatus is { } enrollmentState)
                {
                    <StatusBadge Text="@EnrollmentStatusLabel(enrollmentState)" Status="@EnrollmentStatus(enrollmentState)" />
                }
            </div>
            @if (enrollmentLoadState is { } enrollmentFailure)
            {
                <ResourceLoadFeedback State="enrollmentFailure" OnRetry="RefreshAsync" RetryTestId="extension-enrollment-retry" />
            }
            else if (enrollment is not null)
            {
                <dl class="resource-details">
                    <dt>@T("EnrollmentInstance")</dt><dd><code>@enrollment.Definition.InstanceId</code></dd>
                    <dt>@T("EnrollmentState")</dt><dd><StatusBadge Text="@EnrollmentStatusLabel(enrollment.Definition.State)" Status="@EnrollmentStatus(enrollment.Definition.State)" /></dd>
                    <dt>@T("AepEndpoint")</dt><dd><a href="@enrollment.Definition.Endpoint.AbsoluteUri" target="_blank" rel="noopener noreferrer">@enrollment.Definition.Endpoint</a></dd>
                    @if (enrollment.Definition.PairingUri is { } pairingUri) { <dt>@T("PairingForm")</dt><dd><a href="@pairingUri.AbsoluteUri" target="_blank" rel="noopener noreferrer">@pairingUri</a></dd> }
                    <dt>@T("AnnouncedAt")</dt><dd>@FormatDate(enrollment.Definition.AnnouncedAt)</dd>
                    <dt>@T("CodeIssuedAt")</dt><dd>@FormatDate(enrollment.Definition.CodeIssuedAt)</dd>
                    <dt>@T("CodeExpiresAt")</dt><dd>@FormatDate(enrollment.Definition.CodeExpiresAt)</dd>
                    <dt>@T("AttemptCount")</dt><dd>@enrollment.Definition.AttemptCount</dd>
                    <dt>@T("Registration")</dt><dd>@(enrollment.Definition.RegistrationName ?? "—")</dd>
                    <dt>@T("Outcome")</dt><dd>@(enrollment.Definition.Outcome ?? "—")</dd>
                </dl>
                <div class="panel-actions">
                    <a class="button-primary" href="@EnrollmentManagementUrl">@T("ManageEnrollment")</a>
                    @if (CanAdminister && CanUnenroll(enrollment.Definition.State))
                    {
                        <button class="button-danger" @onclick="() => confirmUnenroll = true">@T("UnenrollExtension")</button>
                    }
                </div>
            }
            else if (item.EnrollmentInstanceId is { } instanceId)
            {
                <dl class="resource-details">
                    <dt>@T("EnrollmentInstance")</dt><dd><code>@instanceId</code></dd>
                    <dt>@T("EnrollmentState")</dt><dd>@if (item.EnrollmentStatus is { } state) { <StatusBadge Text="@EnrollmentStatusLabel(state)" Status="@EnrollmentStatus(state)" /> } else { <span>—</span> }</dd>
                    @if (item.AnnouncedAt is { } announced) { <dt>@T("AnnouncedAt")</dt><dd>@FormatDate(announced)</dd> }
                </dl>
            }
            else
            {
                <p>@T("NoEnrollmentDetails")</p>
            }
        </section>
    }

    @if (path == "contributions")
    {
        <section class="panel resource-section">
            <div class="panel-header"><div><p class="eyebrow">@T("Contributions")</p><h2>@T("Contributions")</h2><p>@T("Contributions.Description")</p></div><span>@(item.Extension is { } discovered ? T("ContributionCount", discovered.Contributions.Count) : "—")</span></div>
            @if (item.Extension?.Contributions.Count > 0)
            {
                <div class="extension-contribution-list" data-testid="extension-contribution-list">
                    @foreach (var contribution in item.Extension.Contributions)
                    {
                        var resources = MaterializedResources(contribution);
                        var tools = MaterializedTools(contribution);
                        var toolState = ToolContributionState(tools);
                        var contributionState = contribution.Kind == "tool" ? toolState : BundleContributionState(contribution);
                        <article class="extension-contribution-card" data-contribution-kind="@contribution.Kind" data-contribution-id="@contribution.Id">
                            <div class="extension-contribution-heading">
                                <div>
                                    <span class="extension-contribution-kind">@ContributionKindLabel(contribution.Kind)</span>
                                    <h3>@contribution.Id</h3>
                                    <p>@ContributionDescription(contribution, resources.Count + tools.Count)</p>
                                </div>
                                <div class="extension-contribution-actions">
                                    @if (contribution.Kind is "tool" or "data-source-profile-bundle") { <StatusBadge Text="@T($"ContributionState.{contributionState}")" Status="@(contributionState == "Available" ? UiStatus.Success : contributionState == "Conflict" ? UiStatus.Danger : UiStatus.Warning)" /> }
                                    @if (contribution.Kind == "tool" && toolState != "Conflict" && extensionToolProvider is not null)
                                    { <a href="@ToolProviderUrl(extensionToolProvider)" class="text-button">@T("OpenProvider", extensionToolProvider.Definition.DisplayName) →</a> }
                                    @foreach (var provider in item.Extension.Providers.Where(value => value.ContributionId == contribution.Id)) { <a class="text-button" href="@ProviderUrl(provider)">@T("OpenProvider", provider.Name) →</a> }
                                    @if (contribution.Kind == "model-provider" && !item.Extension.Providers.Any(value => value.ContributionId == contribution.Id)) { <a class="text-button" href="@ConfigureProviderUrl(item.Extension, contribution)">@T("ConfigureProvider", contribution.Id) →</a> }
                                </div>
                            </div>
                            @if (tools.Count > 0 || resources.Count > 0)
                            {
                                <div class="extension-materialized-resources">
                                    <p class="extension-materialized-label">@T("MaterializedResources", tools.Count + resources.Count)</p>
                                    <ul class="resource-links">
                                        @foreach (var tool in tools)
                                        {
                                            <li><CollectionIdentity DisplayName="@tool.Definition.DisplayName" Namespace="@tool.Namespace.Value" Name="@tool.Name" Href="@(toolState != "Conflict" ? ToolUrl(tool) : null)" IconName="wrench">
                                                <IconBadges><ResourceScopeBadge ScopeRef="tool.ScopeRef" IconOnly /><ManagedResourceBadge IsManaged="@tool.Governance.IsManaged" IsReadOnly="@(!ResourceOwnershipContext.CanManage(tool.ScopeRef, Services))" IconOnly /></IconBadges>
                                                <Badges><small>@T("ContributionKind.tool") · @tool.Definition.ExternalId</small></Badges>
                                            </CollectionIdentity>@if (toolState != "Conflict" && tool.ScopeRef is { } owner) { <CollectionActions ResourceName="@tool.Name"><a href="@ToolUrl(tool)"><UiIcon Name="arrow-up-right" />@Shared["OpenItem"]</a><button type="button" data-testid="extension-tool-preview" disabled="@(contextState?.HasPermission(AuthorizationPermissions.ResourcesRead) != true)" @onclick="() => toolPreview?.Open(ScopedResourceAddress.Create(owner, tool.Namespace, tool.Kind, tool.Name))"><UiIcon Name="eye" />@Shared["Preview"]</button></CollectionActions> }</li>
                                        }
                                        @foreach (var resource in resources)
                                        {
                                            <li><CollectionIdentity DisplayName="@resource.Name" Namespace="@resource.Namespace" Name="@resource.Name" Href="@ManagedResourceUrl(resource)" IconName="layers">
                                                <IconBadges><ResourceScopeBadge ScopeRef="resource.ScopeRef" IconOnly /><ManagedResourceBadge IsManaged="true" IconOnly /></IconBadges>
                                                <Badges><small>@ManagedResourceKindLabel(resource.Kind)</small></Badges>
                                            </CollectionIdentity></li>
                                        }
                                    </ul>
                                </div>
                            }
                        </article>
                    }
                </div>
            }
            else { <p>@T("NoContributions")</p> }
        </section>
    }

    @if (path == "resources")
    {
        <section class="panel resource-section extension-managed-resources" data-testid="extension-governed-inventory">
            <div class="panel-header"><div><p class="eyebrow">@T("ManagedResources")</p><h2>@T("ManagedResources")</h2><p>@T("ManagedResources.Description")</p></div><span>@(item.Extension?.BundleInstallations is { } installations ? T("InstallationCount", installations.Count) : "—")</span></div>
            @if (item.Extension?.BundleInstallations?.Count > 0)
            {
                @foreach (var installation in item.Extension.BundleInstallations)
                {
                    var resources = installation.ManagedResources.Where(resource => !resource.Published).ToArray();
                    var publications = installation.ManagedResources.Where(resource => resource.Published).ToArray();
                    <article class="resource-section extension-bundle-card" data-testid="extension-bundle-installation" data-bundle-id="@installation.BundleId">
                        <div class="extension-bundle-heading">
                            <CollectionIdentity DisplayName="@installation.BundleId" Name="@installation.BundleId" IconName="layers" HeadingLevel="3">
                                <IconBadges><ResourceScopeBadge ScopeRef="installation.ScopeRef" IconOnly /><StatusBadge Text="@T($"InstallationState.{installation.State}")" Status="@InstallationStatus(installation.State)" IconOnly /></IconBadges>
                                <Badges><small>@T("Bundle")</small></Badges>
                            </CollectionIdentity>
                        </div>
                        <div class="extension-bundle-meta"><span>@T("BundleVersion") <strong>@installation.BundleVersion</strong></span><span>@T("ExtensionVersion") <strong>@installation.ExtensionVersion</strong></span></div>
                        @if (installation.ToolBindings.Count > 0)
                        {
                            <div class="extension-bundle-bindings"><p class="field-label">@T("ToolBindings")</p><div class="extension-bundle-binding-list">@foreach (var binding in installation.ToolBindings) { <a href="@ToolReferenceUrl(installation.ScopeRef, binding.Value)" title="@binding.Value.Name">@binding.Key</a> }</div></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(installation.Diagnostic)) { <div class="extension-bundle-diagnostic"><strong>@T("Diagnostics")</strong><p>@installation.Diagnostic</p></div> }
                        @if (resources.Length > 0)
                        {
                            <div class="extension-bundle-grid" data-testid="extension-managed-resources"><CollectionView TItem="ExtensionManagedResourceResponse" Items="resources" InformationLabels="@(new string[] { T("Type") })" IdentityLabel="@T("Identity")" ScopeLabel="@T("Scope")" StateLabel="@T("State")">
        <Identity Context="resource"><CollectionIdentity DisplayName="@resource.Name" Namespace="@resource.Namespace" Name="@resource.Name" Href="@(installation.State != ExtensionBundleInstallationState.Degraded ? ManagedResourceUrl(resource) : null)" IconName="layers"><Versions><CollectionVersion Label="@T("Version")" Value="@(resource.Version)" /></Versions><IconBadges><ResourceScopeBadge ScopeRef="resource.ScopeRef" ShowName IconOnly /><ManagedResourceBadge IsManaged="true" IsReadOnly="@(!ResourceOwnershipContext.CanManage(resource.ScopeRef, Services))" IconOnly /></IconBadges></CollectionIdentity></Identity>
        <Information Context="resource">
            <CollectionValue Label="@T("Type")"><span class="extension-bundle-kind">@ManagedResourceKindLabel(resource.Kind)</span></CollectionValue>
        </Information>
    </CollectionView></div>
                        }
                        else { <p>@T("NoManagedResources")</p> }
                        <details class="extension-bundle-evidence" data-testid="extension-technical-details"><summary>@T("TechnicalDetails")</summary><dl class="resource-details"><dt>@T("Identity")</dt><dd><code>@installation.Name</code></dd><dt>@T("ManagingExtension")</dt><dd><code>@installation.ExtensionId</code></dd><dt>@T("BundleDigest")</dt><dd><code>@installation.BundleDigest</code></dd><dt>@T("ToolBindings")</dt><dd>@foreach (var binding in installation.ToolBindings) { <div><code>@binding.Key</code><br /><code>@binding.Value.Name</code></div> }</dd></dl>
                            @if (publications.Length > 0)
                            {
                                <h4>@T("PublishedVersions")</h4>
                                <ul class="extension-bundle-publications" data-testid="extension-published-versions">
                                    @foreach (var publication in publications)
                                    {
                                        <li><CollectionIdentity DisplayName="@ManagedResourceKindLabel(publication.Kind)" Namespace="@publication.Namespace" Name="@publication.Name" IconName="layers">
                                            <Versions><CollectionVersion Label="@T("Version")" Value="@publication.Version" /></Versions>
                                            <IconBadges><ResourceScopeBadge ScopeRef="publication.ScopeRef" IconOnly /><ManagedResourceBadge IsManaged="true" IconOnly /></IconBadges>
                                        </CollectionIdentity></li>
                                    }
                                </ul>
                            }
                        </details>
                    </article>
                }
            }
            else { <p>@T("NoBundleInstallations")</p> }
        </section>
    }

    @if (path == "options")
    {
        <section class="panel resource-section">
            <div class="panel-header"><div><p class="eyebrow">@T("OptionContracts")</p><h2>@T("OptionContracts")</h2><p>@T("OptionContracts.Description")</p></div><span>@T("SetCount", item.Extension?.OptionSets.Count ?? 0)</span></div>
            @if (item.Extension?.OptionSets.Count > 0)
            {
                <CollectionView TItem="ExtensionOptionSetResponse" Items="item.Extension.OptionSets" InformationLabels="@(new string[] { T("Target"), T("Preferred"), T("SupportedVersions") })" IdentityLabel="@T("OptionSet")">
        <Identity Context="optionSet">
<code>@optionSet.Id</code></Identity>
        <Information Context="optionSet">
            <CollectionValue Label="@T("Target")">@optionSet.ContributionKind · <code>@optionSet.ContributionId</code> · @optionSet.Scope</CollectionValue>
            <CollectionValue Label="@T("Preferred")">@optionSet.PreferredVersion</CollectionValue>
            <CollectionValue Label="@T("SupportedVersions")">@foreach (var version in optionSet.Versions) { <div><strong>@version.Version</strong>@(version.Deprecated ? T("DeprecatedSuffix") : null)<br /><code>@version.SchemaDigest</code><details><summary>@T("JsonSchema")</summary><pre class="runner-json">@JsonSerializer.Serialize(version.Schema, IndentedJsonOptions)</pre></details></div> }</CollectionValue>
        </Information>
    </CollectionView>
            }
            else { <p class="inline-warning">@(item.AvailabilityStatus == "available" ? T("NoVersionedOptionContract") : T("ContractsUnavailable"))</p> }
        </section>
    }

    @if (path == "usages")
    {
        <section class="panel resource-section">
            <div class="panel-header"><div><p class="eyebrow">@T("PersistedUsage")</p><h2>@T("PersistedUsage")</h2><p>@T("PersistedUsage.Description")</p></div><span>@(item.Extension is { } discovered ? T("ProfileCount", discovered.Usages.Count) : "—")</span></div>
            @if (item.Extension?.Usages.Count > 0)
            {
                <CollectionView TItem="ExtensionOptionUsageResponse" Items="item.Extension.Usages" InformationLabels="@(new string[] { T("Contract"), T("Diagnostics") })" IdentityLabel="@T("ModelProfile")" StateLabel="@T("Status")">
        <Identity Context="usage">
<a href="@ProfileUrl(usage)">@usage.ProfileName</a><br /><small>@usage.ProfileNamespace</small></Identity>
        <State Context="usage">
<StatusBadge Text="@StatusLabel(usage.Status)" Status="@ModelManagementUi.Status(usage.Status)" />@if (CanAdminister && MigrationTarget(item.Extension, usage) is { } targetVersion) { <br /><button class="button-secondary" @onclick="() => PreviewMigrationAsync(usage, targetVersion)" disabled="@Busy">@T("MigrateTo", targetVersion)</button> }</State>
        <Information Context="usage">
            <CollectionValue Label="@T("Contract")">@if (string.IsNullOrWhiteSpace(usage.OptionSet)) { <span>@T("LegacyUnversionedOptions")</span> } else { <code>@usage.OptionSet@@@usage.Version</code> }</CollectionValue>
            <CollectionValue Label="@T("Diagnostics")">@(usage.Issues.Count == 0 ? T("Compatible") : string.Join(" ", usage.Issues))</CollectionValue>
        </Information>
    </CollectionView>
            }
            else { <p>@T("NoPersistedUsage")</p> }
        </section>
        @if (migrationPreview is not null)
        {
            <section class="panel resource-section">
                <div class="panel-header"><div><p class="eyebrow">@T("ExplicitMigrationPreview")</p><h2>@migrationPreview.Value.ProfileNamespace/@migrationPreview.Value.ProfileName</h2><p>@T("NoProfileChanged")</p></div><span>@migrationPreview.Value.Source.Version → @migrationPreview.Value.Target.Version</span></div>
                <div class="details-grid"><article><h3>@T("CurrentOptions")</h3><pre class="runner-json">@JsonSerializer.Serialize(migrationPreview.Value.Source, IndentedJsonOptions)</pre></article><article><h3>@T("ProposedOptions")</h3><pre class="runner-json">@JsonSerializer.Serialize(migrationPreview.Value.Target, IndentedJsonOptions)</pre></article></div>
                <div class="panel-actions"><button class="button-primary" @onclick="ApplyMigrationAsync" disabled="@Busy">@(migrating ? T("Applying") : T("ApplyMigration"))</button><button class="button-secondary" @onclick="CancelMigration" disabled="@Busy">@T("Cancel")</button></div>
            </section>
        }
    }
    }</div>;
}
