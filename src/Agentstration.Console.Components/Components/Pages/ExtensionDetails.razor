@page "/extensions/{RegistrationName}"
@page "/extensions/enrollment/{EnrollmentInstanceId:guid}"
@implements IDisposable
@inject IExtensionsClient Client
@inject IModelProfilesClient ProfilesClient
@inject NotificationState Notifications
@inject IServiceProvider Services
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<ExtensionStrings> Localizer

<PageTitle>@(item?.DisplayName ?? T("Extension")) · Agentstration</PageTitle>
<PageHeader Title="@(item?.DisplayName ?? T("Extension"))" Description="@(item?.Extension?.Extension?.Description ?? T("ExtensionDetails.Description"))">
    <Actions><a class="button-secondary" href="/extensions">@T("BackToExtensions")</a></Actions>
</PageHeader>

<div data-testid="distribution-extension-details">
@if (error is not null)
{
    <ErrorState Message="@error.Message" ErrorId="@error.ErrorId"><button class="button-secondary" @onclick="LoadAsync">@T("Retry")</button></ErrorState>
}
else if (loading)
{
    <LoadingState Message="@T("LoadingExtension")" />
}
else if (item is null)
{
    <EmptyState Title="@T("ExtensionNotFound")" Message="@T("ExtensionNotFound.Description")" />
}
else
{
    <ResourceTabs Label="@T("ExtensionDetailsTabs")">
        @foreach (var tab in Enum.GetValues<DetailTab>())
        {
            <button type="button" role="tab" aria-selected="@(activeTab == tab ? "true" : "false")" class="@(activeTab == tab ? "active" : null)" @onclick="() => activeTab = tab">@T($"DetailTab.{tab}")</button>
        }
    </ResourceTabs>

    @if (activeTab == DetailTab.Summary)
    {
        <section class="panel resource-section">
            <div class="panel-header"><div><p class="eyebrow">@T("AepExtension")</p><h2>@item.DisplayName</h2><p>@(item.Extension?.Details ?? item.Extension?.Extension?.Description ?? T("ExtensionIdentityUnavailable"))</p></div><StatusBadge Text="@StatusLabel(item.AvailabilityStatus)" Status="@ModelManagementUi.Status(item.AvailabilityStatus)" /></div>
            <dl class="resource-details">
                <dt>@T("ExtensionId")</dt><dd><code>@item.ExtensionId</code></dd>
                <dt>@T("ObservedVersion")</dt><dd>@(item.Version ?? "—")</dd>
                <dt>@T("Enrollment")</dt><dd>@if (item.EnrollmentStatus is { } state) { <StatusBadge Text="@EnrollmentStatusLabel(state)" Status="@EnrollmentStatus(state)" /> } else { <span>—</span> }</dd>
                <dt>@T("Availability")</dt><dd><StatusBadge Text="@StatusLabel(item.AvailabilityStatus)" Status="@ModelManagementUi.Status(item.AvailabilityStatus)" /></dd>
                <dt>@T("Connection")</dt><dd><code>@item.Endpoint</code></dd>
                <dt>@T("Origin")</dt><dd>@SourceLabel(item.RegistrationSource)</dd>
                <dt>@T("Contributions")</dt><dd>@(item.Extension?.Contributions.Count > 0 ? string.Join(", ", item.Extension.Contributions.Select(value => $"{value.Kind}:{value.Id}")) : "—")</dd>
            </dl>
        </section>
    }

    @if (activeTab == DetailTab.Connection)
    {
        <section class="panel resource-section">
            <div class="panel-header"><div><p class="eyebrow">@T("Connection")</p><h2>@T("ConnectionDetails")</h2><p>@T("ConnectionDetails.Description")</p></div></div>
            @if (editing && registration is not null)
            {
                <EditForm Model="form" OnValidSubmit="SaveAsync">
                    <DataAnnotationsValidator /><ValidationSummary />
                    <FormGrid>
                        <ResourceIdentityFields @bind-DisplayName="form.DisplayName" TechnicalName="@registration.Value.Name" IsNew="false" />
                        <FormField Label="@T("AepEndpoint")"><ChildContent><ClearableText UpdateOnInput="false" @bind-Value="form.Endpoint" /></ChildContent></FormField>
                        <FormField Label="@T("ExpectedExtensionId")"><ChildContent><ClearableText UpdateOnInput="false" @bind-Value="form.ExpectedExtensionId" /></ChildContent></FormField>
                        <label class="checkbox-field"><FormCheckbox @bind-Value="form.Enabled" /> @T("EnabledForDiscovery")</label>
                    </FormGrid>
                    <div class="panel-actions"><button class="button-primary" type="submit" disabled="@saving">@T("SaveChanges")</button><button class="button-secondary" type="button" @onclick="() => editing = false" disabled="@saving">@T("Cancel")</button></div>
                </EditForm>
            }
            else
            {
                <dl class="resource-details">
                    <dt>@T("AepEndpoint")</dt><dd><a href="@item.Endpoint.AbsoluteUri" target="_blank" rel="noopener noreferrer">@item.Endpoint</a></dd>
                    <dt>@T("Registration")</dt><dd>@(item.RegistrationName is null ? "—" : $"{item.RegistrationNamespace}/{item.RegistrationName}")</dd>
                    <dt>@T("Origin")</dt><dd>@SourceLabel(item.RegistrationSource)</dd>
                    <dt>@T("Discovery")</dt><dd>@(item.RegistrationEnabled ? T("Enabled") : T("Disabled"))</dd>
                    <dt>@T("AuthenticationMode")</dt><dd>@(registration is null ? "—" : T($"Authentication.{registration.Value.Definition.AuthenticationMode}"))</dd>
                    <dt>@T("Enrollment")</dt><dd>@if (item.EnrollmentStatus is { } state) { <StatusBadge Text="@EnrollmentStatusLabel(state)" Status="@EnrollmentStatus(state)" /> } else { <span>—</span> }</dd>
                    @if (item.AnnouncedAt is { } announced) { <dt>@T("AnnouncedAt")</dt><dd>@announced.ToLocalTime().ToString("g")</dd> }
                </dl>
                @if (item.Connections.Count > 0)
                {
                    <div class="panel-header"><div><h3>@T("Connections")</h3><p>@T("Connections.Description")</p></div><span>@T("ConnectionCount", item.Connections.Count)</span></div>
                    <DataGrid TItem="ExtensionInventoryConnectionResponse" Items="item.Connections">
                        <Header><tr><th>@T("Registration")</th><th>@T("Endpoint")</th><th>@T("Origin")</th><th>@T("Availability")</th></tr></Header>
                        <Row Context="connection"><tr><td><strong>@connection.DisplayName</strong><br /><code>@connection.RegistrationNamespace/@connection.RegistrationName</code></td><td><a href="@connection.Endpoint.AbsoluteUri" target="_blank" rel="noopener noreferrer">@connection.Endpoint</a></td><td>@SourceLabel(connection.Source)</td><td><StatusBadge Text="@StatusLabel(connection.AvailabilityStatus)" Status="@ModelManagementUi.Status(connection.AvailabilityStatus)" /></td></tr></Row>
                    </DataGrid>
                }
                <div class="panel-actions">
                    @if (CanEditRegistration)
                    {
                        <button class="button-secondary" @onclick="StartEdit">@T("Edit")</button>
                        <button class="button-secondary" @onclick="ToggleAsync">@(registration!.Value.Definition.Enabled ? T("Disable") : T("Enable"))</button>
                        <button class="button-danger" @onclick="() => confirmDelete = true">@T("Delete")</button>
                    }
                    else if (registration is not null) { <span>@T("ManagedBy", registration.Value.Definition.Source)</span> }
                    @if (item.EnrollmentInstanceId.HasValue && CanAdminister) { <a class="button-primary" href="/extensions?tab=enrollments">@T("ManageEnrollment")</a> }
                </div>
            }
        </section>
    }

    @if (activeTab == DetailTab.Enrollment)
    {
        <section class="panel resource-section">
            <div class="panel-header">
                <div><p class="eyebrow">@T("Enrollment")</p><h2>@T("EnrollmentDetails")</h2><p>@T("EnrollmentDetails.Description")</p></div>
                @if (item.EnrollmentStatus is { } enrollmentState)
                {
                    <StatusBadge Text="@EnrollmentStatusLabel(enrollmentState)" Status="@EnrollmentStatus(enrollmentState)" />
                }
            </div>
            @if (enrollment is not null)
            {
                <dl class="resource-details">
                    <dt>@T("EnrollmentInstance")</dt><dd><code>@enrollment.Definition.InstanceId</code></dd>
                    <dt>@T("EnrollmentState")</dt><dd><StatusBadge Text="@EnrollmentStatusLabel(enrollment.Definition.State)" Status="@EnrollmentStatus(enrollment.Definition.State)" /></dd>
                    <dt>@T("AepEndpoint")</dt><dd><a href="@enrollment.Definition.Endpoint.AbsoluteUri" target="_blank" rel="noopener noreferrer">@enrollment.Definition.Endpoint</a></dd>
                    @if (enrollment.Definition.PairingUri is { } pairingUri) { <dt>@T("PairingForm")</dt><dd><a href="@pairingUri.AbsoluteUri" target="_blank" rel="noopener noreferrer">@pairingUri</a></dd> }
                    <dt>@T("AnnouncedAt")</dt><dd>@FormatDate(enrollment.Definition.AnnouncedAt)</dd>
                    <dt>@T("CodeIssuedAt")</dt><dd>@FormatDate(enrollment.Definition.CodeIssuedAt)</dd>
                    <dt>@T("CodeExpiresAt")</dt><dd>@FormatDate(enrollment.Definition.CodeExpiresAt)</dd>
                    <dt>@T("AttemptCount")</dt><dd>@enrollment.Definition.AttemptCount</dd>
                    <dt>@T("Registration")</dt><dd>@(enrollment.Definition.RegistrationName ?? "—")</dd>
                    <dt>@T("Outcome")</dt><dd>@(enrollment.Definition.Outcome ?? "—")</dd>
                </dl>
                <div class="panel-actions">
                    <a class="button-primary" href="/extensions?tab=enrollments">@T("ManageEnrollment")</a>
                    @if (CanAdminister && CanUnenroll(enrollment.Definition.State))
                    {
                        <button class="button-danger" @onclick="() => confirmUnenroll = true">@T("UnenrollExtension")</button>
                    }
                </div>
            }
            else if (item.EnrollmentInstanceId is { } instanceId)
            {
                <dl class="resource-details">
                    <dt>@T("EnrollmentInstance")</dt><dd><code>@instanceId</code></dd>
                    <dt>@T("EnrollmentState")</dt><dd>@if (item.EnrollmentStatus is { } state) { <StatusBadge Text="@EnrollmentStatusLabel(state)" Status="@EnrollmentStatus(state)" /> } else { <span>—</span> }</dd>
                    @if (item.AnnouncedAt is { } announced) { <dt>@T("AnnouncedAt")</dt><dd>@FormatDate(announced)</dd> }
                </dl>
            }
            else
            {
                <p>@T("NoEnrollmentDetails")</p>
            }
        </section>
    }

    @if (activeTab == DetailTab.Contributions)
    {
        <section class="panel resource-section">
            <div class="panel-header"><div><p class="eyebrow">@T("Contributions")</p><h2>@T("Contributions")</h2><p>@T("Contributions.Description")</p></div><span>@T("ContributionCount", item.Extension?.Contributions.Count ?? 0)</span></div>
            @if (item.Extension?.Contributions.Count > 0)
            {
                <div class="extension-contribution-list" data-testid="extension-contribution-list">
                    @foreach (var contribution in item.Extension.Contributions)
                    {
                        var resources = MaterializedResources(contribution);
                        var tools = MaterializedTools(contribution);
                        var toolState = ToolContributionState(tools);
                        var contributionState = contribution.Kind == "tool" ? toolState : BundleContributionState(contribution);
                        <article class="extension-contribution-card" data-contribution-kind="@contribution.Kind" data-contribution-id="@contribution.Id">
                            <div class="extension-contribution-heading">
                                <div>
                                    <span class="extension-contribution-kind">@ContributionKindLabel(contribution.Kind)</span>
                                    <h3>@contribution.Id</h3>
                                    <p>@ContributionDescription(contribution, resources.Count + tools.Count)</p>
                                </div>
                                <div class="extension-contribution-actions">
                                    @if (contribution.Kind is "tool" or "data-source-profile-bundle") { <StatusBadge Text="@T($"ContributionState.{contributionState}")" Status="@(contributionState == "Available" ? UiStatus.Success : contributionState == "Conflict" ? UiStatus.Danger : UiStatus.Warning)" /> }
                                    @if (contribution.Kind == "tool" && toolState != "Conflict" && extensionToolProvider is not null)
                                    { <a href="@ToolProviderUrl(extensionToolProvider)" class="text-button">@T("OpenProvider", extensionToolProvider.Definition.DisplayName) →</a> }
                                    @foreach (var provider in item.Extension.Providers.Where(value => value.ContributionId == contribution.Id)) { <a class="text-button" href="@ProviderUrl(provider)">@T("OpenProvider", provider.Name) →</a> }
                                    @if (contribution.Kind == "model-provider" && !item.Extension.Providers.Any(value => value.ContributionId == contribution.Id)) { <a class="text-button" href="@ConfigureProviderUrl(item.Extension, contribution)">@T("ConfigureProvider", contribution.Id) →</a> }
                                </div>
                            </div>
                            @if (tools.Count > 0 || resources.Count > 0)
                            {
                                <div class="extension-materialized-resources">
                                    <p class="extension-materialized-label">@T("MaterializedResources", tools.Count + resources.Count)</p>
                                    <ul class="resource-links">
                                        @foreach (var tool in tools)
                                        {
                                            <li>@if (toolState != "Conflict") { <a href="@ToolUrl(tool)"><span><strong>@tool.Definition.DisplayName</strong><code>@tool.Definition.ExternalId</code></span><span class="extension-resource-meta"><span>@T("ContributionKind.tool")</span><ResourceScopeBadge ScopeRef="tool.ScopeRef" Compact /></span></a> } else { <code>@tool.Namespace/@tool.Name</code> }</li>
                                        }
                                        @foreach (var resource in resources)
                                        {
                                            <li>@if (ManagedResourceUrl(resource) is { } url) { <a href="@url"><span><strong>@resource.Name</strong><code>@resource.Namespace/@resource.Name</code></span><span class="extension-resource-meta"><span>@ManagedResourceKindLabel(resource.Kind)</span><ResourceScopeBadge ScopeRef="resource.ScopeRef" Compact /></span></a> }</li>
                                        }
                                    </ul>
                                </div>
                            }
                        </article>
                    }
                </div>
            }
            else { <p>@T("NoContributions")</p> }
        </section>
    }

    @if (activeTab == DetailTab.Resources)
    {
        <section class="panel resource-section extension-managed-resources" data-testid="extension-governed-inventory">
            <div class="panel-header"><div><p class="eyebrow">@T("ManagedResources")</p><h2>@T("ManagedResources")</h2><p>@T("ManagedResources.Description")</p></div><span>@T("InstallationCount", item.Extension?.BundleInstallations?.Count ?? 0)</span></div>
            @if (item.Extension?.BundleInstallations?.Count > 0)
            {
                @foreach (var installation in item.Extension.BundleInstallations)
                {
                    var resources = installation.ManagedResources.Where(resource => !resource.Published).ToArray();
                    var publications = installation.ManagedResources.Where(resource => resource.Published).ToArray();
                    <article class="resource-section extension-bundle-card" data-testid="extension-bundle-installation" data-bundle-id="@installation.BundleId">
                        <div class="extension-bundle-heading">
                            <div class="extension-bundle-title"><span class="extension-bundle-icon" aria-hidden="true"><UiIcon Name="layers" /></span><div><p class="eyebrow">@T("Bundle")</p><h3>@installation.BundleId</h3></div></div>
                            <StatusBadge Text="@T($"InstallationState.{installation.State}")" Status="@InstallationStatus(installation.State)" />
                        </div>
                        <div class="extension-bundle-meta"><span>@T("BundleVersion") <strong>@installation.BundleVersion</strong></span><ResourceScopeBadge ScopeRef="installation.ScopeRef" /><span>@T("ExtensionVersion") <strong>@installation.ExtensionVersion</strong></span></div>
                        @if (installation.ToolBindings.Count > 0)
                        {
                            <div class="extension-bundle-bindings"><p class="field-label">@T("ToolBindings")</p><div class="extension-bundle-binding-list">@foreach (var binding in installation.ToolBindings) { <a href="@ToolReferenceUrl(installation.ScopeRef, binding.Value)" title="@binding.Value.Name">@binding.Key</a> }</div></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(installation.Diagnostic)) { <div class="extension-bundle-diagnostic"><strong>@T("Diagnostics")</strong><p>@installation.Diagnostic</p></div> }
                        @if (resources.Length > 0)
                        {
                            <div class="extension-bundle-grid" data-testid="extension-managed-resources"><DataGrid TItem="ExtensionManagedResourceResponse" Items="resources">
                                <Header><tr><th>@T("Type")</th><th>@T("Identity")</th><th>@T("Scope")</th><th>@T("Version")</th><th>@T("State")</th></tr></Header>
                                <Row Context="resource"><tr>
                                    <td data-label="@T("Type")"><span class="extension-bundle-kind">@ManagedResourceKindLabel(resource.Kind)</span></td>
                                    <td data-label="@T("Identity")">@if (installation.State != ExtensionBundleInstallationState.Degraded && ManagedResourceUrl(resource) is { } url) { <a class="text-button" href="@url">@resource.Namespace/@resource.Name</a> } else { <code>@resource.Namespace/@resource.Name</code> }</td>
                                    <td data-label="@T("Scope")"><ResourceScopeBadge ScopeRef="resource.ScopeRef" Compact /></td>
                                    <td data-label="@T("Version")"><code>@(resource.Version ?? "—")</code></td>
                                    <td data-label="@T("State")"><StatusBadge Text="@T("ManagedReadOnly")" Status="UiStatus.Neutral" /></td>
                                </tr></Row>
                            </DataGrid></div>
                        }
                        else { <p>@T("NoManagedResources")</p> }
                        <details class="extension-bundle-evidence" data-testid="extension-technical-details"><summary>@T("TechnicalDetails")</summary><dl class="resource-details"><dt>@T("Identity")</dt><dd><code>@installation.Name</code></dd><dt>@T("ManagingExtension")</dt><dd><code>@installation.ExtensionId</code></dd><dt>@T("BundleDigest")</dt><dd><code>@installation.BundleDigest</code></dd><dt>@T("ToolBindings")</dt><dd>@foreach (var binding in installation.ToolBindings) { <div><code>@binding.Key</code><br /><code>@binding.Value.Name</code></div> }</dd></dl>
                            @if (publications.Length > 0)
                            {
                                <h4>@T("PublishedVersions")</h4>
                                <ul class="extension-bundle-publications" data-testid="extension-published-versions">
                                    @foreach (var publication in publications)
                                    {
                                        <li><div><strong>@ManagedResourceKindLabel(publication.Kind)</strong><code>@publication.Namespace/@publication.Name</code></div><div><ResourceScopeBadge ScopeRef="publication.ScopeRef" Compact /><span>@T("Version") <code>@(publication.Version ?? "—")</code></span></div></li>
                                    }
                                </ul>
                            }
                        </details>
                    </article>
                }
            }
            else { <p>@T("NoBundleInstallations")</p> }
        </section>
    }

    @if (activeTab == DetailTab.Options)
    {
        <section class="panel resource-section">
            <div class="panel-header"><div><p class="eyebrow">@T("OptionContracts")</p><h2>@T("OptionContracts")</h2><p>@T("OptionContracts.Description")</p></div><span>@T("SetCount", item.Extension?.OptionSets.Count ?? 0)</span></div>
            @if (item.Extension?.OptionSets.Count > 0)
            {
                <DataGrid TItem="ExtensionOptionSetResponse" Items="item.Extension.OptionSets">
                    <Header><tr><th>@T("OptionSet")</th><th>@T("Target")</th><th>@T("Preferred")</th><th>@T("SupportedVersions")</th></tr></Header>
                    <Row Context="optionSet"><tr><td><code>@optionSet.Id</code></td><td>@optionSet.ContributionKind · <code>@optionSet.ContributionId</code> · @optionSet.Scope</td><td>@optionSet.PreferredVersion</td><td>@foreach (var version in optionSet.Versions) { <div><strong>@version.Version</strong>@(version.Deprecated ? T("DeprecatedSuffix") : null)<br /><code>@version.SchemaDigest</code><details><summary>@T("JsonSchema")</summary><pre class="runner-json">@JsonSerializer.Serialize(version.Schema, IndentedJsonOptions)</pre></details></div> }</td></tr></Row>
                </DataGrid>
            }
            else { <p class="inline-warning">@(item.AvailabilityStatus == "available" ? T("NoVersionedOptionContract") : T("ContractsUnavailable"))</p> }
        </section>
    }

    @if (activeTab == DetailTab.Usages)
    {
        <section class="panel resource-section">
            <div class="panel-header"><div><p class="eyebrow">@T("PersistedUsage")</p><h2>@T("PersistedUsage")</h2><p>@T("PersistedUsage.Description")</p></div><span>@T("ProfileCount", item.Extension?.Usages.Count ?? 0)</span></div>
            @if (item.Extension?.Usages.Count > 0)
            {
                <DataGrid TItem="ExtensionOptionUsageResponse" Items="item.Extension.Usages">
                    <Header><tr><th>@T("ModelProfile")</th><th>@T("Contract")</th><th>@T("Status")</th><th>@T("Diagnostics")</th></tr></Header>
                    <Row Context="usage"><tr><td><a href="@ProfileUrl(usage)">@usage.ProfileName</a><br /><small>@usage.ProfileNamespace</small></td><td>@if (string.IsNullOrWhiteSpace(usage.OptionSet)) { <span>@T("LegacyUnversionedOptions")</span> } else { <code>@usage.OptionSet@@@usage.Version</code> }</td><td><StatusBadge Text="@StatusLabel(usage.Status)" Status="@ModelManagementUi.Status(usage.Status)" />@if (MigrationTarget(item.Extension, usage) is { } targetVersion) { <br /><button class="button-secondary" @onclick="() => PreviewMigrationAsync(usage, targetVersion)" disabled="@migrating">@T("MigrateTo", targetVersion)</button> }</td><td>@(usage.Issues.Count == 0 ? T("Compatible") : string.Join(" ", usage.Issues))</td></tr></Row>
                </DataGrid>
            }
            else { <p>@T("NoPersistedUsage")</p> }
        </section>
        @if (migrationPreview is not null)
        {
            <section class="panel resource-section">
                <div class="panel-header"><div><p class="eyebrow">@T("ExplicitMigrationPreview")</p><h2>@migrationPreview.Value.ProfileNamespace/@migrationPreview.Value.ProfileName</h2><p>@T("NoProfileChanged")</p></div><span>@migrationPreview.Value.Source.Version → @migrationPreview.Value.Target.Version</span></div>
                <div class="details-grid"><article><h3>@T("CurrentOptions")</h3><pre class="runner-json">@JsonSerializer.Serialize(migrationPreview.Value.Source, IndentedJsonOptions)</pre></article><article><h3>@T("ProposedOptions")</h3><pre class="runner-json">@JsonSerializer.Serialize(migrationPreview.Value.Target, IndentedJsonOptions)</pre></article></div>
                <div class="panel-actions"><button class="button-primary" @onclick="ApplyMigrationAsync" disabled="@migrating">@(migrating ? T("Applying") : T("ApplyMigration"))</button><button class="button-secondary" @onclick="() => migrationPreview = null" disabled="@migrating">@T("Cancel")</button></div>
            </section>
        }
    }
}

<ConfirmationDialog IsOpen="@confirmDelete" Title="@T("DeleteExtensionRegistration")" Message="@T("DeleteRegistrationMessage", item?.RegistrationNamespace ?? string.Empty, item?.RegistrationName ?? string.Empty)" ConfirmLabel="@T("DeleteRegistration")" OnConfirm="DeleteAsync" OnCancel="() => confirmDelete = false" />
<ConfirmationDialog IsOpen="@confirmUnenroll" Title="@T("UnenrollExtension")" Message="@T("UnenrollExtensionMessage")" ConfirmLabel="@T("ConfirmUnenrollExtension")" OnConfirm="UnenrollAsync" OnCancel="() => confirmUnenroll = false" />

</div>

@code {
    private static readonly JsonSerializerOptions IndentedJsonOptions = new() { WriteIndented = true };
    [Parameter] public string? RegistrationName { get; set; }
    [Parameter] public Guid? EnrollmentInstanceId { get; set; }
    [SupplyParameterFromQuery(Name = "namespace")] public string? ResourceNamespaceValue { get; set; }
    [SupplyParameterFromQuery(Name = "scopeRef")] public string? ScopeRefValue { get; set; }
    private readonly CancellationTokenSource cancellation = new();
    private ExtensionInventoryItemResponse? item;
    private AepEnrollmentRequestResource? enrollment;
    private ResourceSnapshot<ExtensionRegistrationResource>? registration;
    private AgentstrationApiException? error;
    private bool loading = true;
    private bool editing;
    private bool saving;
    private bool confirmDelete;
    private bool confirmUnenroll;
    private bool migrating;
    private IReadOnlyList<ToolResource> extensionTools = [];
    private ToolProviderResource? extensionToolProvider;
    private ResourceSnapshot<ModelProfileOptionMigrationPreviewResponse>? migrationPreview;
    private RegistrationEditForm form = new();
    private DetailTab activeTab;
    private bool CanAdminister => Services.GetService(typeof(ConsoleContextState)) is ConsoleContextState state
        && state.HasPermission(AuthorizationPermissions.ResourcesWrite);
    private bool CanEditRegistration => CanAdminister && registration?.Value.Definition.Source == ExtensionRegistrationSource.Manual
        && ResourceOwnershipContext.CanManage(registration.Value.ScopeRef ?? ResourceScopeRef.Instance, Services);
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    private string StatusLabel(string status) => T($"Status.{status}");
    private string EnrollmentStatusLabel(AepEnrollmentState status) => T($"EnrollmentStatus.{status}");
    private string SourceLabel(string source) => T($"Source.{source}");

    protected override Task OnParametersSetAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        loading = true; error = null;
        try
        {
            var inventory = await Client.GetExtensionInventoryAsync(cancellation.Token);
            item = RegistrationName is not null
                ? inventory.SingleOrDefault(value => string.Equals(value.RegistrationName, RegistrationName, StringComparison.Ordinal)
                    && string.Equals(value.RegistrationNamespace, ResourceNamespaceValue ?? ResourceNamespace.DefaultValue, StringComparison.Ordinal)
                    && (ScopeRefValue is null || value.RegistrationScopeRef == ResourceScopeRef.Parse(ScopeRefValue)))
                : inventory.SingleOrDefault(value => value.EnrollmentInstanceId == EnrollmentInstanceId);
            registration = item?.RegistrationName is null ? null : ScopeRefValue is not null && item.RegistrationScopeRef is { } scope
                ? await Client.GetRegistrationAsync(scope, ResourceNamespace.Parse(item.RegistrationNamespace), item.RegistrationName, cancellation.Token)
                : await Client.GetRegistrationAsync(ResourceNamespace.Parse(item.RegistrationNamespace), item.RegistrationName, cancellation.Token);
            extensionTools = [];
            extensionToolProvider = null;
            if (item?.RegistrationName is not null && Services.GetService<IToolsClient>() is { } toolsClient)
            {
                try
                {
                    var candidates = item.RegistrationScopeRef is { } scopeRef
                        ? await toolsClient.GetToolsAsync(scopeRef, cancellationToken: cancellation.Token)
                        : await toolsClient.GetToolsAsync(cancellationToken: cancellation.Token);
                    extensionTools = candidates.Where(ToolBelongsToExtension).ToArray();
                    extensionToolProvider = (await toolsClient.GetProvidersAsync(cancellation.Token)).SingleOrDefault(provider =>
                        provider.Name == item.RegistrationName && provider.Namespace.Value == item.RegistrationNamespace
                        && provider.ScopeRef == item.RegistrationScopeRef
                        && provider.Definition.Aep?.Extension.Name == item.RegistrationName
                        && (provider.Definition.Aep.Extension.Namespace ?? provider.Namespace).Value == item.RegistrationNamespace
                        && (provider.Definition.Aep.Extension.ScopeRef ?? provider.ScopeRef) == item.RegistrationScopeRef);
                }
                catch (AgentstrationApiException) { }
            }
            enrollment = null;
            if (CanAdminister && item?.EnrollmentInstanceId is { } instanceId)
            {
                var enrollmentRequests = await Client.GetEnrollmentsAsync(cancellation.Token);
                enrollment = enrollmentRequests.SingleOrDefault(value => value.Definition.InstanceId == instanceId);
            }
        }
        catch (AgentstrationApiException exception) { error = exception; }
        finally { loading = false; }
    }
