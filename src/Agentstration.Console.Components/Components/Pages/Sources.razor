    private RefreshScheduleSummary? NextRefresh()
    {
        if (detail is null) return null;
        var now = Clock.GetUtcNow();
        var source = detail.Source.Source;
        var refresh = detail.Source.Configuration.Definition.Refresh;
        var candidates = new List<RefreshScheduleSummary>();
        if (refresh.Source.Enabled && detail.Source.Configuration.Definition.Origin is not null)
        {
            candidates.Add(new(SourceRefreshSchedule.GetNextDue(
                detail.Source.Observed.Definition.LastAttemptAt,
                detail.Source.Observed.Definition.ConsecutiveFailures,
                refresh.Source,
                $"{source.ScopeRef}|{source.Namespace}|{source.Name}|source"),
                T("SourceDefinitionRefresh")));
        }
        foreach (var channel in detail.Channels)
        {
            var policy = refresh.ChannelOverrides.TryGetValue(channel.Definition.Name, out var configured)
                ? configured
                : refresh.Channels;
            if (!policy.Enabled) continue;
            var observed = channel.Status.Refresh?.Definition;
            var next = observed is null
                ? now
                : SourceRefreshSchedule.GetNextDue(observed.LastAttemptAt, observed.ConsecutiveFailures, policy,
                    $"{source.ScopeRef}|{source.Namespace}|{source.Name}|{detail.SelectedVersion.Uid:N}|{channel.Definition.Name}");
            candidates.Add(new(next, F("ChannelRefreshTarget", channel.Definition.Name)));
        }
        return candidates.OrderBy(value => value.At).FirstOrDefault();
    }
    private string NextRefreshDate(RefreshScheduleSummary summary) =>
        summary.At <= Clock.GetUtcNow() ? T("RefreshDueNow") : summary.At.ToLocalTime().ToString("g");
