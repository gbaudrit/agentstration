                    </div>
                }
                @if (channel.Catalogs.Count > 0)
                {
                    <div class="catalog-toolbar"><h4>@T("Catalogs")</h4><FormField Label="@T("ContentLanguage")"><ChildContent><ClearableSelect TValue="string" Value="@Convert.ToString(catalogLocale, System.Globalization.CultureInfo.InvariantCulture)" ValueChanged="changed => ChangeLocaleAsync(new ChangeEventArgs { Value = changed })">@foreach (var locale in AvailableCatalogLocales(channel)) { <option value="@locale">@LocaleLabel(channel, locale)</option> }</ClearableSelect></ChildContent></FormField></div>
                    @foreach (var catalog in channel.Catalogs)
                    {
                        <section class="catalog-card"><div><strong>@catalog.DisplayName</strong><small><code>@catalog.Provenance.CatalogKind/@catalog.Provenance.CatalogName</code> · @catalog.Provenance.CatalogPath</small>@if (catalog.Description is not null) { <p>@catalog.Description</p> }</div>
                            @foreach (var entry in catalog.BootstrapEntries)
                            {
                                <div class="catalog-entry"><span><strong>@entry.Name</strong><small>@F("Locales", string.Join(", ", entry.Variants.Select(value => value.Locale))) · @F("SelectedLocale", entry.ResolvedLocale)@if (entry.ResolvedLocale != catalogLocale) { <em> · @F("FallbackFrom", catalogLocale)</em> }</small><code>@entry.ResolvedPath</code></span><a class="button-primary" href="@BootstrapUrl(channel, catalog, entry)">@T("PreviewAndApply")</a></div>
                            }
                            @foreach (var entry in catalog.PackEntries)
                            {
                                <div class="catalog-entry"><span><strong>@if (IsPackInstalled(entry)) { <a class="text-link" href="@PackUrl(entry)">@(entry.DisplayName ?? entry.Name)</a> } else { @(entry.DisplayName ?? entry.Name) }</strong><small>@entry.Description</small><code>@entry.Path</code></span><div class="catalog-entry-actions"><button class="button-secondary" disabled="@(DetailBusy || !installedPacksKnown || !CanInstall)" @onclick="() => PreviewPackAsync(channel, catalog, entry)">@(IsPackInstalled(entry) ? T("ReinstallPack") : T("InstallPack"))</button></div></div>
                            }
                        </section>
                    }
                }
            </article>
        }
        </section>
}</div>;
