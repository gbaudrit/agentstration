                <dl class="resource-details channel-details">
                    <dt>@T("Provider")</dt><dd>@if (channel.CurrentSnapshot is { } providerSnapshot) { <a class="text-link" href="@SourceProviderUrl(providerSnapshot.Definition.Provider)">@providerSnapshot.Definition.Provider.Namespace/@providerSnapshot.Definition.Provider.Name</a><small>@F("ProviderGeneration", providerSnapshot.Definition.Provider.ContributionId, providerSnapshot.Definition.Provider.Generation)</small> } else { @T("PendingMaterialization") }</dd>
                    <dt>@T("Compatibility")</dt><dd>@CompatibilityLabel(channel.Status.Compatibility.Status)</dd>
                    <dt>@T("LastAttempt")</dt><dd>@(channel.Status.Refresh is null ? T("Never") : channel.Status.Refresh.Definition.LastAttemptAt.ToLocalTime().ToString("g"))</dd>
                    <dt>@T("Result")</dt><dd>@(channel.Status.Refresh is null ? "—" : RefreshOutcome(channel.Status.Refresh.Definition.LastOutcome))</dd>
                    <dt>@T("ResolvedRevision")</dt><dd><code>@(channel.CurrentSnapshot is null ? "—" : channel.CurrentSnapshot.Definition.ResolvedRevision)</code></dd>
                    <dt>@T("Snapshot")</dt><dd>@if (channel.CurrentSnapshot is { } currentSnapshot) { <code>@currentSnapshot.Uid.ToString("D")</code><small>@Short(currentSnapshot.Definition.Artifact.Sha256)</small> } else { <text>—</text> }</dd>
