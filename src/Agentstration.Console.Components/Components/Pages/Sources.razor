}

@code {
    [Parameter] public string? Publisher { get; set; }
    [Parameter] public string? Name { get; set; }
    [SupplyParameterFromQuery(Name = "scopeRef")] public string? ScopeRefValue { get; set; }
    [SupplyParameterFromQuery(Name = "versionUid")] public Guid? VersionUid { get; set; }


    private readonly CancellationTokenSource lifetime = new();
    private IReadOnlyList<SourceConsoleListItem>? sources;
    private SourceConsoleDetailView? detail;
    private Dictionary<string, SourceConsoleBindingSelection> bindingSelections => model.BindingSelections;
    private string displayName { get => model.DisplayName; set => model.DisplayName = value; }
    private SourceRefreshPolicyForm sourceRefresh => model.SourceRefresh;
    private SourceRefreshPolicyForm channelRefresh => model.ChannelRefresh;
    private Dictionary<string, SourceRefreshPolicyForm> channelRefreshOverrides => model.ChannelOverrides;
    private string catalogLocale = string.IsNullOrWhiteSpace(CultureInfo.CurrentUICulture.Name)
        ? "en-US"
        : CultureInfo.CurrentUICulture.Name;
    private string importMode { get => importModel.Method; set => importModel.Method = value; }
    private string importUrl { get => importModel.Url; set => importModel.Url = value; }
    private string importYaml { get => importModel.Yaml; set => importModel.Yaml = value; }
    private ResourceScopeRef? importScope { get => importModel.ScopeRef; set => importModel.ScopeRef = value; }
    private bool importing;
    private bool interactive;


    private void OpenCollectionImport() { if (importing) CloseImport(); else importing = true; }
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { interactive = true; StateHasChanged(); }
        return Task.CompletedTask;
    }
    private bool busy;
    private string? error;
    private SourcePackSelection? packSelection;
    private SourcePackInstallationPreview? sourcePackPreview;
    private PackInstallationPreview? packPreview => sourcePackPreview?.Pack;
    private readonly Dictionary<string, string> packBindingSelections = new(StringComparer.Ordinal);
    private IReadOnlyList<ModelProfileSummaryResponse> packModelProfiles = [];
    private IReadOnlyList<ModelProviderResponse> packModelProviders = [];
    private IReadOnlyList<RuntimeProfileSummaryResponse> packRuntimeProfiles = [];
    private IReadOnlyList<ExtensionRegistrationResource> packExtensions = [];
    private IReadOnlyList<ParameterResource> packParameters = [];
    private IReadOnlyList<SecretResponse> packSecrets = [];
    private string? packError;
    private bool packPreviewing;
    private bool packInstalling;
    private bool replacePack;
    private bool reinstallPack;
    private IReadOnlySet<string> installedPackIdentities = new HashSet<string>(StringComparer.Ordinal);
    private string? selectedChannelName;
    private bool confirmDeleteSource;
    private bool deletingSource;
    private string? deleteError;

    private IReadOnlyList<SourceConsoleChannelView> DisplayedChannels => detail is null ? [] : detail.Channels.Count <= 1 ? detail.Channels : detail.Channels.Where(channel => channel.Definition.Name == selectedChannelName).ToArray();
    private bool CanImport => importScope is not null && importModel.HasManifest;
    private bool CanInstallPack => CanInstall && installedPacksKnown && packPreview is not null && !packPreviewing && !packInstalling
        && (packPreview.CanInstall || packPreview.AlreadyInstalled && replacePack)
        && packPreview.Bindings.All(binding => !binding.Required || !string.IsNullOrWhiteSpace(PackBindingValue(binding.Name)));

    private sealed record PackChoice(string Key, string Label);
    private IReadOnlyList<PackChoice> PackChoices(PackBindingTargetKind kind) => kind switch
    {
        PackBindingTargetKind.ModelProfile => packModelProfiles.Select(item => new PackChoice(BindingValue(item.Name, ResourceNamespace.Parse(item.Namespace), item.ScopeRef), $"{item.Properties.DisplayName} — {item.ScopeRef} · {item.Namespace}/{item.Name}")).ToArray(),
        PackBindingTargetKind.ModelProvider => packModelProviders.Select(item => new PackChoice(BindingValue(item.Name, ResourceNamespace.Parse(item.Namespace), item.ScopeRef), $"{item.Properties.DisplayName} — {item.ScopeRef} · {item.Namespace}/{item.Name}")).ToArray(),
        PackBindingTargetKind.RuntimeProfile => packRuntimeProfiles.Select(item => new PackChoice(BindingValue(item.Name, ResourceNamespace.Parse(item.Namespace), item.ScopeRef), $"{item.Properties.DisplayName} — {item.ScopeRef} · {item.Namespace}/{item.Name}")).ToArray(),
        PackBindingTargetKind.ExtensionRegistration => packExtensions.Select(item => new PackChoice(BindingValue(item.Name, item.Namespace, item.ScopeRef), $"{item.Definition.DisplayName} — {item.ScopeRef} · {item.Namespace}/{item.Name}")).ToArray(),
        PackBindingTargetKind.Parameter => packParameters.Select(item => new PackChoice(BindingValue(item.Name, item.Namespace, item.ScopeRef), $"{item.Definition.DisplayName} — {item.ScopeRef} · {item.Namespace}/{item.Name}")).ToArray(),
        _ => packSecrets.Select(item => new PackChoice(BindingValue(item.Resource.Name, item.Resource.Namespace, item.Resource.ScopeRef), $"{item.Resource.Definition.DisplayName} — {item.Resource.ScopeRef} · {item.Resource.Namespace}/{item.Resource.Name}")).ToArray()
    };
    private static bool MatchesPackPin(SourcePackInstallationPreview preview, SourcePackSelection selection) => preview.Pin.SourceVersionUid == selection.SourceVersionUid
        && preview.Pin.Channel == selection.Channel && preview.Pin.SnapshotUid == selection.SnapshotUid && preview.Pin.CatalogName == selection.CatalogName && preview.Pin.EntryName == selection.EntryName;
    private async Task PreviewPackAsync(SourceConsoleChannelView channel, SourceCatalogView catalog, SourceCatalogEntryView entry)
    {
        if (DetailBusy || !CanInstall || !installedPacksKnown || channel.CurrentSnapshot is null) return;
        var epoch = detailEpoch; var key = detailKey; var request = ++packRevision;
        packSelection = new(ScopeRef(), Publisher!, Name!, detail!.SelectedVersion.Uid, channel.Definition.Name,
            channel.Status.Refresh!.Definition.CurrentSnapshotUid!.Value, catalog.Provenance.CatalogName, entry.Name);
        var selection = packSelection; reinstallPack = IsPackInstalled(entry);
        sourcePackPreview = null; packError = null; replacePack = reinstallPack; packBindingSelections.Clear(); packPreviewing = true;
        try
        {
            var preview = await Service.PreviewPackAsync(selection, [], replacePack, lifetime.Token);
            if (!CurrentCommand(epoch, key) || request != packRevision || packSelection != selection) return;
            if (!MatchesPackPin(preview, selection)) throw new InvalidOperationException(T("PackPreviewMismatch"));
            sourcePackPreview = preview;
            foreach (var binding in preview.Pack.Bindings.Where(value => value.TargetAvailable && value.Target is not null))
                packBindingSelections[binding.Name] = BindingValue(binding.Target!.Name, binding.Target.Namespace ?? ResourceNamespace.Default, binding.Target.ScopeRef);
            await LoadPackBindingOptionsAsync(preview.Pack.Bindings, epoch, key, request);
            if (!CurrentCommand(epoch, key) || request != packRevision || packSelection != selection) return;
            if (packBindingSelections.Count > 0)
            {
                var bound = await Service.PreviewPackAsync(selection, SelectedPackBindings(), replacePack, lifetime.Token);
                if (CurrentCommand(epoch, key) && request == packRevision && packSelection == selection) { if (!MatchesPackPin(bound, selection)) throw new InvalidOperationException(T("PackPreviewMismatch")); sourcePackPreview = bound; }
            }
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) { if (CurrentCommand(epoch, key) && request == packRevision) { packError = exception.Message; sourcePackPreview = null; } }
        finally { if (CurrentCommand(epoch, key) && request == packRevision) packPreviewing = false; }
    }
    private async Task InstallPackAsync()
    {
        if (!CanInstallPack || packSelection is null || sourcePackPreview is null) return;
        var epoch = detailEpoch; var key = detailKey; var selection = packSelection; var expected = sourcePackPreview;
        packInstalling = true; packError = null;
        try
        {
            var installed = await Service.InstallPackAsync(selection, expected.PreviewDigest, replacePack, SelectedPackBindings(), lifetime.Token);
            if (!CurrentCommand(epoch, key) || packSelection != selection) return;
            if (installed.Value.Definition.Publisher != expected.Pack.Metadata.Publisher || installed.Value.Definition.PackName != expected.Pack.Metadata.Name) throw new InvalidOperationException(T("PackPreviewMismatch"));
            Notify("PackInstalled", F("PackInstalledMessage", installed.Value.Definition.DisplayName ?? installed.Value.Definition.PackName));
            packSelection = null; sourcePackPreview = null;
            Navigation.NavigateTo(ResourceOwnershipContext.PreserveNavigation($"/packs?publisher={Uri.EscapeDataString(installed.Value.Definition.Publisher)}&name={Uri.EscapeDataString(installed.Value.Definition.PackName)}", Services));
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) { if (CurrentCommand(epoch, key)) packError = exception.Message; }
        finally { if (CurrentCommand(epoch, key)) packInstalling = false; }
    }
    private void ClosePackPreview() { if (!packInstalling) { packRevision++; packPreviewing = false; packSelection = null; sourcePackPreview = null; packError = null; reinstallPack = false; } }
    private string? PackBindingValue(string name) => packBindingSelections.GetValueOrDefault(name);
    private async Task SetPackBindingAsync(string name, ChangeEventArgs args)
    {
        if (packInstalling) return;
        packBindingSelections[name] = args.Value?.ToString()?.Trim() ?? string.Empty;
        await RefreshPackPreviewAsync();
    }
    private async Task SetReplacePackAsync(ChangeEventArgs args)
    {
        if (packInstalling) return;
        replacePack = args.Value is true;
        await RefreshPackPreviewAsync();
    }
    private IReadOnlyList<PackBindingSelection> SelectedPackBindings() => packBindingSelections
        .Where(value => !string.IsNullOrWhiteSpace(value.Value)).Select(value => new PackBindingSelection(value.Key, ParsePackBinding(value.Value))).ToArray();
    private async Task RefreshPackPreviewAsync()
    {
        if (packSelection is null || packInstalling) return;
        var epoch = detailEpoch; var key = detailKey; var selection = packSelection; var request = ++packRevision;
        packPreviewing = true; packError = null;
        try { var incoming = await Service.PreviewPackAsync(selection, SelectedPackBindings(), replacePack, lifetime.Token); if (CurrentCommand(epoch, key) && request == packRevision && packSelection == selection) { if (!MatchesPackPin(incoming, selection)) throw new InvalidOperationException(T("PackPreviewMismatch")); sourcePackPreview = incoming; } }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) { if (CurrentCommand(epoch, key) && request == packRevision) { packError = exception.Message; sourcePackPreview = null; } }
        finally { if (CurrentCommand(epoch, key) && request == packRevision) packPreviewing = false; }
    }
    private async Task LoadPackBindingOptionsAsync(IReadOnlyList<PackBindingPreview> bindings, long epoch, string key, long request)
    {
        if (bindings.Any(value => value.TargetKind == PackBindingTargetKind.ModelProfile)) { var values = await Services.GetRequiredService<IModelProfilesClient>().GetModelProfilesAsync(null, null, null, lifetime.Token); if (!CurrentCommand(epoch, key) || request != packRevision) return; packModelProfiles = values; }
        if (bindings.Any(value => value.TargetKind == PackBindingTargetKind.ModelProvider)) { var values = await Services.GetRequiredService<IModelProvidersClient>().GetModelProvidersAsync(lifetime.Token); if (!CurrentCommand(epoch, key) || request != packRevision) return; packModelProviders = values; }
        if (bindings.Any(value => value.TargetKind == PackBindingTargetKind.RuntimeProfile)) { var values = await Services.GetRequiredService<IRuntimeProfilesClient>().GetRuntimeProfilesAsync(lifetime.Token); if (!CurrentCommand(epoch, key) || request != packRevision) return; packRuntimeProfiles = values; }
        if (bindings.Any(value => value.TargetKind == PackBindingTargetKind.ExtensionRegistration)) { var values = await Services.GetRequiredService<IExtensionsClient>().GetRegistrationsAsync(lifetime.Token); if (!CurrentCommand(epoch, key) || request != packRevision) return; packExtensions = values; }
        if (bindings.Any(value => value.TargetKind == PackBindingTargetKind.Parameter)) { var values = await Services.GetRequiredService<IParametersClient>().GetParametersAsync(lifetime.Token); if (!CurrentCommand(epoch, key) || request != packRevision) return; packParameters = values; }
        if (bindings.Any(value => value.TargetKind == PackBindingTargetKind.Secret)) { var values = await Services.GetRequiredService<ISecretsClient>().GetSecretsAsync(lifetime.Token); if (!CurrentCommand(epoch, key) || request != packRevision) return; packSecrets = values; }
    }
    private static string BindingValue(string name, ResourceNamespace @namespace, ResourceScopeRef? scopeRef = null) =>
        scopeRef is null ? $"{@namespace.Value}:{name}" : $"{scopeRef.Value.Value}|{@namespace.Value}:{name}";
    private static ResourceReference ParsePackBinding(string value)
    {
        var scoped = value.Split('|', 2);
        var parts = scoped[^1].Split(':', 2);
        if (parts.Length != 2 || string.IsNullOrWhiteSpace(parts[0]) || string.IsNullOrWhiteSpace(parts[1]))
            throw new SourceValidationException("source_pack_binding_invalid", "Pack binding targets must use namespace:resource-name.");
        ResourceScopeRef? scopeRef = scoped.Length == 2 && !string.IsNullOrWhiteSpace(scoped[0]) ? ResourceScopeRef.Parse(scoped[0]) : null;
        return new(parts[1], scopeRef, ResourceNamespace.Parse(parts[0]));
    }
    private ResourceScopeRef? PackTargetScope() => packPreview?.TargetScope switch { ResourceScopeKind.Instance => ResourceScopeRef.Instance, ResourceScopeKind.Tenant => ResourceScopeRef.Tenant(ContextState.Current?.TenantId ?? Guid.Empty), _ => ResourceScopeRef.Workspace(ContextState.Current?.WorkspaceId ?? Guid.Empty) };
    private string PackResourceCount(int count) => F(count == 1 ? "PackResourceCount.One" : "PackResourceCount.Many", count);
    private bool IsPackInstalled(SourceCatalogEntryView entry) => installedPackIdentities.Contains(PackIdentityKey(detail!.SelectedVersion.Definition.PublishedDefinition.Publisher.Name, entry.Name));
    private string PackUrl(SourceCatalogEntryView entry) => $"/packs?publisher={Uri.EscapeDataString(detail!.SelectedVersion.Definition.PublishedDefinition.Publisher.Name)}&name={Uri.EscapeDataString(entry.Name)}";
    private static string PackIdentityKey(string publisher, string name) => $"{publisher}\n{name}";
    private string BindingKindLabel(PackBindingTargetKind kind) => T($"BindingTargetKind.{kind}");
    private static UiStatus ChangeTone(PackResourceChange change) => change switch { PackResourceChange.Add => UiStatus.Success, PackResourceChange.Conflict => UiStatus.Danger, PackResourceChange.Remove => UiStatus.Warning, _ => UiStatus.Info };
    private async Task ChangeLocaleAsync(ChangeEventArgs args) { if (DetailBusy) return; catalogLocale = args.Value?.ToString() ?? "en-US"; await ReadDetailAsync(); }
    private void SelectChannel(ChangeEventArgs args) => selectedChannelName = args.Value?.ToString();
    private void SelectVersion(Guid uid) => Navigation.NavigateTo(ResourceOwnershipContext.PreserveNavigation($"{SourceUrl(detail!.Source)}&versionUid={uid:D}#versions", Services));

    private void SetBinding(SourceBindingStatus binding, ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(value)) { bindingSelections.Remove(binding.Name); return; }
        if (value.StartsWith("provider\n", StringComparison.Ordinal))
        {
            var parts = value.Split('\n', 4);
            bindingSelections[binding.Name] = new(binding.Name, binding.TargetKind, new(parts[3], ResourceScopeRef.Parse(parts[1]), new(parts[2])), null);
            return;
        }
        var candidateKey = value["candidate\n".Length..];
        var candidate = detail!.ProviderCandidates.Single(item => item.Key == candidateKey);
        bindingSelections[binding.Name] = new(binding.Name, binding.TargetKind, null, candidate);
    }

    private void SetImportMode(string mode) => importMode = mode;

    private ResourceScopeRef ScopeRef() => detail?.Source.Source.ScopeRef
        ?? ResourceScopeRef.Parse(ScopeRefValue!);
    private IEnumerable<StoredResource<SourceProviderResource>> CompatibleProviders(string targetKind) => targetKind == SourceKinds.SourceProvider ? detail!.Providers : [];
    private IEnumerable<SourceConsoleProviderCandidate> CompatibleProviderCandidates(string targetKind) => targetKind == SourceKinds.SourceProvider ? detail!.ProviderCandidates : [];
    private static string ProviderValue(SourceProviderResource provider) => $"provider\n{provider.ScopeRef!.Value.Value}\n{provider.Namespace.Value}\n{provider.Name}";
    private static string CandidateValue(SourceConsoleProviderCandidate candidate) => $"candidate\n{candidate.Key}";
    private string BindingValue(SourceBindingStatus binding)
    {
        if (!bindingSelections.TryGetValue(binding.Name, out var selection)) return string.Empty;
        return selection.Target is { } target
            ? $"provider\n{target.ScopeRef!.Value.Value}\n{target.Namespace?.Value ?? "default"}\n{target.Name}"
