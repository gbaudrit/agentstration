@page "/settings/sources"
@implements IDisposable
@using System.Globalization
@inject ISourceConsoleApiClient Service
@inject IServiceProvider Services
@inject ConsoleContextState ContextState
@inject TimeProvider Clock
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@inject NavigationManager Navigation
@inject NotificationState Notifications
@inject Microsoft.Extensions.Localization.IStringLocalizer<SourcesStrings> Localizer

<PageTitle>@T("PageTitle")</PageTitle>
<div data-testid="distribution-sources" data-interactive="@(interactive ? "true" : "false")">
@if (IsCollection)
{
    <UnsavedNavigationGuard IsDirty="HasImportDraft" HasUnsavedChanges="@(() => HasImportDraft)" />
    <ResourceCollectionTemplate TItem="SourceConsoleListItem" Title="@T("Title")" Description="@T("Description")" TestId="sources-collection" ContextKey="@collectionContextKey"
                                IdentityColumn="SourceIdentityColumn" Columns="SourceColumns" AdditionalFilters="SourceAdditionalFilters" Items="SourcePageItems" RowTestId="source-row"
                                ItemAttributes="@(item => new Dictionary<string, object> { ["data-source-publisher"] = item.Source.Source.Definition.Publisher, ["data-source-name"] = item.Source.Source.Name })"
                                Query="sourceQuery" QueryChanged="ChangeSourceQueryAsync" Pagination="SourcePagination" LoadState="collectionLoad" Disabled="@(!interactive || busy)"
                                SearchEnabled SearchLabel="@T("Search")" SearchPlaceholder="@T("SearchPlaceholder")"
                                EmptyTitle="@T("NoSources")" EmptyMessage="@T("NoSourcesMessage")" OnRefresh="LoadCollectionAsync" OnRetry="RetryCollectionAsync">
        <PrimaryActions>@if (hasCollectionAuthorization) { <button class="button-primary" disabled="@DetailBusy" @onclick="OpenCollectionImport" data-testid="source-import-open">@T("ImportSource")</button> }</PrimaryActions>
        <Actions>@if (hasCollectionAuthorization) { <a class="button-secondary" href="@ResourceOwnershipContext.PreserveNavigation("/settings/source-registries/discovery", Services)">@T("DiscoverFromRegistries")</a> }</Actions>
        <Metrics>@if (sources is not null)
        {
            <MetricCard Label="@T("Sources")" Value="@sources.Count.ToString()" Detail="@T("ReusableCatalogs")" Status="UiStatus.Info" />
            <MetricCard Label="@T("Versions")" Value="@sources.Sum(value => value.Source.VersionCount).ToString()" Detail="@T("ImmutableHistory")" Status="UiStatus.Neutral" />
            <MetricCard Label="@T("Healthy")" Value="@sources.Count(IsHealthy).ToString()" Detail="@T("LastImportSucceeded")" Status="UiStatus.Success" />
        }</Metrics>
        <Feedback>@if (error is not null) { <ErrorState Message="@error"><button class="button-secondary" @onclick="() => error = null">@T("Close")</button></ErrorState> }</Feedback>
        <ItemActions Context="item"><CollectionActions ResourceName="@item.Source.Configuration.Definition.DisplayName">
            <a href="@(SourceUrl(item) + "#overview")"><UiIcon Name="arrow-up-right" />@Shared["OpenItem"]</a>
            @if (CanPreviewEdit(item)) { <a href="@(SourceUrl(item) + "#definition/configuration")"><UiIcon Name="pencil" />@Shared["EditDefinition"]</a> }
            <button type="button" data-testid="source-preview" disabled="@(item.Source.Source.ScopeRef is null)" @onclick="() => OpenPreview(item)"><UiIcon Name="eye" />@Shared["Preview"]</button>
        </CollectionActions></ItemActions>
    </ResourceCollectionTemplate>
    @if (importing && hasCollectionAuthorization)
    {
        <FormSection Title="@T("ImportSource")" Description="@T("ImportDescription")" Class="source-import" TestId="source-import-form">
            <ResourceDefinitionForm @key="importModel" @ref="importDefinitionForm" Id="source-import-form" EditContext="ImportContext" FieldLabels="ImportFieldLabels" Busy="busy">
                <CreationWizard @ref="importWizard" Steps="ImportSteps" OnFinish="FinishImportAsync" OnStepReady="ImportStepReady" Busy="busy" FinishLabel="@(busy ? T("Importing") : T("Import"))" FinishTestId="source-import-submit" />
            </ResourceDefinitionForm>
            <FormActions><button type="button" class="button-secondary" disabled="@DetailBusy" @onclick="CloseImport">@T("Cancel")</button></FormActions>
        </FormSection>
    }
}
else
{
    var presentations = DetailPresentations;
    <div data-testid="source-details" data-source-publisher="@Publisher" data-source-name="@Name"><ConsoleResourceDetailsTemplate Resource="detail?.Source.Source" Name="@(detail?.Source.Configuration.Definition.DisplayName ?? Name ?? T("Title"))" ResourceType="@T("Source")" Domain="source" IconName="database"
        CollectionHref="@SourceCollectionUrl" CollectionLabel="@T("Title")"
        ResourceIdentity="@detailKey" SectionState="sectionState" SectionPresentations="presentations" DefinitionSections="DetailDefinitionSections" AdditionalSections="DetailAdditionalSections"
        Description="@detail?.SelectedVersion.Definition.PublishedDefinition.Description" LoadState="detailLoadState" OnRefresh="RefreshDetailAsync" OnRetry="RefreshDetailAsync" Busy="DetailBusy"
        DefinitionReadOnlyReason="DetailReadOnlyReason" HasDraft="HasDefinitionDraft" HasAdditionalDraft="@(packSelection is not null)" AllowAccess="OwnScope"
        StatusText="@(detail is null ? null : VerificationLabel(detail.Verification.Status))" Status="@(detail is null ? UiStatus.Neutral : VerificationTone(detail.Verification.Status))"
        Yaml="@(detail?.SelectedVersion.Definition.RawManifest ?? string.Empty)" YamlReadOnly YamlTitle="@T("ManifestYaml")" YamlDescription="@T("PublishedYamlHelp")"
        NavigationTestId="source-sections" SectionTestIdPrefix="source" TestId="source-resource-details">
        <Actions>@if (CanDelete) { <button class="button-danger" type="button" disabled="@DetailBusy" @onclick="() => confirmDeleteSource = true">@T("DeleteSource")</button> }</Actions>
        <PrimaryActions>@if (CanRefresh) { <button type="button" class="button-primary" disabled="@(DetailBusy || detail?.Source.Configuration.Definition.Origin is null)" title="@(detail?.Source.Configuration.Definition.Origin is null ? T("PastedSourceCannotRefresh") : null)" @onclick="RefreshSourceAsync">@T("RefreshSource")</button> }</PrimaryActions>
        <Feedback>
            @if (error is not null) { <div class="form-alert form-alert-danger" role="alert">@error</div> }
            @if (newerDetail is not null) { <div class="form-alert form-alert-warning" role="status">@T("RefreshDraftConflict")</div> }
            @if (pendingReceipt is not null) { <div class="form-alert form-alert-warning" role="status">@T("SavedReceiptPending")</div> }
            @if (detail is not null && !installedPacksKnown) { <p class="muted">@T("InstalledPacksUnavailable")</p> }
        </Feedback>
        <OverviewMetrics><MetricCard Label="@T("Versions")" Value="@(detail?.Source.VersionCount.ToString(CultureInfo.CurrentCulture) ?? "—")" /><MetricCard Label="@T("ChannelsAndCatalogs")" Value="@(detail?.SelectedVersion.Definition.PublishedDefinition.Channels.Count.ToString(CultureInfo.CurrentCulture) ?? "—")" /><MetricCard Label="@T("Bindings")" Value="@(detail is null ? "—" : detail.Bindings.Ready ? T("Ready") : T("NeedsConfiguration"))" Status="@(detail?.Bindings.Ready == true ? UiStatus.Success : UiStatus.Neutral)" /></OverviewMetrics>
        <OverviewSummary Context="identity">@if (detail is not null) { <SourceResourceSummary Resource="detail.Source.Source" Configuration="detail.Source.Configuration" Version="detail.SelectedVersion" Identity="identity"><AdditionalContent>@if (detail is not null) { <div class="source-detail-grid">        <article class="panel">
            <div class="panel-header"><div><p class="eyebrow">@T("PublishedIdentity")</p><h2>@T("Publisher")</h2></div></div>
            <dl class="resource-details"><dt>@T("Declared")</dt><dd>@PublisherLabel(detail.Verification.DeclaredPublisher)</dd><dt>@T("Verified")</dt><dd>@(detail.Verification.VerifiedPublisher is null ? T("NotVerified") : PublisherLabel(detail.Verification.VerifiedPublisher))</dd><dt>@T("ManifestDigest")</dt><dd><ValueDisclosure Value="@detail.SelectedVersion.Definition.ManifestDigest" /></dd></dl>
        </article>
        <article class="panel">
            <div class="panel-header"><div><p class="eyebrow">@T("SourceActivity")</p><h2>@T("ImportStatus")</h2><p>@T("ImportStatusDescription")</p></div><StatusBadge Text="@ImportOutcome(detail.Source.Observed.Definition.LastOutcome)" Status="@(IsHealthy(detail.Source) ? UiStatus.Success : UiStatus.Danger)" /></div>
            <dl class="resource-details">
                <dt>@T("Origin")</dt><dd>@if (detail.Source.Configuration.Definition.Origin is { } sourceOrigin) { <a class="text-link detail-origin" href="@sourceOrigin.Url" target="_blank" rel="noopener noreferrer">@sourceOrigin.Url</a> } else { @T("PastedManifest") }</dd>
                <dt>@T("SelectedVersion")</dt><dd><button class="text-button version-link" type="button" @onclick='() => ShowSection("versions")'>@detail.SelectedVersion.Definition.Version</button> <code>@Short(detail.SelectedVersion.Definition.ManifestDigest)</code></dd>
                <dt>@T("LastSuccessfulImport")</dt><dd>@LastSuccessfulImport()</dd>
                <dt>@T("LastAttempt")</dt><dd>@detail.Source.Observed.Definition.LastAttemptAt.ToLocalTime().ToString("g")</dd>
            </dl>
            @if (detail.Source.Observed.Definition.ErrorMessage is { } importError) { <p class="inline-warning">@importError</p> }
        </article>
        @{ var nextRefresh = NextRefresh(); }
        <article class="panel refresh-overview-panel">
            <div class="panel-header"><div><p class="eyebrow">@T("Automation")</p><h2>@T("NextRefresh")</h2><p>@T("NextRefreshDescription")</p></div><button class="text-button" type="button" @onclick='() => ShowSection("definition/refresh")'>@T("ConfigureScheduling") →</button></div>
            @if (nextRefresh is null)
            {
                <p class="refresh-overview-empty">@T("NoRefreshScheduled")</p>
            }
            else
            {
                <div class="refresh-overview-value"><strong>@NextRefreshDate(nextRefresh)</strong><span>@nextRefresh.Target</span></div>
            }
        </article>
</div> }</AdditionalContent></SourceResourceSummary> }</OverviewSummary>

        <DefinitionContent Context="path"><ResourceDefinitionForm @key="model" @ref="definitionForm" Id="source-definition-form" EditContext="DetailContext" FieldLabels="DetailFieldLabels" Sections="presentations" SectionState="sectionState" SectionContent="DetailSectionContent" SectionRequested="ShowSection" OnValidSubmit="SaveDefinitionAsync" OnInvalidSubmit="InvalidDefinitionSubmitAsync" InvalidInputChanged="value => invalidInput = value" ReadOnly="@(!CanWrite)" Busy="DetailBusy" data-testid="source-definition-form" /></DefinitionContent>
        <AdditionalContent Context="path">@if (path == "versions") { @VersionContent } else if (path == "content") { @ChannelContent }</AdditionalContent>
        <DraftActions><button class="button-secondary" type="button" disabled="@DetailBusy" @onclick="DiscardDefinitionAsync">@Shared["Discard"]</button><button type="submit" form="source-definition-form" class="button-primary" disabled="@(DetailBusy || !CanWrite || pendingReceipt is not null)" data-testid="source-save">@T("Save")</button></DraftActions>
    </ConsoleResourceDetailsTemplate></div>
}
@if (confirmDeleteSource && detail is not null)
{
    <ModalFrame IsOpen="true" TitleId="source-delete-title" Class="source-delete-dialog" Busy="deletingSource" OnClose="CloseDeleteSource"><section>
            <div class="panel-header"><div><p class="eyebrow">@detail.Source.Source.Definition.Publisher / @detail.Source.Source.Name</p><h2 id="source-delete-title">@T("DeleteSourceTitle")</h2></div><button class="icon-button" @onclick="CloseDeleteSource" aria-label="@T("Close")">×</button></div>
            <p>@T("DeleteSourceDescription")</p>
            <div class="source-delete-retention" role="note">@T("DeleteSourceRetainsPacks")</div>
            @if (deleteError is not null) { <p class="error-panel" role="alert">@deleteError</p> }
            <FormActions Class="dialog-actions"><button class="button-secondary" disabled="@deletingSource" @onclick="CloseDeleteSource">@T("Cancel")</button><button class="button-danger" disabled="@deletingSource" @onclick="DeleteSourceAsync">@(deletingSource ? T("DeletingSource") : T("ConfirmDeleteSource"))</button></FormActions>
        </section></ModalFrame>
}

@if (packSelection is not null)
{
    <ModalFrame IsOpen="true" TitleId="source-pack-title" Class="source-pack-dialog" Busy="packInstalling" OnClose="ClosePackPreview"><section>
            <div class="panel-header"><div><p class="eyebrow">@T("PinnedSourcePack")</p><h2 id="source-pack-title">@(reinstallPack ? T("ReinstallPack") : T("InstallPack"))</h2></div><button class="icon-button" @onclick="ClosePackPreview" aria-label="@T("Close")">×</button></div>
            @if (packPreviewing) { <LoadingState Message="@T("ValidatingPack")" /> }
            @if (packError is not null) { <p class="error-panel" role="alert">@packError</p><button type="button" class="button-secondary" disabled="@(packPreviewing || packInstalling)" @onclick="RefreshPackPreviewAsync">@T("Retry")</button> }
            @if (packPreview is not null)
            {
                <div class="source-pack-summary"><div><strong>@(packPreview.Metadata.DisplayName ?? packPreview.Metadata.Name)</strong><small><code>@packPreview.Metadata.Publisher/@packPreview.Metadata.Name</code> · @packPreview.Metadata.Version</small></div><ResourceScopeBadge ScopeRef="@PackTargetScope()" /></div>
                @if (!string.IsNullOrWhiteSpace(packPreview.Metadata.Description))
                {
                    <div class="source-pack-description"><span>@T("PublishedPackDescription")</span><p>@packPreview.Metadata.Description</p></div>
                }
                <p class="pack-pin"><UiIcon Name="pin" /><span>@F("PinnedSourceSelectionMessage", sourcePackPreview!.Pin.SourceVersion, Short(sourcePackPreview.Pin.ManifestDigest), sourcePackPreview.Pin.Channel, Short(sourcePackPreview.Pin.SnapshotUid.ToString("D")), sourcePackPreview.Pin.EntryName)</span></p>
                @if (packPreview.Bindings.Count > 0)
                {
                    <section class="source-pack-bindings"><h3>@T("PackBindingsTitle")</h3><p>@T("PackBindingsHelp")</p>
                    @foreach (var binding in packPreview.Bindings)
                    {
                        <FormField Label="@BindingKindLabel(binding.TargetKind)" Class="source-pack-binding"><LabelContent><span class="source-pack-binding-heading"><span><strong>@BindingKindLabel(binding.TargetKind)</strong><small><code>@binding.Name</code></small></span><StatusBadge Text="@(binding.Required ? T("Required") : T("Optional"))" Status="@(binding.Required ? UiStatus.Info : UiStatus.Neutral)" /></span></LabelContent><ChildContent><ClearableSelect TValue="string" Value="@Convert.ToString(PackBindingValue(binding.Name), System.Globalization.CultureInfo.InvariantCulture)" disabled="@packInstalling" ValueChanged="changed => SetPackBindingAsync(binding.Name, new ChangeEventArgs { Value = changed })"><option value="">@F("SelectPackBindingTarget", BindingKindLabel(binding.TargetKind).ToLowerInvariant())</option>@if (!string.IsNullOrEmpty(PackBindingValue(binding.Name)) && !PackChoices(binding.TargetKind).Any(choice => choice.Key == PackBindingValue(binding.Name))) { <option value="@PackBindingValue(binding.Name)" disabled>@T("RetainedProvider") · @PackBindingValue(binding.Name)</option> }@foreach (var choice in PackChoices(binding.TargetKind)) { <option value="@choice.Key">@choice.Label</option> }</ClearableSelect></ChildContent></FormField>
                    }
                    </section>
                }
                @if (packPreview.AlreadyInstalled) { <label class="resource-enabled-toggle"><FormCheckbox role="switch" disabled="@packInstalling" Value="@replacePack" ValueChanged="changed => SetReplacePackAsync(new ChangeEventArgs { Value = changed })" /><span>@T("ReplaceInstalledPack")</span></label> }
                <section class="source-pack-resources"><header><strong>@PackResourceCount(packPreview.Resources.Count)</strong></header><div>@foreach (var resource in packPreview.Resources) { <article><span><strong>@resource.Name</strong><small>@resource.Kind</small></span><StatusBadge Text="@T($"Change.{resource.Change}")" Status="@ChangeTone(resource.Change)" /></article> }</div></section>
            }
            <FormActions Class="dialog-actions"><button class="button-secondary" @onclick="ClosePackPreview">@T("Cancel")</button><button class="button-primary" disabled="@(!CanInstallPack)" @onclick="InstallPackAsync">@(packInstalling ? T("InstallingPack") : reinstallPack ? T("ConfirmReinstallPack") : T("ConfirmInstallPack"))</button></FormActions>
        </section></ModalFrame>
}
</div>

@if (IsCollection)
{
<ResourceCollectionPreview @ref="collectionPreview" ResourceKind="@SourceResourceKinds.Source" ContextKey="@collectionContextKey" Enabled="@(IsCollection && hasCollectionAuthorization && collectionContextKey is not null && ContextState.Error is null && collectionLoad.Status != ResourceLoadStatus.Forbidden)">
    <ChildContent Context="address"><SourceResourcePreview Address="address" OverviewHref="@PreviewUrl(address, "overview")" DefinitionHref="@PreviewUrl(address, "definition/configuration")" /></ChildContent>
</ResourceCollectionPreview>
}


@code {
    private ResourceCollectionPreview? collectionPreview;
    private bool CanPreviewEdit(SourceConsoleListItem item) => !item.Source.Source.Governance.IsManaged && !item.Source.Configuration.Governance.IsManaged && ContextState.HasPermission(AuthorizationPermissions.ResourcesWrite) && item.Source.Source.ScopeRef?.Value == ContextState.Current?.SelectedScopeRef && ResourceOwnershipContext.CanManage(item.Source.Source.ScopeRef, Services);
    private void OpenPreview(SourceConsoleListItem item) { if (item.Source.Source.ScopeRef is { } owner) collectionPreview?.Open(ScopedResourceAddress.Create(owner, item.Source.Source.Namespace, SourceResourceKinds.Source, item.Source.Source.Name)); }
    private string PreviewUrl(ScopedResourceAddress address, string section) => ResourceOwnershipContext.PreserveNavigation($"/settings/sources/{Uri.EscapeDataString(address.Namespace.Value)}/{Uri.EscapeDataString(address.Name)}?scopeRef={Uri.EscapeDataString(address.ScopeRef.Value)}", Services).Split('#')[0] + "#" + section;
    private RenderFragment VersionContent => @<div class="resource-editor-view">@if (detail is not null) {        <FormSection Title="@T("Versions")" Eyebrow="@T("ImmutableHistory")" Description="@T("VersionHistoryDescription")"><ChildContent>
        <div class="version-strip">
            @foreach (var version in detail.Versions)
            {
                <button type="button" class="version-card @(version.Uid == detail.SelectedVersion.Uid ? "selected" : null)" @onclick="() => SelectVersion(version.Uid)"><strong>@version.Definition.Version</strong><small>@version.Definition.ImportedAt.ToLocalTime().ToString("g")</small><code>@Short(version.Definition.ManifestDigest)</code></button>
            }
        </div>
        </ChildContent></FormSection>
}</div>;
    private RenderFragment BindingContent => @<div class="resource-editor-view">@if (detail is not null) {        <FormSection Title="@T("Bindings")" Eyebrow="@T("ProviderRouting")" Description="@T("BindingsDescription")"><Actions><StatusBadge Text="@(detail.Bindings.Ready ? T("Ready") : T("NeedsConfiguration"))" Status="@(detail.Bindings.Ready ? UiStatus.Success : UiStatus.Warning)" /></Actions><ChildContent>
        @if (detail.Bindings.Bindings.Count == 0) { <p>@T("NoBindings")</p> }
        else
        {
            @if (detail.Providers.Count == 0) { <div class="form-alert form-alert-warning"><span>@T("NoConfiguredProviders")</span><a class="text-link" href="@ConfigureProviderUrl()">@T("ConfigureProvider") →</a></div> }
            <div class="binding-grid">
                @foreach (var binding in detail.Bindings.Bindings)
                {
                    <article class="binding-card">
                        <header>
                            <span class="binding-identity"><span class="binding-icon" aria-hidden="true"><UiIcon Name="database" /></span><strong>@binding.Name</strong></span>
                            <span class="binding-channels">@foreach (var channel in binding.Channels) { <code>@channel</code> }</span>
                        </header>
                        <FormField Label="@T("SelectProvider")"><LabelContent><span class="sr-only">@T("SelectProvider")</span></LabelContent><ChildContent><ClearableSelect TValue="string" Value="@Convert.ToString(BindingValue(binding), System.Globalization.CultureInfo.InvariantCulture)" disabled="@DetailBusy" ValueChanged="changed => SetBinding(binding, new ChangeEventArgs { Value = changed })"><option value="">@T("SelectProvider")</option>@if (binding.Target is not null && !CompatibleProviders(binding.TargetKind).Any(value => ProviderValue(value.Value) == BindingValue(binding))) { <option value="@BindingValue(binding)" disabled>@T("RetainedProvider") · @binding.Target.ScopeRef · @binding.Target.Namespace/@binding.Target.Name</option> }@foreach (var provider in CompatibleProviders(binding.TargetKind)) { <option value="@ProviderValue(provider.Value)">@provider.Value.Definition.DisplayName — @provider.Value.Namespace/@provider.Value.Name</option> }@foreach (var candidate in CompatibleProviderCandidates(binding.TargetKind)) { <option value="@CandidateValue(candidate)">@F("DiscoveredProvider", candidate.DisplayName, candidate.ContributionId)</option> }</ClearableSelect></ChildContent></FormField>
                        @if (binding.Issues.Count > 0) { <small class="inline-warning">@string.Join(" ", binding.Issues.Select(value => value.Message))</small> }
                    </article>
                }
            </div>

        }
        </ChildContent></FormSection>
}</div>;
    private RenderFragment RefreshContent => @<div class="resource-editor-view">@if (detail is not null) {        <FormSection Title="@T("RefreshScheduling")" Eyebrow="@T("Automation")" Description="@T("RefreshSchedulingDescription")"><ChildContent>
        <div class="refresh-policy-grid">
            <article class="refresh-policy-card">
                <header><div><h3>@T("SourceDefinitionRefresh")</h3><p>@T("SourceDefinitionRefreshDescription")</p></div><label class="resource-enabled-toggle"><FormCheckbox role="switch" @bind-Value="sourceRefresh.Enabled" disabled="@(busy || detail.Source.Configuration.Definition.Origin is null)" /><span>@T("Enabled")</span></label></header>
                @if (detail.Source.Configuration.Definition.Origin is null) { <p class="inline-warning">@T("PastedSourceCannotSchedule")</p> }
                <p class="refresh-observed">@F("LastSourceRefreshStatus", detail.Source.Observed.Definition.LastAttemptAt.ToLocalTime().ToString("g"), ImportOutcome(detail.Source.Observed.Definition.LastOutcome))</p>
                @if (detail.Source.Observed.Definition.ErrorMessage is { } sourceRefreshError) { <p class="inline-warning">@RefreshError(detail.Source.Observed.Definition.ErrorCode, sourceRefreshError)</p> }
                <div class="refresh-policy-fields"><FormField Label="@T("IntervalMinutes")"><ChildContent><ClearableNumber min="1" max="10080" @bind-Value="sourceRefresh.IntervalMinutes" disabled="@DetailBusy" /></ChildContent><Validation><ValidationMessage For="() => sourceRefresh.IntervalMinutes" /></Validation></FormField><FormField Label="@T("TimeoutSeconds")"><ChildContent><ClearableNumber min="1" max="300" @bind-Value="sourceRefresh.TimeoutSeconds" disabled="@DetailBusy" /></ChildContent><Validation><ValidationMessage For="() => sourceRefresh.TimeoutSeconds" /></Validation></FormField><FormField Label="@T("MaximumAttempts")"><ChildContent><ClearableNumber min="1" max="10" @bind-Value="sourceRefresh.MaximumAttempts" disabled="@DetailBusy" /></ChildContent><Validation><ValidationMessage For="() => sourceRefresh.MaximumAttempts" /></Validation></FormField><FormField Label="@T("InitialBackoffSeconds")"><ChildContent><ClearableNumber min="1" max="3600" @bind-Value="sourceRefresh.InitialBackoffSeconds" disabled="@DetailBusy" /></ChildContent><Validation><ValidationMessage For="() => sourceRefresh.InitialBackoffSeconds" /></Validation></FormField><FormField Label="@T("MaximumBackoffSeconds")"><ChildContent><ClearableNumber min="1" max="86400" @bind-Value="sourceRefresh.MaximumBackoffSeconds" disabled="@DetailBusy" /></ChildContent><Validation><ValidationMessage For="() => sourceRefresh.MaximumBackoffSeconds" /></Validation></FormField><FormField Label="@T("JitterSeconds")"><ChildContent><ClearableNumber min="0" max="3600" @bind-Value="sourceRefresh.JitterSeconds" disabled="@DetailBusy" /></ChildContent><Validation><ValidationMessage For="() => sourceRefresh.JitterSeconds" /></Validation></FormField></div>
            </article>
            <article class="refresh-policy-card">
                <header><div><h3>@T("ChannelRefreshDefaults")</h3><p>@T("ChannelRefreshDefaultsDescription")</p></div><label class="resource-enabled-toggle"><FormCheckbox role="switch" @bind-Value="channelRefresh.Enabled" disabled="@DetailBusy" /><span>@T("Enabled")</span></label></header>
                <div class="refresh-policy-fields"><FormField Label="@T("IntervalMinutes")"><ChildContent><ClearableNumber min="1" max="10080" @bind-Value="channelRefresh.IntervalMinutes" disabled="@DetailBusy" /></ChildContent><Validation><ValidationMessage For="() => channelRefresh.IntervalMinutes" /></Validation></FormField><FormField Label="@T("TimeoutSeconds")"><ChildContent><ClearableNumber min="1" max="300" @bind-Value="channelRefresh.TimeoutSeconds" disabled="@DetailBusy" /></ChildContent><Validation><ValidationMessage For="() => channelRefresh.TimeoutSeconds" /></Validation></FormField><FormField Label="@T("MaximumAttempts")"><ChildContent><ClearableNumber min="1" max="10" @bind-Value="channelRefresh.MaximumAttempts" disabled="@DetailBusy" /></ChildContent><Validation><ValidationMessage For="() => channelRefresh.MaximumAttempts" /></Validation></FormField><FormField Label="@T("InitialBackoffSeconds")"><ChildContent><ClearableNumber min="1" max="3600" @bind-Value="channelRefresh.InitialBackoffSeconds" disabled="@DetailBusy" /></ChildContent><Validation><ValidationMessage For="() => channelRefresh.InitialBackoffSeconds" /></Validation></FormField><FormField Label="@T("MaximumBackoffSeconds")"><ChildContent><ClearableNumber min="1" max="86400" @bind-Value="channelRefresh.MaximumBackoffSeconds" disabled="@DetailBusy" /></ChildContent><Validation><ValidationMessage For="() => channelRefresh.MaximumBackoffSeconds" /></Validation></FormField><FormField Label="@T("JitterSeconds")"><ChildContent><ClearableNumber min="0" max="3600" @bind-Value="channelRefresh.JitterSeconds" disabled="@DetailBusy" /></ChildContent><Validation><ValidationMessage For="() => channelRefresh.JitterSeconds" /></Validation></FormField></div>
            </article>
        </div>
        @if (detail.SelectedVersion.Definition.PublishedDefinition.Channels.Count > 0)
        {
            <div class="channel-overrides"><div><h3>@T("ChannelOverrides")</h3><p>@T("ChannelOverridesDescription")</p></div>
            @foreach (var channel in detail.SelectedVersion.Definition.PublishedDefinition.Channels)
            {
                var editor = channelRefreshOverrides[channel.Name];
                <article class="channel-override-card"><header><strong>@channel.Name</strong><label class="resource-enabled-toggle"><FormCheckbox role="switch" @bind-Value="editor.Custom" disabled="@DetailBusy" /><span>@T("CustomPolicy")</span></label></header>
                @if (editor.Custom) { <div class="refresh-policy-fields compact"><label class="resource-enabled-toggle"><FormCheckbox role="switch" @bind-Value="editor.Enabled" disabled="@DetailBusy" /><span>@T("Enabled")</span></label><FormField Label="@T("IntervalMinutes")"><ChildContent><ClearableNumber min="1" max="10080" @bind-Value="editor.IntervalMinutes" disabled="@DetailBusy" /></ChildContent><Validation><ValidationMessage For="() => editor.IntervalMinutes" /></Validation></FormField><FormField Label="@T("TimeoutSeconds")"><ChildContent><ClearableNumber min="1" max="300" @bind-Value="editor.TimeoutSeconds" disabled="@DetailBusy" /></ChildContent><Validation><ValidationMessage For="() => editor.TimeoutSeconds" /></Validation></FormField><FormField Label="@T("MaximumAttempts")"><ChildContent><ClearableNumber min="1" max="10" @bind-Value="editor.MaximumAttempts" disabled="@DetailBusy" /></ChildContent><Validation><ValidationMessage For="() => editor.MaximumAttempts" /></Validation></FormField><FormField Label="@T("InitialBackoffSeconds")"><ChildContent><ClearableNumber min="1" max="3600" @bind-Value="editor.InitialBackoffSeconds" disabled="@DetailBusy" /></ChildContent><Validation><ValidationMessage For="() => editor.InitialBackoffSeconds" /></Validation></FormField><FormField Label="@T("MaximumBackoffSeconds")"><ChildContent><ClearableNumber min="1" max="86400" @bind-Value="editor.MaximumBackoffSeconds" disabled="@DetailBusy" /></ChildContent><Validation><ValidationMessage For="() => editor.MaximumBackoffSeconds" /></Validation></FormField><FormField Label="@T("JitterSeconds")"><ChildContent><ClearableNumber min="0" max="3600" @bind-Value="editor.JitterSeconds" disabled="@DetailBusy" /></ChildContent><Validation><ValidationMessage For="() => editor.JitterSeconds" /></Validation></FormField></div> }
                </article>
            }
            </div>
        }

        </ChildContent></FormSection>
}</div>;
    private RenderFragment ChannelContent => @<div class="resource-editor-view">@if (detail is not null) {        <section class="panel">
        <div class="panel-header"><div><p class="eyebrow">@T("Content")</p><h2>@T("ChannelsAndCatalogs")</h2><p>@T("ChannelsDescription")</p></div></div>
