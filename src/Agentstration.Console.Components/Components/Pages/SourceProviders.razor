@inject IServiceProvider Services
@page "/sourceproviders"
@implements IDisposable
@inject ISourceProvidersClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<SourceProvidersStrings> Localizer

<PageTitle>@T("Title") · Agentstration</PageTitle>
<PageHeader Title="@T("Title")" Description="@T("Description")">
    <Actions><button class="button-secondary" @onclick="LoadAsync" disabled="@loading">@T("Refresh")</button><a class="button-primary" href="/sourceproviders/new">@T("CreateProvider")</a></Actions>
</PageHeader>

<div data-testid="distribution-source-providers">
@if (loading && providers is null)
{
    <LoadingState Message="@T("Loading")" />
}
else if (error is not null)
{
    <ErrorState Message="@error.Message" ErrorId="@error.ErrorId"><button class="button-secondary" @onclick="LoadAsync">@T("Retry")</button></ErrorState>
}
else if (providers?.Count == 0)
{
    <EmptyState Title="@T("EmptyTitle")" Message="@T("EmptyMessage")"><a class="button-primary" href="/sourceproviders/new">@T("CreateProvider")</a></EmptyState>
}
else
{
    <CollectionView TItem="SourceProviderSummaryResponse" Items="providers ?? []" InformationLabels="@(new string[] { T("Extension"), T("Contribution") })" IdentityLabel="@T("Provider")" StateLabel="@T("Status")">
        <Identity Context="provider">
<CollectionIdentity DisplayName="@provider.DisplayName" Namespace="@provider.Namespace" Name="@provider.Name" Href="@DetailsUrl(provider)" IconName="server" ><IconBadges><ResourceScopeBadge ScopeRef="@provider.ScopeRef" ShowName IconOnly /><StatusBadge Text="@StatusLabel(provider.Status)" Status="@ModelManagementUi.Status(provider.Status)" IconOnly /><ManagedResourceBadge IsReadOnly="@(!ResourceOwnershipContext.CanManage(provider.ScopeRef, Services))" IconOnly /></IconBadges></CollectionIdentity></Identity>
        <Information Context="provider">
            <CollectionValue Label="@T("Extension")"><a class="text-button" href="/extensions">@provider.ExtensionNamespace/@provider.ExtensionName</a></CollectionValue>
            <CollectionValue Label="@T("Contribution")"><code>@provider.ContributionId</code></CollectionValue>
        </Information>
        <Actions Context="provider">
<CollectionActions ResourceName="@($"{provider.DisplayName} ({provider.Namespace}/{provider.Name}, {provider.ScopeRef})")"><a class="text-link" href="@DetailsUrl(provider)">@T("ViewDetails") →</a></CollectionActions></Actions>
    </CollectionView>
}

</div>

@code {
    private readonly CancellationTokenSource cancellation = new();
    private IReadOnlyList<SourceProviderSummaryResponse>? providers;
    private AgentstrationApiException? error;
    private bool loading;
    private string T(string key) => Localizer[key];
    private string StatusLabel(string? value) => Localizer[$"Status.{value?.ToLowerInvariant() switch { "available" => "Available", "disabled" => "Disabled", "unavailable" => "Unavailable", "incompatible" => "Incompatible", _ => "Unknown" }}"];
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        loading = true; error = null;
        try { providers = await Client.GetSourceProvidersAsync(cancellation.Token); }
        catch (AgentstrationApiException exception) { error = exception; }
        finally { loading = false; }
    }
    private string DetailsUrl(SourceProviderSummaryResponse provider) => ResourceOwnershipContext.Resource(Services, "/sourceproviders", provider.Name, ResourceNamespace.Parse(provider.Namespace), provider.ScopeRef);
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
