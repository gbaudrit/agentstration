@inject IServiceProvider Services
@page "/settings/source-registries"
@page "/settings/source-registries/new"
@page "/settings/source-registries/{Name}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "agentstration:platform-admin")]
@implements IDisposable
@inject ISourceRegistriesClient Client
@inject ISecretsClient Secrets
@inject ConsoleContextState ContextState
@inject NavigationManager Navigation
@inject NotificationState Notifications
@inject TimeProvider Clock
@inject Microsoft.Extensions.Localization.IStringLocalizer<SourceRegistriesStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared

<PageTitle>@T("PageTitle")</PageTitle>
@if (IsList) { <SourceRegistryCollection /> }
else if (IsNew)
{
    <UnsavedNavigationGuard IsDirty="HasDraft" HasUnsavedChanges="@(() => HasDraft)" />
    <PageHeader ScopeRef="ResourceScopeRef.Instance" Title="@T("CreateTitle")" Description="@T("EditorDescription")" CollectionHref="@BackUrl" CollectionLabel="@T("Title")" Enabled="model.Enabled" EnabledChanged="ToggleAsync" EnabledDisabled="@(busy || !CanWrite)" EnabledTestId="source-registry-enabled" />
    <div data-testid="distribution-source-registries">
        @if (loadState.BlocksContent) { <ResourceLoadFeedback State="loadState" OnRetry="RefreshAsync" /> }
        else
        {
            @if (loadState.Status is ResourceLoadStatus.Failed or ResourceLoadStatus.Refreshing) { <ResourceLoadFeedback State="loadState" OnRetry="RefreshAsync" /> }
            @Feedback
            @if (!CanWrite) { <ResourceReadOnlyNotice Reason="ResourceReadOnlyReason.InsufficientPermissions" /> }
            <ResourceDefinitionForm @key="editContext" @ref="definitionForm" Id="@formId" EditContext="editContext" FieldLabels="FieldLabels" Sections="Presentations" OnValidSubmit="SaveAsync" OnInvalidSubmit="InvalidSubmitAsync" InvalidInputChanged="value => invalidInput = value" ReadOnly="@(!CanWrite)" Busy="commandBusy" data-testid="source-registry-form">
                <p class="required-fields-note"><span aria-hidden="true">*</span> @Shared["RequiredFields"]</p>
                <CreationWizard @ref="wizard" Steps="Steps" OnFinish="FinishAsync" OnStepReady="StepReadyAsync" Busy="commandBusy" Disabled="@(!CanWrite)" FinishLabel="@T("CreateRegistry")" FinishTestId="source-registry-create" />
            </ResourceDefinitionForm>
        }
    </div>
}
else
{
    var presentations = Presentations;
    <ConsoleResourceDetailsTemplate Resource="view?.Registration" Name="@(view?.Registration.Definition.DisplayName ?? Name ?? T("Registration"))" ResourceType="@T("Registration")" Domain="source" IconName="world"
        CollectionHref="@BackUrl" CollectionLabel="@T("Title")"
        ResourceIdentity="@(loadedKey ?? Name ?? string.Empty)" SectionState="sectionState" SectionPresentations="presentations" DefinitionSections="DefinitionSections" AdditionalSections="AdditionalSections"
        Enabled="view?.Registration.Definition.Enabled" EnabledChanged="ToggleAsync" EnabledDisabled="@(busy || !CanWrite)" EnabledTestId="source-registry-enabled"
        LoadState="loadState" OnRefresh="RefreshAsync" OnRetry="RefreshAsync" Busy="busy" DefinitionReadOnlyReason="ReadOnlyReason" AllowAccess="OwnScope"
        StatusText="@(view is null ? null : ObservedStatus(view.Observed.Definition.Status))" Status="@(view is null ? UiStatus.Neutral : ObservedTone(view.Observed.Definition.Status))"
        HasDraft="HasDraft" Yaml="@SavedYaml" YamlReadOnly SectionTestIdPrefix="source-registry" TestId="distribution-source-registries">
        <Actions>@if (CanDelete) { <button type="button" class="button-danger" disabled="@busy" @onclick="() => confirmDelete = true">@T("DeleteRegistry")</button> }</Actions>
        <Feedback>@Feedback</Feedback>
        <OverviewMetrics><MetricCard Label="@T("Editor.Generation")" Value="@(view?.Registration.Generation.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—")" /><MetricCard Label="@T("CachedShards")" Value="@(view is null ? "—" : (view.Observed.Definition.Current?.Catalogs.Count ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))" /><MetricCard Label="@T("RefreshHistory")" Value="@(refreshes?.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—")" /></OverviewMetrics>
        <OverviewConfiguration>@ConfigurationSummary</OverviewConfiguration>
        <OverviewContent>@ObservationPanel</OverviewContent>
        <DefinitionContent Context="path"><ResourceDefinitionForm @key="editContext" @ref="definitionForm" Id="@formId" EditContext="editContext" FieldLabels="FieldLabels" Sections="presentations" SectionState="sectionState" SectionContent="DefinitionContent" SectionRequested="ShowSection" OnValidSubmit="SaveAsync" OnInvalidSubmit="InvalidSubmitAsync" InvalidInputChanged="value => invalidInput = value" ReadOnly="@(!CanWrite)" Busy="commandBusy" data-testid="source-registry-form" /></DefinitionContent>
        <AdditionalContent Context="path">@if (path == "origin") { @TrustPanel } else if (path == "history") { @HistoryPanel }</AdditionalContent>
        <DraftActions><button type="button" class="button-secondary" disabled="@busy" @onclick="DiscardAsync">@Shared["Discard"]</button><button type="submit" form="@formId" class="button-primary" data-testid="source-registry-save" disabled="@(busy || !CanWrite)">@T("SaveChanges")</button></DraftActions>
    </ConsoleResourceDetailsTemplate>
}
<ConfirmationDialog IsOpen="confirmDelete" Title="@T("DeleteDialogTitle")" Message="@F("DeleteDialogMessage", view?.Registration.Definition.DisplayName ?? Name ?? string.Empty)" ConfirmLabel="@T("DeleteRegistry")" OnConfirm="DeleteAsync" OnCancel="() => confirmDelete = false" />

@code {
    private RenderFragment Feedback => @<div>
        @if (error is not null) { <div class="form-alert form-alert-danger" role="alert">@error.Message @if (error.IsConcurrencyConflict) { <button type="button" class="text-button" disabled="@busy" @onclick="ReloadAfterConflictAsync">@T("ReloadLatest")</button> }</div> }
        @if (newerSnapshot is not null) { <div class="form-alert form-alert-warning" role="status">@T("Editor.RefreshDraftConflict") <button type="button" class="button-secondary" disabled="@busy" @onclick="DiscardAsync">@Shared["Discard"]</button></div> }
    </div>;
    private RenderFragment DefinitionContent(string path) => path switch { "definition/identity" => IdentityFields, "definition/refresh" => RefreshFields, _ => ConfigurationFields };
    private RenderFragment IdentityFields => @<ResourceIdentityEditor ResourceKind="@SourceRegistryKinds.SourceRegistryRegistration" NamePolicy="ResourceNamePolicy.SourceRegistry" IsNew="IsNew" ReadOnly="@(!CanWrite)"
        DisplayName="@model.DisplayName" DisplayNameChanged="value => model.DisplayName = value" DisplayNameExpression="@(() => model.DisplayName)"
        TechnicalName="@model.Name" TechnicalNameChanged="value => model.Name = value" TechnicalNameExpression="@(() => model.Name)"
        Namespace="@model.Namespace" NamespaceExpression="@(() => model.Namespace)" ScopeRef="model.ScopeRef" Description="@model.Description" DescriptionExpression="@(() => model.Description)" DescriptionReadOnly
        Labels="@model.Tags" LabelsExpression="@(() => model.Tags)" LabelsReadOnly DisplayNameTestId="source-registry-display-name" TechnicalNameTestId="source-registry-name" TestId="source-registry-identity">
        <ScopeContent><ResourceScopeBadge ScopeRef="model.ScopeRef" /></ScopeContent>
    </ResourceIdentityEditor>;
    private RenderFragment ConfigurationFields => @<FormSection Title="@Shared["Configuration"]" Description="@T("CredentialHelp")"><FormGrid>
        <FormField Label="@T("IndexUrl")" Required Class="form-span-2"><ChildContent><ClearableText @bind-Value="model.IndexUrl" Type="url" data-testid="source-registry-index-url" /></ChildContent><Validation><ValidationMessage For="() => model.IndexUrl" /></Validation></FormField>
        <FormField Label="@T("TrustPolicy")"><ChildContent><ClearableSelect @bind-Value="model.TrustPolicy">@foreach (var value in Enum.GetValues<SourceRegistryTrustPolicy>()) { <option value="@value">@TrustPolicy(value)</option> }</ClearableSelect></ChildContent><Validation><ValidationMessage For="() => model.TrustPolicy" /></Validation></FormField>
        <FormField Label="@T("Authentication")"><ChildContent><ClearableSelect @bind-Value="model.AuthenticationMode"><option value="@SourceRegistryAuthenticationMode.None">@T("Authentication.None")</option><option value="@SourceRegistryAuthenticationMode.StaticBearer">@T("Authentication.StaticBearer")</option></ClearableSelect></ChildContent><Validation><ValidationMessage For="() => model.AuthenticationMode" /></Validation></FormField>
        @if (model.AuthenticationMode == SourceRegistryAuthenticationMode.StaticBearer) {
            <FormField Label="@T("CredentialReference")" Required><HelpContent>@T("CredentialValueHidden")</HelpContent><ChildContent><ClearableSelect TValue="string" Value="@CredentialKey" ValueChanged="SelectCredential" ValueExpression="@(() => model.CredentialName)"><option value="">@T("SelectCredential")</option>
                @if (model.CredentialName.Length > 0 && !instanceSecrets.Any(value => SecretKey(value) == CredentialKey)) { <option value="@CredentialKey" disabled>@T("Editor.RetainedCredential") · @ReferenceDisplay(model.CredentialName, model.CredentialScopeRef, model.CredentialNamespace)</option> }
                @foreach (var secret in instanceSecrets) { <option value="@SecretKey(secret)">@secret.Resource.Definition.DisplayName — @secret.Resource.ScopeRef · @secret.Resource.Namespace/@secret.Resource.Name</option> }
            </ClearableSelect></ChildContent><Validation><ValidationMessage For="() => model.CredentialName" /></Validation></FormField>
        }
        <label class="resource-enabled-toggle"><FormCheckbox role="switch" @bind-Value="model.AllowHttp" /><span>@T("AllowHttp")</span></label>
        <label class="resource-enabled-toggle"><FormCheckbox role="switch" @bind-Value="model.AllowPrivateNetwork" /><span>@T("AllowPrivateNetwork")</span></label>
    </FormGrid></FormSection>;
    private RenderFragment RefreshFields => @<FormSection Title="@T("RefreshPolicy")" Eyebrow="@T("Automation")" Description="@T("RefreshPolicyHelp")"><Actions><label class="resource-enabled-toggle"><FormCheckbox role="switch" @bind-Value="model.PeriodicEnabled" /><span>@T("PeriodicRefresh")</span></label></Actions><ChildContent>
            <div class="refresh-policy-fields">
                <FormField Label="@T("IntervalMinutes")"><ChildContent><ClearableNumber @bind-Value="model.IntervalMinutes" /></ChildContent><Validation><ValidationMessage For="() => model.IntervalMinutes" /></Validation></FormField>
                <FormField Label="@T("TimeoutSeconds")"><ChildContent><ClearableNumber @bind-Value="model.TimeoutSeconds" /></ChildContent><Validation><ValidationMessage For="() => model.TimeoutSeconds" /></Validation></FormField>
                <FormField Label="@T("MaximumAttempts")"><ChildContent><ClearableNumber @bind-Value="model.MaximumAttempts" /></ChildContent><Validation><ValidationMessage For="() => model.MaximumAttempts" /></Validation></FormField>
                <FormField Label="@T("InitialBackoffSeconds")"><ChildContent><ClearableNumber @bind-Value="model.InitialBackoffSeconds" /></ChildContent><Validation><ValidationMessage For="() => model.InitialBackoffSeconds" /></Validation></FormField>
                <FormField Label="@T("MaximumBackoffSeconds")"><ChildContent><ClearableNumber @bind-Value="model.MaximumBackoffSeconds" /></ChildContent><Validation><ValidationMessage For="() => model.MaximumBackoffSeconds" /></Validation></FormField>
                <FormField Label="@T("JitterSeconds")"><ChildContent><ClearableNumber @bind-Value="model.JitterSeconds" /></ChildContent><Validation><ValidationMessage For="() => model.JitterSeconds" /></Validation></FormField>
                <FormField Label="@T("StaleAfterMinutes")"><ChildContent><ClearableNumber @bind-Value="model.StaleAfterMinutes" /></ChildContent><Validation><ValidationMessage For="() => model.StaleAfterMinutes" /></Validation></FormField>
                <FormField Label="@T("RetainedObservations")"><ChildContent><ClearableNumber @bind-Value="model.RetainedObservations" /></ChildContent><Validation><ValidationMessage For="() => model.RetainedObservations" /></Validation></FormField>
            </div>
        </ChildContent></FormSection>;
    private sealed record Setting(string Label, string Value);
    private RenderFragment ConfigurationSummary => @<CollectionView TItem="Setting" Items="SavedSettings" IdentityLabel="@Shared["Configuration"]" InformationLabels="@(new[] { Shared["Saved"].Value })"><Identity Context="row"><strong class="configuration-key">@row.Label</strong></Identity><Information Context="row"><CollectionValue Label="@Shared["Saved"]"><span class="configuration-value">@row.Value</span></CollectionValue></Information></CollectionView>;
    private RenderFragment ObservationPanel => @<FormSection Title="@T("LastKnownGood")"><Actions>@if (CanRefresh) { <button type="button" class="button-secondary" disabled="@(busy || view?.Registration.Definition.Enabled != true)" @onclick="RefreshCurrentAsync">@T("RefreshNow")</button> }</Actions><ChildContent>
        @if (view is not null) { <dl class="resource-details"><dt>@T("Freshness")</dt><dd>@ObservedStatus(view.Observed.Definition.Status)</dd><dt>@T("LastSuccessfulRefresh")</dt><dd>@FormatDate(view.Observed.Definition.LastSuccessfulRefreshAt)</dd><dt>@T("IndexDigest")</dt><dd><ValueDisclosure Value="@view.Observed.Definition.Current?.IndexDigest" /></dd><dt>@T("CachedShards")</dt><dd>@(view.Observed.Definition.Current?.Catalogs.Count ?? 0)</dd></dl> }
    </ChildContent></FormSection>;
    private RenderFragment TrustPanel => @<FormSection Title="@T("OriginTrust")" Description="@T("IndependentTrustHelp")">
        @if (originTrust is null) { <p>@T("Editor.TrustUnavailable")</p> }
        else { <dl class="resource-details"><dt>@T("OriginClassification")</dt><dd><StatusBadge Text="@OriginClassification(originTrust.Classification)" Status="@(originTrust.Classification == SourceRegistryOriginClassification.Official ? UiStatus.Info : UiStatus.Neutral)" /></dd><dt>@T("LocalPolicy")</dt><dd>@TrustPolicy(originTrust.Policy)</dd><dt>@T("Reason")</dt><dd><code>@originTrust.ReasonCode</code></dd><dt>@T("Evaluated")</dt><dd>@FormatDate(originTrust.EvaluatedAt)</dd></dl> }
    </FormSection>;
    private RenderFragment HistoryPanel => @<FormSection Title="@T("RefreshHistory")" Description="@T("RefreshHistoryHelp")">
        @if (refreshes is null) { <p>@T("Editor.HistoryUnavailable")</p> }
        else if (refreshes.Count == 0) { <EmptyState Title="@T("NoRefreshHistory")" Message="@T("NoRefreshHistoryMessage")" /> }
        else { <div class="registry-history">@foreach (var refresh in refreshes) { <article><span><strong>@RefreshOutcome(refresh.Definition.Outcome)</strong><small>@FormatDate(refresh.Definition.CompletedAt) · @RefreshTrigger(refresh.Definition.Trigger) · @F("RetryCount", refresh.Definition.RetryCount)</small></span><span><ValueDisclosure Value="@refresh.Definition.IndexDigest" />@if (!string.IsNullOrWhiteSpace(refresh.Definition.ErrorMessage)) { <small class="registry-error">@refresh.Definition.ErrorMessage</small> }</span></article> }</div> }
    </FormSection>;
}
