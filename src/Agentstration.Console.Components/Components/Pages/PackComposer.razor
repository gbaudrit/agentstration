@page "/pack-projects/new"
@implements IDisposable
@inject IPacksClient Client
@inject ConsoleContextState ContextState
@inject IServiceProvider Services
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<PackStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared

<PageTitle>@T("CreatePackProject") · Agentstration</PageTitle>
<UnsavedNavigationGuard IsDirty="HasDraft" HasUnsavedChanges="@(() => HasDraft)" />
<PageHeader ScopeRef="CreationScope" Title="@T("CreatePackFromWorkspace")" Description="@T("PackComposer.Description")" CollectionHref="@BackUrl" CollectionLabel="@T("Packs")">
    <Actions><button type="button" class="button-secondary" disabled="@(loading || creating || reviewing)" @onclick="LoadAsync" data-testid="pack-composer-refresh">@T("Refresh")</button></Actions>
</PageHeader>
<div data-testid="distribution-pack-composer" data-interactive="@(interactive ? "true" : "false")">
@if (loadState.BlocksContent) { <ResourceLoadFeedback State="loadState" OnRetry="LoadAsync" /> }
else
{
    @if (loadState.Status is ResourceLoadStatus.Failed or ResourceLoadStatus.Refreshing) { <ResourceLoadFeedback State="loadState" OnRetry="LoadAsync" /> }
    @if (error is not null) { <div class="form-alert form-alert-danger" role="alert">@error @if (previewFailed) { <button type="button" class="button-secondary" disabled="@(reviewing || creating || loading)" @onclick="RefreshPreviewAsync">@T("Retry")</button> }</div> }
    @if (!CanWrite) { <ResourceReadOnlyNotice Reason="ResourceReadOnlyReason.InsufficientPermissions" /> }
        <section class="composer-summary" aria-label="@T("PackCompositionSummary")">
        <article><span>@T("Selected")</span><strong>@SelectedCount</strong><small>@T("ExplicitResources")</small></article>
        <article><span>@T("PackContents")</span><strong>@(PreviewCurrent ? preview!.Resources.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) : "—")</strong><small>@T("IncludingDependencies")</small></article>
        <article><span>@T("Bindings")</span><strong>@(PreviewCurrent ? preview!.Bindings.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) : "—")</strong><small>@T("EnvironmentSpecificResources")</small></article>
        <article><span>@T("Validation")</span><strong>@ValidationLabel</strong><small>@ValidationDetail</small></article>
    </section>

    <ResourceDefinitionForm @key="metadataContext" @ref="definitionForm" Id="@FormId" EditContext="MetadataContext" FieldLabels="FieldLabels" Sections="Fields" ReadOnly="@(!CanWrite)" Busy="creating"
        OnValidSubmit="SubmitFromFormAsync" OnInvalidSubmit="InvalidSubmitAsync" InvalidInputChanged="value => invalidMetadata = value" data-testid="pack-composer-form">
        <p class="required-fields-note"><span aria-hidden="true">*</span> @Shared["RequiredFields"]</p>
        <CreationWizard @ref="wizard" Steps="Steps" OnFinish="FinishAsync" OnStepReady="StepReadyAsync" CanFinish="CanCreate" FinishLabel="@T(creating ? "Creating" : "CreatePackProject")" FinishTestId="pack-project-create" />
    </ResourceDefinitionForm>
}
</div>

@code {
    private RenderFragment IdentityFields => @<div>    <FormSection Title="@T("ProjectMetadata")" Description="@T("Composer.IdentityHelp")" Class="composer-metadata">
        <FormGrid>
            <FormField Label="@T("Publisher")" Required="true"><ChildContent><ClearableText @bind-Value="model.Publisher" autocomplete="off" spellcheck="false" data-testid="pack-project-publisher" /></ChildContent><Validation><ValidationMessage For="() => model.Publisher" /></Validation></FormField>
            <ResourceIdentityFields @bind-DisplayName="model.DisplayName" @bind-TechnicalName="model.Name" Policy="ResourceNamePolicy.Pack" IsNew="true" DisplayNameTestId="pack-project-display-name" TechnicalNameTestId="pack-project-name" />
            <FormField Label="@T("Version")" Required="true"><ChildContent><ClearableText @bind-Value="model.Version" autocomplete="off" spellcheck="false" data-testid="pack-project-version" /></ChildContent><Validation><ValidationMessage For="() => model.Version" /></Validation></FormField>
            <FormField Label="@T("Audience")"><ChildContent><ClearableSelect @bind-Value="model.Audience"><option value="@PackAudience.Universal">@T("Audience.Universal")</option><option value="@PackAudience.Personal">@T("Audience.Personal")</option><option value="@PackAudience.Professional">@T("Audience.Professional")</option></ClearableSelect></ChildContent><Validation><ValidationMessage For="() => model.Audience" /></Validation></FormField>
            <FormField Label="@T("Purpose")"><ChildContent><ClearableSelect @bind-Value="model.Purpose"><option value="@PackPurpose.Standard">@T("Purpose.Standard")</option><option value="@PackPurpose.Sample">@T("Purpose.Sample")</option><option value="@PackPurpose.Template">@T("Purpose.Template")</option></ClearableSelect></ChildContent><Validation><ValidationMessage For="() => model.Purpose" /></Validation></FormField>
            <FormField Label="@T("Scope")"><ResourceScopeBadge ScopeRef="CreationScope" /></FormField>
            <FormField Label="@T("Categories")"><ChildContent><ClearableText @bind-Value="model.Categories"  /></ChildContent></FormField>
            <FormField Label="@T("Tags")"><ChildContent><ClearableText @bind-Value="model.Tags"  /></ChildContent></FormField>
            <FormField Label="@T("Description")" Class="form-span-2"><ChildContent><ClearableText Multiline="true" rows="3" @bind-Value="model.Description"></ClearableText></ChildContent></FormField>
        </FormGrid>
    </FormSection>
</div>;
    private RenderFragment ResourceFields => @<div>    <section class="composer-transfer" aria-label="@T("PackResourceComposition")">
        <article class="panel composer-catalog">
            <div class="panel-header">
                <div><p class="eyebrow">@T("WorkspaceInventory")</p><h2>@T("AvailableResources")</h2></div>
                <span>@T("ResultCount", AvailableResources.Count)</span>
            </div>
            <div class="composer-filters">
                <FormField Label="@T("Search")"><ChildContent><ClearableText Type="search" @bind-Value="search" placeholder="@T("NameOrDescription")" /></ChildContent></FormField>
                <FormField Label="@T("Kind")"><ChildContent><ClearableSelect @bind-Value="kindFilter"><option value="">@T("AllKinds")</option>@foreach (var kind in Kinds) { <option value="@kind">@kind</option> }</ClearableSelect></ChildContent></FormField>
                <FormField Label="@T("Availability")"><ChildContent><ClearableSelect @bind-Value="availabilityFilter"><option value="">@T("AllResources")</option><option value="selectable">@T("Selectable")</option><option value="binding">@T("BindingOnly")</option><option value="unsupported">@T("NotSupported")</option></ClearableSelect></ChildContent></FormField>
            </div>
            @if (AvailableResources.Count == 0)
            {
                <EmptyState Title="@T("NoAvailableResources")" Message="@T("NoAvailableResourcesMessage")" />
            }
            else
            {
                <div class="composer-resource-list">
                    @foreach (var item in AvailableResources)
                    {
                        var selectable = CanWrite && item.Availability == PackCompositionAvailability.Selectable;
                            <div class="composer-resource @(!selectable ? "unavailable" : null)" data-resource-kind="@item.Resource.Kind" data-resource-name="@item.Resource.Name">
                            <div class="composer-resource-main">
                                <div class="composer-resource-heading"><CollectionIdentity DisplayName="@item.DisplayName" Namespace="@item.Resource.Namespace" Name="@item.Resource.Name" IconName="package" /><span class="composer-kind">@item.Resource.Kind</span></div>
                                <div class="composer-resource-copy">
                                    <small>@if (!string.IsNullOrWhiteSpace(item.Version)) { <text> · @item.Version</text> }</small>
                                    @if (!string.IsNullOrWhiteSpace(item.Description)) { <small>@item.Description</small> }
                                    @if (!string.IsNullOrWhiteSpace(item.AvailabilityReason)) { <small class="composer-reason">@item.AvailabilityReason</small> }
                                </div>
                            </div>
                            <span class="composer-resource-actions">
                                <StatusBadge Text="@AvailabilityLabel(item)" Status="@AvailabilityTone(item)" />
                                @if (selectable)
                                {
                                    <button class="composer-add" type="button" aria-label="@T("AddResourceToPack", item.DisplayName)" @onclick="() => AddAsync(item)" data-testid="pack-project-add-resource">@T("Add") <span aria-hidden="true">→</span></button>
                                }
                            </span>
                        </div>
                    }
                </div>
            }
        </article>

        <article class="panel composer-preview">
            <div class="panel-header">
                <div><p class="eyebrow">@T("PackComposition")</p><h2>@T("SelectedContents")</h2></div>
                <span class="composer-live-status" aria-live="polite">
                    @if (reviewing) { <span class="composer-spinner" aria-hidden="true"></span><text> @T("Reviewing")</text> }
                    else if (preview is not null) { <StatusBadge Text="@ValidationLabel" Status="ValidationTone" /> }
                </span>
            </div>
            @if (SelectedCount == 0)
            {
                <div class="composer-empty"><span>→</span><p>@T("AddResourcesHelp")</p></div>
            }
            else
            {
                @if (preview is { Issues.Count: > 0 })
                {
                    <div class="composer-issues">@foreach (var issue in preview.Issues) { <p class="@(issue.Severity == PackCompositionIssueSeverity.Error ? "error" : "warning")"><strong>@issue.Code</strong> @issue.Message</p> }</div>
                }
                @if (ExplicitPackResources.Count > 0)
                {
                    <section class="composer-content-group" aria-labelledby="explicit-selection-heading">
                        <div class="composer-group-header">
                            <div><h3 id="explicit-selection-heading">@T("YourSelection")</h3><p>@T("DirectResources")</p></div>
                            <span>@ExplicitPackResources.Count</span>
                        </div>
                        <div class="composer-selection-list">
                        @foreach (var resource in ExplicitPackResources)
                        {
                            var remainsRequired = IsRequiredByOtherSelection(resource);
                            <div class="composer-selected-resource explicit" @key="resource.Resource.Address">
                                <div class="composer-resource-main">
                                    <div class="composer-resource-heading"><CollectionIdentity DisplayName="@resource.DisplayName" Namespace="@resource.Resource.Namespace" Name="@resource.Resource.Name" IconName="package" /><span class="composer-kind">@resource.Resource.Kind</span></div>
                                    <div class="composer-resource-copy">
                                        <small>@T("ExplicitSelection")</small>
                                        @if (!string.IsNullOrWhiteSpace(resource.Path)) { <small>@resource.Path</small> }
                                        @if (remainsRequired) { <small class="composer-inclusion-reason">@InclusionReason(resource)</small> }
                                    </div>
                                </div>
                                <button class="composer-remove" type="button" disabled="@(!CanWrite || creating)" aria-label="@(remainsRequired ? T("LeaveAsDependencyLabel", resource.DisplayName) : T("RemoveFromPackLabel", resource.DisplayName))" @onclick="() => RemoveAsync(resource.Resource.Address)">
                                    @(remainsRequired ? T("LeaveAsDependency") : T("Remove")) <span aria-hidden="true">←</span>
                                </button>
                            </div>
                        }
                        </div>
                    </section>
                }
                @if (AutomaticPackResources.Count > 0)
                {
                    <section class="composer-content-group automatic" aria-labelledby="automatic-selection-heading">
                        <div class="composer-group-header">
                            <div><h3 id="automatic-selection-heading">@T("IncludedAutomatically")</h3><p>@T("RequiredByDirectSelections")</p></div>
                            <span>@AutomaticPackResources.Count</span>
                        </div>
                        <div class="composer-selection-list">
                        @foreach (var resource in AutomaticPackResources)
                        {
                            <div class="composer-selected-resource dependency" @key="resource.Resource.Address">
                                <div class="composer-resource-main">
                                    <div class="composer-resource-heading"><CollectionIdentity DisplayName="@resource.DisplayName" Namespace="@resource.Resource.Namespace" Name="@resource.Resource.Name" IconName="package" /><span class="composer-kind">@resource.Resource.Kind</span></div>
                                    <div class="composer-resource-copy">
                                        <small>@T("RequiredDependency")</small>
                                        @if (!string.IsNullOrWhiteSpace(resource.Path)) { <small>@resource.Path</small> }
                                        <small class="composer-inclusion-reason">@InclusionReason(resource)</small>
                                    </div>
                                </div>
                                <button class="composer-pin" type="button" disabled="@(!CanWrite || creating)" aria-label="@T("KeepExplicitlyLabel", resource.DisplayName)" @onclick="() => PinAsync(resource)">@T("KeepExplicitly")</button>
                            </div>
                        }
                        </div>
                    </section>
                }
                @if (preview is not null)
                {
                    <h3>@T("ExternalBindings")</h3>
                    @if (preview.Bindings.Count == 0) { <p class="muted">@T("NoExternalBindingRequired")</p> }
                    else
                    {
                        <div class="composer-preview-list bindings">
                            @foreach (var binding in preview.Bindings)
                            {
                                <div><span class="composer-kind">@BindingLabel(binding.TargetKind)</span><span><strong>@binding.Name</strong><small>@T("UsedBy", binding.WorkspaceResource.Name, string.Join(", ", binding.UsedBy.Select(value => value.Name)))</small></span></div>
                            }
                        </div>
                    }
                }
            }
        </article>
    </section></div>;
    private RenderFragment ReviewFields => @<FormSection Title="@Shared["Verification"]" Description="@T("Composer.ReviewHelp")">
        <dl class="resource-details composer-review">
            <dt>@T("Publisher")</dt><dd>@model.Publisher</dd><dt>@T("TechnicalName")</dt><dd>@model.Name</dd><dt>@T("Version")</dt><dd>@model.Version</dd>
            <dt>@T("DisplayName")</dt><dd>@(string.IsNullOrWhiteSpace(model.DisplayName) ? model.Name : model.DisplayName)</dd><dt>@T("Description")</dt><dd>@(model.Description ?? "—")</dd>
            <dt>@T("Audience")</dt><dd>@T($"Audience.{model.Audience}")</dd><dt>@T("Purpose")</dt><dd>@T($"Purpose.{model.Purpose}")</dd>
            <dt>@T("Categories")</dt><dd>@model.Categories</dd><dt>@T("Tags")</dt><dd>@model.Tags</dd><dt>@T("Scope")</dt><dd><ResourceScopeBadge ScopeRef="CreationScope" /></dd>
        </dl>
        @if (!PreviewCurrent) { <p>@T(SelectedCount == 0 ? "AddResource" : "NotPreviewed")</p> }
        @if (preview is { } reviewed) {
            <h3>@T("SelectedContents")</h3><ul>@foreach (var item in reviewed.Resources) { <li>@item.Resource.Kind · @item.Resource.Namespace/@item.Resource.Name — @T(item.ExplicitlySelected ? "ExplicitSelection" : "RequiredDependency")</li> }</ul>
            <h3>@T("ExternalBindings")</h3>@if (reviewed.Bindings.Count == 0) { <p>@T("NoExternalBindingRequired")</p> } else { <ul>@foreach (var binding in reviewed.Bindings) { <li>@BindingLabel(binding.TargetKind) · @binding.Name — @T("UsedBy", binding.WorkspaceResource.Name, string.Join(", ", binding.UsedBy.Select(value => value.Name)))</li> }</ul> }
            @foreach (var issue in reviewed.Issues) { <p class="form-alert @(issue.Severity == PackCompositionIssueSeverity.Error ? "form-alert-danger" : "form-alert-warning")">@issue.Code — @issue.Message</p> }
        }
    </FormSection>;
    private readonly CancellationTokenSource cancellation = new();
    private readonly CancellationToken lifetimeToken;
    public PackComposer() => lifetimeToken = cancellation.Token;
    private readonly Dictionary<ResourceAddress, PackCompositionResourceKey> selected = [];
    private CancellationTokenSource? previewCancellation;
    private IReadOnlyList<PackCompositionCatalogItem> resources = [];
    private PackCompositionPreview? preview;
    private string? error, baseline, loadedKey, previewSignature, pendingStep;
    private string search = string.Empty, kindFilter = string.Empty, availabilityFilter = string.Empty;
    private PackComposerModel model = new();
    private EditContext metadataContext = null!;
    private EditContext MetadataContext => metadataContext;
    private ResourceDefinitionForm? definitionForm;
    private CreationWizard? wizard;
    private ResourceLoadState loadState = new(ResourceLoadStatus.Loading);
    private bool invalidMetadata, previewFailed, loading = true, creating, reviewing, interactive, disposed, completed;
    private long loadVersion, previewVersion;
    private string FormId { get; } = $"pack-composer-{Guid.NewGuid():N}";
    private ResourceScopeRef? CreationScope => ContextState.Current is { } current ? ResourceScopeRef.Parse(current.SelectedScopeRef) : null;
    private string ContextKey => $"{ContextState.Current?.UserId}|{ContextState.Current?.SelectedScopeRef}|{ContextState.Current?.WorkspaceId}";
    private bool CanRead => ContextState.HasPermission("resources/read");
    private bool CanWrite => !disposed && ContextState.HasPermission("resources/write");
    private string Fingerprint => JsonSerializer.Serialize(model);
    private bool HasDraft => !disposed && !completed && baseline is not null && (Fingerprint != baseline || invalidMetadata || selected.Count > 0);
    private string SelectionSignature => JsonSerializer.Serialize(Selections());
    private bool PreviewCurrent => preview is not null && previewSignature == SelectionSignature;
    private bool CanCreate => CanWrite && !loading && !invalidMetadata && PreviewCurrent && preview!.CanCreate && !reviewing && !creating && model.CoordinatesPresent;
    private string BackUrl => ResourceOwnershipContext.PreserveNavigation("/packs", Services);
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    private IReadOnlyList<CreationWizardStep> Steps => [new("identity", T("PackIdentity"), IdentityFields) { IsComplete = model.CoordinatesPresent && !invalidMetadata }, new("resources", T("PackResourceComposition"), ResourceFields) { IsComplete = PreviewCurrent && preview!.CanCreate && !reviewing }, new("review", Shared["Verification"], ReviewFields) { IsComplete = CanCreate }];
    private IReadOnlyDictionary<string, string> FieldLabels => new Dictionary<string, string> { [nameof(model.Publisher)] = T("Publisher"), [nameof(model.Name)] = T("TechnicalName"), [nameof(model.Version)] = T("Version"), [nameof(model.DisplayName)] = T("DisplayName"), [nameof(model.Description)] = T("Description"), [nameof(model.Audience)] = T("Audience"), [nameof(model.Purpose)] = T("Purpose"), [nameof(model.Categories)] = T("Categories"), [nameof(model.Tags)] = T("Tags") };
    private static IReadOnlyDictionary<string, ResourceSectionPresentation> Fields => new Dictionary<string, ResourceSectionPresentation> { ["definition/identity"] = new() { HasRequiredFields = true, Fields = [nameof(PackComposerModel.Publisher), nameof(PackComposerModel.Name), nameof(PackComposerModel.Version), nameof(PackComposerModel.DisplayName), nameof(PackComposerModel.Description), nameof(PackComposerModel.Audience), nameof(PackComposerModel.Purpose), nameof(PackComposerModel.Categories), nameof(PackComposerModel.Tags)] } };
    protected override async Task OnInitializedAsync()
    {
        ResetDraft(); await ContextState.EnsureLoadedAsync(lifetimeToken); if (disposed) return;
        loadedKey = ContextKey; ContextState.Changed += ContextChanged; await LoadAsync();
    }
    private void ResetDraft() { ++previewVersion; previewCancellation?.Cancel(); creating = reviewing = false; pendingStep = null; model = new(); metadataContext = new(model); invalidMetadata = completed = previewFailed = false; baseline = Fingerprint; selected.Clear(); preview = null; previewSignature = null; resources = []; error = null; }
    private void ContextChanged() => _ = InvokeAsync(async () => { if (disposed) return; if (loadedKey != ContextKey) { ++loadVersion; ++previewVersion; previewCancellation?.Cancel(); loadedKey = ContextKey; ResetDraft(); await LoadAsync(); } else if (!CanRead) { ++loadVersion; ++previewVersion; previewCancellation?.Cancel(); ResetDraft(); loadState = new(ResourceLoadStatus.Forbidden); } StateHasChanged(); });
    protected override void OnAfterRender(bool firstRender) { if (firstRender) { interactive = true; StateHasChanged(); } }
    private async Task LoadAsync()
    {
        if (disposed || creating) return; var request = ++loadVersion; var key = loadedKey; loading = true;
        var hasContent = loadState.HasContent; loadState = new(hasContent ? ResourceLoadStatus.Refreshing : ResourceLoadStatus.Loading) { HasContent = hasContent };
        try { if (!CanRead) { ResetDraft(); loadState = new(ResourceLoadStatus.Forbidden); return; } var values = await Client.GetCompositionResourcesAsync(lifetimeToken); if (!Current(request, key)) return; resources = values; loadState = new(ResourceLoadStatus.Ready) { HasContent = true }; }
        catch (OperationCanceledException) when (lifetimeToken.IsCancellationRequested) { }
        catch (Exception exception) { if (!Current(request, key)) return; var status = FailureStatus(exception); if (status is ResourceLoadStatus.Forbidden or ResourceLoadStatus.NotFound) ResetDraft(); loadState = new(status) { HasContent = status == ResourceLoadStatus.Failed && hasContent, ErrorId = (exception as AgentstrationApiException)?.ErrorId }; }
        finally { if (Current(request, key)) loading = false; }
    }
    private bool Current(long request, string? key) => !disposed && request == loadVersion && key == loadedKey && key == ContextKey;
    private static ResourceLoadStatus FailureStatus(Exception exception) => exception is AgentstrationApiException api ? api.StatusCode switch { System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden => ResourceLoadStatus.Forbidden, System.Net.HttpStatusCode.NotFound => ResourceLoadStatus.NotFound, _ => ResourceLoadStatus.Failed } : ResourceLoadStatus.Failed;
    private IReadOnlyList<string> Kinds => resources.Select(item => item.Resource.Kind).Distinct(StringComparer.Ordinal).Order().ToArray();
    private IReadOnlyList<PackCompositionCatalogItem> FilteredResources => resources.Where(item =>
        (string.IsNullOrWhiteSpace(search) || item.DisplayName.Contains(search, StringComparison.OrdinalIgnoreCase) || item.Resource.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || (item.Description?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false))
        && (kindFilter.Length == 0 || item.Resource.Kind == kindFilter)
        && (availabilityFilter.Length == 0 || availabilityFilter == "selectable" && item.Availability == PackCompositionAvailability.Selectable || availabilityFilter == "binding" && item.Availability == PackCompositionAvailability.BindingOnly || availabilityFilter == "unsupported" && item.Availability == PackCompositionAvailability.Unsupported)).ToArray();
    private IReadOnlyList<PackCompositionCatalogItem> AvailableResources => FilteredResources.Where(item => !IsIncluded(item.Resource.Address)).ToArray();
    private IReadOnlyList<PackCompositionPreviewResource> DisplayedPackResources => preview?.Resources ?? resources.Where(IsSelected).Select(item => new PackCompositionPreviewResource(item.Resource, item.DisplayName, string.Empty, true, [])).ToArray();
    private IReadOnlyList<PackCompositionPreviewResource> ExplicitPackResources => DisplayedPackResources.Where(item => item.ExplicitlySelected).ToArray();
    private IReadOnlyList<PackCompositionPreviewResource> AutomaticPackResources => DisplayedPackResources.Where(item => !item.ExplicitlySelected).ToArray();
    private int SelectedCount => selected.Count;
    private string ValidationLabel => reviewing ? T("Reviewing") : !PreviewCurrent ? T(SelectedCount == 0 ? "Empty" : "NotPreviewed") : preview!.CanCreate ? T("Ready") : T("Blocked");
    private UiStatus ValidationTone => !PreviewCurrent ? UiStatus.Neutral : preview!.CanCreate ? UiStatus.Success : UiStatus.Warning;
    private string ValidationDetail => reviewing ? T("UpdatingDependencies") : !PreviewCurrent ? T(SelectedCount == 0 ? "AddResource" : "Retry") : preview!.Issues.Count == 0 ? T("NoIssue") : T("IssueCount", preview.Issues.Count);
    private bool IsSelected(PackCompositionCatalogItem item) => selected.ContainsKey(item.Resource.Address);
    private bool IsIncluded(ResourceAddress address) => selected.ContainsKey(address) || preview?.Resources.Any(item => item.Resource.Address == address) == true;
    private async Task AddAsync(PackCompositionCatalogItem item) { if (!CanWrite || creating || item.Availability != PackCompositionAvailability.Selectable || !selected.TryAdd(item.Resource.Address, item.Resource)) return; await RefreshPreviewAsync(); }
    private async Task RemoveAsync(ResourceAddress address) { if (!CanWrite || creating || !selected.Remove(address)) return; await RefreshPreviewAsync(); }
    private async Task PinAsync(PackCompositionPreviewResource resource) { if (!CanWrite || creating || !selected.TryAdd(resource.Resource.Address, resource.Resource)) return; await RefreshPreviewAsync(); }
    private async Task RefreshPreviewAsync()
    {
        previewCancellation?.Cancel(); previewCancellation?.Dispose(); previewCancellation = CancellationTokenSource.CreateLinkedTokenSource(lifetimeToken);
        var token = previewCancellation.Token; var request = ++previewVersion; var key = loadedKey; var signature = SelectionSignature;
        if (SelectedCount == 0) { preview = null; previewSignature = null; reviewing = false; return; }
        reviewing = true; previewFailed = false; error = null;
        try { var value = await Client.PreviewCompositionAsync(new(Selections()), token); if (!disposed && request == previewVersion && key == ContextKey && signature == SelectionSignature) { preview = value; previewSignature = signature; } }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception exception) { if (!disposed && request == previewVersion && key == ContextKey) { if (FailureStatus(exception) == ResourceLoadStatus.Forbidden) { ResetDraft(); loadState = new(ResourceLoadStatus.Forbidden); } else { if (FailureStatus(exception) == ResourceLoadStatus.NotFound) { preview = null; previewSignature = null; } previewFailed = true; error = exception.Message; } } }
        finally { if (!disposed && request == previewVersion && key == ContextKey) reviewing = false; }
    }
    private async Task FinishAsync(CreationWizardFinish finish) { if (!CanCreate) return; await CreateAsync(); }
    private async Task SubmitFromFormAsync() { if (wizard?.CurrentStepId != "review" && wizard is not null) { await wizard.GoToStepAsync("review"); return; } await CreateAsync(); }
    private async Task InvalidSubmitAsync(EditContext context) { pendingStep = "identity"; if (wizard is not null) await wizard.GoToStepAsync("identity"); }
    private Task StepReadyAsync(string step) { if (pendingStep == step) { pendingStep = null; definitionForm?.RequestValidationFocus(); StateHasChanged(); } return Task.CompletedTask; }
    private async Task CreateAsync()
    {
        if (!CanCreate) return; var request = loadVersion; var key = loadedKey; creating = true; previewFailed = false; error = null;
        try { var project = await Client.CreateProjectFromWorkspaceAsync(model.Command(Selections()), lifetimeToken); if (!Current(request, key)) return; if (project.Value.Uid == Guid.Empty || project.Value.Kind != PackAuthoringKinds.PackProject || project.Value.ScopeRef != CreationScope || project.Value.Definition.Publisher != model.Publisher.Trim() || project.Value.Definition.PackName != model.Name.Trim()) { error = T("Composer.OperationUnconfirmed"); return; } completed = true; Navigation.NavigateTo(ResourceOwnershipContext.PreserveNavigation($"/pack-projects/{project.Value.Uid:D}", Services)); }
        catch (OperationCanceledException) when (lifetimeToken.IsCancellationRequested) { }
        catch (Exception exception) { if (Current(request, key)) error = exception is HttpRequestException or TimeoutException ? T("Composer.OperationUnconfirmed") : exception.Message; }
        finally { if (Current(request, key)) creating = false; }
    }
    private PackCompositionResourceKey[] Selections() => selected.Values.ToArray();
    private bool IsRequiredByOtherSelection(PackCompositionPreviewResource resource) => InclusionPaths(resource).Count > 0;
    private string InclusionReason(PackCompositionPreviewResource resource)
    {
        var paths = InclusionPaths(resource);
        return paths.Count switch
        {
            0 => T("IncludedByDependencyClosure"),
            1 => T("RequiredBy", paths[0]),
            _ => T("RequiredByAndOthers", paths[0], paths.Count - 1)
        };
    }
    private IReadOnlyList<string> InclusionPaths(PackCompositionPreviewResource target)
    {
        if (preview is null) return [];
        var resourcesByAddress = preview.Resources.ToDictionary(item => item.Resource.Address);
        var paths = new List<string>();
        foreach (var root in preview.Resources.Where(item => item.ExplicitlySelected && item.Resource.Address != target.Resource.Address))
        {
            var path = FindDependencyPath(root, target.Resource.Address, resourcesByAddress, []);
            if (path is not null) paths.Add(string.Join(" → ", path.Select(ResourceLabel)));
        }
        return paths.Distinct(StringComparer.Ordinal).ToArray();
    }
    private static IReadOnlyList<PackCompositionPreviewResource>? FindDependencyPath(
        PackCompositionPreviewResource current,
        ResourceAddress target,
        IReadOnlyDictionary<ResourceAddress, PackCompositionPreviewResource> resourcesByAddress,
        HashSet<ResourceAddress> visited)
    {
        if (!visited.Add(current.Resource.Address)) return null;
        foreach (var dependency in current.Dependencies.Where(item => item.Mode == PackCompositionDependencyMode.Include))
        {
            if (dependency.Target.Address == target) return [current];
            if (!resourcesByAddress.TryGetValue(dependency.Target.Address, out var next)) continue;
            var nested = FindDependencyPath(next, target, resourcesByAddress, new HashSet<ResourceAddress>(visited));
            if (nested is not null) return [current, .. nested];
        }
        return null;
    }
    private static string ResourceLabel(PackCompositionPreviewResource resource) => $"{resource.Resource.Kind} {resource.DisplayName}";
    private string AvailabilityLabel(PackCompositionCatalogItem item) => item.Availability switch { PackCompositionAvailability.Selectable => T($"Status.{item.Status}"), PackCompositionAvailability.BindingOnly => T("BindingOnly"), _ => T("NotSupported") };
    private static UiStatus AvailabilityTone(PackCompositionCatalogItem item) => item.Availability switch { PackCompositionAvailability.Selectable => UiStatus.Success, PackCompositionAvailability.BindingOnly => UiStatus.Info, _ => UiStatus.Neutral };
    private string BindingLabel(PackBindingTargetKind kind) => kind switch
    {
        PackBindingTargetKind.Secret => T("Binding.Secret"),
        PackBindingTargetKind.ModelProvider => T("Binding.ModelProvider"),
        PackBindingTargetKind.RuntimeProfile => T("Binding.RuntimeProfile"),
        _ => T("Binding.ModelProfile")
    };

    public void Dispose() { if (disposed) return; disposed = true; ++loadVersion; ++previewVersion; ContextState.Changed -= ContextChanged; previewCancellation?.Cancel(); previewCancellation?.Dispose(); cancellation.Cancel(); cancellation.Dispose(); }
}
