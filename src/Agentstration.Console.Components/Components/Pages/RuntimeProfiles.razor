@page "/runtimeprofiles"
@implements IDisposable
@inject IServiceProvider Services
@inject IRuntimeProfilesClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<RuntimeProfilesStrings> Localizer

<PageTitle>@T("Title") · Agentstration</PageTitle>
<PageHeader Title="@T("Title")" Description="@T("Description")" TestId="resource-runtime-profiles">
    <Actions><a class="button-primary" href="/runtimeprofiles/new">@T("CreateProfile")</a></Actions>
</PageHeader>

@if (error is not null) { <ErrorState Message="@error.Message" ErrorId="@error.ErrorId"><button class="button-secondary" @onclick="LoadAsync">@T("Retry")</button></ErrorState> }
else if (profiles is null) { <LoadingState Message="@T("Loading")" /> }
else if (profiles.Count == 0) { <EmptyState Title="@T("EmptyTitle")" Message="@T("EmptyMessage")"><a class="button-primary" href="/runtimeprofiles/new">@T("CreateProfile")</a></EmptyState> }
else
{
    <CollectionView TItem="RuntimeProfileSummaryResponse" Items="profiles" InformationLabels="@(new[] { T("Runtime"), T("Session"), T("Streaming"), T("Usage") })">
        <Identity Context="profile"><CollectionIdentity DisplayName="@profile.Properties.DisplayName" Namespace="@profile.Namespace" Name="@profile.Name" Href="@Url(profile)" IconName="server" Domain="runtime"><Badges><ManagedResourceBadge IsManaged="@profile.IsManaged" /></Badges></CollectionIdentity></Identity>
        <Scope Context="profile"><ResourceScopeBadge ShowName ScopeRef="@profile.ScopeRef" Kind="ResourceScopeKind.Instance" /></Scope>
        <Information Context="profile">
            <CollectionValue Label="@T("Runtime")"><code>@profile.Properties.RuntimeType</code></CollectionValue>
            <CollectionValue Label="@T("Session")">@SessionLabel(profile.Properties.Execution.SessionMode)</CollectionValue>
            <CollectionValue Label="@T("Streaming")">@StreamingLabel(profile.Properties.Execution.Streaming)</CollectionValue>
            <CollectionValue Label="@T("Usage")">@DeploymentCount(profile.UsageCount)</CollectionValue>
        </Information>
        <Actions Context="profile"><CollectionActions ResourceName="@($"{profile.Properties.DisplayName} ({profile.Namespace}/{profile.Name})")"><a href="@Url(profile)">@T("Open")</a></CollectionActions></Actions>
    </CollectionView>
}

@code {
    private readonly CancellationTokenSource cancellation = new();
    private IReadOnlyList<RuntimeProfileSummaryResponse>? profiles;
    private AgentstrationApiException? error;
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string DeploymentCount(int count) => T(count == 1 ? "DeploymentCount.One" : "DeploymentCount.Many", count);
    private string SessionLabel(RuntimeSessionMode value) => Localizer[$"Session.{value}"];
    private string StreamingLabel(StreamingMode value) => Localizer[$"Streaming.{value}"];
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync() { error = null; try { profiles = await Client.GetRuntimeProfilesAsync(cancellation.Token); } catch (AgentstrationApiException exception) { error = exception; } }
    private string Url(RuntimeProfileSummaryResponse profile) => ResourceOwnershipContext.PreserveNavigation($"/runtimeprofiles/{Uri.EscapeDataString(profile.Name)}?namespace={Uri.EscapeDataString(profile.Namespace)}", Services);
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
