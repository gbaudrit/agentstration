@page "/entries"
@rendermode InteractiveServer
@inject IEntryAdministrationApiClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<WorkplaceStrings> Localizer

<PageTitle>@T("Entries") · Agentstration</PageTitle>
<PageHeader Eyebrow="Workplace" Title="@T("Entries")" Description="@T("Entries.Description")" TestId="resource-entries">
    <Actions><a class="button-primary entry-create-action" href="/entries/new"><UiIcon Name="plus" />@T("CreateEntry")</a></Actions>
</PageHeader>

@if (loading) { <LoadingState Message="@T("LoadingEntries")" /> }
else if (items.Count == 0) { <EmptyState Title="@T("NoEntries")" Message="@T("NoEntriesMessage")" /> }
else
{
    <section class="entry-catalog" aria-label="@T("EntryCatalog")">
        <header class="entry-catalog-header">
            <div>
                <p class="eyebrow">@T("Catalog")</p>
                <h2>@T("WorkplaceEntryPoints")</h2>
                <p>@T("EntryCatalog.Description")</p>
            </div>
            <div class="entry-catalog-summary" aria-label="@T("EntrySummary")">
                <span><strong>@items.Count</strong> @T("TotalLower")</span>
                <span><strong>@PublishedCount</strong> @T("PublishedLower")</span>
            </div>
        </header>

        <div class="entry-card-list" role="list">
            @foreach (var item in items)
            {
                <article role="listitem" class="entry-card @(item.Published is null ? "entry-card-draft" : "entry-card-published")">
                    <CollectionIdentity DisplayName="@item.Value.DisplayName" Namespace="@item.Value.Id.Namespace.Value" Name="@item.Value.Id.Value" Href="@ConsoleResourceUrls.Entry(item.Value.Id)" IconName="entry" class="resource-name-link entry-card-link"><Versions><CollectionVersion Label="@T("PublishedVersionLabel")" Value="@item.Published?.Version.ToString()" /></Versions><IconBadges><ResourceScopeBadge ScopeRef="@ResourceScopeRef.Workspace(item.Value.WorkspaceId.Value)" IconOnly /><StatusBadge Text="@(item.Published is null ? T("Draft") : T("Published"))" Status="@(item.Published is null ? UiStatus.Warning : UiStatus.Success)" IconOnly /><ManagedResourceBadge IsManaged="@item.ManagedByPack" IconOnly /></IconBadges></CollectionIdentity>
                    <p class="entry-kind">@T("EntryKind", EnumLabel("Presentation", item.Value.Presentation.Kind))</p>
                    <p class="entry-description">@(string.IsNullOrWhiteSpace(item.Value.Description) ? T("EntryFallbackDescription", ResourceName(item.Value.Binding.ResourceId)) : item.Value.Description)</p>
                    <p>@EnumLabel("Binding", item.Value.Binding.Kind) <strong>@ResourceName(item.Value.Binding.ResourceId)</strong></p>
                    <CollectionActions ResourceName="@($"{item.Value.DisplayName} ({item.Value.Id.Namespace}/{item.Value.Id.Value})")"><a href="@ConsoleResourceUrls.Entry(item.Value.Id)">@T("Configure")</a></CollectionActions>
                </article>
            }
        </div>
    </section>
}

@code {
    private bool loading = true;
    private IReadOnlyList<EntryDraftResponse> items = [];
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    private int PublishedCount => items.Count(item => item.Published is not null);

    protected override async Task OnInitializedAsync()
    {
        items = await Client.GetEntriesAsync(default);
        loading = false;
    }

    private string EnumLabel<TEnum>(string prefix, TEnum value) where TEnum : struct, Enum => T($"{prefix}.{value}");
    private static string ResourceName(string id) => id[(id.LastIndexOf('/') + 1)..];
}
