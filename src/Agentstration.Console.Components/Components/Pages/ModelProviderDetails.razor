        ["definition/configuration"] = new() { HasRequiredFields = Requirements.Any(value => value.Required), Fields = [nameof(ModelProviderEditorModel.ValueBindings), nameof(ModelProviderEditorModel.SpecificationOverrides)], Actions = CanOperate ? TestActions : null, ReadOnlyActions = CanOperate ? TestActions : null },
