@page "/modelproviders/new"
@page "/modelproviders/{Name}"
@implements IDisposable
@inject IModelProvidersClient Client
@inject IExtensionsClient ExtensionsClient
@inject IParametersClient ParametersClient
@inject ISecretsClient SecretsClient
@inject NavigationManager Navigation
@inject NotificationState Notifications
@inject Microsoft.Extensions.Localization.IStringLocalizer<ModelProviderDetailsStrings> Localizer

<PageTitle>@(IsNew ? T("CreateProvider") : $"{Name} · {T("ModelProvider")}") · Agentstration</PageTitle>
<PageHeader Title="@(IsNew ? T("CreateProvider") : model?.DisplayName ?? Name)" Description="@T("Description")" TestId="resource-model-provider-editor">
    <Actions>@if (!IsNew) { <button class="button-danger" @onclick="RequestDelete" data-testid="model-provider-delete">@T("Delete")</button><a class="button-primary" href="@CreateModelProfileUrl()">@T("CreateModelProfile")</a> }<a class="button-secondary" href="/modelproviders">@T("Back")</a></Actions>
</PageHeader>

@if (model is null) { <LoadingState Message="@T("Loading")" /> }
else
{
    @if (error is not null) { <div class="form-alert form-alert-danger" role="alert"><strong>@T("ProviderError")</strong><span>@error.Message</span></div> }
    @if (usages.Count > 0) { <div class="form-alert form-alert-warning">@T("ProviderReferencedBy", ProfileCount(usages.Count))</div> }
    @if (!IsNew)
    {
        <nav class="section-tabs model-provider-tabs" role="tablist" aria-label="@T("ModelProvider")">
            <button id="model-provider-overview-tab" type="button" role="tab" aria-selected="@(activeTab == ProviderTab.Overview ? "true" : "false")" aria-controls="model-provider-tab-panel" class="@(activeTab == ProviderTab.Overview ? "active" : null)" @onclick="() => activeTab = ProviderTab.Overview">@T("Tab.Overview")</button>
            <button id="model-provider-configuration-tab" type="button" role="tab" aria-selected="@(activeTab == ProviderTab.Configuration ? "true" : "false")" aria-controls="model-provider-tab-panel" class="@(activeTab == ProviderTab.Configuration ? "active" : null)" @onclick="() => activeTab = ProviderTab.Configuration" disabled="@(!interactive)" data-testid="model-provider-configuration-tab" data-interactive="@(interactive ? "true" : "false")">@T("Tab.Configuration")</button>
        </nav>
    }
    <div id="model-provider-tab-panel" role="tabpanel" aria-labelledby="@(activeTab == ProviderTab.Configuration ? "model-provider-configuration-tab" : "model-provider-overview-tab")">
    @if (IsNew || activeTab == ProviderTab.Configuration)
    {
    <EditForm Model="model" OnValidSubmit="SaveAsync" FormName="model-provider-editor" class="resource-form" data-testid="model-provider-form" data-interactive="@(interactive ? "true" : "false")" data-resource-etag="@etag">
        <DataAnnotationsValidator /><ValidationSummary />
        <section class="panel form-section"><div class="panel-header"><div><p class="eyebrow">@T("Identity")</p><h2>@T("ProviderResource")</h2></div>@if (status is not null) { <StatusBadge Text="@StatusLabel(status.Status)" Status="@ModelManagementUi.Status(status.Status)" /> }</div><div class="form-grid">
            <ResourceIdentityFields @bind-DisplayName="model.DisplayName" @bind-TechnicalName="model.Name" IsNew="@IsNew" DisplayNameTestId="model-provider-display-name" TechnicalNameTestId="model-provider-name" />
            <label><span>@T("Namespace")</span><InputText @bind-Value="model.Namespace" disabled="@(!IsNew)" /><ValidationMessage For="() => model.Namespace" /></label>
            <ResourceScopeFormField ResourceKind="@ModelResourceKinds.ModelProvider" @bind-Value="selectedScope" Disabled="@(!IsNew)" />
            <label><span>@T("ExtensionRegistration")</span><select value="@model.ExtensionId" @onchange="ExtensionChanged" data-testid="model-provider-extension"><option value="">@T("SelectExtension")</option>@foreach (var extension in extensions) { <option value="@ExtensionKey(extension)">@extension.RegistrationNamespace/@extension.RegistrationName — @(extension.Extension?.Name ?? extension.RegistrationName)</option> }</select><ValidationMessage For="() => model.ExtensionId" /></label>
            <label><span>@T("ModelProviderContribution")</span><select value="@model.ContributionId" @onchange="ContributionChanged" data-testid="model-provider-contribution"><option value="">@T("SelectContribution")</option>@foreach (var contribution in Contributions) { <option value="@contribution.Id">@contribution.Id</option> }</select><ValidationMessage For="() => model.ContributionId" /></label>
        </div></section>
        @if (Requirements.Count > 0)
        {
            <section class="panel form-section" data-testid="model-provider-value-bindings"><div class="panel-header"><div><p class="eyebrow">@T("ConfigurationValues")</p><h2>@T("ValueBindings")</h2><p>@T("ValueBindingsHelp")</p></div></div>
                <div class="binding-requirements">
                    @foreach (var requirement in Requirements)
                    {
                        var binding = Binding(requirement);
                        var secured = IsSecured(requirement);
                        <div class="panel binding-requirement" data-testid="model-provider-value-requirement" data-requirement-id="@requirement.Id">
                            <div class="panel-header"><div><strong>@requirement.Id</strong>@if (!string.IsNullOrWhiteSpace(requirement.Description)) { <p>@requirement.Description</p> }</div><div><StatusBadge Text="@(requirement.Required ? T("Required") : T("Optional"))" Status="@(requirement.Required ? UiStatus.Info : UiStatus.Neutral)" /><StatusBadge Text="@(secured ? T("Protection.Secured") : T("Protection.Standard"))" Status="@(secured ? UiStatus.Warning : UiStatus.Neutral)" /></div></div>
                            <p><span>@T("ExpectedType"):</span> <code>@requirement.ValueType</code>@if (!string.IsNullOrWhiteSpace(requirement.Format)) { <span> · @T("ExpectedFormat"): <code>@requirement.Format</code></span> }</p>
                            <div class="form-grid">
                                <label><span>@T("ValueSource")</span><select value="@binding.Kind" @onchange="args => SourceChanged(binding, args)" data-testid="model-provider-binding-kind"><option value="@ModelProviderValueBindingKind.Parameter" disabled="@secured">@T("Source.Parameter")</option><option value="@ModelProviderValueBindingKind.Secret">@T("Source.Secret")</option></select></label>
                                <div class="contextual-binding-target"><label><span>@T("ExactResource")</span><select @key="TargetValue(binding)" @onchange="args => TargetChanged(binding, args)" data-testid="model-provider-binding-target"><option value="" selected="@(!binding.IsConfigured)">@T("SelectValueSource")</option>@if (!BindingAvailable(binding) && binding.IsConfigured) { <option value="@TargetValue(binding)" selected disabled>@T("UnavailableSelection", binding.ScopeRef, binding.Namespace, binding.Name)</option> }@if (binding.Kind == ModelProviderValueBindingKind.Parameter) { @foreach (var item in AvailableParameters) { <option value="@TargetValue(item)" selected="@(TargetValue(item) == TargetValue(binding))">@item.Definition.DisplayName — @item.ScopeRef/@item.Namespace/@item.Name</option> } } else { @foreach (var item in AvailableSecrets) { <option value="@TargetValue(item.Resource)" selected="@(TargetValue(item.Resource) == TargetValue(binding))">@item.Resource.Definition.DisplayName — @item.Resource.ScopeRef/@item.Resource.Namespace/@item.Resource.Name</option> } }</select></label><button type="button" class="button-secondary" disabled="@(selectedScope is null)" @onclick="() => OpenValueCreator(requirement, binding)" data-testid="model-provider-binding-create">@(binding.Kind == ModelProviderValueBindingKind.Parameter ? T("CreateParameter") : T("CreateSecret"))</button></div>
                            </div>
                            @if (requirement.Required && !binding.IsConfigured) { <p class="inline-warning">@T("RequiredBindingMissing")</p> }
                            @if (binding.Kind == ModelProviderValueBindingKind.Secret) { <p class="inline-info">@T("SecretValueHidden")</p> }
                        </div>
                    }
                </div>
            </section>
        }
        <section class="panel form-section"><div class="panel-header"><div><p class="eyebrow">@T("Connection")</p><h2>@T("ExtensionOwnedEndpoint")</h2><p>@T("ConnectionHelp")</p></div>@if (!IsNew) { <button class="button-secondary" type="button" @onclick="TestAsync" disabled="@testing" data-testid="model-provider-test">@(testing ? T("Testing") : T("TestConnection"))</button> }</div>@if (SelectedExtension is { } selected) { <dl class="resource-details"><dt>@T("AepEndpoint")</dt><dd><code>@selected.Endpoint</code></dd><dt>@T("ExtensionId")</dt><dd><code>@(selected.Extension?.Id ?? T("NotObserved"))</code></dd><dt>@T("Source")</dt><dd>@selected.DiscoverySource</dd></dl> }@if (status is not null) { <p class="@(status.Status == "available" ? "inline-info" : "inline-warning")" data-testid="model-provider-status" data-checked-at="@status.CheckedAt.ToString("O")">@T("LastTest", status.CheckedAt.ToLocalTime().ToString("g")) : @StatusLabel(status.Status)@if (!string.IsNullOrWhiteSpace(status.Details)) { <span> — @status.Details</span> }</p> }</section>
        <div class="form-actions"><a class="button-secondary" href="/modelproviders">@T("Cancel")</a><button class="button-primary" type="submit" disabled="@saving" data-testid="model-provider-save">@(saving ? T("Saving") : IsNew ? T("CreateProviderAction") : T("SaveChanges"))</button></div>
    </EditForm>
    }

    @if (!IsNew && activeTab == ProviderTab.Overview)
    {
        <section class="metric-grid model-provider-summary" aria-label="@T("ProviderSummary")">
            <MetricCard Label="@T("Status")" Value="@(status is null ? T("Status.Unknown") : StatusLabel(status.Status))" Detail="@(status is null ? T("NotObserved") : T("LastTest", status.CheckedAt.ToLocalTime().ToString("g")))" Status="@(status is null ? UiStatus.Neutral : ModelManagementUi.Status(status.Status))" />
            <MetricCard Label="@T("AvailableModels")" Value="@ModelCount(models.Count)" Detail="@T("Discovery")" Status="@(models.Count > 0 ? UiStatus.Success : UiStatus.Neutral)" />
            <MetricCard Label="@T("ModelProfileUsages")" Value="@ProfileCount(usages.Count)" Detail="@T("UsagesHelp")" Status="@(usages.Count > 0 ? UiStatus.Info : UiStatus.Neutral)" />
            <MetricCard Label="@T("ModelProviderContribution")" Value="@model.ContributionId" Detail="@model.ExtensionId" Status="UiStatus.Info" />
        </section>
        <section class="panel resource-section"><div class="panel-header"><div><p class="eyebrow">@T("Discovery")</p><h2>@T("AvailableModels")</h2></div><div class="model-discovery-actions"><span>@ModelCount(models.Count)</span><button class="button-secondary" type="button" @onclick="RefreshModelsAsync" disabled="@refreshing" data-testid="model-provider-refresh">@(refreshing ? T("RefreshingModels") : T("RefreshModels"))</button></div></div>
            @if (modelsError is not null) { <div class="form-alert form-alert-warning">@modelsError</div> }
            @if (discoveryResult is not null) { <div class="form-alert form-alert-success" role="status" data-testid="model-discovery-result">@DiscoverySummary(discoveryResult)</div> }
            @if (models.Count == 0) { <EmptyState Title="@T("NoModelsDiscovered")" Message="@T("NoModelsMessage")" /> }
            else { <DataGrid TItem="AvailableModelResponse" Items="models"><Header><tr><th>@T("Model")</th><th>@T("Status")</th><th>@T("Capabilities")</th><th>@T("Input")</th><th>@T("Output")</th><th>@T("Actions")</th></tr></Header><Row Context="item"><tr><td>@if (!string.IsNullOrWhiteSpace(item.ResourceName)) { <a class="text-button model-details-link" href="@ModelDetailsUrl(item)" data-testid="open-model-details"><strong>@item.DisplayName</strong></a> } else { <strong>@item.DisplayName</strong> }<br /><code>@item.Name</code></td><td><StatusBadge Text="@StatusLabel(item.Status)" Status="@ModelManagementUi.Status(item.Status)" /></td><td>@Features(item)</td><td>@ContentTypes(item.Specification.Input)</td><td>@ContentTypes(item.Specification.Output)</td><td>@if (string.Equals(item.Status, "available", StringComparison.OrdinalIgnoreCase)) { <a class="text-button" href="@CreateModelProfileUrl(item.Name)" data-testid="create-profile-for-model">@T("CreateProfileForModel")</a> }</td></tr></Row></DataGrid> }
        </section>
        @if (usages.Count > 0) { <section class="panel resource-section"><div class="panel-header"><h2>@T("ModelProfileUsages")</h2><span>@usages.Count</span></div><ul class="resource-links">@foreach (var usage in usages) { <li><a href="@ProfileUrl(usage)"><strong>@usage.DisplayName</strong><code>@usage.Name</code></a></li> }</ul></section> }
    }
    </div>
}

<ConfirmationDialog IsOpen="@confirmDelete" Title="@T("DeleteDialogTitle")" Message="@T("DeleteDialogMessage", Name ?? string.Empty)" ConfirmLabel="@T("DeleteDialogConfirm")" OnConfirm="DeleteAsync" OnCancel="() => confirmDelete = false" TestId="model-provider-delete-dialog" />
<ContextualParameterCreator IsOpen="@(creationBinding?.Kind == ModelProviderValueBindingKind.Parameter)" Context="creationContext" OnCreated="ValueCreatedAsync" OnCancel="CloseValueCreator" />
<ContextualSecretCreator IsOpen="@(creationBinding?.Kind == ModelProviderValueBindingKind.Secret)" Context="creationContext" OnCreated="ValueCreatedAsync" OnCancel="CloseValueCreator" />

@code {
    [Parameter] public string? Name { get; set; }
    [SupplyParameterFromQuery(Name = "namespace")] public string? Namespace { get; set; }
    [SupplyParameterFromQuery(Name = "extension")] public string? SuggestedExtension { get; set; }
    [SupplyParameterFromQuery(Name = "extensionNamespace")] public string? SuggestedExtensionNamespace { get; set; }
    [SupplyParameterFromQuery(Name = "contributionId")] public string? SuggestedContributionId { get; set; }
    [SupplyParameterFromQuery(Name = "displayName")] public string? SuggestedDisplayName { get; set; }
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string ModelCount(int count) => T(count == 1 ? "ModelCount.One" : "ModelCount.Many", count);
    private string ProfileCount(int count) => T(count == 1 ? "ProfileCount.One" : "ProfileCount.Many", count);
    private string StatusLabel(string? value) => Localizer[$"Status.{value?.ToLowerInvariant() switch { "available" => "Available", "starting" => "Starting", "unavailable" => "Unavailable", "failed" => "Failed", _ => "Unknown" }}"];
    private readonly CancellationTokenSource cancellation = new();
    private ModelProviderEditorModel? model; private IReadOnlyList<ModelProviderUsageResponse> usages = []; private IReadOnlyList<AvailableModelResponse> models = []; private IReadOnlyList<ExtensionResponse> extensions = [];
    private IReadOnlyList<ParameterResource> parameters = []; private IReadOnlyList<SecretResponse> secrets = [];
    private ModelProviderStatusResponse? status; private ModelDiscoveryDiffResponse? discoveryResult; private AgentstrationApiException? error; private string? modelsError; private string? etag; private bool saving; private bool testing; private bool refreshing; private bool confirmDelete;
    private ModelProviderValueBindingEditorModel? creationBinding;
    private ContextualValueCreationContext? creationContext;
    private ResourceScopeRef? selectedScope;
    private bool hydrated;
    private bool loading;
    private bool interactive => hydrated && !loading;
    private bool persisted;
    private ProviderTab activeTab;
    private bool IsNew => !persisted;
    private ExtensionResponse? SelectedExtension => model is null ? null : extensions.SingleOrDefault(value => ExtensionKey(value) == model.ExtensionId);
    private IReadOnlyList<ExtensionContributionResponse> Contributions => SelectedExtension?.Contributions.Where(value => value.Kind == "model-provider").ToArray() ?? [];
    private IReadOnlyList<ExtensionValueRequirementResponse> Requirements => (SelectedExtension?.ValueRequirements ?? [])
        .Where(value => value.ContributionKind == "model-provider" && value.ContributionId.Equals(model?.ContributionId, StringComparison.OrdinalIgnoreCase)).ToArray();
    private IReadOnlyList<ParameterResource> AvailableParameters => parameters.Where(CanUse).ToArray();
    private IReadOnlyList<SecretResponse> AvailableSecrets => secrets.Where(value => value.ValueConfigured && CanUse(value.Resource)).ToArray();
    private ResourceNamespace SelectedNamespace => ResourceNamespace.Parse(Namespace);
    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        persisted = !string.IsNullOrWhiteSpace(Name);
        try { await LoadAsync(); }
        finally { loading = false; }
    }
    protected override void OnAfterRender(bool firstRender) { if (!firstRender) return; hydrated = true; StateHasChanged(); }
    private async Task LoadAsync()
    {
        error = null;
        modelsError = null;
        try
        {
            var loadedExtensions = await ExtensionsClient.GetExtensionsAsync(cancellation.Token);
            var loadedParameters = await ParametersClient.GetParametersAsync(cancellation.Token);
            var loadedSecrets = await SecretsClient.GetSecretsAsync(cancellation.Token);
            if (IsNew)
            {
                extensions = loadedExtensions;
                parameters = loadedParameters;
                secrets = loadedSecrets;
                var extensionNamespace = SuggestedExtensionNamespace ?? SelectedNamespace.Value;
                model = new ModelProviderEditorModel { Namespace = SelectedNamespace.Value, ExtensionId = string.IsNullOrWhiteSpace(SuggestedExtension) ? string.Empty : $"{extensionNamespace}:{SuggestedExtension}", ContributionId = SuggestedContributionId ?? string.Empty, DisplayName = SuggestedDisplayName ?? string.Empty };
                SyncBindings();
                return;
            }

            var snapshot = await Client.GetModelProviderAsync(SelectedNamespace, Name!, cancellation.Token);
            var loadedUsages = (await Client.GetModelProviderUsagesAsync(SelectedNamespace, Name!, cancellation.Token)).Value;
            extensions = loadedExtensions;
            parameters = loadedParameters;
            secrets = loadedSecrets;
            model = ModelProviderEditorModel.FromResource(snapshot.Value);
            selectedScope = snapshot.Value.ScopeRef;
            etag = snapshot.ETag;
            usages = loadedUsages;
            SyncBindings();
            await LoadObservedAsync();
        }
        catch (AgentstrationApiException exception)
        {
            error = exception;
            model ??= new ModelProviderEditorModel { Namespace = SelectedNamespace.Value };
        }
    }
    private void ExtensionChanged(ChangeEventArgs args) { if (model is null) return; model.ExtensionId = args.Value?.ToString() ?? string.Empty; if (!Contributions.Any(value => value.Id == model.ContributionId)) model.ContributionId = Contributions.Count == 1 ? Contributions[0].Id : string.Empty; SyncBindings(); }
    private void ContributionChanged(ChangeEventArgs args) { if (model is null) return; model.ContributionId = args.Value?.ToString() ?? string.Empty; SyncBindings(); }
    private async Task LoadObservedAsync() { if (model is null) return; var @namespace = ResourceNamespace.Parse(model.Namespace); try { status = await Client.GetProviderStatusAsync(@namespace, model.Name, cancellation.Token); models = await Client.GetProviderModelsAsync(@namespace, model.Name, cancellation.Token); } catch (AgentstrationApiException exception) { modelsError = exception.Message; models = []; } }
    private async Task SaveAsync() { if (model is null || saving) return; saving = true; error = null; try { var wasNew = IsNew; var @namespace = ResourceNamespace.Parse(model.Namespace); var snapshot = wasNew ? await Client.CreateModelProviderAsync(model.ToCreateRequest() with { ScopeRef = selectedScope }, cancellation.Token) : await Client.UpdateModelProviderAsync(@namespace, model.Name, model.ToPutRequest(), etag!, cancellation.Token); Notifications.Add(new NotificationItem(Guid.NewGuid(), wasNew ? T("CreatedNotification") : T("UpdatedNotification"), snapshot.Value.Name, DateTimeOffset.Now, UiStatus.Success)); model = ModelProviderEditorModel.FromResource(snapshot.Value); selectedScope = snapshot.Value.ScopeRef; etag = snapshot.ETag; SyncBindings(); if (wasNew) { discoveryResult = await DiscoverAfterCreationAsync(snapshot.Value); await LoadObservedAsync(); Navigation.NavigateTo(DetailsUrl(snapshot.Value.Namespace, snapshot.Value.Name)); model = ModelProviderEditorModel.FromResource(snapshot.Value); selectedScope = snapshot.Value.ScopeRef; etag = snapshot.ETag; SyncBindings(); persisted = true; } else { await LoadObservedAsync(); } } catch (ArgumentException exception) { error = new AgentstrationApiException(exception.Message, Guid.NewGuid().ToString("N")); } catch (AgentstrationApiException exception) { error = exception; } finally { saving = false; } }
    private async Task TestAsync() { if (model is null || testing) return; testing = true; error = null; try { status = await Client.TestProviderAsync(ResourceNamespace.Parse(model.Namespace), model.Name, cancellation.Token); await LoadObservedAsync(); } catch (AgentstrationApiException exception) { error = exception; } finally { testing = false; } }
    private async Task<ModelDiscoveryDiffResponse?> DiscoverAfterCreationAsync(ModelProviderResource created)
    {
        try
        {
            var result = await Client.RefreshProviderModelsAsync(created.Namespace, created.Name, cancellation.Token);
            Notifications.Add(new NotificationItem(Guid.NewGuid(), T("InitialDiscoveryComplete"), DiscoverySummary(result), DateTimeOffset.Now, UiStatus.Success));
            return result;
        }
        catch (AgentstrationApiException exception)
        {
            Notifications.Add(new NotificationItem(Guid.NewGuid(), T("InitialDiscoveryFailed"), exception.Message, DateTimeOffset.Now, UiStatus.Warning));
            return null;
        }
    }
    private async Task RefreshModelsAsync()
    {
        if (model is null || refreshing) return;
        refreshing = true;
        modelsError = null;
        discoveryResult = null;
        try
        {
            discoveryResult = await Client.RefreshProviderModelsAsync(ResourceNamespace.Parse(model.Namespace), model.Name, cancellation.Token);
            await LoadObservedAsync();
            Notifications.Add(new NotificationItem(Guid.NewGuid(), T("DiscoveryRefreshed"), DiscoverySummary(discoveryResult), DateTimeOffset.Now, UiStatus.Success));
        }
        catch (AgentstrationApiException exception) { modelsError = exception.Message; }
        finally { refreshing = false; }
    }
    private string DiscoverySummary(ModelDiscoveryDiffResponse result) => T("DiscoverySummary", result.Created, result.Updated, result.Unchanged, result.Missing, result.Reappeared, result.Total);
    private void RequestDelete() { if (usages.Count == 0) confirmDelete = true; else error = new AgentstrationApiException(T("ProviderUsedBy", ProfileCount(usages.Count)), Guid.NewGuid().ToString("N")); }
    private async Task DeleteAsync() { if (model is null || etag is null) return; confirmDelete = false; try { await Client.DeleteModelProviderAsync(ResourceNamespace.Parse(model.Namespace), model.Name, etag, cancellation.Token); Navigation.NavigateTo("/modelproviders"); } catch (AgentstrationApiException exception) { error = exception; } }
    private void SyncBindings()
    {
        if (model is null) return;
        var existing = model.ValueBindings.ToDictionary(value => value.RequirementId, StringComparer.Ordinal);
        model.ValueBindings = Requirements.Select(requirement =>
        {
            var binding = existing.GetValueOrDefault(requirement.Id) ?? new ModelProviderValueBindingEditorModel { RequirementId = requirement.Id };
            if (IsSecured(requirement) && binding.Kind == ModelProviderValueBindingKind.Parameter)
            {
                binding.Kind = ModelProviderValueBindingKind.Secret;
                binding.Name = binding.Namespace = binding.ScopeRef = string.Empty;
            }
            return binding;
        }).ToList();
    }
    private ModelProviderValueBindingEditorModel Binding(ExtensionValueRequirementResponse requirement) =>
        model!.ValueBindings.Single(value => value.RequirementId == requirement.Id);
    private static bool IsSecured(ExtensionValueRequirementResponse requirement) =>
        requirement.Protection.Equals("secured", StringComparison.OrdinalIgnoreCase);
    private void SourceChanged(ModelProviderValueBindingEditorModel binding, ChangeEventArgs args)
    {
        if (Enum.TryParse<ModelProviderValueBindingKind>(args.Value?.ToString(), out var kind)) binding.Kind = kind;
        binding.Name = binding.ScopeRef = string.Empty;
        binding.Namespace = ResourceNamespace.DefaultValue;
    }
    private void TargetChanged(ModelProviderValueBindingEditorModel binding, ChangeEventArgs args)
    {
        var value = args.Value?.ToString() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(value)) { binding.Name = binding.ScopeRef = string.Empty; return; }
        Resource? resource = binding.Kind == ModelProviderValueBindingKind.Parameter
            ? AvailableParameters.FirstOrDefault(candidate => TargetValue(candidate) == value)
            : AvailableSecrets.Select(candidate => candidate.Resource).FirstOrDefault(candidate => TargetValue(candidate) == value);
        if (resource?.ScopeRef is not { } scopeRef) return;
        binding.Name = resource.Name;
        binding.Namespace = resource.Namespace.Value;
        binding.ScopeRef = scopeRef.Value;
    }
    private void OpenValueCreator(ExtensionValueRequirementResponse requirement, ModelProviderValueBindingEditorModel binding)
    {
        if (selectedScope is not { } scopeRef) return;
        creationBinding = binding;
        var consumerName = !string.IsNullOrWhiteSpace(model?.Name) ? model.Name : model?.ContributionId ?? "provider";
        var consumerDisplayName = !string.IsNullOrWhiteSpace(model?.DisplayName) ? model.DisplayName : consumerName;
        var suggestedName = SecretEditorModel.IdentifierFromDisplayName($"mp-{consumerName}-{requirement.Id}");
        creationContext = new ContextualValueCreationContext(
            scopeRef,
            suggestedName,
            $"{consumerDisplayName} — {requirement.Id}",
            requirement.Description,
            ResourceNamespace.Default,
            ParameterType(requirement.ValueType),
            requirement.Format,
            requirement.AllowedValues);
    }
    private async Task ValueCreatedAsync(ScopedResourceAddress address)
    {
        if (creationBinding is null) return;
        creationBinding.Name = address.Name;
        creationBinding.Namespace = address.Namespace.Value;
        creationBinding.ScopeRef = address.ScopeRef.Value;
        if (creationBinding.Kind == ModelProviderValueBindingKind.Parameter)
            parameters = await ParametersClient.GetParametersAsync(cancellation.Token);
        else
            secrets = await SecretsClient.GetSecretsAsync(cancellation.Token);
        CloseValueCreator();
    }
    private void CloseValueCreator() { creationBinding = null; creationContext = null; }
    private static ParameterValueType? ParameterType(string valueType) => valueType.ToLowerInvariant() switch
    {
        "string" => ParameterValueType.Text,
        "integer" => ParameterValueType.WholeNumber,
        "number" => ParameterValueType.DecimalNumber,
        "boolean" => ParameterValueType.Logical,
        _ => null
    };
    private bool BindingAvailable(ModelProviderValueBindingEditorModel binding) => binding.Kind == ModelProviderValueBindingKind.Parameter
        ? AvailableParameters.Any(value => TargetValue(value) == TargetValue(binding))
        : AvailableSecrets.Any(value => TargetValue(value.Resource) == TargetValue(binding));
    private static string TargetValue(Resource resource) => resource.ScopeRef is { } scope
        ? $"{scope.Value}|{resource.Namespace.Value}|{resource.Name}"
        : string.Empty;
    private static string TargetValue(ModelProviderValueBindingEditorModel binding) => binding.IsConfigured
        ? $"{binding.ScopeRef}|{binding.Namespace}|{binding.Name}"
        : string.Empty;
    private bool CanUse(ParameterResource resource) => resource.ScopeRef is { } owner
        && CanUse(owner, resource.Definition.UsePolicy);
    private bool CanUse(SecretResource resource) => resource.ScopeRef is { } owner
        && CanUse(owner, resource.Definition.UsePolicy);
    private bool CanUse(ResourceScopeRef owner, DescendantUsePolicy policy)
    {
        if (selectedScope is not { } consumer) return false;
        if (owner == consumer) return true;
        if (owner.Kind >= consumer.Kind) return false;
        return policy.Grants.Any(grant => grant.ScopeRef == consumer
            || grant.IncludeDescendants && grant.ScopeRef.Kind < consumer.Kind);
    }
    private string ContentTypes(IReadOnlyList<ModelContentType>? values) => values is null || values.Count == 0
        ? T("NotReported")
        : string.Join(" · ", values.Select(value => value.ToString()));
    private string Features(AvailableModelResponse item)
    {
        var features = new List<string>();
        if (IsSupported(item.Specification.Features.Streaming?.Support)) features.Add("Streaming");
        if (IsSupported(item.Specification.Features.Tools?.Support)) features.Add("Tools");
        if (IsSupported(item.Specification.Features.StructuredOutput?.Support)) features.Add("Structured output");
        if (IsSupported(item.Specification.Features.Reasoning?.Support)) features.Add("Reasoning");
        return features.Count == 0 ? T("NotReported") : string.Join(" · ", features);
    }
    private static bool IsSupported(ModelFeatureSupport? support) => support is
        ModelFeatureSupport.Native or ModelFeatureSupport.Emulated or ModelFeatureSupport.Partial;
    private static string ProfileUrl(ModelProviderUsageResponse usage) => $"/modelprofiles/{Uri.EscapeDataString(usage.Name)}";
    private string ModelDetailsUrl(AvailableModelResponse item) => ConsoleResourceUrls.Model(
        ResourceAddress.Create(ResourceNamespace.Parse(model?.Namespace), ModelResourceKinds.Model, item.ResourceName!));
    private string CreateModelProfileUrl(string? modelName = null)
    {
        var providerNamespace = ResourceNamespace.Parse(model?.Namespace ?? Namespace).Value;
        var providerName = model?.Name ?? Name ?? string.Empty;
        return $"/modelprofiles/new?namespace={Uri.EscapeDataString(providerNamespace)}&provider={Uri.EscapeDataString(providerName)}&providerNamespace={Uri.EscapeDataString(providerNamespace)}"
            + (modelName is null ? string.Empty : $"&model={Uri.EscapeDataString(modelName)}");
    }
    private static string DetailsUrl(ResourceNamespace @namespace, string name) => $"/modelproviders/{Uri.EscapeDataString(name)}?namespace={Uri.EscapeDataString(@namespace.Value)}";
    private static string ExtensionKey(ExtensionResponse extension) => $"{extension.RegistrationNamespace}:{extension.RegistrationName}";
    private enum ProviderTab { Overview, Configuration }
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
