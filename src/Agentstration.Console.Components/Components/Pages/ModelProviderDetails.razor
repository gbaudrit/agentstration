    {
        var matches = extensions.Where(value => ExtensionKey(value) == key && (value.RegistrationScopeRef is null || value.RegistrationScopeRef == ResourceScopeRef.Instance)).ToArray();
        if (owner is { } scope) return matches.SingleOrDefault(value => value.RegistrationScopeRef == scope) ?? (matches.Length == 1 && matches[0].RegistrationScopeRef is null ? matches[0] : null);
        return matches.Length == 1 ? matches[0] : null;
