        SectionState="sectionState" SectionPresentations="presentations" AdditionalSections="AdditionalSections" LoadState="loadState" OnRetry="RetryAsync" OnRefresh="RefreshAsync" Busy="@Busy"
        DefinitionReadOnlyReason="@(CanWrite ? null : ResourceReadOnlyReason.InsufficientPermissions)" HasDraft="HasDraft" HasAdditionalDraft="@(creators.Count > 0)"
        Yaml="@(resource is null ? string.Empty : ResourceManifestSerializer.ToYaml(resource))" SectionTestIdPrefix="model-provider-details" TestId="resource-model-provider-editor">
