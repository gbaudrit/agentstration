            if ((removeOld || !binding.IsConfigured) && IsSecured(requirement) && binding.Kind != ModelProviderValueBindingKind.Secret) { binding.Kind = ModelProviderValueBindingKind.Secret; binding.Name = binding.ScopeRef = string.Empty; binding.Namespace = ResourceNamespace.DefaultValue; binding.Literal = null; }
        }
