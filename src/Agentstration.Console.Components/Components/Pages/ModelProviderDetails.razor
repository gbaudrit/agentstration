    private RenderFragment Identity { get { var value = model!; return @<ResourceIdentityEditor ResourceKind="@ModelResourceKinds.ModelProvider" DisplayName="@value.DisplayName" DisplayNameChanged="changed => value.DisplayName = changed" DisplayNameExpression="@(() => value.DisplayName)"
        TechnicalName="@value.Name" TechnicalNameChanged="changed => value.Name = changed" TechnicalNameExpression="@(() => value.Name)" Namespace="@value.Namespace" NamespaceChanged="changed => value.Namespace = changed" NamespaceExpression="@(() => value.Namespace)" NamespaceEditable="IsNew"
        ScopeRef="value.ScopeRef" ScopeRefChanged="changed => value.ScopeRef = changed" ScopeTargets="scopeTargets" IsNew="IsNew" ReadOnly="@(!CanManage)" Description="@value.Description" DescriptionExpression="@(() => value.Description)" DescriptionReadOnly="true" Labels="@value.Tags" LabelsExpression="@(() => value.Tags)" LabelsReadOnly="true"
        DisplayNameTestId="model-provider-display-name" TechnicalNameTestId="model-provider-name" TestId="model-provider-identity-editor">
        <ScopeValidation><ValidationMessage For="() => value.ScopeRef" /></ScopeValidation>
        <AdditionalPanels><FormSection Title="@T("ProviderResource")"><FormGrid>
            <FormField Label="@T("ExtensionRegistration")" Required><Validation><ValidationMessage For="() => value.ExtensionId" /></Validation><ChildContent><ClearableSelect TValue="string" Value="@value.ExtensionId" ValueExpression="@(() => value.ExtensionId)" ValueChanged="ExtensionChanged" data-testid="model-provider-extension"><option value="">@T("SelectExtension")</option>@if (!extensions.Any(item => ExtensionKey(item) == value.ExtensionId) && !string.IsNullOrEmpty(value.ExtensionId)) { <option value="@value.ExtensionId" disabled>@value.ExtensionId</option> }@foreach (var extension in extensions.Where(item => item.RegistrationScopeRef is null || item.RegistrationScopeRef == ResourceScopeRef.Instance)) { <option @key="extension" value="@ExtensionKey(extension)">@extension.RegistrationNamespace/@extension.RegistrationName — @(extension.Extension?.Name ?? extension.RegistrationName)</option> }</ClearableSelect></ChildContent></FormField>
            <FormField Label="@T("ModelProviderContribution")" Required><Validation><ValidationMessage For="() => value.ContributionId" /></Validation><ChildContent><ClearableSelect TValue="string" Value="@value.ContributionId" ValueExpression="@(() => value.ContributionId)" ValueChanged="ContributionChanged" data-testid="model-provider-contribution"><option value="">@T("SelectContribution")</option>@if (!Contributions.Any(item => item.Id == value.ContributionId) && !string.IsNullOrEmpty(value.ContributionId)) { <option value="@value.ContributionId" disabled>@value.ContributionId</option> }@foreach (var contribution in Contributions) { <option @key="contribution.Id" value="@contribution.Id">@contribution.Id</option> }</ClearableSelect></ChildContent></FormField>
        </FormGrid></FormSection></AdditionalPanels>
    </ResourceIdentityEditor>; } }
    private RenderFragment Configuration { get { var value = model!; return @<div class="resource-editor-view">
        @if (Requirements.Count > 0) { <FormSection Title="@T("ValueBindings")" Description="@T("ValueBindingsHelp")" TestId="model-provider-value-bindings"><div class="binding-requirements">@foreach (var requirement in Requirements) { var binding = Binding(requirement); <ValueBindingRequirementEditor @key="binding" Requirement="@RequirementModel(requirement)" AllowedSources="@BindingSources(requirement)" Options="@BindingOptions(requirement)" Selection="@BindingSelection(binding)" SelectionChanged="selection => BindingChangedAndNotify(binding, selection)" CreationContext="@CreationContext(requirement)" ResourceCreated="ValueCreatedAsync" CreationChanged="open => CreatorChanged(binding, open)" ValidationField="@(new FieldIdentifier(value, nameof(value.ValueBindings)))" Disabled="@(!CanManage || saving || catalogueForbidden)" TestIdPrefix="model-provider" DialogSectionId="binding" /> }</div></FormSection> }
        <FormSection Title="@T("ExtensionOwnedEndpoint")" Description="@T("ConnectionHelp")">@if (SelectedExtension is { } selected) { <dl class="resource-details"><dt>@T("AepEndpoint")</dt><dd><code class="configuration-value">@selected.Endpoint</code></dd><dt>@T("ExtensionId")</dt><dd><code>@(selected.Extension?.Id ?? T("NotObserved"))</code></dd><dt>@T("Source")</dt><dd>@selected.DiscoverySource</dd></dl> }@if (status is not null) { <p data-testid="model-provider-status" data-checked-at="@status.CheckedAt.ToString("O")">@T("LastTest", status.CheckedAt.ToLocalTime().ToString("g")) : @StatusLabel(status.Status) @status.Details</p> }</FormSection>
    </div>; } }
    private RenderFragment DefinitionSection(string path) => path switch { "definition/identity" => Identity, "definition/configuration" => Configuration, _ => throw new ArgumentOutOfRangeException(nameof(path)) };
    private RenderFragment TestActions => @<button class="button-secondary" type="button" disabled="@Busy" @onclick="TestAsync" data-testid="model-provider-test">@(testing ? T("Testing") : T("TestConnection"))</button>;
    private RenderFragment DiscoveryActions => @<button class="button-secondary" type="button" disabled="@(Busy || DiscoveryPending || !CanOperate)" @onclick="RefreshModelsAsync" data-testid="model-provider-refresh">@(refreshing || DiscoveryPending ? T("RefreshingModels") : T("RefreshModels"))</button>;
    private bool IdentityComplete => model is not null && model.ScopeRef == ResourceScopeRef.Instance
        && System.ComponentModel.DataAnnotations.Validator.TryValidateObject(model, new(model), null, validateAllProperties: true);
    private bool ConfigurationComplete => model is not null && !invalidInput
        && model.MissingRequiredBindings(Requirements.Where(item => item.Required).Select(item => item.Id)).Count == 0;
    private IReadOnlyList<CreationWizardStep> CreationSteps =>
    [
        new("identity", Shared["Identity"], Identity) { IsComplete = IdentityComplete },
        new("configuration", Shared["Configuration"], Configuration) { IsComplete = ConfigurationComplete },
        new("review", Shared["Verification"], Review) { IsComplete = IdentityComplete && ConfigurationComplete }
    ];
    private RenderFragment Review => @<FormSection Title="@Shared["Verification"]"><dl class="resource-details"><dt>@IdentityLabels["DisplayName"]</dt><dd>@model?.DisplayName</dd><dt>@IdentityLabels["TechnicalName"]</dt><dd><code>@model?.Namespace/@model?.Name</code></dd><dt>@T("ExtensionRegistration")</dt><dd><code>@model?.ExtensionId</code></dd><dt>@T("ModelProviderContribution")</dt><dd><code>@model?.ContributionId</code></dd></dl></FormSection>;
    private RenderFragment AdditionalContent(string path) => path switch { "models" => ModelsPanel, "usages" => UsagesPanel, _ => throw new ArgumentOutOfRangeException(nameof(path)) };
    private RenderFragment ModelsPanel => @<FormSection Title="@T("AvailableModels")">
        <p role="status" data-testid="model-discovery-state">@DiscoveryStateLabel</p>
        @if (status?.Discovery?.State == "failed") { <div class="form-alert form-alert-warning" role="status">@T(status.Discovery.ErrorCode == "discovery_timeout" ? "Discovery.Timeout" : "Discovery.Failure") @if (status.Discovery.NextAttemptAt is { } nextAttempt) { @T("Discovery.RetryAt", nextAttempt.ToLocalTime().ToString("g")) }</div> }
        @if (modelsError is not null) { <p role="alert">@modelsError</p> }@if (discoveryResult is not null) { <p role="status" data-testid="model-discovery-result">@DiscoverySummary(discoveryResult)</p> }@if (!modelsKnown) { <p>@T("ObservationUnavailable")</p> } else if (models.Count == 0) { <EmptyState Title="@T("NoModelsDiscovered")" Message="@T("NoModelsMessage")" /> } else { <CollectionView TItem="AvailableModelResponse" Items="models" IdentityLabel="@T("Model")" InformationLabels="@(new[] { T("Capabilities"), T("Input"), T("Output") })"><Identity Context="item"><CollectionIdentity DisplayName="@item.DisplayName" Namespace="@(item.ResourceName is null ? null : resource?.Namespace.Value)" Name="@(item.ResourceName ?? item.Name)" Href="@(item.ResourceName is null ? null : ModelDetailsUrl(item))" IconName="layers" Domain="model" data-testid="open-model-details"><IconBadges>@if (item.ResourceName is not null) { <ResourceScopeBadge ScopeRef="resource?.ScopeRef" IconOnly /><ManagedResourceBadge IsReadOnly="@(!ResourceOwnershipContext.CanManage(resource?.ScopeRef, Services))" IconOnly /> }<StatusBadge Text="@StatusLabel(item.Status)" Status="@ModelManagementUi.Status(item.Status)" IconOnly /></IconBadges></CollectionIdentity><code>@item.Name</code></Identity><Information Context="item"><CollectionValue Label="@T("Capabilities")">@Features(item)</CollectionValue><CollectionValue Label="@T("Input")">@ContentTypes(item.Specification.Input)</CollectionValue><CollectionValue Label="@T("Output")">@ContentTypes(item.Specification.Output)</CollectionValue></Information><Actions Context="item">@if (CanWrite && item.Status.Equals("available", StringComparison.OrdinalIgnoreCase)) { <CollectionActions ResourceName="@item.DisplayName"><Primary><a class="button-secondary" href="@CreateModelProfileUrl(item.Name)" data-testid="create-profile-for-model">@T("CreateProfileForModel")</a></Primary></CollectionActions> }</Actions></CollectionView> }</FormSection>;
    private RenderFragment UsagesPanel => @<FormSection Title="@T("ModelProfileUsages")">@if (!usagesKnown) { <p>@T("UsagesUnavailable")</p> } else if (usages.Count == 0) { <p>@T("UsagesHelp")</p> } else { <CollectionView TItem="ModelProviderUsageResponse" Items="usages" IdentityLabel="@T("ModelProfileUsages")" InformationLabels="Array.Empty<string>()"><Identity Context="usage">@if (usage.Namespace is { } ns && usage.ScopeRef is { } owner) { <CollectionIdentity DisplayName="@usage.DisplayName" Namespace="@ns.Value" Name="@usage.Name" Href="@ResourceOwnershipContext.Resource(Services, "/modelprofiles", usage.Name, ns, owner)" IconName="layers" Domain="model"><IconBadges><ResourceScopeBadge ScopeRef="owner" IconOnly /></IconBadges></CollectionIdentity> } else { <strong>@usage.DisplayName</strong><code>@usage.Name</code> }</Identity><Information Context="usage"></Information></CollectionView> }</FormSection>;
    private sealed record ProviderBundle(ResourceSnapshot<ModelProviderResource> Snapshot, IReadOnlyList<ExtensionResponse> Extensions, IReadOnlyList<ParameterResource> Parameters, IReadOnlyList<SecretResponse> Secrets, IReadOnlyList<ResourceScopeTargetResponse> Targets, IReadOnlyList<ModelProviderUsageResponse> Usages, ModelProviderStatusResponse? Status, IReadOnlyList<AvailableModelResponse> Models, bool ModelsKnown, bool UsagesKnown, string? ObservationError, string? CatalogueWarning, bool CatalogueForbidden = false);
    protected override Task OnParametersSetAsync()
    {
        var key = ContextKey;
        if (key == loadedKey) return Task.CompletedTask;
        loadedKey = key; persisted = !string.IsNullOrWhiteSpace(Name); ClearPrivate(); sectionState.Reset(key);
        return LoadAsync(false);
    }
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) { hydrated = true; observationPolling = PollObservationsAsync(); StateHasChanged(); }
        if (pendingNavigation is { } target) { pendingNavigation = null; Navigation.NavigateTo(target); }
    }
    private void ClearPrivate()
    {
        model = null; resource = null; editContext = null; messages = null; baseline = etag = null; baselineBundle = newerBundle = null;
        extensions = []; parameters = []; secrets = []; scopeTargets = []; usages = []; models = []; creators.Clear();
        status = null; discoveryResult = null; error = null; modelsError = catalogueWarning = null;
        saving = testing = refreshing = confirmDelete = invalidInput = touched = modelsKnown = usagesKnown = catalogueForbidden = false;
    }
    private Task RetryAsync() => Busy ? Task.CompletedTask : LoadAsync(resource is not null);
    private Task RefreshAsync() => Busy ? Task.CompletedTask : LoadAsync(true);
    private async Task LoadAsync(bool refresh)
    {
        var request = ++loadVersion; var expected = resource; var requestedName = Name; var requestedNamespace = ResourceNamespace.Default;
        loading = true; loadState = new(refresh && resource is not null ? ResourceLoadStatus.Refreshing : ResourceLoadStatus.Loading) { HasContent = resource is not null };
        try
        {
            requestedNamespace = SelectedNamespace;
            if (IsNew)
            {
                using var metadataDeadline = new CancellationTokenSource(TimeSpan.FromSeconds(3), Clock);
                using var metadataCancellation = CancellationTokenSource.CreateLinkedTokenSource(cancellation.Token, metadataDeadline.Token);
                IReadOnlyList<ExtensionResponse> loadedExtensions = [];
                try { loadedExtensions = await ExtensionsClient.GetExtensionsAsync(metadataCancellation.Token); }
                catch (AgentstrationApiException exception) when (exception.StatusCode is System.Net.HttpStatusCode.Forbidden or System.Net.HttpStatusCode.Unauthorized) { throw; }
                catch (OperationCanceledException) when (!cancellation.IsCancellationRequested) { catalogueWarning = T("MetadataUnavailable"); }
                catch (Exception exception) when (exception is HttpRequestException or AgentstrationApiException) { catalogueWarning = T("MetadataUnavailable"); }
                if (request != loadVersion) return;
                var loadedParameters = await ParametersClient.GetParametersAsync(cancellation.Token); if (request != loadVersion) return;
                var loadedSecrets = await SecretsClient.GetSecretsAsync(cancellation.Token); if (request != loadVersion) return;
                var targets = await Scopes.GetTargetsAsync(ModelResourceKinds.ModelProvider, cancellation.Token); if (request != loadVersion) return;
                extensions = loadedExtensions; parameters = loadedParameters; secrets = loadedSecrets;
                scopeTargets = targets.Where(target => target.Kind == ResourceScopeKind.Instance).ToArray();
                model = new() { Namespace = requestedNamespace.Value, ScopeRef = scopeTargets.FirstOrDefault(target => target.CanWrite)?.ScopeRef,
                    ExtensionId = string.IsNullOrWhiteSpace(SuggestedExtension) ? string.Empty : $"{SuggestedExtensionNamespace ?? requestedNamespace.Value}:{SuggestedExtension}", ContributionId = SuggestedContributionId ?? string.Empty, DisplayName = SuggestedDisplayName ?? string.Empty };
                model.ExtensionScopeRef = SelectedExtension?.RegistrationScopeRef; SyncBindings(false); ResetForm();
                loadState = new(ResourceLoadStatus.Ready) { HasContent = true }; return;
            }
            var snapshot = string.IsNullOrWhiteSpace(ScopeRefValue)
                ? await Client.GetModelProviderAsync(requestedNamespace, requestedName!, cancellation.Token)
                : await Client.GetModelProviderAsync(requestedNamespace, requestedName!, ResourceScopeRef.Parse(ScopeRefValue), cancellation.Token);
            if (request != loadVersion) return;
            if (!Matches(snapshot.Value, requestedNamespace, requestedName!, expected)) { ClearPrivate(); loadState = new(ResourceLoadStatus.NotFound); return; }
            var bundle = await ReadBundleAsync(snapshot, request);
            if (request != loadVersion) return;
            if (HasDraft || creators.Count > 0)
            {
