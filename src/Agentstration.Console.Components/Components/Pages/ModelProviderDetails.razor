        binding.IsConfigured && binding.Kind != ModelProviderValueBindingKind.Literal
            ? ScopedResourceAddress.Create(ResourceScopeRef.Parse(binding.ScopeRef), ResourceNamespace.Parse(binding.Namespace),
                binding.Kind == ModelProviderValueBindingKind.Parameter ? ParameterResourceKinds.Parameter : SecretResourceKinds.Secret, binding.Name)
            : null,
        binding.Literal);
