                if (baselineBundle is not null) baselineBundle = baselineBundle with { Extensions = extensions, Parameters = parameters, Secrets = secrets, Targets = scopeTargets, CatalogueWarning = null, CatalogueForbidden = false };
                if (newerBundle is not null) newerBundle = newerBundle with { Extensions = extensions, Parameters = parameters, Secrets = secrets, Targets = scopeTargets, CatalogueWarning = null, CatalogueForbidden = false };
