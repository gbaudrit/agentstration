            var targets = (await Scopes.GetTargetsAsync(ModelResourceKinds.ModelProvider, linked.Token)).Where(target => target.Kind == ResourceScopeKind.Instance).ToArray();
            if (request != loadVersion || cancellation.IsCancellationRequested || resource is null || !Matches(resource, saved.Namespace, saved.Name, saved)) return;
