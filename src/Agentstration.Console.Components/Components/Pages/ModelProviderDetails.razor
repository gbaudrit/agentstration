    private IReadOnlyDictionary<string, string> FieldLabels => new Dictionary<string, string>(StringComparer.Ordinal)
    {
        [nameof(ModelProviderEditorModel.Name)] = IdentityLabels["TechnicalName"], [nameof(ModelProviderEditorModel.Namespace)] = T("Namespace"), [nameof(ModelProviderEditorModel.DisplayName)] = IdentityLabels["DisplayName"],
        [nameof(ModelProviderEditorModel.Description)] = Shared["Description"], [nameof(ModelProviderEditorModel.Tags)] = Shared["Labels"], [nameof(ModelProviderEditorModel.ScopeRef)] = Shared["Scope"],
        [nameof(ModelProviderEditorModel.ExtensionId)] = T("ExtensionRegistration"), [nameof(ModelProviderEditorModel.ExtensionScopeRef)] = Shared["Scope"], [nameof(ModelProviderEditorModel.ContributionId)] = T("ModelProviderContribution"),
        [nameof(ModelProviderEditorModel.ValueBindings)] = T("ValueBindings"), [nameof(ModelProviderEditorModel.SpecificationOverrides)] = T("SpecificationOverrides")
