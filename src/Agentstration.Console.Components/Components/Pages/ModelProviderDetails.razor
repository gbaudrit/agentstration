                {
                    extensions = []; parameters = []; secrets = []; scopeTargets = []; creators.Clear(); catalogueForbidden = true;
                    if (baselineBundle is not null) baselineBundle = baselineBundle with { Extensions = [], Parameters = [], Secrets = [], Targets = [], CatalogueForbidden = true, CatalogueWarning = catalogueWarning };
