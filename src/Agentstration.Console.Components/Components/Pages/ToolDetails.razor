@page "/tools/{Name}"
@implements IDisposable
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@inject Microsoft.Extensions.Localization.IStringLocalizer<ResourceIdentityFieldsStrings> IdentityLabels
@inject IToolsClient Client
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<ToolDetailsStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<ToolsStrings> ToolLabels

<PageTitle>@(tool?.Definition.DisplayName ?? Name) · Agentstration</PageTitle>
@{ var presentations = Presentations; }
<ConsoleResourceDetailsTemplate Resource="tool" Name="@(tool?.Definition.DisplayName ?? Name)" ResourceType="@T("Tool")" Domain="tool" IconName="wrench" Description="@tool?.Definition.Description" CollectionHref="@ResourceOwnershipContext.PreserveNavigation("/tools", Services)" CollectionLabel="@ToolLabels["Title"]"
    StatusText="@(tool?.Definition.Discovery is { } discovery ? AvailabilityLabel(discovery.Available) : null)" Status="@(tool?.Definition.Discovery?.Available == true ? UiStatus.Success : tool?.Definition.Discovery is null ? UiStatus.Neutral : UiStatus.Warning)"
    Enabled="@(operational?.Enabled ?? tool?.Definition.Enabled)" EnabledChanged="ToggleAsync" EnabledDisabled="@(!CanWrite || toggling || refreshing)" OperationalActivation="true" EnabledTestId="tool-enabled-toggle"
    ResourceIdentity="@(loadedKey ?? Name)" SectionState="sectionState" SectionPresentations="presentations" AdditionalSections="AdditionalSections" SelectionChanged="SelectSection"
    LoadState="loadState" OnRetry="RetryAsync" OnRefresh="RefreshAsync" Busy="@(toggling || submitting)" Yaml="@SavedYaml" TestId="resource-tool-details" SectionTestIdPrefix="tool">
    <Actions>@if (CanWrite) { <a class="button-secondary" href="@NewDefinitionUrl">@T("NewDefinition")</a> }</Actions>
    <Feedback>@if (commandError is not null) { <p class="error-panel" role="alert">@commandError</p> }@if (InputContractChanged) { <div class="form-alert form-alert-warning" role="status">@T("InputContractChanged")</div> }</Feedback>
    <OverviewMetrics>@if (tool?.Definition.Discovery is { } observed) { <MetricCard Label="@T("LastSeen")" Value="@observed.LastSeenAt.ToString("g")" /> }</OverviewMetrics>
    <OverviewSummary Context="identity">@if (tool is not null) { <ToolResourceSummary Resource="tool" OperationalEnabled="operational?.Enabled" Identity="identity" Provider="provider" ManagingExtension="managingExtension" /> }</OverviewSummary>
    <DefinitionContent Context="path"><ResourceDefinitionForm @key="model" EditContext="FormContext" FieldLabels="FieldLabels" Id="tool-inspection-form" FormName="tool-inspection"
        SectionState="sectionState" Sections="presentations" SectionContent="DefinitionSection" ReadOnly="true" /></DefinitionContent>
    <AdditionalContent Context="path">@Execution</AdditionalContent>
</ConsoleResourceDetailsTemplate>

@code {
    private RenderFragment Identity => @<ResourceIdentityEditor ResourceKind="@ToolResourceKinds.Tool" DisplayName="@model.DisplayName" DisplayNameExpression="@(() => model.DisplayName)"
        TechnicalName="@model.Name" TechnicalNameExpression="@(() => model.Name)" Namespace="@model.Namespace" NamespaceExpression="@(() => model.Namespace)" ScopeRef="model.ScopeRef"
        Description="@model.Description" DescriptionExpression="@(() => model.Description)" Labels="@model.Tags" LabelsExpression="@(() => model.Tags)" ReadOnly="true" TestId="tool-identity-editor" />;
    private RenderFragment DefinitionSection(string path) => path switch
    {
        "definition/identity" => Identity,
        "definition/configuration" => @<ToolResourceSummary Resource="tool!" ShowIdentity="false" ShowSpecificContent="false" ConfigurationInitiallyCollapsed="false" />,
        _ => throw new ArgumentOutOfRangeException(nameof(path))
    };
    private RenderFragment Execution => @<div>@if (tool is not null) {
            <section class="panel tool-runner" aria-labelledby="tool-runner-heading" data-testid="tool-runner">
                <div class="panel-header"><div><h2 id="tool-runner-heading">@T("RunTool")</h2><p class="muted">@T("RunToolHelp")</p></div></div>
                <div class="tool-run-mode" role="group" aria-label="@T("RunMode")">
                    <button type="button" class="tool-run-mode-option @(runMode == ToolRunMode.Simulate ? "selected" : null)" aria-pressed="@(runMode == ToolRunMode.Simulate)" disabled="@(!CanSimulate)" data-testid="tool-run-simulate-mode" @onclick="() => SelectMode(ToolRunMode.Simulate)">
                        <span><strong>@T("Simulation")</strong><small>@T("SimulationOptionHelp")</small></span><span class="tool-run-mode-mark" aria-hidden="true">✓</span>
                    </button>
                    <button type="button" class="tool-run-mode-option execution @(runMode == ToolRunMode.Execute ? "selected" : null)" aria-pressed="@(runMode == ToolRunMode.Execute)" data-testid="tool-run-execute-mode" @onclick="() => SelectMode(ToolRunMode.Execute)">
                        <span><strong>@T("RealExecution")</strong><small>@T("ExecutionOptionHelp")</small></span><span class="tool-run-mode-mark" aria-hidden="true">✓</span>
                    </button>
                </div>
                @if (runMode == ToolRunMode.Execute)
                {
                    <p class="tool-run-mode-help execution">@T("RealExecutionHelp")</p>
                }
                else
                {
                    <p class="tool-run-mode-help">@T("SimulationHelp")</p>
                }
                @if (!CanSimulate)
                {
                    <p class="tool-run-mode-unavailable" role="status">@T("SimulationUnavailableHelp")</p>
                }
                @if (!(operational?.Enabled ?? tool.Definition.Enabled) || tool.Definition.Discovery?.Available != true)
                {
                    <p class="inline-warning" role="status">@T(!(operational?.Enabled ?? tool.Definition.Enabled) ? "ToolDisabledHelp" : "ToolUnavailableHelp")</p>
                }
                @if (runMode == ToolRunMode.Execute && tool.Definition.RequiresApproval)
                {
                    <p class="inline-warning" role="status">@T("ApprovalRequiredHelp")</p>
                }
                <div class="tool-run-input">
                    <div class="tool-run-input-heading">
                        <h3>@T("RunInput")</h3>
                        @if (runMode == ToolRunMode.Simulate)
                        {
                            <span class="tool-run-managed-input" data-testid="tool-run-dry-run-managed">✓ @T("DryRunManaged")</span>
                        }
                    </div>
                    <JsonSchemaInputEditor @key="inputResetIdentity" Schema="ExecutionSchema?.Input" Value="runInput" ValueChanged="ChangeRunInput" ValidationChanged="UpdateRunValidation" LockedValues="ManagedRunValues" Disabled="submitting" />
                </div>
                @if (runError is not null)
                {
                    <p class="error-panel" role="alert">@runError</p>
                }
                <div class="tool-run-actions">
                    <button class="button-primary" disabled="@(!CanSubmit)" data-testid="tool-run-submit" @onclick="SubmitRunAsync">@(submitting ? T("Running") : T(runMode == ToolRunMode.Simulate ? "Simulate" : "ExecuteNow"))</button>
                </div>
            </section>
            @if (runResult is not null)
            {
                <section class="panel tool-run-result" aria-labelledby="tool-run-result-heading" data-testid="tool-run-result">
                    <div class="panel-header"><h2 id="tool-run-result-heading">@T("RunResult")</h2><StatusBadge Text="@T($"RunStatus.{runResult.Status}")" Status="@(runResult.Status == "denied" ? UiStatus.Warning : UiStatus.Success)" /></div>
                    @if (runResult.Status != "denied")
                    {
                        <div class="tool-output" data-testid="tool-run-output">
                            <h3>@T("ToolOutput")</h3>
                            @if (runResult.Output is { } output)
                            {
                                <pre>@JsonSerializer.Serialize(output, IndentedJson)</pre>
                                @if (ReturnedArtifactUrl(output) is { } artifactUrl)
                                {
                                    <a class="button-secondary" href="@artifactUrl" data-testid="tool-run-open-artifact">@T("OpenReturnedArtifact")</a>
                                }
                            }
                            else
                            {
                                <p class="muted">@T("NoOutput")</p>
                            }
                        </div>
                    }
                    @if (runResult.Receipt?.FlowRunId is { Length: > 0 } flowRunId)
                    {
                        <a class="button-secondary" href="@($"/flow-runs/{Uri.EscapeDataString(flowRunId)}")">@T("OpenFlowRun")</a>
                    }
                    <div class="tool-run-facts">
                        <span><small>@T("RunMode")</small><strong>@T(runResult.Mode == ToolRunMode.Simulate ? "Simulation" : "RealExecution")</strong></span>
                        <span><small>@T("ProviderInvoked")</small><strong>@BooleanLabel(runResult.ProviderInvoked)</strong></span>
                        <span><small>@T("Provider")</small><code>@runResult.ProviderName</code></span>
                    </div>
                    <details class="tool-run-diagnostics">
                        <summary>@T("VerificationDetails")</summary>
                        <ul class="tool-run-checks">@foreach (var check in runResult.Checks) { <li class="@check.Status"><strong>@RunCheckTitle(check)</strong><span>@RunCheckMessage(check)</span></li> }</ul>
                    </details>
                </section>
            }
    }</div>;

    [Parameter] public string Name { get; set; } = "";
    [SupplyParameterFromQuery(Name = "scopeRef")] public string? ScopeRefValue { get; set; }
    [SupplyParameterFromQuery(Name = "namespace")] public string? NamespaceValue { get; set; }
    private static readonly JsonSerializerOptions IndentedJson = new() { WriteIndented = true };
    private static readonly IReadOnlyDictionary<string, JsonElement> DryRunEnabled = new Dictionary<string, JsonElement>(StringComparer.Ordinal)
    {
        [ToolDryRunContract.ParameterName] = JsonSerializer.SerializeToElement(true)
    };
    private readonly ResourceSectionState sectionState = new();
    private bool toggling, refreshing, loading;
    private string? loadedKey, commandError;
    private ResourceLoadState loadState = new(ResourceLoadStatus.Loading);
    private ToolInspectionModel model = new();
    private EditContext? editContext;
    private EditContext FormContext => editContext is not null && ReferenceEquals(editContext.Model, model) ? editContext : editContext = new(model);
    // Keep the visited input editor on its accepted contract until an explicit reset.
    private ToolResource? executionSnapshot;
    private Guid inputResetIdentity = Guid.NewGuid();
    private ToolSchema? ExecutionSchema => (executionSnapshot ?? tool)?.Definition.Schema;
    private bool InputContractChanged => executionSnapshot is not null && tool is not null
        && JsonSerializer.Serialize(executionSnapshot.Definition.Schema) != JsonSerializer.Serialize(tool.Definition.Schema);
    private long loadVersion;
    private readonly CancellationTokenSource cancellation = new();
    private IReadOnlyList<ResourceNavigationItem> AdditionalSections => [new("execution", T("TabExecution"), "player-play")];
    private string SavedYaml => tool is null ? string.Empty : ResourceManifestSerializer.ToYaml(tool);
    private string? NavigationScope => ResourceOwnershipContext.TryGetCurrent(Services)?.Value ?? (Services.GetService(typeof(ConsoleContextState)) as ConsoleContextState)?.Current?.SelectedScopeRef;
    private IReadOnlyDictionary<string, ResourceSectionPresentation> Presentations => new Dictionary<string, ResourceSectionPresentation>(StringComparer.Ordinal)
    {
        ["definition/identity"] = new() { ReadOnly = true, ReadOnlyMessage = T("InspectionOnly"), Fields = [nameof(model.Name), nameof(model.Namespace), nameof(model.DisplayName), nameof(model.Description), nameof(model.Tags), nameof(model.ScopeRef)] },
        ["definition/configuration"] = new() { ReadOnly = true, ReadOnlyMessage = T("InspectionOnly") },
        ["execution"] = new() { Actions = ResetInputsAction },
        ["yaml"] = new() { ReadOnly = true, ReadOnlyMessage = T("InspectionOnly") }
    };
    private IReadOnlyDictionary<string, string> FieldLabels => new Dictionary<string, string>(StringComparer.Ordinal)
    {
        [nameof(model.Name)] = IdentityLabels["TechnicalName"], [nameof(model.DisplayName)] = IdentityLabels["DisplayName"], [nameof(model.Namespace)] = Shared["Namespace"],
        [nameof(model.Description)] = Shared["Description"], [nameof(model.Tags)] = Shared["Labels"], [nameof(model.ScopeRef)] = Shared["Scope"]
    };
    private void SelectSection(string? value) { if (value == "execution" && executionSnapshot is null && tool is not null) ResetRunInput(); }
    private void ResetRunInput()
    {
        executionSnapshot = tool; inputResetIdentity = Guid.NewGuid();
        runMode = CanSimulate ? ToolRunMode.Simulate : ToolRunMode.Execute;
        runInput = CanSimulate ? ToolDryRunContract.Enable(JsonSerializer.SerializeToElement(new { })) : JsonSerializer.SerializeToElement(new { });
        runInputValid = true; runError = null; runResult = null;
    }
    private RenderFragment ResetInputsAction => @<button type="button" class="button-secondary" disabled="@(submitting || toggling || refreshing)" @onclick="ResetRunInput">@T("ResetRunInput")</button>;
    private ToolResource? tool;
    private ToolOperationalStatus? operational;
    private ToolProviderResource? provider;
    private ExtensionInventoryItemResponse? managingExtension;
    private string? etag;
    private ToolRunMode runMode = ToolRunMode.Simulate;
    private JsonElement runInput = JsonSerializer.SerializeToElement(new { });
    private bool runInputValid = true;
    private bool submitting;
    private string? runError;
    private RunToolResponse? runResult;
    private ResourceNamespace ToolNamespace => ResourceNamespace.Parse(NamespaceValue);
    private bool CanSimulate => ToolDryRunContract.IsSupported(ExecutionSchema?.Input);
    private bool CanManage => tool is not null && tool.ScopeRef is { } owner && ResourceOwnershipContext.CanManage(owner, Services);
    private bool HasPermission(string permission) => Services.GetService<ConsoleContextState>()?.HasPermission(permission) ?? true;
    private bool CanWrite => CanManage && HasPermission("resources/write");
    private string NewDefinitionUrl
    {
        get
        {
            var url = $"/tools/definitions/new?toolKind=relay&source={Uri.EscapeDataString(ToolResourceIdentity.CatalogId(tool!.Namespace, tool.Name))}&sourceScopeRef={Uri.EscapeDataString(tool.ScopeRef!.Value.Value)}";
            return (Services.GetService(typeof(IConsoleNavigationContext)) as IConsoleNavigationContext)?.AddToUri(url) ?? url;
        }
    }
    private IReadOnlyDictionary<string, JsonElement>? ManagedRunValues => runMode == ToolRunMode.Simulate ? DryRunEnabled : null;
    private bool CanSubmit => tool is not null && (operational?.Enabled ?? tool.Definition.Enabled)
        && tool.Definition.Discovery?.Available == true
        && runInputValid
        && !InputContractChanged
        && HasPermission("runs/execute")
        && !submitting
        && (runMode != ToolRunMode.Execute || !tool.Definition.RequiresApproval);

    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string AvailabilityLabel(bool available) => T(available ? "Available" : "Unavailable");
    private string BooleanLabel(bool value) => T(value ? "Yes" : "No");

    private string RunCheckTitle(ToolRunCheck check)
    {
        var localized = Localizer[$"RunCheckTitle.{check.Code}"];
        return localized.ResourceNotFound ? check.Code : localized.Value;
    }

    private string RunCheckMessage(ToolRunCheck check)
    {
        var statusSpecific = Localizer[$"RunCheck.{check.Code}.{check.Status}"];
        if (!statusSpecific.ResourceNotFound) return statusSpecific.Value;
        var generic = Localizer[$"RunCheck.{check.Code}"];
        return generic.ResourceNotFound ? check.Message : generic.Value;
    }

    protected override Task OnParametersSetAsync()
    {
        var key = $"{Name}|{NamespaceValue}|{ScopeRefValue}|{NavigationScope}";
        if (key == loadedKey) return Task.CompletedTask;
        loadedKey = key; return LoadAsync();
    }
    private void Clear()
    {
        tool = executionSnapshot = null; provider = null; managingExtension = null; etag = commandError = null;
        model = new(); editContext = null; runInput = JsonSerializer.SerializeToElement(new { }); runInputValid = true; runError = null; runResult = null;
    }
    private void Apply(ResourceSnapshot<ToolResource> snapshot)
    {
        tool = snapshot.Value; etag = snapshot.ETag; model = ToolInspectionModel.From(snapshot.Value);
    }
    private async Task LoadAsync()
    {
        var request = ++loadVersion; loading = true; toggling = submitting = refreshing = false; Clear(); loadState = new(ResourceLoadStatus.Loading);
        try
        {
            if (Services.GetService<ConsoleContextState>() is { } context)
            {
                await context.EnsureLoadedAsync(cancellation.Token); if (request != loadVersion) return;
                if (context.Current is null) throw new InvalidOperationException(context.Error);
            }
            loadedKey = $"{Name}|{NamespaceValue}|{ScopeRefValue}|{NavigationScope}";
            var requestedName = Name; var ns = ToolNamespace;
            ResourceScopeRef? requestedOwner = string.IsNullOrWhiteSpace(ScopeRefValue) ? null : ResourceScopeRef.Parse(ScopeRefValue);
            var snapshot = await (requestedOwner is { } exact ? Client.GetToolAsync(exact, ns, requestedName, cancellation.Token) : Client.GetToolAsync(ns, requestedName, cancellation.Token));
            if (request != loadVersion) return;
            var saved = snapshot.Value;
            if (saved.Name != requestedName || saved.Namespace != ns || saved.ScopeRef is null || requestedOwner is { } owner && saved.ScopeRef != owner) throw new InvalidOperationException(T("ResourceIdentityMismatch"));
            var source = await LoadSourceAsync(saved); if (request != loadVersion) return;
            Apply(snapshot); operational = await Client.GetOperationalStateAsync(saved, cancellation.Token); if (request != loadVersion) return; provider = source.Provider; managingExtension = source.Extension;
            runMode = CanSimulate ? ToolRunMode.Simulate : ToolRunMode.Execute;
            runInput = CanSimulate ? ToolDryRunContract.Enable(JsonSerializer.SerializeToElement(new { })) : JsonSerializer.SerializeToElement(new { });
            loadState = new(ResourceLoadStatus.Ready) { HasContent = true };
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception) { if (request == loadVersion) { Clear(); loadState = Failure(exception); } }
        finally { if (request == loadVersion) loading = false; }
    }
    private async Task<(ToolProviderResource? Provider, ExtensionInventoryItemResponse? Extension)> LoadSourceAsync(ToolResource saved)
    {
        ToolProviderResource? loadedProvider = null; ExtensionInventoryItemResponse? loadedExtension = null;
        if (Services.GetService<IExtensionsClient>() is { } extensions && saved.Definition.Provider is { } reference && (reference.ScopeRef ?? saved.ScopeRef) is { } owner)
        {
            var ns = reference.Namespace ?? saved.Namespace;
            loadedProvider = (await Client.GetProviderAsync(owner, ns, reference.Name, cancellation.Token)).Value;
            if (loadedProvider.ScopeRef != owner || loadedProvider.Namespace != ns || loadedProvider.Name != reference.Name) throw new InvalidOperationException(T("ResourceIdentityMismatch"));
            if (loadedProvider.Definition.Aep?.Extension is { } extensionReference)
            {
                var inventory = await extensions.GetExtensionInventoryAsync(cancellation.Token);
                loadedExtension = inventory.SingleOrDefault(candidate => string.Equals(candidate.RegistrationName, extensionReference.Name, StringComparison.Ordinal)
                    && string.Equals(candidate.RegistrationNamespace, (extensionReference.Namespace ?? loadedProvider.Namespace).Value, StringComparison.Ordinal)
                    && candidate.RegistrationScopeRef == (extensionReference.ScopeRef ?? loadedProvider.ScopeRef));
            }
        }
        return (loadedProvider, loadedExtension);
    }
    private Task RetryAsync() => loading || toggling || submitting || refreshing ? Task.CompletedTask : tool is null ? LoadAsync() : RefreshAsync();
    private async Task RefreshAsync()
    {
        if (loading || toggling || submitting || refreshing || tool is not { ScopeRef: { } owner } current) return;
        var request = ++loadVersion; refreshing = true; loadState = new(ResourceLoadStatus.Refreshing) { HasContent = true };
        try
        {
            var snapshot = await Client.GetToolAsync(owner, current.Namespace, current.Name, cancellation.Token); if (request != loadVersion) return;
            var next = snapshot.Value;
            if (next.Uid != current.Uid || next.ScopeRef != owner || next.Address != current.Address) { Clear(); loadState = new(ResourceLoadStatus.NotFound); return; }
            var source = await LoadSourceAsync(next); if (request != loadVersion) return;
            Apply(snapshot); operational = await Client.GetOperationalStateAsync(next, cancellation.Token); if (request != loadVersion) return; provider = source.Provider; managingExtension = source.Extension; loadState = new(ResourceLoadStatus.Ready) { HasContent = true };
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception) { if (request == loadVersion) { var failure = Failure(exception); if (failure.Status is ResourceLoadStatus.NotFound or ResourceLoadStatus.Forbidden) Clear(); loadState = failure with { HasContent = tool is not null }; } }
        finally { if (request == loadVersion) refreshing = false; }
    }
    private static ResourceLoadState Failure(Exception exception) => new(exception is AgentstrationApiException api ? api.StatusCode switch
    {
        System.Net.HttpStatusCode.NotFound => ResourceLoadStatus.NotFound, System.Net.HttpStatusCode.Forbidden or System.Net.HttpStatusCode.Unauthorized => ResourceLoadStatus.Forbidden, _ => ResourceLoadStatus.Failed
    } : ResourceLoadStatus.Failed) { ErrorId = (exception as AgentstrationApiException)?.ErrorId };

    private async Task ToggleAsync(bool enabled)
    {
        if (!CanWrite || tool is null || toggling || refreshing) return;
        toggling = true; commandError = null; var request = loadVersion;
        try
        {
            var value = await Client.SetEnabledAsync(tool.ScopeRef!.Value, tool.Namespace, tool.Name, enabled, operational?.ETag, cancellation.Token);
            var state = await Client.GetOperationalStateAsync(tool, cancellation.Token);
            if (request != loadVersion) return;
            if (value.Value.Uid != tool.Uid || value.Value.ScopeRef != tool.ScopeRef || value.Value.Address != tool.Address) { Clear(); loadState = new(ResourceLoadStatus.NotFound); return; }
            Apply(value); operational = state;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception) { if (request == loadVersion) commandError = exception.Message; }
        finally { if (request == loadVersion) toggling = false; }
    }

    private void SelectMode(ToolRunMode mode)
    {
        if (mode == ToolRunMode.Simulate && !CanSimulate) return;
        runMode = mode;
        if (CanSimulate)
            runInput = ToolDryRunContract.Set(runInput, mode == ToolRunMode.Simulate);
        runError = null;
        runResult = null;
    }

    private void ChangeRunInput(JsonElement value) =>
        runInput = runMode == ToolRunMode.Simulate ? ToolDryRunContract.Enable(value) : value;

    private Task UpdateRunValidation(JsonSchemaInputValidationState validation)
    {
        runInputValid = validation.IsValid;
        return Task.CompletedTask;
    }

    private async Task SubmitRunAsync()
    {
        if (!CanSubmit) return;
        var version = loadVersion;
        try
        {
            submitting = true;
            runError = null;
            var request = new RunToolRequest(runInput.Clone(), runMode);
            var result = tool!.ScopeRef is { } owner
                ? await Client.RunToolAsync(owner, tool.Namespace, tool.Name, request, cancellation.Token)
                : await Client.RunToolAsync(tool.Namespace, tool.Name, request, cancellation.Token);
            if (version == loadVersion) runResult = result;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception)
        {
            if (version != loadVersion) return;
            runResult = null;
            runError = exception is AgentstrationApiException { ProblemType: "https://agentstration.dev/problems/data_source_acquisition_target_stale" }
                ? T("AcquisitionTargetStale") : exception is AgentstrationApiException { ProblemTitle: { } code } api && code.StartsWith("data_source_", StringComparison.Ordinal)
                    ? T("DataSourceQueryFailed") + " " + code + " · " + api.ErrorId : exception.Message;
        }
        finally
        {
            if (version == loadVersion) submitting = false;
        }
    }

    private string? ReturnedArtifactUrl(JsonElement output)
    {
        if (output.ValueKind != JsonValueKind.Object
            || !output.TryGetProperty("artifact", out var artifact) || artifact.ValueKind != JsonValueKind.Object
            || !artifact.TryGetProperty("artifactId", out var id) || id.ValueKind != JsonValueKind.String
            || !Guid.TryParse(id.GetString(), out var artifactId)
            || !artifact.TryGetProperty("kind", out var kind) || kind.ValueKind != JsonValueKind.String
            || kind.GetString() is not ("staged" or "durable"))
            return null;

        var url = $"/artifacts/{kind.GetString()}/{artifactId:N}";
        return (Services.GetService(typeof(IConsoleNavigationContext)) as IConsoleNavigationContext)?.AddToUri(url) ?? url;
    }

    public void Dispose() { loadVersion++; cancellation.Cancel(); cancellation.Dispose(); }

}
