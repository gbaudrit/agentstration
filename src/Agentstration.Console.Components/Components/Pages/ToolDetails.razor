@page "/tools/{Name}"
@inject IToolsClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<ToolDetailsStrings> Localizer

@if (tool is null)
{
    <LoadingState Message="@T("Loading")" />
}
else
{
    <PageTitle>@tool.Definition.DisplayName · Agentstration</PageTitle>
    <ResourceHeader ResourceType="@T("Tool")" Domain="tool" Icon="⌁" Name="@tool.Definition.DisplayName"
                    StatusText="@AvailabilityLabel(tool.Definition.Discovery?.Available == true)"
                    Status="@(tool.Definition.Discovery?.Available == true ? UiStatus.Success : UiStatus.Warning)"
                    TestId="resource-tool-details">
        <Actions><button class="button-primary" @onclick="ToggleAsync">@T(tool.Definition.Enabled ? "Disable" : "Enable")</button></Actions>
    </ResourceHeader>

    <nav class="section-tabs tool-detail-tabs" role="tablist" aria-label="@T("DetailViews")">
        <button id="tool-overview-tab" type="button" role="tab" aria-selected="@(activeTab == ToolDetailTab.Overview ? "true" : "false")" aria-controls="tool-detail-panel" class="@(activeTab == ToolDetailTab.Overview ? "active" : null)" data-testid="tool-overview-tab" @onclick="() => activeTab = ToolDetailTab.Overview">@T("TabOverview")</button>
        <button id="tool-execution-tab" type="button" role="tab" aria-selected="@(activeTab == ToolDetailTab.Execution ? "true" : "false")" aria-controls="tool-detail-panel" class="@(activeTab == ToolDetailTab.Execution ? "active" : null)" data-testid="tool-execution-tab" @onclick="() => activeTab = ToolDetailTab.Execution">@T("TabExecution")</button>
    </nav>

    <div id="tool-detail-panel" role="tabpanel" aria-labelledby="@(activeTab == ToolDetailTab.Overview ? "tool-overview-tab" : "tool-execution-tab")">
        @if (activeTab == ToolDetailTab.Overview)
        {
            <section class="panel tool-capability" aria-labelledby="tool-capability-heading">
                <div class="panel-header"><h2 id="tool-capability-heading">@T("Capability")</h2></div>
                <p>@(string.IsNullOrWhiteSpace(tool.Definition.Description) ? T("NoDescription") : tool.Definition.Description)</p>
            </section>

            <section class="panel tool-contract" aria-labelledby="tool-input-heading">
                <div class="panel-header"><h2 id="tool-input-heading">@T("InputContract")</h2></div>
                @SchemaSummary(tool.Definition.Schema?.Input)
                @RawSchema(tool.Definition.Schema?.Input, "RawInputSchema")
            </section>

            <section class="panel tool-contract" aria-labelledby="tool-output-heading">
                <div class="panel-header"><h2 id="tool-output-heading">@T("OutputContract")</h2></div>
                @SchemaSummary(tool.Definition.Schema?.Output)
                @RawSchema(tool.Definition.Schema?.Output, "RawOutputSchema")
            </section>

            <section class="panel" aria-labelledby="tool-governance-heading">
                <div class="panel-header"><h2 id="tool-governance-heading">@T("GovernanceAndSource")</h2></div>
                <dl class="resource-details">
                    <dt>@T("Provider")</dt><dd><code>@tool.Definition.Provider?.ResourceId</code></dd>
                    <dt>@T("ExternalName")</dt><dd><code>@tool.Definition.ExternalId</code></dd>
                    <dt>@T("Enabled")</dt><dd>@BooleanLabel(tool.Definition.Enabled)</dd>
                    <dt>@T("RequiresApproval")</dt><dd>@BooleanLabel(tool.Definition.RequiresApproval)</dd>
                    <dt>@T("AvailableLabel")</dt><dd>@BooleanLabel(tool.Definition.Discovery?.Available == true)</dd>
                    <dt>@T("FirstSeen")</dt><dd>@tool.Definition.Discovery?.FirstSeenAt.ToString("g")</dd>
                    <dt>@T("LastSeen")</dt><dd>@tool.Definition.Discovery?.LastSeenAt.ToString("g")</dd>
                </dl>
            </section>
        }
        else
        {
            <section class="panel tool-runner" aria-labelledby="tool-runner-heading" data-testid="tool-runner">
                <div class="panel-header"><div><h2 id="tool-runner-heading">@T("RunTool")</h2><p class="muted">@T("RunToolHelp")</p></div></div>
                <div class="tool-run-mode" role="group" aria-label="@T("RunMode")">
                    <button type="button" class="tool-run-mode-option @(runMode == ToolRunMode.Simulate ? "selected" : null)" aria-pressed="@(runMode == ToolRunMode.Simulate)" disabled="@(!CanSimulate)" data-testid="tool-run-simulate-mode" @onclick="() => SelectMode(ToolRunMode.Simulate)">
                        <span><strong>@T("Simulation")</strong><small>@T("SimulationOptionHelp")</small></span><span class="tool-run-mode-mark" aria-hidden="true">✓</span>
                    </button>
                    <button type="button" class="tool-run-mode-option execution @(runMode == ToolRunMode.Execute ? "selected" : null)" aria-pressed="@(runMode == ToolRunMode.Execute)" data-testid="tool-run-execute-mode" @onclick="() => SelectMode(ToolRunMode.Execute)">
                        <span><strong>@T("RealExecution")</strong><small>@T("ExecutionOptionHelp")</small></span><span class="tool-run-mode-mark" aria-hidden="true">✓</span>
                    </button>
                </div>
                @if (runMode == ToolRunMode.Execute)
                {
                    <p class="tool-run-mode-help execution">@T("RealExecutionHelp")</p>
                }
                else
                {
                    <p class="tool-run-mode-help">@T("SimulationHelp")</p>
                }
                @if (!CanSimulate)
                {
                    <p class="tool-run-mode-unavailable" role="status">@T("SimulationUnavailableHelp")</p>
                }
                @if (!tool.Definition.Enabled || tool.Definition.Discovery?.Available != true)
                {
                    <p class="inline-warning" role="status">@T(!tool.Definition.Enabled ? "ToolDisabledHelp" : "ToolUnavailableHelp")</p>
                }
                @if (runMode == ToolRunMode.Execute && tool.Definition.RequiresApproval)
                {
                    <p class="inline-warning" role="status">@T("ApprovalRequiredHelp")</p>
                }
                <div class="tool-run-input">
                    <h3>@T("RunInput")</h3>
                    <JsonSchemaInputEditor Schema="tool.Definition.Schema?.Input" Value="runInput" ValueChanged="value => runInput = value" ValidationChanged="UpdateRunValidation" Disabled="submitting" />
                </div>
                @if (runError is not null)
                {
                    <p class="error-panel" role="alert">@runError</p>
                }
                <div class="tool-run-actions">
                    <button class="button-primary" disabled="@(!CanSubmit)" data-testid="tool-run-submit" @onclick="SubmitRunAsync">@(submitting ? T("Running") : T(runMode == ToolRunMode.Simulate ? "Simulate" : "ExecuteNow"))</button>
                </div>
            </section>
            @if (runResult is not null)
            {
                <section class="panel tool-run-result" aria-labelledby="tool-run-result-heading" data-testid="tool-run-result">
                    <div class="panel-header"><h2 id="tool-run-result-heading">@T("RunResult")</h2><StatusBadge Text="@T($"RunStatus.{runResult.Status}")" Status="@(runResult.Status == "denied" ? UiStatus.Warning : UiStatus.Success)" /></div>
                    @if (runResult.Status != "denied")
                    {
                        <div class="tool-output" data-testid="tool-run-output">
                            <h3>@T("ToolOutput")</h3>
                            @if (runResult.Output is { } output)
                            {
                                <pre>@JsonSerializer.Serialize(output, IndentedJson)</pre>
                            }
                            else
                            {
                                <p class="muted">@T("NoOutput")</p>
                            }
                        </div>
                    }
                    @if (runResult.Receipt?.FlowRunId is { Length: > 0 } flowRunId)
                    {
                        <a class="button-secondary" href="@($"/flow-runs/{Uri.EscapeDataString(flowRunId)}")">@T("OpenFlowRun")</a>
                    }
                    <div class="tool-run-facts">
                        <span><small>@T("RunMode")</small><strong>@T(runResult.Mode == ToolRunMode.Simulate ? "Simulation" : "RealExecution")</strong></span>
                        <span><small>@T("ProviderInvoked")</small><strong>@BooleanLabel(runResult.ProviderInvoked)</strong></span>
                        <span><small>@T("Provider")</small><code>@runResult.ProviderName</code></span>
                    </div>
                    <details class="tool-run-diagnostics">
                        <summary>@T("VerificationDetails")</summary>
                        <ul class="tool-run-checks">@foreach (var check in runResult.Checks) { <li class="@check.Status"><strong>@RunCheckTitle(check)</strong><span>@RunCheckMessage(check)</span></li> }</ul>
                    </details>
                </section>
            }
        }
    </div>
}

@code {
    [Parameter] public string Name { get; set; } = "";
    [SupplyParameterFromQuery(Name = "namespace")] public string? NamespaceValue { get; set; }
    private static readonly JsonSerializerOptions IndentedJson = new() { WriteIndented = true };
    private enum ToolDetailTab { Overview, Execution }
    private ToolResource? tool;
    private string? etag;
    private ToolDetailTab activeTab;
    private ToolRunMode runMode = ToolRunMode.Simulate;
    private JsonElement runInput = JsonSerializer.SerializeToElement(new { });
    private bool runInputValid = true;
    private bool submitting;
    private string? runError;
    private RunToolResponse? runResult;
    private ResourceNamespace ToolNamespace => ResourceNamespace.Parse(NamespaceValue);
    private bool CanSimulate => ToolDryRunContract.IsSupported(tool?.Definition.Schema?.Input);
    private bool CanSubmit => tool is { Definition.Enabled: true }
        && tool.Definition.Discovery?.Available == true
        && runInputValid
        && !submitting
        && (runMode != ToolRunMode.Execute || !tool.Definition.RequiresApproval);

    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string AvailabilityLabel(bool available) => T(available ? "Available" : "Unavailable");
    private string BooleanLabel(bool value) => T(value ? "Yes" : "No");

    private string RunCheckTitle(ToolRunCheck check)
    {
        var localized = Localizer[$"RunCheckTitle.{check.Code}"];
        return localized.ResourceNotFound ? check.Code : localized.Value;
    }

    private string RunCheckMessage(ToolRunCheck check)
    {
        var statusSpecific = Localizer[$"RunCheck.{check.Code}.{check.Status}"];
        if (!statusSpecific.ResourceNotFound) return statusSpecific.Value;
        var generic = Localizer[$"RunCheck.{check.Code}"];
        return generic.ResourceNotFound ? check.Message : generic.Value;
    }

    protected override async Task OnParametersSetAsync()
    {
        var value = await Client.GetToolAsync(ToolNamespace, Name, default);
        tool = value.Value;
        etag = value.ETag;
        activeTab = ToolDetailTab.Overview;
        runMode = CanSimulate ? ToolRunMode.Simulate : ToolRunMode.Execute;
        runInput = JsonSerializer.SerializeToElement(new { });
        runInputValid = true;
        runError = null;
        runResult = null;
    }

    private async Task ToggleAsync()
    {
        var value = await Client.SetEnabledAsync(ToolNamespace, Name, !tool!.Definition.Enabled, etag, default);
        tool = value.Value;
        etag = value.ETag;
    }

    private void SelectMode(ToolRunMode mode)
    {
        if (mode == ToolRunMode.Simulate && !CanSimulate) return;
        runMode = mode;
        runError = null;
        runResult = null;
    }

    private Task UpdateRunValidation(JsonSchemaInputValidationState validation)
    {
        runInputValid = validation.IsValid;
        return Task.CompletedTask;
    }

    private async Task SubmitRunAsync()
    {
        if (!CanSubmit) return;
        try
        {
            submitting = true;
            runError = null;
            runResult = await Client.RunToolAsync(ToolNamespace, Name, new RunToolRequest(runInput.Clone(), runMode), default);
        }
        catch (Exception exception)
        {
            runResult = null;
            runError = exception.Message;
        }
        finally
        {
            submitting = false;
        }
    }

    private RenderFragment SchemaSummary(JsonElement? schema) => builder =>
    {
        if (schema is null || schema.Value.ValueKind is JsonValueKind.Null or JsonValueKind.Undefined)
        {
            builder.OpenElement(0, "p");
            builder.AddAttribute(1, "class", "tool-contract-note");
            builder.AddContent(2, T("NoSchema"));
            builder.CloseElement();
            return;
        }

        if (schema.Value.ValueKind != JsonValueKind.Object ||
            !schema.Value.TryGetProperty("properties", out var properties) ||
            properties.ValueKind != JsonValueKind.Object)
        {
            builder.OpenElement(0, "p");
            builder.AddAttribute(1, "class", "tool-contract-note");
            builder.AddContent(2, T("UnstructuredSchema"));
            builder.CloseElement();
            return;
        }

        var fields = properties.EnumerateObject().ToArray();
        if (fields.Length == 0)
        {
            builder.OpenElement(0, "p");
            builder.AddAttribute(1, "class", "tool-contract-note");
            builder.AddContent(2, T("NoProperties"));
            builder.CloseElement();
            return;
        }

        var required = new HashSet<string>(StringComparer.Ordinal);
        if (schema.Value.TryGetProperty("required", out var requiredValue) && requiredValue.ValueKind == JsonValueKind.Array)
        {
            foreach (var item in requiredValue.EnumerateArray())
            {
                if (item.ValueKind == JsonValueKind.String && item.GetString() is { } fieldName)
                {
                    required.Add(fieldName);
                }
            }
        }

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "tool-fields");
        foreach (var field in fields)
        {
            builder.OpenElement(2, "article");
            builder.AddAttribute(3, "class", "tool-field");
            builder.OpenElement(4, "div");
            builder.AddAttribute(5, "class", "tool-field-heading");
            builder.OpenElement(6, "code");
            builder.AddContent(7, field.Name);
            builder.CloseElement();
            builder.OpenElement(8, "span");
            builder.AddAttribute(9, "class", required.Contains(field.Name) ? "tool-field-required" : "tool-field-optional");
            builder.AddContent(10, T(required.Contains(field.Name) ? "Required" : "Optional"));
            builder.CloseElement();
            builder.CloseElement();

            var type = PropertyText(field.Value, "type");
            if (type is not null)
            {
                builder.OpenElement(11, "p");
                builder.AddAttribute(12, "class", "tool-field-type");
                builder.AddContent(13, T("Type", type));
                builder.CloseElement();
            }

            var description = PropertyText(field.Value, "description");
            if (!string.IsNullOrWhiteSpace(description))
            {
                builder.OpenElement(14, "p");
                builder.AddContent(15, description);
                builder.CloseElement();
            }

            var constraints = Constraints(field.Value);
            if (constraints.Count > 0)
            {
                builder.OpenElement(16, "ul");
                builder.AddAttribute(17, "class", "tool-field-constraints");
                foreach (var constraint in constraints)
                {
                    builder.OpenElement(18, "li");
                    builder.AddContent(19, constraint);
                    builder.CloseElement();
                }
                builder.CloseElement();
            }
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    private RenderFragment RawSchema(JsonElement? schema, string titleKey) => builder =>
    {
        if (schema is null || schema.Value.ValueKind is JsonValueKind.Null or JsonValueKind.Undefined)
        {
            return;
        }

        builder.OpenElement(0, "details");
        builder.AddAttribute(1, "class", "tool-raw-schema");
        builder.OpenElement(2, "summary");
        builder.AddContent(3, T(titleKey));
        builder.CloseElement();
        builder.OpenElement(4, "pre");
        builder.AddContent(5, JsonSerializer.Serialize(schema.Value, new JsonSerializerOptions { WriteIndented = true }));
        builder.CloseElement();
        builder.CloseElement();
    };

    private static string? PropertyText(JsonElement element, string name) =>
        element.ValueKind == JsonValueKind.Object && element.TryGetProperty(name, out var value) && value.ValueKind == JsonValueKind.String
            ? value.GetString()
            : null;

    private List<string> Constraints(JsonElement property)
    {
        var result = new List<string>();
        if (property.ValueKind != JsonValueKind.Object)
        {
            return result;
        }

        AddConstraint("minLength", "MinLength");
        AddConstraint("maxLength", "MaxLength");
        AddConstraint("minimum", "Minimum");
        AddConstraint("maximum", "Maximum");
        AddConstraint("pattern", "Pattern");
        AddConstraint("format", "Format");
        if (property.TryGetProperty("enum", out var allowed) && allowed.ValueKind == JsonValueKind.Array)
        {
            result.Add(T("AllowedValues", string.Join(", ", allowed.EnumerateArray().Select(item => item.ToString()))));
        }
        return result;

        void AddConstraint(string jsonName, string label)
        {
            if (property.TryGetProperty(jsonName, out var value) && value.ValueKind is not (JsonValueKind.Null or JsonValueKind.Undefined))
            {
                result.Add(T(label, value.ToString()));
            }
        }
    }
}
