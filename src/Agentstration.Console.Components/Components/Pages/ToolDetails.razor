@page "/tools/{Name}"
@inject IToolsClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<ToolDetailsStrings> Localizer

@if (tool is null) { <LoadingState Message="@T("Loading")" /> }
else { <PageTitle>@tool.Definition.DisplayName · Agentstration</PageTitle><ResourceHeader ResourceType="@T("Tool")" Domain="tool" Icon="⌁" Name="@tool.Definition.DisplayName" Description="@tool.Definition.Description" StatusText="@AvailabilityLabel(tool.Definition.Discovery?.Available == true)" Status="@(tool.Definition.Discovery?.Available == true ? UiStatus.Success : UiStatus.Warning)"><Actions><button class="button-primary" @onclick="ToggleAsync">@T(tool.Definition.Enabled ? "Disable" : "Enable")</button></Actions></ResourceHeader>
<section class="panel"><div class="panel-header"><h2>@T("GovernanceAndSource")</h2></div><dl class="resource-details"><dt>@T("Provider")</dt><dd><code>@tool.Definition.Provider?.ResourceId</code></dd><dt>@T("ExternalName")</dt><dd><code>@tool.Definition.ExternalId</code></dd><dt>@T("Enabled")</dt><dd>@BooleanLabel(tool.Definition.Enabled)</dd><dt>@T("RequiresApproval")</dt><dd>@BooleanLabel(tool.Definition.RequiresApproval)</dd><dt>@T("AvailableLabel")</dt><dd>@BooleanLabel(tool.Definition.Discovery?.Available == true)</dd><dt>@T("FirstSeen")</dt><dd>@tool.Definition.Discovery?.FirstSeenAt.ToString("g")</dd><dt>@T("LastSeen")</dt><dd>@tool.Definition.Discovery?.LastSeenAt.ToString("g")</dd></dl></section>
<section class="panel"><div class="panel-header"><h2>@T("InputSchema")</h2></div><pre>@Pretty(tool.Definition.Schema?.Input)</pre></section> }
@code { [Parameter] public string Name {get;set;}=""; private ToolResource? tool; private string? etag; private string T(string key, params object[] arguments) => Localizer[key, arguments]; private string AvailabilityLabel(bool available) => T(available ? "Available" : "Unavailable"); private string BooleanLabel(bool value) => T(value ? "Yes" : "No"); protected override async Task OnParametersSetAsync(){var value=await Client.GetToolAsync(Name,default);tool=value.Value;etag=value.ETag;} private async Task ToggleAsync(){var value=await Client.SetEnabledAsync(Name,!tool!.Definition.Enabled,etag,default);tool=value.Value;etag=value.ETag;} private static string Pretty(JsonElement? value)=>value is null?"—":JsonSerializer.Serialize(value.Value,new JsonSerializerOptions{WriteIndented=true}); }
