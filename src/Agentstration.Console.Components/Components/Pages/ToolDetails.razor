@page "/tools/{Name}"
@implements IDisposable
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@inject IToolsClient Client
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<ToolDetailsStrings> Localizer

<UnsavedNavigationGuard IsDirty="policyDirty" HasUnsavedChanges="@(() => policyDirty)" />
@if (loadError is not null) { <ErrorState Message="@loadError" /> }
else if (tool is null)
{
    <LoadingState Message="@T("Loading")" />
}
else
{
    <PageTitle>@tool.Definition.DisplayName · Agentstration</PageTitle>
    <ResourceDetailsTemplate ScopeRef="tool.ScopeRef" ResourceType="@T("Tool")" Domain="tool" IconName="wrench" Name="@tool.Definition.DisplayName"
                             TechnicalName="@tool.Name" Namespace="@tool.Namespace.Value" Description="@tool.Definition.Description"
                             StatusText="@AvailabilityLabel(tool.Definition.Discovery?.Available == true)" Status="@(tool.Definition.Discovery?.Available == true ? UiStatus.Success : UiStatus.Warning)"
                             Enabled="tool.Definition.Enabled" EnabledChanged="ToggleAsync" EnabledDisabled="@(!CanManage || tool.Governance.IsManaged || toggling)" EnabledTestId="tool-enabled-toggle"
                             Sections="Sections" ResourceIdentity="@($"{loadedKey}|{tool.Uid}")" DefaultSection="overview" SelectionChanged="SelectSection" TestId="resource-tool-details">
        <Actions>@if (CanManage) { <a class="button-secondary" href="@NewDefinitionUrl">@T("NewDefinition")</a> }</Actions>
        <Feedback>@if (tool.ScopeRef is { } owner) { <InheritedResourceNotice OwnerScopeRef="owner" /> }@if (commandError is not null) { <p class="error-panel" role="alert">@commandError</p> }</Feedback>
        <Content>
        <div hidden="@(section != "overview")">
            <ResourceIdentitySummary DisplayName="@tool.Definition.DisplayName" TechnicalName="@tool.Name" Namespace="@tool.Namespace.Value" Description="@tool.Definition.Description"><Scope><ResourceScopeBadge ScopeRef="tool.ScopeRef" /></Scope></ResourceIdentitySummary>
            <FormSection Title="@Shared["Configuration"]" Class="resource-configuration-summary">
                <CollectionView TItem="ConfigurationEntry" Items="SavedConfiguration" IdentityLabel="@Shared["Configuration"]" InformationLabels="@(new[] { Shared["Saved"].Value })">
                    <Identity Context="entry"><strong class="configuration-key">@entry.Label</strong></Identity>
                    <Information Context="entry"><CollectionValue Label="@Shared["Saved"]"><span class="configuration-value">@entry.Value</span></CollectionValue></Information>
                </CollectionView>
            </FormSection>
            <section class="panel tool-capability" aria-labelledby="tool-capability-heading">
                <div class="panel-header"><h2 id="tool-capability-heading">@T("Capability")</h2></div>
                <p>@(string.IsNullOrWhiteSpace(tool.Definition.Description) ? T("NoDescription") : tool.Definition.Description)</p>
            </section>

            <section class="panel tool-contract" aria-labelledby="tool-input-heading">
                <div class="panel-header"><h2 id="tool-input-heading">@T("InputContract")</h2></div>
                @SchemaSummary(tool.Definition.Schema?.Input)
                @RawSchema(tool.Definition.Schema?.Input, "RawInputSchema")
            </section>

            <section class="panel tool-contract" aria-labelledby="tool-output-heading">
                <div class="panel-header"><h2 id="tool-output-heading">@T("OutputContract")</h2></div>
                @SchemaSummary(tool.Definition.Schema?.Output)
                @RawSchema(tool.Definition.Schema?.Output, "RawOutputSchema")
            </section>

            <section class="panel" aria-labelledby="tool-governance-heading">
                <div class="panel-header"><h2 id="tool-governance-heading">@T("GovernanceAndSource")</h2></div>
                <dl class="resource-details">
                    @if (managingExtension is not null)
                    {
                        <dt>@T("ManagingExtension")</dt><dd><a class="text-button" href="@ManagingExtensionUrl">@managingExtension.DisplayName</a><br /><code>@managingExtension.ExtensionId</code> · @(tool.Governance.Origin.Version ?? managingExtension.Version ?? "—") · <ResourceScopeBadge ScopeRef="managingExtension.RegistrationScopeRef" Compact /></dd>
                    }
                    <dt>@T("TechnicalProvider")</dt><dd>@if (provider is not null) { <a href="@ProviderUrl"><code>@tool.Definition.Provider?.ResourceId</code></a> } else { <code>@tool.Definition.Provider?.ResourceId</code> }</dd>
                    <dt>@T("ExternalName")</dt><dd><code>@tool.Definition.ExternalId</code></dd>
                    <dt>@T("Enabled")</dt><dd>@BooleanLabel(tool.Definition.Enabled)</dd>
                    <dt>@T("RequiresApproval")</dt><dd>@BooleanLabel(tool.Definition.RequiresApproval)</dd>
                    <dt>@T("AvailableLabel")</dt><dd>@BooleanLabel(tool.Definition.Discovery?.Available == true)</dd>
                    <dt>@T("FirstSeen")</dt><dd>@tool.Definition.Discovery?.FirstSeenAt.ToString("g")</dd>
                    <dt>@T("LastSeen")</dt><dd>@tool.Definition.Discovery?.LastSeenAt.ToString("g")</dd>
                </dl>
            </section>
        </div>
        @if (executionVisited)
        {
        <div hidden="@(section != "execution")">
            <section class="panel tool-runner" aria-labelledby="tool-runner-heading" data-testid="tool-runner">
                <div class="panel-header"><div><h2 id="tool-runner-heading">@T("RunTool")</h2><p class="muted">@T("RunToolHelp")</p></div></div>
                <div class="tool-run-mode" role="group" aria-label="@T("RunMode")">
                    <button type="button" class="tool-run-mode-option @(runMode == ToolRunMode.Simulate ? "selected" : null)" aria-pressed="@(runMode == ToolRunMode.Simulate)" disabled="@(!CanSimulate)" data-testid="tool-run-simulate-mode" @onclick="() => SelectMode(ToolRunMode.Simulate)">
                        <span><strong>@T("Simulation")</strong><small>@T("SimulationOptionHelp")</small></span><span class="tool-run-mode-mark" aria-hidden="true">✓</span>
                    </button>
                    <button type="button" class="tool-run-mode-option execution @(runMode == ToolRunMode.Execute ? "selected" : null)" aria-pressed="@(runMode == ToolRunMode.Execute)" data-testid="tool-run-execute-mode" @onclick="() => SelectMode(ToolRunMode.Execute)">
                        <span><strong>@T("RealExecution")</strong><small>@T("ExecutionOptionHelp")</small></span><span class="tool-run-mode-mark" aria-hidden="true">✓</span>
                    </button>
                </div>
                @if (runMode == ToolRunMode.Execute)
                {
                    <p class="tool-run-mode-help execution">@T("RealExecutionHelp")</p>
                }
                else
                {
                    <p class="tool-run-mode-help">@T("SimulationHelp")</p>
                }
                @if (!CanSimulate)
                {
                    <p class="tool-run-mode-unavailable" role="status">@T("SimulationUnavailableHelp")</p>
                }
                @if (!tool.Definition.Enabled || tool.Definition.Discovery?.Available != true)
                {
                    <p class="inline-warning" role="status">@T(!tool.Definition.Enabled ? "ToolDisabledHelp" : "ToolUnavailableHelp")</p>
                }
                @if (runMode == ToolRunMode.Execute && tool.Definition.RequiresApproval)
                {
                    <p class="inline-warning" role="status">@T("ApprovalRequiredHelp")</p>
                }
                <div class="tool-run-input">
                    <div class="tool-run-input-heading">
                        <h3>@T("RunInput")</h3>
                        @if (runMode == ToolRunMode.Simulate)
                        {
                            <span class="tool-run-managed-input" data-testid="tool-run-dry-run-managed">✓ @T("DryRunManaged")</span>
                        }
                    </div>
                    <JsonSchemaInputEditor Schema="tool.Definition.Schema?.Input" Value="runInput" ValueChanged="ChangeRunInput" ValidationChanged="UpdateRunValidation" LockedValues="ManagedRunValues" Disabled="submitting" />
                </div>
                @if (runError is not null)
                {
                    <p class="error-panel" role="alert">@runError</p>
                }
                <div class="tool-run-actions">
                    <button class="button-primary" disabled="@(!CanSubmit)" data-testid="tool-run-submit" @onclick="SubmitRunAsync">@(submitting ? T("Running") : T(runMode == ToolRunMode.Simulate ? "Simulate" : "ExecuteNow"))</button>
                </div>
            </section>
            @if (runResult is not null)
            {
                <section class="panel tool-run-result" aria-labelledby="tool-run-result-heading" data-testid="tool-run-result">
                    <div class="panel-header"><h2 id="tool-run-result-heading">@T("RunResult")</h2><StatusBadge Text="@T($"RunStatus.{runResult.Status}")" Status="@(runResult.Status == "denied" ? UiStatus.Warning : UiStatus.Success)" /></div>
                    @if (runResult.Status != "denied")
                    {
                        <div class="tool-output" data-testid="tool-run-output">
                            <h3>@T("ToolOutput")</h3>
                            @if (runResult.Output is { } output)
                            {
                                <pre>@JsonSerializer.Serialize(output, IndentedJson)</pre>
                                @if (ReturnedArtifactUrl(output) is { } artifactUrl)
                                {
                                    <a class="button-secondary" href="@artifactUrl" data-testid="tool-run-open-artifact">@T("OpenReturnedArtifact")</a>
                                }
                            }
                            else
                            {
                                <p class="muted">@T("NoOutput")</p>
                            }
                        </div>
                    }
                    @if (runResult.Receipt?.FlowRunId is { Length: > 0 } flowRunId)
                    {
                        <a class="button-secondary" href="@($"/flow-runs/{Uri.EscapeDataString(flowRunId)}")">@T("OpenFlowRun")</a>
                    }
                    <div class="tool-run-facts">
                        <span><small>@T("RunMode")</small><strong>@T(runResult.Mode == ToolRunMode.Simulate ? "Simulation" : "RealExecution")</strong></span>
                        <span><small>@T("ProviderInvoked")</small><strong>@BooleanLabel(runResult.ProviderInvoked)</strong></span>
                        <span><small>@T("Provider")</small><code>@runResult.ProviderName</code></span>
                    </div>
                    <details class="tool-run-diagnostics">
                        <summary>@T("VerificationDetails")</summary>
                        <ul class="tool-run-checks">@foreach (var check in runResult.Checks) { <li class="@check.Status"><strong>@RunCheckTitle(check)</strong><span>@RunCheckMessage(check)</span></li> }</ul>
                    </details>
                </section>
            }
                </div>
        }
        @if (accessVisited && CanManage && tool.ScopeRef is { } accessOwner)
        {
            <div hidden="@(section != "access")"><ResourceAccessPanel ResourceUid="tool.Uid" DraftChanged="value => policyDirty = value" OwnerScopeRef="accessOwner" Namespace="tool.Namespace" Kind="@ToolResourceKinds.Tool" Name="@tool.Name" Generation="tool.Generation" Governance="tool.Governance" /></div>
        }
        </Content>
    </ResourceDetailsTemplate>
}

@code {
    [Parameter] public string Name { get; set; } = "";
    [SupplyParameterFromQuery(Name = "scopeRef")] public string? ScopeRefValue { get; set; }
    [SupplyParameterFromQuery(Name = "namespace")] public string? NamespaceValue { get; set; }
    private static readonly JsonSerializerOptions IndentedJson = new() { WriteIndented = true };
    private static readonly IReadOnlyDictionary<string, JsonElement> DryRunEnabled = new Dictionary<string, JsonElement>(StringComparer.Ordinal)
    {
        [ToolDryRunContract.ParameterName] = JsonSerializer.SerializeToElement(true)
    };
    private string section = "overview";
    private bool executionVisited, accessVisited, policyDirty, toggling;
    private string? loadedKey, loadError, commandError;
    private long loadVersion;
    private readonly CancellationTokenSource cancellation = new();
    private IReadOnlyList<ResourceNavigationItem> Sections => [new("overview", T("TabOverview"), "home"), new("execution", T("TabExecution"), "player-play"), new("access", T("TabAccess"), "lock") { Visible = CanManage }];
    private void SelectSection(string? value) { section = value ?? "overview"; executionVisited |= section == "execution"; accessVisited |= section == "access"; }
    private sealed record ConfigurationEntry(string Label, string Value);
    private IReadOnlyList<ConfigurationEntry> SavedConfiguration => tool is null ? [] : [new(T("TechnicalProvider"), tool.Definition.Provider?.ResourceId ?? "—"), new(T("ExternalName"), tool.Definition.ExternalId ?? "—"), new(T("Enabled"), BooleanLabel(tool.Definition.Enabled)), new(T("RequiresApproval"), BooleanLabel(tool.Definition.RequiresApproval)), new(T("AvailableLabel"), BooleanLabel(tool.Definition.Discovery?.Available == true))];
    private ToolResource? tool;
    private ToolProviderResource? provider;
    private ExtensionInventoryItemResponse? managingExtension;
    private string? etag;
    private ToolRunMode runMode = ToolRunMode.Simulate;
    private JsonElement runInput = JsonSerializer.SerializeToElement(new { });
    private bool runInputValid = true;
    private bool submitting;
    private string? runError;
    private RunToolResponse? runResult;
    private ResourceNamespace ToolNamespace => ResourceNamespace.Parse(NamespaceValue);
    private bool CanSimulate => ToolDryRunContract.IsSupported(tool?.Definition.Schema?.Input);
    private bool CanManage => tool is not null && tool.ScopeRef is { } owner && ResourceOwnershipContext.CanManage(owner, Services);
    private string NewDefinitionUrl
    {
        get
        {
            var url = $"/tools/definitions/new?toolKind=relay&source={Uri.EscapeDataString(ToolResourceIdentity.CatalogId(tool!.Namespace, tool.Name))}";
            return (Services.GetService(typeof(IConsoleNavigationContext)) as IConsoleNavigationContext)?.AddToUri(url) ?? url;
        }
    }
    private IReadOnlyDictionary<string, JsonElement>? ManagedRunValues => runMode == ToolRunMode.Simulate ? DryRunEnabled : null;
    private bool CanSubmit => tool is { Definition.Enabled: true }
        && tool.Definition.Discovery?.Available == true
        && runInputValid
        && !submitting
        && (runMode != ToolRunMode.Execute || !tool.Definition.RequiresApproval);

    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string AvailabilityLabel(bool available) => T(available ? "Available" : "Unavailable");
    private string BooleanLabel(bool value) => T(value ? "Yes" : "No");

    private string RunCheckTitle(ToolRunCheck check)
    {
        var localized = Localizer[$"RunCheckTitle.{check.Code}"];
        return localized.ResourceNotFound ? check.Code : localized.Value;
    }

    private string RunCheckMessage(ToolRunCheck check)
    {
        var statusSpecific = Localizer[$"RunCheck.{check.Code}.{check.Status}"];
        if (!statusSpecific.ResourceNotFound) return statusSpecific.Value;
        var generic = Localizer[$"RunCheck.{check.Code}"];
        return generic.ResourceNotFound ? check.Message : generic.Value;
    }

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Name}|{NamespaceValue}|{ScopeRefValue}|{ResourceOwnershipContext.TryGetCurrent(Services)}";
        if (key == loadedKey) return;
        loadedKey = key; var request = ++loadVersion;
        tool = null; provider = null; managingExtension = null; loadError = commandError = null;
        section = "overview"; executionVisited = accessVisited = policyDirty = submitting = toggling = false;
        try
        {
        var requestedName = Name; var requestedNamespace = ToolNamespace;
        ResourceScopeRef? requestedOwner = string.IsNullOrWhiteSpace(ScopeRefValue) ? null : ResourceScopeRef.Parse(ScopeRefValue);
        var value = requestedOwner is { } exactOwner
            ? await Client.GetToolAsync(exactOwner, requestedNamespace, requestedName, cancellation.Token)
            : await Client.GetToolAsync(requestedNamespace, requestedName, cancellation.Token);
        if (request != loadVersion) return;
        var saved = value.Value;
        if (saved.Name != requestedName || saved.Namespace != requestedNamespace || requestedOwner is { } owner && saved.ScopeRef != owner)
            throw new InvalidOperationException(T("ResourceIdentityMismatch"));
        ToolProviderResource? loadedProvider = null;
        ExtensionInventoryItemResponse? loadedExtension = null;
        if (Services.GetService<IExtensionsClient>() is { } extensions && saved.Definition.Provider is { } reference
            && (reference.ScopeRef ?? saved.ScopeRef) is { } providerOwner)
        {
            loadedProvider = (await Client.GetProviderAsync(providerOwner, reference.Namespace ?? saved.Namespace, reference.Name, cancellation.Token)).Value;
            if (request != loadVersion) return;
            if (loadedProvider.Definition.Aep?.Extension is { } extensionReference)
            {
                var inventory = await extensions.GetExtensionInventoryAsync(cancellation.Token);
                if (request != loadVersion) return;
                loadedExtension = inventory.SingleOrDefault(candidate =>
                    string.Equals(candidate.RegistrationName, extensionReference.Name, StringComparison.Ordinal)
                    && string.Equals(candidate.RegistrationNamespace, (extensionReference.Namespace ?? loadedProvider.Namespace).Value, StringComparison.Ordinal)
                    && candidate.RegistrationScopeRef == (extensionReference.ScopeRef ?? loadedProvider.ScopeRef));
            }
        }
        if (request != loadVersion) return;
        tool = saved; etag = value.ETag; provider = loadedProvider; managingExtension = loadedExtension;
        runMode = CanSimulate ? ToolRunMode.Simulate : ToolRunMode.Execute;
        runInput = CanSimulate
            ? ToolDryRunContract.Enable(JsonSerializer.SerializeToElement(new { }))
            : JsonSerializer.SerializeToElement(new { });
        runInputValid = true;
        runError = null;
        runResult = null;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception) { if (request == loadVersion) { tool = null; loadError = exception.Message; loadedKey = null; } }
    }

    private string ManagingExtensionUrl => managingExtension?.RegistrationName is null ? "/extensions"
        : ResourceOwnershipContext.Resource(Services, "/extensions", managingExtension.RegistrationName, ResourceNamespace.Parse(managingExtension.RegistrationNamespace), managingExtension.RegistrationScopeRef);
    private string ProviderUrl => ResourceOwnershipContext.Resource(Services, "/tools/providers", provider!.Name, provider.Namespace, provider.ScopeRef);

    private async Task ToggleAsync(bool enabled)
    {
        if (!CanManage || tool!.Governance.IsManaged || toggling) return;
        toggling = true; commandError = null; var request = loadVersion;
        try
        {
            var value = await Client.SetEnabledAsync(tool.Namespace, tool.Name, enabled, etag, cancellation.Token);
            if (request != loadVersion) return;
            tool = value.Value; etag = value.ETag;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception) { if (request == loadVersion) commandError = exception.Message; }
        finally { if (request == loadVersion) toggling = false; }
    }

    private void SelectMode(ToolRunMode mode)
    {
        if (mode == ToolRunMode.Simulate && !CanSimulate) return;
        runMode = mode;
        if (CanSimulate)
            runInput = ToolDryRunContract.Set(runInput, mode == ToolRunMode.Simulate);
        runError = null;
        runResult = null;
    }

    private void ChangeRunInput(JsonElement value) =>
        runInput = runMode == ToolRunMode.Simulate ? ToolDryRunContract.Enable(value) : value;

    private Task UpdateRunValidation(JsonSchemaInputValidationState validation)
    {
        runInputValid = validation.IsValid;
        return Task.CompletedTask;
    }

    private async Task SubmitRunAsync()
    {
        if (!CanSubmit) return;
        var version = loadVersion;
        try
        {
            submitting = true;
            runError = null;
            var request = new RunToolRequest(runInput.Clone(), runMode);
            var result = tool!.ScopeRef is { } owner
                ? await Client.RunToolAsync(owner, tool.Namespace, tool.Name, request, cancellation.Token)
                : await Client.RunToolAsync(tool.Namespace, tool.Name, request, cancellation.Token);
            if (version == loadVersion) runResult = result;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception)
        {
            if (version != loadVersion) return;
            runResult = null;
            runError = exception is AgentstrationApiException { ProblemType: "https://agentstration.dev/problems/data_source_acquisition_target_stale" }
                ? T("AcquisitionTargetStale") : exception is AgentstrationApiException { ProblemTitle: { } code } api && code.StartsWith("data_source_", StringComparison.Ordinal)
                    ? T("DataSourceQueryFailed") + " " + code + " · " + api.ErrorId : exception.Message;
        }
        finally
        {
            if (version == loadVersion) submitting = false;
        }
    }

    private string? ReturnedArtifactUrl(JsonElement output)
    {
        if (output.ValueKind != JsonValueKind.Object
            || !output.TryGetProperty("artifact", out var artifact) || artifact.ValueKind != JsonValueKind.Object
            || !artifact.TryGetProperty("artifactId", out var id) || id.ValueKind != JsonValueKind.String
            || !Guid.TryParse(id.GetString(), out var artifactId)
            || !artifact.TryGetProperty("kind", out var kind) || kind.ValueKind != JsonValueKind.String
            || kind.GetString() is not ("staged" or "durable"))
            return null;

        var url = $"/artifacts/{kind.GetString()}/{artifactId:N}";
        return (Services.GetService(typeof(IConsoleNavigationContext)) as IConsoleNavigationContext)?.AddToUri(url) ?? url;
    }

    public void Dispose() { loadVersion++; cancellation.Cancel(); cancellation.Dispose(); }

    private RenderFragment SchemaSummary(JsonElement? schema) => builder =>
    {
        if (schema is null || schema.Value.ValueKind is JsonValueKind.Null or JsonValueKind.Undefined)
        {
            builder.OpenElement(0, "p");
            builder.AddAttribute(1, "class", "tool-contract-note");
            builder.AddContent(2, T("NoSchema"));
            builder.CloseElement();
            return;
        }

        if (schema.Value.ValueKind != JsonValueKind.Object ||
            !schema.Value.TryGetProperty("properties", out var properties) ||
            properties.ValueKind != JsonValueKind.Object)
        {
            builder.OpenElement(0, "p");
            builder.AddAttribute(1, "class", "tool-contract-note");
            builder.AddContent(2, T("UnstructuredSchema"));
            builder.CloseElement();
            return;
        }

        var fields = properties.EnumerateObject().ToArray();
        if (fields.Length == 0)
        {
            builder.OpenElement(0, "p");
            builder.AddAttribute(1, "class", "tool-contract-note");
            builder.AddContent(2, T("NoProperties"));
            builder.CloseElement();
            return;
        }

        var required = new HashSet<string>(StringComparer.Ordinal);
        if (schema.Value.TryGetProperty("required", out var requiredValue) && requiredValue.ValueKind == JsonValueKind.Array)
        {
            foreach (var item in requiredValue.EnumerateArray())
            {
                if (item.ValueKind == JsonValueKind.String && item.GetString() is { } fieldName)
                {
                    required.Add(fieldName);
                }
            }
        }

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "tool-fields");
        foreach (var field in fields)
        {
            builder.OpenElement(2, "article");
            builder.AddAttribute(3, "class", "tool-field");
            builder.OpenElement(4, "div");
            builder.AddAttribute(5, "class", "tool-field-heading");
            builder.OpenElement(6, "code");
            builder.AddContent(7, field.Name);
            builder.CloseElement();
            builder.OpenElement(8, "span");
            builder.AddAttribute(9, "class", required.Contains(field.Name) ? "tool-field-required" : "tool-field-optional");
            builder.AddContent(10, T(required.Contains(field.Name) ? "Required" : "Optional"));
            builder.CloseElement();
            builder.CloseElement();

            var type = PropertyText(field.Value, "type");
            if (type is not null)
            {
                builder.OpenElement(11, "p");
                builder.AddAttribute(12, "class", "tool-field-type");
                builder.AddContent(13, T("Type", type));
                builder.CloseElement();
            }

            var description = PropertyText(field.Value, "description");
            if (!string.IsNullOrWhiteSpace(description))
            {
                builder.OpenElement(14, "p");
                builder.AddContent(15, description);
                builder.CloseElement();
            }

            var constraints = Constraints(field.Value);
            if (constraints.Count > 0)
            {
                builder.OpenElement(16, "ul");
                builder.AddAttribute(17, "class", "tool-field-constraints");
                foreach (var constraint in constraints)
                {
                    builder.OpenElement(18, "li");
                    builder.AddContent(19, constraint);
                    builder.CloseElement();
                }
                builder.CloseElement();
            }
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    private RenderFragment RawSchema(JsonElement? schema, string titleKey) => builder =>
    {
        if (schema is null || schema.Value.ValueKind is JsonValueKind.Null or JsonValueKind.Undefined)
        {
            return;
        }

        builder.OpenElement(0, "details");
        builder.AddAttribute(1, "class", "tool-raw-schema");
        builder.OpenElement(2, "summary");
        builder.AddContent(3, T(titleKey));
        builder.CloseElement();
        builder.OpenElement(4, "pre");
        builder.AddContent(5, JsonSerializer.Serialize(schema.Value, new JsonSerializerOptions { WriteIndented = true }));
        builder.CloseElement();
        builder.CloseElement();
    };

    private static string? PropertyText(JsonElement element, string name) =>
        element.ValueKind == JsonValueKind.Object && element.TryGetProperty(name, out var value) && value.ValueKind == JsonValueKind.String
            ? value.GetString()
            : null;

    private List<string> Constraints(JsonElement property)
    {
        var result = new List<string>();
        if (property.ValueKind != JsonValueKind.Object)
        {
            return result;
        }

        AddConstraint("minLength", "MinLength");
        AddConstraint("maxLength", "MaxLength");
        AddConstraint("minimum", "Minimum");
        AddConstraint("maximum", "Maximum");
        AddConstraint("pattern", "Pattern");
        AddConstraint("format", "Format");
        if (property.TryGetProperty("enum", out var allowed) && allowed.ValueKind == JsonValueKind.Array)
        {
            result.Add(T("AllowedValues", string.Join(", ", allowed.EnumerateArray().Select(item => item.ToString()))));
        }
        return result;

        void AddConstraint(string jsonName, string label)
        {
            if (property.TryGetProperty(jsonName, out var value) && value.ValueKind is not (JsonValueKind.Null or JsonValueKind.Undefined))
            {
                result.Add(T(label, value.ToString()));
            }
        }
    }
}
