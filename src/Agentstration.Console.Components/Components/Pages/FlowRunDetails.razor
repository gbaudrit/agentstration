@page "/flow-runs/{RunId}"
@implements IDisposable
@inject IFlowApiClient Client
@inject NavigationManager Navigation
@inject IConsoleRealtimeConnectionConfigurator RealtimeSession
@inject ILogger<FlowRunDetails> Logger
@inject Microsoft.Extensions.Localization.IStringLocalizer<FlowRunDetailsStrings> Localizer
@inject TimeProvider TimeProvider

<PageTitle>@(run is null ? T("FlowRun") : run.Id) · Agentstration</PageTitle>
<div data-testid="flow-observability-run-details">
@if (notFound)
{
    <ErrorState Title="@T("NotFoundTitle")" Message="@T("NotFoundMessage")">
        <a class="button-secondary" href="/flow-runs">@T("BackToRuns")</a>
    </ErrorState>
}
else if (loadError is not null)
{
    <ErrorState Title="@T("UnableToLoad")" Message="@loadError.Message" ErrorId="@loadError.ErrorId" />
}
else if (run is null)
{
    <LoadingState Message="@T("Loading")" />
}
else
{
    <PageHeader Title="@(run.ProcessOrigin is { } processTitle ? ProcessLabel(processTitle) : T("FlowRun"))" Description="@run.Id">
        <Actions><a class="button-secondary" href="@($"/flow-runs?scopeRef={Uri.EscapeDataString(run.ExecutionScopeRef.Value)}{(run.Scope.LogicalScopeRef is { } logical ? "&context=" + Uri.EscapeDataString(logical.Value) : string.Empty)}")">@T("BackToRuns")</a>@if (!run.Status.IsTerminal()) { <button class="button-danger" @onclick="CancelAsync">@T("Cancel")</button> }<a class="button-secondary" href="/tool-governance/flow/@Uri.EscapeDataString(run.Id)?scopeRef=@Uri.EscapeDataString(run.ExecutionScopeRef.Value)">@T("ToolGovernance")</a><a class="button-secondary" href="@ConsoleResourceUrls.Flow(run.FlowId, run.DefinitionScopeRef)">@T("FlowDefinition")</a></Actions>
    </PageHeader>
    @if (run.ProcessOrigin is { } process)
    {
        <div class="panel process-origin" data-testid="flow-process-origin">
            <span class="eyebrow">@T("ProcessDefinition")</span>
            <p><a href="@CausalRunUrl(process.OwnerRunId, process.OwnerStepName)">@T("ProcessOwner"): @(process.Definition.OwnerStepDisplayName ?? process.OwnerStepName)</a> · @T("ProcessAttempt", process.OwnerAttempt)</p>
            <p class="muted">@T("SourceFlow"): @process.Definition.SourceFlowId.Value · @process.Definition.SourceVersion · @T("ProcessRegion"): <code>@process.Definition.Region</code></p>
        </div>
    }
    <nav class="section-tabs flow-run-page-tabs" role="tablist" aria-label="@T("RunViewsAriaLabel")">
        @foreach (var tab in AvailableTabs)
        {
            <button id="@TabId(tab)" data-testid="@(tab == RunTab.Worker ? "flow-run-worker-tab" : null)" type="button" role="tab" aria-selected="@(activeTab == tab ? "true" : "false")" aria-controls="flow-run-tab-panel" class="@(activeTab == tab ? "active" : null)" @onclick="() => SelectTabAsync(tab)">@TabLabel(tab)</button>
        }
    </nav>
    @if (run.Error is not null && activeTab == RunTab.Summary)
    {
        <article class="panel run-error" data-testid="flow-run-error">
            @if (run.Error.Origin is { } failureOrigin && failureOrigin.RunId != run.Id)
            { <p><span class="muted">@T("FailurePropagated")</span> · <a data-testid="flow-failure-origin" href="@CausalRunUrl(failureOrigin.RunId, failureOrigin.StepName)">@T("FailureOrigin"): @failureOrigin.StepName</a></p> }
            <ContractFailurePanel Details="@(IsContractFailure(run.Error) ? run.Error.Details : RunErrorDetail(run.Error))" ErrorCode="@run.Error.Code" Message="@RunErrorMessage(run.Error)" Run="run" RelatedRuns="contractOrigins" Collapsible="true" />
        </article>
    }
    @if (pendingInput is not null)
    {
        <article class="panel input-request-panel">
            <div class="panel-header"><h2>@T("InputNeeded")</h2><span>@T("WaitingForResponse")</span></div>
            <p>@pendingInput.Prompt</p>
            @if (pendingInput.Type == InputRequestType.Text)
            {
                <input @bind="responseText" placeholder="@T("ResponsePlaceholder")" disabled="@submittingInput" />
                <button class="button-primary" @onclick="SubmitTextAsync" disabled="@(submittingInput || string.IsNullOrWhiteSpace(responseText))">@T("SendResponse")</button>
            }
            else if (pendingInput.Type == InputRequestType.Choice)
            {
                <select @bind="selectedChoice" disabled="@submittingInput">
                    <option value="">@T("SelectOption")</option>
                    @foreach (var option in pendingInput.Options) { <option value="@option">@option</option> }
                </select>
                <button class="button-primary" @onclick="SubmitChoiceAsync" disabled="@(submittingInput || string.IsNullOrWhiteSpace(selectedChoice))">@T("Continue")</button>
            }
            else
            {
                <div class="button-row">
                    <button class="button-primary" @onclick="() => SubmitConfirmationAsync(true)" disabled="@submittingInput">@T("Confirm")</button>
                    <button class="button-secondary" @onclick="() => SubmitConfirmationAsync(false)" disabled="@submittingInput">@T("Decline")</button>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(inputError)) { <p class="validation-error">@inputError</p> }
        </article>
    }
    @if (realtimeError is not null)
    {
        <div class="panel realtime-warning" role="status"><span>@realtimeError</span><button class="button-secondary" @onclick="ConnectAsync">@T("RetryLiveUpdates")</button></div>
    }
    <main id="flow-run-tab-panel" role="tabpanel" aria-labelledby="@TabId(activeTab)" tabindex="0">
        @if (activeTab == RunTab.Summary)
        {
            <article class="panel flow-run-overview">
                <section class="run-summary flow-run-overview-identity">
                    <div><span class="field-label">@T("Status")</span><StatusBadge Text="@StatusLabel(run.Status)" Status="@PlatformDashboardService.ToStatus(run.Status.ToString())" /></div>
                    <div><span class="field-label">@T("FlowAndVersion")</span><strong><a class="text-button" href="@ConsoleResourceUrls.Flow(run.FlowId, run.DefinitionScopeRef)">@run.FlowId.Value · @run.FlowVersion</a></strong></div>
                    <div data-testid="flow-run-definition-scope"><span class="field-label">@T("DefinitionScope")</span><code>@(run.DefinitionScopeRef?.Value ?? "—")</code></div>
                    <div data-testid="flow-run-execution-scope"><span class="field-label">@T("ExecutionScope")</span><code>@run.ExecutionScopeRef.Value</code></div>
                    <div><span class="field-label">@T("Deployment")</span><strong>@(run.DeploymentResourceId ?? "—")</strong></div>
                    <div><span class="field-label">@T("TriggerAndStartedBy")</span><strong>@TriggerLabel(run.Trigger) · @(run.StartedBy ?? "—")</strong></div>
                    @if (run.InvocationOrigin is { } origin) { <div><span class="field-label">@T("OriginAndCaller")</span><strong>@OriginLabel(origin) · @(run.CallerId ?? "—")</strong></div> }
                    <div><span class="field-label">@T("CorrelationId")</span><code>@run.CorrelationId</code></div>
                    @if (!string.IsNullOrWhiteSpace(run.CausationId)) { <div><span class="field-label">@T("CausationId")</span><code>@run.CausationId</code></div> }
                </section>
                <section class="token-usage-summary" data-testid="flow-run-token-usage" aria-label="@T("TokenUsageSummary")">
                    <div class="panel-header"><h2>@T("TokenUsageSummary")</h2><span>@T("TokenUsageHelp")</span></div>
                    @if (run.TokenUsage.State == FlowRunTokenUsageState.Collecting)
                    {
                        <p class="muted">@T("TokenUsageCollecting")</p>
                    }
                    else
                    {
                        var tokenUsage = run.TokenUsage;
                        <div class="token-usage-grid">
                            <article>
                                <h3>@T("DirectUsage")</h3>
                                <p>@T("DirectUsageHelp")</p>
                                <dl class="details-list token-usage-values">
                                    <dt>@T("InputTokens")</dt><dd>@TokenCount(tokenUsage.Direct.InputTokens)</dd>
                                    <dt>@T("OutputTokens")</dt><dd>@TokenCount(tokenUsage.Direct.OutputTokens)</dd>
                                    <dt>@T("CombinedTokens")</dt><dd>@TokenCount(tokenUsage.Direct.TotalTokens)</dd>
                                    <dt>@T("UsageCoverage")</dt><dd>@CoverageLabel(tokenUsage.Direct.Coverage) · @T("ReportedInvocations", tokenUsage.Direct.ReportedInvocationCount, tokenUsage.Direct.InvocationCount)</dd>
                                </dl>
                            </article>
                            <article>
                                <h3>@T("InclusiveUsage")</h3>
                                <p>@T("InclusiveUsageHelp")</p>
                                <dl class="details-list token-usage-values">
                                    <dt>@T("InputTokens")</dt><dd>@TokenCount(tokenUsage.Inclusive.InputTokens)</dd>
                                    <dt>@T("OutputTokens")</dt><dd>@TokenCount(tokenUsage.Inclusive.OutputTokens)</dd>
                                    <dt>@T("CombinedTokens")</dt><dd>@TokenCount(tokenUsage.Inclusive.TotalTokens)</dd>
                                    <dt>@T("UsageCoverage")</dt><dd>@CoverageLabel(tokenUsage.Inclusive.Coverage) · @T("ReportedInvocations", tokenUsage.Inclusive.ReportedInvocationCount, tokenUsage.Inclusive.InvocationCount)</dd>
                                </dl>
                            </article>
                        </div>
                    }
                </section>
                <FlowRunTimeline Events="eventBuffer.Snapshot()" IsLive="@(!run.Status.IsTerminal())" InferParticipantHandoffs="IsHandoffRun"
                                 View="@FlowRunTimeline.TimelineView.Summary" ShowHeader="false" ShowNavigation="false" Embedded="true" ParticipantUrls="@ParticipantUrls" />
                <section class="designer-layout run-layout flow-run-overview-topology @(inspectorVisible ? null : "inspector-collapsed")">
                    <FlowTopologyViewer ContractDescription="StepContractDescription" Graph="Topology" SelectedKey="selected?.StepName" SelectedKeyChanged="SelectStep"
                                        ShowInspectorControl="true" InspectorVisible="inspectorVisible" InspectorVisibleChanged="SetInspectorVisible"
                                        ReplayInProgress="replayInProgress" ReplayElapsed="replayElapsed" ReplayRequested="ReplaySequenceAsync"
                                        InitiallyFit="true" />
                    @if (inspectorVisible)
                    {
                    <article class="panel inspector step-inspector">
                        <div class="panel-header"><h2>@T("StepDiagnostic")</h2></div>
                        @if (selected is null)
                        {
                            <p class="muted">@T("SelectStep")</p>
                        }
                        else
                        {
                            <dl class="details-list"><dt>@T("Status")</dt><dd>@StepStatusLabel(selected.Status)</dd><dt>@T("Type")</dt><dd>@selected.StepType</dd><dt>@T("Duration")</dt><dd>@Duration(selected.StartedAt, selected.CompletedAt)</dd><dt>@T("Attempt")</dt><dd>@selected.Attempt</dd><dt>@T("Transition")</dt><dd>@(selected.SelectedTransition ?? "—")</dd><dt>@T("ChildFlowRun")</dt><dd>@if (selected.ChildFlowRunId is { } childRunId) { <a href="@($"/flow-runs/{Uri.EscapeDataString(childRunId)}?scopeRef={Uri.EscapeDataString(run.ExecutionScopeRef.Value)}")"><code>@childRunId</code></a> } else { <span>—</span> }</dd><dt>@T("Agent")</dt><dd>@(selected.AgentResourceId ?? "—")</dd><dt>@T("AgentVersion")</dt><dd>@(selected.AgentVersion?.ToString() ?? "—")</dd><dt>@T("ModelProfile")</dt><dd>@(selected.ModelProfileResourceId ?? "—")</dd><dt>@T("Provider")</dt><dd>@(selected.Provider ?? "—")</dd><dt>@T("Tokens")</dt><dd>@TokenUsage(selected.Usage)</dd><dt>@T("Tools")</dt><dd>@(selected.Tools.Count == 0 ? "—" : string.Join(", ", selected.Tools))</dd></dl>
                            @if (IsContractFailure(selected.Error))
                            { <ContractFailurePanel Details="@selected.Error!.Details" ErrorCode="@selected.Error.Code" Run="run" RelatedRuns="contractOrigins" /> }
                            <details><summary>@T("EffectiveContracts")</summary><p>@T("EffectiveContractsHelp")</p><pre>@Pretty(selected.Contracts is null ? null : JsonSerializer.SerializeToElement(selected.Contracts))</pre>
                                @foreach (var contracts in selected.ArtifactContracts) { <pre>@Pretty(JsonSerializer.SerializeToElement(contracts))</pre> }
                                @if (selected.MoreArtifactContracts) { <p>@T("AdditionalArtifactContracts")</p> }
                            </details>
                            @if (selected.Process is { } admission)
                            { <FlowProcessSummary Admission="admission" OwnerRunId="@run.Id" StepName="@selected.StepName" Scope="run.ExecutionScopeRef" LogicalScope="run.Scope.LogicalScopeRef" Nodes="@(causality?.Value ?? [])" /> }
                            @if (IsContractFailure(selected.Error))
                            { <details><summary>@T("ContractPayloadDetails")</summary>                            <span class="field-label">@T("DeclaredInput")</span><pre>@Pretty(selected.DeclaredInput)</pre><span class="field-label">@T("ResolvedInput")</span><pre>@Pretty(selected.ResolvedInput)</pre><span class="field-label">@T("Output")</span><pre>@Pretty(selected.Output)</pre><span class="field-label">@T("Logs")</span><pre>@string.Join(Environment.NewLine, selected.Logs)</pre></details> }
                            else
                            {                            <span class="field-label">@T("DeclaredInput")</span><pre>@Pretty(selected.DeclaredInput)</pre><span class="field-label">@T("ResolvedInput")</span><pre>@Pretty(selected.ResolvedInput)</pre><span class="field-label">@T("Output")</span><pre>@Pretty(selected.Output)</pre><span class="field-label">@T("Logs")</span><pre>@string.Join(Environment.NewLine, selected.Logs)</pre>
                                @if (selected.Error is not null) { <ContractFailurePanel ErrorCode="@selected.Error.Code" Message="@RunErrorMessage(selected.Error)" Details="@RunErrorDetail(selected.Error)" Collapsible="true" /> }
                            }
                        }
                    </article>
                    }
                </section>
            </article>
        }
        else if (activeTab == RunTab.Causality)
        {
            @if (causality is null)
            {
                <article class="panel"><p class="muted">@(causalityError ?? T("CausalityLoading"))</p></article>
            }
            else
            {
                <section class="causality-view" aria-label="@T("CausalityAriaLabel")">
                    <article class="panel causality-origin">
                        <div class="panel-header"><h2>@T("InvocationOrigin")</h2><span>@causality.TotalCount @T("FlowRuns")</span></div>
                        <dl class="details-list"><dt>@T("Origin")</dt><dd>@(causality.Origin.InvocationOrigin is { } origin ? OriginLabel(origin) : "—")</dd><dt>@T("Trigger")</dt><dd>@TriggerLabel(causality.Origin.Trigger)</dd><dt>@T("Caller")</dt><dd>@(causality.Origin.CallerId ?? "—")</dd><dt>@T("CausationId")</dt><dd><code>@(causality.Origin.CausationId ?? "—")</code></dd><dt>@T("CorrelationId")</dt><dd><code>@(causality.Origin.CorrelationId ?? "—")</code></dd></dl>
                    </article>
                    <ol class="causality-tree">
                        @foreach (var node in causality.Value)
                        {
                            <li @key="node.FlowRunId" style="--causality-depth:@node.NestingDepth">
                                <article class="panel causality-node">
                                    <div class="panel-header"><h2><a href="@CausalRunUrl(node.FlowRunId)">@(node.ProcessOrigin is { } processNode ? ProcessLabel(processNode) : $"{node.FlowId.Value} · {node.FlowVersion}")</a></h2><StatusBadge Text="@StatusLabel(node.Status)" Status="@PlatformDashboardService.ToStatus(node.Status.ToString())" /></div>
                                    <div class="causality-meta"><a href="@CausalRunUrl(node.FlowRunId)"><code>@node.FlowRunId</code></a><a href="@CausalRunUrl(node.FlowRunId)">@T("OpenExecution") ↗</a><span>@(node.ResolvedFromActiveReference ? T("ResolvedFromActive") : T("ExactReference"))</span>@if (node.ParentStepName is { } parentStep) { <a href="@CausalRunUrl(node.ParentFlowRunId ?? run.Id, parentStep)">@T("CalledByStep", parentStep)</a> }</div>
                                    @if (node.ProcessOrigin is { } processOrigin)
                                    { <p class="muted">@T("SourceFlow"): @processOrigin.Definition.SourceFlowId.Value · @processOrigin.Definition.SourceVersion · @T("ProcessAttempt", processOrigin.OwnerAttempt)</p> }
                                    @if (node.ErrorOrigin is { } originFailure && originFailure.RunId != node.FlowRunId)
                                    { <p><a href="@CausalRunUrl(originFailure.RunId, originFailure.StepName)">@T("FailureOrigin"): @originFailure.StepName</a></p> }
                                    @foreach (var owned in node.Processes)
                                    { <FlowProcessSummary Admission="owned.Value" OwnerRunId="@node.FlowRunId" StepName="@owned.Key" Scope="run.ExecutionScopeRef" LogicalScope="run.Scope.LogicalScopeRef" Nodes="causality.Value" /> }
                                    <FlowRunCausalityOutput RunId="@node.FlowRunId" Scope="run.ExecutionScopeRef" LogicalScope="run.Scope.LogicalScopeRef" Status="node.Status" Root="run" />
                                    @if (node.AgentExecutions.Count > 0)
                                    {
                                        <h3>@T("AgentExecutions")</h3>
                                        <ul class="causality-details">@foreach (var agent in node.AgentExecutions) { <li><strong>@agent.StepName</strong><span>@agent.AgentResourceId @if (agent.AgentVersion is { } version) { <text>· v@(version)</text> }</span><span>@StepStatusLabel(agent.Status) · @(agent.Provider ?? "—")</span></li> }</ul>
                                    }
                                    @if (node.ToolCalls.Count > 0)
                                    {
                                        <h3>@T("ToolCalls")</h3>
                                        <ul class="causality-details">
                                            @foreach (var tool in node.ToolCalls)
                                            {
                                                <li><strong>@if (tool.ToolId is { } toolId) { <a href="@($"/tools/{Uri.EscapeDataString(toolId)}")">@(tool.ToolName ?? toolId)</a> } else { <text>@(tool.ToolName ?? tool.LogicalCallId)</text> }</strong><span>@T("LogicalCall") <a href="@GovernanceUrl(node.FlowRunId, tool.LogicalCallId)"><code>@tool.LogicalCallId</code></a></span><span>@T("Provider"): @if (tool.ProviderId is { } providerId) { <a href="@($"/tools/providers/{Uri.EscapeDataString(providerId)}")">@providerId</a> } else { <text>—</text> } · @tool.Status</span>
                                                    <ul class="tool-attempts">@foreach (var attempt in tool.Attempts) { <li><span>@T("Attempt") @attempt.Attempt · @attempt.Status</span><a href="@GovernanceUrl(node.FlowRunId, tool.LogicalCallId, attempt.InvocationId)">@T("GovernanceEvaluations", attempt.GovernanceEvaluationCount)</a></li> }</ul>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </article>
                            </li>
                        }
                    </ol>
                </section>
            }
        }
        else if (activeTab == RunTab.InputOutput)
        {
            <section class="flow-run-io-panels" aria-label="@T("RunInputAndOutput")">
                <article class="panel io-panel flow-run-tab-card"><div class="panel-header"><h2>@T("Input")</h2></div><pre>@Pretty(run.Input)</pre></article>
                <FlowRunOutput Run="run" />
            </section>
        }
        else if (activeTab == RunTab.Worker)
        {
            <RuntimePlacementSummary TargetKind="RuntimeAssignmentTargetKind.FlowRun" RunId="@(run.RootFlowRunId ?? run.Id)" ScopeRef="@run.ExecutionScopeRef" />
        }
        else
        {
            <FlowRunTimeline Events="eventBuffer.Snapshot()" IsLive="@(!run.Status.IsTerminal())" InferParticipantHandoffs="IsHandoffRun"
                             View="@SelectedTimelineView" ShowHeader="false" ShowNavigation="false" />
        }
    </main>
}

</div>
@code {
    [Parameter] public string RunId { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "step")] public string? FocusStep { get; set; }
    [SupplyParameterFromQuery(Name = "scopeRef")] public string? ScopeRef { get; set; }
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string StatusLabel(FlowRunStatus value) => Localizer[$"Status.{value}"];
    private string TriggerLabel(FlowRunTrigger value) => Localizer[$"Trigger.{value}"];
    private string OriginLabel(FlowInvocationOrigin value) => Localizer[$"Origin.{value}"];
    private string StepStatusLabel(FlowStepRunStatus value) => Localizer[$"StepStatus.{value}"];
    private string TokenUsage(FlowStepRunUsage? usage) => usage is null
        ? T("UnavailableValue")
        : T("TokenUsage", TokenCount(usage.InputTokens), TokenCount(usage.OutputTokens));
    private string TokenCount(long? value) => value?.ToString(System.Globalization.CultureInfo.CurrentCulture) ?? T("UnavailableValue");
    private string CoverageLabel(FlowRunTokenUsageCoverage coverage) => T($"UsageCoverage.{coverage}");
    private readonly CancellationTokenSource cancellation = new();
    private readonly FlowRunEventBuffer eventBuffer = new();
    private FlowRun? run;
    private FlowRunCausalityPageResponse? causality;
    private string ProcessLabel(FlowProcessRunOrigin process) => T("ProcessRun", process.Definition.OwnerStepDisplayName ?? process.OwnerStepName, process.Ordinal + 1);
    private string CausalRunUrl(string id, string? step = null) => FlowRunInspection.RunUrl(id, run!.ExecutionScopeRef, run.Scope.LogicalScopeRef, step);
    private string? causalityError;
    private InputRequest? pendingInput;
    private FlowStepRun? selected;
    private Microsoft.AspNetCore.SignalR.Client.HubConnection? hub;
    private AgentstrationApiException? loadError;
    private bool notFound;
    private string? realtimeError;
    private bool IsHandoffRun => run?.DefinitionSnapshot.Definition is OrchestrationFlowDefinition { Pattern: HandoffOrchestrationPattern };
    private int streamingRenderScheduled;
    private string responseText = string.Empty;
    private string selectedChoice = string.Empty;
    private string? inputError;
    private bool submittingInput;
    private bool inspectorVisible;
    private bool replayInProgress;
    private long? replaySequence;
    private TimeSpan? replayElapsed;
    private IReadOnlyList<FlowRunEvent>? replayEvents;
    private CancellationTokenSource? replayCancellation;
    private RunTab activeTab;
    private static readonly RunTab[] StandardTabs = [RunTab.Summary, RunTab.Worker, RunTab.Causality, RunTab.Activity, RunTab.InputOutput, RunTab.RawEvents];
    private static readonly RunTab[] HandoffTabs = [RunTab.Summary, RunTab.Worker, RunTab.Causality, RunTab.Activity, RunTab.Handoffs, RunTab.InputOutput, RunTab.RawEvents];
    private IReadOnlyList<RunTab> AvailableTabs => IsHandoffRun ? HandoffTabs : StandardTabs;
    private IReadOnlyDictionary<string, string> ParticipantUrls => BuildParticipantUrls();
    private FlowRunTimeline.TimelineView SelectedTimelineView => activeTab switch
    {
        RunTab.Activity => FlowRunTimeline.TimelineView.Activity,
        RunTab.Handoffs => FlowRunTimeline.TimelineView.Handoffs,
        RunTab.RawEvents => FlowRunTimeline.TimelineView.Raw,
        _ => FlowRunTimeline.TimelineView.Summary
    };
    private IReadOnlyList<FlowRunEvent> TopologyEvents => replayEvents is null || replaySequence is null
        ? eventBuffer.Snapshot()
        : replayEvents.Where(runEvent => runEvent.Sequence <= replaySequence.Value).ToArray();
    private FlowTopologyGraph Topology => run is null
        ? new([], [], "horizontal", T("FlowTopology"))
        : FlowTopologyProjector.ProjectPreview(replayEvents is null ? run : ReplaySnapshot(run, TopologyEvents), TopologyEvents);

    private string TabLabel(RunTab tab) => T(tab switch
    {
        RunTab.Summary => "Summary",
        RunTab.Worker => "Worker",
        RunTab.Causality => "Causality",
        RunTab.Activity => "Activity",
        RunTab.Handoffs => "Handoffs",
        RunTab.InputOutput => "InputOutputTab",
        RunTab.RawEvents => "RawEvents",
        _ => throw new ArgumentOutOfRangeException(nameof(tab))
    });
    private static string TabId(RunTab tab) => $"flow-run-tab-{tab.ToString().ToLowerInvariant()}";

    private IReadOnlyDictionary<string, string> BuildParticipantUrls()
    {
        if (run?.DefinitionSnapshot.Definition is not OrchestrationFlowDefinition orchestration) return new Dictionary<string, string>(StringComparer.Ordinal);
        return orchestration.Participants.ToDictionary(
            participant => participant.Id,
            participant => ParticipantUrl(participant, run.FlowId.Namespace),
            StringComparer.Ordinal);
    }

    private static string ParticipantUrl(FlowTargetReference participant, ResourceNamespace ownerNamespace)
    {
        var @namespace = participant.Namespace ?? ownerNamespace;
        if (participant.Kind == FlowTargetKind.Flow) return ConsoleResourceUrls.Flow(new FlowId(participant.Id, @namespace));
        return @namespace.IsDefault
            ? $"/agents/{Uri.EscapeDataString(participant.Id)}"
            : $"/namespaces/{Uri.EscapeDataString(@namespace.Value)}/agents/{Uri.EscapeDataString(participant.Id)}";
    }

    private IReadOnlyList<FlowRun> contractOrigins = [];
    private static bool IsContractFailure(FlowRunError? error) => error is not null && (ContractFailurePanel.IsContractCode(error.Code) || Agentstration.Schemas.DataContracts.ParseFailure(error.Details) is not null);
    protected override async Task OnParametersSetAsync()
    {
        replayCancellation?.Cancel();
        notFound = false;
        loadError = null;
        realtimeError = null;
        try
        {
            run = string.IsNullOrWhiteSpace(ScopeRef)
                ? await Client.GetFlowRunAsync(RunId, cancellation.Token)
                : await Client.GetFlowRunAsync(RunId, ResourceScopeRef.Parse(ScopeRef), cancellation.Token);
        }
        catch (AgentstrationApiException exception) when (exception.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            run = null;
            notFound = true;
            return;
        }
        catch (AgentstrationApiException exception)
        {
            run = null;
            loadError = exception;
            return;
        }
        await RefreshInputAsync();
        await RefreshCausalityAsync();
        contractOrigins = await FlowRunInspection.ReadErrorOriginsAsync(Client, run!, cancellation.Token);
        if (!IsHandoffRun && activeTab == RunTab.Handoffs) activeTab = RunTab.Summary;
        selected = run.Steps.FirstOrDefault(step => step.StepName == FocusStep) ?? run.Steps.FirstOrDefault();
        if (!string.IsNullOrEmpty(FocusStep)) { activeTab = RunTab.Summary; inspectorVisible = true; }
        eventBuffer.Clear();
        await ReplayAsync();
        if (!run.Status.IsTerminal()) await ConnectAsync();
    }

    private async Task ConnectAsync()
    {
        if (hub is not null) await hub.DisposeAsync();
        var endpoint = Navigation.ToAbsoluteUri("/hubs/flow-runs");
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (query.TryGetValue("context", out var context))
            endpoint = new Uri(Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(endpoint.AbsoluteUri, "context", context.ToString()));
        hub = new Microsoft.AspNetCore.SignalR.Client.HubConnectionBuilder()
            .WithUrl(endpoint, options => RealtimeSession.Configure(endpoint, options))
            .WithAutomaticReconnect()
            .Build();
        hub.On<FlowRunEvent>("FlowRunEvent", ApplyEventAsync);
        hub.Reconnected += async _ => await SubscribeAndReplayAsync();
        try
        {
            await hub.StartAsync(cancellation.Token);
            await SubscribeAndReplayAsync();
            realtimeError = null;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Flow Run live updates are unavailable for {FlowRunId}", RunId);
            realtimeError = T("LiveUpdatesUnavailable");
            await hub.DisposeAsync();
            hub = null;
            await ReplayAsync();
        }
    }

    private async Task SubscribeAndReplayAsync()
    {
        await hub!.InvokeAsync("SubscribeAsync", RunId, run!.ExecutionScopeRef.Value, cancellation.Token);
        await ReplayAsync();
        // Persisted state is authoritative even when a reconnect has no new notification to replay.
        await RefreshRunAsync();
    }

    private async Task ReplayAsync()
    {
        var replay = await Client.GetFlowRunEventsAsync(RunId, run!.ExecutionScopeRef, eventBuffer.LastSequence, cancellation.Token);
        foreach (var runEvent in replay) AddEvent(runEvent);
        if (replay.Count > 0) await RefreshRunAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ApplyEventAsync(FlowRunEvent runEvent)
    {
        if (!AddEvent(runEvent)) return;
        if (runEvent.Type == FlowRunEventType.StepOutputDelta)
        {
            ScheduleStreamingRender();
            return;
        }
        await RefreshRunAsync();
        await InvokeAsync(StateHasChanged);
    }

    private bool AddEvent(FlowRunEvent runEvent)
    {
        return eventBuffer.TryAdd(runEvent);
    }

    private async Task RefreshRunAsync()
    {
        run = await Client.GetFlowRunAsync(RunId, run!.ExecutionScopeRef, cancellation.Token);
        await RefreshInputAsync();
        if (selected is not null) selected = run.Steps.FirstOrDefault(value => value.StepName == selected.StepName);
        await RefreshCausalityAsync();
        contractOrigins = await FlowRunInspection.ReadErrorOriginsAsync(Client, run!, cancellation.Token);
    }

    private async Task RefreshCausalityAsync()
    {
        try
        {
            causality = await Client.GetFlowRunCausalityAsync(RunId, run!.ExecutionScopeRef, cancellation.Token);
            causalityError = null;
        }
        catch (NotSupportedException) { causality = null; }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Flow Run causality is unavailable for {FlowRunId}", RunId);
            causality = null;
            causalityError = T("CausalityUnavailable");
        }
    }

    private async Task SelectTabAsync(RunTab tab)
    {
        activeTab = tab;
        if (tab == RunTab.Causality && causality is null) await RefreshCausalityAsync();
    }

    private string GovernanceUrl(string flowRunId, string toolCallId, string? invocationId = null) =>
        $"/tool-governance/flow/{Uri.EscapeDataString(flowRunId)}?scopeRef={Uri.EscapeDataString(run!.ExecutionScopeRef.Value)}&toolCallId={Uri.EscapeDataString(toolCallId)}"
        + (invocationId is null ? string.Empty : $"&invocationId={Uri.EscapeDataString(invocationId)}");

    private async Task RefreshInputAsync()
    {
        pendingInput = run?.Status == FlowRunStatus.WaitingForInput
            ? (await Client.GetFlowRunInputsAsync(RunId, run.ExecutionScopeRef, cancellation.Token)).FirstOrDefault()
            : null;
    }

    private Task SubmitTextAsync() => SubmitInputAsync(JsonSerializer.SerializeToElement(responseText));
    private Task SubmitChoiceAsync() => SubmitInputAsync(JsonSerializer.SerializeToElement(selectedChoice));
    private Task SubmitConfirmationAsync(bool value) => SubmitInputAsync(JsonSerializer.SerializeToElement(value));

    private async Task SubmitInputAsync(JsonElement value)
    {
        if (pendingInput is null) return;
        try
        {
            submittingInput = true;
            inputError = null;
            await Client.RespondToFlowRunInputAsync(RunId, pendingInput.Id, run!.ExecutionScopeRef, value, cancellation.Token);
            pendingInput = null;
            await RefreshRunAsync();
        }
        catch (Exception exception) { inputError = exception.Message; }
        finally { submittingInput = false; }
    }

    private void ScheduleStreamingRender()
    {
        if (Interlocked.Exchange(ref streamingRenderScheduled, 1) != 0) return;
        _ = FlushStreamingRenderAsync();
    }

    private async Task FlushStreamingRenderAsync()
    {
        var renderedSequence = eventBuffer.LastSequence;
        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(150), cancellation.Token);
            renderedSequence = eventBuffer.LastSequence;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        finally
        {
            Volatile.Write(ref streamingRenderScheduled, 0);
            if (!cancellation.IsCancellationRequested && eventBuffer.LastSequence > renderedSequence) ScheduleStreamingRender();
        }
    }

    private void SelectStep(string name) => selected = run?.Steps.FirstOrDefault(value => value.StepName == name);
    private void SetInspectorVisible(bool value) => inspectorVisible = value;
    private async Task ReplaySequenceAsync()
    {
        if (replayInProgress) return;
        var events = eventBuffer.Snapshot().OrderBy(runEvent => runEvent.Sequence).ToArray();
        var frames = events.Where(IsReplayFrame).DistinctBy(runEvent => runEvent.Sequence).ToArray();
        if (frames.Length == 0) return;

        var replaySource = CancellationTokenSource.CreateLinkedTokenSource(cancellation.Token);
        replayCancellation = replaySource;
        replayEvents = events;
        replayInProgress = true;
        replayElapsed = TimeSpan.Zero;
        var frameDelay = TimeSpan.FromMilliseconds(Math.Clamp(15000d / frames.Length, 20, 650));
        var startedAt = frames.FirstOrDefault(runEvent => runEvent.Type is FlowRunEventType.FlowRunStarted or FlowRunEventType.FlowRunResumed)?.Timestamp
            ?? frames[0].Timestamp;
        try
        {
            replaySequence = 0;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(TimeSpan.FromMilliseconds(300), TimeProvider, replaySource.Token);
            for (var index = 0; index < frames.Length; index++)
            {
                var frame = frames[index];
                replaySequence = frame.Sequence;
                replayElapsed = ElapsedSince(startedAt, frame.Timestamp);
                await InvokeAsync(StateHasChanged);
                if (index + 1 < frames.Length)
                {
                    var nextElapsed = ElapsedSince(startedAt, frames[index + 1].Timestamp);
                    await AdvanceReplayCounterAsync(replayElapsed.Value, nextElapsed, frameDelay, replaySource.Token);
                }
            }
            await Task.Delay(TimeSpan.FromMilliseconds(450), TimeProvider, replaySource.Token);
        }
        catch (OperationCanceledException) when (replaySource.IsCancellationRequested) { }
        finally
        {
            if (ReferenceEquals(replayCancellation, replaySource))
            {
                replayCancellation = null;
                replayEvents = null;
                replaySequence = null;
                replayElapsed = null;
                replayInProgress = false;
                if (!cancellation.IsCancellationRequested) await InvokeAsync(StateHasChanged);
            }
            replaySource.Dispose();
        }
    }

    private async Task AdvanceReplayCounterAsync(TimeSpan from, TimeSpan to, TimeSpan duration, CancellationToken cancellationToken)
    {
        const double tickMilliseconds = 50;
        var steps = Math.Max(1, (int)Math.Ceiling(duration.TotalMilliseconds / tickMilliseconds));
        var delay = TimeSpan.FromMilliseconds(duration.TotalMilliseconds / steps);
        for (var step = 1; step <= steps; step++)
        {
            await Task.Delay(delay, TimeProvider, cancellationToken);
            replayElapsed = from + ((to - from) * ((double)step / steps));
            await InvokeAsync(StateHasChanged);
        }
    }

    private static TimeSpan ElapsedSince(DateTimeOffset startedAt, DateTimeOffset timestamp) =>
        timestamp <= startedAt ? TimeSpan.Zero : timestamp - startedAt;

    private static bool IsReplayFrame(FlowRunEvent runEvent) => runEvent.Type is
        FlowRunEventType.FlowRunStarted or FlowRunEventType.FlowRunResumed or
        FlowRunEventType.StepRunStarted or FlowRunEventType.StepRunCompleted or FlowRunEventType.StepRunFailed or
        FlowRunEventType.ParticipantTurnStarted or FlowRunEventType.ParticipantTurnCompleted or FlowRunEventType.ParticipantHandoff or
        FlowRunEventType.FlowRunCompleted or FlowRunEventType.FlowRunFailed or FlowRunEventType.FlowRunCancelled or FlowRunEventType.FlowRunTimedOut;

    private static FlowRun ReplaySnapshot(FlowRun source, IReadOnlyList<FlowRunEvent> visibleEvents)
    {
        var terminal = visibleEvents.Any(runEvent => runEvent.Type is FlowRunEventType.FlowRunCompleted or FlowRunEventType.FlowRunFailed or FlowRunEventType.FlowRunCancelled or FlowRunEventType.FlowRunTimedOut);
        var started = visibleEvents.Any(runEvent => runEvent.Type is not FlowRunEventType.FlowRunCreated);
        return source with
        {
            Status = terminal ? source.Status : started ? FlowRunStatus.Running : FlowRunStatus.Pending,
            Steps = source.Steps.Select(step => ReplayStep(step, visibleEvents, terminal)).ToArray()
        };
    }

    private static FlowStepRun ReplayStep(FlowStepRun source, IReadOnlyList<FlowRunEvent> visibleEvents, bool terminal)
    {
        if (terminal) return source;
        var events = visibleEvents
            .Where(runEvent => string.Equals(runEvent.StepId, source.StepName, StringComparison.Ordinal))
            .OrderBy(runEvent => runEvent.Sequence)
            .ToArray();
        var latest = events.LastOrDefault(runEvent => runEvent.Type is
            FlowRunEventType.StepRunStarted or FlowRunEventType.StepRunCompleted or FlowRunEventType.StepRunFailed or
            FlowRunEventType.ParticipantTurnStarted or FlowRunEventType.ParticipantTurnCompleted);
        var status = latest?.Type switch
        {
            FlowRunEventType.StepRunStarted or FlowRunEventType.ParticipantTurnStarted => FlowStepRunStatus.Running,
            FlowRunEventType.StepRunCompleted or FlowRunEventType.ParticipantTurnCompleted => FlowStepRunStatus.Succeeded,
            FlowRunEventType.StepRunFailed => FlowStepRunStatus.Failed,
            _ => FlowStepRunStatus.NotStarted
        };
        var startedAt = events.FirstOrDefault(runEvent => runEvent.Type is FlowRunEventType.StepRunStarted or FlowRunEventType.ParticipantTurnStarted)?.Timestamp;
        var completedAt = events.LastOrDefault(runEvent => runEvent.Type is FlowRunEventType.StepRunCompleted or FlowRunEventType.StepRunFailed or FlowRunEventType.ParticipantTurnCompleted)?.Timestamp;
        return source with
        {
            Status = status,
            StartedAt = startedAt,
            CompletedAt = completedAt,
            SelectedTransition = status is FlowStepRunStatus.Succeeded or FlowStepRunStatus.Failed ? source.SelectedTransition : null
        };
    }

    private async Task CancelAsync() => run = await Client.CancelFlowRunAsync(RunId, run!.ExecutionScopeRef, cancellation.Token);
    private string? StepContractDescription(string name) => run?.Steps.FirstOrDefault(step => step.StepName == name)?.Contracts is { } contracts
        ? T("EffectiveContracts") + ": " + JsonSerializer.Serialize(contracts) : null;
    private string RunErrorMessage(FlowRunError error) => error.Code switch
    {
        "data_contract_encoding_invalid" => T("Error.ContractEncodingInvalid"),
        "data_contract_json_invalid" => T("Error.ContractJsonInvalid"),
        "data_contract_unresolved" => T("Error.ContractUnresolved"),
        "data_contract_violation" or "flow_composition_value_invalid" => T("Error.ContractViolation"),
        "data_contract_media_mismatch" => T("Error.ContractMediaMismatch"),
        "data_contract_conflict" => T("Error.ContractConflict"),
        "tool_contract_required" => T("Error.ToolContractRequired"),
        "tool_contract_stale" => T("Error.ToolContractStale"),
        "artifact_processing_json_invalid" => T("Error.ArtifactOutputJsonInvalid"),
        "artifact_processing_input_json_invalid" => T("Error.ArtifactInputJsonInvalid"),
        "agent_model_profile_unavailable" => T("Error.AgentModelProfileUnavailable"),
        "model_output_token_limit" => T("Error.ModelOutputTokenLimit"),
        "model_empty_response" => T("Error.ModelEmptyResponse"),
        _ => error.Message
    };
    private static string? RunErrorDetail(FlowRunError error) => error.Code == "agent_model_profile_unavailable"
        ? error.Message : DataContracts.ParseFailure(error.Details) is not null ? SelectedFailureDetails(error.Details!) : error.Details;
    private static string? SelectedFailureDetails(string details)
    {
        using var document = JsonDocument.Parse(details);
        return document.RootElement.TryGetProperty("details", out var selected) && selected.ValueKind == JsonValueKind.String ? selected.GetString() : null;
    }
    private static string Pretty(JsonElement value) => JsonSerializer.Serialize(value, new JsonSerializerOptions { WriteIndented = true });
    private static string Pretty(JsonElement? value) => value is null ? "—" : Pretty(value.Value);
    private static string Duration(DateTimeOffset? start, DateTimeOffset? end) { if (start is null) return "—"; var value = (end ?? DateTimeOffset.UtcNow) - start.Value; return value.TotalSeconds >= 1 ? $"{value.TotalSeconds:0.##} s" : $"{value.TotalMilliseconds:0} ms"; }

    public void Dispose()
    {
        replayCancellation?.Cancel();
        cancellation.Cancel();
        if (hub is not null) _ = hub.DisposeAsync();
        cancellation.Dispose();
    }

    private enum RunTab { Summary, Worker, Causality, Activity, Handoffs, InputOutput, RawEvents }
}
