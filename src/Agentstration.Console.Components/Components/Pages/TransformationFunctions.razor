@page "/transformation-functions"
@page "/function-kinds"
@implements IDisposable
@using Agentstration.Functions.Contracts
@inject ITransformationFunctionsClient Client
@inject IServiceProvider Services
@inject ConsoleContextState Context
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<FunctionStrings> Localizer

<PageTitle>@T("Title") · Agentstration</PageTitle>
<div class="transformation-function-catalogs" data-testid="transformation-functions">
<ResourceCollectionTemplate TItem="TransformationFunctionResource" Title="@T("Title")" Description="@T("Description")" TestId="function-catalog" ContextKey="@contextKey"
                            IdentityColumn="FunctionIdentity" Columns="FunctionColumns" Items="@(functions.Items ?? [])" RowTestId="transformation-function-row"
                            Query="functions.Query" QueryChanged="ChangeFunctionsAsync" Pagination="functions.Pagination" LoadState="functions.LoadState" Disabled="@(!interactive)"
                            EmptyTitle="@T("Empty")" OnRefresh="LoadFunctionsAsync" OnRetry="RetryFunctionsAsync">
    <PrimaryActions>@if (CanCreate) { <a class="button-primary" href="@ScopedUri("/transformation-functions/new")">@T("Create")</a> }</PrimaryActions>
    <EmptyActions>@if (CanCreate) { <a class="button-primary" href="@ScopedUri("/transformation-functions/new")">@T("Create")</a> }</EmptyActions>
    <ItemActions Context="item"><CollectionActions ResourceName="@item.Name">
        <a href="@(Url(item) + "#overview")"><UiIcon Name="arrow-up-right" />@Shared["OpenItem"]</a>
        @if (CanPreviewEdit(item)) { <a href="@(Url(item) + "#definition/configuration")"><UiIcon Name="pencil" />@Shared["EditDefinition"]</a> }
        <button type="button" disabled="@(item.ScopeRef is null)" data-testid="transformation-function-preview" @onclick="() => OpenPreview(item)"><UiIcon Name="eye" />@Shared["Preview"]</button>
    </CollectionActions></ItemActions>
</ResourceCollectionTemplate>

<section class="resource-section" aria-label="@T("Kinds")">
<ResourceCollectionTemplate TItem="FunctionKindResource" Title="@T("Kinds")" TestId="function-kinds-catalog" ContextKey="@contextKey"
                            IdentityColumn="KindIdentity" Columns="KindColumns" Items="@(kinds.Items ?? [])" RowTestId="function-kind-row"
                            Query="kinds.Query" QueryChanged="ChangeKindsAsync" Pagination="kinds.Pagination" LoadState="kinds.LoadState" Disabled="@(!interactive || savingKind)"
                            IsExpanded="@(kind => expandedKinds.Contains(KindKey(kind)))" OnRefresh="LoadKindsAsync" OnRetry="RetryKindsAsync">
    <Feedback>@if (operationError is not null) { <div role="alert" class="form-alert form-alert-danger"><p>@T("Error")</p><details><summary>@T("Details")</summary><pre>@operationError.Message</pre></details><button class="button-secondary" @onclick="LoadKindsAsync">@T("Refresh")</button></div> }</Feedback>
    <ItemActions Context="kind"><CollectionActions ResourceName="@kind.Definition.DisplayName">
        <a href="@(KindUrl(kind) + "#overview")"><UiIcon Name="arrow-up-right" />@Shared["OpenItem"]</a>
        <button type="button" disabled="@(kind.ScopeRef is null)" data-testid="function-kind-preview" @onclick="() => OpenKindPreview(kind)"><UiIcon Name="eye" />@Shared["Preview"]</button>
        <button type="button" class="button-secondary" aria-expanded="@(expandedKinds.Contains(KindKey(kind)).ToString().ToLowerInvariant())" @onclick="() => ToggleKindDetails(kind)">@T("Details")</button>
        @if (CanToggle(kind)) { <button type="button" class="button-secondary" disabled="@(savingKind || kinds.LoadState.Status is ResourceLoadStatus.Loading or ResourceLoadStatus.Refreshing)" @onclick="() => ToggleKindAsync(kind)">@T(kind.Definition.Enabled ? "Disable" : "Enable")</button> }
    </CollectionActions></ItemActions>
            <Details Context="kind"><FunctionKindResourceSummary Resource="kind" ShowIdentity="false" ConfigurationInitiallyCollapsed="false" /></Details>
</ResourceCollectionTemplate>
</section>
</div>

<ResourceCollectionPreview @ref="preview" ResourceKind="@FunctionResourceKinds.TransformationFunction" ContextKey="@contextKey" Enabled="@(contextKey is not null && Context.Error is null && functions.LoadState.Status != ResourceLoadStatus.Forbidden && Context.HasPermission(AuthorizationPermissions.ResourcesRead))">
    <ChildContent Context="address"><TransformationFunctionResourcePreview Address="address" OverviewHref="@PreviewUrl(address, "overview")" DefinitionHref="@PreviewUrl(address, "definition/configuration")" /></ChildContent>
</ResourceCollectionPreview>

<ResourceCollectionPreview @ref="kindPreview" ResourceKind="@FunctionResourceKinds.FunctionKind" ContextKey="@contextKey" Enabled="@(contextKey is not null && Context.Error is null && kinds.LoadState.Status != ResourceLoadStatus.Forbidden && Context.HasPermission(AuthorizationPermissions.ResourcesRead))">
    <ChildContent Context="address"><FunctionKindResourcePreview Address="address" OverviewHref="@KindPreviewUrl(address)" DefinitionHref="@KindPreviewUrl(address)" /></ChildContent>
</ResourceCollectionPreview>

@code {
    private ResourceCollectionPreview? kindPreview;
    private string KindUrl(FunctionKindResource resource) => ResourceOwnershipContext.Resource(Services, "/function-kinds", resource.Name, resource.Namespace, resource.ScopeRef);
    private string KindPreviewUrl(ScopedResourceAddress address) => ResourceOwnershipContext.Resource(Services, "/function-kinds", address.Name, address.Namespace, address.ScopeRef).Split('#')[0] + "#overview";
    private void OpenKindPreview(FunctionKindResource resource) { if (resource.ScopeRef is { } owner) kindPreview?.Open(ScopedResourceAddress.Create(owner, resource.Namespace, FunctionResourceKinds.FunctionKind, resource.Name)); }
    private ResourceCollectionPreview? preview;
    private bool CanPreviewEdit(TransformationFunctionResource item) => !item.Governance.IsManaged && Context.HasPermission(AuthorizationPermissions.ResourcesWrite) && item.ScopeRef?.Value == Context.Current?.SelectedScopeRef && ResourceOwnershipContext.CanManage(item.ScopeRef, Services);
    private void OpenPreview(TransformationFunctionResource item) { if (item.ScopeRef is { } owner) preview?.Open(ScopedResourceAddress.Create(owner, item.Namespace, FunctionResourceKinds.TransformationFunction, item.Name)); }
    private string PreviewUrl(ScopedResourceAddress address, string section) => ResourceOwnershipContext.Resource(Services, "/transformation-functions", address.Name, address.Namespace, address.ScopeRef).Split('#')[0] + "#" + section;
    private string T(string key) => Localizer[key];
    private static string? ImplementationId(TransformationFunctionResource resource) => resource.Definition.Versions.LastOrDefault()?.Configuration is { ValueKind: JsonValueKind.Object } configuration
        && configuration.TryGetProperty("implementation", out var implementation) && implementation.TryGetProperty("id", out var id)
        && id.ValueKind == JsonValueKind.String ? id.GetString() : null;
    private CollectionColumn<TransformationFunctionResource> FunctionIdentity => new("identity", T("Functions"), item => @<CollectionIdentity DisplayName="@item.Definition.DisplayName" Namespace="@item.Namespace.Value" Name="@item.Name" Href="@(Url(item) + "#overview")" IconName="cube"><IconBadges><ResourceScopeBadge ScopeRef="item.ScopeRef" IconOnly /><StatusBadge Text="@T(item.Definition.Enabled ? "Enabled" : "Disabled")" Status="@(item.Definition.Enabled ? UiStatus.Success : UiStatus.Neutral)" IconOnly /><ManagedResourceBadge IsManaged="@item.Governance.IsManaged" IsReadOnly="@(!ResourceOwnershipContext.CanManage(item.ScopeRef, Services))" IconOnly /></IconBadges><Badges>@if (item.Governance.Origin.Kind == ResourceOriginKind.BuiltIn) { <small>@T("BuiltIn")</small> }</Badges></CollectionIdentity>);
    private IReadOnlyList<CollectionColumn<TransformationFunctionResource>> FunctionColumns =>
    [
        new("kind", T("Kind"), item => @<span class="function-kind">@string.Join(", ", item.Definition.Versions.Select(version => version.FunctionKind.Name).Distinct(StringComparer.Ordinal))</span>),
        new("versions", T("Version"), item => @<text>@string.Join(", ", item.Definition.Versions.Select(value => value.Version))</text>),
        new("description", T("FunctionDescription"), item => @<FunctionDescription Description="@item.Definition.Description" ImplementationId="@ImplementationId(item)" BuiltIn="@(item.Governance.Origin.Kind == ResourceOriginKind.BuiltIn)" />)
    ];
    private CollectionColumn<FunctionKindResource> KindIdentity => new("identity", T("Kinds"), kind => @<CollectionIdentity DisplayName="@kind.Definition.DisplayName" Namespace="@kind.Namespace.Value" Name="@kind.Name" Href="@(KindUrl(kind) + "#overview")" IconName="layers"><IconBadges><ResourceScopeBadge ScopeRef="kind.ScopeRef" IconOnly /><StatusBadge Text="@T(kind.Definition.Enabled ? "Enabled" : "Disabled")" Status="@(kind.Definition.Enabled ? UiStatus.Success : UiStatus.Neutral)" IconOnly /><ManagedResourceBadge IsManaged="@kind.Governance.IsManaged" IsReadOnly="@(!ResourceOwnershipContext.CanManage(kind.ScopeRef, Services))" IconOnly /></IconBadges><Badges>@if (kind.Governance.Origin.Kind == ResourceOriginKind.BuiltIn) { <small>@T("BuiltIn")</small> }</Badges></CollectionIdentity>);
    private IReadOnlyList<CollectionColumn<FunctionKindResource>> KindColumns => [new("versions", T("Version"), kind => @<text>@string.Join(", ", kind.Definition.Versions.Select(value => value.Version))</text>)];
}
