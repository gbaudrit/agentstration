@page "/flows"
@implements IDisposable
@inject IServiceProvider Services
@inject IFlowApiClient Client
@inject ConsoleContextState Context
@inject Microsoft.Extensions.Localization.IStringLocalizer<FlowsStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared

<PageTitle>@T("PageTitle")</PageTitle>
<div class="flow-compact-list" data-testid="flow-observability-flows" data-interactive="@interactive.ToString().ToLowerInvariant()" aria-busy="@((loadState.Status is ResourceLoadStatus.Loading or ResourceLoadStatus.Refreshing).ToString().ToLowerInvariant())">
    <ResourceCollectionTemplate TItem="FlowSummary" Title="@T("Flows")" Description="@T("Description")" TestId="flow-list" ContextKey="@contextKey"
                                IdentityColumn="IdentityColumn" Columns="Columns" Items="@(items ?? [])" Compact
                                Query="query" QueryChanged="ChangeQueryAsync" Pagination="Pagination" PageSizeId="flow-page-size" LoadState="loadState" Disabled="@(!interactive)"
                                PrimaryActions="CreateAction" EmptyActions="CreateAction" EmptyTitle="@T("EmptyTitle")" EmptyMessage="@T("EmptyMessage")"
                                OnRefresh="ReloadAsync" OnRetry="RetryAsync">
        <Actions><a class="button-secondary" href="@ResourceOwnershipContext.PreserveNavigation("/flow-runs", Services)">@T("ViewAllRuns")</a></Actions>
    </ResourceCollectionTemplate>
</div>

@code {
    private string T(string key) => Localizer[key];
    private RenderFragment? CreateAction => Context.HasPermission(AuthorizationPermissions.ResourcesWrite)
        ? @<PermissionGate Permission="@AuthorizationPermissions.ResourcesWrite"><a class="button-primary" href="@ResourceOwnershipContext.PreserveNavigation("/flows/new", Services)">@T("NewFlow")</a></PermissionGate> : null;
    private CollectionColumn<FlowSummary> IdentityColumn => new("identity", Shared["CollectionResource"], item => @<CollectionIdentity DisplayName="@item.Name" Namespace="@item.Namespace.Value" Name="@item.Id" Href="@DetailsUrl(item)" IconName="workflow" Domain="flow" ShowNamespaceIcon="false">
        <IconBadges><span class="flow-icon-badges"><ResourceScopeBadge ScopeRef="@item.ScopeRef" Kind="ResourceScopeKind.Workspace" IconOnly /><StatusBadge Text="@StatusLabel(item.Status)" Status="@PlatformDashboardService.ToStatus(item.Status)" IconOnly /><ManagedResourceBadge IsManaged="@item.IsManaged" IsReadOnly="@(!ResourceOwnershipContext.CanManage(item.ScopeRef, Services))" IconOnly /></span></IconBadges>
        <NameSuffix><span class="flow-kind">@KindLabel(item.Kind)</span></NameSuffix>
    </CollectionIdentity>);
    // The current Flow page API supports offset/continuation only; no page-local filtering is advertised.
    private IReadOnlyList<CollectionColumn<FlowSummary>> Columns =>
    [
        new("version", T("Version"), item => @<div class="flow-versions"><CollectionVersion Label="@T("PublishedVersion")" Value="@(item.PublishedVersion ?? item.ActiveVersion)" Compact /></div>)
        {
            Heading = @<span class="flow-version-heading">@T("Version") <ValueDisclosure Value="@T("VersionHelp")" IconName="info-circle" /></span>
        },
        new("updated", T("Updated"), item => @<time datetime="@item.UpdatedAt.ToString("O")">@item.UpdatedAt.LocalDateTime.ToString("g")</time>)
    ];
    private string DetailsUrl(FlowSummary item) => ResourceOwnershipContext.PreserveNavigation(item.DetailsUrl, Services);
    private string StatusLabel(string value) { var localized = Localizer[$"Status.{value}"]; return localized.ResourceNotFound ? value : localized.Value; }
    private string KindLabel(string value) { var localized = Localizer[$"Kind.{value}"]; return localized.ResourceNotFound ? value : localized.Value; }
}
