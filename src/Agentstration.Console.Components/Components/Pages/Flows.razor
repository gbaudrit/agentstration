@page "/flows"
@implements IDisposable
@inject IServiceProvider Services
@inject IFlowApiClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<FlowsStrings> Localizer
<PageTitle>@T("PageTitle")</PageTitle>
<div data-testid="flow-observability-flows">
<PageHeader Title="@T("Flows")" Description="@T("Description")">
    <Actions><a class="button-primary" href="/flows/new">@T("NewFlow")</a><a class="button-secondary" href="/flow-runs">@T("ViewAllRuns")</a></Actions>
</PageHeader>
<nav class="section-tabs" aria-label="@T("FlowSections")"><a class="active" href="/flows">@T("Definitions")</a><a href="/flow-runs">@T("Runs")</a><a href="/flows#deployments">@T("Deployments")</a></nav>
@if (items is null) { <LoadingState /> }
else if (items.Count == 0) { <EmptyState Title="@T("EmptyTitle")" Message="@T("EmptyMessage")" /> }
else
{
    <CollectionView TItem="FlowSummary" Items="items" InformationLabels="@(new[] { T("Kind"), T("Version"), T("Updated") })">
        <Identity Context="item"><CollectionIdentity DisplayName="@item.Name" Namespace="@item.Namespace.Value" Name="@item.Id" Href="@DetailsUrl(item)" IconName="workflow" Domain="flow"><Badges><ManagedResourceBadge IsManaged="@item.IsManaged" /></Badges></CollectionIdentity></Identity>
        <Scope Context="item"><ResourceScopeBadge ShowName ScopeRef="@item.ScopeRef" Kind="ResourceScopeKind.Workspace" /></Scope>
        <State Context="item"><StatusBadge Text="@StatusLabel(item.Status)" Status="@PlatformDashboardService.ToStatus(item.Status)" /></State>
        <Information Context="item">
            <CollectionValue Label="@T("Kind")">@item.Kind</CollectionValue>
            <CollectionValue Label="@T("Version")">@item.Version</CollectionValue>
            <CollectionValue Label="@T("Updated")">@item.UpdatedAt.LocalDateTime.ToString("g")</CollectionValue>
        </Information>
        <Actions Context="item"><CollectionActions ResourceName="@($"{item.Name} ({item.Namespace}/{item.Id})")"><a href="@DetailsUrl(item)">@T("Open")</a></CollectionActions></Actions>
    </CollectionView>
}
</div>
@code {
    private readonly CancellationTokenSource cancellation = new();
    private IReadOnlyList<FlowSummary>? items;
    protected override async Task OnInitializedAsync() => items = await Client.GetFlowsAsync(cancellation.Token);
    private string DetailsUrl(FlowSummary item) => ResourceOwnershipContext.PreserveNavigation(item.DetailsUrl, Services);
    private string T(string key) => Localizer[key];
    private string StatusLabel(string value) { var localized = Localizer[$"Status.{value}"]; return localized.ResourceNotFound ? value : localized.Value; }
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
