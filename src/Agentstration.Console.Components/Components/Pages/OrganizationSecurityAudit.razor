@page "/settings/organization/security-audit"
@implements IDisposable
@using Agentstration.Security.Contracts
@inject IIdentityAdministrationApiClient Client
@inject ConsoleContextState Context
@inject Microsoft.Extensions.Localization.IStringLocalizer<OrganizationStrings> Localizer

<PageTitle>@T("SecurityAudit") · @T("Organization") · Agentstration</PageTitle>
<ResourceCollectionTemplate TItem="SecurityAuditEvent" Title="@T("SecurityAudit")" Description="@($"{T("SecurityAudit.Description")} {T("SecurityAudit.SnapshotHelp")}")" TestId="console-admin-organization-security-audit"
                            IdentityColumn="IdentityColumn" Columns="Columns" Items="@(items ?? [])" ContextKey="@contextKey"
                            Query="query" LoadState="loadState" Disabled="@(!interactive)" RowTestId="security-audit-event"
                            EmptyTitle="@T("NoSecurityEvent")" EmptyMessage="@T("NoSecurityEventMessage")" OnRefresh="LoadAsync" OnRetry="RetryAsync">
    <Navigation><OrganizationSettingsNav /></Navigation>
</ResourceCollectionTemplate>

@code {
    private string T(string key) => Localizer[key].Value;
    private string ActionLabel(string action) { var value = Localizer[$"AuditAction.{action}"]; return value.ResourceNotFound ? T("AuditAction.Unknown") : value.Value; }
    private CollectionColumn<SecurityAuditEvent> IdentityColumn => new("identity", T("Action"), entry => @<text>
        <strong>@ActionLabel(entry.Action)</strong><code class="audit-action-code">@entry.Action</code>@if (!string.IsNullOrWhiteSpace(entry.ReasonCode)) { <small class="audit-action-code">@entry.ReasonCode</small> }
    </text>);
    private IReadOnlyList<CollectionColumn<SecurityAuditEvent>> Columns =>
    [
        new("scope", T("Scope"), entry => @<text>@if (entry.WorkspaceId is { } workspace) { <span>@T("Workspace")</span><br /><CopyableValue Value="@workspace.ToString("D")" /> } else if (entry.TenantId is { } tenant) { <span>@T("Tenant")</span><br /><CopyableValue Value="@tenant.ToString("D")" /> } else { <span>@T("Instance")</span> }</text>),
        new("outcome", T("Outcome"), entry => @<StatusBadge Text="@T($"AuditOutcome.{(Enum.IsDefined(entry.Outcome) ? entry.Outcome.ToString() : "Unknown")}")" Status="@(entry.Outcome == SecurityAuditOutcome.Succeeded ? UiStatus.Success : entry.Outcome == SecurityAuditOutcome.Failed ? UiStatus.Warning : UiStatus.Neutral)" />),
        new("time", T("Time"), entry => @<time datetime="@entry.OccurredAt.ToString("O")"><span class="audit-date">@entry.OccurredAt.ToLocalTime().ToString("d")</span> @entry.OccurredAt.ToLocalTime().ToString("t")</time>),
        new("actor", T("Actor"), entry => @<text>@if (entry.ActorPrincipalId is { } actor) { <CopyableValue Value="@actor.ToString("D")" /> } else { <span>—</span> }</text>),
        new("target", T("Target"), entry => @<text>@if (entry.TargetPrincipalId is { } principal) { <span>@T("Principal")</span><br /><CopyableValue Value="@principal.ToString("D")" /> } else if (entry.TargetAccountId is { } account) { <span>@T("Account")</span><br /><CopyableValue Value="@account.ToString("D")" /> } else { <span>—</span> }</text>),
        new("correlation", T("Correlation"), entry => @<text>@if (!string.IsNullOrWhiteSpace(entry.CorrelationId)) { <CopyableValue Value="@entry.CorrelationId" /> } else { <span>—</span> }</text>)
    ];
}
