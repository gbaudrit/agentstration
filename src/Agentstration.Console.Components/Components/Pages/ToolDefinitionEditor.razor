@page "/tools/definitions/{Name}"
@implements IDisposable
@inject IToolDefinitionsClient Client
@inject IFlowApiClient Flows
@inject NavigationManager Navigation
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<ToolsStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared

<PageTitle>@(resource?.Definition.DisplayName ?? Name) · Agentstration</PageTitle>
@if (resource?.Definition is RelayToolDefinitionProperties)
{
    <ToolRelayEditor @key="loadedKey" Name="@Name" NamespaceQuery="@NamespaceQuery" ScopeRefValue="@ScopeRefValue" InitialSnapshot="snapshot" />
}
else
{
    var presentations = Presentations;
    <ConsoleResourceDetailsTemplate Resource="resource" RequestedAddress="RequestedAddress" Name="@(resource?.Definition.DisplayName ?? Name ?? string.Empty)" ResourceType="@T("Definition")" Domain="tool" IconName="wrench" CollectionHref="@BackUrl" CollectionLabel="@T("DefinitionsTitle")"
        Description="@resource?.Definition.Description" ResourceIdentity="@($"{loadedKey}|{resource?.Uid}")" SectionState="sectionState" SectionPresentations="presentations"
        DefinitionSections="DefinitionSections" AdditionalSections="AdditionalSections" SelectionChanged="SelectSectionAsync"
        DefinitionReadOnlyReason="DefinitionReadOnlyReason" LoadState="loadState" OnRetry="RefreshAsync" OnRefresh="RefreshAsync" HasDraft="IsDirty" Busy="saving"
        Enabled="resource?.Definition.Enabled" EnabledChanged="SetEnabledAsync" EnabledDisabled="@(!CanMutate || saving || loading)"
        Yaml="@SavedYaml" YamlReadOnly="true" YamlTitle="@T("DefinitionYaml")" YamlDescription="@T("DefinitionYamlHelp")"
        TestId="resource-tool-definition-editor" SectionTestIdPrefix="tool-definition">
        <Actions>@if (CanMutate) { <button class="button-danger" type="button" disabled="@(saving || loading)" @onclick="() => confirmDelete = true">@T("Delete")</button> }</Actions>
        <Feedback>@if (error is not null) { <div class="form-alert form-alert-danger" role="alert">@error</div> }@if (newerSnapshot is not null) { <div class="form-alert form-alert-warning" role="status">@T("DefinitionRefreshDraftConflict")</div> }</Feedback>
        <OverviewMetrics>@if (resource is not null) { <MetricCard Label="@T("DefinitionGeneration")" Value="@resource.Generation.ToString(System.Globalization.CultureInfo.CurrentCulture)" /><MetricCard Label="@T("RelayVersion")" Value="@resource.Definition.Version" /> }</OverviewMetrics>
        <OverviewConfiguration><CollectionView TItem="ConfigurationEntry" Items="SavedConfiguration" IdentityLabel="@Shared["Configuration"]" InformationLabels="@(new[] { Shared["Saved"].Value })"><Identity Context="entry"><strong class="configuration-key">@entry.Label</strong></Identity><Information Context="entry"><CollectionValue Label="@Shared["Saved"]"><span class="configuration-value">@entry.Value</span></CollectionValue></Information></CollectionView></OverviewConfiguration>
        <DefinitionContent Context="path">
            <ResourceDefinitionForm @key="formContext" @ref="definitionForm" EditContext="formContext" FieldLabels="FieldLabels" OnValidSubmit="SaveAsync" Id="tool-definition-resource-form" FormName="tool-definition"
                Sections="presentations" SectionState="sectionState" SectionContent="DefinitionContent" SectionRequested="ShowSection" ReadOnly="@(!CanMutate)" Busy="saving" Disabled="loading" InvalidInputChanged="value => invalidInput = value" />
        </DefinitionContent>
        <AdditionalContent Context="path">
            @if (path == "versions") {
                @HistoryFeedback
                <FormSection Title="@T("RelayVersions")"><CollectionView TItem="ToolDefinitionVersionResource" Items="versions" IdentityLabel="@T("RelayVersion")" InformationLabels="@(new[] { T("Flow"), T("PublishedAt") })"><Identity Context="version"><CollectionIdentity DisplayName="@version.Definition.Version" Name="@version.Name" Namespace="@version.Namespace.Value" IconName="history"><IconBadges><ResourceScopeBadge ScopeRef="version.ScopeRef" IconOnly /></IconBadges></CollectionIdentity></Identity><Information Context="version"><CollectionValue Label="@T("Flow")">@(version.Definition is FlowToolDefinitionProperties flow ? FlowText(flow.Flow, version.Namespace) : T("AcquisitionImplementation"))</CollectionValue><CollectionValue Label="@T("PublishedAt")">@version.PublishedAt.ToLocalTime().ToString("g")</CollectionValue></Information></CollectionView></FormSection>
            }
            else {
                @HistoryFeedback
                <FormSection Title="@T("RelayUsages")"><CollectionView TItem="ToolDefinitionUsage" Items="usages" IdentityLabel="@T("Tool")" InformationLabels="@(new[] { T("Version"), T("RelayVersion") })"><Identity Context="usage"><CollectionIdentity DisplayName="@usage.Name" Name="@usage.Name" Namespace="@usage.Namespace.Value" Href="@UsageUrl(usage)" IconName="layers"><IconBadges><ResourceScopeBadge ScopeRef="usage.ScopeRef" IconOnly /></IconBadges></CollectionIdentity></Identity><Information Context="usage"><CollectionValue Label="@T("Version")"><CollectionVersion Label="@T("Version")" Value="@usage.Version" /></CollectionValue><CollectionValue Label="@T("RelayVersion")"><CollectionVersion Label="@T("RelayVersion")" Value="@usage.RelayVersion" /></CollectionValue></Information></CollectionView></FormSection>

            }
        </AdditionalContent>
        <DraftActions><button type="button" class="button-secondary" disabled="@(saving || loading)" @onclick="DiscardAsync">@Shared["Discard"]</button><button type="submit" form="tool-definition-resource-form" class="button-primary" data-testid="tool-definition-save" disabled="@(saving || loading || loadingContract)">@T("Save")</button></DraftActions>
    </ConsoleResourceDetailsTemplate>
}
<ConfirmationDialog IsOpen="confirmDelete" Title="@T("Delete")" OnConfirm="DeleteAsync" OnCancel="() => confirmDelete = false" />

@code {
    private RenderFragment IdentityFields => @<ResourceIdentityEditor ResourceKind="@ToolResourceKinds.ToolDefinition" DisplayName="@model.DisplayName" DisplayNameChanged="value => model.DisplayName = value" DisplayNameExpression="@(() => model.DisplayName)"
        TechnicalName="@model.Name" TechnicalNameChanged="value => model.Name = value" TechnicalNameExpression="@(() => model.Name)" Namespace="@model.Namespace" NamespaceExpression="@(() => model.Namespace)"
        ScopeRef="resource!.ScopeRef" @bind-Description="model.Description" @bind-Labels="model.Tags" LabelsReadOnly="true" ReadOnly="@(!CanMutate)" />;
    private RenderFragment OptionsFields => @<FormSection Title="@Shared["Configuration"]"><FormGrid>
        <label class="resource-enabled-toggle"><FormCheckbox role="switch" @bind-Value="model.RequiresApproval" /> <span>@T("RequiresApproval")</span></label>
        <FormField Required="true" Label="@T("RelayVersion")"><Validation><ValidationMessage For="() => model.PublicationVersion" /></Validation><ChildContent><ClearableText @bind-Value="model.PublicationVersion" /></ChildContent></FormField>
        <label class="resource-enabled-toggle"><FormCheckbox role="switch" @bind-Value="model.Publish" /> <span>@T("PublishVersion")</span></label>
        <FormField Required="true" Label="@T("TimeoutSeconds")"><Validation><ValidationMessage For="() => model.TimeoutSeconds" /></Validation><ChildContent><ClearableNumber @bind-Value="model.TimeoutSeconds" min="1" max="900" /></ChildContent></FormField>
    </FormGrid></FormSection>;
    private RenderFragment ImplementationFields => @<div>
    @if (acquisitionDefinition?.Acquisition is { } acquisition)
    {
        <section class="panel" data-testid="tool-definition-acquisition">
            <div class="panel-header"><h2>@T("AcquisitionImplementation")</h2></div>
            <p>@T("AcquisitionImplementationHelp")</p>
            <dl class="resource-details">
                <dt>@T("AcquisitionTemplate")</dt><dd><code>@acquisition.TemplateNamespace/@acquisition.TemplateId</code></dd>
                <dt>@T("AcquisitionOutput")</dt><dd>@(acquisition.ArtifactName ?? "artifact")</dd>
            </dl>
        </section>
    }
    else
    {
    <section class="panel"><div class="panel-header"><h2>@T("FlowImplementation")</h2></div>
        <FormGrid>
            <FormField Required="true" Label="@T("Flow")"><Validation><ValidationMessage For="() => model.SelectedFlow" /></Validation><ChildContent><ClearableSelect TValue="string" data-testid="tool-definition-flow" @bind-Value="model.SelectedFlow" @bind-Value:after="FlowSelectionChangedAsync"><option value="">—</option>@if (Selected() is null && model.SelectedFlow.Length > 0) { <option value="@model.SelectedFlow">@model.SelectedFlow</option> }@foreach(var flow in flows){<option value="@FlowKey(flow)">@flow.ScopeRef · @flow.Namespace/@flow.Name (@flow.ActiveVersion)</option>}</ClearableSelect></ChildContent></FormField>
            <label class="resource-enabled-toggle"><FormCheckbox role="switch" data-testid="tool-definition-use-active-version" @bind-Value="model.UseActiveVersion" @bind-Value:after="LoadContractAsync" /> <span>@T("UseActiveVersion")</span></label>
            @if (!model.UseActiveVersion) { <FormField Label="@T("Version")"><ClearableText UpdateOnInput="false" data-testid="tool-definition-version" @bind-Value="model.FlowVersion" @bind-Value:after="LoadContractAsync" /></FormField> }
            <div class="form-span-2">
                @if (loadingContract)
                {
                    <p class="muted" role="status">@T("LoadingFlowContract")</p>
                }
                else if (!contractLoaded)
                {
                    <div class="form-alert form-alert-info" role="status">@T("SelectFlowToViewContracts")</div>
                }
                else
                {
                    <div class="form-alert form-alert-info" role="status">@T("ContractsProvidedByFlow", loadedContractVersion)</div>
                    <ContractDirectionTabs Label="@T("Contracts")" InputLabel="@T("InputContract")"
                        OutputLabel="@T("OutputContract")" TestId="tool-definition-contract">
                        <InputContent>
                            <ReusableSchemaBindingEditor Title="@T("InputSchema")" TestId="tool-definition-input-schema"
                                LegacySchema="InputSchemaContent" ReadOnly="true" ShowSourceControls="false"
                                HelpText="@T("FlowContractReadOnlyHelp")" />
                        </InputContent>
                        <OutputContent>
                            <ReusableSchemaBindingEditor Title="@T("OutputSchema")" TestId="tool-definition-output-schema"
                                LegacySchema="OutputSchemaContent" ReadOnly="true" ShowSourceControls="false"
                                HelpText="@T("FlowContractReadOnlyHelp")" />
                        </OutputContent>
                    </ContractDirectionTabs>
                }
            </div>
        </FormGrid>
    </section>
    }

    </div>;

    private RenderFragment HistoryFeedback => @<div>@if (historyLoading) { <LoadingState Message="@T("LoadingDefinitions")" /> }@if (historyError is not null) { <ErrorState Message="@historyError" /><button type="button" class="button-secondary" @onclick="LoadHistoryAsync">@T("Refresh")</button> }</div>;
}
