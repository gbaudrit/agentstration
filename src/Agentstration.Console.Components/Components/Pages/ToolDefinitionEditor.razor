@page "/tools/definitions/{Name}"
@inject IToolDefinitionsClient Client
@inject IFlowApiClient Flows
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<ToolsStrings> Localizer

<PageTitle>@T(IsNew ? "NewDefinition" : "EditDefinition") · Agentstration</PageTitle>
<PageHeader Title="@T(IsNew ? "NewDefinition" : "EditDefinition")" Description="@T("DefinitionEditorDescription")" TestId="resource-tool-definition-editor" />

@if (loading) { <LoadingState Message="@T("LoadingDefinitions")" /> }
else if (isRelay)
{
    <ToolRelayEditor Name="@Name" NamespaceQuery="@NamespaceQuery" Source="@Source" />
}
else
{
    @if (error is not null) { <ErrorState Message="@error" /> }
    <section class="panel"><div class="panel-header"><h2>@T("Definition")</h2></div>
        <div class="form-grid">
            <ResourceIdentityFields @bind-DisplayName="displayName" @bind-TechnicalName="name" IsNew="@IsNew" />
            <label><span>@T("Namespace")</span><input @bind="namespaceValue" disabled="@(!IsNew)" /></label>
            <label class="form-span-2"><span>@T("DefinitionDescription")</span><textarea @bind="description" rows="2"></textarea></label>
            <label><input type="checkbox" @bind="enabled" /> <span>@T("Enabled")</span></label>
            <label><input type="checkbox" @bind="requiresApproval" /> <span>@T("RequiresApproval")</span></label>
            <label><span>@T("RelayVersion")</span><input @bind="publicationVersion" /></label>
            <label><input type="checkbox" @bind="publish" /> <span>@T("PublishVersion")</span></label>
            <label><span>@T("TimeoutSeconds")</span><input type="number" min="1" max="900" @bind="timeoutSeconds" /></label>
        </div>
    </section>
    @if (acquisitionDefinition?.Acquisition is { } acquisition)
    {
        <section class="panel" data-testid="tool-definition-acquisition">
            <div class="panel-header"><h2>@T("AcquisitionImplementation")</h2></div>
            <p>@T("AcquisitionImplementationHelp")</p>
            <dl class="resource-details">
                <dt>@T("AcquisitionTemplate")</dt><dd><code>@acquisition.TemplateNamespace/@acquisition.TemplateId</code></dd>
                <dt>@T("AcquisitionOutput")</dt><dd>@(acquisition.ArtifactName ?? "artifact")</dd>
            </dl>
        </section>
    }
    else
    {
    <section class="panel"><div class="panel-header"><h2>@T("FlowImplementation")</h2></div>
        <div class="form-grid">
            <label><span>@T("Flow")</span><select data-testid="tool-definition-flow" @bind="selectedFlow" @bind:after="FlowSelectionChangedAsync"><option value="">—</option>@foreach(var flow in flows){<option value="@FlowKey(flow)">@flow.ScopeRef · @flow.Namespace/@flow.Name (@flow.ActiveVersion)</option>}</select></label>
            <label><input type="checkbox" data-testid="tool-definition-use-active-version" @bind="useActiveVersion" @bind:after="LoadContractAsync" /> <span>@T("UseActiveVersion")</span></label>
            @if (!useActiveVersion) { <label><span>@T("Version")</span><input data-testid="tool-definition-version" @bind="flowVersion" @bind:after="LoadContractAsync" /></label> }
            <div class="form-span-2">
                @if (loadingContract)
                {
                    <p class="muted" role="status">@T("LoadingFlowContract")</p>
                }
                else if (!contractLoaded)
                {
                    <div class="form-alert form-alert-info" role="status">@T("SelectFlowToViewContracts")</div>
                }
                else
                {
                    <div class="form-alert form-alert-info" role="status">@T("ContractsProvidedByFlow", loadedContractVersion)</div>
                    <ContractDirectionTabs Label="@T("Contracts")" InputLabel="@T("InputContract")"
                        OutputLabel="@T("OutputContract")" TestId="tool-definition-contract">
                        <InputContent>
                            <ReusableSchemaBindingEditor Title="@T("InputSchema")" TestId="tool-definition-input-schema"
                                LegacySchema="InputSchemaContent" ReadOnly="true" ShowSourceControls="false"
                                HelpText="@T("FlowContractReadOnlyHelp")" />
                        </InputContent>
                        <OutputContent>
                            <ReusableSchemaBindingEditor Title="@T("OutputSchema")" TestId="tool-definition-output-schema"
                                LegacySchema="OutputSchemaContent" ReadOnly="true" ShowSourceControls="false"
                                HelpText="@T("FlowContractReadOnlyHelp")" />
                        </OutputContent>
                    </ContractDirectionTabs>
                }
            </div>
        </div>
    </section>
    }
    <div class="page-actions"><button class="button-primary" data-testid="tool-definition-save" @onclick="SaveAsync" disabled="@(saving || loadingContract || acquisitionDefinition is null && !contractLoaded)">@T("Save")</button><a class="button-secondary" href="/tools/definitions">@T("Cancel")</a>@if(!IsNew){<button class="button-danger" @onclick="DeleteAsync">@T("Delete")</button>}</div>
}

@code {
    [Parameter] public string? Name { get; set; }
    [SupplyParameterFromQuery(Name="namespace")] public string? NamespaceQuery { get; set; }
    private IReadOnlyList<FlowSummary> flows=[]; private string name="",namespaceValue="default",displayName="",description="",selectedFlow="",flowVersion="",inputSchema="{\n  \"type\": \"object\"\n}",outputSchema="",loadedContractVersion=""; private bool enabled=true,requiresApproval,useActiveVersion=true,loading=true,saving,loadingContract,contractLoaded; private int timeoutSeconds=90; private string? etag,error;
    private AcquisitionToolDefinitionProperties? acquisitionDefinition;
    [SupplyParameterFromQuery(Name="toolKind")] public string? ToolKind { get; set; }
    [SupplyParameterFromQuery(Name="source")] public string? Source { get; set; }
    private bool isRelay;
    private string publicationVersion="1.0.0";
    private bool publish;
    private bool IsNew => string.IsNullOrWhiteSpace(Name);
    private string T(string key, params object[] arguments)=>Localizer[key,arguments];
    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        error = null;
        acquisitionDefinition = null;
        isRelay = ToolKind == "relay";
        try
        {
            if (IsNew)
            {
                if (!isRelay) flows = await Flows.GetFlowsAsync(default);
                return;
            }

            var snapshot = await Client.GetAsync(Name!, ResourceNamespace.Parse(NamespaceQuery), default);
            if (snapshot.Value.Definition is RelayToolDefinitionProperties) { isRelay = true; return; }
            if (snapshot.Value.Definition is AcquisitionToolDefinitionProperties acquisition)
                acquisitionDefinition = acquisition;
            else
                flows = await Flows.GetFlowsAsync(default);

            From(snapshot.Value);
            etag = snapshot.ETag;
            if (acquisitionDefinition is null) await RefreshContractAsync();
        }
        catch (Exception exception) { error = exception.Message; }
        finally { loading = false; }
    }
    private void From(ToolDefinitionResource value){name=value.Name;namespaceValue=value.Namespace.Value;displayName=value.Definition.DisplayName;description=value.Definition.Description??"";enabled=value.Definition.Enabled;requiresApproval=value.Definition.RequiresApproval;timeoutSeconds=value.Definition.InvocationTimeoutSeconds;publicationVersion=value.Definition.Version;if(value.Definition is FlowToolDefinitionProperties flow){useActiveVersion=flow.Flow.UseActiveVersion;flowVersion=flow.Flow.Version??"";selectedFlow=ExistingFlowKey(flow.Flow,value.Namespace);}inputSchema=Pretty(value.Definition.InputSchema);outputSchema=value.Definition.OutputSchema is null?"":Pretty(value.Definition.OutputSchema.Value);}
    private async Task FlowSelectionChangedAsync(){var flow=Selected();flowVersion=flow?.ActiveVersion??"";if(flow is null){ClearContract();return;}await RefreshContractAsync();}
    private async Task LoadContractAsync(){if(Selected() is null){ClearContract();return;}await RefreshContractAsync();}
    private async Task<bool> RefreshContractAsync(){error=null;loadingContract=true;contractLoaded=false;try{var flow=Selected()??throw new InvalidOperationException(T("SelectFlow"));var version=useActiveVersion?flow.ActiveVersion:flowVersion;if(string.IsNullOrWhiteSpace(version))throw new InvalidOperationException(T("FlowVersionRequired"));var published=await Flows.GetFlowVersionAsync(flow.Namespace,flow.Id,version,flow.ScopeRef,default);var input=published.Graph?.ResolveInputSchema();var ambiguous=false;var output=published.Graph?.ResolveSingleSuccessOutputSchema(out ambiguous);if(ambiguous)throw new InvalidOperationException(T("FlowOutputContractAmbiguous"));inputSchema=input is {} inputContract?Pretty(inputContract):"{}";outputSchema=output is {} outputContract?Pretty(outputContract):"";flowVersion=version;loadedContractVersion=version;contractLoaded=true;return true;}catch(Exception ex){error=ex.Message;return false;}finally{loadingContract=false;}}
    private void ClearContract(){error=null;inputSchema="{}";outputSchema="";loadedContractVersion="";contractLoaded=false;}
    private async Task SaveAsync()
    {
        saving = true;
        error = null;
        try
        {
            ToolDefinitionProperties? properties = acquisitionDefinition;
            if (properties is null)
            {
                if (!await RefreshContractAsync()) return;
                var flow = Selected()!;
                using var input = JsonDocument.Parse(inputSchema);
                properties = new FlowToolDefinitionProperties
                {
                    DisplayName = displayName,
                    InputSchema = input.RootElement.Clone(),
                    OutputSchema = OutputSchemaContent,
                    Flow = new ToolDefinitionFlowTarget
                    {
                        Name = flow.Id, Namespace = flow.Namespace, ScopeRef = flow.ScopeRef,
                        UseActiveVersion = useActiveVersion, Version = useActiveVersion ? null : flowVersion
                    }
                };
            }

            properties = properties with
            {
                DisplayName = displayName,
                Description = string.IsNullOrWhiteSpace(description) ? null : description,
                Enabled = enabled,
                RequiresApproval = requiresApproval,
                InvocationTimeoutSeconds = timeoutSeconds,
                Version = publicationVersion,
                Publish = publish
            };
            if (IsNew)
                await Client.CreateAsync(new CreateToolDefinitionRequest(name, properties, namespaceValue), default);
            else
                await Client.UpdateAsync(name, ResourceNamespace.Parse(namespaceValue), new PutToolDefinitionRequest(properties), etag!, default);
            Navigation.NavigateTo("/tools/definitions");
        }
        catch (Exception exception) { error = exception.Message; }
        finally { saving = false; }
    }
    private async Task DeleteAsync(){try{await Client.DeleteAsync(name,ResourceNamespace.Parse(namespaceValue),etag!,default);Navigation.NavigateTo("/tools/definitions");}catch(Exception ex){error=ex.Message;}}
    private FlowSummary? Selected()=>flows.SingleOrDefault(value=>FlowKey(value)==selectedFlow);
    private static string FlowKey(FlowSummary flow)=>flow.ScopeRef is null?string.Empty:$"{flow.ScopeRef.Value.Value}|{flow.Namespace.Value}|{flow.Id}";
    private string ExistingFlowKey(ToolDefinitionFlowTarget target,ResourceNamespace owner){var ns=target.Namespace??owner;var scope=target.ScopeRef??flows.Where(value=>value.Namespace==ns&&value.Id==target.Name).Select(value=>value.ScopeRef).SingleOrDefault();return scope is null?string.Empty:$"{scope.Value.Value}|{ns.Value}|{target.Name}";}
    private static string Pretty(JsonElement value)=>JsonSerializer.Serialize(value,new JsonSerializerOptions{WriteIndented=true});
    private JsonElement? InputSchemaContent => ParseOrNull(inputSchema);
    private JsonElement? OutputSchemaContent => ParseOrNull(outputSchema);
    private static JsonElement? ParseOrNull(string value){if(string.IsNullOrWhiteSpace(value))return null;try{using var document=JsonDocument.Parse(value);return document.RootElement.Clone();}catch(JsonException){return null;}}
}
