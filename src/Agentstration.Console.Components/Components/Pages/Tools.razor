@page "/tools"
@inject IToolsClient Client
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<ToolsStrings> Localizer

<PageTitle>@T("Title") · Agentstration</PageTitle>
<PageHeader Title="@T("Title")" Description="@T("Description")" TestId="resource-tools">
    <Actions><a class="button-secondary" href="/tools/providers">@T("Providers")</a><button class="button-secondary" @onclick="LoadAsync">@T("Refresh")</button></Actions>
</PageHeader>
<ResourceTabs Label="@T("SectionsLabel")"><a class="active" href="/tools">@T("Catalog")</a><a href="/tools/sets">@T("ToolSets")</a><a href="/tools/categories">@T("Categories")</a><a href="/tools/definitions">@T("Definitions")</a><a href="/tools/providers">@T("Providers")</a></ResourceTabs>

@if (loading) { <LoadingState Message="@T("Loading")" /> }
else if (error is not null) { <ErrorState Message="@error" /> }
else if (tools.Count == 0) { <EmptyState Title="@T("EmptyTitle")" Message="@T("EmptyMessage")" /> }
else
{
    <DataGrid TItem="ToolResource" Items="tools">
        <Header><tr><th>@T("Tool")</th><th>@T("Provider")</th><th>@T("Availability")</th><th>@T("Enabled")</th><th></th></tr></Header>
        <Row Context="tool"><tr><td><span class="resource-name-with-scope"><strong>@tool.Definition.DisplayName</strong><ResourceScopeBadge ScopeRef="tool.ScopeRef" Compact /></span><code>@tool.Definition.ExternalId</code></td><td><strong>@ProviderDisplayName(tool)</strong>
            @if (ManagingExtension(tool) is { } extension) { <br /><code>@extension.ExtensionId</code><span> · @(tool.Governance.Origin.Version ?? extension.Version)</span><ResourceScopeBadge ScopeRef="extension.RegistrationScopeRef" Compact /> }
            <br /><code>@ResourceName(tool.Definition.Provider?.ResourceId)</code></td><td><StatusBadge Text="@AvailabilityLabel(tool.Definition.Discovery?.Available == true)" Status="@(tool.Definition.Discovery?.Available == true ? UiStatus.Success : UiStatus.Warning)" /></td><td>@BooleanLabel(tool.Definition.Enabled)</td><td><a class="text-button" href="@ToolUrl(tool)">@T("Details")</a></td></tr></Row>
    </DataGrid>
}

@code {
    private IReadOnlyList<ToolResource> tools = []; private IReadOnlyList<ToolProviderResource> providers = []; private IReadOnlyList<ExtensionInventoryItemResponse> extensions = []; private bool loading = true; private string? error;
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string AvailabilityLabel(bool available) => T(available ? "Available" : "Unavailable");
    private string BooleanLabel(bool value) => T(value ? "Yes" : "No");
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync() { loading = true; error = null; try { var toolsTask = Client.GetToolsAsync(); var providersTask = Client.GetProvidersAsync(default); await Task.WhenAll(toolsTask, providersTask); tools = toolsTask.Result; providers = providersTask.Result; if (Services.GetService<IExtensionsClient>() is { } client) extensions = await client.GetExtensionInventoryAsync(default); } catch (Exception ex) { error = ex.Message; } finally { loading = false; } }
    private static string ResourceName(string? id) => id ?? "—";
    private string ProviderDisplayName(ToolResource tool)
    {
        return ManagingExtension(tool)?.DisplayName ?? providers.FirstOrDefault(value =>
            value.Name == tool.Definition.Provider?.Name && value.Namespace == (tool.Definition.Provider?.Namespace ?? tool.Namespace)
            && value.ScopeRef == (tool.Definition.Provider?.ScopeRef ?? tool.ScopeRef))?.Definition.DisplayName
            ?? ResourceName(tool.Definition.Provider?.ResourceId);
    }
    private ExtensionInventoryItemResponse? ManagingExtension(ToolResource tool)
    {
        var provider = providers.SingleOrDefault(value => value.Name == tool.Definition.Provider?.Name
            && value.Namespace == (tool.Definition.Provider?.Namespace ?? tool.Namespace)
            && value.ScopeRef == (tool.Definition.Provider?.ScopeRef ?? tool.ScopeRef));
        var extension = provider?.Definition.Aep?.Extension;
        if (extension is null) return null;
        return extensions.SingleOrDefault(value => value.RegistrationName == extension.Name
            && value.RegistrationNamespace == (extension.Namespace ?? provider!.Namespace).Value
            && value.RegistrationScopeRef == (extension.ScopeRef ?? provider!.ScopeRef));
    }
    private static string ToolUrl(ToolResource tool)
    {
        var query = new List<string>();
        if (!tool.Namespace.IsDefault) query.Add($"namespace={Uri.EscapeDataString(tool.Namespace.Value)}");
        if (tool.ScopeRef is { } scopeRef) query.Add($"scopeRef={Uri.EscapeDataString(scopeRef.Value)}");
        var path = $"/tools/{Uri.EscapeDataString(tool.Name)}";
        return query.Count == 0 ? path : $"{path}?{string.Join('&', query)}";
    }
}
