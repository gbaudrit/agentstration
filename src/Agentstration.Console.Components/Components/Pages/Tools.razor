@page "/tools"
@inject IToolsClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<ToolsStrings> Localizer

<PageTitle>@T("Title") · Agentstration</PageTitle>
<PageHeader Title="@T("Title")" Description="@T("Description")" TestId="resource-tools">
    <Actions><a class="button-secondary" href="/tools/providers">@T("Providers")</a><button class="button-secondary" @onclick="LoadAsync">@T("Refresh")</button></Actions>
</PageHeader>
<ResourceTabs Label="@T("SectionsLabel")"><a class="active" href="/tools">@T("Catalog")</a><a href="/tools/sets">@T("ToolSets")</a><a href="/tools/categories">@T("Categories")</a><a href="/tools/definitions">@T("Definitions")</a><a href="/tools/providers">@T("Providers")</a></ResourceTabs>

@if (loading) { <LoadingState Message="@T("Loading")" /> }
else if (error is not null) { <ErrorState Message="@error" /> }
else if (tools.Count == 0) { <EmptyState Title="@T("EmptyTitle")" Message="@T("EmptyMessage")" /> }
else
{
    <ResourceToolbar Label="@Shared["Filters"]">
        <SearchBox Value="@search" ValueChanged="SearchChanged" />
        <FormField Label="@T("Availability")"><ClearableSelect TValue="string" Value="@availability" ValueChanged="AvailabilityChanged" ValueExpression="() => availability"><option value="">@Shared["All"]</option><option value="available">@T("Available")</option><option value="unavailable">@T("Unavailable")</option></ClearableSelect></FormField>
        <span role="status">@Shared["LoadedResults", tools.Count]</span>
    </ResourceToolbar>
    @if (FilteredTools.Count == 0) { <EmptyState Title="@Shared["NoMatches"]" Message="@Shared["NoMatchesHelp"]" /> }
    <div class="tool-catalog-grid"><CollectionView TItem="ToolResource" Items="PageTools" InformationLabels="@(new string[] { T("Provider"), T("Enabled") })" IdentityLabel="@T("Tool")" StateLabel="@T("Availability")">
        <Identity Context="tool">
<CollectionIdentity DisplayName="@tool.Definition.DisplayName" Namespace="@tool.Namespace.Value" Name="@tool.Name" Href="@ToolUrl(tool)" IconName="wrench"><IconBadges><ResourceScopeBadge ScopeRef="tool.ScopeRef" ShowName IconOnly /><StatusBadge Text="@AvailabilityLabel(tool.Definition.Discovery?.Available == true)" Status="@(tool.Definition.Discovery?.Available == true ? UiStatus.Success : UiStatus.Warning)" IconOnly /><ManagedResourceBadge IsManaged="@tool.Governance.IsManaged" IsReadOnly="@(!ResourceOwnershipContext.CanManage(tool.ScopeRef, Services))" IconOnly /></IconBadges></CollectionIdentity></Identity>
        <Information Context="tool">
            <CollectionValue Label="@T("Provider")">
            @if (ManagingExtension(tool) is { } extension)
            {
                <div class="tool-catalog-owner"><a class="tool-catalog-extension" href="@ExtensionUrl(extension)">@extension.DisplayName</a><div class="tool-catalog-provenance"><code>@extension.ExtensionId</code><span>@(tool.Governance.Origin.Version ?? extension.Version)</span><ResourceScopeBadge ScopeRef="extension.RegistrationScopeRef" Compact /></div></div>
            }
            else { <div class="tool-catalog-owner"><strong>@ProviderDisplayName(tool)</strong></div> }
            </CollectionValue>
            <CollectionValue Label="@T("Enabled")">@BooleanLabel(tool.Definition.Enabled)</CollectionValue>
        </Information>
        <Actions Context="tool">
<CollectionActions ResourceName="@($"{tool.Definition.DisplayName} ({tool.Namespace}/{tool.Name}, {tool.ScopeRef})")"><a class="text-button" href="@ToolUrl(tool)">@T("Details")</a></CollectionActions></Actions>
    </CollectionView></div>
    <CollectionPager Page="@(page)" Total="@FilteredTools.Count" HasMore="@(page * 20 < FilteredTools.Count)" PageChanged="value => page = value" />
}

@code {
    private string search = string.Empty, availability = string.Empty;
    private int page = 1;
    private IReadOnlyList<ToolResource> FilteredTools => tools.Where(tool =>
        (string.IsNullOrWhiteSpace(search) || new[] { tool.Name, tool.Namespace.Value, tool.Definition.DisplayName, tool.Definition.ExternalId, ProviderDisplayName(tool) }.Any(value => value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true))
        && (string.IsNullOrEmpty(availability) || (tool.Definition.Discovery?.Available == true) == (availability == "available"))).ToArray();
    private IReadOnlyList<ToolResource> PageTools => FilteredTools.Skip((page - 1) * 20).Take(20).ToArray();
    private void SearchChanged(string value) { search = value; page = 1; }
    private void AvailabilityChanged(string value) { availability = value; page = 1; }
    private IReadOnlyList<ToolResource> tools = []; private IReadOnlyList<ToolProviderResource> providers = []; private IReadOnlyList<ExtensionInventoryItemResponse> extensions = []; private bool loading = true; private string? error;
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string AvailabilityLabel(bool available) => T(available ? "Available" : "Unavailable");
    private string BooleanLabel(bool value) => T(value ? "Yes" : "No");
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync() { loading = true; error = null; try { var toolsTask = Client.GetToolsAsync(); var providersTask = Client.GetProvidersAsync(default); await Task.WhenAll(toolsTask, providersTask); tools = toolsTask.Result; providers = providersTask.Result; if (Services.GetService<IExtensionsClient>() is { } client) extensions = await client.GetExtensionInventoryAsync(default); page = Math.Clamp(page, 1, Math.Max(1, (FilteredTools.Count + 19) / 20)); } catch (Exception ex) { error = ex.Message; } finally { loading = false; } }
    private string ProviderDisplayName(ToolResource tool)
    {
        return ManagingExtension(tool)?.DisplayName ?? providers.FirstOrDefault(value =>
            value.Name == tool.Definition.Provider?.Name && value.Namespace == (tool.Definition.Provider?.Namespace ?? tool.Namespace)
            && value.ScopeRef == (tool.Definition.Provider?.ScopeRef ?? tool.ScopeRef))?.Definition.DisplayName
            ?? T("Provider");
    }
    private ExtensionInventoryItemResponse? ManagingExtension(ToolResource tool)
    {
        var provider = providers.SingleOrDefault(value => value.Name == tool.Definition.Provider?.Name
            && value.Namespace == (tool.Definition.Provider?.Namespace ?? tool.Namespace)
            && value.ScopeRef == (tool.Definition.Provider?.ScopeRef ?? tool.ScopeRef));
        var extension = provider?.Definition.Aep?.Extension;
        if (extension is null) return null;
        return extensions.SingleOrDefault(value => value.RegistrationName == extension.Name
            && value.RegistrationNamespace == (extension.Namespace ?? provider!.Namespace).Value
            && value.RegistrationScopeRef == (extension.ScopeRef ?? provider!.ScopeRef));
    }
    private string ToolUrl(ToolResource tool)
    {
        var query = new List<string>();
        if (!tool.Namespace.IsDefault) query.Add($"namespace={Uri.EscapeDataString(tool.Namespace.Value)}");
        if (tool.ScopeRef is { } scopeRef)
        {
            var context = scopeRef.Kind == ResourceScopeKind.Workspace
                && Services.GetService<ConsoleContextState>()?.Current?.WorkspaceId == scopeRef.TargetId
                ? ResourceOwnershipContext.TryGetCurrent(Services) ?? scopeRef : scopeRef;
            query.Add($"scopeRef={Uri.EscapeDataString(scopeRef.Value)}");
            query.Add($"context={Uri.EscapeDataString(context.Value)}");
        }
        var path = $"/tools/{Uri.EscapeDataString(tool.Name)}";
        return query.Count == 0 ? path : $"{path}?{string.Join('&', query)}";
    }
    private static string ExtensionUrl(ExtensionInventoryItemResponse extension)
    {
        var scope = extension.RegistrationScopeRef ?? ResourceScopeRef.Instance;
        return $"/extensions/{Uri.EscapeDataString(extension.RegistrationName!)}?namespace={Uri.EscapeDataString(extension.RegistrationNamespace)}&scopeRef={Uri.EscapeDataString(scope.Value)}&context={Uri.EscapeDataString(scope.Value)}";
    }
}
