@page "/tools"
@implements IDisposable
@inject IToolsClient Client
@inject IServiceProvider Services
@inject ConsoleContextState Context
@inject Microsoft.Extensions.Localization.IStringLocalizer<ToolsStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<ExtensionStrings> ExtensionLocalizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared

<PageTitle>@T("Title") · Agentstration</PageTitle>
<ResourceCollectionTemplate TItem="ToolResource" Title="@T("Title")" Description="@T("Description")" TestId="resource-tools"
                            IdentityColumn="IdentityColumn" Columns="Columns" AdditionalFilters="ExtraFilters" Items="PageItems" ContextKey="@contextKey"
                            Query="query" QueryChanged="ChangeQueryAsync" Pagination="Pagination" LoadState="loadState" Disabled="@(!interactive)"
                            SearchEnabled SearchLabel="@Shared["Search"]" SearchPlaceholder="@Shared["Search"]"
                            EmptyTitle="@T("EmptyTitle")" EmptyMessage="@T("EmptyMessage")" OnRefresh="LoadAsync" OnRetry="RetryAsync">
    <Actions><a class="button-secondary" href="@Navigate("/tools/providers")">@T("Providers")</a></Actions>
    <Navigation><ResourceTabs Label="@T("SectionsLabel")"><a class="active" href="@Navigate("/tools")">@T("Catalog")</a><a href="@Navigate("/tools/sets")">@T("ToolSets")</a><a href="@Navigate("/tools/categories")">@T("Categories")</a><a href="@Navigate("/tools/definitions")">@T("Definitions")</a><a href="@Navigate("/tools/providers")">@T("Providers")</a></ResourceTabs></Navigation>
</ResourceCollectionTemplate>

@code {
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string AvailabilityLabel(bool available) => T(available ? "Available" : "Unavailable");
    private string BooleanLabel(bool value) => T(value ? "Yes" : "No");
    private string Navigate(string path) => ResourceOwnershipContext.PreserveNavigation(path, Services);
    private CollectionColumn<ToolResource> IdentityColumn => new("identity", T("Tool"), tool => @<CollectionIdentity DisplayName="@tool.Definition.DisplayName" Namespace="@tool.Namespace.Value" Name="@tool.Name" Href="@ToolUrl(tool)" IconName="wrench">
        <IconBadges><ResourceScopeBadge ScopeRef="tool.ScopeRef" ShowName IconOnly /><StatusBadge Text="@AvailabilityLabel(tool.Definition.Discovery?.Available == true)" Status="@(tool.Definition.Discovery?.Available == true ? UiStatus.Success : UiStatus.Warning)" IconOnly /><ManagedResourceBadge IsManaged="@tool.Governance.IsManaged" IsReadOnly="@(!ResourceOwnershipContext.CanManage(tool.ScopeRef, Services))" IconOnly /></IconBadges>
    </CollectionIdentity>)
    {
        Filters = [new("availability", T("Availability"), CollectionFilterKind.Choice) { Options = [new("available", T("Available")), new("unavailable", T("Unavailable"))] }]
    };
    private IReadOnlyList<CollectionColumn<ToolResource>> Columns =>
    [
        new("provider", T("Provider"), tool => @<text>@if (ManagingExtension(tool) is { } extension) {
            <div class="tool-catalog-owner"><a class="tool-catalog-extension" href="@ExtensionUrl(extension)">@extension.DisplayName</a><div class="tool-catalog-provenance"><code>@extension.ExtensionId</code><span>@ExtensionLocalizer["ExtensionVersion"]: @extension.Version</span><ResourceScopeBadge ScopeRef="extension.RegistrationScopeRef" Compact /></div>
            @if (tool.Governance.Origin.Version is { } originVersion) { <small>@T("OriginVersion"): @originVersion</small> }</div>
        } else { <div class="tool-catalog-owner"><strong>@ProviderDisplayName(tool)</strong></div> }</text>),
        new("enabled", T("Enabled"), tool => @<span>@BooleanLabel(tool.Definition.Enabled)</span>)
        {
            Filters = [new("enabled", T("Enabled"), CollectionFilterKind.Choice) { Options = [new("true", BooleanLabel(true)), new("false", BooleanLabel(false))] }]
        }
    ];
    private IReadOnlyList<CollectionFilter> ExtraFilters =>
    [
        new("namespace", Shared["Namespace"], CollectionFilterKind.Choice)
        {
            Options = (items ?? []).Select(tool => tool.Namespace.Value).Distinct(StringComparer.Ordinal).Order().Select(value => new CollectionFilterOption(value, value)).ToArray()
        },
        new("scope", ExtensionLocalizer["Scope"], CollectionFilterKind.Choice)
        {
            Options = (items ?? []).Select(tool => tool.ScopeRef?.Value).OfType<string>().Distinct(StringComparer.Ordinal).Order().Select(value => new CollectionFilterOption(value, value)).ToArray()
        }
    ];
    private string ProviderDisplayName(ToolResource tool)
    {
        return ManagingExtension(tool)?.DisplayName ?? providers.FirstOrDefault(value =>
            value.Name == tool.Definition.Provider?.Name && value.Namespace == (tool.Definition.Provider?.Namespace ?? tool.Namespace)
            && value.ScopeRef == (tool.Definition.Provider?.ScopeRef ?? tool.ScopeRef))?.Definition.DisplayName
            ?? T("Provider");
    }
    private ExtensionInventoryItemResponse? ManagingExtension(ToolResource tool)
    {
        var provider = providers.SingleOrDefault(value => value.Name == tool.Definition.Provider?.Name
            && value.Namespace == (tool.Definition.Provider?.Namespace ?? tool.Namespace)
            && value.ScopeRef == (tool.Definition.Provider?.ScopeRef ?? tool.ScopeRef));
        var extension = provider?.Definition.Aep?.Extension;
        if (extension is null) return null;
        return extensions.SingleOrDefault(value => value.RegistrationName == extension.Name
            && value.RegistrationNamespace == (extension.Namespace ?? provider!.Namespace).Value
            && value.RegistrationScopeRef == (extension.ScopeRef ?? provider!.ScopeRef));
    }
    private string ToolUrl(ToolResource tool)
    {
        var query = new List<string>();
        if (!tool.Namespace.IsDefault) query.Add($"namespace={Uri.EscapeDataString(tool.Namespace.Value)}");
        if (tool.ScopeRef is { } scopeRef)
        {
            var context = scopeRef.Kind == ResourceScopeKind.Workspace
                && Services.GetService<ConsoleContextState>()?.Current?.WorkspaceId == scopeRef.TargetId
                ? ResourceOwnershipContext.TryGetCurrent(Services) ?? scopeRef : scopeRef;
            query.Add($"scopeRef={Uri.EscapeDataString(scopeRef.Value)}");
            query.Add($"context={Uri.EscapeDataString(context.Value)}");
        }
        var path = $"/tools/{Uri.EscapeDataString(tool.Name)}";
        return query.Count == 0 ? path : $"{path}?{string.Join('&', query)}";
    }
    private static string ExtensionUrl(ExtensionInventoryItemResponse extension)
    {
        var scope = extension.RegistrationScopeRef ?? ResourceScopeRef.Instance;
        return $"/extensions/{Uri.EscapeDataString(extension.RegistrationName!)}?namespace={Uri.EscapeDataString(extension.RegistrationNamespace)}&scopeRef={Uri.EscapeDataString(scope.Value)}&context={Uri.EscapeDataString(scope.Value)}";
    }
}
