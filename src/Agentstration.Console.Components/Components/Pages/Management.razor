@page "/management"
@implements IDisposable
@inject IManagementApiClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<ManagementStrings> Localizer
<PageTitle>@T("PageTitle")</PageTitle>
<PageHeader Title="@T("Title")" Description="@T("Description")" />
@if (summary is null) { <LoadingState Message="@T("Loading")" /> }
else {
<section class="metric-grid"><MetricCard Label="@T("Agents")" Value="@summary.Agents.ToString()" Status="UiStatus.Info" /><MetricCard Label="@T("Configurations")" Value="@summary.Configurations.ToString()" /><MetricCard Label="@T("Revisions")" Value="@summary.Revisions.ToString()" /><MetricCard Label="@T("Policies")" Value="@summary.Policies.ToString()" /><MetricCard Label="@T("DesiredState")" Value="@Label("State", summary.DesiredState)" Status="UiStatus.Success" /></section>
<section class="dashboard-grid"><article class="panel"><div class="panel-header"><h2>@T("GovernanceResources")</h2><a href="/agents">@T("ManageAgents") →</a></div><div class="health-list"><HealthIndicator Label="@T("AgentResources")" StatusText="@T("AgentResourcesDescription")" Status="UiStatus.Success" /><HealthIndicator Label="@T("ModelProfiles")" StatusText="@T("ModelProfilesDescription")" Status="UiStatus.Success" /><HealthIndicator Label="@T("RuntimeProfiles")" StatusText="@T("RuntimeProfilesDescription")" Status="UiStatus.Success" /><HealthIndicator Label="@T("ModelProviders")" StatusText="@T("ModelProvidersDescription")" Status="UiStatus.Success" /></div><div class="management-links"><a class="button-secondary" href="/modelprofiles">@T("ModelProfiles")</a><a class="button-secondary" href="/runtimeprofiles">@T("RuntimeProfiles")</a><a class="button-secondary" href="/modelproviders">@T("ModelProviders")</a></div></article><article class="panel"><div class="panel-header"><h2>@T("ControlPlane")</h2></div><p>@T("ControlPlaneDescription")</p><StatusBadge Text="@T("SqliteLocal")" Status="UiStatus.Info" /></article></section> }
@code { private readonly CancellationTokenSource cancellation = new(); private ManagementSummary? summary; private string T(string key)=>Localizer[key];private string Label(string prefix,string value){var localized=Localizer[$"{prefix}.{value}"];return localized.ResourceNotFound?value:localized.Value;}protected override async Task OnInitializedAsync() => summary = await Client.GetSummaryAsync(cancellation.Token); public void Dispose(){ cancellation.Cancel(); cancellation.Dispose(); } }
