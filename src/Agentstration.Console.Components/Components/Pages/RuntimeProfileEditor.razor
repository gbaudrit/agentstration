@page "/runtimeprofiles/new"
@page "/runtimeprofiles/{Name}"
@implements IDisposable
@inject IRuntimeProfilesClient Client
@inject NavigationManager Navigation
@inject IServiceProvider Services
@inject NotificationState Notifications
@inject Microsoft.Extensions.Localization.IStringLocalizer<RuntimeProfileEditorStrings> Localizer

<UnsavedNavigationGuard IsDirty="@IsDirty" HasUnsavedChanges="@(() => IsDirty)" />
<PageTitle>@(IsNew ? T("CreateProfile") : $"{Name} · {T("RuntimeProfile")}") · Agentstration</PageTitle>
<PageHeader Title="@(IsNew ? T("CreateProfile") : model?.DisplayName ?? Name)" Description="@T("Description")" TestId="resource-runtime-profile-editor">
    <Actions>@if (!IsNew && CanManage) { <button class="button-danger" @onclick="RequestDelete" data-testid="runtime-profile-delete">@T("Delete")</button> }<a class="button-secondary" href="/runtimeprofiles">@T("Back")</a></Actions>
</PageHeader>

@if (model is null) { <LoadingState Message="@T("Loading")" /> }
else
{
    @if (error is not null) { <div class="form-alert form-alert-danger"><strong>@T("UnableToSave")</strong><span>@error.Message</span></div> }
    @if (!IsNew && selectedScope is { } inheritedOwner) { <InheritedResourceNotice OwnerScopeRef="inheritedOwner" /> }
    @if (CanManage && usages.Count > 0) { <div class="form-alert form-alert-warning">@T("ProfileUsedWarning", DeploymentCount(usages.Count))</div> }
    @if (!IsNew)
    {
        <ResourceTabs Label="@T("RuntimeProfile")"><button type="button" class="@(!accessMode ? "active" : null)" @onclick="() => accessMode = false">@T("Definition")</button>@if (CanManage) { <button type="button" class="@(accessMode ? "active" : null)" data-testid="runtime-profile-access-tab" @onclick="() => accessMode = true">@T("Access")</button> }</ResourceTabs>
    }
    @if (CanManage && accessMode && resource is not null && selectedScope is { } ownerScope)
    {
        <ResourceAccessPanel OwnerScopeRef="ownerScope" Namespace="resource.Namespace" Kind="@RuntimeProfileResourceKinds.RuntimeProfile" Name="@resource.Name" Generation="resource.Generation" Governance="resource.Governance" />
    }
    else
    {
    <EditForm Model="model" OnValidSubmit="SaveAsync" FormName="runtime-profile-editor" class="resource-form" data-testid="runtime-profile-form" data-interactive="@(interactive ? "true" : "false")" data-resource-etag="@etag">
        <DataAnnotationsValidator /><FormDraftMonitor InvalidInputChanged="value => invalidInput = value" /><ValidationSummary />
        <fieldset class="resource-definition-fields" disabled="@(!CanManage || saving)" data-testid="runtime-profile-definition-fields">
        <FormSection Title="@T("RuntimeResource")" Eyebrow="@T("Identity")"><ChildContent><FormGrid>
            <ResourceIdentityFields @bind-DisplayName="model.DisplayName" @bind-TechnicalName="model.Name" IsNew="@IsNew" DisplayNameTestId="runtime-profile-display-name" TechnicalNameTestId="runtime-profile-name" />
            <FormField Label="@T("Namespace")"><ChildContent><ClearableText @bind-Value="model.Namespace" disabled="@(!IsNew)" /></ChildContent><Validation><ValidationMessage For="() => model.Namespace" /></Validation></FormField>
            <ResourceScopeFormField ResourceKind="@RuntimeProfileResourceKinds.RuntimeProfile" Value="@selectedScope" ValueChanged="ScopeChanged" Disabled="@(!IsNew)" />
            <FormField Required="true" Label="@T("RuntimeType")" Class="form-span-2"><ChildContent><ClearableText @bind-Value="model.RuntimeType" /><small>@T("RuntimeTypeHelpPrefix") <code>microsoft-agent-framework</code> @T("RuntimeTypeHelpSuffix")</small></ChildContent><Validation><ValidationMessage For="() => model.RuntimeType" /></Validation></FormField>
        </FormGrid></ChildContent></FormSection>
        <FormSection Title="@T("ExecutionPolicy")" Eyebrow="@T("Defaults")"><ChildContent><FormGrid>
            <FormField Required="true" Label="@T("SessionMode")"><ChildContent><ClearableSelect @bind-Value="model.SessionMode">@foreach (var value in Enum.GetValues<RuntimeSessionMode>()) { <option value="@value">@SessionLabel(value)</option> }</ClearableSelect></ChildContent><Validation><ValidationMessage For="() => model.SessionMode" /></Validation></FormField>
            <FormField Required="true" Label="@T("ToolInvocation")"><ChildContent><ClearableSelect @bind-Value="model.ToolInvocation">@foreach (var value in Enum.GetValues<RuntimeToolInvocationMode>()) { <option value="@value">@ToolInvocationLabel(value)</option> }</ClearableSelect></ChildContent><Validation><ValidationMessage For="() => model.ToolInvocation" /></Validation></FormField>
            <FormField Required="true" Label="@T("Streaming")"><ChildContent><ClearableSelect @bind-Value="model.Streaming">@foreach (var value in Enum.GetValues<StreamingMode>()) { <option value="@value">@StreamingLabel(value)</option> }</ClearableSelect></ChildContent><Validation><ValidationMessage For="() => model.Streaming" /></Validation></FormField>
        </FormGrid></ChildContent></FormSection>
        <FormSection Title="@T("RuntimeOptions")" Eyebrow="@T("Adapter")"><Actions><span>@T("Advanced")</span></Actions><ChildContent><FormGrid><FormField Label="@T("RuntimeSpecificJson")" Class="form-span-2"><ChildContent><ClearableText Multiline @bind-Value="model.RuntimeOptionsJson" rows="8" class="runner-json form-code-editor" /><small>@T("RuntimeJsonHelp")</small></ChildContent><Validation><ValidationMessage For="() => model.RuntimeOptionsJson" /></Validation></FormField></FormGrid></ChildContent></FormSection>
        </fieldset>
        @if (CanManage) { <FormActions Busy="@saving"><a class="button-secondary" href="/runtimeprofiles">@T("Cancel")</a><button class="button-primary" type="submit" disabled="@saving" data-testid="runtime-profile-save">@(saving ? T("Saving") : IsNew ? T("CreateProfileAction") : T("SaveChanges"))</button></FormActions> }
    </EditForm>
    @if (!IsNew && usages.Count > 0) { <section class="panel resource-section"><div class="panel-header"><h2>@T("Deployments")</h2><span>@usages.Count</span></div><ul>@foreach (var usage in usages) { <li><CollectionIdentity DisplayName="@usage.Name" Name="@usage.ResourceId" IconName="activity" /><small>@usage.Environment</small></li> }</ul></section> }
    }
}

<ConfirmationDialog IsOpen="@confirmDelete" Title="@T("DeleteDialogTitle")" Message="@T("DeleteDialogMessage", Name ?? string.Empty)" ConfirmLabel="@T("DeleteDialogConfirm")" OnConfirm="DeleteAsync" OnCancel="() => confirmDelete = false" TestId="runtime-profile-delete-dialog" />

@code {
    [Parameter] public string? Name { get; set; }
    [SupplyParameterFromQuery(Name = "namespace")] public string? Namespace { get; set; }
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string DeploymentCount(int count) => T(count == 1 ? "DeploymentCount.One" : "DeploymentCount.Many", count);
    private string SessionLabel(RuntimeSessionMode value) => Localizer[$"Session.{value}"];
    private string ToolInvocationLabel(RuntimeToolInvocationMode value) => Localizer[$"ToolInvocation.{value}"];
    private string StreamingLabel(StreamingMode value) => Localizer[$"Streaming.{value}"];
    private readonly CancellationTokenSource cancellation = new();
    private RuntimeProfileEditorModel? model; private RuntimeProfileResource? resource; private IReadOnlyList<RuntimeProfileUsageResponse> usages = []; private string? etag; private AgentstrationApiException? error; private bool saving; private bool confirmDelete; private bool interactive; private bool accessMode;
    private ResourceScopeRef? selectedScope;
    private bool invalidInput;
    private string savedFingerprint = string.Empty;
    private void ScopeChanged(ResourceScopeRef? value)
    {
        var initializing = IsNew && selectedScope is null && Fingerprint == savedFingerprint;
        selectedScope = value;
        if (initializing) savedFingerprint = Fingerprint;
    }
    private string Fingerprint => JsonSerializer.Serialize(new { model, selectedScope });
    private bool IsDirty => model is not null && CanManage && (Fingerprint != savedFingerprint || invalidInput);
    private bool IsNew => string.IsNullOrWhiteSpace(Name);
    private bool CanManage => IsNew || ResourceOwnershipContext.CanManage(selectedScope, Services);
    private ResourceNamespace SelectedNamespace => ResourceNamespace.Parse(Namespace);
    protected override Task OnParametersSetAsync() => LoadAsync();
    protected override void OnAfterRender(bool firstRender) { if (!firstRender) return; interactive = true; StateHasChanged(); }
    private async Task LoadAsync() { error = null; if (IsNew) { model = new RuntimeProfileEditorModel { Namespace = SelectedNamespace.Value }; savedFingerprint = Fingerprint; return; } try { var snapshot = await Client.GetRuntimeProfileAsync(SelectedNamespace, Name!, cancellation.Token); resource = snapshot.Value; model = RuntimeProfileEditorModel.FromResource(snapshot.Value); selectedScope = snapshot.Value.ScopeRef; etag = snapshot.ETag; usages = (await Client.GetRuntimeProfileUsagesAsync(SelectedNamespace, model.Name, cancellation.Token)).Value; } catch (AgentstrationApiException exception) { error = exception; model ??= new RuntimeProfileEditorModel { Namespace = SelectedNamespace.Value }; } finally { savedFingerprint = Fingerprint; } }
    private async Task SaveAsync()
    {
        if (!CanManage || model is null || saving) return;
        saving = true;
        error = null;
        try
        {
            var wasNew = IsNew;
            var @namespace = ResourceNamespace.Parse(model.Namespace);
            var snapshot = wasNew
                ? await Client.CreateRuntimeProfileAsync(model.ToCreateRequest() with { ScopeRef = selectedScope }, cancellation.Token)
                : await Client.UpdateRuntimeProfileAsync(@namespace, model.Name, model.ToPutRequest(), etag!, cancellation.Token);
            Notifications.Add(new NotificationItem(Guid.NewGuid(), wasNew ? T("CreatedNotification") : T("UpdatedNotification"), snapshot.Value.Name, DateTimeOffset.Now, UiStatus.Success));
            savedFingerprint = Fingerprint;
            if (wasNew) Navigation.NavigateTo(DetailsUrl(snapshot.Value.Namespace, snapshot.Value.Name));
            else
            {
                resource = snapshot.Value;
                model = RuntimeProfileEditorModel.FromResource(snapshot.Value);
                selectedScope = snapshot.Value.ScopeRef;
                etag = snapshot.ETag;
                savedFingerprint = Fingerprint;
            }
        }
        catch (ArgumentException exception) { error = new AgentstrationApiException(exception.Message, Guid.NewGuid().ToString("N")); }
        catch (AgentstrationApiException exception) { error = exception; }
        finally { saving = false; }
    }
    private void RequestDelete() { if (!CanManage) return; if (usages.Count == 0) confirmDelete = true; else error = new AgentstrationApiException(T("ProfileUsedError", DeploymentCount(usages.Count)), Guid.NewGuid().ToString("N")); }
    private async Task DeleteAsync() { if (!CanManage || model is null || etag is null) return; confirmDelete = false; try { await Client.DeleteRuntimeProfileAsync(ResourceNamespace.Parse(model.Namespace), model.Name, etag, cancellation.Token); savedFingerprint = Fingerprint; invalidInput = false; Navigation.NavigateTo("/runtimeprofiles"); } catch (AgentstrationApiException exception) { error = exception; } }
    private static string DetailsUrl(ResourceNamespace @namespace, string name) => $"/runtimeprofiles/{Uri.EscapeDataString(name)}?namespace={Uri.EscapeDataString(@namespace.Value)}";
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
