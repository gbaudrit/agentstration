@page "/runtimeprofiles/new"
@page "/runtimeprofiles/{Name}"
@implements IDisposable
@inject IRuntimeProfilesClient Client
@inject NavigationManager Navigation
@inject IServiceProvider Services
@inject NotificationState Notifications
@inject Microsoft.Extensions.Localization.IStringLocalizer<RuntimeProfileEditorStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared

<UnsavedNavigationGuard IsDirty="@IsDirty" HasUnsavedChanges="@(() => IsDirty)" ViewQueryParameters="@(new[] { "view", "tab" })" />
<PageTitle>@(IsNew ? T("CreateProfile") : $"{Name} · {T("RuntimeProfile")}") · Agentstration</PageTitle>
@{
    RenderFragment feedback = @<div>
        @if (error is not null) { <div class="form-alert form-alert-danger" role="alert"><strong>@T("UnableToSave")</strong><span>@error.Message</span></div> }
        @if (!IsNew && selectedScope is { } owner) { <InheritedResourceNotice OwnerScopeRef="owner" /> }
        @if (CanManage && usages.Count > 0) { <div class="form-alert form-alert-warning">@T("ProfileUsedWarning", DeploymentCount(usages.Count))</div> }
    </div>;
}
@if (loading) { <LoadingState Message="@T("Loading")" /> }
else if (model is null) { @feedback }
else if (IsNew)
{
    <PageHeader Title="@T("CreateProfile")" Description="@T("Description")" TestId="resource-runtime-profile-editor"><Actions><a class="button-secondary" href="/runtimeprofiles">@T("Back")</a></Actions></PageHeader>
    @feedback
    <EditForm @key="model" EditContext="FormContext" FormName="runtime-profile-editor" class="resource-form" data-testid="runtime-profile-form" data-interactive="@(interactive ? "true" : "false")">
        <DataAnnotationsValidator /><FormDraftMonitor InvalidInputChanged="value => invalidInput = value" />
        <p class="required-fields-note"><span aria-hidden="true">*</span> @Shared["RequiredFields"]</p>
        <fieldset class="resource-definition-fields" disabled="@saving" data-testid="runtime-profile-definition-fields"><CreationWizard Steps="Steps" OnFinish="FinishAsync" Busy="saving" FinishLabel="@T("CreateProfileAction")" FinishTestId="runtime-profile-save" /></fieldset>
    </EditForm>
}
else if (resource is not null)
{
    <ResourceDetailsTemplate Name="@resource.Definition.DisplayName" ResourceType="@T("RuntimeProfile")" Domain="runtime" IconName="server"
                             TechnicalName="@resource.Name" Namespace="@resource.Namespace.Value" ScopeRef="resource.ScopeRef"
                             Sections="Sections" ResourceIdentity="@($"{loadedKey}|{resource.ScopeRef}")" DefaultSection="overview" SelectionChanged="SelectSection" Feedback="@feedback" HasDraft="@HasMetadataDraft" TestId="resource-runtime-profile-editor">
        <Metadata>@if (section is "definition/configuration" or "definition/execution") { <span class="required-fields-note"><span aria-hidden="true">*</span> @Shared["RequiredFields"]</span> }</Metadata>
        <Actions>@if (CanManage) { <button class="button-danger" type="button" @onclick="RequestDelete" disabled="@saving" data-testid="runtime-profile-delete">@T("Delete")</button> }<a class="button-secondary" href="/runtimeprofiles">@T("Back")</a></Actions>
        <Content>
            <div hidden="@(section != "overview")">
                <ResourceIdentitySummary DisplayName="@resource.Definition.DisplayName" TechnicalName="@resource.Name" Namespace="@resource.Namespace.Value"><Scope><ResourceScopeBadge ScopeRef="resource.ScopeRef" /></Scope></ResourceIdentitySummary>
                <FormSection Title="@Shared["Configuration"]" Class="resource-configuration-summary"><CollectionView TItem="ConfigurationEntry" Items="SavedConfiguration" IdentityLabel="@Shared["Configuration"]" InformationLabels="@(new[] { Shared["Saved"].Value })"><Identity Context="entry"><strong class="configuration-key">@entry.Label</strong></Identity><Information Context="entry"><CollectionValue Label="@Shared["Saved"]"><span class="configuration-value">@entry.Value</span></CollectionValue></Information></CollectionView></FormSection>
            </div>
            <div hidden="@(!section.StartsWith("definition/", StringComparison.Ordinal))">
                <EditForm @key="model" EditContext="FormContext" OnValidSubmit="SaveAsync" OnInvalidSubmit="InvalidSubmit" FormName="runtime-profile-editor" id="runtime-profile-resource-form" class="resource-form" data-testid="runtime-profile-form" data-interactive="@(interactive ? "true" : "false")" data-resource-etag="@etag">
                    <DataAnnotationsValidator /><FormDraftMonitor InvalidInputChanged="value => invalidInput = value" />
                    <fieldset class="resource-definition-fields" disabled="@(!CanManage || saving)" data-testid="runtime-profile-definition-fields"><div hidden="@(section != "definition/configuration")">@IdentityFields</div><div hidden="@(section != "definition/execution")">@ExecutionFields</div><div hidden="@(section != "definition/options")">@OptionsFields</div></fieldset>
                </EditForm>
            </div>
            <div hidden="@(section != "deployments")">@Deployments</div>
            @if (accessVisited && CanManageAccess && selectedScope is { } ownerScope) { <div hidden="@(section != "access")"><ResourceAccessPanel ResourceUid="resource.Uid" DraftChanged="value => policyDirty = value" OwnerScopeRef="ownerScope" Namespace="resource.Namespace" Kind="@RuntimeProfileResourceKinds.RuntimeProfile" Name="@resource.Name" Generation="resource.Generation" Governance="resource.Governance" /></div> }
        </Content>
        <DraftActions><button type="button" class="button-secondary" disabled="@saving" @onclick="Discard">@Shared["Discard"]</button><button type="submit" form="runtime-profile-resource-form" class="button-primary" disabled="@saving" data-testid="runtime-profile-save">@(saving ? T("Saving") : T("SaveChanges"))</button></DraftActions>
    </ResourceDetailsTemplate>
}
<ConfirmationDialog IsOpen="@confirmDelete" Title="@T("DeleteDialogTitle")" Message="@T("DeleteDialogMessage", Name ?? string.Empty)" ConfirmLabel="@T("DeleteDialogConfirm")" OnConfirm="DeleteAsync" OnCancel="() => confirmDelete = false" TestId="runtime-profile-delete-dialog" />

@code {
    private RenderFragment IdentityFields => @<div>        <FormSection Title="@T("Identity")"><ChildContent><FormGrid>
            <ResourceIdentityFields @bind-DisplayName="Model.DisplayName" @bind-TechnicalName="Model.Name" IsNew="@IsNew" DisplayNameTestId="runtime-profile-display-name" TechnicalNameTestId="runtime-profile-name" />
            <FormField Label="@T("Namespace")"><ChildContent><ClearableText @bind-Value="Model.Namespace" disabled="@(!IsNew)" /></ChildContent><Validation><ValidationMessage For="() => Model.Namespace" /></Validation></FormField>
            <ResourceScopeFormField ResourceKind="@RuntimeProfileResourceKinds.RuntimeProfile" Value="@selectedScope" ValueChanged="ScopeChanged" Disabled="@(!IsNew)" />
            <FormField Required="true" Label="@T("RuntimeType")" Class="form-span-2"><ChildContent><ClearableText @bind-Value="Model.RuntimeType" /><small>@T("RuntimeTypeHelpPrefix") <code>microsoft-agent-framework</code> @T("RuntimeTypeHelpSuffix")</small></ChildContent><Validation><ValidationMessage For="() => Model.RuntimeType" /></Validation></FormField>
        </FormGrid></ChildContent></FormSection>
</div>;
    private RenderFragment ExecutionFields => @<div>        <FormSection Title="@T("ExecutionPolicy")" Eyebrow="@T("Defaults")"><ChildContent><FormGrid>
            <FormField Required="true" Label="@T("SessionMode")"><ChildContent><ClearableSelect @bind-Value="Model.SessionMode">@foreach (var value in Enum.GetValues<RuntimeSessionMode>()) { <option value="@value">@SessionLabel(value)</option> }</ClearableSelect></ChildContent><Validation><ValidationMessage For="() => Model.SessionMode" /></Validation></FormField>
            <FormField Required="true" Label="@T("ToolInvocation")"><ChildContent><ClearableSelect @bind-Value="Model.ToolInvocation">@foreach (var value in Enum.GetValues<RuntimeToolInvocationMode>()) { <option value="@value">@ToolInvocationLabel(value)</option> }</ClearableSelect></ChildContent><Validation><ValidationMessage For="() => Model.ToolInvocation" /></Validation></FormField>
            <FormField Required="true" Label="@T("Streaming")"><ChildContent><ClearableSelect @bind-Value="Model.Streaming">@foreach (var value in Enum.GetValues<StreamingMode>()) { <option value="@value">@StreamingLabel(value)</option> }</ClearableSelect></ChildContent><Validation><ValidationMessage For="() => Model.Streaming" /></Validation></FormField>
        </FormGrid></ChildContent></FormSection>
</div>;
    private RenderFragment OptionsFields => @<div>        <FormSection Title="@T("RuntimeOptions")" Eyebrow="@T("Adapter")"><Actions><span>@T("Advanced")</span></Actions><ChildContent><FormGrid><FormField Label="@T("RuntimeSpecificJson")" Class="form-span-2"><ChildContent><ClearableText Multiline Value="@Model.RuntimeOptionsJson" ValueChanged="OptionsChanged" ValueExpression="() => Model.RuntimeOptionsJson" rows="8" class="runner-json form-code-editor" /><small>@T("RuntimeJsonHelp")</small></ChildContent><Validation><ValidationMessage For="() => Model.RuntimeOptionsJson" /></Validation></FormField></FormGrid></ChildContent></FormSection>
</div>;
    private RenderFragment Deployments => @<div>    @if (!IsNew && usages.Count > 0) { <section class="panel resource-section"><div class="panel-header"><h2>@T("Deployments")</h2><span>@usages.Count</span></div><ul>@foreach (var usage in usages) { <li><CollectionIdentity DisplayName="@usage.Name" Name="@usage.ResourceId" IconName="activity" /><small>@usage.Environment</small></li> }</ul></section> }</div>;
    private RenderFragment Review => @<FormSection Title="@Shared["Verification"]"><ChildContent><dl class="resource-details"><dt>@T("Identity")</dt><dd>@Model.DisplayName<br /><code>@Model.Namespace/@Model.Name</code></dd><dt>@Shared["Scope"]</dt><dd><ResourceScopeBadge ScopeRef="selectedScope" /></dd><dt>@T("RuntimeType")</dt><dd>@Model.RuntimeType</dd><dt>@T("SessionMode")</dt><dd>@SessionLabel(Model.SessionMode)</dd><dt>@T("ToolInvocation")</dt><dd>@ToolInvocationLabel(Model.ToolInvocation)</dd><dt>@T("Streaming")</dt><dd>@StreamingLabel(Model.Streaming)</dd></dl></ChildContent></FormSection>;

    private RuntimeProfileEditorModel Model => model!;
    [Parameter] public string? Name { get; set; }
    [SupplyParameterFromQuery(Name = "scopeRef")] public string? ScopeRefValue { get; set; }
    [SupplyParameterFromQuery(Name = "namespace")] public string? Namespace { get; set; }
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string DeploymentCount(int count) => T(count == 1 ? "DeploymentCount.One" : "DeploymentCount.Many", count);
    private string SessionLabel(RuntimeSessionMode value) => Localizer[$"Session.{value}"];
    private string ToolInvocationLabel(RuntimeToolInvocationMode value) => Localizer[$"ToolInvocation.{value}"];
    private string StreamingLabel(StreamingMode value) => Localizer[$"Streaming.{value}"];
    private readonly CancellationTokenSource cancellation = new();
    private RuntimeProfileEditorModel? model; private RuntimeProfileResource? resource; private IReadOnlyList<RuntimeProfileUsageResponse> usages = []; private string? etag; private AgentstrationApiException? error; private bool saving; private bool confirmDelete; private bool interactive; private bool loading;
    private ResourceScopeRef? selectedScope;
    private bool invalidInput;
    private string savedFingerprint = string.Empty;
    private void ScopeChanged(ResourceScopeRef? value)
    {
        var initializing = IsNew && selectedScope is null && Fingerprint == savedFingerprint;
        selectedScope = value;
        if (initializing) savedFingerprint = Fingerprint;
    }
    private string Fingerprint => JsonSerializer.Serialize(new { model, selectedScope });
    private bool policyDirty, accessVisited;
    private bool IsDirty => HasMetadataDraft || policyDirty;
    private bool HasMetadataDraft => !loading && model is not null && CanManage && (Fingerprint != savedFingerprint || invalidInput);
    private bool IsNew => string.IsNullOrWhiteSpace(Name);
    private bool CanManageAccess => resource is not null && selectedScope is not null && ResourceOwnershipContext.CanManage(selectedScope, Services);
    private bool CanManage => IsNew || resource is not null && !resource.Governance.IsManaged && ResourceOwnershipContext.CanManage(selectedScope, Services);
    private ResourceNamespace SelectedNamespace => ResourceNamespace.Parse(Namespace);
    private string section = "overview";
    private string? loadedKey;
    private long loadVersion;
    private EditContext? editContext;
    private EditContext FormContext => editContext is not null && ReferenceEquals(editContext.Model, model) ? editContext : editContext = new(model!);
    private ValidationMessageStore? optionMessages;
    private EditContext? optionContext;
    private bool ValidIdentityField(string name, object value) => model is not null && System.ComponentModel.DataAnnotations.Validator.TryValidateProperty(value, new(model) { MemberName = name }, null);
    private bool IdentityComplete
    {
        get
        {
            if (model is null || selectedScope is null || !ValidIdentityField(nameof(model.Name), model.Name) || !ValidIdentityField(nameof(model.DisplayName), model.DisplayName) || !ValidIdentityField(nameof(model.RuntimeType), model.RuntimeType)) return false;
            try { _ = ResourceNamespace.Parse(model.Namespace); return true; } catch (ArgumentException) { return false; }
        }
    }
    private bool ExecutionComplete => model is not null && new[] { nameof(model.SessionMode), nameof(model.ToolInvocation), nameof(model.Streaming) }.All(name => !FormContext.GetValidationMessages(new FieldIdentifier(model, name)).Any());
    private bool OptionsComplete { get { if (model is null) return false; try { _ = model.ToProperties(); return true; } catch (ArgumentException) { return false; } } }
    private bool ValidateOptions()
    {
        if (model is null) return false;
        if (optionContext != FormContext) { optionContext = FormContext; optionMessages = new(optionContext); }
        optionMessages!.Clear();
        var valid = OptionsComplete;
        if (!valid) optionMessages.Add(new FieldIdentifier(model, nameof(model.RuntimeOptionsJson)), T("OptionsInvalid"));
        FormContext.NotifyValidationStateChanged(); return valid;
    }
    private void OptionsChanged(string? value)
    {
        if (model is null) return;
        model.RuntimeOptionsJson = value;
        if (optionContext == FormContext) { optionMessages?.Clear(); FormContext.NotifyValidationStateChanged(); }
    }
    private void SelectSection(string? path) { section = path ?? "overview"; if (section == "access" && CanManageAccess) accessVisited = true; }
    private void ShowSection(string path) { section = path; if (!IsNew) Navigation.NavigateTo(Navigation.Uri.Split('#')[0] + "#" + path); }
    private void InvalidSubmit(EditContext context)
    {
        var optionsInvalid = model is not null && context.GetValidationMessages(new FieldIdentifier(model, nameof(model.RuntimeOptionsJson))).Any();
        ShowSection(!IdentityComplete ? "definition/configuration" : optionsInvalid ? "definition/options" : "definition/execution");
    }
    private IReadOnlyList<ResourceNavigationItem> Sections =>
    [
        new("overview", Shared["Overview"], "home"),
        new("definition", T("Definition"), "settings") { Navigable = false, Visible = CanManage },
        new("definition/configuration", Shared["Configuration"], "forms") { Visible = CanManage },
        new("definition/execution", T("ExecutionPolicy"), "server") { Visible = CanManage },
        new("definition/options", T("RuntimeOptions"), "code") { Visible = CanManage },
        new("deployments", T("Deployments"), "list-check") { Visible = usages.Count > 0 },
        new("access", T("Access"), "key") { Visible = CanManageAccess }
    ];
    private IReadOnlyList<CreationWizardStep> Steps =>
    [
        new("identity", T("Identity"), IdentityFields) { IsComplete = IdentityComplete },
        new("execution", T("ExecutionPolicy"), ExecutionFields) { IsComplete = ExecutionComplete },
        new("options", T("RuntimeOptions"), OptionsFields) { IsComplete = OptionsComplete },
        new("review", Shared["Verification"], Review) { IsComplete = IdentityComplete && ExecutionComplete && OptionsComplete }
    ];
    private async Task FinishAsync(CreationWizardFinish finish)
    {
        var valid = FormContext.Validate(); var optionsValid = ValidateOptions();
        if (!valid || !optionsValid || !IdentityComplete) { finish.ReturnToStepId = !IdentityComplete ? "identity" : !ExecutionComplete ? "execution" : "options"; return; }
        await SaveAsync();
    }
    private void Discard()
    {
        if (saving || resource is null) return;
        model = RuntimeProfileEditorModel.FromResource(resource); selectedScope = resource.ScopeRef;
        invalidInput = false; savedFingerprint = Fingerprint; error = null;
    }
    private sealed record ConfigurationEntry(string Label, string Value);
    private IReadOnlyList<ConfigurationEntry> SavedConfiguration => resource is null ? [] :
    [
        new(T("RuntimeType"), resource.Definition.RuntimeType),
        new(T("SessionMode"), SessionLabel(resource.Definition.Execution.SessionMode)),
        new(T("ToolInvocation"), ToolInvocationLabel(resource.Definition.Execution.ToolInvocation)),
        new(T("Streaming"), StreamingLabel(resource.Definition.Execution.Streaming)),
        new(T("RuntimeOptions"), resource.Definition.RuntimeOptions.Count == 0 ? Shared["NotProvided"] : JsonSerializer.Serialize(resource.Definition.RuntimeOptions, new JsonSerializerOptions { WriteIndented = true }))
    ];
    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Name}|{Namespace}|{ScopeRefValue}|{ResourceOwnershipContext.TryGetCurrent(Services)}";
        if (loadedKey == key) return;
        loadedKey = key; var version = ++loadVersion; loading = true; error = null; policyDirty = accessVisited = false; model = null; resource = null; usages = []; section = "overview";
        try
        {
            if (IsNew) { model = new() { Namespace = SelectedNamespace.Value }; selectedScope = null; return; }
            var snapshot = await Client.GetRuntimeProfileAsync(SelectedNamespace, Name!, cancellation.Token);
            var references = (await Client.GetRuntimeProfileUsagesAsync(SelectedNamespace, snapshot.Value.Name, cancellation.Token)).Value;
            if (version != loadVersion) return;
            resource = snapshot.Value; model = RuntimeProfileEditorModel.FromResource(resource); selectedScope = resource.ScopeRef; etag = snapshot.ETag; usages = references;
        }
        catch (AgentstrationApiException exception) { if (version == loadVersion) { error = exception; loadedKey = null; } }
        finally { if (version == loadVersion) { loading = false; invalidInput = false; savedFingerprint = Fingerprint; } }
    }
    protected override void OnAfterRender(bool firstRender) { if (!firstRender) return; interactive = true; StateHasChanged(); }
    private async Task SaveAsync()
    {
        if (!CanManage || model is null || saving) return;
        if (!ValidateOptions()) { ShowSection("definition/options"); return; }
        saving = true;
        error = null;
        try
        {
            var wasNew = IsNew;
            var @namespace = ResourceNamespace.Parse(model.Namespace);
            var snapshot = wasNew
                ? await Client.CreateRuntimeProfileAsync(model.ToCreateRequest() with { ScopeRef = selectedScope }, cancellation.Token)
                : await Client.UpdateRuntimeProfileAsync(@namespace, model.Name, model.ToPutRequest(), etag!, cancellation.Token);
            Notifications.Add(new NotificationItem(Guid.NewGuid(), wasNew ? T("CreatedNotification") : T("UpdatedNotification"), snapshot.Value.Name, DateTimeOffset.Now, UiStatus.Success));
            invalidInput = false; savedFingerprint = Fingerprint;
            if (wasNew) Navigation.NavigateTo(ResourceOwnershipContext.Resource(Services, "/runtimeprofiles", snapshot.Value.Name, snapshot.Value.Namespace, snapshot.Value.ScopeRef));
            else
            {
                resource = snapshot.Value;
                model = RuntimeProfileEditorModel.FromResource(snapshot.Value);
                selectedScope = snapshot.Value.ScopeRef;
                etag = snapshot.ETag;
                savedFingerprint = Fingerprint;
            }
        }
        catch (ArgumentException exception) { error = new AgentstrationApiException(exception.Message, Guid.NewGuid().ToString("N")); }
        catch (AgentstrationApiException exception) { error = exception; }
        finally { saving = false; }
    }
    private void RequestDelete() { if (!CanManage) return; if (usages.Count == 0) confirmDelete = true; else error = new AgentstrationApiException(T("ProfileUsedError", DeploymentCount(usages.Count)), Guid.NewGuid().ToString("N")); }
    private async Task DeleteAsync() { if (!CanManage || model is null || etag is null) return; confirmDelete = false; try { await Client.DeleteRuntimeProfileAsync(ResourceNamespace.Parse(model.Namespace), model.Name, etag, cancellation.Token); savedFingerprint = Fingerprint; invalidInput = false; Navigation.NavigateTo("/runtimeprofiles"); } catch (AgentstrationApiException exception) { error = exception; } }
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
