@page "/settings/organization/members/{UserId:guid}"
@inject Agentstration.Web.Console.IIdentityAdministrationApiClient Client
@inject ConsoleContextState ContextState
@inject Microsoft.Extensions.Localization.IStringLocalizer<OrganizationStrings> Localizer

<PageTitle>@T("MemberAccess") · Agentstration</PageTitle>
@if (member is null) { <LoadingState Message="@T("LoadingMemberAccess")" /> }
else
{
    <PageHeader Title="@member.Principal.DisplayName" Description="@T("MemberAccess.Description")" />
    <OrganizationSettingsNav />
    <section class="dashboard-grid">
        <article class="panel"><div class="panel-header"><h2>@T("Principal")</h2><StatusBadge Text="@T($"Status.{member.Principal.Status}")" Status="UiStatus.Success" /></div><p><strong>@T("Kind"):</strong> @member.Principal.Kind</p><p><strong>@T("Email"):</strong> @(member.Principal.Email ?? "—")</p><p><strong>@T("PrincipalId"):</strong> <code>@member.Principal.Id</code></p><p><strong>@T("InstanceRole"):</strong> @(targetIsPlatformAdministrator ? T("PlatformAdministrator") : "—")</p>@foreach(var identity in member.ExternalIdentities){<p><strong>@T("ExternalIdentity"):</strong> <code>@identity.Issuer</code> · <code>@identity.Subject</code></p>}</article>
        <article class="panel"><div class="panel-header"><h2>@T("Membership")</h2><StatusBadge Text="@T($"Status.{member.Membership.Status}")" Status="UiStatus.Success" /></div><p>@T("JoinedAt", member.Membership.JoinedAt.ToLocalTime().ToString("g"))</p></article>
    </section>
    <section class="panel" style="margin-top:18px"><div class="panel-header"><h2>@T("RoleAssignments")</h2></div>@if(member.Roles.Count == 0){<EmptyState Title="@T("NoAccessAssigned")" Message="@T("MembershipNoAccess")" />}else{@foreach(var assigned in member.Roles){<article><p><strong>@assigned.Role.DisplayName</strong> @if(assigned.Scope.StartsWith("/tenants/",StringComparison.Ordinal)){<StatusBadge Text="@T("Inherited")" Status="UiStatus.Info" />}</p><code>@assigned.Scope</code></article>}}</section>
    <section class="panel" style="margin-top:18px">
        <div class="panel-header"><div><h2>@T("CurrentWorkspaceMembership")</h2><p class="muted">@T("WorkspaceMembershipHelp")</p></div></div>
        @if (!string.IsNullOrWhiteSpace(message)) { <p class="form-alert @(hasError ? "form-alert-danger" : "form-alert-success")">@message</p> }
        <div class="form-grid"><label><span>@T("Role")</span><select @bind="selectedRole">@foreach(var role in Agentstration.Management.Contracts.BuiltInIdentityRoleNames.All){<option value="@role">@role</option>}</select></label></div>
        <div class="form-actions"><button class="button-primary" @onclick="SaveMembershipAsync">@T("SaveRole")</button>@if(workspaceMembership is not null){<button class="button-secondary" @onclick="RemoveMembershipAsync">@T("RemoveFromWorkspace")</button>}</div>
    </section>
    @if (canManagePlatformAdministrators)
    {
        <section class="panel" style="margin-top:18px">
            <div class="panel-header"><div><h2>@T("ExternalAuthentication")</h2><p class="muted">@T("ExternalAuthenticationHelp")</p></div></div>
            @if (!string.IsNullOrWhiteSpace(identityMessage)) { <p class="form-alert @(identityError ? "form-alert-danger" : "form-alert-success")">@identityMessage</p> }
            <div class="form-grid">
                <label><span>@T("Issuer")</span><input @bind="newIssuer" placeholder="https://identity.example/realms/company" autocomplete="off" /></label>
                <label><span>@T("Subject")</span><input @bind="newSubject" autocomplete="off" /></label>
            </div>
            <div class="form-actions"><button class="button-primary" @onclick="LinkExternalIdentityAsync">@T("LinkExternalIdentity")</button></div>
            @if (member.ExternalIdentities.Count > 0)
            {
                <DataGrid TItem="ExternalIdentity" Items="member.ExternalIdentities">
                    <Header><tr><th>@T("Issuer")</th><th>@T("Subject")</th><th>@T("Linked")</th><th></th></tr></Header>
                    <Row Context="identity"><tr><td><code>@identity.Issuer</code></td><td><code>@identity.Subject</code></td><td>@identity.LinkedAt.ToLocalTime().ToString("g")</td><td><button class="text-button" @onclick="() => UnlinkExternalIdentityAsync(identity.Id)">@T("Unlink")</button></td></tr></Row>
                </DataGrid>
            }
        </section>
        <section class="panel" style="margin-top:18px">
            <div class="panel-header"><div><h2>@T("InstanceAdministration")</h2><p class="muted">@T("InstanceAdministrationHelp")</p></div></div>
            @if (!string.IsNullOrWhiteSpace(platformMessage)) { <p class="form-alert @(platformError ? "form-alert-danger" : "form-alert-success")">@platformMessage</p> }
            <div class="form-actions">
                @if (targetIsPlatformAdministrator)
                {
                    <button class="button-secondary" @onclick="RevokePlatformAdministratorAsync" disabled="@(UserId == ContextState.Current?.UserId)">@T("RevokePlatformAdmin")</button>
                }
                else
                {
                    <button class="button-primary" @onclick="GrantPlatformAdministratorAsync" disabled="@(member.Principal.Status != PrincipalStatus.Active)">@T("GrantPlatformAdmin")</button>
                }
            </div>
        </section>
    }
}

@code {
    [Parameter] public Guid UserId { get; set; }
    private Agentstration.Management.Contracts.OrganizationMemberResponse? member;
    private Agentstration.Management.Contracts.WorkspaceMemberResponse? workspaceMembership; private string selectedRole = Agentstration.Management.Contracts.BuiltInIdentityRoleNames.Viewer; private string? message; private bool hasError;
    private bool canManagePlatformAdministrators; private bool targetIsPlatformAdministrator; private string? platformMessage; private bool platformError;
    private string newIssuer = ""; private string newSubject = ""; private string? identityMessage; private bool identityError;
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    protected override async Task OnParametersSetAsync()
    {
        if (ContextState.Current is null) await ContextState.LoadAsync(default);
        var workspaceId = ContextState.Current?.WorkspaceId ?? throw new InvalidOperationException("The Console context is unavailable.");
        member = (await Client.GetOrganizationAsync(default)).Members.SingleOrDefault(value => value.Principal.Id == UserId);
        workspaceMembership = (await Client.GetWorkspaceMembersAsync(workspaceId, default)).SingleOrDefault(value => value.Principal.Id == UserId);
        selectedRole = workspaceMembership?.Role ?? Agentstration.Management.Contracts.BuiltInIdentityRoleNames.Viewer;
        canManagePlatformAdministrators = (await Client.GetCapabilitiesAsync(default)).IsPlatformAdministrator;
        if (canManagePlatformAdministrators)
            targetIsPlatformAdministrator = (await Client.GetPlatformAdministratorsAsync(default)).Any(value => value.Principal.Id == UserId);
    }
    private async Task SaveMembershipAsync()
    {
        try { workspaceMembership = await Client.SetWorkspaceMembershipAsync(ContextState.Current!.WorkspaceId, UserId, selectedRole, default); hasError = false; message = T("WorkspaceRoleUpdated"); }
        catch (Agentstration.Web.Console.AgentstrationApiException exception) { hasError = true; message = exception.Message; }
    }
    private async Task RemoveMembershipAsync()
    {
        try { await Client.RemoveWorkspaceMembershipAsync(ContextState.Current!.WorkspaceId, UserId, default); workspaceMembership = null; hasError = false; message = T("PrincipalRemoved"); }
        catch (Agentstration.Web.Console.AgentstrationApiException exception) { hasError = true; message = exception.Message; }
    }
    private async Task GrantPlatformAdministratorAsync()
    {
        try { await Client.GrantPlatformAdministratorAsync(UserId, default); targetIsPlatformAdministrator = true; platformError = false; platformMessage = T("PlatformAdminGranted"); }
        catch (Agentstration.Web.Console.AgentstrationApiException exception) { platformError = true; platformMessage = exception.Message; }
    }
    private async Task RevokePlatformAdministratorAsync()
    {
        try { await Client.RevokePlatformAdministratorAsync(UserId, default); targetIsPlatformAdministrator = false; platformError = false; platformMessage = T("PlatformAdminRevoked"); }
        catch (Agentstration.Web.Console.AgentstrationApiException exception) { platformError = true; platformMessage = exception.Message; }
    }
    private async Task LinkExternalIdentityAsync()
    {
        try
        {
            await Client.LinkExternalIdentityAsync(UserId, newIssuer, newSubject, default);
            member = (await Client.GetOrganizationAsync(default)).Members.Single(value => value.Principal.Id == UserId);
            newIssuer = newSubject = ""; identityError = false; identityMessage = T("ExternalIdentityLinked");
        }
        catch (Agentstration.Web.Console.AgentstrationApiException exception)
        { identityError = true; identityMessage = exception.Message; }
    }
    private async Task UnlinkExternalIdentityAsync(Guid externalIdentityId)
    {
        try
        {
            await Client.UnlinkExternalIdentityAsync(UserId, externalIdentityId, default);
            member = (await Client.GetOrganizationAsync(default)).Members.Single(value => value.Principal.Id == UserId);
            identityError = false; identityMessage = T("ExternalIdentityUnlinked");
        }
        catch (Agentstration.Web.Console.AgentstrationApiException exception)
        { identityError = true; identityMessage = exception.Message; }
    }
}
