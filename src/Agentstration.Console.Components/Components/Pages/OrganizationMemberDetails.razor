@page "/settings/organization/members/{UserId:guid}"
@implements IDisposable
@inject Agentstration.Web.Console.IIdentityAdministrationApiClient Client
@inject ConsoleContextState ContextState
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@inject Microsoft.Extensions.Localization.IStringLocalizer<OrganizationStrings> Localizer

<PageTitle>@T("MemberAccess") · Agentstration</PageTitle>
<UnsavedNavigationGuard IsDirty="@IsDirty" HasUnsavedChanges="@(() => IsDirty)" />
<div data-testid="console-admin-organization-member-details" data-member-id="@UserId">
    <ResourceDetailsTemplate Name="@(member?.Principal.DisplayName ?? T("MemberAccess"))" ResourceType="@T("MemberAccess")" Domain="identity" IconName="user" CollectionHref="@BackUrl" CollectionLabel="@T("Members")"
                             Description="@T("MemberAccess.Description")" StatusText="@(member is null ? null : T($"Status.{member.Principal.Status}"))" Status="@(member?.Principal.Status == PrincipalStatus.Active ? UiStatus.Success : UiStatus.Neutral)"
                             Sections="Sections" ResourceIdentity="@loadedKey" DefaultSection="overview" SelectionChanged="SelectSection" SectionState="sectionState" LoadState="loadState" OnRetry="RefreshAsync" OnRefresh="RefreshAsync" Busy="IsBusy" HasDraft="IsDirty" SectionTestIdPrefix="organization-member">
        <Metadata><CopyableValue Value="@UserId.ToString("D")" /></Metadata>

        <Feedback>@if (newerBundle is not null) { <div class="form-alert form-alert-warning" role="status">@T("Member.RefreshDraftConflict")</div> }</Feedback>
        <Content>@if (member is not null) {
        <div hidden="@(section != "overview")">
            <section class="metric-grid"><MetricCard Label="@T("Principal")" Value="@T($"Status.{member.Principal.Status}")" Status="@(member.Principal.Status == PrincipalStatus.Active ? UiStatus.Success : UiStatus.Neutral)" /><MetricCard Label="@T("Membership")" Value="@T($"Status.{member.Membership.Status}")" Detail="@T("JoinedAt", member.Membership.JoinedAt.ToLocalTime().ToString("g"))" Status="@(member.Membership.Status == MembershipStatus.Active ? UiStatus.Success : UiStatus.Warning)" /></section>
            <FormSection Title="@Shared["Identity"]" Class="resource-identity-summary"><dl class="resource-details member-details"><dt>@T("DisplayName")</dt><dd>@member.Principal.DisplayName</dd><dt>@T("PrincipalId")</dt><dd><CopyableValue Value="@member.Principal.Id.ToString("D")" /></dd><dt>@T("Kind")</dt><dd>@T($"PrincipalKind.{member.Principal.Kind}")</dd><dt>@T("Email")</dt><dd>@(member.Principal.Email ?? "—")</dd>@foreach (var identity in member.ExternalIdentities) { <dt>@T("ExternalIdentity")</dt><dd><code>@identity.Issuer</code> · <code>@identity.Subject</code></dd> }</dl></FormSection>
            <FormSection Title="@Shared["Configuration"]" Class="resource-configuration-summary">@ConfigurationSummary</FormSection>
            <FormSection Title="@T("RoleAssignments")">@if (member.Roles.Count == 0) { <EmptyState Title="@T("NoAccessAssigned")" Message="@T("MembershipNoAccess")" /> } else { @foreach (var assigned in member.Roles) { <article><p><strong>@assigned.Role.DisplayName</strong> @if (assigned.Scope.StartsWith("/tenants/", StringComparison.Ordinal)) { <StatusBadge Text="@T("Inherited")" Status="UiStatus.Info" /> }</p><code class="member-scope">@assigned.Scope</code></article> } }</FormSection>
        </div>
        <div hidden="@(section != "membership")">
    <FormSection Title="@T("CurrentWorkspaceMembership")"><ChildContent>
        @if (!string.IsNullOrWhiteSpace(message)) { <p class="form-alert @(hasError ? "form-alert-danger" : "form-alert-success")" role="@(hasError ? "alert" : "status")">@message</p> }
        <FormGrid><FormField Label="@T("Role")"><ChildContent><ClearableSelect Disabled="@(busy || !CanManageMembership)" @bind-Value="selectedRole" data-testid="organization-member-role">@foreach(var role in Agentstration.Identity.Contracts.BuiltInIdentityRoleNames.All){<option value="@role">@role</option>}</ClearableSelect></ChildContent></FormField></FormGrid>
        <FormActions><button class="button-primary" disabled="@(IsBusy || !CanManageMembership)" @onclick="SaveMembershipAsync" data-testid="organization-member-save-role">@T("SaveRole")</button>@if(workspaceMembership is not null){<button class="button-secondary" disabled="@(IsBusy || !CanManageMembership)" @onclick="RemoveMembershipAsync" data-testid="organization-member-remove-membership">@T("RemoveFromWorkspace")</button>}</FormActions>
    </ChildContent></FormSection>
        </div>
        @if (canManagePlatformAdministrators)
        {
            <div hidden="@(section != "authentication")">
        <FormSection Title="@T("ExternalAuthentication")"><ChildContent>
            @if (!string.IsNullOrWhiteSpace(identityMessage)) { <p class="form-alert @(identityError ? "form-alert-danger" : "form-alert-success")" role="@(identityError ? "alert" : "status")">@identityMessage</p> }
            <FormGrid>
                <FormField Label="@T("Issuer")"><ChildContent><ClearableText Disabled="busy" UpdateOnInput="false" @bind-Value="newIssuer" data-testid="organization-member-issuer" placeholder="https://identity.example/realms/company" autocomplete="off" /></ChildContent></FormField>
                <FormField Label="@T("Subject")"><ChildContent><ClearableText Disabled="busy" UpdateOnInput="false" @bind-Value="newSubject" data-testid="organization-member-subject" autocomplete="off" /></ChildContent></FormField>
            </FormGrid>
            <FormActions><button class="button-primary" disabled="@IsBusy" @onclick="LinkExternalIdentityAsync" data-testid="organization-member-link-identity">@T("LinkExternalIdentity")</button></FormActions>
            @if (member.ExternalIdentities.Count > 0)
            {
                <CollectionView TItem="ExternalIdentity" Items="member.ExternalIdentities" InformationLabels="@(new string[] { T("Subject"), T("Linked") })" IdentityLabel="@T("Issuer")">
        <Identity Context="identity">
<code>@identity.Issuer</code></Identity>
        <Information Context="identity">
            <CollectionValue Label="@T("Subject")"><code>@identity.Subject</code></CollectionValue>
            <CollectionValue Label="@T("Linked")">@identity.LinkedAt.ToLocalTime().ToString("g")</CollectionValue>
        </Information>
        <Actions Context="identity">
<CollectionActions ResourceName="@(identity.Subject)"><button class="text-button" disabled="@IsBusy" @onclick="() => UnlinkExternalIdentityAsync(identity.Id)" data-testid="organization-member-unlink-identity">@T("Unlink")</button></CollectionActions></Actions>
    </CollectionView>
            }
        </ChildContent></FormSection>
            </div>
            <div hidden="@(section != "administration")">
        <FormSection Title="@T("InstanceAdministration")"><ChildContent>
            @if (!string.IsNullOrWhiteSpace(platformMessage)) { <p class="form-alert @(platformError ? "form-alert-danger" : "form-alert-success")" role="@(platformError ? "alert" : "status")">@platformMessage</p> }
            <FormActions>
                @if (targetIsPlatformAdministrator)
                {
                    <button class="button-secondary" @onclick="RevokePlatformAdministratorAsync" disabled="@(IsBusy || UserId == ContextState.Current?.UserId)">@T("RevokePlatformAdmin")</button>
                }
                else
                {
                    <button class="button-primary" @onclick="GrantPlatformAdministratorAsync" disabled="@(IsBusy || member.Principal.Status != PrincipalStatus.Active)">@T("GrantPlatformAdmin")</button>
                }
            </FormActions>
        </ChildContent></FormSection>            </div>
        }
        }</Content>
        <DraftActions><button type="button" class="button-secondary" disabled="@IsBusy" @onclick="DiscardDrafts">@Shared["Discard"]</button></DraftActions>
    </ResourceDetailsTemplate>
</div>

@code {
    private sealed record ConfigurationRow(string Name, string Value);
    private IReadOnlyList<ConfigurationRow> ConfigurationRows => [new(T("Workspace"), $"{ContextState.Current?.WorkspaceDisplayName} · {loadedWorkspace:D}"), new(T("CurrentWorkspaceMembership"), workspaceMembership?.Role ?? "—"), new(T("InstanceRole"), targetIsPlatformAdministrator ? T("PlatformAdministrator") : "—")];
    private RenderFragment ConfigurationSummary => @<CollectionView TItem="ConfigurationRow" Items="ConfigurationRows" IdentityLabel="@Shared["Configuration"]" InformationLabels="@(new[] { T("Member.Value") })"><Identity Context="row"><strong class="configuration-key">@row.Name</strong></Identity><Information Context="row"><CollectionValue Label="@T("Member.Value")"><span class="configuration-value">@row.Value</span></CollectionValue></Information></CollectionView>;
    private readonly ResourceSectionState sectionState = new();
    private readonly CancellationToken lifetimeToken;
    public OrganizationMemberDetails() => lifetimeToken = lifetime.Token;
    private ResourceLoadState loadState = new(ResourceLoadStatus.Loading);
    private MemberBundle? newerBundle;
    private Guid loadedUser, loadedTenant;
    private bool disposed;
    private bool IsBusy => loading || busy;
    private string section => sectionState.CurrentPath;
    private string BackUrl => ResourceOwnershipContext.PreserveNavigation("/settings/organization/members", Services);
    private void ClearPrivate()
    {
        member = null; workspaceMembership = null; newerBundle = null; selectedRole = roleBaseline = BuiltInIdentityRoleNames.Viewer; newIssuer = newSubject = "";
        message = identityMessage = platformMessage = null; busy = hasError = platformError = identityError = canManagePlatformAdministrators = targetIsPlatformAdministrator = false;
    }
    private static ResourceLoadStatus FailureStatus(Exception exception) => exception is AgentstrationApiException api ? api.StatusCode switch
    {
        System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden => ResourceLoadStatus.Forbidden,
        System.Net.HttpStatusCode.NotFound => ResourceLoadStatus.NotFound,
        _ => ResourceLoadStatus.Failed
    } : ResourceLoadStatus.Failed;
    private MemberBundle CurrentBundle => new(member!, workspaceMembership, canManagePlatformAdministrators, targetIsPlatformAdministrator);
    private static string Fingerprint(MemberBundle value) => JsonSerializer.Serialize(new
    {
        value.Member.Principal, value.Member.Membership.Status, value.Member.ExternalIdentities, value.Member.Roles,
        WorkspaceRole = value.WorkspaceMembership?.Role, WorkspaceStatus = value.WorkspaceMembership?.Membership.Status,
        value.CanManagePlatformAdministrators, value.TargetIsPlatformAdministrator
    });
    private void Adopt(MemberBundle value)
    {
        member = value.Member; workspaceMembership = value.WorkspaceMembership; canManagePlatformAdministrators = value.CanManagePlatformAdministrators;
        targetIsPlatformAdministrator = value.TargetIsPlatformAdministrator; selectedRole = roleBaseline = value.WorkspaceMembership?.Role ?? BuiltInIdentityRoleNames.Viewer; newerBundle = null;
    }
    private void DiscardDrafts()
    {
        if (IsBusy) return;
        if (newerBundle is { } latest) Adopt(latest); else selectedRole = roleBaseline;
        newIssuer = newSubject = ""; message = identityMessage = platformMessage = null;
        hasError = platformError = identityError = false;
    }
    private void AcceptLatestSavedView()
    {
        if (newerBundle is not { } latest) return;
        var roleDraft = selectedRole != roleBaseline;
        member = latest.Member; workspaceMembership = latest.WorkspaceMembership; roleBaseline = latest.WorkspaceMembership?.Role ?? BuiltInIdentityRoleNames.Viewer;
        if (!roleDraft) selectedRole = roleBaseline;
        canManagePlatformAdministrators = latest.CanManagePlatformAdministrators; targetIsPlatformAdministrator = latest.TargetIsPlatformAdministrator; newerBundle = null;
    }
    private async Task<OrganizationMemberResponse?> ReadSavedMemberAsync(long request, Guid user)
    {
        OrganizationAdministrationResponse organization;
        try { organization = await Client.GetOrganizationAsync(lifetimeToken); }
        catch (AgentstrationApiException exception) when (FailureStatus(exception) != ResourceLoadStatus.Failed)
        {
            if (IsCurrent(request)) { ClearPrivate(); loadState = new(FailureStatus(exception)); }
            return null;
        }
        if (!IsCurrent(request)) return null;
        var saved = organization.Members.SingleOrDefault(value => value.Principal.Id == user);
        if (organization.Tenant.Id != loadedTenant || saved is null || saved.Membership.TenantId != loadedTenant || saved.Membership.PrincipalId != user)
        {
            ClearPrivate(); loadState = new(ResourceLoadStatus.Failed) { Message = T("Member.NotFound") }; return null;
        }
        AcceptLatestSavedView(); return saved;
    }
    private sealed record MemberBundle(OrganizationMemberResponse Member, WorkspaceMemberResponse? WorkspaceMembership, bool CanManagePlatformAdministrators, bool TargetIsPlatformAdministrator);
    [Parameter] public Guid UserId { get; set; }
    private readonly CancellationTokenSource lifetime = new();
    private OrganizationMemberResponse? member;
    private WorkspaceMemberResponse? workspaceMembership;
    private string selectedRole = BuiltInIdentityRoleNames.Viewer, roleBaseline = BuiltInIdentityRoleNames.Viewer;
    private string newIssuer = "", newSubject = "";
    private string? loadedKey, message, platformMessage, identityMessage;
    private Guid loadedWorkspace;
    private long loadVersion;
    private bool loading = true, busy, hasError, platformError, identityError, canManagePlatformAdministrators, targetIsPlatformAdministrator;
    private bool CanManageMembership => ContextState.HasPermission(AuthorizationPermissions.AuthorizationWrite);
    private bool IsDirty => !disposed && member is not null && (selectedRole != roleBaseline || newIssuer.Length > 0 || newSubject.Length > 0);
    private IReadOnlyList<ResourceNavigationItem> Sections => [new("overview", Shared["Overview"], "home"), new("membership", T("CurrentWorkspaceMembership"), "users"), new("authentication", T("ExternalAuthentication"), "key") { Visible = canManagePlatformAdministrators }, new("administration", T("InstanceAdministration"), "shield") { Visible = canManagePlatformAdministrators }];
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    private string ContextKey => $"{UserId}|{ContextState.Current?.SelectedScopeRef}|{ContextState.Current?.WorkspaceId}";
    private void SelectSection(string? value) => sectionState.Select(value ?? "overview");
    protected override Task OnParametersSetAsync()
    {
        if (loadedKey == ContextKey) return Task.CompletedTask;
        loadedKey = ContextKey; ClearPrivate(); sectionState.Reset(loadedKey);
        return LoadAsync();
    }
    private async Task LoadAsync(bool refresh = false)
    {
        var request = ++loadVersion; var userId = UserId;
        loading = true;
        loadState = new(refresh && member is not null ? ResourceLoadStatus.Refreshing : ResourceLoadStatus.Loading) { HasContent = member is not null };
        try
        {
            await ContextState.EnsureLoadedAsync(lifetimeToken);
            if (request != loadVersion || disposed) return;
            loadedKey = ContextKey;
            var workspace = ContextState.Current!.WorkspaceId; var tenant = ContextState.Current.TenantId;
            if (!refresh) { loadedWorkspace = workspace; loadedTenant = tenant; loadedUser = userId; }
            var organization = await Client.GetOrganizationAsync(lifetimeToken);
            if (request != loadVersion || disposed) return;
            if (organization.Tenant.Id != tenant) { ClearPrivate(); loadState = new(ResourceLoadStatus.Forbidden); return; }
            var memberships = await Client.GetWorkspaceMembersAsync(workspace, lifetimeToken);
            if (request != loadVersion || disposed) return;
            var capabilities = await Client.GetCapabilitiesAsync(lifetimeToken);
            if (request != loadVersion || disposed) return;
            if (capabilities.PrincipalId != ContextState.Current.UserId || capabilities.WorkspaceId != workspace) { ClearPrivate(); loadState = new(ResourceLoadStatus.Forbidden); return; }
            var administrators = capabilities.IsPlatformAdministrator ? await Client.GetPlatformAdministratorsAsync(lifetimeToken) : [];
            if (request != loadVersion || disposed) return;
            var saved = organization.Members.SingleOrDefault(value => value.Principal.Id == userId);
            var membership = memberships.SingleOrDefault(value => value.Principal.Id == userId);
            if (saved is null || saved.Membership.PrincipalId != userId || saved.Membership.TenantId != tenant || membership is not null && (membership.Membership.PrincipalId != userId || membership.Membership.WorkspaceId != workspace))
            {
                ClearPrivate(); loadState = new(ResourceLoadStatus.Failed) { Message = T("Member.NotFound") }; return;
            }
            var bundle = new MemberBundle(saved, membership, capabilities.IsPlatformAdministrator, administrators.Any(value => value.Principal.Id == userId));
            if (IsDirty)
            {
                newerBundle = Fingerprint(bundle) == Fingerprint(CurrentBundle) ? null : bundle;
                canManagePlatformAdministrators = bundle.CanManagePlatformAdministrators;
                if (!canManagePlatformAdministrators) newIssuer = newSubject = "";
                if (!IsDirty) Adopt(bundle);
            }
            else Adopt(bundle);
            loadState = new(ResourceLoadStatus.Ready) { HasContent = true };
        }
        catch (OperationCanceledException) when (lifetimeToken.IsCancellationRequested) { }
        catch (Exception exception)
        {
            if (request != loadVersion || disposed) return;
            var state = FailureStatus(exception);
            if (state is ResourceLoadStatus.Forbidden or ResourceLoadStatus.NotFound) ClearPrivate();
            loadState = new(state) { HasContent = member is not null, ErrorId = (exception as AgentstrationApiException)?.ErrorId };
        }
        finally { if (request == loadVersion && !disposed) loading = false; }
    }
    private Task RefreshAsync() => IsBusy ? Task.CompletedTask : LoadAsync(member is not null);
    private bool IsCurrent(long request) => !disposed && request == loadVersion && UserId == loadedUser && ContextState.Current?.WorkspaceId == loadedWorkspace && ContextState.Current?.TenantId == loadedTenant;
    private async Task SaveMembershipAsync()
    {
        if (IsBusy || member is null || !CanManageMembership) return;
        var request = loadVersion; var user = UserId; var workspace = loadedWorkspace; var role = selectedRole; busy = true;
        try { var saved = await Client.SetWorkspaceMembershipAsync(workspace, user, role, lifetimeToken); if (!IsCurrent(request)) return; if (saved.Principal.Id != user || saved.Membership.PrincipalId != user || saved.Membership.WorkspaceId != workspace) throw new InvalidOperationException(T("Member.NotFound")); var current = await ReadSavedMemberAsync(request, user); if (current is null || !IsCurrent(request)) return; member = current; workspaceMembership = saved; roleBaseline = saved.Role ?? BuiltInIdentityRoleNames.Viewer; hasError = false; message = T("WorkspaceRoleUpdated"); }
        catch (AgentstrationApiException exception) { if (IsCurrent(request)) { hasError = true; message = exception.Message; } }
        catch (InvalidOperationException) { if (IsCurrent(request)) { hasError = true; message = T("Member.NotFound"); } }
        catch (OperationCanceledException) when (lifetimeToken.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or TimeoutException) { if (IsCurrent(request)) { hasError = true; message = T("Member.OperationUnconfirmed"); } }
        finally { if (IsCurrent(request)) busy = false; }
    }
    private async Task RemoveMembershipAsync()
    {
        if (IsBusy || member is null || !CanManageMembership || workspaceMembership is null) return;
        var request = loadVersion; var user = UserId; var workspace = loadedWorkspace; busy = true;
        try { await Client.RemoveWorkspaceMembershipAsync(workspace, user, lifetimeToken); if (!IsCurrent(request)) return; var current = await ReadSavedMemberAsync(request, user); if (current is null || !IsCurrent(request)) return; member = current; workspaceMembership = null; roleBaseline = selectedRole; hasError = false; message = T("PrincipalRemoved"); }
        catch (AgentstrationApiException exception) { if (IsCurrent(request)) { hasError = true; message = exception.Message; } }
        catch (OperationCanceledException) when (lifetimeToken.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or TimeoutException) { if (IsCurrent(request)) { hasError = true; message = T("Member.OperationUnconfirmed"); } }
        finally { if (IsCurrent(request)) busy = false; }
    }
    private async Task GrantPlatformAdministratorAsync()
    {
        if (IsBusy || !canManagePlatformAdministrators || member?.Principal.Status != PrincipalStatus.Active) return;
        var request = loadVersion; var user = UserId; busy = true;
        try { await Client.GrantPlatformAdministratorAsync(user, lifetimeToken); if (IsCurrent(request)) { AcceptLatestSavedView(); targetIsPlatformAdministrator = true; platformError = false; platformMessage = T("PlatformAdminGranted"); } }
        catch (AgentstrationApiException exception) { if (IsCurrent(request)) { platformError = true; platformMessage = exception.Message; } }
        catch (OperationCanceledException) when (lifetimeToken.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or TimeoutException) { if (IsCurrent(request)) { platformError = true; platformMessage = T("Member.OperationUnconfirmed"); } }
        finally { if (IsCurrent(request)) busy = false; }
    }
    private async Task RevokePlatformAdministratorAsync()
    {
        if (IsBusy || member is null || !canManagePlatformAdministrators || UserId == ContextState.Current?.UserId) return;
        var request = loadVersion; var user = UserId; busy = true;
        try { await Client.RevokePlatformAdministratorAsync(user, lifetimeToken); if (IsCurrent(request)) { AcceptLatestSavedView(); targetIsPlatformAdministrator = false; platformError = false; platformMessage = T("PlatformAdminRevoked"); } }
        catch (AgentstrationApiException exception) { if (IsCurrent(request)) { platformError = true; platformMessage = exception.Message; } }
        catch (OperationCanceledException) when (lifetimeToken.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or TimeoutException) { if (IsCurrent(request)) { platformError = true; platformMessage = T("Member.OperationUnconfirmed"); } }
        finally { if (IsCurrent(request)) busy = false; }
    }
    private async Task LinkExternalIdentityAsync()
    {
        if (IsBusy || member is null || !canManagePlatformAdministrators) return;
        var request = loadVersion; var user = UserId; var issuer = newIssuer; var subject = newSubject; busy = true;
        try { await Client.LinkExternalIdentityAsync(user, issuer, subject, lifetimeToken); var saved = await ReadSavedMemberAsync(request, user); if (saved is null || !IsCurrent(request)) return; member = saved; newIssuer = newIssuer == issuer ? "" : newIssuer; newSubject = newSubject == subject ? "" : newSubject; identityError = false; identityMessage = T("ExternalIdentityLinked"); }
        catch (AgentstrationApiException exception) { if (IsCurrent(request)) { identityError = true; identityMessage = exception.Message; } }
        catch (OperationCanceledException) when (lifetimeToken.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or TimeoutException) { if (IsCurrent(request)) { identityError = true; identityMessage = T("Member.OperationUnconfirmed"); } }
        finally { if (IsCurrent(request)) busy = false; }
    }
    private async Task UnlinkExternalIdentityAsync(Guid externalIdentityId)
    {
        if (IsBusy || member is null || !canManagePlatformAdministrators) return;
        var request = loadVersion; var user = UserId; busy = true;
        try { await Client.UnlinkExternalIdentityAsync(user, externalIdentityId, lifetimeToken); var saved = await ReadSavedMemberAsync(request, user); if (saved is not null && IsCurrent(request)) { member = saved; identityError = false; identityMessage = T("ExternalIdentityUnlinked"); } }
        catch (AgentstrationApiException exception) { if (IsCurrent(request)) { identityError = true; identityMessage = exception.Message; } }
        catch (OperationCanceledException) when (lifetimeToken.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or TimeoutException) { if (IsCurrent(request)) { identityError = true; identityMessage = T("Member.OperationUnconfirmed"); } }
        finally { if (IsCurrent(request)) busy = false; }
    }
    public void Dispose() { if (disposed) return; disposed = true; ++loadVersion; lifetime.Cancel(); lifetime.Dispose(); }
}
