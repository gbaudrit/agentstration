@page "/secrets/new"
@page "/secrets/{Name}"
@implements IDisposable
@inject ISecretsClient Client
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<SecretStrings> Localizer

<PageTitle>@(IsNew ? T("CreateSecret") : $"{Name} · {T("Secret")}") · Agentstration</PageTitle>
<PageHeader Title="@(IsNew ? T("CreateSecret") : model.DisplayName)" Description="@T("SecretEditor.Description")" TestId="resource-secret-editor"><Actions>@if (!IsNew) { <button class="button-danger" @onclick="RequestDelete">@T("Delete")</button> }<a class="button-secondary" href="/secrets">@T("Back")</a></Actions></PageHeader>
<ResourceTabs Label="@T("SecretManagement")"><a class="active" href="/secrets">@T("Secrets")</a><a href="/vaults">@T("Vaults")</a></ResourceTabs>
@if (error is not null) { <div class="form-alert form-alert-danger" role="alert">@error.Message</div> }
@if (usages.Count > 0) { <div class="form-alert form-alert-warning">@T("SecretReferenced", usages.Count)</div> }
<EditForm Model="model" OnValidSubmit="SaveAsync" FormName="secret-editor" class="resource-form" data-interactive="@(interactive ? "true" : "false")" @oninput="MarkDirtyFromForm" @onchange="MarkDirtyFromForm"><DataAnnotationsValidator /><ValidationSummary />
    <section class="panel form-section">
        <div class="panel-header"><div><p class="eyebrow">@T("Identity")</p><h2>@T("SecretResource")</h2></div>@if (valueStatus is not null) { <StatusBadge Text="@StatusText(valueStatus)" Status="@Tone(valueStatus)" /> }</div>
        <div class="form-grid">
            <label><span>@T("DisplayName")</span><InputText data-testid="secret-display-name" Value="@model.DisplayName" ValueChanged="DisplayNameChanged" ValueExpression="@(() => model.DisplayName)" /></label>
            <label><span>@T("Name")</span><InputText data-testid="secret-name" Value="@model.Name" ValueChanged="NameChanged" ValueExpression="@(() => model.Name)" disabled="@(!IsNew)" /><small>@T("ResourceIdentifierHelp")</small></label>
            <label class="form-span-2"><span>@T("Description")</span><InputTextArea @bind-Value="model.Description" /></label>
            @if (IsNew) { <ResourceScopePicker Targets="scopeTargets" Value="selectedScope" ValueChanged="ScopeChangedAsync" /> } else { <label><span>@T("Scope")</span><ResourceScopeBadge ScopeRef="selectedScope" /></label> }
            <label><span>@T("Vault")</span><select data-testid="secret-vault-select" value="@VaultSelection" @onchange="VaultChanged"><option value="">@T("SelectVault")</option>@foreach (var vault in AvailableVaults) { <option value="@VaultKey(vault.Resource)">@vault.Resource.Definition.DisplayName · @vault.Resource.ScopeRef</option> }</select></label>
            <label><span>@T("VaultKey")</span><InputText data-testid="secret-vault-key" Value="@model.Key" ValueChanged="KeyChanged" ValueExpression="@(() => model.Key)" /><small>@T("VaultKeyHelp")</small></label>
            <label><span>@T("SecretType")</span><input value="opaque" disabled /></label>
        </div>
    </section>
    <DescendantUseGrantEditor OwnerScopeRef="selectedScope" Targets="scopeTargets" Grants="model.UseGrants" OnChanged="MarkDirty" />
    @if (saveError && error is not null) { <div class="form-alert form-alert-danger" role="alert">@error.Message</div> }
    @if (IsNew)
    {
        <div class="form-actions"><a class="button-secondary" href="/secrets">@T("Cancel")</a><button type="submit" class="button-primary" disabled="@busy">@(busy ? T("Saving") : T("SaveMetadata"))</button></div>
    }
    else
    {
        <UnsavedChangesBar IsVisible="@dirty" Title="@T("UnsavedChangesTitle")" Message="@T("UnsavedChangesMessage")">
            <Actions><button type="button" class="button-secondary" disabled="@busy" @onclick="DiscardAsync">@T("Discard")</button><button type="submit" class="button-primary" disabled="@busy">@(busy ? T("Saving") : T("SaveMetadata"))</button></Actions>
        </UnsavedChangesBar>
    }
</EditForm>
@if (!IsNew)
{
    <section class="panel resource-section">
        <div class="panel-header"><div><p class="eyebrow">@T("WriteOnly")</p><h2>@T("SecretValue")</h2></div><StatusBadge Text="@StatusText(valueStatus ?? "Unknown")" Status="@Tone(valueStatus ?? "")" /></div>
        <p>@T("SecretValueNeverRevealed")</p>
        @if (!editingValue) { <div class="form-actions"><button class="button-primary" @onclick="() => editingValue = true">@(valueConfigured ? T("ReplaceValue") : T("SetValue"))</button>@if (valueConfigured) { <button class="button-danger" @onclick="() => confirmDeleteValue = true">@T("DeleteValue")</button> }</div> }
        else { <div @key="valueEditorKey" class="form-grid"><label class="form-span-2"><span>@T("NewValue")</span><input type="password" @bind="secretValue" autocomplete="new-password" spellcheck="false" /></label><div class="form-actions"><button class="button-secondary" @onclick="CancelValue">@T("Cancel")</button><button class="button-primary" @onclick="SetValueAsync" disabled="@(busy || string.IsNullOrEmpty(secretValue))">@T("SaveValue")</button></div></div> }
    </section>
    @if (usages.Count > 0) { <section class="panel resource-section"><div class="panel-header"><h2>@T("Usages")</h2><span>@usages.Count</span></div><ul class="resource-links">@foreach (var usage in usages) { <li><a href="@usage.Url"><strong>@usage.DisplayName</strong><code>@usage.Name</code></a></li> }</ul></section> }
}
<ConfirmationDialog IsOpen="@confirmDelete" Title="@T("DeleteSecret")" Message="@T("DeleteSecretMessage", Name ?? string.Empty)" ConfirmLabel="@T("DeleteSecret")" OnConfirm="DeleteAsync" OnCancel="() => confirmDelete = false" />
<ConfirmationDialog IsOpen="@confirmDeleteValue" Title="@T("DeleteSecretValue")" Message="@T("DeleteSecretValueMessage")" ConfirmLabel="@T("DeleteValue")" OnConfirm="DeleteValueAsync" OnCancel="() => confirmDeleteValue = false" />

@code {
    [Parameter] public string? Name { get; set; }
    [SupplyParameterFromQuery(Name = "scopeRef")] public string? ScopeRefValue { get; set; }
    private readonly CancellationTokenSource cancellation = new();
    private SecretEditorModel model = new();
    private IReadOnlyList<VaultResponse> vaults = [];
    private IReadOnlyList<ResourceScopeTargetResponse> scopeTargets = [];
    private ResourceScopeRef? selectedScope;
    private IReadOnlyList<SecretUsageResponse> usages = [];
    private string? etag, valueStatus, secretValue;
    private bool valueConfigured, editingValue, busy, confirmDelete, confirmDeleteValue, nameEdited, keyEdited, saveError, dirty, interactive;
    private int valueEditorKey;
    private Exception? error;
    private bool IsNew => string.IsNullOrWhiteSpace(Name);
    private IReadOnlyList<VaultResponse> AvailableVaults => vaults.Where(value => CanUseVault(value.Resource)).ToArray();
    private string VaultSelection => model.VaultScopeRef is { } scope && !string.IsNullOrWhiteSpace(model.VaultName) ? $"{scope.Value}|{(model.VaultNamespace ?? ResourceNamespace.Default).Value}|{model.VaultName}" : string.Empty;
    private static string VaultKey(VaultResource vault) => $"{vault.ScopeRef!.Value.Value}|{vault.Namespace.Value}|{vault.Name}";
    private bool CanUseVault(VaultResource vault)
    {
        if (selectedScope is not { } consumer || vault.ScopeRef is not { } owner) return false;
        if (owner == consumer) return true;
        if (owner.Kind >= consumer.Kind) return false;
        var tenant = scopeTargets.FirstOrDefault(value => value.Kind == ResourceScopeKind.Tenant)?.ScopeRef;
        return vault.Definition.UsePolicy.Grants.Any(grant => grant.ScopeRef == consumer
            || grant.IncludeDescendants && consumer.Kind == ResourceScopeKind.Workspace && grant.ScopeRef == tenant);
    }
    private void VaultChanged(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        var vault = AvailableVaults.FirstOrDefault(candidate => VaultKey(candidate.Resource) == value)?.Resource;
        model.VaultName = vault?.Name ?? string.Empty;
        model.VaultScopeRef = vault?.ScopeRef;
        model.VaultNamespace = vault?.Namespace;
    }
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    private void MarkDirty() => dirty = true;
    private void MarkDirtyFromForm(EventArgs _) => MarkDirty();
    private string StatusText(string status) => T($"Status.{status}");
    protected override void OnAfterRender(bool firstRender) { if (!firstRender) return; interactive = true; StateHasChanged(); }
    protected override async Task OnParametersSetAsync() { error = null; try { vaults = await Client.GetVaultsAsync(cancellation.Token); scopeTargets = await Client.GetScopeTargetsAsync(SecretResourceKinds.Secret, cancellation.Token); if (IsNew) { selectedScope ??= scopeTargets.FirstOrDefault(value => value.Kind == ResourceScopeKind.Workspace && value.CanWrite)?.ScopeRef ?? scopeTargets.FirstOrDefault(value => value.CanWrite)?.ScopeRef; return; } var requestedScope = ParseScope(); var snapshot = requestedScope is null ? await Client.GetSecretAsync(Name!, cancellation.Token) : await Client.GetSecretAsync(Name!, requestedScope.Value, cancellation.Token); model = SecretEditorModel.From(snapshot.Value.Resource); selectedScope = snapshot.Value.Resource.ScopeRef; nameEdited = keyEdited = true; etag = snapshot.ETag; valueStatus = snapshot.Value.ValueStatus; valueConfigured = snapshot.Value.ValueConfigured; usages = (await Client.GetSecretUsagesAsync(Name!, selectedScope!.Value, cancellation.Token)).Value; } catch (Exception ex) { error = ex; } }
    private void DisplayNameChanged(string value) { model.DisplayName = value; if (!IsNew) return; var identifier = SecretEditorModel.IdentifierFromDisplayName(value); if (!nameEdited) model.Name = identifier; if (!keyEdited) model.Key = model.Name; }
    private void NameChanged(string value) { model.Name = value; nameEdited = true; if (IsNew && !keyEdited) model.Key = value; }
    private void KeyChanged(string value) { model.Key = value; keyEdited = true; }
    private async Task SaveAsync()
    {
        busy = true;
        error = null;
        saveError = false;
        try
        {
            var snapshot = IsNew
                ? await Client.CreateSecretAsync(new(model.Name, model.Properties(selectedScope), selectedScope), cancellation.Token)
                : await Client.UpdateSecretAsync(model.Name, selectedScope!.Value, new(model.Properties(selectedScope)), etag!, cancellation.Token);
            if (IsNew) Navigation.NavigateTo(ResourceUrl(snapshot.Value));
            else
            {
                model = SecretEditorModel.From(snapshot.Value);
                etag = snapshot.ETag;
                dirty = false;
            }
        }
        catch (Exception ex) { error = ex; saveError = true; }
        finally { busy = false; }
    }
    private async Task DiscardAsync()
    {
        await OnParametersSetAsync();
        if (error is null) { dirty = false; saveError = false; }
    }
    private async Task SetValueAsync() { if (string.IsNullOrEmpty(secretValue)) return; busy = true; error = null; try { await Client.SetSecretValueAsync(model.Name, selectedScope!.Value, secretValue, cancellation.Token); valueConfigured = true; valueStatus = "Configured"; CancelValue(); } catch (Exception ex) { error = ex; } finally { secretValue = null; valueEditorKey++; busy = false; } }
    private void CancelValue() { secretValue = null; editingValue = false; valueEditorKey++; }
    private async Task DeleteValueAsync() { confirmDeleteValue = false; try { await Client.DeleteSecretValueAsync(model.Name, selectedScope!.Value, cancellation.Token); valueConfigured = false; valueStatus = "Missing"; CancelValue(); } catch (Exception ex) { error = ex; } }
    private void RequestDelete() { if (usages.Count > 0) error = new AgentstrationApiException(T("SecretUsed", usages.Count), Guid.NewGuid().ToString("N")); else confirmDelete = true; }
    private async Task DeleteAsync() { confirmDelete = false; try { await Client.DeleteSecretAsync(model.Name, selectedScope!.Value, etag!, cancellation.Token); Navigation.NavigateTo("/secrets"); } catch (Exception ex) { error = ex; } }
    private Task ScopeChangedAsync(ResourceScopeRef? scopeRef) { selectedScope = scopeRef; model.VaultName = string.Empty; model.VaultScopeRef = null; model.VaultNamespace = null; model.UseGrants.Clear(); return Task.CompletedTask; }
    private ResourceScopeRef? ParseScope() => string.IsNullOrWhiteSpace(ScopeRefValue) ? null : ResourceScopeRef.Parse(ScopeRefValue);
    private static string ResourceUrl(SecretResource resource) => $"/secrets/{Uri.EscapeDataString(resource.Name)}?scopeRef={Uri.EscapeDataString(resource.ScopeRef!.Value.Value)}";
    private static UiStatus Tone(string value) => value.Equals("Configured", StringComparison.OrdinalIgnoreCase) ? UiStatus.Success : value.Equals("Missing", StringComparison.OrdinalIgnoreCase) ? UiStatus.Warning : UiStatus.Danger;
    public void Dispose() { secretValue = null; cancellation.Cancel(); cancellation.Dispose(); }
}
