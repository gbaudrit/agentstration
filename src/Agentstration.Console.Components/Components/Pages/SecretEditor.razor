@page "/secrets/new"
@page "/secrets/{Name}"
@implements IDisposable
@inject ISecretsClient Client
@inject NavigationManager Navigation
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<SecretStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared

@if (IsNew) { <UnsavedNavigationGuard IsDirty="@HasDraft" HasUnsavedChanges="@(() => HasDraft)" /> }
<PageTitle>@(IsNew ? T("CreateSecret") : $"{Name} · {T("Secret")}") · Agentstration</PageTitle>
@{
    RenderFragment feedback = @<div>
        @if (error is not null) { <div class="form-alert form-alert-danger" role="alert">@error.Message</div> }
        @if (usages.Count > 0) { <div class="form-alert form-alert-warning">@T("SecretReferenced", usages.Count)</div> }
        @if (newerResource is not null) { <div class="form-alert form-alert-warning" role="status">@T("SecretRefreshDraftConflict")</div> }
    </div>;
    var presentations = Presentations;
}
@if (IsNew)
{
    <PageHeader Title="@T("CreateSecret")" Description="@T("SecretEditor.Description")" TestId="resource-secret-editor"><Actions><a class="button-secondary" href="@BackUrl">@T("Back")</a></Actions></PageHeader>
    @if (loading) { <LoadingState Message="@T("LoadingSecrets")" /> }
    else
    {
        @feedback
        <ResourceDefinitionForm @key="model" @ref="definitionForm" EditContext="FormContext" FieldLabels="FieldLabels" Id="secret-resource-form" FormName="secret-editor"
            Busy="busy" InvalidInputChanged="value => invalidInput = value" data-interactive="@(interactive ? "true" : "false")">
            <p class="required-fields-note"><span aria-hidden="true">*</span> @Shared["RequiredFields"]</p>
            <CreationWizard Steps="Steps" OnFinish="FinishAsync" Busy="busy" FinishLabel="@T("SaveMetadata")" />
        </ResourceDefinitionForm>
    }
}
else
{
    <ConsoleResourceDetailsTemplate Resource="resource" RequestedAddress="@ResourceAddress.Create(ResourceNamespace.Default, SecretResourceKinds.Secret, Name!)"
        Name="@(resource?.Definition.DisplayName ?? Name!)" ResourceType="@T("Secret")" Domain="secret" IconName="key"
        Description="@resource?.Definition.Description" StatusText="@StatusText(valueStatus ?? "Unknown")" Status="@Tone(valueStatus ?? "Unknown")" LoadState="loadState" OnRetry="RetryAsync" OnRefresh="RefreshAsync"
        ResourceIdentity="@(loadedKey ?? Name!)" SectionState="sectionState" SectionPresentations="presentations" AdditionalSections="AdditionalSections" DefinitionSections="DefinitionSections"
        Feedback="feedback" HasDraft="HasDraft" HasAdditionalDraft="HasValueDraft" DefinitionReadOnlyReason="@(CanManage ? null : ResourceReadOnlyReason.InsufficientPermissions)"
        Yaml="@SavedYaml" Busy="busy" TestId="resource-secret-editor" SectionTestIdPrefix="secret">
        <OverviewMetrics><MetricCard Label="@T("Status")" Value="@StatusText(valueStatus ?? "Unknown")" Status="@Tone(valueStatus ?? "Unknown")" /></OverviewMetrics>
        <OverviewConfiguration><CollectionView TItem="ConfigurationEntry" Items="SavedConfiguration" IdentityLabel="@Shared["Configuration"]" InformationLabels="@(new[] { Shared["Saved"].Value })">
            <Identity Context="entry"><strong class="configuration-key">@entry.Label</strong></Identity><Information Context="entry"><CollectionValue Label="@Shared["Saved"]">@if (entry.Href is { } href) { <a class="configuration-value resource-name-link" href="@href">@entry.Value</a> } else { <span class="configuration-value">@entry.Value</span> }</CollectionValue></Information>
        </CollectionView></OverviewConfiguration>
        <DefinitionContent Context="path"><ResourceDefinitionForm @key="model" @ref="definitionForm" EditContext="FormContext" FieldLabels="FieldLabels" Id="secret-resource-form" FormName="secret-editor"
            Sections="presentations" SectionState="sectionState" SectionContent="DefinitionSection" SectionRequested="ShowSection"
            OnValidSubmit="SaveAsync" InvalidInputChanged="value => invalidInput = value" Busy="busy" ReadOnly="@(!CanManage)" data-interactive="@(interactive ? "true" : "false")" /></DefinitionContent>
        <OverviewContent><p>@T("SecretValueNeverRevealed")</p></OverviewContent>
        <AdditionalContent Context="path">@if (path == "value") { @ValuePanel } else if (path == "usages") { @Usages }</AdditionalContent>
        <Actions>@if (CanManage) { <button class="button-danger" type="button" @onclick="RequestDelete" disabled="@(busy || refreshing)">@T("Delete")</button> }<a class="button-secondary" href="@BackUrl">@T("Back")</a></Actions>
        <DraftActions><button type="button" class="button-secondary" disabled="@(busy || refreshing)" @onclick="Discard">@T("Discard")</button>@if (!sectionState.Is("yaml")) { <button type="submit" form="secret-resource-form" class="button-primary" disabled="@(busy || refreshing)">@(busy ? T("Saving") : T("SaveMetadata"))</button> }</DraftActions>
    </ConsoleResourceDetailsTemplate>
}
<ConfirmationDialog IsOpen="@confirmDelete" Title="@T("DeleteSecret")" Message="@T("DeleteSecretMessage", Name ?? string.Empty)" ConfirmLabel="@T("DeleteSecret")" OnConfirm="DeleteAsync" OnCancel="() => confirmDelete = false" />
<ConfirmationDialog IsOpen="@confirmDeleteValue" Title="@T("DeleteSecretValue")" Message="@T("DeleteSecretValueMessage")" ConfirmLabel="@T("DeleteValue")" OnConfirm="DeleteValueAsync" OnCancel="() => confirmDeleteValue = false" />

@code {
    private RenderFragment IdentityFields => @<ResourceIdentityEditor ResourceKind="@SecretResourceKinds.Secret"
        DisplayName="@model.DisplayName" DisplayNameChanged="value => model.DisplayName = value" DisplayNameExpression="@(() => model.DisplayName)"
        TechnicalName="@model.Name" TechnicalNameChanged="NameChanged" TechnicalNameExpression="@(() => model.Name)"
        Namespace="@model.Namespace" NamespaceExpression="@(() => model.Namespace)" ScopeRef="selectedScope" ScopeRefChanged="ScopeChangedAsync" ScopeTargets="scopeTargets"
        Description="@model.Description" DescriptionChanged="value => model.Description = value" DescriptionExpression="@(() => model.Description)"
        Labels="@model.Tags" LabelsExpression="@(() => model.Tags)" LabelsReadOnly="true"
        IsNew="IsNew" ReadOnly="@(!CanManage)" DisplayNameTestId="secret-display-name" TechnicalNameTestId="secret-name" />;
    private RenderFragment BindingFields => @<FormSection Title="@Shared["Configuration"]"><FormGrid>            <FormField Label="@T("Vault")" Required="true"><ChildContent><ClearableSelect TValue="string" data-testid="secret-vault-select" Value="@VaultSelection" ValueExpression="@(() => model.VaultName)" ValueChanged="value => VaultChanged(new ChangeEventArgs { Value = value })"><option value="">@T("SelectVault")</option>@foreach (var vault in AvailableVaults) { <option value="@VaultKey(vault.Resource)">@vault.Resource.Definition.DisplayName · @vault.Resource.ScopeRef</option> }</ClearableSelect></ChildContent><Validation><ValidationMessage For="@(() => model.VaultName)" /></Validation></FormField>
            <FormField Label="@T("VaultKey")" Required="true" Help="@T("VaultKeyHelp")"><ChildContent><ClearableText data-testid="secret-vault-key" Value="@model.Key" ValueChanged="KeyChanged" ValueExpression="@(() => model.Key)" /></ChildContent><Validation><ValidationMessage For="@(() => model.Key)" /></Validation></FormField>
            <FormField Label="@T("SecretType")"><ClearableText Value="@("opaque")" Disabled="true" /></FormField>
</FormGrid></FormSection>;
    private RenderFragment Grants => @<DescendantUseGrantEditor OwnerScopeRef="selectedScope" Targets="scopeTargets" Grants="model.UseGrants" OnChanged="GrantsChanged" />;
    private RenderFragment ValuePanel => @<div>    <FormSection Title="@T("SecretValue")" Eyebrow="@T("WriteOnly")" Class="secret-value-panel"><Actions><StatusBadge Text="@StatusText(valueStatus ?? "Unknown")" Status="@Tone(valueStatus ?? "")" /></Actions><ChildContent>
        <p>@T("SecretValueNeverRevealed")</p>
        @if (CanManage && !editingValue) { <FormActions><button type="button" class="button-primary" disabled="@(busy || refreshing)" @onclick="() => editingValue = true">@(valueConfigured ? T("ReplaceValue") : T("SetValue"))</button>@if (valueConfigured) { <button type="button" class="button-danger" disabled="@(busy || refreshing)" @onclick="() => confirmDeleteValue = true">@T("DeleteValue")</button> }</FormActions> }
        else if (CanManage) { <FormGrid @key="valueEditorKey"><FormField Label="@T("NewValue")" Class="form-span-2"><ClearableText Type="password" @bind-Value="secretValue" autocomplete="new-password" spellcheck="false" /></FormField><FormActions><button type="button" class="button-secondary" @onclick="CancelValue">@T("Cancel")</button><button type="button" class="button-primary" @onclick="SetValueAsync" disabled="@(busy || refreshing || string.IsNullOrEmpty(secretValue))">@T("SaveValue")</button></FormActions></FormGrid> }
    </ChildContent></FormSection>
</div>;
    private RenderFragment Usages => @<div>    @if (usages.Count > 0) { <FormSection Title="@T("Usages")"><Actions><span>@usages.Count</span></Actions><ChildContent><ul class="resource-links">@foreach (var usage in usages) { <li><CollectionIdentity DisplayName="@usage.DisplayName" Name="@usage.Name" Href="@usage.Url" IconName="layers" /><CollectionActions ResourceName="@usage.DisplayName"><a href="@usage.Url">@Shared["OpenItem"]</a></CollectionActions></li> }</ul></ChildContent></FormSection> }</div>;
    private RenderFragment Review => @<FormSection Title="@Shared["Verification"]"><ChildContent><dl class="resource-details"><dt>@T("Identity")</dt><dd>@model.DisplayName<br /><code>@model.Name</code></dd><dt>@T("Scope")</dt><dd><ResourceScopeBadge ScopeRef="selectedScope" /></dd><dt>@T("Vault")</dt><dd>@model.VaultNamespace/@model.VaultName</dd><dt>@T("VaultKey")</dt><dd>@model.Key</dd></dl><p>@T("SecretValueNeverRevealed")</p></ChildContent></FormSection>;

    private RenderFragment EditAction => @<button type="button" class="button-secondary" @onclick="() => ShowSection(ResourceDefinitionForm.FirstInvalidSection(FormContext, Presentations) ?? sectionState.DefinitionPath)">@Shared["Edit"]</button>;
    private RenderFragment DefinitionSection(string path) => path switch { "definition/identity" => IdentityFields, "definition/configuration" => BindingFields, "definition/use-policy" => Grants, _ => throw new ArgumentOutOfRangeException(nameof(path)) };
    [Parameter] public string? Name { get; set; }
    [SupplyParameterFromQuery(Name = "scopeRef")] public string? ScopeRefValue { get; set; }
    private readonly CancellationTokenSource cancellation = new();
    private readonly ResourceSectionState sectionState = new();
    private SecretEditorModel model = new();
    private SecretResource? resource, newerResource;
    private IReadOnlyList<VaultResponse> vaults = [];
    private IReadOnlyList<ResourceScopeTargetResponse> scopeTargets = [];
    private ResourceScopeRef? selectedScope;
    private IReadOnlyList<SecretUsageResponse> usages = [];
    private string? etag, newerEtag, valueStatus, secretValue, loadedKey;
    private bool valueConfigured, editingValue, busy, refreshing, confirmDelete, confirmDeleteValue, keyEdited, interactive, loading, invalidInput;
    private int valueEditorKey;
    private long loadVersion, vaultLoadVersion;
    private Exception? error;
    private string baseline = string.Empty;
    private ResourceLoadState loadState = new(ResourceLoadStatus.Loading);
    private EditContext? editContext;
    private ResourceDefinitionForm? definitionForm;
    private EditContext FormContext => editContext is not null && ReferenceEquals(editContext.Model, model) ? editContext : editContext = new(model);
    private void GrantsChanged() => FormContext.NotifyFieldChanged(new FieldIdentifier(model, nameof(model.UseGrants)));
    private string Fingerprint => JsonSerializer.Serialize(new { model, selectedScope });
    private bool HasDraft => !loading && baseline.Length > 0 && (Fingerprint != baseline || invalidInput);
    private bool HasValueDraft => !string.IsNullOrEmpty(secretValue);
    private bool CanManage => IsNew || resource is not null && !resource.Governance.IsManaged && ResourceOwnershipContext.CanManage(resource.ScopeRef, Services);
    private bool IsNew => string.IsNullOrWhiteSpace(Name);
    private string? NavigationScope => ResourceOwnershipContext.TryGetCurrent(Services)?.Value ?? (Services.GetService(typeof(ConsoleContextState)) as ConsoleContextState)?.Current?.SelectedScopeRef;
    private string BackUrl => ResourceOwnershipContext.PreserveNavigation("/secrets", Services);
    private string SavedYaml => resource is null ? string.Empty : ResourceManifestSerializer.ToYaml(resource);
    private IReadOnlyDictionary<string, ResourceSectionPresentation> Presentations => new Dictionary<string, ResourceSectionPresentation>(StringComparer.Ordinal)
    {
        ["definition/identity"] = new() { ReadOnly = !CanManage, HasRequiredFields = true, Fields = [nameof(model.Name), nameof(model.DisplayName), nameof(model.Namespace), nameof(model.Description), nameof(model.Tags)] },
        ["definition/configuration"] = new() { ReadOnly = !CanManage, HasRequiredFields = true, Fields = [nameof(model.VaultName), nameof(model.VaultScopeRef), nameof(model.VaultNamespace), nameof(model.Key)] },
        ["definition/use-policy"] = new() { ReadOnly = !CanManage, Fields = [nameof(model.UseGrants)] },
        ["yaml"] = new() { ReadOnly = true, ReadOnlyMessage = T("ResourceYamlExport"), ReadOnlyActions = CanManage ? EditAction : null }
    };
    private IReadOnlyDictionary<string, string> FieldLabels => new Dictionary<string, string>(StringComparer.Ordinal)
    {
        [nameof(model.Name)] = T("Name"), [nameof(model.DisplayName)] = T("DisplayName"), [nameof(model.Description)] = T("Description"),
        [nameof(model.Namespace)] = Shared["Namespace"], [nameof(model.Tags)] = Shared["Labels"], [nameof(model.VaultName)] = T("Vault"), [nameof(model.Key)] = T("VaultKey")
    };
    private IReadOnlyList<ResourceNavigationItem> DefinitionSections => [new("definition/use-policy", Shared["Access"], "key")];
    private IReadOnlyList<ResourceNavigationItem> AdditionalSections => [new("value", T("SecretValue"), "lock"), new("usages", T("Usages"), "list-check") { Visible = usages.Count > 0 }];
    private bool ValidField(string name, object? value) => System.ComponentModel.DataAnnotations.Validator.TryValidateProperty(value, new(model) { MemberName = name }, null);
    private bool IdentityComplete => selectedScope is not null && ValidField(nameof(model.Name), model.Name) && ValidField(nameof(model.DisplayName), model.DisplayName);
    private bool BindingComplete => ValidField(nameof(model.VaultName), model.VaultName) && ValidField(nameof(model.Key), model.Key) && model.VaultScopeRef is not null;
    private IReadOnlyList<CreationWizardStep> Steps =>
    [
        new("identity", T("Identity"), IdentityFields) { IsComplete = IdentityComplete },
        new("vault", T("Vault"), BindingFields) { IsComplete = BindingComplete },
        new("grants", Shared["Access"], Grants) { IsComplete = true },
        new("review", Shared["Verification"], Review) { IsComplete = IdentityComplete && BindingComplete }
    ];
    private void ShowSection(string path) => Navigation.NavigateTo(Navigation.Uri.Split('#')[0] + "#" + path);
    private async Task FinishAsync(CreationWizardFinish finish)
    {
        if (!FormContext.Validate() || selectedScope is null || !BindingComplete) { finish.ReturnToStepId = !IdentityComplete ? "identity" : "vault"; definitionForm?.RequestValidationFocus(); return; }
        await SaveAsync();
    }
    private sealed record ConfigurationEntry(string Label, string Value, string? Href = null);
    private IReadOnlyList<ConfigurationEntry> SavedConfiguration => resource is null ? [] :
    [
        new(T("Vault"), $"{resource.Definition.Vault.Namespace ?? resource.Namespace}/{resource.Definition.Vault.Name}", ResourceOwnershipContext.Resource(Services, "/vaults", resource.Definition.Vault.Name, resource.Definition.Vault.Namespace ?? resource.Namespace, resource.Definition.Vault.ScopeRef)),
        new(T("VaultKey"), resource.Definition.Key),
        new(T("SecretType"), resource.Definition.SecretType.ToString().ToLowerInvariant()),
        new(Shared["Access"], resource.Definition.UsePolicy.Grants.Count == 0 ? Shared["NotProvided"] : string.Join("\n", resource.Definition.UsePolicy.Grants.Select(g => g.ScopeRef.Value)))
    ];
    private IReadOnlyList<VaultResponse> AvailableVaults => vaults.Where(value => CanUseVault(value.Resource)).ToArray();
    private string VaultSelection => model.VaultScopeRef is { } scope && !string.IsNullOrWhiteSpace(model.VaultName) ? $"{scope.Value}|{(model.VaultNamespace ?? ResourceNamespace.Default).Value}|{model.VaultName}" : string.Empty;
    private static string VaultKey(VaultResource vault) => $"{vault.ScopeRef!.Value.Value}|{vault.Namespace.Value}|{vault.Name}";
    private bool CanUseVault(VaultResource vault)
    {
        if (selectedScope is not { } consumer || vault.ScopeRef is not { } owner) return false;
        if (owner == consumer) return true;
        if (owner.Kind >= consumer.Kind) return false;
        var tenant = scopeTargets.FirstOrDefault(value => value.Kind == ResourceScopeKind.Tenant)?.ScopeRef;
        return vault.Definition.UsePolicy.Grants.Any(grant => grant.ScopeRef == consumer
            || grant.IncludeDescendants && consumer.Kind == ResourceScopeKind.Workspace && grant.ScopeRef == tenant);
    }
    private void VaultChanged(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        var vault = AvailableVaults.FirstOrDefault(candidate => VaultKey(candidate.Resource) == value)?.Resource;
        model.VaultName = vault?.Name ?? string.Empty;
        model.VaultScopeRef = vault?.ScopeRef;
        model.VaultNamespace = vault?.Namespace;
    }
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    private string StatusText(string status) => T($"Status.{status.ToLowerInvariant() switch { "configured" => "Configured", "missing" => "Missing", "unavailable" => "Unavailable", "vaultunavailable" => "VaultUnavailable", _ => "Unknown" }}");
    protected override void OnAfterRender(bool firstRender) { if (returnAfterDelete is { } destination) { returnAfterDelete = null; Navigation.NavigateTo(destination); return; } if (!firstRender) return; interactive = true; StateHasChanged(); }
    private void Apply(SecretResource value, string version)
    {
        resource = value; model = SecretEditorModel.From(value); selectedScope = value.ScopeRef; etag = version;
        newerResource = null; newerEtag = null; invalidInput = false; error = null; keyEdited = true; baseline = Fingerprint;
    }
    private void Discard()
    {
        if (busy || refreshing || resource is null) return;
        Apply(newerResource ?? resource, newerEtag ?? etag!);
    }
    protected override Task OnParametersSetAsync()
    {
        var key = $"{Name}|{ScopeRefValue}|{NavigationScope}";
        if (loadedKey == key) return Task.CompletedTask;
        loadedKey = key; return LoadAsync();
    }
    private void Clear()
    {
        resource = newerResource = null; etag = newerEtag = valueStatus = null; selectedScope = null; model = new(); baseline = string.Empty;
        vaults = []; usages = []; busy = refreshing = false; invalidInput = false; keyEdited = valueConfigured = confirmDeleteValue = confirmDelete = false; CancelValue();
    }
    private async Task LoadAsync()
    {
        var version = ++loadVersion; ++vaultLoadVersion; var addressKey = $"{Name}|{ScopeRefValue}";
        loading = true; loadState = new(ResourceLoadStatus.Loading); error = null; Clear();
        try
        {
            if (Services.GetService(typeof(ConsoleContextState)) is ConsoleContextState context)
            {
                await context.EnsureLoadedAsync(cancellation.Token); if (version != loadVersion) return;
                if (context.Current is null) throw new InvalidOperationException(context.Error);
            }
            loadedKey = $"{addressKey}|{NavigationScope}";
            var targets = await Client.GetScopeTargetsAsync(SecretResourceKinds.Secret, cancellation.Token);
            if (version != loadVersion) return;
            scopeTargets = targets;
            if (IsNew)
            {
                selectedScope = scopeTargets.FirstOrDefault(value => value.Kind == ResourceScopeKind.Workspace && value.CanWrite)?.ScopeRef ?? scopeTargets.FirstOrDefault(value => value.CanWrite)?.ScopeRef;
                await LoadVaultsAsync(); if (version != loadVersion) return;
                baseline = Fingerprint; loadState = new(ResourceLoadStatus.Ready); return;
            }
            var owner = string.IsNullOrWhiteSpace(ScopeRefValue) ? (ResourceScopeRef?)null : ResourceScopeRef.Parse(ScopeRefValue);
            var snapshot = owner is null ? await Client.GetSecretAsync(Name!, cancellation.Token) : await Client.GetSecretAsync(Name!, owner.Value, cancellation.Token);
            if (version != loadVersion) return;
            var value = snapshot.Value.Resource;
            if (value.Name != Name || value.ScopeRef is not { } actualOwner || owner is not null && actualOwner != owner) throw new InvalidOperationException(T("ResourceIdentityMismatch"));
            var availableTask = Client.GetVaultsAsync(actualOwner, cancellation.Token);
            var referencesTask = Client.GetSecretUsagesAsync(Name!, actualOwner, cancellation.Token);
            await Task.WhenAll(availableTask, referencesTask); if (version != loadVersion) return;
            Apply(value, snapshot.ETag); vaults = availableTask.Result; usages = referencesTask.Result.Value;
            valueStatus = snapshot.Value.ValueStatus; valueConfigured = snapshot.Value.ValueConfigured; loadState = new(ResourceLoadStatus.Ready) { HasContent = true };
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception) { if (version == loadVersion) { Clear(); error = IsNew ? exception : null; loadState = Failure(exception); } }
        finally { if (version == loadVersion) loading = false; }
    }
    private Task RetryAsync() => busy || loading || refreshing ? Task.CompletedTask : resource is null ? LoadAsync() : RefreshAsync();
    private async Task RefreshAsync()
    {
        if (IsNew || resource is not { ScopeRef: { } owner } current || loading || refreshing || busy) return;
        var version = ++loadVersion; refreshing = true; loadState = new(ResourceLoadStatus.Refreshing) { HasContent = true };
        try
        {
            var snapshot = await Client.GetSecretAsync(current.Name, owner, cancellation.Token);
            if (version != loadVersion) return;
            var value = snapshot.Value.Resource;
            if (value.Uid != current.Uid || value.ScopeRef != owner || value.Address != current.Address) { Clear(); loadState = new(ResourceLoadStatus.NotFound); return; }
            var availableTask = Client.GetVaultsAsync(owner, cancellation.Token);
            var referencesTask = Client.GetSecretUsagesAsync(current.Name, owner, cancellation.Token);
            await Task.WhenAll(availableTask, referencesTask); if (version != loadVersion) return;
            if (HasDraft)
            {
                if (etag != snapshot.ETag) { newerResource = value; newerEtag = snapshot.ETag; }
                else resource = value;
            }
            else Apply(value, snapshot.ETag);
            vaults = availableTask.Result; usages = referencesTask.Result.Value;
            valueStatus = snapshot.Value.ValueStatus; valueConfigured = snapshot.Value.ValueConfigured; loadState = new(ResourceLoadStatus.Ready) { HasContent = true };
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception)
        {
            if (version != loadVersion) return;
            var failure = Failure(exception); if (failure.Status is ResourceLoadStatus.Forbidden or ResourceLoadStatus.NotFound) Clear();
            loadState = failure with { HasContent = resource is not null };
        }
        finally { if (version == loadVersion) refreshing = false; }
    }
    private static ResourceLoadState Failure(Exception exception) => new(exception is AgentstrationApiException api ? api.StatusCode switch
    {
        System.Net.HttpStatusCode.NotFound => ResourceLoadStatus.NotFound,
        System.Net.HttpStatusCode.Forbidden or System.Net.HttpStatusCode.Unauthorized => ResourceLoadStatus.Forbidden,
        _ => ResourceLoadStatus.Failed
    } : ResourceLoadStatus.Failed) { ErrorId = (exception as AgentstrationApiException)?.ErrorId };
    private void NameChanged(string value) { model.Name = value; if (IsNew && !keyEdited) model.Key = value; }
    private void KeyChanged(string value) { model.Key = value; keyEdited = true; }
    private async Task SaveAsync()
    {
        if (!CanManage || busy || refreshing) return;
        var version = loadVersion; var current = resource; var wasNew = IsNew;
        busy = true; error = null;
        try
        {
            var snapshot = wasNew ? await Client.CreateSecretAsync(new(model.Name, model.Properties(selectedScope), selectedScope), cancellation.Token)
                : await Client.UpdateSecretAsync(current!.Name, current.ScopeRef!.Value, new(model.Properties(selectedScope)), etag!, cancellation.Token);
            if (version != loadVersion) return;
            if (snapshot.Value.Name != (wasNew ? model.Name : current!.Name) || snapshot.Value.ScopeRef != selectedScope || !wasNew && snapshot.Value.Uid != current!.Uid)
                throw new InvalidOperationException(T("ResourceIdentityMismatch"));
            if (wasNew) { baseline = Fingerprint; invalidInput = false; Navigation.NavigateTo(ResourceUrl(snapshot.Value)); }
            else Apply(snapshot.Value, snapshot.ETag);
        }
        catch (Exception exception) { if (version == loadVersion) error = exception; }
        finally { if (version == loadVersion) busy = false; }
    }
    private async Task SetValueAsync()
    {
        if (!CanManage || busy || refreshing || string.IsNullOrEmpty(secretValue) || resource is not { ScopeRef: { } owner } current) return;
        var version = loadVersion; busy = true; error = null;
        try { await Client.SetSecretValueAsync(current.Name, owner, secretValue, cancellation.Token); if (version != loadVersion) return; valueConfigured = true; valueStatus = "Configured"; CancelValue(); }
        catch (Exception exception) { if (version == loadVersion) error = exception; }
        finally { if (version == loadVersion) { secretValue = null; valueEditorKey++; busy = false; } }
    }
    private void CancelValue() { secretValue = null; editingValue = false; valueEditorKey++; }
    private async Task DeleteValueAsync()
    {
        if (!CanManage || busy || refreshing || resource is not { ScopeRef: { } owner } current) return;
        var version = loadVersion; confirmDeleteValue = false; busy = true;
        try { await Client.DeleteSecretValueAsync(current.Name, owner, cancellation.Token); if (version != loadVersion) return; valueConfigured = false; valueStatus = "Missing"; CancelValue(); }
        catch (Exception exception) { if (version == loadVersion) error = exception; }
        finally { if (version == loadVersion) busy = false; }
    }
    private void RequestDelete() { if (!CanManage || busy || refreshing) return; if (usages.Count > 0) error = new AgentstrationApiException(T("SecretUsed", usages.Count), Guid.NewGuid().ToString("N")); else confirmDelete = true; }
    private string? returnAfterDelete;
    private async Task DeleteAsync()
    {
        if (!CanManage || busy || refreshing || resource is not { ScopeRef: { } owner } current) return;
        var version = loadVersion; confirmDelete = false; busy = true;
        try { await Client.DeleteSecretAsync(current.Name, owner, etag!, cancellation.Token); if (version != loadVersion) return; Clear(); loadState = new(ResourceLoadStatus.NotFound); returnAfterDelete = BackUrl; }
        catch (Exception exception) { if (version == loadVersion) error = exception; }
        finally { if (version == loadVersion) busy = false; }
    }
    private async Task ScopeChangedAsync(ResourceScopeRef? scopeRef)
    {
        selectedScope = scopeRef;
        model.VaultName = string.Empty;
        model.VaultScopeRef = null;
        model.VaultNamespace = null;
        model.UseGrants.Clear();
        await LoadVaultsAsync();
    }
    private async Task LoadVaultsAsync()
    {
        var version = ++vaultLoadVersion; var page = loadVersion; var scope = selectedScope;
        var values = scope is { } owner ? await Client.GetVaultsAsync(owner, cancellation.Token) : [];
        if (version == vaultLoadVersion && page == loadVersion && scope == selectedScope) vaults = values;
    }
    private string ResourceUrl(SecretResource value) => ResourceOwnershipContext.Resource(Services, "/secrets", value.Name, value.Namespace, value.ScopeRef);
    private static UiStatus Tone(string value) => value.Equals("Configured", StringComparison.OrdinalIgnoreCase) ? UiStatus.Success : value.Equals("Missing", StringComparison.OrdinalIgnoreCase) ? UiStatus.Warning : value.Equals("Unavailable", StringComparison.OrdinalIgnoreCase) || value.Equals("VaultUnavailable", StringComparison.OrdinalIgnoreCase) ? UiStatus.Danger : UiStatus.Neutral;
    public void Dispose() { ++loadVersion; ++vaultLoadVersion; secretValue = null; cancellation.Cancel(); cancellation.Dispose(); }
}
