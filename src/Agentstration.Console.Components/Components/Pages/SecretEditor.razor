@page "/secrets/new"
@page "/secrets/{Name}"
@implements IDisposable
@inject ISecretsClient Client
@inject NavigationManager Navigation
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<SecretStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared

<UnsavedNavigationGuard IsDirty="@HasUnsavedChanges" HasUnsavedChanges="@(() => HasUnsavedChanges)" ViewQueryParameters="@(new[] { "view", "tab" })" />
<PageTitle>@(IsNew ? T("CreateSecret") : $"{Name} · {T("Secret")}") · Agentstration</PageTitle>
@{
    RenderFragment feedback = @<div>
        @if (!IsNew && selectedScope is { } owner) { <InheritedResourceNotice OwnerScopeRef="owner" /> }
        @if (error is not null) { <div class="form-alert form-alert-danger" role="alert">@error.Message</div> }
        @if (usages.Count > 0) { <div class="form-alert form-alert-warning">@T("SecretReferenced", usages.Count)</div> }
    </div>;
}
@if (loading) { <LoadingState Message="@T("LoadingSecrets")" /> }
else if (!IsNew && resource is null) { @feedback }
else if (IsNew)
{
    <PageHeader Title="@T("CreateSecret")" Description="@T("SecretEditor.Description")" TestId="resource-secret-editor"><Actions><a class="button-secondary" href="/secrets">@T("Back")</a></Actions></PageHeader>
    @feedback
    <EditForm @key="model" EditContext="FormContext" FormName="secret-editor" class="resource-form" data-interactive="@(interactive ? "true" : "false")" @oninput="MarkDirtyFromForm" @onchange="MarkDirtyFromForm">
        <DataAnnotationsValidator /><FormDraftMonitor InvalidInputChanged="value => invalidInput = value" />
        <p class="required-fields-note"><span aria-hidden="true">*</span> @Shared["RequiredFields"]</p>
        <fieldset class="resource-definition-fields" disabled="@busy"><CreationWizard Steps="Steps" OnFinish="FinishAsync" Busy="busy" FinishLabel="@T("SaveMetadata")" /></fieldset>
    </EditForm>
}
else if (resource is not null)
{
    <ResourceDetailsTemplate Name="@resource.Definition.DisplayName" ResourceType="@T("Secret")" Domain="secret" IconName="key" Description="@resource.Definition.Description"
                             TechnicalName="@resource.Name" Namespace="@resource.Namespace.Value" ScopeRef="resource.ScopeRef"
                             StatusText="@StatusText(valueStatus ?? "Unknown")" Status="@Tone(valueStatus ?? "Unknown")"
                             Sections="Sections" ResourceIdentity="@($"{loadedKey}|{resource.ScopeRef}")" DefaultSection="overview" SelectionChanged="SelectSection" Feedback="@feedback" HasDraft="@HasDraft" TestId="resource-secret-editor">
        <Metadata>@if (section == "definition/configuration") { <span class="required-fields-note"><span aria-hidden="true">*</span> @Shared["RequiredFields"]</span> }</Metadata>
        <Actions>@if (CanManage) { <button class="button-danger" type="button" @onclick="RequestDelete" disabled="@busy">@T("Delete")</button> }<a class="button-secondary" href="/secrets">@T("Back")</a></Actions>
        <Content>
            <div hidden="@(section != "overview")">
                <ResourceIdentitySummary DisplayName="@resource.Definition.DisplayName" TechnicalName="@resource.Name" Namespace="@resource.Namespace.Value" Description="@resource.Definition.Description"><Scope><ResourceScopeBadge ScopeRef="resource.ScopeRef" /></Scope></ResourceIdentitySummary>
                <FormSection Title="@Shared["Configuration"]" Class="resource-configuration-summary">
                    <CollectionView TItem="ConfigurationEntry" Items="SavedConfiguration" IdentityLabel="@Shared["Configuration"]" InformationLabels="@(new[] { Shared["Saved"].Value })">
                        <Identity Context="entry"><strong class="configuration-key">@entry.Label</strong></Identity>
                        <Information Context="entry"><CollectionValue Label="@Shared["Saved"]">@if (entry.Href is { } href) { <a class="configuration-value resource-name-link" href="@href">@entry.Value</a> } else { <span class="configuration-value">@entry.Value</span> }</CollectionValue></Information>
                    </CollectionView>
                </FormSection>
                <p>@T("SecretValueNeverRevealed")</p>
            </div>
            <div hidden="@(!section.StartsWith("definition/", StringComparison.Ordinal))">
                <EditForm @key="model" EditContext="FormContext" OnValidSubmit="SaveAsync" OnInvalidSubmit="InvalidSubmit" FormName="secret-editor" id="secret-resource-form" class="resource-form" data-interactive="@(interactive ? "true" : "false")" @oninput="MarkDirtyFromForm" @onchange="MarkDirtyFromForm">
                    <DataAnnotationsValidator /><FormDraftMonitor InvalidInputChanged="value => invalidInput = value" />
                    <fieldset class="resource-definition-fields" disabled="@(busy || !CanManage)"><div hidden="@(section != "definition/configuration")">@IdentityFields @BindingFields</div><div hidden="@(section != "definition/grants")">@Grants</div></fieldset>
                </EditForm>
            </div>
            <div hidden="@(section != "value")">@ValuePanel</div>
            <div hidden="@(section != "usages")">@Usages</div>
            @if (accessVisited && CanManageAccess && resource.ScopeRef is { } ownerScope) { <div hidden="@(section != "access")"><ResourceAccessPanel ResourceUid="resource.Uid" DraftChanged="value => policyDirty = value" OwnerScopeRef="ownerScope" Namespace="resource.Namespace" Kind="@SecretResourceKinds.Secret" Name="@resource.Name" Generation="resource.Generation" Governance="resource.Governance" /></div> }
        </Content>
        <DraftActions><button type="button" class="button-secondary" disabled="@busy" @onclick="DiscardAsync">@T("Discard")</button><button type="submit" form="secret-resource-form" class="button-primary" disabled="@busy">@(busy ? T("Saving") : T("SaveMetadata"))</button></DraftActions>
    </ResourceDetailsTemplate>
}
<ConfirmationDialog IsOpen="@confirmDelete" Title="@T("DeleteSecret")" Message="@T("DeleteSecretMessage", Name ?? string.Empty)" ConfirmLabel="@T("DeleteSecret")" OnConfirm="DeleteAsync" OnCancel="() => confirmDelete = false" />
<ConfirmationDialog IsOpen="@confirmDeleteValue" Title="@T("DeleteSecretValue")" Message="@T("DeleteSecretValueMessage")" ConfirmLabel="@T("DeleteValue")" OnConfirm="DeleteValueAsync" OnCancel="() => confirmDeleteValue = false" />

@code {
    private RenderFragment IdentityFields => @<FormSection Title="@T("Identity")"><FormGrid>            <ResourceIdentityFields DisplayName="@model.DisplayName" DisplayNameChanged="value => model.DisplayName = value" DisplayNameExpression="@(() => model.DisplayName)" TechnicalName="@model.Name" TechnicalNameChanged="NameChanged" TechnicalNameExpression="@(() => model.Name)" IsNew="@IsNew" DisplayNameTestId="secret-display-name" TechnicalNameTestId="secret-name" TechnicalNameHelp="@T("ResourceIdentifierHelp")" />
            <FormField Label="@T("Description")" Optional="true" Class="form-span-2"><ClearableText Multiline="true" @bind-Value="model.Description" /></FormField>
            @if (IsNew) { <ResourceScopePicker Targets="scopeTargets" Value="selectedScope" ValueChanged="ScopeChangedAsync" /> } else { <label><span>@T("Scope")</span><ResourceScopeBadge ScopeRef="selectedScope" /></label> }
</FormGrid></FormSection>;
    private RenderFragment BindingFields => @<FormSection Title="@Shared["Configuration"]"><FormGrid>            <FormField Label="@T("Vault")" Required="true"><ChildContent><ClearableSelect TValue="string" data-testid="secret-vault-select" Value="@VaultSelection" ValueExpression="@(() => model.VaultName)" ValueChanged="value => VaultChanged(new ChangeEventArgs { Value = value })"><option value="">@T("SelectVault")</option>@foreach (var vault in AvailableVaults) { <option value="@VaultKey(vault.Resource)">@vault.Resource.Definition.DisplayName · @vault.Resource.ScopeRef</option> }</ClearableSelect></ChildContent><Validation><ValidationMessage For="@(() => model.VaultName)" /></Validation></FormField>
            <FormField Label="@T("VaultKey")" Required="true" Help="@T("VaultKeyHelp")"><ChildContent><ClearableText data-testid="secret-vault-key" Value="@model.Key" ValueChanged="KeyChanged" ValueExpression="@(() => model.Key)" /></ChildContent><Validation><ValidationMessage For="@(() => model.Key)" /></Validation></FormField>
            <FormField Label="@T("SecretType")"><ClearableText Value="@("opaque")" Disabled="true" /></FormField>
</FormGrid></FormSection>;
    private RenderFragment Grants => @<DescendantUseGrantEditor OwnerScopeRef="selectedScope" Targets="scopeTargets" Grants="model.UseGrants" OnChanged="MarkDirty" />;
    private RenderFragment ValuePanel => @<div>    <section class="panel resource-section">
        <div class="panel-header"><div><p class="eyebrow">@T("WriteOnly")</p><h2>@T("SecretValue")</h2></div><StatusBadge Text="@StatusText(valueStatus ?? "Unknown")" Status="@Tone(valueStatus ?? "")" /></div>
        <p>@T("SecretValueNeverRevealed")</p>
        @if (CanManage && !editingValue) { <FormActions><button class="button-primary" disabled="@busy" @onclick="() => editingValue = true">@(valueConfigured ? T("ReplaceValue") : T("SetValue"))</button>@if (valueConfigured) { <button class="button-danger" disabled="@busy" @onclick="() => confirmDeleteValue = true">@T("DeleteValue")</button> }</FormActions> }
        else if (CanManage) { <FormGrid @key="valueEditorKey"><FormField Label="@T("NewValue")" Class="form-span-2"><ClearableText Type="password" @bind-Value="secretValue" autocomplete="new-password" spellcheck="false" /></FormField><FormActions><button class="button-secondary" @onclick="CancelValue">@T("Cancel")</button><button class="button-primary" @onclick="SetValueAsync" disabled="@(busy || string.IsNullOrEmpty(secretValue))">@T("SaveValue")</button></FormActions></FormGrid> }
    </section>
</div>;
    private RenderFragment Usages => @<div>    @if (usages.Count > 0) { <section class="panel resource-section"><div class="panel-header"><h2>@T("Usages")</h2><span>@usages.Count</span></div><ul class="resource-links">@foreach (var usage in usages) { <li><CollectionIdentity DisplayName="@usage.DisplayName" Name="@usage.Name" Href="@usage.Url" IconName="layers" /><CollectionActions ResourceName="@usage.DisplayName"><a href="@usage.Url">@Shared["OpenItem"]</a></CollectionActions></li> }</ul></section> }</div>;
    private RenderFragment Review => @<FormSection Title="@Shared["Verification"]"><ChildContent><dl class="resource-details"><dt>@T("Identity")</dt><dd>@model.DisplayName<br /><code>@model.Name</code></dd><dt>@T("Scope")</dt><dd><ResourceScopeBadge ScopeRef="selectedScope" /></dd><dt>@T("Vault")</dt><dd>@model.VaultNamespace/@model.VaultName</dd><dt>@T("VaultKey")</dt><dd>@model.Key</dd></dl><p>@T("SecretValueNeverRevealed")</p></ChildContent></FormSection>;

    [Parameter] public string? Name { get; set; }
    [SupplyParameterFromQuery(Name = "scopeRef")] public string? ScopeRefValue { get; set; }
    private readonly CancellationTokenSource cancellation = new();
    private SecretEditorModel model = new();
    private SecretResource? resource;
    private IReadOnlyList<VaultResponse> vaults = [];
    private IReadOnlyList<ResourceScopeTargetResponse> scopeTargets = [];
    private ResourceScopeRef? selectedScope;
    private IReadOnlyList<SecretUsageResponse> usages = [];
    private string? etag, valueStatus, secretValue;
    private bool valueConfigured, editingValue, busy, confirmDelete, confirmDeleteValue, keyEdited, dirty, interactive, loading, invalidInput;
    private bool policyDirty, accessVisited;
    private string section = "overview";
    private string? loadedKey;
    private long loadVersion, vaultLoadVersion;
    private bool CanManageAccess => resource is not null && resource.ScopeRef is not null && ResourceOwnershipContext.CanManage(resource.ScopeRef, Services);
    private bool CanManage => IsNew || resource is not null && !resource.Governance.IsManaged && ResourceOwnershipContext.CanManage(resource.ScopeRef, Services);
    private bool HasDraft => !loading && CanManage && (dirty || invalidInput);
    private bool HasUnsavedChanges => HasDraft || policyDirty || CanManage && !string.IsNullOrEmpty(secretValue);
    private bool ValidField(string name, object? value) => System.ComponentModel.DataAnnotations.Validator.TryValidateProperty(value, new(model) { MemberName = name }, null);
    private bool IdentityComplete => selectedScope is not null && ValidField(nameof(model.Name), model.Name) && ValidField(nameof(model.DisplayName), model.DisplayName);
    private bool BindingComplete => ValidField(nameof(model.VaultName), model.VaultName) && ValidField(nameof(model.Key), model.Key) && model.VaultScopeRef is not null;
    private IReadOnlyList<ResourceNavigationItem> Sections =>
    [
        new("overview", Shared["Overview"], "home"),
        new("definition", Shared["Definition"], "settings") { Navigable = false, Visible = CanManage },
        new("definition/configuration", Shared["Configuration"], "forms") { Visible = CanManage },
        new("definition/grants", Shared["Access"], "key") { Visible = CanManage },
        new("value", T("SecretValue"), "lock"),
        new("usages", T("Usages"), "list-check") { Visible = usages.Count > 0 },
        new("access", T("Access"), "shield-check") { Visible = CanManageAccess }
    ];
    private IReadOnlyList<CreationWizardStep> Steps =>
    [
        new("identity", T("Identity"), IdentityFields) { IsComplete = IdentityComplete },
        new("vault", T("Vault"), BindingFields) { IsComplete = BindingComplete },
        new("grants", Shared["Access"], Grants) { IsComplete = true },
        new("review", Shared["Verification"], Review) { IsComplete = IdentityComplete && BindingComplete }
    ];
    private void SelectSection(string? path) { section = path ?? "overview"; if (section == "access" && CanManageAccess) accessVisited = true; }
    private void InvalidSubmit(EditContext _) { section = "definition/configuration"; Navigation.NavigateTo(Navigation.Uri.Split('#')[0] + "#" + section); }
    private async Task FinishAsync(CreationWizardFinish finish)
    {
        if (!FormContext.Validate() || selectedScope is null || !BindingComplete) { finish.ReturnToStepId = !IdentityComplete ? "identity" : "vault"; return; }
        await SaveAsync();
    }
    private sealed record ConfigurationEntry(string Label, string Value, string? Href = null);
    private IReadOnlyList<ConfigurationEntry> SavedConfiguration => resource is null ? [] :
    [
        new(T("Vault"), $"{resource.Definition.Vault.Namespace ?? resource.Namespace}/{resource.Definition.Vault.Name}", ResourceOwnershipContext.Resource(Services, "/vaults", resource.Definition.Vault.Name, resource.Definition.Vault.Namespace ?? resource.Namespace, resource.Definition.Vault.ScopeRef)),
        new(T("VaultKey"), resource.Definition.Key),
        new(T("SecretType"), resource.Definition.SecretType.ToString().ToLowerInvariant()),
        new(Shared["Access"], resource.Definition.UsePolicy.Grants.Count == 0 ? Shared["NotProvided"] : string.Join("\n", resource.Definition.UsePolicy.Grants.Select(g => g.ScopeRef.Value)))
    ];
    private int valueEditorKey;
    private Exception? error;
    private bool IsNew => string.IsNullOrWhiteSpace(Name);
    private IReadOnlyList<VaultResponse> AvailableVaults => vaults.Where(value => CanUseVault(value.Resource)).ToArray();
    private string VaultSelection => model.VaultScopeRef is { } scope && !string.IsNullOrWhiteSpace(model.VaultName) ? $"{scope.Value}|{(model.VaultNamespace ?? ResourceNamespace.Default).Value}|{model.VaultName}" : string.Empty;
    private static string VaultKey(VaultResource vault) => $"{vault.ScopeRef!.Value.Value}|{vault.Namespace.Value}|{vault.Name}";
    private bool CanUseVault(VaultResource vault)
    {
        if (selectedScope is not { } consumer || vault.ScopeRef is not { } owner) return false;
        if (owner == consumer) return true;
        if (owner.Kind >= consumer.Kind) return false;
        var tenant = scopeTargets.FirstOrDefault(value => value.Kind == ResourceScopeKind.Tenant)?.ScopeRef;
        return vault.Definition.UsePolicy.Grants.Any(grant => grant.ScopeRef == consumer
            || grant.IncludeDescendants && consumer.Kind == ResourceScopeKind.Workspace && grant.ScopeRef == tenant);
    }
    private void VaultChanged(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        var vault = AvailableVaults.FirstOrDefault(candidate => VaultKey(candidate.Resource) == value)?.Resource;
        model.VaultName = vault?.Name ?? string.Empty;
        model.VaultScopeRef = vault?.ScopeRef;
        model.VaultNamespace = vault?.Namespace;
    }
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    private EditContext? editContext;
    private EditContext FormContext
    {
        get
        {
            if (!ReferenceEquals(editContext?.Model, model))
            {
                if (editContext is not null) editContext.OnFieldChanged -= FieldChanged;
                editContext = new(model);
                editContext.OnFieldChanged += FieldChanged;
            }
            return editContext;
        }
    }
    private void FieldChanged(object? sender, FieldChangedEventArgs args) => MarkDirty();
    private void MarkDirty() => dirty = true;
    private void MarkDirtyFromForm(EventArgs _) => MarkDirty();
    private string StatusText(string status) => T($"Status.{status.ToLowerInvariant() switch { "configured" => "Configured", "missing" => "Missing", "unavailable" => "Unavailable", "vaultunavailable" => "VaultUnavailable", _ => "Unknown" }}");
    protected override void OnAfterRender(bool firstRender) { if (!firstRender) return; interactive = true; StateHasChanged(); }
    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Name}|{ScopeRefValue}|{ResourceOwnershipContext.TryGetCurrent(Services)}";
        if (loadedKey == key) return;
        loadedKey = key; var version = ++loadVersion; ++vaultLoadVersion;
        loading = true; error = null; policyDirty = accessVisited = false; resource = null; usages = []; section = "overview"; CancelValue();
        try
        {
            var targets = await Client.GetScopeTargetsAsync(SecretResourceKinds.Secret, cancellation.Token);
            if (version != loadVersion) return;
            scopeTargets = targets;
            if (IsNew)
            {
                model = new(); keyEdited = false;
                selectedScope = scopeTargets.FirstOrDefault(value => value.Kind == ResourceScopeKind.Workspace && value.CanWrite)?.ScopeRef ?? scopeTargets.FirstOrDefault(value => value.CanWrite)?.ScopeRef;
                await LoadVaultsAsync(); return;
            }
            var requestedScope = ParseScope();
            var snapshot = requestedScope is null ? await Client.GetSecretAsync(Name!, cancellation.Token) : await Client.GetSecretAsync(Name!, requestedScope.Value, cancellation.Token);
            var owner = snapshot.Value.Resource.ScopeRef!.Value;
            var available = await Client.GetVaultsAsync(owner, cancellation.Token);
            var references = (await Client.GetSecretUsagesAsync(Name!, owner, cancellation.Token)).Value;
            if (version != loadVersion) return;
            resource = snapshot.Value.Resource; model = SecretEditorModel.From(resource); selectedScope = owner;
            vaults = available; usages = references; keyEdited = true; etag = snapshot.ETag;
            valueStatus = snapshot.Value.ValueStatus; valueConfigured = snapshot.Value.ValueConfigured;
        }
        catch (Exception ex) { if (version == loadVersion) { error = ex; loadedKey = null; } }
        finally { if (version == loadVersion) { loading = false; dirty = invalidInput = false; } }
    }
    private void NameChanged(string value) { model.Name = value; if (IsNew && !keyEdited) model.Key = value; }
    private void KeyChanged(string value) { model.Key = value; keyEdited = true; }
    private async Task SaveAsync()
    {
        if (!CanManage || busy) return;
        busy = true;
        error = null;
        try
        {
            var snapshot = IsNew
                ? await Client.CreateSecretAsync(new(model.Name, model.Properties(selectedScope), selectedScope), cancellation.Token)
                : await Client.UpdateSecretAsync(model.Name, selectedScope!.Value, new(model.Properties(selectedScope)), etag!, cancellation.Token);
            if (IsNew) { dirty = invalidInput = false; Navigation.NavigateTo(ResourceUrl(snapshot.Value)); }
            else
            {
                resource = snapshot.Value;
                model = SecretEditorModel.From(snapshot.Value);
                etag = snapshot.ETag;
                dirty = invalidInput = false;
            }
        }
        catch (Exception ex) { error = ex; }
        finally { busy = false; }
    }
    private void DiscardAsync()
    {
        if (busy || resource is null) return;
        model = SecretEditorModel.From(resource); selectedScope = resource.ScopeRef;
        dirty = invalidInput = false; error = null;
    }
    private async Task SetValueAsync() { if (!CanManage || busy || string.IsNullOrEmpty(secretValue)) return; busy = true; error = null; try { await Client.SetSecretValueAsync(model.Name, selectedScope!.Value, secretValue, cancellation.Token); valueConfigured = true; valueStatus = "Configured"; CancelValue(); } catch (Exception ex) { error = ex; } finally { secretValue = null; valueEditorKey++; busy = false; } }
    private void CancelValue() { secretValue = null; editingValue = false; valueEditorKey++; }
    private async Task DeleteValueAsync() { if (!CanManage || busy) return; confirmDeleteValue = false; try { await Client.DeleteSecretValueAsync(model.Name, selectedScope!.Value, cancellation.Token); valueConfigured = false; valueStatus = "Missing"; CancelValue(); } catch (Exception ex) { error = ex; } }
    private void RequestDelete() { if (!CanManage || busy) return; if (usages.Count > 0) error = new AgentstrationApiException(T("SecretUsed", usages.Count), Guid.NewGuid().ToString("N")); else confirmDelete = true; }
    private async Task DeleteAsync() { if (!CanManage || busy) return; confirmDelete = false; try { await Client.DeleteSecretAsync(model.Name, selectedScope!.Value, etag!, cancellation.Token); dirty = invalidInput = false; CancelValue(); Navigation.NavigateTo("/secrets"); } catch (Exception ex) { error = ex; } }
    private async Task ScopeChangedAsync(ResourceScopeRef? scopeRef)
    {
        selectedScope = scopeRef;
        model.VaultName = string.Empty;
        model.VaultScopeRef = null;
        model.VaultNamespace = null;
        model.UseGrants.Clear();
        await LoadVaultsAsync();
    }
    private async Task LoadVaultsAsync()
    {
        var version = ++vaultLoadVersion; var page = loadVersion; var scope = selectedScope;
        var values = scope is { } owner ? await Client.GetVaultsAsync(owner, cancellation.Token) : [];
        if (version == vaultLoadVersion && page == loadVersion && scope == selectedScope) vaults = values;
    }
    private ResourceScopeRef? ParseScope() => string.IsNullOrWhiteSpace(ScopeRefValue) ? null : ResourceScopeRef.Parse(ScopeRefValue);
    private string ResourceUrl(SecretResource value) => ResourceOwnershipContext.Resource(Services, "/secrets", value.Name, value.Namespace, value.ScopeRef);
    private static UiStatus Tone(string value) => value.Equals("Configured", StringComparison.OrdinalIgnoreCase) ? UiStatus.Success : value.Equals("Missing", StringComparison.OrdinalIgnoreCase) ? UiStatus.Warning : value.Equals("Unavailable", StringComparison.OrdinalIgnoreCase) || value.Equals("VaultUnavailable", StringComparison.OrdinalIgnoreCase) ? UiStatus.Danger : UiStatus.Neutral;
    public void Dispose() { if (editContext is not null) editContext.OnFieldChanged -= FieldChanged; secretValue = null; cancellation.Cancel(); cancellation.Dispose(); }
}
