@page "/tools/categories"
@inject IToolCategoriesClient Categories
@inject Microsoft.Extensions.Localization.IStringLocalizer<ToolCategoriesStrings> Localizer

<PageTitle>@T("Title") · Agentstration</PageTitle>
<PageHeader Title="@T("Title")" Description="@T("Description")" TestId="resource-tool-categories">
    <Actions><a class="button-primary" href="/tools/categories/new">@T("Create")</a></Actions>
</PageHeader>
<ResourceTabs Label="@T("SectionsLabel")"><a href="/tools">@T("Catalog")</a><a href="/tools/sets">@T("ToolSets")</a><a class="active" href="/tools/categories">@T("Categories")</a><a href="/tools/definitions">@T("Definitions")</a><a href="/tools/providers">@T("Providers")</a></ResourceTabs>

@if (loading) { <LoadingState Message="@T("Loading")" /> }
else if (error is not null) { <ErrorState Message="@error" /> }
else if (categories.Count == 0) { <EmptyState Title="@T("EmptyTitle")" Message="@T("EmptyMessage")" /> }
else
{
    <CollectionView TItem="ToolCategoryResource" Items="categories" InformationLabels="@(new string[] { T("DescriptionColumn"), T("Members") })" RowTestId="tool-category-row" IdentityLabel="@T("Category")">
        <Identity Context="category">
<CollectionIdentity DisplayName="@category.Definition.DisplayName" Namespace="@category.Namespace.Value" Name="@category.Name" Href="@CategoryUrl(category)" IconName="layers"><Badges><ManagedResourceBadge IsManaged="@category.Governance.IsManaged" /></Badges></CollectionIdentity></Identity>
        <Scope Context="category">
<ResourceScopeBadge ScopeRef="category.ScopeRef" ShowName /></Scope>
        <Information Context="category">
            <CollectionValue Label="@T("DescriptionColumn")">@(category.Definition.Description ?? "—")</CollectionValue>
            <CollectionValue Label="@T("Members")">@category.Definition.Tools.Count</CollectionValue>
        </Information>
        <Actions Context="category">
<CollectionActions ResourceName="@($"{category.Definition.DisplayName} ({category.Namespace}/{category.Name}, {category.ScopeRef})")"><a class="text-button" href="@CategoryUrl(category)">@T("Manage")</a></CollectionActions></Actions>
    </CollectionView>
}

@code {
    private IReadOnlyList<ToolCategoryResource> categories = [];
    private bool loading = true;
    private string? error;
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    protected override async Task OnInitializedAsync()
    {
        try { categories = await Categories.GetCategoriesAsync(); }
        catch (Exception exception) { error = exception.Message; }
        finally { loading = false; }
    }
    private static string CategoryUrl(ToolCategoryResource value) => ConsoleResourceUrls.Resource("/tools/categories", value.Name, value.Namespace, value.ScopeRef);
}
