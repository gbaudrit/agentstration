@inject Microsoft.Extensions.Localization.IStringLocalizer<AgentEditorStrings> Localizer

<section class="panel form-section agent-tools-panel" data-testid="agent-tool-configuration">
    <div class="panel-header">
        <div>
            <p class="eyebrow">@T("ToolConfiguration")</p>
            <h2>@T("GovernedTools")</h2>
            <p>@T("ToolConfigurationHelp")</p>
        </div>
        <a class="button-secondary agent-tools-manage" href="/tools" data-testid="manage-mcp-tools"><UiIcon Name="wrench" />@T("ManageMcpTools")</a>
    </div>

    @if (Groups.Count == 0)
    {
        <div class="agent-tools-empty">
            <p>@T("NoDiscoveredTools")</p>
            <a class="text-button" href="/tools">@T("OpenToolCatalog") →</a>
        </div>
    }
    else
    {
        <div class="agent-tool-access-summary" aria-label="@T("EffectiveToolAccess")" data-testid="agent-tool-access-summary">
            <span><strong>@EffectiveToolCount</strong>@T("EffectiveTools")</span>
            <span><strong>@InheritedToolCount</strong>@T("ViaToolSets")</span>
            <span><strong>@IndividualToolCount</strong>@T("IndividualTools")</span>
        </div>
        @if (CategoryGroups.Count > 0)
        {
            <section class="agent-tool-categories" aria-labelledby="agent-tool-categories-title">
                <header><div><span class="agent-tool-provider-type">@T("FunctionalSelection")</span><h3 id="agent-tool-categories-title">@T("ToolCategories")</h3><p>@T("ToolCategoriesHelp")</p></div><a class="text-button" href="/tools/categories">@T("ManageCategories") →</a></header>
                <div class="agent-tool-category-list">
                    @foreach (var category in CategoryGroups)
                    {
                        var state = CategoryState(category);
                        <button type="button" class="agent-tool-category @(state == "true" ? "selected" : state == "mixed" ? "partial" : null)" role="checkbox" aria-checked="@state" @onclick="() => ToggleCategoryAsync(category)" data-category="@category.Name">
                            <span class="agent-tool-category-check" aria-hidden="true">@(state == "true" ? "✓" : state == "mixed" ? "−" : "")</span>
                            <span><strong>@category.DisplayName</strong><small>@T("CategorySelection", CategorySelectedCount(category), category.AssignableTools.Count)</small><small>@ProviderSummary(category)</small></span>
                        </button>
                    }
                </div>
            </section>
        }
        <div class="agent-tool-groups">
            @foreach (var group in Groups)
            {
                <article class="agent-tool-group" data-provider="@group.ProviderName">
                    <header>
                        <div class="agent-tool-provider-identity">
                            <span class="agent-tool-provider-icon" aria-hidden="true"><TablerIcon Name="server" /></span>
                            <div>
                                <span class="agent-tool-provider-type">@T("McpProvider")</span>
                                <h3>@group.DisplayName</h3>
                                <code>@group.ProviderName</code>
                            </div>
                        </div>
                        <div class="agent-tool-group-actions">
                            <div class="agent-tool-group-summary">
                                <strong>@T("EffectiveSelectedTools", SelectedCount(group))</strong>
                                <span>@T("ToolCount", group.Tools.Count)</span>
                            </div>
                            @if (group.HasProvider)
                            {
                                <a class="text-button" href="@ProviderUrl(group.ProviderName)">@T("OpenMcp") →</a>
                            }
                        </div>
                    </header>
                    <div class="agent-tool-list">
                        @foreach (var tool in group.Tools)
                        {
                            var assigned = IsAssigned(tool.Metadata.Name);
                            var inherited = IsInherited(tool.Metadata.Name);
                            var effective = assigned || inherited;
                            var usable = tool.Definition.Enabled && tool.Definition.Discovery?.Available == true;
                            var inputId = ToolInputId(tool.Metadata.Name);
                            <div class="agent-tool-option @(inherited ? "inherited" : null)">
                                <input id="@inputId" type="checkbox" aria-label="@tool.Definition.DisplayName" checked="@effective" disabled="@(inherited || (!usable && !assigned))" @onchange="args => ToggleAsync(tool.Metadata.Name, (bool)args.Value!)" />
                                <label class="agent-tool-card-icon" for="@inputId" aria-hidden="true"><TablerIcon Name="tool" /></label>
                                <span class="agent-tool-copy">
                                    <strong><a class="agent-tool-name" href="@ToolUrl(tool.Metadata.Name)">@tool.Definition.DisplayName</a>@if (!string.IsNullOrWhiteSpace(tool.Definition.Description)) { <HelpTooltip Text="@tool.Definition.Description" /> }</strong>
                                    @if (inherited)
                                    {
                                        <span class="tool-status inherited"><i></i>@T("GrantedViaToolSet", ToolSetSources(tool.Metadata.Name))</span>
                                    }
                                    else
                                    {
                                        <label class="@ToolStatusClass(usable, assigned)" for="@inputId"><i></i>@(usable ? T("Available") : assigned ? T("AssignedUnavailable") : T("NotUsable"))</label>
                                    }
                                </span>
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>

@code {
    [Parameter] public IReadOnlyList<ToolResource> Tools { get; set; } = [];
    [Parameter] public IReadOnlyList<ToolProviderResource> Providers { get; set; } = [];
    [Parameter] public IReadOnlyList<ToolCategoryResource> Categories { get; set; } = [];
    [Parameter] public IReadOnlyList<string> SelectedToolIds { get; set; } = [];
    [Parameter] public IReadOnlyDictionary<string, IReadOnlyList<string>> ToolSetGrantedTools { get; set; } = new Dictionary<string, IReadOnlyList<string>>(StringComparer.Ordinal);
    [Parameter] public EventCallback<IReadOnlyList<string>> SelectedToolIdsChanged { get; set; }

    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private IReadOnlyList<AgentToolProviderGroup> Groups => AgentToolProviderGroup.Create(Tools, Providers, T("UnknownMcp"));
    private IReadOnlyList<AgentToolCategoryGroup> CategoryGroups => AgentToolCategoryGroup.Create(Categories, Tools);
    private bool IsAssigned(string id) => SelectedToolIds.Contains(id, StringComparer.Ordinal);
    private bool IsInherited(string id) => ToolSetGrantedTools.ContainsKey(id);
    private bool IsEffective(string id) => IsAssigned(id) || IsInherited(id);
    private int EffectiveToolCount => Tools.Count(tool => IsEffective(tool.Metadata.Name));
    private int InheritedToolCount => Tools.Count(tool => IsInherited(tool.Metadata.Name));
    private int IndividualToolCount => Tools.Count(tool => IsAssigned(tool.Metadata.Name) && !IsInherited(tool.Metadata.Name));
    private int SelectedCount(AgentToolProviderGroup group) => group.Tools.Count(tool => IsEffective(tool.Metadata.Name));
    private string ToolSetSources(string id) => string.Join(", ", ToolSetGrantedTools[id]);
    private static string ToolStatusClass(bool usable, bool assigned) => usable ? "tool-status available" : assigned ? "tool-status warning" : "tool-status unavailable";
    private int CategorySelectedCount(AgentToolCategoryGroup category) => category.AssignableTools.Count(tool => IsEffective(tool.Name));
    private string CategoryState(AgentToolCategoryGroup category)
    {
        var selected = CategorySelectedCount(category);
        return selected == 0 ? "false" : selected == category.AssignableTools.Count ? "true" : "mixed";
    }
    private string ProviderSummary(AgentToolCategoryGroup category) => string.Join(" · ", category.Tools
        .Select(tool => Providers.FirstOrDefault(provider => provider.Name == tool.Definition.Provider?.Name)?.Definition.DisplayName ?? tool.Definition.Provider?.Name ?? T("UnknownMcp"))
        .Distinct(StringComparer.CurrentCultureIgnoreCase));

    private async Task ToggleAsync(string id, bool selected)
    {
        if (IsInherited(id)) return;
        var values = SelectedToolIds.Distinct(StringComparer.Ordinal).ToList();
        if (selected && !values.Contains(id, StringComparer.Ordinal)) values.Add(id);
        else if (!selected) values.RemoveAll(value => string.Equals(value, id, StringComparison.Ordinal));
        await SelectedToolIdsChanged.InvokeAsync(values);
    }

    private async Task ToggleCategoryAsync(AgentToolCategoryGroup category)
    {
        var values = SelectedToolIds.Distinct(StringComparer.Ordinal).ToList();
        var mutableTools = category.AssignableTools.Where(tool => !IsInherited(tool.Name)).ToArray();
        var select = mutableTools.Any(tool => !values.Contains(tool.Name, StringComparer.Ordinal));
        if (select)
        {
            foreach (var tool in mutableTools)
                if (!values.Contains(tool.Name, StringComparer.Ordinal)) values.Add(tool.Name);
        }
        else
        {
            var members = mutableTools.Select(tool => tool.Name).ToHashSet(StringComparer.Ordinal);
            values.RemoveAll(members.Contains);
        }
        await SelectedToolIdsChanged.InvokeAsync(values);
    }

    private static string ProviderUrl(string name) => $"/tools/providers/{Uri.EscapeDataString(name)}";
    private static string ToolUrl(string name) => $"/tools/{Uri.EscapeDataString(name)}";
    private static string ToolInputId(string name) => $"agent-tool-{Uri.EscapeDataString(name)}";
}
