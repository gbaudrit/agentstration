@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<RuntimePlacementStrings> Localizer

@if (loading)
{
    <LoadingState Message="@T("Loading")" />
}
else if (placement is not null)
{
    var effectiveAttempt = placement.Attempts
        .OrderByDescending(attempt => attempt.AcquiredAt)
        .FirstOrDefault(attempt => attempt.State == nameof(RuntimeAssignmentAttemptState.Active))
        ?? placement.Attempts.OrderByDescending(attempt => attempt.AcquiredAt).FirstOrDefault();
    <section class="panel runtime-placement" data-testid="runtime-placement">
        <div class="panel-header"><h2>@T("Title")</h2><StatusBadge Text="@T($"State.{placement.State}")" Status="@PlatformDashboardService.ToStatus(placement.State)" /></div>
        <dl class="details-list">
            <dt>@T("Worker")</dt>
            <dd>@if (effectiveAttempt is null) { <span>@T("NotAssigned")</span> } else { <a href="@WorkerUrl(effectiveAttempt.WorkerId)"><code>@effectiveAttempt.WorkerId</code></a> }</dd>
            <dt>@T("Runtime")</dt><dd>@placement.RuntimeCapability · @placement.RuntimeCapabilityVersion</dd>
            <dt>@T("MaterialVersion")</dt><dd>@placement.ExecutionMaterialVersion</dd>
        </dl>
        @if (placement.Attempts.Count > 0)
        {
            <details>
                <summary>@T("AttemptHistory", placement.Attempts.Count)</summary>
                <ol class="operations-list">
                    @foreach (var attempt in placement.Attempts.OrderByDescending(item => item.AcquiredAt))
                    {
                        <li>
                            <a href="@WorkerUrl(attempt.WorkerId)"><code>@attempt.WorkerId</code></a>
                            <span>@T($"AttemptState.{attempt.State}")</span>
                            <dl class="details-list">
                                <dt>@T("Session")</dt><dd><code>@attempt.WorkerSessionId</code></dd>
                                <dt>@T("Acquired")</dt><dd>@attempt.AcquiredAt.LocalDateTime.ToString("g")</dd>
                                <dt>@T("Heartbeat")</dt><dd>@attempt.LastHeartbeatAt.LocalDateTime.ToString("g")</dd>
                                <dt>@T("LeaseExpires")</dt><dd>@attempt.LeaseExpiresAt.LocalDateTime.ToString("g")</dd>
                                <dt>@T("Completed")</dt><dd>@(attempt.CompletedAt?.LocalDateTime.ToString("g") ?? "—")</dd>
                                <dt>@T("ErrorCode")</dt><dd>@(attempt.ErrorCode ?? "—")</dd>
                                <dt>@T("Fencing")</dt><dd>@attempt.FencingGeneration</dd>
                            </dl>
                        </li>
                    }
                </ol>
            </details>
        }
    </section>
}
else if (unavailable)
{
    <div class="form-alert form-alert-warning" role="status">@T("Unavailable")</div>
}

@code {
    [Parameter, EditorRequired] public RuntimeAssignmentTargetKind TargetKind { get; set; }
    [Parameter, EditorRequired] public string RunId { get; set; } = string.Empty;

    private RuntimeAssignmentPlacementResponse? placement;
    private bool loading;
    private bool unavailable;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        unavailable = false;
        var runtimeClient = Services.GetService(typeof(IRuntimeApiClient)) as IRuntimeApiClient;
        if (runtimeClient is null)
        {
            loading = false;
            placement = null;
            return;
        }
        try
        {
            placement = await runtimeClient.GetPlacementAsync(TargetKind, RunId, CancellationToken.None);
        }
        catch (HttpRequestException)
        {
            placement = null;
            unavailable = true;
        }
        finally
        {
            loading = false;
        }
    }

    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private static string WorkerUrl(Guid workerId) => $"/settings/runtime-workers/{workerId:D}";
}
