@page "/schemas"
@implements IDisposable
@using Agentstration.Schemas
@inject IServiceProvider Services
@inject ISchemasClient Client
@inject ConsoleContextState Context
@inject Microsoft.Extensions.Localization.IStringLocalizer<SchemasStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared

<PageTitle>@T("Title") · Agentstration</PageTitle>
<ResourceCollectionTemplate TItem="SchemaResource" Title="@T("Title")" Description="@T("Description")" TestId="resource-schemas"
                            IdentityColumn="IdentityColumn" Columns="Columns" AdditionalFilters="ExtraFilters" Items="PageItems" ContextKey="@contextKey" RowTestId="schema-row"
                            Query="query" QueryChanged="ChangeQueryAsync" Pagination="Pagination" LoadState="loadState" Disabled="@(!interactive)"
                            SearchEnabled SearchLabel="@Shared["Search"]" SearchPlaceholder="@Shared["Search"]"
                            EmptyTitle="@T("EmptyTitle")" EmptyMessage="@T("EmptyMessage")" PrimaryActions="CreateAction" EmptyActions="CreateAction"
                            OnRefresh="LoadAsync" OnRetry="RetryAsync" />

@code {
    private string T(string key) => Localizer[key].Value;
    private RenderFragment? CreateAction => Context.HasPermission(AuthorizationPermissions.ResourcesWrite)
        ? @<PermissionGate Permission="@AuthorizationPermissions.ResourcesWrite"><a class="button-primary" href="@Navigate("/schemas/new")">@T("Create")</a></PermissionGate> : null;
    private CollectionColumn<SchemaResource> IdentityColumn => new("identity", T("Schema"), schema => @<CollectionIdentity DisplayName="@schema.Definition.DisplayName" Namespace="@schema.Namespace.Value" Name="@schema.Name" Href="@EditUrl(schema)" IconName="schema" Domain="neutral" data-testid="schema-details-link">
        <Versions><CollectionVersion Label="@T("Generation")" Value="@(schema.Generation.ToString())" /></Versions>
        <IconBadges><ResourceScopeBadge ScopeRef="schema.ScopeRef" ShowName IconOnly /><ManagedResourceBadge IsManaged="@schema.Governance.IsManaged" IsReadOnly="@(!ResourceOwnershipContext.CanManage(schema.ScopeRef, Services))" IconOnly /></IconBadges>
    </CollectionIdentity>);
    private IReadOnlyList<CollectionColumn<SchemaResource>> Columns =>
    [
        new("format", T("Format"), schema => @<code>@schema.Definition.Format</code>)
        {
            Filters = [new("format", T("Format"), CollectionFilterKind.Choice)
            {
                Options = (items ?? []).Select(item => item.Definition.Format).Distinct(StringComparer.Ordinal).Order().Select(value => new CollectionFilterOption(value, value)).ToArray()
            }]
        },
        new("dialect", T("Dialect"), schema => @<code>@(schema.Definition.Dialect ?? "—")</code>)
        {
            Filters = [new("dialect", T("Dialect"), CollectionFilterKind.Text) { Advanced = true }]
        }
    ];
    private IReadOnlyList<CollectionFilter> ExtraFilters =>
    [
        new("scope", Shared["Scope"], CollectionFilterKind.Choice)
        {
            Options = (items ?? []).Select(item => item.ScopeRef?.Value).OfType<string>().Distinct(StringComparer.Ordinal).Order().Select(value => new CollectionFilterOption(value, Context.Current?.Contexts.FirstOrDefault(context => context.ScopeRef == value)?.DisplayName ?? value)).ToArray()
        },
        new("namespace", T("Namespace"), CollectionFilterKind.Text) { Placeholder = T("AllNamespaces") }
    ];
    private string Navigate(string path) => ResourceOwnershipContext.PreserveNavigation(path, Services);
    private string EditUrl(SchemaResource schema) => Navigate($"/schemas/{Uri.EscapeDataString(schema.Name)}?scopeRef={Uri.EscapeDataString(schema.ScopeRef!.Value.Value)}&namespace={Uri.EscapeDataString(schema.Namespace.Value)}");
}
