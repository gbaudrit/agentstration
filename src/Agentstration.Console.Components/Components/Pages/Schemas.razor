@inject IServiceProvider Services
@page "/schemas"
@using Agentstration.Schemas
@inject ISchemasClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<SchemasStrings> Localizer

<PageTitle>@T("Title") · Agentstration</PageTitle>
<PageHeader Title="@T("Title")" Description="@T("Description")" TestId="resource-schemas">
    <Actions><a class="button-primary" href="/schemas/new">@T("Create")</a><button class="button-secondary" type="button" @onclick="LoadAsync">@T("Refresh")</button></Actions>
</PageHeader>

<ResourceToolbar Label="@T("Filters")">
    <label><span>@T("Scope")</span><select data-testid="schema-scope-filter" @bind="scopeFilter"><option value="">@T("AllScopes")</option>@foreach (var scope in scopes) { <option value="@scope.Value">@scope.Value</option> }</select></label>
    <label><span>@T("Namespace")</span><input data-testid="schema-namespace-filter" @bind="namespaceFilter" placeholder="@T("AllNamespaces")" /></label>
</ResourceToolbar>

@if (loading) { <LoadingState Message="@T("Loading")" /> }
else if (error is not null) { <ErrorState Message="@error" /> }
else if (Filtered.Count == 0) { <EmptyState Title="@T("EmptyTitle")" Message="@T("EmptyMessage")" /> }
else
{
    <CollectionView TItem="SchemaResource" Items="Filtered" InformationLabels="@(new string[] { T("Format"), T("Dialect") })" RowTestId="schema-row">
        <Identity Context="schema"><CollectionIdentity DisplayName="@schema.Definition.DisplayName" Namespace="@schema.Namespace.Value" Name="@schema.Name" Href="@EditUrl(schema)" IconName="schema" Domain="neutral" data-testid="schema-details-link"><Versions><CollectionVersion Label="@T("Generation")" Value="@(schema.Generation.ToString())" /></Versions><IconBadges><ResourceScopeBadge ScopeRef="schema.ScopeRef" ShowName IconOnly /><ManagedResourceBadge IsManaged="@schema.Governance.IsManaged" IsReadOnly="@(!ResourceOwnershipContext.CanManage(schema.ScopeRef, Services))" IconOnly /></IconBadges></CollectionIdentity></Identity>
        <Information Context="schema">
            <CollectionValue Label="@T("Format")"><code>@schema.Definition.Format</code></CollectionValue>
            <CollectionValue Label="@T("Dialect")"><code>@(schema.Definition.Dialect ?? "—")</code></CollectionValue>
        </Information>
        <Actions Context="schema"><CollectionActions ResourceName="@($"{schema.Definition.DisplayName} ({schema.Namespace}/{schema.Name}, {schema.ScopeRef})")"><a href="@EditUrl(schema)">@T("Open")</a></CollectionActions></Actions>
    </CollectionView>
}

@code {
    private IReadOnlyList<SchemaResource> schemas = [];
    private IReadOnlyList<ResourceScopeRef> scopes = [];
    private string scopeFilter = string.Empty;
    private string namespaceFilter = string.Empty;
    private bool loading = true;
    private string? error;
    private IReadOnlyList<SchemaResource> Filtered => schemas.Where(value =>
        (string.IsNullOrEmpty(scopeFilter) || value.ScopeRef?.Value == scopeFilter)
        && (string.IsNullOrWhiteSpace(namespaceFilter)
            || value.Namespace.Value.Contains(namespaceFilter.Trim(), StringComparison.OrdinalIgnoreCase)))
        .OrderBy(value => value.Namespace.Value, StringComparer.Ordinal)
        .ThenBy(value => value.Name, StringComparer.Ordinal)
        .ToArray();
    private string T(string key) => Localizer[key];
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            schemas = await Client.GetSchemasAsync();
            scopes = schemas.Where(value => value.ScopeRef is not null).Select(value => value.ScopeRef!.Value)
                .Distinct().OrderBy(value => value.Value, StringComparer.Ordinal).ToArray();
        }
        catch (Exception exception) { error = exception.Message; }
        finally { loading = false; }
    }
    private static string EditUrl(SchemaResource value) => $"/schemas/{Uri.EscapeDataString(value.Name)}"
        + $"?scopeRef={Uri.EscapeDataString(value.ScopeRef!.Value.Value)}"
        + $"&namespace={Uri.EscapeDataString(value.Namespace.Value)}";
}
