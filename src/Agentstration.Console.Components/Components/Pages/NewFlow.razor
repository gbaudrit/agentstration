@page "/flows/new"
@implements IDisposable
@inject IFlowApiClient Client
@inject IManagementApiClient Management
@inject IServiceProvider Services
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<NewFlowStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
<PageTitle>@T("Title") · Agentstration</PageTitle>
<UnsavedNavigationGuard IsDirty="@IsDirty" HasUnsavedChanges="@(() => IsDirty)" />
<PageHeader ScopeRef="selectedScope" Title="@T("Title")" Description="@T("Description")"><Actions><a class="button-secondary" href="@ResourceOwnershipContext.PreserveNavigation("/flows", Services)">@T("Cancel")</a></Actions></PageHeader>
@if (!CanCreate && (Services.GetService(typeof(ConsoleContextState)) as ConsoleContextState)?.Current is not null) { <ResourceReadOnlyNotice Reason="ResourceReadOnlyReason.InsufficientPermissions" /> }
<EditForm EditContext="formContext" OnSubmit="SubmitAsync" class="resource-form" data-testid="flow-create-form" data-interactive="@interactive.ToString().ToLowerInvariant()" novalidate>
    <FormDraftMonitor InvalidInputChanged="value => invalidInput = value" />
    <p class="required-fields-note"><span aria-hidden="true">*</span> @Shared["RequiredFields"]</p>
    @if (error is not null) { <p class="error-panel" role="alert">@error</p> }
    <fieldset class="resource-definition-fields" disabled="@(submitting || !interactive || !CanCreate)">
        <CreationWizard @ref="wizard" Steps="Steps" Busy="submitting" Disabled="@(!interactive || !CanCreate)" OnFinish="FinishAsync" FinishLabel="@T(model.Kind == "Workflow" ? "CreateDraft" : "CreateOrchestration")" FinishTestId="flow-create" />
    </fieldset>
</EditForm>

@code {
    private RenderFragment IdentityFields => @<div>
        <FormSection Title="@Shared["Identity"]" Description="@T("IdentityHelp")" TestId="flow-identity-section"><FormGrid>
            <ResourceIdentityFields @bind-DisplayName="model.DisplayName" TechnicalName="@model.Name" TechnicalNameChanged="TechnicalNameChanged" TechnicalNameExpression="() => model.Name" Policy="ResourceNamePolicy.Flow" IsNew="true" DisplayNameHelp="@T("DisplayNameHelp")" TechnicalNameHelp="@T("TechnicalNameHelp")" DisplayNameTestId="flow-display-name" TechnicalNameTestId="flow-name" />
            <FormField Label="@T("Namespace")"><ClearableText Value="@ResourceNamespace.Default.Value" ReadOnly /></FormField>
            <ResourceScopeFormField ResourceKind="@FlowResourceKinds.Flow" Value="selectedScope" ValueChanged="ScopeChanged" Disabled="submitting" />
            @if (scopeError) { <p class="validation-message" role="alert">@T("Validation.Scope")</p> }
            <FormField Label="@T("Field.Description")" Class="form-span-2" Help="@T("DescriptionHelp")"><ClearableText Multiline @bind-Value="model.Description" rows="3" data-testid="flow-description" /></FormField>
        </FormGrid></FormSection>
        <FormSection Title="@T("FlowKind")" Description="@T("FlowKindHelp")">
            <InputRadioGroup @bind-Value="model.Kind" class="flow-kind-grid">
                <label class="flow-choice @(model.Kind == "Workflow" ? "is-selected" : null)"><InputRadio Value="@("Workflow")" /><UiIcon Name="workflow" /><span><strong>@T("Kind.Workflow")</strong><small>@T("Kind.WorkflowHelp")</small></span></label>
                <label class="flow-choice @(model.Kind == "Orchestration" ? "is-selected" : null)" data-testid="flow-kind-orchestration"><InputRadio Value="@("Orchestration")" /><UiIcon Name="agent" /><span><strong>@T("Kind.Orchestration")</strong><small>@T("Kind.OrchestrationHelp")</small></span></label>
            </InputRadioGroup>
            @if (model.Kind == "Orchestration") { <FormField Label="@T("InitialVersion")" Required Help="@T("InitialVersionHelp")"><Validation><ValidationMessage For="() => orchestration.Version" /></Validation><ChildContent><ClearableText UpdateOnInput="false" @bind-Value="orchestration.Version" data-testid="flow-version" /></ChildContent></FormField> }
        </FormSection>
    </div>;
    private RenderFragment ConfigurationFields => @<div>
        <div hidden="@(model.Kind != "Workflow")"><FormSection Title="@T("StartingTemplate")" Description="@T("StartingTemplateHelp")">
            <InputRadioGroup @bind-Value="model.Template" class="flow-template-grid">
                @foreach (var template in Templates) { <label class="flow-choice @(model.Template == template.Value ? "is-selected" : null)"><InputRadio Value="@template.Value" /><UiIcon Name="@template.Icon" /><span><strong>@T($"Template.{template.Value}")</strong><small>@T($"Template.{template.Value}Help")</small></span></label> }
            </InputRadioGroup>
        </FormSection></div>
        <div hidden="@(model.Kind != "Orchestration")" data-testid="flow-orchestration-configuration">
            <FormSection Title="@T("ConfigurationTitle")" Description="@T("ConfigurationHelp")"><FormField Label="@T("Enabled")" Help="@T("EnabledHelp")"><FormCheckbox @bind-Value="orchestration.Enabled" role="switch" data-testid="flow-enabled" /></FormField></FormSection>
            @if (agentsLoading) { <LoadingState Message="@T("LoadingAgents")" /> }
            else if (agentsError is not null) { <ErrorState Title="@Shared["Unavailable"]" Message="@agentsError" /><button type="button" class="button-secondary" @onclick="LoadAgentsAsync">@T("Retry")</button> }
            else { <OrchestrationDefinitionEditor Model="orchestration" Agents="agents" Changed="DefinitionChanged" IsReadOnly="submitting" /> }
            @if (configurationError) { <p class="validation-message" role="alert">@T("Validation.Configuration")</p> }
        </div>
    </div>;
    private RenderFragment Review => @<FormSection Title="@Shared["Verification"]"><ChildContent>
        <dl class="resource-details"><dt>@Shared["Identity"]</dt><dd>@model.DisplayName<br /><code>@ResourceNamespace.Default.Value/@model.Name</code></dd><dt>@Shared["Scope"]</dt><dd><ResourceScopeBadge ScopeRef="selectedScope" /></dd><dt>@T("FlowKind")</dt><dd>@T($"Kind.{model.Kind}")</dd>
        @if (!string.IsNullOrWhiteSpace(model.Description)) { <dt>@T("Field.Description")</dt><dd>@model.Description</dd> }
        @if (model.Kind == "Workflow") { <dt>@T("StartingTemplate")</dt><dd>@T($"Template.{model.Template}")</dd> }
        else { <dt>@T("InitialVersion")</dt><dd>@orchestration.Version</dd><dt>@T("Enabled")</dt><dd>@T(orchestration.Enabled ? "EnabledOn" : "EnabledOff")</dd><dt>@T("Participants")</dt><dd>@string.Join(", ", orchestration.ParticipantIds)</dd> }
        </dl><p>@T(model.Kind == "Workflow" ? "Ready.Workflow" : "Ready.Orchestration")</p><p>@T("PublicationSeparate")</p>
    </ChildContent></FormSection>;

    private readonly CancellationTokenSource cancellation = new();
    private readonly NewFlowModel model = new();
    private readonly OrchestrationEditorModel orchestration = new();
    private ResourceScopeRef? selectedScope, initialScope;
    private IReadOnlyList<AgentSummary> agents = [];
    private EditContext formContext = null!;
    private ValidationMessageStore messages = null!;
    private CreationWizard? wizard;
    private bool submitting, interactive, invalidInput, created, scopeInitialized, scopeError, configurationError, agentsLoading;
    private string? error, agentsError, baseline;
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string Fingerprint => JsonSerializer.Serialize(new { model, orchestration });
    private bool IsDirty => !created && (invalidInput || baseline is not null && Fingerprint != baseline || scopeInitialized && selectedScope != initialScope);
    private bool CanCreate => Services.GetService(typeof(ConsoleContextState)) is not ConsoleContextState context || context.HasPermission("resources/write");
    private bool NameValid => !string.IsNullOrWhiteSpace(model.Name) && model.Name.Length <= 128 && char.IsLetterOrDigit(model.Name[0]) && model.Name.All(character => char.IsLetterOrDigit(character) || character is '-' or '_');
    private bool IdentityComplete => NameValid && !string.IsNullOrWhiteSpace(model.DisplayName) && model.DisplayName.Length <= 200 && selectedScope is not null && model.Kind is "Workflow" or "Orchestration";
    private IReadOnlyList<CreationWizardStep> Steps => [
        new("identity", Shared["Identity"], IdentityFields) { IsComplete = IdentityComplete && VersionValid },
        new("configuration", Shared["Configuration"], ConfigurationFields) { IsComplete = ConfigurationComplete && !invalidInput },
        new("review", Shared["Verification"], Review) { IsComplete = IdentityComplete && VersionValid && ConfigurationComplete && !invalidInput }
    ];
    private bool VersionValid { get { if (model.Kind != "Orchestration") return true; try { FlowValidator.ValidateVersion(new FlowVersion(ResourceScopeRef.Instance, new("validation"), orchestration.Version, null, new DirectFlowDefinition(new(FlowTargetKind.Agent, "validation")), new Dictionary<string, string>(), DateTimeOffset.UnixEpoch)); return true; } catch (ArgumentException) { return false; } } }
    private bool ConfigurationComplete
    {
        get
        {
            if (model.Kind == "Workflow") return Templates.Any(template => template.Value == model.Template);
            if (agentsLoading || agentsError is not null) return false;
            try
            {
                FlowValidator.ValidateVersion(new FlowVersion(ResourceScopeRef.Instance, new("validation"), "1.0.0", model.Description, orchestration.CreateDefinition(), new Dictionary<string, string>(), DateTimeOffset.UnixEpoch)); return true;
            }
            catch (Exception exception) when (exception is InvalidOperationException or ArgumentException) { return false; }
        }
    }
    private static readonly (string Value, string Icon)[] Templates = [("EmptyFlow", "plus"), ("AgentRouting", "workflow"), ("SequentialProcessing", "layers"), ("ConditionalFlow", "flow-run")];
    protected override async Task OnInitializedAsync()
    {
        model.DisplayName = T("DefaultDisplayName"); model.Description = T("DefaultDescription");
        formContext = new(model); messages = new(formContext); formContext.OnFieldChanged += FieldChanged;
        baseline = Fingerprint;
        if (Services.GetService(typeof(ConsoleContextState)) is ConsoleContextState context) await context.EnsureLoadedAsync(cancellation.Token);
        await LoadAgentsAsync();
    }
    private async Task LoadAgentsAsync()
    {
        agentsLoading = true; agentsError = null;
        try { var available = await Management.GetAgentsAsync(cancellation.Token); if (!cancellation.IsCancellationRequested) agents = available; }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception) { agentsError = exception.Message; }
        finally { agentsLoading = false; }
    }
    private void FieldChanged(object? sender, FieldChangedEventArgs args) { messages.Clear(args.FieldIdentifier); formContext.NotifyValidationStateChanged(); _ = InvokeAsync(StateHasChanged); }
    private Task DefinitionChanged() { configurationError = false; return InvokeAsync(StateHasChanged); }
    private void TechnicalNameChanged(string value) { var initializing = model.Name.Length == 0 && !formContext.IsModified(); model.Name = value; if (initializing) baseline = Fingerprint; }
    private void ScopeChanged(ResourceScopeRef? scope) { selectedScope = scope; scopeError = false; if (!scopeInitialized) { initialScope = scope; scopeInitialized = true; } }
    protected override void OnAfterRender(bool firstRender) { if (firstRender) { interactive = true; StateHasChanged(); } }
    private Task SubmitAsync() => wizard is null ? Task.CompletedTask : wizard.CurrentStepId == "review" ? wizard.FinishAsync() : wizard.ContinueAsync();
    private async Task FinishAsync(CreationWizardFinish finish)
    {
        if (!interactive || !CanCreate || submitting) return;
        messages.Clear(); error = null; scopeError = selectedScope is null; configurationError = !ConfigurationComplete;
        if (!NameValid) messages.Add(new FieldIdentifier(model, nameof(model.Name)), T("Validation.Name"));
        if (string.IsNullOrWhiteSpace(model.DisplayName) || model.DisplayName.Length > 200) messages.Add(new FieldIdentifier(model, nameof(model.DisplayName)), T("Validation.DisplayName"));
        if (!VersionValid) messages.Add(new FieldIdentifier(orchestration, nameof(orchestration.Version)), T("Validation.Version"));
        formContext.NotifyValidationStateChanged();
        if (!IdentityComplete || !VersionValid) { finish.ReturnToStepId = "identity"; return; }
        if (configurationError || invalidInput) { finish.ReturnToStepId = "configuration"; return; }
        await CreateAsync();
    }
    private async Task CreateAsync()
    {
        if (submitting || !interactive || !CanCreate || selectedScope is not { } ownerScope) return;
        try
        {
            submitting = true; error = null;
            if (model.Kind == "Workflow")
            {
                var draft = await Client.CreateDraftAsync(new CreateFlowDraftRequest(model.Name, model.DisplayName, model.Description, Template: model.Template) { ScopeRef = ownerScope }, cancellation.Token);
                if (cancellation.IsCancellationRequested) return;
                if (draft.Value.FlowId.Value != model.Name || draft.Value.ScopeRef != ownerScope || draft.Value.FlowId.Namespace != ResourceNamespace.Default) throw new InvalidOperationException(T("IdentityMismatch"));
                created = true;
                Navigation.NavigateTo(ResourceOwnershipContext.PreserveNavigation($"/flows/{Uri.EscapeDataString(draft.Value.FlowId.Value)}/designer?scopeRef={Uri.EscapeDataString(ownerScope.Value)}", Services), forceLoad: true);
                return;
            }
            var result = await Client.CreateFlowAsync(new CreateFlowRequest(model.Name, model.Description, orchestration.Version, orchestration.Enabled, orchestration.CreateDefinition()) { DisplayName = model.DisplayName, ScopeRef = ownerScope }, cancellation.Token);
            if (cancellation.IsCancellationRequested) return;
            if (result.Value.Id != model.Name || result.Value.Namespace != ResourceNamespace.Default || result.Value.ScopeRef != ownerScope) throw new InvalidOperationException(T("IdentityMismatch"));
            created = true;
            Navigation.NavigateTo(ResourceOwnershipContext.PreserveNavigation($"/flows/{Uri.EscapeDataString(result.Value.Id)}?scopeRef={Uri.EscapeDataString(ownerScope.Value)}", Services) + "#definition/configuration");
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception) { error = exception.Message; }
        finally { submitting = false; }
    }
    public void Dispose() { formContext.OnFieldChanged -= FieldChanged; cancellation.Cancel(); cancellation.Dispose(); }
    private sealed class NewFlowModel
    {
        public string Name { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string Kind { get; set; } = "Workflow";
        public string Template { get; set; } = "AgentRouting";
    }
}
