@implements IDisposable
@inject IArtifactsClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<ArtifactsStrings> Localizer

<section class="panel form-section durable-content-notice" data-testid="durable-artifact-content-panel">
    <div class="panel-header"><div><p class="eyebrow">@T("ProtectedContent")</p><h2>@T("DurableContentTitle")</h2><p>@T("DurableContentHelp")</p></div></div>
    @if (materializationError is not null)
    {
        <div class="form-alert form-alert-danger" role="alert">@materializationError</div>
    }
    <div class="artifact-content-actions">
        @if (materializedArtifactId is { } stagedId)
        {
            <a class="button-secondary" href="@StagedUrl(stagedId)" data-testid="durable-artifact-open-materialized">@T("OpenMaterializedArtifact")</a>
            <a class="button-secondary" href="@DownloadUrl(stagedId)" download data-enhance-nav="false" data-testid="durable-artifact-download">@T("Download")</a>
        }
        else
        {
            <button class="button-primary" type="button" disabled="@(loading || materializing)" data-testid="durable-artifact-materialize" @onclick="MaterializeAsync">
                @(materializing ? T("MaterializingContent") : T("MaterializeContent"))
            </button>
        }
    </div>
    @if (materialization is not null)
    {
        <p class="muted" data-testid="durable-artifact-materialization-status">@T("MaterializationStatus", MaterializationStatus(materialization.Status)) · <a class="text-button" href="@FlowRunUrl(materialization.FlowRunId)">@materialization.FlowRunId</a></p>
    }
</section>

@if (InlinePreview && materializedArtifactId is { } previewId)
{
    <StagedArtifactContent @key="previewId" ArtifactId="previewId" ContextScope="ContextScope" ReadOnOpen="true" />
}

<section class="panel form-section" data-testid="durable-artifact-materialization-history">
    <div class="panel-header"><div><p class="eyebrow">@T("Materialization")</p><h2>@T("MaterializationHistory")</h2><p>@T("MaterializationHistoryHelp")</p></div></div>
    @if (materializations.Count == 0)
    {
        <p class="muted">@T("NoMaterializations")</p>
    }
    else
    {
        <DataGrid TItem="FlowRunArtifactMaterialization" Items="materializations">
            <Header><tr><th>@T("State")</th><th>@T("FlowRun")</th><th>@T("Artifact")</th><th>@T("Expires")</th><th><span class="sr-only">@T("Actions")</span></th></tr></Header>
            <Row Context="item"><tr>
                <td>@MaterializationStatus(item.Status)</td>
                <td><a class="text-button" href="@FlowRunUrl(item.FlowRunId)"><code>@item.FlowRunId</code></a></td>
                <td>
                    @if (item is { StagedArtifactAvailable: true, StagedArtifactId: { } stagedArtifactId })
                    {
                        <a class="text-button" href="@StagedUrl(stagedArtifactId)"><code>@stagedArtifactId</code></a>
                    }
                    else
                    {
                        <span class="muted">@T("MaterializationUnavailable")</span>
                    }
                </td>
                <td>@FormatDate(item.StagedArtifactExpiresAt)</td>
                <td>
                    @if (item is { StagedArtifactAvailable: true, StagedArtifactId: { } downloadableArtifactId })
                    {
                        <a class="icon-button" href="@DownloadUrl(downloadableArtifactId)" download data-enhance-nav="false" aria-label="@T("DownloadMaterializedArtifact")" title="@T("DownloadMaterializedArtifact")" data-testid="durable-artifact-history-download"><UiIcon Name="download" /></a>
                    }
                </td>
            </tr></Row>
        </DataGrid>
    }
</section>

@code {
    [Parameter, EditorRequired] public FlowRunArtifactId ArtifactId { get; set; }
    [Parameter] public ResourceScopeRef? ContextScope { get; set; }
    [Parameter] public bool InlinePreview { get; set; }

    private readonly CancellationTokenSource cancellation = new();
    private FlowRunArtifactMaterialization? materialization;
    private IReadOnlyList<FlowRunArtifactMaterialization> materializations = [];
    private StagedArtifactId? materializedArtifactId;
    private bool loading = true, materializing;
    private string? materializationError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            materializations = await Client.GetMaterializationsAsync(ArtifactId, cancellation.Token);
            materialization = materializations.FirstOrDefault();
            RestoreMaterializedArtifact();
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception) { materializationError = exception.Message; }
        finally { loading = false; }
    }

    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string WithContext(string url) => ContextScope is { } scope
        ? $"{url}?context={Uri.EscapeDataString(scope.Value)}" : url;
    private string FlowRunUrl(string id) => WithContext($"/flow-runs/{Uri.EscapeDataString(id)}");
    private string StagedUrl(StagedArtifactId id) => WithContext($"/artifacts/staged/{id}");
    private string DownloadUrl(StagedArtifactId id) => WithContext(Client.GetDownloadUrl(id));

    private async Task MaterializeAsync()
    {
        if (loading || materializing) return;
        materializing = true;
        materializationError = null;
        try
        {
            materialization = await Client.StartMaterializationAsync(ArtifactId, cancellation.Token);
            for (var attempt = 0; attempt < 60 && !IsTerminal(materialization.Status); attempt++)
            {
                await Task.Delay(TimeSpan.FromSeconds(1), cancellation.Token);
                materialization = await Client.GetMaterializationAsync(ArtifactId, materialization.FlowRunId, cancellation.Token)
                    ?? throw new InvalidOperationException(T("MaterializationNotFound"));
            }
            if (materialization.StagedArtifactId is { } stagedId)
                materializedArtifactId = materialization.StagedArtifactAvailable ? stagedId : null;
            else if (string.Equals(materialization.Status, "Succeeded", StringComparison.OrdinalIgnoreCase))
                materializationError = T("MaterializationOutputMissing");
            else if (IsTerminal(materialization.Status))
                materializationError = materialization.ErrorMessage ?? T("MaterializationFailed", materialization.Status);
            else
                materializationError = T("MaterializationStillRunning");
            var completedFlowRunId = materialization.FlowRunId;
            materializations = await Client.GetMaterializationsAsync(ArtifactId, cancellation.Token);
            materialization = materializations.FirstOrDefault(value => value.FlowRunId == completedFlowRunId) ?? materialization;
            RestoreMaterializedArtifact();
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception) { materializationError = exception.Message; }
        finally { materializing = false; }
    }

    private void RestoreMaterializedArtifact() => materializedArtifactId = materializations.FirstOrDefault(value =>
        value is { StagedArtifactAvailable: true, StagedArtifactId: not null })?.StagedArtifactId;

    private static string FormatDate(DateTimeOffset? value) => value is null
        ? "—"
        : value.Value.ToLocalTime().ToString("g", System.Globalization.CultureInfo.CurrentCulture);

    private string MaterializationStatus(string status)
    {
        var localized = Localizer[$"MaterializationStatus.{status}"];
        return localized.ResourceNotFound ? status : localized.Value;
    }

    private static bool IsTerminal(string status) => status is "Succeeded" or "Failed" or "Cancelled" or "TimedOut";

    public void Dispose()
    {
        cancellation.Cancel();
        cancellation.Dispose();
    }
}
