@page "/pack-projects/{ProjectId:guid}"
@implements IDisposable
@inject IPacksClient Client
@inject ConsoleContextState ContextState
@inject IServiceProvider Services
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<PackStrings> Localizer

<PageTitle>@(project?.Value.Definition.DisplayName ?? T("PackProject")) · Agentstration</PageTitle>

@if (error is not null)
{
    <ErrorState Message="@error.Message" ErrorId="@error.ErrorId"><button class="button-secondary" @onclick="LoadAsync">@T("Retry")</button></ErrorState>
}
else if (project is null)
{
    <LoadingState Message="@T("LoadingPackProject")" />
}
else
{
    <PageHeader Title="@(project.Value.Definition.DisplayName ?? project.Value.Definition.PackName)" Description="@T("PackProject.Description")">
        <Actions>
            <button class="button-secondary" @onclick="BackToPacks">@T("BackToPacks")</button>
            <button class="button-secondary" disabled="@(busy || !dirty)" @onclick="SaveAsync">@T("Save")</button>
            <button class="button-primary" disabled="@busy" @onclick="BuildAsync">@(building ? T("Building") : T("BuildPack"))</button>
        </Actions>
    </PageHeader>

    <section class="studio-layout">
        <div class="panel studio-editor">
            <div class="panel-header"><div><p class="eyebrow">@T("ProjectDefinition")</p><h2>@T("ManifestMetadata")</h2></div><StatusBadge Text="@T($"ProjectState.{project.Value.Definition.State}")" Status="@ProjectTone" /></div>
            <div class="studio-grid">
                <label>@T("Publisher")<input value="@project.Value.Definition.Publisher" disabled /></label>
                <label>@T("Name")<input value="@project.Value.Definition.PackName" disabled /></label>
                <label>@T("Version")<input @bind="version" @bind:after="MarkDirty" /></label>
                <label>@T("DisplayName")<input @bind="displayName" @bind:after="MarkDirty" /></label>
            </div>
            <label class="studio-field">@T("Description")<textarea rows="4" @bind="description" @bind:after="MarkDirty"></textarea></label>
            <div class="studio-grid">
                <label>@T("Audience")
                    <select @bind="audience" @bind:after="MarkDirty">
                        <option value="@PackAudience.Universal">@T("Audience.Universal")</option>
                        <option value="@PackAudience.Personal">@T("Audience.Personal")</option>
                        <option value="@PackAudience.Professional">@T("Audience.Professional")</option>
                    </select>
                </label>
                <label>@T("Purpose")
                    <select @bind="purpose" @bind:after="MarkDirty">
                        <option value="@PackPurpose.Standard">@T("Purpose.Standard")</option>
                        <option value="@PackPurpose.Sample">@T("Purpose.Sample")</option>
                        <option value="@PackPurpose.Template">@T("Purpose.Template")</option>
                    </select>
                </label>
                <label>@T("Categories")<input @bind="categories" @bind:after="MarkDirty" placeholder="game, sample" /></label>
                <label>@T("Tags")<input @bind="tags" @bind:after="MarkDirty" placeholder="local, experimental" /></label>
            </div>
            <dl class="resource-details studio-origin">
                @if (project.Value.Definition.Origin is { } origin)
                {
                    <dt>@T("ForkedFrom")</dt><dd><code>@origin.Publisher/@origin.Name</code> · @origin.Version</dd>
                }
                else
                {
                    <dt>@T("Source")</dt><dd>@T("WorkspaceResourceSnapshot")</dd>
                    <dt>@T("Resources")</dt><dd>@project.Value.Definition.SourceResources.Count</dd>
                }
                <dt>@T("SourceHash")</dt><dd><code>@ShortHash(project.Value.Definition.SourceArtifact.Sha256)</code></dd>
                <dt>@T("Revision")</dt><dd>@project.Value.Definition.Revision</dd>
            </dl>
              @if (project.Value.Definition.SourceResources.Count > 0)
              {
                <div class="studio-source-resources">
                    @foreach (var resource in project.Value.Definition.SourceResources)
                    {
                        <span><code>@resource.Kind/@resource.Name</code><small>@(resource.ExplicitlySelected ? T("Selected") : T("Dependency"))</small></span>
                    }
                </div>
              }
            @if (message is not null) { <p class="@(hasError ? "error-panel" : "studio-message")" role="status">@message</p> }
        </div>

        <aside class="panel studio-install">
            <div class="panel-header"><div><p class="eyebrow">@T("LocalDeployment")</p><h2>@T("CurrentWorkspace")</h2></div></div>
            <strong>@(ContextState.Current?.WorkspaceDisplayName ?? T("CurrentWorkspace"))</strong>
            @if (preview is not null) { <p class="studio-namespace"><span>@T("Namespace")</span><code>@preview.Namespace</code></p> }
            <p class="studio-hint">@T("StoredBuildHelp")</p>
            @if (selectedBuild is null)
            {
                <div class="studio-empty-preview"><span>1</span><p>@T("PreviewBuildHelp")</p></div>
            }
            else if (preview is not null)
            {
                <div class="studio-selected-build"><span>@T("SelectedBuild")</span><strong>@selectedBuild.Definition.Version</strong><code>@ShortHash(selectedBuild.Definition.Artifact.Sha256)</code></div>
                <div class="studio-preview">
                    <StatusBadge Text="@PreviewStatus" Status="@(CanInstall ? UiStatus.Success : UiStatus.Warning)" />
                    <span>@T("ResourceConflictCount", preview.Resources.Count, preview.Resources.Count(resource => resource.AlreadyExists))</span>
                </div>
                @if (preview.Bindings.Count > 0)
                {
                    <section class="studio-bindings" aria-label="@T("PackResourceBindings")">
                        <div><strong>@T("ResourceBindings")</strong><small>@T("BindingsRetained")</small></div>
                        @foreach (var binding in preview.Bindings)
                        {
                            <label>
                                <span>@binding.DisplayName <small>@(binding.Required ? T("Required") : T("Optional")) · @BindingKindLabel(binding.TargetKind)</small></span>
                                <select value="@SelectedBinding(binding.Name)" @onchange="args => BindingChanged(binding.Name, args)">
                                    <option value="">@T("SelectBinding", BindingKindLabel(binding.TargetKind).ToLowerInvariant())</option>
                                    @if (binding.TargetKind == PackBindingTargetKind.ModelProfile)
                                    {
                                        @foreach (var profile in modelProfiles)
                                        {
                                            <option value="@BindingValue(profile.Name, ResourceNamespace.Parse(profile.Namespace))">@profile.Properties.DisplayName — @profile.Namespace/@profile.Name</option>
                                        }
                                    }
                                    else if (binding.TargetKind == PackBindingTargetKind.ModelProvider)
                                    {
                                        @foreach (var provider in modelProviders)
                                        {
                                            <option value="@BindingValue(provider.Name, ResourceNamespace.Default)">@provider.Properties.DisplayName — default/@provider.Name</option>
                                        }
                                    }
                                    else if (binding.TargetKind == PackBindingTargetKind.RuntimeProfile)
                                    {
                                        @foreach (var runtimeProfile in runtimeProfiles)
                                        {
                                            <option value="@BindingValue(runtimeProfile.Name, ResourceNamespace.Parse(runtimeProfile.Namespace))">@runtimeProfile.Properties.DisplayName — @runtimeProfile.Namespace/@runtimeProfile.Name</option>
                                        }
                                    }
                                    else if (binding.TargetKind == PackBindingTargetKind.ExtensionRegistration)
                                    {
                                        @foreach (var extension in extensionRegistrations)
                                        {
                                            <option value="@BindingValue(extension.Name, extension.Namespace)">@extension.Definition.DisplayName — @extension.Namespace/@extension.Name</option>
                                        }
                                    }
                                    else
                                    {
                                        @foreach (var secret in secrets)
                                        {
                                            <option value="@BindingValue(secret.Resource.Name, secret.Resource.Namespace)">@secret.Resource.Definition.DisplayName — @secret.Resource.Name (@T($"SecretStatus.{secret.ValueStatus}"))</option>
                                        }
                                    }
                                </select>
                            </label>
                        }
                    </section>
                }
                @if (preview.AlreadyInstalled)
                {
                    <label class="studio-checkbox"><input type="checkbox" @bind="replaceExisting" /> @T("ReinstallPackBuild")</label>
                    <p class="studio-warning">@T("ModifiedResourcesPreserved")</p>
                }
            }
            <button class="button-primary" disabled="@(selectedBuild is null || busy || !CanInstall)" @onclick="InstallAsync">@(installing ? T("Installing") : T("InstallLocally"))</button>
        </aside>
    </section>

    <section class="panel studio-builds" data-testid="pack-source-resources">
        <div class="panel-header"><div><p class="eyebrow">@T("EditableSource")</p><h2>@T("PackResources")</h2><p>@T("PackResourcesHelp")</p></div><span>@T("ResourceCount", sourceDocuments?.Count ?? 0)</span></div>
        @if (sourceDocuments is null)
        {
            <LoadingState Message="@T("LoadingPackResources")" />
        }
        else if (sourceDocuments.Count == 0)
        {
            <EmptyState Title="@T("NoSourceResource")" Message="@T("NoSourceResourceHelp")" />
        }
        else
        {
            <div class="studio-source-resources">
                @foreach (var resource in sourceDocuments)
                {
                    <article><div><code>@resource.Kind/@resource.Name</code><small>@resource.Path</small></div><div class="studio-source-actions">@if (CanUseForm(resource)) { <button type="button" class="text-button" @onclick="() => SelectSource(resource, SourceView.Form)">@T("Form")</button> }<button type="button" class="text-button" @onclick="() => SelectSource(resource, SourceView.Yaml)">@T("Yaml")</button></div></article>
                }
            </div>
        }
        @if (selectedSource is not null)
        {
            <div class="resource-section" data-testid="pack-source-editor">
                <div class="panel-header"><div><p class="eyebrow">@selectedSource.Path</p><h3>@selectedSource.Kind/@selectedSource.Name</h3></div><div class="studio-source-actions">@if (CanUseForm(selectedSource)) { <button type="button" class="text-button @(sourceView == SourceView.Form ? "active" : null)" @onclick="() => sourceView = SourceView.Form">@T("Form")</button> }<button type="button" class="text-button @(sourceView == SourceView.Yaml ? "active" : null)" @onclick="() => sourceView = SourceView.Yaml">@T("Yaml")</button><button class="icon-button" type="button" @onclick="CloseSource" aria-label="@T("CloseSourceEditor")">×</button></div></div>
                @if (sourceView == SourceView.Form && CanUseForm(selectedSource))
                {
                    <PackAgentDefinitionForm @key="selectedSource.Path" @ref="agentSourceForm" Source="@sourceYaml" />
                }
                else
                {
                    <textarea class="form-code-editor runner-json" rows="30" @bind="sourceYaml" @bind:event="oninput" aria-label="@T("PackSourceYaml")"></textarea>
                }
                <div class="form-actions"><button class="button-secondary" type="button" @onclick="CloseSource">@T("Cancel")</button><button class="button-primary" type="button" disabled="@busy" @onclick="SaveSourceAsync">@(busy ? T("Saving") : T("SaveResource"))</button></div>
            </div>
        }
    </section>

    <section class="panel studio-builds">
        <div class="panel-header"><div><p class="eyebrow">@T("ImmutableArtifacts")</p><h2>@T("Builds")</h2></div><span class="studio-hint">@T("Builds.Description")</span></div>
        @if (builds is null)
        {
            <LoadingState Message="@T("LoadingBuilds")" />
        }
        else if (builds.Count == 0)
        {
            <EmptyState Title="@T("NoBuildYet")" Message="@T("NoBuildYetMessage")" />
        }
        else
        {
            <DataGrid TItem="PackProjectBuildResource" Items="builds">
                <Header><tr><th>@T("Version")</th><th>@T("Revision")</th><th>@T("Created")</th><th>@T("Artifact")</th><th></th></tr></Header>
                <Row Context="build"><tr class="@(selectedBuild?.Uid == build.Uid ? "selected-build" : null)">
                    <td><strong>@build.Definition.Version</strong></td>
                    <td>@build.Definition.ProjectRevision</td>
                    <td>@build.Definition.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td><code>@ShortHash(build.Definition.Artifact.Sha256)</code><br /><small>@FormatBytes(build.Definition.Artifact.Length)</small></td>
                    <td class="studio-action-cell"><div class="studio-actions"><button class="text-button" @onclick="() => PreviewAsync(build)">@T("Preview")</button><a class="text-button" href="@DownloadPath(build)">@T("Download")</a></div></td>
                </tr></Row>
            </DataGrid>
        }
    </section>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private readonly CancellationTokenSource cancellation = new();
    private ResourceSnapshot<PackProjectResource>? project;
    private IReadOnlyList<PackProjectBuildResource>? builds;
    private IReadOnlyList<PackProjectSourceDocument>? sourceDocuments;
    private PackProjectSourceDocument? selectedSource;
    private PackAgentDefinitionForm? agentSourceForm;
    private SourceView sourceView;
    private string sourceYaml = string.Empty;
    private PackProjectBuildResource? selectedBuild;
    private PackInstallationPreview? preview;
    private IReadOnlyList<ModelProfileSummaryResponse> modelProfiles = [];
    private IReadOnlyList<ModelProviderResponse> modelProviders = [];
    private IReadOnlyList<RuntimeProfileSummaryResponse> runtimeProfiles = [];
    private IReadOnlyList<ExtensionRegistrationResource> extensionRegistrations = [];
    private IReadOnlyList<SecretResponse> secrets = [];
    private readonly Dictionary<string, string> bindingSelections = new(StringComparer.Ordinal);
    private AgentstrationApiException? error;
    private string version = string.Empty;
    private PackAudience audience = PackAudience.Universal;
    private PackPurpose purpose = PackPurpose.Standard;
    private string displayName = string.Empty;
    private string? description;
    private string categories = string.Empty;
    private string tags = string.Empty;
    private string? message;
    private bool hasError;
    private bool dirty;
    private bool busy;
    private bool building;
    private bool installing;
    private bool replaceExisting;
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    private bool CanInstall => preview is not null
        && (preview.CanInstall || replaceExisting && preview.AlreadyInstalled)
        && preview.Bindings.All(binding => !binding.Required || !string.IsNullOrWhiteSpace(SelectedBinding(binding.Name)));
    private string PreviewStatus => preview is null ? T("NotPreviewed")
        : preview.Bindings.Any(binding => binding.Required && string.IsNullOrWhiteSpace(SelectedBinding(binding.Name))) ? T("ConfigurationRequired")
        : preview.CanInstall ? T("Ready")
        : preview.AlreadyInstalled ? T("AlreadyInstalled")
        : T("Conflicts");
    private UiStatus ProjectTone => project?.Value.Definition.State == PackProjectState.Built ? UiStatus.Success : UiStatus.Info;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        error = null;
        try
        {
            if (ContextState.Current is null) await ContextState.LoadAsync(cancellation.Token);
            project = await Client.GetProjectAsync(ProjectId, cancellation.Token);
            builds = await Client.GetBuildsAsync(ProjectId, cancellation.Token);
            sourceDocuments = await Client.GetProjectResourcesAsync(ProjectId, cancellation.Token);
            var definition = project.Value.Definition;
            version = definition.Version;
            audience = definition.Audience;
            purpose = definition.Purpose;
            displayName = definition.DisplayName ?? string.Empty;
            description = definition.Description;
            categories = string.Join(", ", definition.Categories);
            tags = string.Join(", ", definition.Tags);
            dirty = false;
        }
        catch (AgentstrationApiException exception) { error = exception; }
    }

    private void MarkDirty() { dirty = true; message = null; preview = null; selectedBuild = null; bindingSelections.Clear(); }
    private static bool CanUseForm(PackProjectSourceDocument source) => string.Equals(source.Kind, ResourceKinds.Agent, StringComparison.Ordinal);
    private void SelectSource(PackProjectSourceDocument source, SourceView view) { selectedSource = source; sourceYaml = source.Source; sourceView = view; message = null; agentSourceForm = null; }
    private void CloseSource() { selectedSource = null; sourceYaml = string.Empty; agentSourceForm = null; }
    private async Task SaveSourceAsync()
    {
        if (project is null || selectedSource is null) return;
        if (sourceView == SourceView.Form && agentSourceForm is not null && !agentSourceForm.TryBuildSource(out sourceYaml, out var formError))
        {
            hasError = true;
            message = formError;
            return;
        }
        var path = selectedSource.Path;
        await ExecuteAsync(async () =>
        {
            project = await Client.UpdateProjectResourceAsync(ProjectId, new(path, sourceYaml), project.ETag, cancellation.Token);
            sourceDocuments = await Client.GetProjectResourcesAsync(ProjectId, cancellation.Token);
            selectedSource = sourceDocuments.Single(resource => string.Equals(resource.Path, path, StringComparison.Ordinal));
            sourceYaml = selectedSource.Source;
            agentSourceForm = null;
            builds = await Client.GetBuildsAsync(ProjectId, cancellation.Token);
            preview = null; selectedBuild = null; dirty = false;
            message = $"Saved {selectedSource.Kind}/{selectedSource.Name} in Pack Project revision {project.Value.Definition.Revision}.";
        });
    }
    private async Task SaveAsync()
    {
        if (project is null) return;
        await ExecuteAsync(async () =>
        {
            project = await Client.UpdateProjectAsync(ProjectId,
                new(version.Trim(), EmptyToNull(displayName), EmptyToNull(description), Split(categories), Split(tags), audience, purpose), project.ETag, cancellation.Token);
            dirty = false;
            message = T("ProjectSaved");
        });
    }

    private async Task BuildAsync()
    {
        building = true;
        try
        {
            if (dirty) await SaveAsync();
            if (hasError) return;
            await ExecuteAsync(async () =>
            {
                selectedBuild = await Client.BuildAsync(ProjectId, cancellation.Token);
                builds = await Client.GetBuildsAsync(ProjectId, cancellation.Token);
                project = await Client.GetProjectAsync(ProjectId, cancellation.Token);
                preview = await Client.PreviewBuildAsync(ProjectId, selectedBuild.Uid, cancellation.Token);
                await ConfigureBindingsAsync();
                replaceExisting = false;
                message = PreviewMessage(selectedBuild.Definition.Version);
            });
        }
        finally { building = false; }
    }

    private async Task PreviewAsync(PackProjectBuildResource build)
    {
        selectedBuild = build;
        replaceExisting = false;
        await ExecuteAsync(async () =>
        {
            preview = await Client.PreviewBuildAsync(ProjectId, build.Uid, cancellation.Token);
            await ConfigureBindingsAsync();
            message = PreviewMessage(build.Definition.Version);
        });
    }

    private async Task InstallAsync()
    {
        if (selectedBuild is null || !CanInstall) return;
        installing = true;
        try
        {
            await ExecuteAsync(async () =>
            {
                var bindings = preview!.Bindings
                    .Where(binding => !string.IsNullOrWhiteSpace(SelectedBinding(binding.Name)))
                    .Select(binding => new PackBindingSelection(binding.Name, ParseBindingTarget(SelectedBinding(binding.Name)!)))
                    .ToArray();
                var installed = await Client.InstallBuildAsync(ProjectId, selectedBuild.Uid, replaceExisting, bindings, cancellation.Token);
                preview = await Client.PreviewBuildAsync(ProjectId, selectedBuild.Uid, cancellation.Token);
                await ConfigureBindingsAsync();
                replaceExisting = false;
                message = T("PackInstalled", installed.Value.Definition.Publisher, installed.Value.Definition.PackName);
            });
        }
        finally { installing = false; }
    }

    private async Task ExecuteAsync(Func<Task> operation)
    {
        busy = true;
        hasError = false;
        message = null;
        try { await operation(); }
        catch (AgentstrationApiException exception) { hasError = true; message = exception.Message; }
        finally { busy = false; }
    }

    private enum SourceView { Form, Yaml }

    private string DownloadPath(PackProjectBuildResource build) => $"/api/pack-projects/{ProjectId:D}/builds/{build.Uid:D}/download";
    private async Task ConfigureBindingsAsync()
    {
        bindingSelections.Clear();
        if (preview is null || preview.Bindings.Count == 0) return;
        foreach (var binding in preview.Bindings)
        {
            if (binding.TargetAvailable && binding.Target is not null)
                bindingSelections[binding.Name] = BindingValue(binding.Target.Name, binding.Target.Namespace ?? ResourceNamespace.Default);
        }
        if (preview.Bindings.Any(binding => binding.TargetKind == PackBindingTargetKind.ModelProfile))
            modelProfiles = await Services.GetRequiredService<IModelProfilesClient>().GetModelProfilesAsync(null, null, null, cancellation.Token);
        if (preview.Bindings.Any(binding => binding.TargetKind == PackBindingTargetKind.ModelProvider))
            modelProviders = await Services.GetRequiredService<IModelProvidersClient>().GetModelProvidersAsync(cancellation.Token);
        if (preview.Bindings.Any(binding => binding.TargetKind == PackBindingTargetKind.RuntimeProfile))
            runtimeProfiles = await Services.GetRequiredService<IRuntimeProfilesClient>().GetRuntimeProfilesAsync(cancellation.Token);
        if (preview.Bindings.Any(binding => binding.TargetKind == PackBindingTargetKind.ExtensionRegistration))
            extensionRegistrations = await Services.GetRequiredService<IExtensionsClient>().GetRegistrationsAsync(cancellation.Token);
        if (preview.Bindings.Any(binding => binding.TargetKind == PackBindingTargetKind.Secret))
            secrets = await Services.GetRequiredService<ISecretsClient>().GetSecretsAsync(cancellation.Token);
    }
    private string? SelectedBinding(string name) => bindingSelections.GetValueOrDefault(name);
    private void BindingChanged(string name, ChangeEventArgs args) => bindingSelections[name] = args.Value?.ToString() ?? string.Empty;
    private static string BindingValue(string name, ResourceNamespace @namespace) => $"{@namespace.Value}:{name}";
    private ResourceReference ParseBindingTarget(string value)
    {
        var parts = value.Split(':', 2);
        if (parts.Length != 2) throw new InvalidOperationException(T("InvalidPackBinding"));
        return new(parts[1], @namespace: ResourceNamespace.Parse(parts[0]));
    }
    private string BindingKindLabel(PackBindingTargetKind kind) => kind switch
    {
        PackBindingTargetKind.Secret => T("Binding.Secret"),
        PackBindingTargetKind.ModelProvider => T("Binding.ModelProvider"),
        PackBindingTargetKind.RuntimeProfile => T("Binding.RuntimeProfile"),
        PackBindingTargetKind.ExtensionRegistration => T("Binding.ExtensionRegistration"),
        _ => T("Binding.ModelProfile")
    };
    private string PreviewMessage(string buildVersion) => preview?.CanInstall == true
        ? T("BuildReadyForWorkspace", buildVersion)
        : preview?.AlreadyInstalled == true
            ? T("BuildAlreadyInstalled", buildVersion)
            : T("BuildConflicts", buildVersion, preview?.Namespace.ToString() ?? string.Empty);
    private void BackToPacks() => Navigation.NavigateTo("/packs");
    private static string? EmptyToNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static IReadOnlyList<string> Split(string value) => value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct(StringComparer.OrdinalIgnoreCase).ToArray();
    private static string ShortHash(string hash) => hash.Length <= 16 ? hash : $"{hash[..12]}…{hash[^4..]}";
    private static string FormatBytes(long bytes) => bytes < 1024 ? $"{bytes} B" : $"{bytes / 1024d:F1} KB";

    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
