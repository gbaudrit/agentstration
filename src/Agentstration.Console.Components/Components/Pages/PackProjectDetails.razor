@page "/pack-projects/{ProjectId:guid}"
@implements IDisposable
@inject IPacksClient Client
@inject ConsoleContextState ContextState
@inject IServiceProvider Services
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<PackStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared

<PageTitle>@Title · Agentstration</PageTitle>
@{ var presentations = Presentations; var callbackIdentity = Identity; }
<ConsoleResourceDetailsTemplate Resource="project?.Value" Name="@Title" ResourceType="@T("PackProject")" IconName="package" Domain="package"
    CollectionHref="@BackUrl" CollectionLabel="@T("Packs")"
    ResourceIdentity="@(loadedKey ?? ProjectId.ToString("D"))" SectionState="sectionState" SectionPresentations="presentations" AdditionalSections="AdditionalSections"
    Description="@project?.Value.Definition.Description" StatusText="@(project is null ? null : ProjectStatus)" Status="ProjectTone"
    DefinitionReadOnlyReason="ReadOnlyReason" AllowAccess="OwnScope" LoadState="loadState" OnRetry="RefreshAsync" OnRefresh="RefreshAsync" Busy="busy"
    HasDraft="HasMetadataDraft" HasAdditionalDraft="HasAdditionalDraft" Yaml="@PublicYaml" YamlReadOnly YamlDescription="@T("Project.YamlHelp")"
    SectionTestIdPrefix="pack-project" TestId="distribution-pack-project-details">
    <PrimaryActions>@if (CanAuthor) { <button type="button" class="button-primary" disabled="@busy" @onclick="BuildAsync" data-testid="pack-project-build">@T(building ? "Building" : "BuildPack")</button> }</PrimaryActions>
    <Feedback>
        @if (message is not null) { <p class="form-alert @(hasError ? "form-alert-danger" : "form-alert-success")" role="@(hasError ? "alert" : "status")" data-testid="pack-project-status" data-state="@(hasError ? "error" : "success")">@message</p> }
        @if (newerBundle is not null) { <div class="form-alert form-alert-warning" role="status">@T("Project.RefreshDraftConflict") <button type="button" class="button-secondary" disabled="@busy" @onclick="DiscardResourceDraftsAsync">@T("Project.DiscardResourceDrafts")</button></div> }
    </Feedback>
    <OverviewMetrics><MetricCard Label="@T("Revision")" Value="@(project?.Value.Definition.Revision.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—")" /><MetricCard Label="@T("Project.Generation")" Value="@(project?.Value.Generation.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—")" /><MetricCard Label="@T("Builds")" Value="@(builds?.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—")" /><MetricCard Label="@T("PackResources")" Value="@(sourceDocuments?.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—")" /></OverviewMetrics>
    <IdentityDetails>@if (project is { Value.Definition: var definition }) { <dt>@T("Publisher")</dt><dd>@definition.Publisher</dd><dt>@T("PackIdentity")</dt><dd>@definition.PackName</dd> }</IdentityDetails>
    <OverviewSummary Context="identity">@if (project is not null) { <PackProjectResourceSummary Resource="project.Value" Identity="identity" /> }</OverviewSummary>
    <DefinitionContent Context="path">
        <ResourceDefinitionForm @key="metadataContext" @ref="definitionForm" Id="@formId" EditContext="metadataContext" FieldLabels="FieldLabels" Sections="presentations" SectionState="sectionState" SectionContent="MetadataSection" SectionRequested="ShowSection"
            ReadOnly="@(!CanAuthor)" Busy="commandBusy" OnValidSubmit="SaveAsync" InvalidInputChanged="value => invalidMetadata = value" data-testid="pack-project-form" />
    </DefinitionContent>
    <AdditionalContent Context="path">@if (path == "sources") { @SourcesPanel } else if (path == "builds") { @BuildsPanel } else if (path == "installation") { @InstallationPanel }</AdditionalContent>
    <DraftActions><button type="button" class="button-secondary" disabled="@busy" @onclick="DiscardMetadataAsync">@Shared["Discard"]</button><button type="submit" class="button-primary" form="@formId" disabled="@(busy || !CanAuthor)" data-testid="pack-project-save">@T("Save")</button></DraftActions>
</ConsoleResourceDetailsTemplate>

@code {
    private RenderFragment MetadataSection(string path) => path == "definition/identity" ? IdentityFields : ConfigurationFields;
    private RenderFragment IdentityFields => @<ResourceIdentityEditor ResourceKind="@PackAuthoringKinds.PackProject" IsNew="false" ReadOnly="@(!CanAuthor)"
        DisplayName="@model.DisplayName" DisplayNameChanged="value => model.DisplayName = value" DisplayNameExpression="@(() => model.DisplayName)"
        TechnicalName="@model.ResourceName" TechnicalNameExpression="@(() => model.ResourceName)" Namespace="@model.Namespace" NamespaceExpression="@(() => model.Namespace)"
        ScopeRef="model.ScopeRef" Description="@model.Description" DescriptionChanged="value => model.Description = value" DescriptionExpression="@(() => model.Description)"
        Labels="@model.MetadataTags" LabelsExpression="@(() => model.MetadataTags)" LabelsReadOnly DisplayNameTestId="pack-project-display-name" TestId="pack-project-identity">
        <ScopeContent><ResourceScopeBadge ScopeRef="model.ScopeRef" /></ScopeContent>
        <AdditionalPanels><FormSection Title="@T("PackIdentity")"><FormGrid><FormField Label="@T("Publisher")"><code>@model.Publisher</code></FormField><FormField Label="@T("TechnicalName")"><code>@model.PackName</code></FormField></FormGrid></FormSection></AdditionalPanels>
    </ResourceIdentityEditor>;
    private RenderFragment ConfigurationFields => @<FormSection Title="@T("ManifestMetadata")"><FormGrid>
        <FormField Label="@T("Version")" Required><ChildContent><ClearableText @bind-Value="model.Version" data-testid="pack-project-version" /></ChildContent><Validation><ValidationMessage For="() => model.Version" /></Validation></FormField>
        <FormField Label="@T("Audience")"><ChildContent><ClearableSelect @bind-Value="model.Audience">@foreach (var value in Enum.GetValues<PackAudience>()) { <option value="@value">@T($"Audience.{value}")</option> }</ClearableSelect></ChildContent><Validation><ValidationMessage For="() => model.Audience" /></Validation></FormField>
        <FormField Label="@T("Purpose")"><ChildContent><ClearableSelect @bind-Value="model.Purpose">@foreach (var value in Enum.GetValues<PackPurpose>()) { <option value="@value">@T($"Purpose.{value}")</option> }</ClearableSelect></ChildContent><Validation><ValidationMessage For="() => model.Purpose" /></Validation></FormField>
        <FormField Label="@T("Categories")"><ClearableText @bind-Value="model.Categories" /></FormField><FormField Label="@T("Tags")"><ClearableText @bind-Value="model.ManifestTags" /></FormField>
    </FormGrid></FormSection>;
    private RenderFragment SourcesPanel => @<FormSection Title="@T("PackResources")" Description="@T("PackResourcesHelp")" TestId="pack-source-resources">
        @if (sourceDocuments is null) { <p>@T("Project.SourcesUnavailable")</p> }
        else if (sourceDocuments.Count == 0) { <EmptyState Title="@T("NoSourceResource")" Message="@T("NoSourceResourceHelp")" /> }
        else { <CollectionView TItem="PackProjectSourceDocument" Items="sourceDocuments" IdentityLabel="@T("PackResources")" InformationLabels="@(new[] { T("Project.SourcePath") })"><Identity Context="document"><strong>@document.Kind/@document.Name</strong></Identity><Information Context="document"><CollectionValue Label="@T("Project.SourcePath")"><CopyableValue Value="@document.Path" />@if (sourceEditors.TryGetValue(document.Path, out var retained) && retained.Component?.IsDirty == true) { <StatusBadge Text="@T("Project.SourceUnsaved")" Status="UiStatus.Warning" /> }</CollectionValue></Information><Actions Context="document">@if (document.Kind == AgentResourceKinds.Agent) { <button type="button" class="text-button" @onclick="() => SelectSourceAsync(document, true)">@T("Form")</button> }<button type="button" class="text-button" @onclick="() => SelectSourceAsync(document, false)">@T("Yaml")</button></Actions></CollectionView> }
        @foreach (var entry in sourceEditors.Values.ToArray()) { var identity = Identity; <div @key="entry.Document.Path" hidden="@(activeSourcePath != entry.Document.Path)"><PackProjectSourceEditor @ref="entry.Component" Document="entry.Document" InitialForm="entry.InitialForm" ReadOnly="@(!CanAuthor)" Busy="commandBusy" DraftChanged="value => SourceDirtyChanged(identity)" SaveRequested="command => SaveSourceAsync(identity, command)" Hide="() => activeSourcePath = null" /></div> }
    </FormSection>;
    private RenderFragment BuildsPanel => @<div>    <section class="panel studio-builds">
        <div class="panel-header"><div><p class="eyebrow">@T("ImmutableArtifacts")</p><h2>@T("Builds")</h2></div><span class="studio-hint">@T("Builds.Description")</span></div>
        @if (builds is null)
        {
            <p>@T("Project.BuildsUnavailable")</p>
        }
        else if (builds.Count == 0)
        {
            <EmptyState Title="@T("NoBuildYet")" Message="@T("NoBuildYetMessage")" />
        }
        else
        {
            <CollectionView TItem="PackProjectBuildResource" Items="builds" InformationLabels="@(new string[] { T("Revision"), T("Created"), T("Artifact") })" ItemAttributes="@((build) => new Dictionary<string, object> { ["class"] = selectedBuild?.Uid == build.Uid ? "selected-build" : string.Empty })" IdentityLabel="@T("Version")">
        <Identity Context="build">
<CollectionIdentity DisplayName="@build.Definition.Version" Namespace="@build.Namespace.Value" Name="@build.Name" OnOpen="() => PreviewAsync(build)" IconName="package" ><IconBadges><ResourceScopeBadge ScopeRef="build.ScopeRef" IconOnly /><ManagedResourceBadge IsReadOnly="@(!ResourceOwnershipContext.CanManage(build.ScopeRef, Services))" IconOnly /></IconBadges></CollectionIdentity></Identity>
        <Information Context="build">
            <CollectionValue Label="@T("Revision")">@build.Definition.ProjectRevision</CollectionValue>
            <CollectionValue Label="@T("Created")">@build.Definition.CreatedAt.ToLocalTime().ToString("g")</CollectionValue>
            <CollectionValue Label="@T("Artifact")"><code>@ShortHash(build.Definition.Artifact.Sha256)</code><br /><small>@FormatBytes(build.Definition.Artifact.Length)</small></CollectionValue>
        </Information>
        <Actions Context="build">
<CollectionActions ResourceName="@(build.Definition.Version)"><div class="studio-actions"><button type="button" class="text-button" disabled="@busy" @onclick="() => PreviewAsync(build)">@T("Preview")</button><a class="text-button" href="@DownloadPath(build)">@T("Download")</a></div></CollectionActions></Actions>
    </CollectionView>
        }
    </section></div>;
    private RenderFragment InstallationPanel => @<div>        <aside class="panel">
            <div class="panel-header"><div><p class="eyebrow">@T("LocalDeployment")</p><h2>@T("Project.InstallTarget")</h2></div></div>
            <ResourceScopeBadge ScopeRef="CurrentScope" />
            @if (preview is not null) { <p class="studio-namespace"><span>@T("Namespace")</span><code data-testid="pack-project-namespace">@preview.Namespace</code></p> }
            <p class="studio-hint">@T("StoredBuildHelp")</p>
            @if (selectedBuild is null)
            {
                <div class="studio-empty-preview"><span>1</span><p>@T("PreviewBuildHelp")</p></div>
            }
            else if (preview is not null)
            {
                <div class="studio-selected-build"><span>@T("SelectedBuild")</span><strong>@selectedBuild.Definition.Version</strong><code>@ShortHash(selectedBuild.Definition.Artifact.Sha256)</code></div>
                <div class="studio-preview">
                    <StatusBadge Text="@PreviewStatus" Status="@(CanInstall ? UiStatus.Success : UiStatus.Warning)" />
                    <span>@T("ResourceConflictCount", preview.Resources.Count, preview.Resources.Count(resource => resource.AlreadyExists))</span>
                </div>
                @if (preview.Bindings.Count > 0)
                {
                    <section class="studio-bindings" aria-label="@T("PackResourceBindings")">
                        <div><strong>@T("ResourceBindings")</strong><small>@T("BindingsRetained")</small></div>
                        @foreach (var binding in preview.Bindings)
                        {
                            <FormField Label="@BindingKindLabel(binding.TargetKind)"><LabelContent>@binding.DisplayName <small>@(binding.Required ? T("Required") : T("Optional")) · @BindingKindLabel(binding.TargetKind)</small></LabelContent><ChildContent><ClearableSelect TValue="string" Value="@Convert.ToString(SelectedBinding(binding.Name), System.Globalization.CultureInfo.InvariantCulture)" ValueChanged="changed => BindingChanged(binding.Name, new ChangeEventArgs { Value = changed })" disabled="@(commandBusy || !CanInstallPermission)">
                                    <option value="">@T("SelectBinding", BindingKindLabel(binding.TargetKind).ToLowerInvariant())</option>
                                    @if (SelectedBinding(binding.Name) is { Length: > 0 } retained && !BindingOptions(binding.TargetKind).Contains(retained, StringComparer.Ordinal)) { <option value="@retained" disabled>@T("Project.RetainedBindingReference") · @retained</option> }
                                    @if (binding.TargetKind == PackBindingTargetKind.ModelProfile)
                                    {
                                        @foreach (var profile in modelProfiles)
                                        {
                                            <option value="@BindingValue(profile.Name, ResourceNamespace.Parse(profile.Namespace), profile.ScopeRef)">@profile.Properties.DisplayName — @profile.Namespace/@profile.Name</option>
                                        }
                                    }
                                    else if (binding.TargetKind == PackBindingTargetKind.ModelProvider)
                                    {
                                        @foreach (var provider in modelProviders)
                                        {
                                            <option value="@BindingValue(provider.Name, ResourceNamespace.Parse(provider.Namespace), provider.ScopeRef)">@provider.Properties.DisplayName — @provider.Namespace/@provider.Name</option>
                                        }
                                    }
                                    else if (binding.TargetKind == PackBindingTargetKind.RuntimeProfile)
                                    {
                                        @foreach (var runtimeProfile in runtimeProfiles)
                                        {
                                            <option value="@BindingValue(runtimeProfile.Name, ResourceNamespace.Parse(runtimeProfile.Namespace), runtimeProfile.ScopeRef)">@runtimeProfile.Properties.DisplayName — @runtimeProfile.Namespace/@runtimeProfile.Name</option>
                                        }
                                    }
                                    else if (binding.TargetKind == PackBindingTargetKind.ExtensionRegistration)
                                    {
                                        @foreach (var extension in extensionRegistrations)
                                        {
                                            <option value="@BindingValue(extension.Name, extension.Namespace, extension.ScopeRef)">@extension.Definition.DisplayName — @extension.Namespace/@extension.Name</option>
                                        }
                                    }
                                    else if (binding.TargetKind == PackBindingTargetKind.Parameter)
                                    {
                                        @foreach (var parameter in parameters)
                                        {
                                            <option value="@BindingValue(parameter)">@parameter.Definition.DisplayName — @parameter.ScopeRef/@parameter.Namespace/@parameter.Name</option>
                                        }
                                    }
                                    else
                                    {
                                        @foreach (var secret in secrets)
                                        {
                                            <option value="@BindingValue(secret.Resource.Name, secret.Resource.Namespace, secret.Resource.ScopeRef)">@secret.Resource.Definition.DisplayName — @secret.Resource.Name (@T($"SecretStatus.{secret.ValueStatus}"))</option>
                                        }
                                    }
                                </ClearableSelect>
                            </ChildContent></FormField>
                        }
                    </section>
                }
                @if (preview.AlreadyInstalled)
                {
                    <label class="resource-enabled-toggle"><FormCheckbox role="switch" @bind-Value="replaceExisting" disabled="@(commandBusy || !CanInstallPermission)" /><span>@T("ReinstallPackBuild")</span></label>
                    <p class="studio-warning">@T("ModifiedResourcesPreserved")</p>
                }
            }
            @if (InstallationDirty) { <button type="button" class="button-secondary" disabled="@busy" @onclick="DiscardInstallation">@Shared["Discard"]</button> }
            <button class="button-primary" data-testid="pack-project-install" disabled="@(selectedBuild is null || busy || !CanInstall)" @onclick="InstallAsync">@(installing ? T("Installing") : T("InstallLocally"))</button>
        </aside></div>;
}
