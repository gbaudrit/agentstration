@page "/agents/new"
@page "/agents/{Name}"
@implements IDisposable
@inject IManagementApiClient Client
@inject IAgentsModelClient AgentsModelClient
@inject IAgentRunnerRuntimeClient RuntimeClient
@inject IRuntimeProfilesClient RuntimeProfilesClient
@inject IToolsClient ToolsClient
@inject IToolCategoriesClient ToolCategoriesClient
@inject IToolSetsClient ToolSetsClient
@inject NavigationManager Navigation
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@inject NotificationState Notifications
@inject Microsoft.Extensions.Localization.IStringLocalizer<AgentEditorStrings> Localizer

<UnsavedNavigationGuard IsDirty="@isDirty" HasUnsavedChanges="@(() => isDirty)" />
<PageTitle>@(IsNew ? T("CreateAgent") : Name) · Agentstration</PageTitle>

@if (IsNew)
{
    <PageHeader Eyebrow="@T("Agent")" Title="@T("CreateAgent")" Description="@T("CreateDescription")">
        <Actions><a class="button-secondary" href="/agents">@T("BackToAgents")</a></Actions>
    </PageHeader>
}

@if (loading || model is null)
{
    <LoadingState Message="@T("Loading")" />
}
else
{
    @if (!IsNew)
    {
        <ResourceHeader ResourceType="@T("Agent")" Domain="agent" Icon="◎" Name="@(savedResource?.Definition.DisplayName ?? model.DisplayName)" Description="@(savedResource?.Definition.Description ?? model.Description)" StatusText="@HeaderStatus" Status="@HeaderStatusTone">
            <Metadata><CopyableValue Value="@model.Name" /><ResourceScopeBadge ScopeRef="selectedScope" Compact /><span>@T("Generation", generation)</span></Metadata>
            <PrimaryActions>@if (AgentResourceNamespace.IsDefault) { <a class="button-primary" href="@RunUrl">@T("Run")</a> }</PrimaryActions>
            <Actions>@if (CanManage) { <button class="button-secondary" type="button" @onclick="ReconcileAsync" disabled="@(saving || isDirty)" title="@(isDirty ? T("SaveBeforeApply") : null)">@T("ReconcileDeployment")</button> }@if (SafeReturnUrl is { } returnUrl) { <a class="button-secondary" href="@returnUrl" data-testid="agent-context-return">@T("ReturnToSource")</a> }</Actions>
        </ResourceHeader>
        @if (selectedScope is { } inheritedOwner) { <InheritedResourceNotice OwnerScopeRef="inheritedOwner" /> }
        <ResourcePageTabs Items="PageTabs" Value="@CurrentPage" ValueChanged="SelectPage" PanelId="agent-page-panel" IdPrefix="agent-page" Label="@T("AgentSections")" />


    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="form-alert form-alert-danger" role="alert"><strong>@T("UnableToApply")</strong><span>@errorMessage</span>@if (!string.IsNullOrWhiteSpace(errorId)) { <code>@errorId</code> }</div>
    }
    <PageNotification Message="@successMessage" OnDismiss="() => successMessage = null" />
    @if (!IsNew && !overviewMode && !accessMode && !IsStateSynchronized && !isDirty)
    {
        <div class="form-alert form-alert-warning" role="status">@T("CurrentGenerationNotActive")</div>
    }
    @if (HasRawDraft && !sourceMode)
    {
        <div class="form-alert form-alert-warning" role="status"><span>@Shared["YamlConflict"]</span><button class="text-button" type="button" @onclick="ShowSource">@T("Yaml")</button><button class="text-button" type="button" @onclick="DiscardRawDraft">@Shared["DiscardYaml"]</button></div>
    }
    @if (IsNew)
    {
        <ResourceTabs Label="@T("AgentEditorMode")"><button type="button" class="@(!sourceMode && !toolsMode && !contractsMode ? "active" : null)" @onclick="ShowDefinition">@T("Form")</button><button type="button" class="@(contractsMode ? "active" : null)" data-testid="agent-contracts-tab" @onclick="ShowContracts">@T("Contracts")</button><button type="button" class="@(toolsMode ? "active" : null)" data-testid="agent-tools-tab" @onclick="ShowTools">@T("Tools")</button><button type="button" class="@(sourceMode ? "active" : null)" data-testid="agent-source-tab" @onclick="ShowSource">@T("Yaml")</button></ResourceTabs>
    }

    <div id="agent-page-panel" role="@(!IsNew ? "tabpanel" : null)" aria-labelledby="@(!IsNew ? "agent-page-" + CurrentPage : null)">
    @if (!IsNew && overviewMode && savedResource is not null)
    {
        <div class="resource-overview" data-testid="agent-overview">
        <StateComparison DesiredGeneration="@generation" ActiveGeneration="@ActiveGeneration" DesiredStatus="@(isDirty ? T("ModifiedNotSaved") : T("SavedDefinition"))" ActiveStatus="@ActiveStatus" RuntimeLabel="@ActiveRuntime" IsSynchronized="@IsStateSynchronized" Summary="@StateSummary">
                <Actions>@if (CanManage && !IsStateSynchronized && !isDirty) { <button class="button-secondary" type="button" @onclick="ReconcileAsync" disabled="@saving">@T("ApplyGeneration")</button> }</Actions>
        </StateComparison>
        @if (activeRevision?.Definition.ToolSetAssignments.Count > 0)
        {
            <section class="panel form-section" data-testid="agent-active-toolsets">
                <div class="panel-header"><div><p class="eyebrow">@T("ActiveRevision")</p><h2>@T("PinnedToolSetAssignments")</h2><p>@T("PinnedToolSetAssignmentsHelp")</p></div><code>@activeRevision.Metadata.Name</code></div>
                <div class="table-shell"><table class="resource-table"><thead><tr><th>@T("ToolSet")</th><th>@T("Version")</th><th>@T("DefinitionHash")</th><th>@T("EffectiveMembers")</th></tr></thead><tbody>
                @foreach (var assignment in activeRevision.Definition.ToolSetAssignments.OrderBy(value => value.ToolSetName, StringComparer.Ordinal))
                {
                    <tr><td><code>@assignment.ToolSetNamespace/@assignment.ToolSetName</code></td><td><code>@assignment.Version</code></td><td><code>@assignment.DefinitionHash</code></td><td>@string.Join(", ", assignment.Members)</td></tr>
                }
                </tbody></table></div>
            </section>
        }
        <ResourceIdentitySummary DisplayName="@savedResource.Definition.DisplayName" TechnicalName="@savedResource.Name" Description="@savedResource.Definition.Description" Namespace="@savedResource.Namespace.Value">
            <Scope><ResourceScopeBadge ScopeRef="savedResource.ScopeRef" /></Scope>
        </ResourceIdentitySummary>
        <FormSection Title="@T("Behavior")"><dl class="resource-details">
            <dt>@T("Handler")</dt><dd>@savedResource.Definition.Handler</dd>
            <dt>@T("Instructions")</dt><dd class="resource-text">@savedResource.Definition.Instructions</dd>
        </dl></FormSection>
            <section class="panel form-section">
                <div class="panel-header"><div><h2>@T("DeclaredAndResolved")</h2></div>@if (agentModel is not null) { <StatusBadge Text="@ModelStatusLabel(agentModel.Status)" Status="@ModelManagementUi.Status(agentModel.Status)" /> }</div>
                <div class="declaration-resolution-grid">
                    <article><h3>@T("DeclaredConfiguration")</h3><dl class="resource-details"><dt>@T("ModelProfile")</dt><dd>@(agentModel?.Declared.ModelProfile.DisplayName ?? savedResource.Definition.ModelProfile.Name)</dd><dt>@T("Name")</dt><dd><code>@savedResource.Definition.ModelProfile.Name</code></dd></dl>@if (agentModel is not null) { <a class="text-button" href="@ProfileUrl(agentModel)">@T("OpenModelProfile") →</a> }</article>
                    <article><h3>@T("ResolvedConfiguration")</h3>@if (agentModel is null) { <p class="inline-warning">@modelResolutionWarning</p> } else { <dl class="resource-details"><dt>@T("Provider")</dt><dd>@(agentModel.Resolved.Provider?.DisplayName ?? agentModel.Resolved.Provider?.Name ?? T("NotResolved"))</dd><dt>@T("Contribution")</dt><dd>@(agentModel.Resolved.Provider?.ContributionId ?? T("NotResolved"))</dd><dt>@T("Model")</dt><dd><code>@agentModel.Resolved.Model.Name</code></dd><dt>@T("Status")</dt><dd>@ModelStatusLabel(agentModel.Status)</dd></dl>@if (agentModel.Resolved.Provider is not null) { <a class="text-button" href="@ProviderUrl(agentModel)">@T("OpenProvider") →</a> }}</article>
                </div>
            </section>

        <FormSection Title="@T("Execution")"><dl class="resource-details"><dt>@T("RuntimeProfile")</dt><dd><code>@savedResource.Definition.RuntimeProfile.ScopeRef · @(savedResource.Definition.RuntimeProfile.Namespace ?? savedResource.Namespace)/@savedResource.Definition.RuntimeProfile.Name</code></dd></dl></FormSection>
        <FormSection Title="@T("Tags")"><LabelsSummary Values="@savedResource.Metadata.Tags" /></FormSection>
        </div>
    }
    else if (CanManage && accessMode && selectedScope is { } ownerScope)
    {
        <ResourceAccessPanel OwnerScopeRef="ownerScope" Namespace="AgentResourceNamespace" Kind="@AgentResourceKinds.Agent" Name="@model.Name" Generation="generation" Governance="governance" />
    }
    else if (sourceMode)
    {
        <section class="panel form-section" data-testid="agent-yaml-editor">
            <div class="panel-header"><div><p class="eyebrow">@T("RawResource")</p><h2>@T("AgentYaml")</h2><p>@T("AgentYamlHelp")</p></div></div>
            @if (!string.IsNullOrWhiteSpace(rawError)) { <div class="form-alert form-alert-danger" role="alert">@rawError</div> }
            @if (invalidInput || rawUsesSavedDefinition)
            {
                <div class="form-alert form-alert-info" role="status" data-testid="agent-yaml-form-warning"><span>@T("YamlFormInvalid")</span><button type="button" class="text-button" @onclick="ShowDefinition">@Shared["Edit"]</button></div>
            }
            <label class="agent-yaml-field"><span>@T("ResourceManifest")</span><textarea class="form-code-editor runner-json" rows="28" @bind="rawYaml" @bind:event="oninput" readonly="@(!CanEditRaw)" disabled="@saving"></textarea></label>
            @if (CanManage) { <FormActions Busy="@saving"><button class="button-secondary" type="button" @onclick="() => { ApplyRawYaml(); }" disabled="@(saving || !CanEditRaw)">@T("ApplyToForm")</button><button class="button-primary" type="button" @onclick="SaveRawAsync" disabled="@(saving || !CanEditRaw)">@(saving ? T("Saving") : IsNew ? T("CreateFromYaml") : T("SaveYaml"))</button></FormActions> }
        </section>

    }
    @if (definitionVisited || toolsVisited || contractsVisited)
    {
    <div class="resource-editor-view" hidden="@(overviewMode || sourceMode || accessMode)">
    <EditForm @key="model" Model="model" OnValidSubmit="() => SaveAsync(applyRuntimeOnSubmit)" FormName="agent-editor" class="resource-form" data-testid="agent-editor-form" data-interactive="@(interactive ? "true" : "false")" @oninput="MarkDirty" @onchange="MarkDirty">
        <DataAnnotationsValidator /><FormDraftMonitor InvalidInputChanged="value => invalidInput = value" />
        <ValidationSummary />
        <fieldset class="resource-definition-fields" disabled="@(!CanManage || saving || HasRawDraft)" data-testid="agent-definition-fields">

        @if (toolsVisited)
        {
            <div class="resource-editor-view" hidden="@(!toolsMode)">
            <AgentToolSetConfiguration Versions="VisibleToolSetVersions" Selected="SelectedToolSets" SelectedChanged="UpdateSelectedToolSets" />
            <AgentToolConfiguration Tools="VisibleTools" Providers="VisibleProviders" Categories="VisibleCategories" SelectedToolIds="SelectedToolIds" ToolSetGrantedTools="ToolSetGrantedTools" SelectedToolIdsChanged="UpdateSelectedTools" />
            </div>
        }
        @if (contractsVisited)
        {
            <div class="resource-editor-view" hidden="@(!contractsMode)">
            <section class="panel form-section" data-testid="agent-contracts-section">
                <div class="panel-header"><div><p class="eyebrow">@T("Contracts")</p><h2>@T("InvocationContracts")</h2><p>@T("InvocationContractsHelp")</p></div></div>
                <ContractDirectionTabs Label="@T("InvocationContracts")" InputLabel="@T("InputContract")"
                    OutputLabel="@T("OutputContract")" TestId="agent-contract">
                    <InputContent>
                        <ReusableSchemaBindingEditor Title="@T("InputContract")" TestId="agent-input-schema"
                            Binding="model.InputSchemaBinding" LegacySchema="model.InputSchema" ValueChanged="UpdateAgentInputSchemaAsync" />
                    </InputContent>
                    <OutputContent>
                        <ReusableSchemaBindingEditor Title="@T("OutputContract")" TestId="agent-output-schema"
                            Binding="model.OutputSchemaBinding" LegacySchema="model.OutputSchema" ValueChanged="UpdateAgentOutputSchemaAsync" />
                    </OutputContent>
                </ContractDirectionTabs>
            </section>
            </div>
        }
        @if (definitionVisited)
        {
        <div class="resource-editor-view" hidden="@(toolsMode || contractsMode)">
        <section class="panel form-section" id="definition" data-testid="agent-identity-section">
            <div class="panel-header"><h2>@T("Identity")</h2></div>
            <FormGrid>
                <ResourceIdentityFields @bind-DisplayName="model.DisplayName" @bind-TechnicalName="model.Name" IsNew="@IsNew" DisplayNameTestId="agent-display-name" TechnicalNameTestId="agent-name" />
                <ResourceScopeFormField ResourceKind="@AgentResourceKinds.Agent" Value="@selectedScope" ValueChanged="ScopeChanged" Disabled="@(!IsNew)" />
                <FormField Optional="true" Label="@T("Description")" Class="form-span-2"><ChildContent><ClearableText Multiline @bind-Value="model.Description" rows="3" data-testid="agent-description" /></ChildContent><Validation><ValidationMessage For="() => model.Description" /></Validation></FormField>
            </FormGrid>
            @if (!string.IsNullOrWhiteSpace(resourceId)) { <p class="resource-hint">@T("Uid"): <code>@resourceId</code></p> }
        </section>

        <section class="panel form-section" data-testid="agent-behavior-section">
            <div class="panel-header"><h2>@T("Behavior")</h2></div>
            <FormGrid>
                <FormField Required="true" Label="@T("Handler")"><ChildContent><ClearableText @bind-Value="model.Handler" data-testid="agent-handler" /></ChildContent><Validation><ValidationMessage For="() => model.Handler" /></Validation></FormField>
                <FormField Required="true" Label="@T("Instructions")" Class="form-span-2"><ChildContent><ClearableText Multiline @bind-Value="model.Instructions" rows="6" data-testid="agent-instructions" /></ChildContent><Validation><ValidationMessage For="() => model.Instructions" /></Validation></FormField>
            </FormGrid>
        </section>


        <FormSection Title="@T("ModelConfiguration")" TestId="agent-model-section">
                <div class="form-span-2"><ModelProfilePicker Value="@model.ModelProfileName" Namespace="@model.ModelProfileNamespace" ScopeRef="@model.ModelProfileScopeRef" ValueChanged="ModelProfileChanged" SelectedChanged="ModelProfileSelectionChanged" @key="selectedScope" /><ValidationMessage For="() => model.ModelProfileName" /></div>
        </FormSection>
        <FormSection Title="@T("Execution")" TestId="agent-runtime-section">
                <FormField Required="true" Label="@T("RuntimeProfile")" Class="form-span-2"><ChildContent><ClearableSelect TValue="string" Value="@RuntimeProfileValue" ValueChanged="value => RuntimeProfileChanged(new ChangeEventArgs { Value = value })" ValueExpression="() => model.RuntimeProfileName" data-testid="agent-runtime-profile"><option value="">@Shared["NoSelection"]</option>@foreach (var profile in runtimeProfiles) { <option value="@RuntimeProfileValueFor(profile)">@profile.Properties.DisplayName — @(profile.ScopeRef?.Value ?? "?") · @profile.Namespace/@profile.Name</option> }</ClearableSelect><small>@T("RuntimeProfileHelp")</small></ChildContent><Validation><ValidationMessage For="() => model.RuntimeProfileName" /></Validation></FormField>
        </FormSection>

        <FormSection Title="@T("Tags")" TestId="agent-labels-section">
            <LabelsEditor @bind-Value="model.Tags" />
        </FormSection>
        </div>
        }

        </fieldset>
        @if (CanManage && IsNew)
        {
            <FormActions Busy="@saving"><a class="button-secondary" href="/agents">@T("Cancel")</a><button class="button-primary" type="submit" data-testid="agent-create-and-deploy" @onclick="() => applyRuntimeOnSubmit = true" disabled="@saving">@(saving ? T("Creating") : T("CreateAndDeploy"))</button></FormActions>
        }
        else if (CanManage)
        {
            <UnsavedChangesBar IsVisible="@isDirty">
                <Actions><button class="text-button" type="button" data-testid="agent-discard" @onclick="DiscardAsync" disabled="@saving">@T("Discard")</button><button class="button-secondary" type="submit" data-testid="agent-save-draft" @onclick="() => applyRuntimeOnSubmit = false" disabled="@saving">@T("SaveDraft")</button><button class="button-primary" type="submit" @onclick="() => applyRuntimeOnSubmit = true" disabled="@saving">@(saving ? T("Applying") : T("SaveAndApply"))</button></Actions>
            </UnsavedChangesBar>
        }
    </EditForm>
    </div>
    }
    </div>
}

@code {
    [Parameter] public string? Name { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "namespace")] public string? AgentNamespace { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "scopeRef")] public string? ScopeRefValue { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "context")] public string? ContextScopeRef { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string ModelStatusLabel(string? status) => Localizer[$"Status.{status?.ToLowerInvariant() switch { "available" => "Available", "ready" => "Ready", "succeeded" => "Succeeded", "starting" => "Starting", "providerunavailable" => "ProviderUnavailable", "modelunavailable" => "ModelUnavailable", "unavailable" => "Unavailable", "invalidconfiguration" => "InvalidConfiguration", "incompatible" => "Incompatible", "failed" => "Failed", _ => "Unknown" }}"];

    private readonly CancellationTokenSource cancellation = new();
    private string? loadedKey;
    private AgentEditorModel? model;
    private AgentResource? savedResource;
    private bool overviewMode;
    private bool definitionVisited, toolsVisited, contractsVisited;
    private IReadOnlyList<ToolResource> catalogTools = [];
    private IReadOnlyList<ToolProviderResource> catalogProviders = [];
    private IReadOnlyList<ToolCategoryResource> catalogCategories = [];
    private IReadOnlyList<ToolSetVersionResource> catalogToolSetVersions = [];
    private IReadOnlyList<RuntimeProfileSummaryResponse> runtimeProfiles = [];
    private string? etag;
    private string? resourceId;
    private string? errorMessage;
    private string? errorId;
    private string? successMessage;
    private string? modelResolutionWarning;
    private string rawYaml = string.Empty;
    private string? rawError;
    private AgentModelResponse? agentModel;
    private AgentRuntimeReadinessResponse? readiness;
    private AgentRevision? activeRevision;
    private string provisioningStatus = "Valid";
    private long generation;
    private bool loading = true;
    private bool saving;
    private bool invalidInput;
    private string savedFingerprint = string.Empty;
    private string rawBaseline = string.Empty;
    private string rawModelFingerprint = string.Empty;
    private bool rawInitialized;
    private bool rawUsesSavedDefinition;
    private bool CanEditRaw => CanManage && !invalidInput && !rawUsesSavedDefinition;
    private bool HasRawDraft => rawInitialized && rawYaml != rawBaseline;
    private void ScopeChanged(ResourceScopeRef? value)
    {
        var initializing = IsNew && selectedScope is null && Fingerprint == savedFingerprint;
        selectedScope = value;
        if (initializing) savedFingerprint = Fingerprint;
    }
    private string Fingerprint => JsonSerializer.Serialize(new { model, selectedScope });
    private bool isDirty => model is not null && CanManage && (Fingerprint != savedFingerprint || HasRawDraft || invalidInput);
    private bool applyRuntimeOnSubmit = true;
    private bool sourceMode;
    private bool toolsMode;
    private bool accessMode;
    private bool contractsMode;
    private bool interactive;
    private ResourceScopeRef? selectedScope;
    private ResourceGovernance governance = ResourceGovernance.User;
    private bool IsNew => string.IsNullOrWhiteSpace(Name);
    private bool CanManage => IsNew || ResourceOwnershipContext.CanManage(selectedScope, Services);
    private string? SafeReturnUrl => ConsoleResourceUrls.LocalReturnUrl(ReturnUrl);
    private ResourceNamespace AgentResourceNamespace => string.IsNullOrWhiteSpace(AgentNamespace) ? ResourceNamespace.Default : ResourceNamespace.Parse(AgentNamespace);
    private string OverviewUrl => AgentResourceNamespace.IsDefault
        ? $"/agents/{Uri.EscapeDataString(Name ?? string.Empty)}"
        : $"/agents/{Uri.EscapeDataString(Name ?? string.Empty)}?namespace={Uri.EscapeDataString(AgentResourceNamespace.Value)}";
    private string RunUrl => $"{OverviewUrl}/run";
    private bool IsStateSynchronized => !isDirty && readiness?.Ready == true && readiness.Generation == generation;
    private long? ActiveGeneration => readiness?.Ready == true ? readiness.Generation : null;
    private string ActiveStatus => readiness switch
    {
        { Ready: true } => T("Ready"),
        { State: "agent_version_not_found" } => T("AgentVersionNotFound", generation),
        { State: "agent_deployment_not_found" } => T("AgentDeploymentNotFound"),
        { Error: { Length: > 0 } error } => error,
        { State: { Length: > 0 } state } => StatusPresentation.Label(state),
        _ => T("NotDeployed")
    };
    private string? ActiveRuntime => readiness?.RuntimeProfileId is null ? readiness?.DeploymentId : ResourceName(readiness.RuntimeProfileId);
    private string StateSummary => IsStateSynchronized ? T("GenerationReady", generation) : isDirty ? T("SaveOrApplyModified") : T("CurrentGenerationNotActive");
    private string HeaderStatus => readiness?.Ready == true ? T("Ready") : StatusPresentation.Label(provisioningStatus);
    private string RuntimeProfileValue => model is null || string.IsNullOrWhiteSpace(model.RuntimeProfileName) ? string.Empty :
        $"{model.RuntimeProfileScopeRef?.Value ?? string.Empty}|{model.RuntimeProfileNamespace}|{model.RuntimeProfileName}";
    private UiStatus HeaderStatusTone => readiness?.Ready == true ? UiStatus.Success : StatusPresentation.Tone(provisioningStatus);

    protected override async Task OnParametersSetAsync()
    {
        var contextScope = ContextScopeRef ?? ResourceOwnershipContext.TryGetCurrent(Services)?.Value ?? ScopeRefValue;
        var key = $"{AgentResourceNamespace.Value}|{Name}|{ScopeRefValue ?? contextScope}|{contextScope}";
        if (loadedKey == key) return;
        loadedKey = key;
        loading = true;
        errorMessage = null;
        try
        {
            var toolsTask = ToolsClient.GetToolsAsync(cancellationToken: cancellation.Token);
            var providersTask = ToolsClient.GetProvidersAsync(cancellation.Token);
            var categoriesTask = ToolCategoriesClient.GetCategoriesAsync(cancellation.Token);
            var toolSetVersionsTask = LoadToolSetVersionsAsync();
            var runtimeProfilesTask = RuntimeProfilesClient.GetRuntimeProfilesAsync(cancellation.Token);
            await Task.WhenAll(toolsTask, providersTask, categoriesTask, toolSetVersionsTask, runtimeProfilesTask);
            catalogTools = await toolsTask;
            catalogProviders = await providersTask;
            catalogCategories = await categoriesTask;
            catalogToolSetVersions = await toolSetVersionsTask;
            runtimeProfiles = await runtimeProfilesTask;
            if (IsNew)
            {
                model = new AgentEditorModel { Namespace = AgentResourceNamespace.Value };
                var runtimeProfile = runtimeProfiles.FirstOrDefault();
                if (runtimeProfile is not null)
                {
                    model.RuntimeProfileName = runtimeProfile.Name;
                    model.RuntimeProfileNamespace = runtimeProfile.Namespace;
                    model.RuntimeProfileScopeRef = runtimeProfile.ScopeRef;
                }
            }
            else
            {
                ResourceScopeRef? requestedScope = string.IsNullOrWhiteSpace(ScopeRefValue) ? null : ResourceScopeRef.Parse(ScopeRefValue);
                var snapshot = requestedScope is null
                    ? await Client.GetAgentAsync(AgentResourceNamespace, Name!, cancellation.Token)
                    : await Client.GetAgentAsync(AgentResourceNamespace, Name!, requestedScope.Value, cancellation.Token);
                if (snapshot.Value.Governance.IsManaged)
                {
                    Navigation.NavigateTo(ConsoleResourceUrls.Agent(AgentResourceNamespace, Name!, snapshot.Value.ScopeRef), replace: true);
                    return;
                }
                savedResource = snapshot.Value;
                model = AgentEditorModel.FromResource(snapshot.Value);
                selectedScope = snapshot.Value.ScopeRef;
                etag = snapshot.ETag;
                resourceId = snapshot.Value.Uid.ToString("D");
                generation = snapshot.Value.Generation;
                governance = snapshot.Value.Governance;
                provisioningStatus = snapshot.Value.Status.ProvisioningState.ToString();
                await LoadAgentModelAsync(Name!);
                await LoadReadinessAsync(Name!, generation);
            }
            savedFingerprint = Fingerprint;
            rawInitialized = false;
            overviewMode = !IsNew;
            definitionVisited = IsNew; toolsVisited = false; contractsVisited = false; invalidInput = false;
        }
        catch (AgentstrationApiException exception)
        {
            errorMessage = exception.Message;
            errorId = exception.ErrorId;
            model ??= new AgentEditorModel();
        }
        finally { loading = false; }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        interactive = true;
        StateHasChanged();
    }

    private Task ModelProfileChanged(string value)
    {
        if (model is not null) { model.ModelProfileName = value;  }
        return Task.CompletedTask;
    }

    private Task ModelProfileSelectionChanged(ModelProfileSummaryResponse? profile)
    {
        if (model is not null && profile is not null) model.SelectModelProfile(profile);
        return Task.CompletedTask;
    }

    private void MarkDirty(EventArgs _) { }
    private string CurrentPage => overviewMode ? "overview" : sourceMode ? "yaml" : toolsMode ? "tools" : contractsMode ? "contracts" : accessMode ? "access" : "edit";
    private IReadOnlyList<ResourcePageTab> PageTabs => new ResourcePageTab[] {
        new("overview", Shared["Overview"], "agent-overview-tab"),
        new("edit", Shared["Edit"], "agent-edit-tab"),
        new("contracts", T("Contracts"), "agent-contracts-tab"),
        new("tools", T("Tools"), "agent-tools-tab")
    }.Concat(CanManage ? new[] { new ResourcePageTab("access", T("Access"), "agent-access-tab") } : []).Append(new("yaml", T("Yaml"), "agent-source-tab")).ToArray();
    private void SelectPage(string page)
    {
        switch (page) { case "overview": overviewMode = true; sourceMode = toolsMode = contractsMode = accessMode = false; break; case "yaml": ShowSource(); break; case "tools": ShowTools(); break; case "contracts": ShowContracts(); break; case "access": ShowAccess(); break; default: ShowDefinition(); break; }
    }
    private void ShowDefinition() { definitionVisited = true; overviewMode = false; (sourceMode, toolsMode, contractsMode, accessMode) = (false, false, false, false); }
    private void ShowContracts() { contractsVisited = true; overviewMode = false; (sourceMode, toolsMode, contractsMode, accessMode) = (false, false, true, false); }
    private void ShowTools() { toolsVisited = true; overviewMode = false; (sourceMode, toolsMode, contractsMode, accessMode) = (false, true, false, false); }
    private void ShowAccess() { overviewMode = false; (sourceMode, toolsMode, contractsMode, accessMode) = (false, false, false, true); }
    private AgentResourceRequest SavedRequest() => new()
    {
        ApiVersion = savedResource!.ApiVersion, Kind = savedResource.Kind,
        Metadata = savedResource.Metadata, Definition = savedResource.Definition, ScopeRef = savedResource.ScopeRef
    };
    private void InitializeRawYaml(AgentResourceRequest request, bool savedDefinition)
    {
        rawYaml = ResourceManifestSerializer.ToYaml(request);
        rawBaseline = rawYaml;
        rawModelFingerprint = Fingerprint;
        rawInitialized = true;
        rawUsesSavedDefinition = savedDefinition;
    }
    private void ShowSource()
    {
        overviewMode = false;
        if (model is null) return;
        rawError = null;
        try
        {
            if (!rawInitialized || !HasRawDraft && (rawModelFingerprint != Fingerprint || rawUsesSavedDefinition != invalidInput))
            {
                if (invalidInput && savedResource is not null) InitializeRawYaml(SavedRequest(), true);
                else InitializeRawYaml(model.ToRequest(), false);
            }
        }
        catch (ArgumentException)
        {
            if (savedResource is not null) InitializeRawYaml(SavedRequest(), true);
            else rawError = T("YamlNeedsValidForm");
        }
        (sourceMode, toolsMode, contractsMode, accessMode) = (true, false, false, false);
    }

    private bool ApplyRawYaml()
    {
        if (!CanEditRaw || model is null) return false;
        rawError = null;
        try
        {
            var request = ResourceManifestSerializer.FromYaml<AgentResourceRequest>(rawYaml);
            if (!string.Equals(request.ApiVersion, ResourceApiVersions.CoreV1, StringComparison.Ordinal)) throw new ArgumentException(T("ApiVersionRequired", ResourceApiVersions.CoreV1));
            if (!string.Equals(request.Kind, AgentResourceKinds.Agent, StringComparison.Ordinal)) throw new ArgumentException(T("KindRequired", AgentResourceKinds.Agent));
            if (request.Metadata.Namespace != AgentResourceNamespace) throw new ArgumentException(T("AgentNamespaceImmutable"));
            if (!IsNew && !string.Equals(request.Metadata.Name, Name, StringComparison.Ordinal)) throw new ArgumentException(T("AgentNameImmutable"));
            var parsedModel = AgentEditorModel.FromRequest(request);
            _ = parsedModel.ToRequest();
            model = parsedModel;
            rawYaml = ResourceManifestSerializer.ToYaml(model.ToRequest());
            rawBaseline = rawYaml;
            rawModelFingerprint = Fingerprint;
            successMessage = T("YamlApplied");
            return true;
        }
        catch (Exception exception)
        {
            rawError = exception.Message;
            return false;
        }
    }

    private async Task SaveRawAsync()
    {
        if (!ApplyRawYaml()) return;
        await SaveAsync(applyRuntime: false);
        if (!IsNew) ShowSource();
    }
    private IReadOnlyList<string> SelectedToolIds => model?.ToolNames.Split(['\r','\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) ?? [];
    private IReadOnlyList<AgentToolSetSelection> SelectedToolSets => model?.ToolSets ?? [];
    private IReadOnlyList<ToolResource> VisibleTools => VisibleFromAgentScope(catalogTools);
    private IReadOnlyList<ToolProviderResource> VisibleProviders => VisibleFromAgentScope(catalogProviders);
    private IReadOnlyList<ToolCategoryResource> VisibleCategories => VisibleFromAgentScope(catalogCategories);
    private IReadOnlyList<ToolSetVersionResource> VisibleToolSetVersions => VisibleFromAgentScope(catalogToolSetVersions);
    private IReadOnlyList<T> VisibleFromAgentScope<T>(IReadOnlyList<T> resources) where T : Resource
    {
        if (selectedScope is not { } consumerScope) return resources;
        return resources.Where(resource => resource.ScopeRef is { } ownerScope
            && (ownerScope == consumerScope || ownerScope.Kind < consumerScope.Kind)).ToArray();
    }
    private IReadOnlyDictionary<string, IReadOnlyList<string>> ToolSetGrantedTools
    {
        get
        {
            var grants = new Dictionary<string, List<string>>(StringComparer.Ordinal);
            foreach (var selection in SelectedToolSets)
            {
                var selectedNamespace = selection.ToolSet.Namespace ?? ResourceNamespace.Default;
                var matchingVersions = catalogToolSetVersions.Where(value =>
                    value.Namespace == selectedNamespace
                    && string.Equals(value.ToolSetName, selection.ToolSet.Name, StringComparison.Ordinal)
                    && (selection.ToolSet.ScopeRef is null || value.ScopeRef == selection.ToolSet.ScopeRef)
                    && string.Equals(value.Version, selection.Version, StringComparison.Ordinal)).ToArray();
                var version = matchingVersions.FirstOrDefault(value => value.ScopeRef == selection.ToolSet.ScopeRef)
                    ?? matchingVersions.FirstOrDefault(value => value.ScopeRef == selectedScope)
                    ?? matchingVersions.FirstOrDefault();
                if (version is null) continue;

                var selectedMembers = selection.Members.Count == 0
                    ? version.Members
                    : version.Members.Where(value => selection.Members.Contains(value.ToolName, StringComparer.Ordinal)).ToArray();
                var source = $"{version.ToolSetName}@{version.Version}";
                foreach (var member in selectedMembers)
                {
                    if (!grants.TryGetValue(member.ToolName, out var sources))
                    {
                        sources = [];
                        grants.Add(member.ToolName, sources);
                    }
                    if (!sources.Contains(source, StringComparer.Ordinal)) sources.Add(source);
                }
            }

            return grants.ToDictionary(
                pair => pair.Key,
                pair => (IReadOnlyList<string>)pair.Value,
                StringComparer.Ordinal);
        }
    }
