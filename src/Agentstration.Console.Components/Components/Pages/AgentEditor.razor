    private void HandleInvalidSubmit(EditContext editContext)
    {
        var configurationFields = new[] { nameof(AgentEditorModel.DisplayName), nameof(AgentEditorModel.Name), nameof(AgentEditorModel.Instructions), nameof(AgentEditorModel.Handler), nameof(AgentEditorModel.Tags) };
        var configurationInvalid = configurationFields.Any(field => editContext.GetValidationMessages(new FieldIdentifier(model!, field)).Any());
        var modelInvalid = editContext.GetValidationMessages(new FieldIdentifier(model!, nameof(AgentEditorModel.ModelProfileName))).Any()
            || editContext.GetValidationMessages(new FieldIdentifier(model!, nameof(AgentEditorModel.RuntimeProfileName))).Any();
        ShowSection(!IsNew && !configurationInvalid && modelInvalid ? "definition/model-execution" : "definition/configuration");
    }
    private sealed record ConfigurationEntry(string Label, string Value, string? Href = null);
    private IReadOnlyList<ConfigurationEntry> ConfigurationEntries
    {
        get
        {
            if (savedResource is null) return [];
            var definition = savedResource.Definition;
            var modelAddress = definition.ModelProfile.Resolve(savedResource.Namespace, ModelResourceKinds.ModelProfile);
            var runtimeAddress = definition.RuntimeProfile.Resolve(savedResource.Namespace, RuntimeProfileResourceKinds.RuntimeProfile);
            var rows = new List<ConfigurationEntry>
            {
                new(T("Handler"), definition.Handler),
                new(T("Instructions"), definition.Instructions),
                new(T("ModelProfile"), $"{modelAddress.Namespace}/{modelAddress.Name}", ResourceOwnershipContext.Resource(Services, "/modelprofiles", modelAddress.Name, modelAddress.Namespace, definition.ModelProfile.ScopeRef)),
                new(T("RuntimeProfile"), $"{runtimeAddress.Namespace}/{runtimeAddress.Name}", ResourceOwnershipContext.Resource(Services, "/runtimeprofiles", runtimeAddress.Name, runtimeAddress.Namespace, definition.RuntimeProfile.ScopeRef)),
                new(T("Tools"), definition.Tools.Count == 0 ? Shared["NotProvided"] : string.Join("\n", definition.Tools.Select(value => $"{value.Namespace ?? savedResource.Namespace}/{value.Name}"))),
                new(T("GovernedToolSets"), definition.ToolSets.Count == 0 ? Shared["NotProvided"] : string.Join("\n", definition.ToolSets.Select(value => $"{value.ToolSet.Namespace ?? savedResource.Namespace}/{value.ToolSet.Name}@{value.Version}")))
            };
            if (definition.InputSchemaBinding is not null || definition.InputSchema is not null)
                rows.Add(new(T("InputContract"), JsonSerializer.Serialize((object?)definition.InputSchemaBinding ?? definition.InputSchema)));
            if (definition.OutputSchemaBinding is not null || definition.OutputSchema is not null || definition.OutputContract is not null)
                rows.Add(new(T("OutputContract"), JsonSerializer.Serialize((object?)definition.OutputSchemaBinding ?? (object?)definition.OutputContract ?? definition.OutputSchema)));
            if (definition.Behaviors.Count > 0) rows.Add(new(T("Behaviors"), string.Join("\n", definition.Behaviors)));
            if (definition.Middleware.Count > 0) rows.Add(new(T("Middleware"), string.Join("\n", definition.Middleware)));
            if (definition.ContextProviders.Count > 0) rows.Add(new(T("ContextProviders"), string.Join("\n", definition.ContextProviders)));
            foreach (var setting in definition.Settings.OrderBy(value => value.Key, StringComparer.Ordinal))
                rows.Add(new(setting.Key, setting.Value.ToString()));
            return rows;
        }
    }
    private AgentResourceRequest SavedRequest() => new()
    {
        ApiVersion = savedResource!.ApiVersion, Kind = savedResource.Kind,
        Metadata = savedResource.Metadata, Definition = savedResource.Definition, ScopeRef = savedResource.ScopeRef
    };
    private void InitializeRawYaml(AgentResourceRequest request, bool savedDefinition)
    {
        rawYaml = ResourceManifestSerializer.ToYaml(request);
        rawBaseline = rawYaml;
        rawModelFingerprint = Fingerprint;
        rawInitialized = true;
        rawUsesSavedDefinition = savedDefinition;
    }
    private void InitializeSource()
    {
        overviewMode = false;
        if (model is null) return;
        rawError = null;
        try
        {
            if (!rawInitialized || !HasRawDraft && (rawModelFingerprint != Fingerprint || rawUsesSavedDefinition != invalidInput))
            {
                if (invalidInput && savedResource is not null) InitializeRawYaml(SavedRequest(), true);
                else InitializeRawYaml(model.ToRequest(), false);
            }
        }
        catch (ArgumentException)
        {
            if (savedResource is not null) InitializeRawYaml(SavedRequest(), true);
            else rawError = T("YamlNeedsValidForm");
        }
        (sourceMode, toolsMode, contractsMode, accessMode) = (true, false, false, false);
    }

    private bool ApplyRawYaml()
    {
        if (!CanEditRaw || model is null) return false;
        rawError = null;
        try
        {
            var request = ResourceManifestSerializer.FromYaml<AgentResourceRequest>(rawYaml);
            if (!string.Equals(request.ApiVersion, ResourceApiVersions.CoreV1, StringComparison.Ordinal)) throw new ArgumentException(T("ApiVersionRequired", ResourceApiVersions.CoreV1));
            if (!string.Equals(request.Kind, AgentResourceKinds.Agent, StringComparison.Ordinal)) throw new ArgumentException(T("KindRequired", AgentResourceKinds.Agent));
            if (request.Metadata.Namespace != AgentResourceNamespace) throw new ArgumentException(T("AgentNamespaceImmutable"));
            if (!IsNew && !string.Equals(request.Metadata.Name, Name, StringComparison.Ordinal)) throw new ArgumentException(T("AgentNameImmutable"));
            var parsedModel = AgentEditorModel.FromRequest(request);
            _ = parsedModel.ToRequest();
            model = parsedModel;
            rawYaml = ResourceManifestSerializer.ToYaml(model.ToRequest());
            rawBaseline = rawYaml;
            rawModelFingerprint = Fingerprint;
            successMessage = T("YamlApplied");
            return true;
        }
        catch (Exception exception)
        {
            rawError = exception.Message;
            return false;
        }
    }

    private async Task SaveRawAsync()
    {
        if (!ApplyRawYaml()) return;
        await SaveAsync(applyRuntime: false);
        if (!IsNew) ShowSource();
    }
