    protected override async Task OnParametersSetAsync()
    {
        var contextScope = ContextScopeRef ?? ResourceOwnershipContext.TryGetCurrent(Services)?.Value ?? ScopeRefValue;
        var key = $"{AgentResourceNamespace.Value}|{Name}|{ScopeRefValue ?? contextScope}|{contextScope}";
        if (loadedKey == key) return;
        loadedKey = key;
        await LoadInitialAsync(key);
    }

    private async Task LoadInitialAsync(string key)
    {
        var version = ++loadVersion;
        loading = true; refreshing = false;
        ClearLoadedResource();
        loadState = new(ResourceLoadStatus.Loading);
        sectionState.Reset(key);
        var fetchingResource = false;
        try
        {
            var toolsTask = ToolsClient.GetToolsAsync(cancellationToken: cancellation.Token);
            var providersTask = ToolsClient.GetProvidersAsync(cancellation.Token);
            var categoriesTask = ToolCategoriesClient.GetCategoriesAsync(cancellation.Token);
            var toolSetVersionsTask = LoadToolSetVersionsAsync();
            var runtimeProfilesTask = RuntimeProfilesClient.GetRuntimeProfilesAsync(cancellation.Token);
            await Task.WhenAll(toolsTask, providersTask, categoriesTask, toolSetVersionsTask, runtimeProfilesTask);
            if (version != loadVersion) return;
            catalogTools = await toolsTask;
            catalogProviders = await providersTask;
            catalogCategories = await categoriesTask;
            catalogToolSetVersions = await toolSetVersionsTask;
            runtimeProfiles = await runtimeProfilesTask;
            if (IsNew)
            {
                savedResource = null; selectedScope = null; etag = null; readiness = null; activeRevision = null; agentModel = null;
                model = new AgentEditorModel { Namespace = AgentResourceNamespace.Value };
                var runtimeProfile = runtimeProfiles.FirstOrDefault();
                if (runtimeProfile is not null)
                {
                    model.RuntimeProfileName = runtimeProfile.Name;
                    model.RuntimeProfileNamespace = runtimeProfile.Namespace;
                    model.RuntimeProfileScopeRef = runtimeProfile.ScopeRef;
                }
            }
            else
            {
                ResourceScopeRef? requestedScope = string.IsNullOrWhiteSpace(ScopeRefValue) ? null : ResourceScopeRef.Parse(ScopeRefValue);
                fetchingResource = true;
                var snapshot = requestedScope is null
                    ? await Client.GetAgentAsync(AgentResourceNamespace, Name!, cancellation.Token)
                    : await Client.GetAgentAsync(AgentResourceNamespace, Name!, requestedScope.Value, cancellation.Token);
                if (version != loadVersion) return;
                fetchingResource = false;
                if (snapshot.Value.Governance.IsManaged)
                {
                    Navigation.NavigateTo(ConsoleResourceUrls.Agent(AgentResourceNamespace, Name!, snapshot.Value.ScopeRef), replace: true);
                    return;
                }
                savedResource = snapshot.Value;
                model = AgentEditorModel.FromResource(snapshot.Value);
                selectedScope = snapshot.Value.ScopeRef;
                etag = snapshot.ETag;
                generation = snapshot.Value.Generation;
                governance = snapshot.Value.Governance;
                provisioningStatus = snapshot.Value.Status.ProvisioningState.ToString();
                await LoadAgentModelAsync(Name!);
                if (version != loadVersion) return;
                await LoadReadinessAsync(Name!, generation);
                if (version != loadVersion) return;
            }
            savedFingerprint = Fingerprint;
            rawInitialized = false;
            if (IsNew) sectionState.Select("definition/configuration");
            invalidInput = false;
            loadState = new(ResourceLoadStatus.Ready) { HasContent = !IsNew };
        }
        catch (AgentstrationApiException exception)
        {
            if (version == loadVersion)
            {
                if (IsNew) { errorMessage = exception.Message; errorId = exception.ErrorId; model ??= new AgentEditorModel(); savedFingerprint = Fingerprint; }
                else { ClearLoadedResource(); loadState = LoadFailure(exception, fetchingResource); }
            }
        }
        catch (HttpRequestException)
        {
            if (version == loadVersion) InitialTransportFailure();
        }
        catch (OperationCanceledException) when (!cancellation.IsCancellationRequested)
        {
            if (version == loadVersion) InitialTransportFailure();
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        finally { if (version == loadVersion) loading = false; }
    }

    private Task RetryLoadAsync()
    {
        if (loading || refreshing || saving) return Task.CompletedTask;
        return savedResource is not null && !loadState.BlocksContent
            ? RefreshAsync() : LoadInitialAsync(loadedKey!);
    }

    private void InitialTransportFailure()
    {
        ClearLoadedResource();
        loadState = new(ResourceLoadStatus.Failed);
        if (IsNew)
        {
            model = new AgentEditorModel { Namespace = AgentResourceNamespace.Value };
            errorMessage = Shared["ResourceLoadFailedMessage"];
            savedFingerprint = Fingerprint;
        }
    }

    private async Task RefreshAsync()
    {
        if (IsNew || savedResource is not { ScopeRef: { } owner } current || loading || refreshing || saving) return;
        var version = ++loadVersion;
        refreshing = true;
        loadState = new(ResourceLoadStatus.Refreshing) { HasContent = true };
        try
        {
            var snapshot = await Client.GetAgentAsync(current.Namespace, current.Name, owner, cancellation.Token);
            if (version != loadVersion) return;
            if (snapshot.Value.Uid != current.Uid || snapshot.Value.ScopeRef != owner || snapshot.Value.Address != current.Address)
            {
                ClearLoadedResource();
                loadState = new(ResourceLoadStatus.NotFound);
                return;
            }
            if (snapshot.Value.Governance.IsManaged)
            {
                ClearLoadedResource();
                loadState = new(ResourceLoadStatus.Loading);
                Navigation.NavigateTo(ConsoleResourceUrls.Agent(current.Namespace, current.Name, owner), replace: true);
                return;
            }
            if (isDirty && !string.Equals(etag, snapshot.ETag, StringComparison.Ordinal))
            {
                // Keep the draft's original baseline and ETag so a later save still detects concurrency.
                newerResource = snapshot.Value;
                newerEtag = snapshot.ETag;
            }
            else
            {
                newerResource = null; newerEtag = null;
                if (isDirty) savedResource = snapshot.Value;
                else ApplySnapshot(snapshot.Value, snapshot.ETag);
            }
            await LoadAgentModelAsync(current.Name);
            if (version != loadVersion) return;
            await LoadReadinessAsync(current.Name, generation);
            if (version != loadVersion) return;
            loadState = new(ResourceLoadStatus.Ready) { HasContent = true };
        }
        catch (AgentstrationApiException exception)
        {
            if (version != loadVersion) return;
            var failure = LoadFailure(exception, resourceFailure: true);
            if (failure.Status is ResourceLoadStatus.NotFound or ResourceLoadStatus.Forbidden) ClearLoadedResource();
            loadState = failure with { HasContent = savedResource is not null };
        }
        catch (HttpRequestException)
        {
            if (version == loadVersion) loadState = new(ResourceLoadStatus.Failed) { HasContent = savedResource is not null };
        }
        catch (OperationCanceledException) when (!cancellation.IsCancellationRequested)
        {
            if (version == loadVersion) loadState = new(ResourceLoadStatus.Failed) { HasContent = savedResource is not null };
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        finally { if (version == loadVersion) refreshing = false; }
    }

    private static ResourceLoadState LoadFailure(AgentstrationApiException exception, bool resourceFailure) =>
        new(resourceFailure ? exception.StatusCode switch
        {
            System.Net.HttpStatusCode.NotFound => ResourceLoadStatus.NotFound,
            System.Net.HttpStatusCode.Forbidden or System.Net.HttpStatusCode.Unauthorized => ResourceLoadStatus.Forbidden,
            _ => ResourceLoadStatus.Failed
        } : ResourceLoadStatus.Failed) { ErrorId = exception.ErrorId };

    private void ApplySnapshot(AgentResource resource, string? responseEtag)
    {
        savedResource = resource;
        model = AgentEditorModel.FromResource(resource);
        selectedScope = resource.ScopeRef;
        etag = responseEtag;
        generation = resource.Generation;
        governance = resource.Governance;
        provisioningStatus = resource.Status.ProvisioningState.ToString();
        savedFingerprint = Fingerprint;
        rawInitialized = rawUsesSavedDefinition = invalidInput = false;
        rawYaml = rawBaseline = rawModelFingerprint = string.Empty;
        rawError = null;
        if (IsSource) InitializeSource();
    }

    private void ClearLoadedResource()
    {
        savedResource = newerResource = null;
        model = null; editContext = null; selectedScope = null;
        etag = newerEtag = null;
        readiness = null; activeRevision = null; agentModel = null;
        generation = 0; governance = ResourceGovernance.User; provisioningStatus = "Valid";
        rawInitialized = rawUsesSavedDefinition = invalidInput = false;
        rawYaml = rawBaseline = rawModelFingerprint = savedFingerprint = string.Empty;
        rawError = errorMessage = errorId = successMessage = modelResolutionWarning = null;
        catalogTools = []; catalogProviders = []; catalogCategories = []; catalogToolSetVersions = []; runtimeProfiles = [];
    }

