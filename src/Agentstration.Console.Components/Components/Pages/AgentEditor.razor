    private async Task LoadAgentModelAsync(string name)
    {
        var version = loadVersion;
        agentModel = null;
        modelResolutionWarning = null;
        try
        {
            var result = await AgentsModelClient.GetAgentModelResolutionAsync(AgentResourceNamespace, name, cancellation.Token);
            if (version == loadVersion) agentModel = result;
        }
        catch (AgentstrationApiException exception) { if (version == loadVersion) modelResolutionWarning = exception.Message; }
    }

    private async Task LoadReadinessAsync(string name, long desiredGeneration)
    {
        var version = loadVersion;
        readiness = null;
        activeRevision = null;
        try
        {
            var result = selectedScope is { } scopeRef
                ? await RuntimeClient.GetAgentReadinessAsync(AgentResourceNamespace, name, scopeRef, desiredGeneration, cancellation.Token)
                : await RuntimeClient.GetAgentReadinessAsync(AgentResourceNamespace, name, desiredGeneration, cancellation.Token);
            if (version != loadVersion) return;
            readiness = result;
            if (readiness.Ready && !string.IsNullOrWhiteSpace(readiness.RevisionId))
            {
                var revision = (await Client.GetAgentRevisionAsync(
                    AgentResourceNamespace,
                    name,
                    readiness.RevisionId,
                    cancellation.Token)).Value;
                if (version == loadVersion) activeRevision = revision;
            }
        }
        catch (AgentstrationApiException) { }
    }

    private async Task SaveAsync(bool applyRuntime)
    {
        if (!CanManage || model is null || saving) return;
        if (HasRawDraft) { ShowSource(); return; }
        saving = true;
        errorMessage = null;
        errorId = null;
        successMessage = null;
        try
        {
            var wasNew = IsNew;
            var request = Request();
            var snapshot = await Client.PutAgentAsync(request, etag, wasNew, cancellation.Token);
            etag = snapshot.ETag;
            generation = snapshot.Value.Generation;
            governance = snapshot.Value.Governance;
            provisioningStatus = snapshot.Value.Status.ProvisioningState.ToString();
            selectedScope = snapshot.Value.ScopeRef;
            successMessage = T("GenerationSavedWithoutDeployment", generation);
            savedResource = snapshot.Value;
            model = AgentEditorModel.FromResource(snapshot.Value);
            savedFingerprint = Fingerprint;
            rawInitialized = false;
            if (applyRuntime)
            {
                var activation = snapshot.Value.ScopeRef is { } scopeRef
                    ? await RuntimeClient.PrepareAgentAsync(snapshot.Value.Namespace, snapshot.Value.Name, scopeRef, snapshot.Value.Generation, cancellation.Token)
                    : await RuntimeClient.PrepareAgentAsync(snapshot.Value.Namespace, snapshot.Value.Name, snapshot.Value.Generation, cancellation.Token);
                if (!string.Equals(activation.State, OperationalState.Ready.ToString(), StringComparison.Ordinal))
                {
                    var message = T("ActivationFailedMessage", snapshot.Value.Generation, activation.State);
                    Notifications.Add(new NotificationItem(Guid.NewGuid(), T("ActivationFailed"), message, DateTimeOffset.Now, UiStatus.Warning));
                    if (wasNew) Navigation.NavigateTo(ConsoleResourceUrls.Agent(snapshot.Value.Namespace, snapshot.Value.Name, snapshot.Value.ScopeRef));
                    else { errorMessage = message; await LoadAgentModelAsync(snapshot.Value.Name); await LoadReadinessAsync(snapshot.Value.Name, snapshot.Value.Generation); }
                    return;
                }
            }

            successMessage = wasNew ? (applyRuntime ? T("AgentCreatedDeployed") : T("AgentDraftCreated")) : applyRuntime ? T("AgentUpdatedActivated", snapshot.Value.Generation) : T("GenerationSavedWithoutDeployment", snapshot.Value.Generation);
            Notifications.Add(new NotificationItem(Guid.NewGuid(), successMessage, snapshot.Value.Name, DateTimeOffset.Now, UiStatus.Success));
            if (wasNew)
                Navigation.NavigateTo(ConsoleResourceUrls.Agent(snapshot.Value.Namespace, snapshot.Value.Name, snapshot.Value.ScopeRef));
            else
            {
                await LoadAgentModelAsync(snapshot.Value.Name);
                await LoadReadinessAsync(snapshot.Value.Name, snapshot.Value.Generation);
            }
        }
        catch (ArgumentException exception) { errorMessage = exception.Message; }
        catch (AgentstrationApiException exception)
        {
            errorMessage = exception.IsConcurrencyConflict ? T("ConcurrencyConflict") : exception.Message;
            errorId = exception.ErrorId;
        }
        finally { saving = false; }
    }

    private AgentResourceRequest Request() => model!.ToRequest() with { ScopeRef = selectedScope };

    private async Task ReconcileAsync()
    {
        if (!CanManage || model is null || IsNew || isDirty) return;
        saving = true;
        errorMessage = null;
        try
        {
            var activation = await RuntimeClient.PrepareAgentAsync(AgentResourceNamespace, model.Name, generation, cancellation.Token);
            await LoadReadinessAsync(model.Name, generation);
            successMessage = string.Equals(activation.State, OperationalState.Ready.ToString(), StringComparison.Ordinal) ? T("GenerationActive", generation) : T("ReconciliationCompleted", activation.State);
        }
        catch (AgentstrationApiException exception) { errorMessage = exception.Message; errorId = exception.ErrorId; }
        finally { saving = false; }
    }

