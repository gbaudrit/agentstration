    private void RuntimeProfileChanged(ChangeEventArgs args)
    {
        if (!CanManage || model is null) return;
        if (string.IsNullOrEmpty(args.Value?.ToString())) { model.RuntimeProfileName = string.Empty; model.RuntimeProfileScopeRef = null; return; }
        var parts = args.Value?.ToString()?.Split('|', 3);
        if (parts is not { Length: 3 }) return;
        model.RuntimeProfileScopeRef = string.IsNullOrWhiteSpace(parts[0]) ? null : ResourceScopeRef.Parse(parts[0]);
        model.RuntimeProfileNamespace = parts[1];
        model.RuntimeProfileName = parts[2];

    }

