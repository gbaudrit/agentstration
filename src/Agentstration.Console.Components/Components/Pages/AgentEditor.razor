@page "/agents/new"
@page "/agents/{Name}"
@implements IDisposable
@inject IManagementApiClient Client
@inject IAgentsModelClient AgentsModelClient
@inject IAgentRunnerRuntimeClient RuntimeClient
@inject IRuntimeProfilesClient RuntimeProfilesClient
@inject IToolsClient ToolsClient
@inject IToolCategoriesClient ToolCategoriesClient
@inject IToolSetsClient ToolSetsClient
@inject NavigationManager Navigation
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@inject NotificationState Notifications
@inject Microsoft.Extensions.Localization.IStringLocalizer<AgentEditorStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<ResourceIdentityFieldsStrings> IdentityLocalizer

@if (IsNew)
{
    <UnsavedNavigationGuard IsDirty="@isDirty" HasUnsavedChanges="@(() => isDirty)" ViewQueryParameters="@(new[] { "view", "tab" })" />
}
<PageTitle>@(IsNew ? T("CreateAgent") : Name) · Agentstration</PageTitle>

@if (IsNew)
{
    <PageHeader Eyebrow="@T("Agent")" Title="@T("CreateAgent")" Description="@T("CreateDescription")">
        <Actions><a class="button-secondary" href="/agents">@T("BackToAgents")</a></Actions>
    </PageHeader>
}

@if (IsNew && (loading || model is null))
{
    <LoadingState Message="@T("Loading")" />
}
else
{
    RenderFragment feedback = @<div class="agent-feedback">
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="form-alert form-alert-danger" role="alert"><strong>@T("UnableToApply")</strong><span>@errorMessage</span>@if (!string.IsNullOrWhiteSpace(errorId)) { <code>@errorId</code> }</div>
    }
    @if (newerResource is not null)
    {
        <div class="form-alert form-alert-warning" role="status">@T("RefreshDraftConflict")</div>
    }
    <PageNotification Message="@successMessage" OnDismiss="() => successMessage = null" />
    @if (!IsNew && !IsOverview && !IsAccess && !IsStateSynchronized && !isDirty)
    {
        <div class="form-alert form-alert-warning" role="status">@T("CurrentGenerationNotActive")</div>
    }
    @if (HasRawDraft && !IsSource)
    {
        <div class="form-alert form-alert-warning" role="status"><span>@Shared["YamlConflict"]</span><button class="text-button" type="button" @onclick="ShowSource">@T("Yaml")</button><button class="text-button" type="button" @onclick="DiscardRawDraft">@Shared["DiscardYaml"]</button></div>
    }
    </div>;
    RenderFragment overviewConfiguration = @<div><CollectionView TItem="ConfigurationEntry" Items="ConfigurationEntries" IdentityLabel="@T("ConfigurationEntry")" InformationLabels="@(new[] { T("ConfigurationValue") })">
                <Identity Context="entry"><strong class="configuration-key">@entry.Label</strong></Identity>
                <Information Context="entry"><CollectionValue Label="@T("ConfigurationValue")">@if (entry.Href is { } href) { <a class="resource-name-link configuration-value" href="@href">@entry.Value</a> } else { <span class="configuration-value">@entry.Value</span> }</CollectionValue></Information>
            </CollectionView></div>;
    RenderFragment overviewContent = @<div class="resource-overview-additional">@if (savedResource is not null)
    {
        @if (activeRevision?.Definition.ToolSetAssignments.Count > 0)
        {
            <FormSection Title="@T("PinnedToolSetAssignments")" Eyebrow="@T("ActiveRevision")" Description="@T("PinnedToolSetAssignmentsHelp")" TestId="agent-active-toolsets"><Actions><code>@activeRevision.Metadata.Name</code></Actions><ChildContent>
                <CollectionView TItem="ResolvedAgentToolSetAssignment" Items="activeRevision.Definition.ToolSetAssignments.OrderBy(value => value.ToolSetName, StringComparer.Ordinal).ToArray()" InformationLabels="@(new[] { T("DefinitionHash"), T("EffectiveMembers") })">
                    <Identity Context="assignment"><CollectionIdentity DisplayName="@assignment.ToolSetName" Namespace="@assignment.ToolSetNamespace.Value" Name="@assignment.ToolSetName" Href="@ResourceOwnershipContext.Resource(Services, "/tools/sets", assignment.ToolSetName, assignment.ToolSetNamespace, assignment.ToolSetScopeRef)" IconName="layers"><Versions><CollectionVersion Label="@T("Version")" Value="@(assignment.Version)" /></Versions><IconBadges><ResourceScopeBadge ScopeRef="assignment.ToolSetScopeRef" IconOnly /><ManagedResourceBadge IsReadOnly="@(!ResourceOwnershipContext.CanManage(assignment.ToolSetScopeRef, Services))" IconOnly /></IconBadges></CollectionIdentity></Identity>
                    <Information Context="assignment"><CollectionValue Label="@T("DefinitionHash")"><code>@assignment.DefinitionHash</code></CollectionValue><CollectionValue Label="@T("EffectiveMembers")">@string.Join(", ", assignment.Members)</CollectionValue></Information>
                    <Actions Context="assignment"><CollectionActions ResourceName="@assignment.ToolSetName"><a href="@ResourceOwnershipContext.Resource(Services, "/tools/sets", assignment.ToolSetName, assignment.ToolSetNamespace, assignment.ToolSetScopeRef)">@T("InspectToolSet")</a></CollectionActions></Actions>
                </CollectionView>
            </ChildContent></FormSection>
        }
            <FormSection Title="@T("DeclaredAndResolved")"><Actions>@if (agentModel is not null) { <StatusBadge Text="@ModelStatusLabel(agentModel.Status)" Status="@ModelManagementUi.Status(agentModel.Status)" /> }</Actions><ChildContent>
                <div class="declaration-resolution-grid">
                    <article><h3>@T("DeclaredConfiguration")</h3><dl class="resource-details"><dt>@T("ModelProfile")</dt><dd>@if (agentModel is not null) { <a class="resource-name-link" href="@ProfileUrl(agentModel)">@(agentModel.Declared.ModelProfile.DisplayName ?? savedResource.Definition.ModelProfile.Name)</a> } else { @savedResource.Definition.ModelProfile.Name }</dd><dt>@T("Name")</dt><dd><code>@savedResource.Definition.ModelProfile.Name</code></dd></dl></article>
                    <article><h3>@T("ResolvedConfiguration")</h3>@if (agentModel is null) { <p class="inline-warning">@modelResolutionWarning</p> } else { <dl class="resource-details"><dt>@T("Provider")</dt><dd>@if (agentModel.Resolved.Provider is { } provider) { <a class="resource-name-link" href="@ProviderUrl(agentModel)">@(provider.DisplayName ?? provider.Name)</a> } else { @T("NotResolved") }</dd><dt>@T("Contribution")</dt><dd>@(agentModel.Resolved.Provider?.ContributionId ?? T("NotResolved"))</dd><dt>@T("Model")</dt><dd><code>@agentModel.Resolved.Model.Name</code></dd><dt>@T("Status")</dt><dd>@ModelStatusLabel(agentModel.Status)</dd></dl>}</article>
                </div>
            </ChildContent></FormSection>

    }</div>;
    RenderFragment yamlFeedback = @<text>@if (invalidInput || rawUsesSavedDefinition)
    {
        <div class="form-alert form-alert-info" role="status" data-testid="agent-yaml-form-warning"><span>@T("YamlFormInvalid")</span><button type="button" class="text-button" @onclick="ShowDefinition">@Shared["Edit"]</button></div>
    }</text>;
    RenderFragment yamlActions = @<text><button class="button-secondary" type="button" @onclick="() => { ApplyRawYaml(); }" disabled="@(saving || refreshing || !CanEditRaw)">@T("ApplyToForm")</button>@if (IsNew) { <button class="button-primary" type="button" @onclick="SaveRawAsync" disabled="@(saving || !CanEditRaw)">@(saving ? T("Saving") : T("CreateFromYaml"))</button> }</text>;
    var presentations = AgentSectionPresentations(yamlActions);
    RenderFragment definitionContent = @<div class="resource-editor-view">@if (model is not null)
    {
        <ResourceDefinitionForm @key="model" @ref="definitionForm" EditContext="FormContext" FieldLabels="ValidationFieldLabels"
            OnValidSubmit="() => SaveAsync(applyRuntimeOnSubmit)" OnInvalidSubmit="HandleInvalidSubmit" InvalidInputChanged="value => invalidInput = value"
            Id="agent-resource-form" FormName="agent-editor" FieldsTestId="agent-definition-fields" Busy="saving" ReadOnly="@(!CanManage)" Disabled="HasRawDraft"
            Sections="presentations" SectionState="@(IsNew ? null : sectionState)" SectionContent="@(IsNew ? null : DefinitionSectionContent)" SectionRequested="ShowSection"
            data-testid="agent-editor-form" data-interactive="@(interactive ? "true" : "false")" @oninput="MarkDirty" @onchange="MarkDirty">
            <ChildContent>@if (IsNew)
            {
                <p class="required-fields-note"><span aria-hidden="true">*</span> @Shared["RequiredFields"]</p>
                <CreationWizard @ref="creationWizard" Steps="CreationSteps" OnStepChanging="CreationStepChanging" OnFinish="FinishCreationAsync" Busy="saving" FinishLabel="@T("CreateAndDeploy")" FinishTestId="agent-create-and-deploy" />
            }</ChildContent>
        </ResourceDefinitionForm>
    }</div>;
    if (IsNew)
    {
        @feedback
        <FormActions><button type="button" class="button-secondary" data-testid="agent-source-tab" @onclick="() => { if (IsSource) ShowDefinition(); else ShowSource(); }">@(IsSource ? T("Form") : T("Yaml"))</button></FormActions>

        <div id="agent-page-panel" role="region" aria-label="@CurrentSectionLabel" tabindex="-1">
            @if (IsSource) { <FormSection Title="@T("AgentYaml")" Description="@T("AgentYamlHelp")" TestId="agent-yaml-editor"><ResourceYamlEditor @bind-Value="rawYaml" ReadOnly="@(!CanEditRaw)" Busy="saving" Error="@rawError" Label="@T("ResourceManifest")" Feedback="@yamlFeedback" Actions="@(CanManage ? yamlActions : null)" /></FormSection> }
            <div hidden="@IsSource">@definitionContent</div>
        </div>
    }
    else
    {
        <ConsoleResourceDetailsTemplate Resource="savedResource" RequestedAddress="@ResourceAddress.Create(AgentResourceNamespace, AgentResourceKinds.Agent, Name!)" Name="@(savedResource?.Definition.DisplayName ?? Name!)" ResourceType="@T("Agent")" Domain="agent" Icon="◎"
                                 Description="@(savedResource?.Definition.Description)" StatusText="@(savedResource is null ? null : HeaderStatus)" Status="HeaderStatusTone"
                                 Feedback="@feedback" LoadState="loadState" OnRetry="RetryLoadAsync" OnRefresh="RefreshAsync" HasDraft="@isDirty" TestId="agent-resource-details"
                                 DefinitionSections="AgentDefinitionSections" SectionState="sectionState" ResourceIdentity="@($"{loadedKey}|{selectedScope}|{ContextScopeRef}")" NavigationLabel="@T("AgentSections")"
                                 NavigationTestId="agent-sections" SelectionChanged="SectionSelected" SectionTestIdPrefix="agent"
                                 YamlTitle="@T("AgentYaml")" YamlDescription="@T("AgentYamlHelp")"
                                 @bind-Yaml="rawYaml" YamlReadOnly="@(!CanEditRaw)" Busy="saving" YamlError="@rawError" YamlLabel="@T("ResourceManifest")"
                                 SectionPresentations="presentations">
            <OverviewMetrics>
                <MetricCard Label="@T("DesiredGeneration")" Value="@generation.ToString(System.Globalization.CultureInfo.CurrentCulture)" Detail="@(isDirty ? T("ModifiedNotSaved") : T("SavedDefinition"))" />
                <MetricCard Label="@T("ActiveGeneration")" Value="@(ActiveGeneration?.ToString(System.Globalization.CultureInfo.CurrentCulture) ?? T("NoActiveGeneration"))"
                            Detail="@ActiveRuntime" Url="@ActiveRuntimeUrl" Status="@(readiness?.Ready == true ? UiStatus.Success : UiStatus.Neutral)" />
                <MetricCard Label="@T("Deployment")" Value="@DeploymentMetricValue" Detail="@DeploymentMetricDetail"
                            Status="@DeploymentMetricTone" />
            </OverviewMetrics>
            <OverviewConfiguration>@overviewConfiguration</OverviewConfiguration>
            <OverviewContent>@overviewContent</OverviewContent>
            <DefinitionContent Context="section">@definitionContent</DefinitionContent>
            <Metadata>@if (savedResource is not null) { <span>@T("Generation", generation)</span> }</Metadata>
            <PrimaryActions>@if (savedResource is not null && AgentResourceNamespace.IsDefault) { <a class="button-primary" href="@RunUrl">@T("Run")</a> }</PrimaryActions>
            <Actions>@if (CanManage) { <button class="button-secondary" type="button" @onclick="ReconcileAsync" disabled="@(saving || refreshing || isDirty)" title="@(isDirty ? T("SaveBeforeApply") : null)">@T("ReconcileDeployment")</button> }@if (SafeReturnUrl is { } returnUrl) { <a class="button-secondary" href="@returnUrl" data-testid="agent-context-return">@T("ReturnToSource")</a> }</Actions>
            <DraftActions>
                <button class="text-button" type="button" data-testid="agent-discard" @onclick="DiscardAsync" disabled="@(saving || refreshing)">@T("Discard")</button>
                @if (IsSource)
                {
                    <button class="button-primary" type="button" @onclick="SaveRawAsync" disabled="@(saving || refreshing || !CanEditRaw)">@(saving ? T("Saving") : T("SaveYaml"))</button>
                }
                else
                {
                    <button class="button-secondary" type="submit" form="agent-resource-form" data-testid="agent-save-draft" @onclick="() => applyRuntimeOnSubmit = false" disabled="@(saving || refreshing || HasRawDraft)">@T("SaveDraft")</button>
                    <button class="button-primary" type="submit" form="agent-resource-form" @onclick="() => applyRuntimeOnSubmit = true" disabled="@(saving || refreshing || HasRawDraft)">@(saving ? T("Applying") : T("SaveAndApply"))</button>
                }
            </DraftActions>
        </ConsoleResourceDetailsTemplate>
    }
}

@code {
    private RenderFragment IdentityFields { get { var model = this.model!; return @<ResourceIdentityEditor
        ResourceKind="@AgentResourceKinds.Agent" DisplayName="@model.DisplayName" DisplayNameChanged="value => model.DisplayName = value" DisplayNameExpression="@(() => model.DisplayName)"
        TechnicalName="@model.Name" TechnicalNameChanged="value => model.Name = value" TechnicalNameExpression="@(() => model.Name)"
        Namespace="@model.Namespace" NamespaceExpression="@(() => model.Namespace)" ScopeRef="selectedScope" ScopeRefChanged="ScopeChanged"
        @bind-Description="model.Description" @bind-Labels="model.Tags" IsNew="IsNew" ReadOnly="@(!CanManage)"
        TestId="agent-identity-section" DisplayNameTestId="agent-display-name" TechnicalNameTestId="agent-name" DescriptionTestId="agent-description" />; } }
    private RenderFragment ConfigurationFields { get { var model = this.model!; return @<div class="resource-editor-view">        <FormSection Title="@T("Configuration")" TestId="agent-behavior-section">
            <FormGrid>
                <FormField Required="true" Label="@T("Handler")"><ChildContent><ClearableText @bind-Value="model.Handler" data-testid="agent-handler" /></ChildContent><Validation><ValidationMessage For="() => model.Handler" /></Validation></FormField>
                <FormField Required="true" Label="@T("Instructions")" Class="form-span-2"><ChildContent><ClearableText Multiline @bind-Value="model.Instructions" rows="6" data-testid="agent-instructions" /></ChildContent><Validation><ValidationMessage For="() => model.Instructions" /></Validation></FormField>
            </FormGrid>
        </FormSection>

</div>; } }
    private RenderFragment ExecutionFields { get { var model = this.model!; return @<div class="resource-editor-view">        <FormSection Title="@T("ModelConfiguration")" TestId="agent-model-section">
                <FormField Required="true" Label="@T("ModelProfile")" Class="form-span-2"><ChildContent><ModelProfilePicker ShowHeading="false" Value="@model.ModelProfileName" Namespace="@model.ModelProfileNamespace" ScopeRef="@model.ModelProfileScopeRef" ValueChanged="ModelProfileChanged" SelectedChanged="ModelProfileSelectionChanged" @key="selectedScope" /></ChildContent><Validation><ValidationMessage For="() => model.ModelProfileName" /><ValidationMessage For="() => model.ModelProfileNamespace" /></Validation></FormField>
        </FormSection>
        <FormSection Title="@T("Execution")" TestId="agent-runtime-section">
                <FormField Required="true" Label="@T("RuntimeProfile")" Class="form-span-2"><ChildContent><ClearableSelect TValue="string" Value="@RuntimeProfileValue" ValueChanged="value => RuntimeProfileChanged(new ChangeEventArgs { Value = value })" ValueExpression="() => model.RuntimeProfileName" data-testid="agent-runtime-profile"><option value="">@Shared["NoSelection"]</option>@foreach (var profile in runtimeProfiles) { <option value="@RuntimeProfileValueFor(profile)">@profile.Properties.DisplayName — @(profile.ScopeRef?.Value ?? "?") · @profile.Namespace/@profile.Name</option> }</ClearableSelect><small>@T("RuntimeProfileHelp")</small></ChildContent><Validation><ValidationMessage For="() => model.RuntimeProfileName" /></Validation></FormField>
        </FormSection></div>; } }
    private RenderFragment ToolsFields { get { return @<div class="resource-editor-view">            <AgentToolSetConfiguration Versions="VisibleToolSetVersions" Selected="SelectedToolSets" SelectedChanged="UpdateSelectedToolSets" />
            <AgentToolConfiguration Tools="VisibleTools" Providers="VisibleProviders" Categories="VisibleCategories" SelectedToolIds="SelectedToolIds" ToolSetGrantedTools="ToolSetGrantedTools" SelectedToolIdsChanged="UpdateSelectedTools" /></div>; } }
    private RenderFragment ContractsFields { get { var model = this.model!; return @<div class="resource-editor-view">            <FormSection Title="@T("InvocationContracts")" Eyebrow="@T("Contracts")" Description="@T("InvocationContractsHelp")" TestId="agent-contracts-section"><ChildContent>
                <ContractDirectionTabs Label="@T("InvocationContracts")" InputLabel="@T("InputContract")"
                    OutputLabel="@T("OutputContract")" TestId="agent-contract">
                    <InputContent>
                        <ReusableSchemaBindingEditor Title="@T("InputContract")" TestId="agent-input-schema"
                            Binding="model.InputSchemaBinding" LegacySchema="model.InputSchema" ValueChanged="UpdateAgentInputSchemaAsync" />
                    </InputContent>
                    <OutputContent>
                        <p class="muted">@T("OutputInstructionHelp")</p>
                        <FormField Label="@T("OutputResolution")">
                            <ClearableSelect TValue="string" AllowClear="false" disabled="@(model.OutputSchema is not null || model.OutputSchemaBinding is not null)" Value="@(model.OutputContract?.Mode == Agentstration.Schemas.DataContractMode.Dynamic ? model.OutputContract.Source : model.OutputSchema is not null || model.OutputSchemaBinding is not null || model.OutputContract?.Mode == Agentstration.Schemas.DataContractMode.Fixed ? "fixed" : "absent")" ValueChanged="value => UpdateOutputResolution(new ChangeEventArgs { Value = value })">
                                <option value="fixed" disabled>@T("OutputResolution.Fixed")</option>
                                <option value="absent">@T("OutputResolution.Absent")</option>
                                <option value="input">@T("OutputResolution.Input")</option>
                                <option value="parent">@T("OutputResolution.Parent")</option>
                            </ClearableSelect>
                        </FormField>
                        <FormField Label="@T("OutputMediaType")"><ClearableText Disabled="@(model.OutputContract?.Mode == Agentstration.Schemas.DataContractMode.Dynamic)" Value="@model.OutputContract?.MediaType" ValueChanged="value => UpdateOutputMediaType(new ChangeEventArgs { Value = value })" /></FormField>
                        <ReusableSchemaBindingEditor Title="@T("OutputContract")" TestId="agent-output-schema"
                            Binding="model.OutputSchemaBinding" LegacySchema="model.OutputSchema" ValueChanged="UpdateAgentOutputSchemaAsync" />
                    </OutputContent>
                </ContractDirectionTabs>
            </ChildContent></FormSection></div>; } }
    private RenderFragment CreationTools => @<div>@if (ToolsVisited) { @ToolsFields }</div>;
    private RenderFragment CreationContracts => @<div>@if (ContractsVisited) { @ContractsFields }</div>;
    private RenderFragment CreationReview => @<FormSection Title="@Shared["Verification"]"><ChildContent><dl class="resource-details"><dt>@T("Identity")</dt><dd>@model!.DisplayName<br /><code>@model.Namespace/@model.Name</code></dd><dt>@Shared["Scope"]</dt><dd><ResourceScopeBadge ScopeRef="selectedScope" /></dd><dt>@T("Instructions")</dt><dd class="configuration-value">@model.Instructions</dd><dt>@T("ModelProfile")</dt><dd>@model.ModelProfileNamespace/@model.ModelProfileName</dd><dt>@T("RuntimeProfile")</dt><dd>@model.RuntimeProfileNamespace/@model.RuntimeProfileName</dd><dt>@T("Tools")</dt><dd>@string.Join(", ", SelectedToolIds)</dd><dt>@T("GovernedToolSets")</dt><dd>@string.Join(", ", model.ToolSets.Select(t => t.ToolSet.Name))</dd></dl></ChildContent></FormSection>;
    private ResourceDefinitionForm? definitionForm;
    private RenderFragment<string> DefinitionSectionContent => path => path switch
    {
        "definition/identity" => IdentityFields,
        "definition/configuration" => ConfigurationFields,
        "definition/model-execution" => ExecutionFields,
        "definition/tools" => ToolsFields,
        "definition/contracts" => ContractsFields,
        _ => throw new ArgumentOutOfRangeException(nameof(path))
    };
    private EditContext? editContext;
    private IReadOnlyDictionary<string, string> ValidationFieldLabels => new Dictionary<string, string>(StringComparer.Ordinal)
    {
        [nameof(AgentEditorModel.Name)] = IdentityLocalizer["TechnicalName"],
        [nameof(AgentEditorModel.Namespace)] = Shared["Namespace"],
        [nameof(AgentEditorModel.DisplayName)] = IdentityLocalizer["DisplayName"],
        [nameof(AgentEditorModel.Handler)] = T("Handler"),
        [nameof(AgentEditorModel.Instructions)] = T("Instructions"),
        [nameof(AgentEditorModel.ModelProfileName)] = T("ModelProfile"),
        [nameof(AgentEditorModel.ModelProfileNamespace)] = $"{T("ModelProfile")} / {Shared["Namespace"]}",
        [nameof(AgentEditorModel.RuntimeProfileName)] = T("RuntimeProfile"),
        [nameof(AgentEditorModel.RuntimeProfileNamespace)] = $"{T("RuntimeProfile")} / {Shared["Namespace"]}"
    };
    private EditContext FormContext => editContext is not null && ReferenceEquals(editContext.Model, model) ? editContext : editContext = new(model!);
    private CreationWizard? creationWizard;
    private bool ValidCreationFields(params string[] fields) => model is not null && fields.All(field => System.ComponentModel.DataAnnotations.Validator.TryValidateProperty(typeof(AgentEditorModel).GetProperty(field)!.GetValue(model), new(model) { MemberName = field }, null));
    private bool CreationIdentityComplete => selectedScope is not null && ValidCreationFields(nameof(AgentEditorModel.Name), nameof(AgentEditorModel.DisplayName), nameof(AgentEditorModel.Namespace))
        && ValidTags && !FormContext.GetValidationMessages(new FieldIdentifier(model!, nameof(AgentEditorModel.Tags))).Any();
    private bool CreationConfigurationComplete => ValidCreationFields(nameof(AgentEditorModel.Handler), nameof(AgentEditorModel.Instructions));
    private bool ValidTags { get { try { if (model is not null) _ = model.ToRequest(); return true; } catch (ArgumentException) { return false; } } }
    private bool CreationExecutionComplete => ValidCreationFields(nameof(AgentEditorModel.ModelProfileName), nameof(AgentEditorModel.RuntimeProfileName));
    private IReadOnlyList<CreationWizardStep> CreationSteps =>
    [
        new("identity", T("Identity"), IdentityFields) { IsComplete = CreationIdentityComplete },
        new("configuration", T("Configuration"), ConfigurationFields) { IsComplete = CreationConfigurationComplete },
        new("model-execution", T("ModelAndExecution"), ExecutionFields) { IsComplete = CreationExecutionComplete },
        new("tools", T("Tools"), CreationTools),
        new("contracts", T("Contracts"), CreationContracts),
        new("review", Shared["Verification"], CreationReview) { IsComplete = CreationIdentityComplete && CreationConfigurationComplete && CreationExecutionComplete }
    ];
    private void CreationStepChanging(CreationWizardStepChange step) { if (step.To is "tools" or "contracts") sectionState.Visit("definition/" + step.To); }
    private async Task FinishCreationAsync(CreationWizardFinish finish)
    {
        var valid = FormContext.Validate();
        if (!valid || !CreationIdentityComplete || !CreationConfigurationComplete || !CreationExecutionComplete)
        {
            definitionForm?.RequestValidationFocus();
            finish.ReturnToStepId = !CreationIdentityComplete ? "identity" : !CreationConfigurationComplete ? "configuration" : "model-execution";
            if (selectedScope is null) errorMessage = T("CreationScopeRequired");
            else if (!ValidTags) errorMessage = T("CreationIdentityInvalid");
            return;
        }
        await SaveAsync(applyRuntime: true);
    }

    [Parameter] public string? Name { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "namespace")] public string? AgentNamespace { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "scopeRef")] public string? ScopeRefValue { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "context")] public string? ContextScopeRef { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string ModelStatusLabel(string? status) => Localizer[$"Status.{status?.ToLowerInvariant() switch { "available" => "Available", "ready" => "Ready", "succeeded" => "Succeeded", "starting" => "Starting", "providerunavailable" => "ProviderUnavailable", "modelunavailable" => "ModelUnavailable", "unavailable" => "Unavailable", "invalidconfiguration" => "InvalidConfiguration", "incompatible" => "Incompatible", "failed" => "Failed", _ => "Unknown" }}"];

    private readonly CancellationTokenSource cancellation = new();
    private string? loadedKey;
    private long loadVersion;
    private AgentEditorModel? model;
    private AgentResource? savedResource;
    private readonly ResourceSectionState sectionState = new();
    private bool IsOverview => sectionState.Is("overview");
    private bool IsSource => sectionState.Is("yaml");
    private bool IsTools => sectionState.Is("definition/tools");
    private bool IsContracts => sectionState.Is("definition/contracts");
    private bool IsAccess => sectionState.Is("access");
    private bool IsModel => sectionState.Is("definition/model-execution");
    private bool ToolsVisited => sectionState.HasVisited("definition/tools");
    private bool ContractsVisited => sectionState.HasVisited("definition/contracts");
    private IReadOnlyList<ToolResource> catalogTools = [];
    private IReadOnlyList<ToolProviderResource> catalogProviders = [];
    private IReadOnlyList<ToolCategoryResource> catalogCategories = [];
    private IReadOnlyList<ToolSetVersionResource> catalogToolSetVersions = [];
    private IReadOnlyList<RuntimeProfileSummaryResponse> runtimeProfiles = [];
    private string? etag;
    private string? errorMessage;
    private string? errorId;
    private string? successMessage;
    private string? modelResolutionWarning;
    private string rawYaml = string.Empty;
    private string? rawError;
    private AgentModelResponse? agentModel;
    private AgentRuntimeReadinessResponse? readiness;
    private AgentRevision? activeRevision;
    private string provisioningStatus = "Valid";
    private long generation;
    private bool loading = true;
    private bool refreshing;
    private ResourceLoadState loadState = new(ResourceLoadStatus.Loading);
    private AgentResource? newerResource;
    private string? newerEtag;
    private bool saving;
    private bool invalidInput;
    private string savedFingerprint = string.Empty;
    private string rawBaseline = string.Empty;
    private string rawModelFingerprint = string.Empty;
    private bool rawInitialized;
    private bool rawUsesSavedDefinition;
    private bool CanEditRaw => CanManage && !invalidInput && !rawUsesSavedDefinition;
    private bool HasRawDraft => rawInitialized && rawYaml != rawBaseline;
    private void ScopeChanged(ResourceScopeRef? value)
    {
        var initializing = IsNew && selectedScope is null && Fingerprint == savedFingerprint;
        selectedScope = value;
        if (initializing) savedFingerprint = Fingerprint;
    }
    private string Fingerprint => JsonSerializer.Serialize(new { model, selectedScope });
    private bool isDirty => !loading && model is not null && CanManage && (Fingerprint != savedFingerprint || HasRawDraft || invalidInput);
    private bool applyRuntimeOnSubmit = true;
    private bool interactive;
    private ResourceScopeRef? selectedScope;
    private ResourceGovernance governance = ResourceGovernance.User;
    private bool IsNew => string.IsNullOrWhiteSpace(Name);
    private bool CanManage => IsNew || !governance.IsManaged && ResourceOwnershipContext.CanManage(selectedScope, Services);
    private string? SafeReturnUrl => ConsoleResourceUrls.LocalReturnUrl(ReturnUrl);
    private ResourceNamespace AgentResourceNamespace => string.IsNullOrWhiteSpace(AgentNamespace) ? ResourceNamespace.Default : ResourceNamespace.Parse(AgentNamespace);
    private string OverviewUrl => AgentResourceNamespace.IsDefault
        ? $"/agents/{Uri.EscapeDataString(Name ?? string.Empty)}"
        : $"/agents/{Uri.EscapeDataString(Name ?? string.Empty)}?namespace={Uri.EscapeDataString(AgentResourceNamespace.Value)}";
    private string RunUrl => $"{OverviewUrl}/run";
    private bool IsStateSynchronized => !isDirty && readiness?.Ready == true && readiness.Generation == generation;
    private long? ActiveGeneration => readiness?.Ready == true ? readiness.Generation : null;
    private string ActiveStatus => readiness switch
    {
        { Ready: true } => T("Ready"),
        { State: "agent_version_not_found" } => T("AgentVersionNotFound", generation),
        { State: "agent_deployment_not_found" } => T("AgentDeploymentNotFound"),
        { Error: { Length: > 0 } error } => error,
        { State: { Length: > 0 } state } => StatusPresentation.Label(state),
        _ => T("NotDeployed")
    };
