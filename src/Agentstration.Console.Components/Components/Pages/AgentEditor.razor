    private async Task<IReadOnlyList<ToolSetVersionResource>> LoadToolSetVersionsAsync()
    {
        var toolSets = await ToolSetsClient.GetToolSetsAsync(cancellation.Token);
        var tasks = toolSets.Select(value => ToolSetsClient.GetVersionsAsync(value.Namespace, value.Name, cancellation.Token)).ToArray();
        await Task.WhenAll(tasks);
        return tasks.SelectMany(task => task.Result).ToArray();
    }
    private void DiscardAsync()
    {
        if (saving || savedResource is null) return;
        model = AgentEditorModel.FromResource(savedResource);
        selectedScope = savedResource.ScopeRef;
        rawInitialized = rawUsesSavedDefinition = false; rawYaml = string.Empty; rawError = errorMessage = errorId = successMessage = null;
        invalidInput = false; savedFingerprint = Fingerprint;
    }
