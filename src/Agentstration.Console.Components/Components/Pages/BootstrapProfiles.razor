@page "/settings/bootstrap"
@implements IDisposable
@using Agentstration.Web.Components.Bootstrap
@inject IBootstrapProfilesApiClient Client
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<BootstrapProfilesStrings> Localizer

<div class="bootstrap-management-page">
<PageTitle>@T("PageTitle")</PageTitle>
@if (screen == BootstrapScreen.Prepare)
{
<div class="bootstrap-catalog">
<ResourceCollectionTemplate TItem="BootstrapProfileSummary" Title="@T("Title")" Description="@T("Description")"
                            TestId="distribution-bootstrap-profiles" RowTestId="bootstrap-profile-row" ContextKey="bootstrap-catalog"
                            IdentityColumn="ProfileIdentity" Columns="ProfileColumns" Items="@ProfilePage" Query="catalogQuery" QueryChanged="CatalogQueryChanged"
                            Pagination="ProfilePagination" LoadState="CatalogLoadState" Disabled="@busy" OnRefresh="LoadAsync" OnRetry="LoadAsync"
                            SearchEnabled SearchLabel="@T("SearchProfiles")" SearchPlaceholder="@T("SearchProfiles")"
                            EmptyTitle="@T("NoBootstrapProfile")" EmptyMessage="@T("NoBootstrapProfileMessage")">
    <Metrics>
        @if (view is not null && !denied)
        {
            <MetricCard Label="@T("Profiles")" Value="@view.Catalog.Profiles.Count.ToString()" Detail="@T("CatalogDirectories")" Status="UiStatus.Info" />
            <MetricCard Label="@T("InitialBootstrap")" Value="@(view.Catalog.InitialBootstrapEnabled ? T("Enabled") : T("Disabled"))" Detail="@T("StartupApplicationOnly")" Status="@(view.Catalog.InitialBootstrapEnabled ? UiStatus.Success : UiStatus.Neutral)" />
            <MetricCard Label="@T("InitialProfiles")" Value="@view.Catalog.InitialProfiles.Count.ToString()" Detail="@InitialProfilesLabel" Status="UiStatus.Info" />
            <MetricCard Label="@T("Applications")" Value="@view.Applications.Count.ToString()" Detail="@T("LatestRetainedRuns")" Status="@(view.Applications.Any(item => item.Definition.Status is BootstrapApplicationStatus.Failed or BootstrapApplicationStatus.PartiallyApplied or BootstrapApplicationStatus.Interrupted) ? UiStatus.Warning : UiStatus.Success)" />
        }
    </Metrics>
    <Actions><button type="button" class="button-secondary" @onclick="() => configurationOpen = true">@T("CatalogConfiguration")</button></Actions>
    <Feedback>
        @if (view is not null && !denied && error is not null) { <p class="error-panel" role="alert">@error</p> }
    </Feedback>
</ResourceCollectionTemplate>
</div>
}
else
{
    <PageHeader Title="@(screen == BootstrapScreen.Preview ? T("Preview") : T("ApplicationTitle"))" Description="@T("Description")">
        <Actions><button type="button" class="button-secondary" disabled="@busy" @onclick="BackToPreparation">@T("BackToSelection")</button></Actions>
    </PageHeader>
    @if (error is not null) { <p class="error-panel" role="alert">@error</p> }
}
@if (view is not null && !denied)
{
    <div class="bootstrap-workflow">
    @if (screen == BootstrapScreen.Prepare)
    {
        @if (selectedProfiles.Count > 0)
        {
            <FormSection Title="@T("SelectProfiles")"><ChildContent>
                <p>@T("PlanOrderHelp")</p>
                @if (sourceSelection is not null) { <p>@T("SourceSelection", sourceSelection.Publisher, sourceSelection.SourceName, sourceSelection.Locale) <code>@sourceSelection.Path</code></p> }
                @foreach (var group in selectedProfiles.GroupBy(name => Profile(name).Scope))
                {
                    <h3>@ScopeLabel(group.Key)</h3>
                    <ol class="bootstrap-order">
                    @foreach (var name in group)
                    {
                        var profile = Profile(name);
                        var index = selectedProfiles.IndexOf(name);
                        <li data-bootstrap-profile="@name">
                            <div><strong>@profile.DisplayName</strong><small><code>@name</code></small></div>
                            @if (profile.Scope == BootstrapProfileScope.Instance) { <span>@T("Instance")</span> }
                            else
                            {
                                <FormField Label="@T("TargetForProfile", profile.DisplayName)" Class="bootstrap-target">
                                    <ClearableSelect TValue="string" Value="@targetChoices.GetValueOrDefault(name, string.Empty)" ValueChanged="value => SelectProfileTargetAsync(name, value)" disabled="@busy" data-target-profile="@name">
                                        <option value="">@(profile.Scope == BootstrapProfileScope.Tenant ? T("SelectTenant") : T("SelectWorkspace"))</option>
                                        @foreach (var target in TargetOptions(name)) { <option value="@target.Value">@target.Label</option> }
                                    </ClearableSelect>
                                </FormField>
                            }
                            <span class="bootstrap-order-actions">
                                <button type="button" class="text-button" disabled="@(busy || !CanMove(index, -1))" @onclick="() => Move(index, -1)">@T("Up")</button>
                                <button type="button" class="text-button" disabled="@(busy || !CanMove(index, 1))" @onclick="() => Move(index, 1)">@T("Down")</button>
                            </span>
                        </li>
                    }
                    </ol>
                }
            </ChildContent></FormSection>
        }
        @if (SelectedBindings.Count > 0)
        {
            <FormSection Title="@T("ResolveBindings")"><ChildContent><div class="bootstrap-binding-grid">
            @foreach (var item in SelectedBindings)
            {
                var key = BindingKey(item.Profile, item.Binding.Name);
                var input = bindingTargets[key];
                var options = BindingOptions(item.Profile, item.Binding.TargetKind);
                <fieldset class="bootstrap-binding" data-target-kind="@item.Binding.TargetKind">
                    <legend>@item.Binding.DisplayName</legend>
                    <p><code>@item.Profile/@item.Binding.Name</code> · @BindingTargetKindLabel(item.Binding.TargetKind)</p>
                    @if (item.Binding.Description is not null) { <p class="muted">@item.Binding.Description</p> }
                    <FormField Label="@T("Resource")"><ClearableSelect TValue="string" Value="@BindingTargetValue(input)" disabled="@busy" ValueChanged="value => UpdateBindingTarget(key, new ChangeEventArgs { Value = value })">
                        <option value="">@T("SelectCompatibleResource")</option>
                        @foreach (var option in options) { <option value="@BindingTargetValue(option)">@option.DisplayName — @(option.ScopeRef?.Value ?? T("InheritedScope"))/@option.Namespace/@option.Name@(option.TargetProfile is { } producer ? $" [{producer}]" : null)@(option.Planned ? $" ({T("Planned")})" : null)</option> }
                    </ClearableSelect></FormField>
                </fieldset>
            }
            </div></ChildContent></FormSection>
        }
        @if (selectedProfiles.Count > 0)
        {
            <FormActions><button type="button" class="button-primary" disabled="@(!CanPreview || busy)" @onclick="PreviewAsync">@(previewing ? T("Previewing") : T("PreviewApplication"))</button></FormActions>
        }
    <FormSection Title="@T("ApplicationHistory")" Eyebrow="@T("AuditTrail")"><ChildContent>
        @if (view.Applications.Count == 0) { <EmptyState Title="@T("NoManualApplication")" Message="@T("NoManualApplicationMessage")" /> }
        else
        {
            <CollectionView TItem="BootstrapApplicationResource" Items="view.Applications" InformationLabels="@(new string[] { T("Started"), T("Results") })" IdentityLabel="@T("Profiles")" ScopeLabel="@T("Target")" StateLabel="@T("Status")">
        <Identity Context="application">
@string.Join(" → ", application.Definition.Profiles)</Identity>
        <Scope Context="application">
@ApplicationTargetLabel(application)</Scope>
        <State Context="application">
<StatusBadge Text="@ApplicationStatusLabel(application.Definition.Status)" Status="@ApplicationTone(application.Definition.Status)" /></State>
        <Information Context="application">
            <CollectionValue Label="@T("Started")">@application.Definition.StartedAt.ToLocalTime().ToString("g")</CollectionValue>
            <CollectionValue Label="@T("Results")">@ProgressLabel(application)</CollectionValue>
        </Information>
        <Actions Context="application">
<CollectionActions ResourceName="@(application.Metadata.Name)"><button class="text-button" disabled="@busy" @onclick="() => ShowApplicationAsync(application.Metadata.Name)">@T("View")</button></CollectionActions></Actions>
    </CollectionView>
        }
    </ChildContent></FormSection>


    }
    else if (screen == BootstrapScreen.Preview && preview is not null)
    {
        <FormSection Title="@T("PlanTargets")"><ChildContent>
            @if (PreviewTargets.Any(item => item.ValidationDeferred)) { <p class="inline-warning" role="status">@T("ValidationDeferred")</p> }
            <ol class="bootstrap-preview-targets">@foreach (var item in PreviewTargets) { <li><strong>@item.Profile</strong><span class="bootstrap-preview-target-label">@ScopeLabel(item.Scope) · @item.TargetLabel</span>@if (item.ValidationDeferred) { <StatusBadge Text="@T("ValidationDeferredLabel")" Status="UiStatus.Warning" /> }</li> }</ol>
        </ChildContent></FormSection>
        <FormSection Title="@T("Preview")"><ChildContent>
            <div class="bootstrap-preview-summary"><StatusBadge Text="@(!preview.CanApply ? T("Invalid") : PreviewTargets.Any(item => item.ValidationDeferred) ? T("ValidationDeferredLabel") : T("Ready"))" Status="@(!preview.CanApply ? UiStatus.Danger : PreviewTargets.Any(item => item.ValidationDeferred) ? UiStatus.Warning : UiStatus.Success)" /><span><code>@preview.Digest[..12]</code></span><span>@T("ResourceCount", preview.Resources.Count)</span></div>
            <CollectionView TItem="BootstrapResourcePreview" Items="@preview.Resources.Skip((previewPage - 1) * 25).Take(25).ToArray()" InformationLabels="@(new string[] { T("Profile"), T("Target"), T("Details") })" IdentityLabel="@T("Resource")" StateLabel="@T("ExpectedAction")">
        <Identity Context="item">
<strong>@item.Kind/@item.Name</strong><br /><small>@item.Location</small></Identity>
        <State Context="item">
<StatusBadge Text="@DispositionLabel(item.Disposition)" Status="@DispositionTone(item.Disposition)" /></State>
        <Information Context="item">
            <CollectionValue Label="@T("Profile")"><code>@item.Profile</code></CollectionValue>
            <CollectionValue Label="@T("Target")">@item.TargetLabel</CollectionValue>
            <CollectionValue Label="@T("Details")">@if (item.Message is not null) { <StatusBadge Text="@(item.Message == "bootstrap_validation_after_dependencies" ? T("ValidationDeferredLabel") : item.Message)" Status="UiStatus.Warning" /> }@if (item.Details is { Count: > 0 }) { <ul class="bootstrap-detail-list">@foreach (var detail in item.Details) { <li><span>@detail.Kind/@detail.Name</span><StatusBadge Text="@DispositionLabel(detail.Disposition)" Status="@DispositionTone(detail.Disposition)" /><small>@detail.Description</small></li> }</ul> }</CollectionValue>
        </Information>
    </CollectionView>
            <CollectionPager Page="@previewPage" Total="@preview.Resources.Count" PageSize="25" HasMore="@(previewPage * 25 < preview.Resources.Count)" SupportsDirectNavigation="true" PageChanged="value => previewPage = value" />
            <div class="bootstrap-apply"><p>@T("ApplyDescription")</p><button class="button-primary" disabled="@(!preview.CanApply || busy)" @onclick="() => confirmApply = true">@T("ApplyPreview")</button></div>
        </ChildContent></FormSection>
    }
    else if (screen == BootstrapScreen.Application)
    {
    @if (selectedApplication is not null)
    {
        <FormSection Title="@selectedApplication.Metadata.Name" Eyebrow="@T("LatestResult")" id="bootstrap-application-detail" TestId="bootstrap-application-progress">
            <Actions>
                @if (selectedApplication.Definition.Status == BootstrapApplicationStatus.Running)
                {
                    <button class="button-secondary" disabled="@(busy || selectedApplication.Definition.CancellationRequested)" @onclick="CancelApplicationAsync">@(selectedApplication.Definition.CancellationRequested ? T("CancellationRequested") : T("CancelApplication"))</button>
                }
            </Actions>
            <ChildContent>
                @if (observationInterrupted) { <p class="inline-warning" role="status">@T("ObservationInterrupted")</p> }
                @if (selectedApplication.Definition.Error is not null) { <p class="error-panel" role="alert">@ApplicationError(selectedApplication.Definition.Error)</p> }
                <BootstrapApplicationProgress Application="@selectedApplication" TargetLabel="@ApplicationTargetLabel(selectedApplication)" />
                <details class="bootstrap-application-audit"><summary>@T("ApplicationDetail")</summary>
            <dl class="resource-details">
                <dt>@T("Actor")</dt><dd><code>@selectedApplication.Definition.ActorPrincipalId</code></dd>
                <dt>@T("Source")</dt><dd>@selectedApplication.Definition.Source</dd>
                @if (selectedApplication.Definition.SourceProvenance is { } provenance)
                {
                    <dt>@T("SourceVersion")</dt><dd><code>@provenance.Publisher/@provenance.SourceName@@@provenance.SourceVersion</code></dd>
                    <dt>@T("ContentLocale")</dt><dd>@provenance.Locale</dd>
                    <dt>@T("ContentPath")</dt><dd><code>@provenance.Path</code></dd>
                }
                <dt>@T("Target")</dt><dd>@ApplicationTargetLabel(selectedApplication)</dd>
                <dt>@T("Profiles")</dt><dd>@string.Join(" → ", selectedApplication.Definition.Profiles)</dd>
                <dt>@T("Bindings")</dt><dd>@(selectedApplication.Definition.Bindings.Count == 0 ? T("None") : string.Join(", ", selectedApplication.Definition.Bindings.Select(BindingLabel)))</dd>
                <dt>@T("Digest")</dt><dd><code>@selectedApplication.Definition.Digest</code></dd>
                <dt>@T("Started")</dt><dd>@selectedApplication.Definition.StartedAt.ToLocalTime().ToString("G")</dd>
                <dt>@T("Completed")</dt><dd>@(selectedApplication.Definition.CompletedAt?.ToLocalTime().ToString("G") ?? T("NotCompleted"))</dd>
            </dl>
                </details>
            </ChildContent>
        </FormSection>
    }

    }
    </div>
}
<ModalFrame IsOpen="@configurationOpen" TitleId="bootstrap-catalog-settings-title" OnClose="() => configurationOpen = false">
    <h2 id="bootstrap-catalog-settings-title">@T("CatalogConfiguration")</h2>
    @if (view is not null)
    {
        <dl class="resource-details"><dt>@T("Path")</dt><dd><code>@(view.Catalog.Path ?? T("NotConfigured"))</code></dd><dt>@T("Startup")</dt><dd>@(view.Catalog.InitialBootstrapEnabled ? T("Enabled") : T("Disabled"))</dd><dt>@T("InitialOrder")</dt><dd>@InitialProfilesLabel</dd></dl>
        @if (view.Catalog.Error is not null) { <p class="error-panel">@view.Catalog.Error</p> }
    }
    <FormActions><button type="button" class="button-secondary" @onclick="() => configurationOpen = false">@T("CloseConfiguration")</button></FormActions>
</ModalFrame>
@if (confirmApply && preview is not null)
{
    <ModalFrame IsOpen="true" Busy="@applying" TitleId="bootstrap-confirm-title" OnClose="() => confirmApply = false">
            <h2 id="bootstrap-confirm-title">@T("ApplyBootstrapProfiles")</h2>
            <p>@T("ApplyConfirmation")</p>
            <p><strong>@string.Join(" → ", selectedProfiles)</strong><br />@string.Join(" · ", PreviewTargets.Select(item => item.TargetLabel))</p>
            <FormActions Class="dialog-actions"><button class="button-secondary" disabled="@applying" @onclick="() => confirmApply = false">@T("Cancel")</button><button class="button-primary" disabled="@applying" @onclick="ApplyAsync">@(applying ? T("Applying") : T("ApplyProfiles"))</button></FormActions>
    </ModalFrame>
}

</div>

@code {
    [SupplyParameterFromQuery(Name = "stage")] public string? Stage { get; set; }
    [SupplyParameterFromQuery(Name = "applicationId")] public string? ApplicationId { get; set; }
    [SupplyParameterFromQuery(Name = "sourceScope")] public string? SourceScope { get; set; }
    [SupplyParameterFromQuery(Name = "publisher")] public string? SourcePublisher { get; set; }
    [SupplyParameterFromQuery(Name = "source")] public string? SourceName { get; set; }
    [SupplyParameterFromQuery(Name = "versionUid")] public Guid? SourceVersionUid { get; set; }
    [SupplyParameterFromQuery(Name = "channel")] public string? SourceChannel { get; set; }
    [SupplyParameterFromQuery(Name = "snapshotUid")] public Guid? SourceSnapshotUid { get; set; }
    [SupplyParameterFromQuery(Name = "catalog")] public string? SourceCatalog { get; set; }
    [SupplyParameterFromQuery(Name = "entry")] public string? SourceEntry { get; set; }
    [SupplyParameterFromQuery(Name = "locale")] public string? SourceLocale { get; set; }
    [SupplyParameterFromQuery(Name = "path")] public string? SourcePath { get; set; }

    private CollectionQuery catalogQuery = new() { PageSize = 20 };
    private ResourceLoadState CatalogLoadState => denied ? new(ResourceLoadStatus.Forbidden)
        : view is null ? error is null ? new(ResourceLoadStatus.Loading) : new(ResourceLoadStatus.Failed) { Message = error }
        : busy ? new(ResourceLoadStatus.Refreshing) { HasContent = true } : new(ResourceLoadStatus.Ready);
    private IReadOnlyList<BootstrapProfileSummary> CatalogProfiles => sourceProfile is not null ? [sourceProfile] : view?.Catalog.Profiles ?? [];
    private IReadOnlyList<BootstrapProfileSummary> FilteredProfiles => CatalogProfiles.Where(profile =>
        (string.IsNullOrWhiteSpace(catalogQuery.Search) || profile.Name.Contains(catalogQuery.Search, StringComparison.OrdinalIgnoreCase)
            || profile.DisplayName.Contains(catalogQuery.Search, StringComparison.OrdinalIgnoreCase)
            || profile.Description?.Contains(catalogQuery.Search, StringComparison.OrdinalIgnoreCase) == true)
        && (string.IsNullOrEmpty(catalogQuery.Filter("scope").Value) || profile.Scope.ToString() == catalogQuery.Filter("scope").Value)).ToArray();
    private IReadOnlyList<BootstrapProfileSummary> ProfilePage => FilteredProfiles.Skip((catalogQuery.Page - 1) * catalogQuery.PageSize).Take(catalogQuery.PageSize).ToArray();
    private CollectionPagination ProfilePagination => new(catalogQuery.Page, catalogQuery.PageSize, catalogQuery.Page * catalogQuery.PageSize < FilteredProfiles.Count)
    { Total = FilteredProfiles.Count, SupportsDirectNavigation = true, PageSizes = [20, 50, 100] };
    private void CatalogQueryChanged(CollectionQuery query) => catalogQuery = query;
    private CollectionColumn<BootstrapProfileSummary> ProfileIdentity => new("identity", T("Profile"), profile => @<label class="bootstrap-profile-card @(selectedProfiles.Contains(profile.Name) ? "selected" : null)">
        <FormCheckbox Value="@selectedProfiles.Contains(profile.Name)" disabled="@(!CanSelect(profile) || busy)" ValueChanged="changed => ToggleProfile(profile, new ChangeEventArgs { Value = changed })" data-profile-name="@profile.Name" />
        <span><strong>@profile.DisplayName</strong><small><code>@profile.Name</code></small>@if (!profile.Valid) { <span class="inline-warning">@profile.Error</span> }</span>
    </label>);
    private IReadOnlyList<CollectionColumn<BootstrapProfileSummary>> ProfileColumns =>
    [
        new("scope", T("Target"), profile => @<span>@ScopeLabel(profile.Scope)</span>)
        {
            Filters = [new("scope", T("Target"), CollectionFilterKind.Choice) { Options = Enum.GetValues<BootstrapProfileScope>().Select(scope => new CollectionFilterOption(scope.ToString(), ScopeLabel(scope))).ToArray() }]
        },
        new("resources", T("Resources"), profile => @<span>@profile.ResourceCount</span>),
        new("description", T("Details"), profile => @<span>@profile.Description</span>)
    ];

    private readonly CancellationTokenSource lifetime = new();
    private BootstrapManagementView? view;
    private BootstrapCompositionPreview? preview;
    private BootstrapApplicationResource? lastApplication;
    private BootstrapApplicationResource? selectedApplication;
    private readonly List<string> selectedProfiles = [];
    private BootstrapSourceProfileSelection? sourceSelection;
    private BootstrapProfileSummary? sourceProfile;
    private readonly Dictionary<string, BindingInput> bindingTargets = new(StringComparer.Ordinal);
    private readonly Dictionary<string, IReadOnlyList<BootstrapBindingTargetOption>> bindingOptions = [];
    private readonly Dictionary<string, string> targetChoices = new(StringComparer.Ordinal);
    private BootstrapScreen screen;
    private bool configurationOpen;
    private BootstrapProfileSelection? previewSelection;
    private enum BootstrapScreen { Prepare, Preview, Application }
    private string? error;
    private bool denied;
    private bool busy;
    private bool previewing;
    private bool applying;
    private bool confirmApply;
    private bool observationInterrupted;
    private Guid requestId = Guid.NewGuid();
    private Task? observation;

    private IReadOnlyList<(string Profile, BootstrapProfileBinding Binding)> SelectedBindings => selectedProfiles
        .SelectMany(name => Profile(name).Bindings.Where(binding => binding.ExtensionTarget is null).Select(binding => (name, binding))).ToArray();
    private bool CanPreview => selectedProfiles.Count > 0 && selectedProfiles.All(name => Profile(name).Scope == BootstrapProfileScope.Instance || SelectedTarget(name) is not null)
        && SelectedBindings.All(item => !item.Binding.Required || !string.IsNullOrWhiteSpace(bindingTargets[BindingKey(item.Profile, item.Binding.Name)].Name));
    private int previewPage = 1;
    private string InitialProfilesLabel => view is null || view.Catalog.InitialProfiles.Count == 0 ? T("None") : string.Join(" → ", view.Catalog.InitialProfiles);
    private IReadOnlyList<BootstrapProfileApplicationPreview> PreviewTargets => preview?.Applications is { Count: > 0 } entries ? entries
        : preview?.Profiles.Select(item => new BootstrapProfileApplicationPreview(item.Name, item.Scope, TargetLabel(preview.Target), false)).ToArray() ?? [];
    private BootstrapProfileSummary Profile(string name) => sourceProfile?.Name == name ? sourceProfile : view!.Catalog.Profiles.Single(profile => profile.Name == name);

    protected override Task OnInitializedAsync() => LoadAsync();

    protected override async Task OnParametersSetAsync()
    {
        screen = ApplicationId is not null ? BootstrapScreen.Application : Stage == "preview" && preview is not null ? BootstrapScreen.Preview : BootstrapScreen.Prepare;
        if (view is not null && !string.IsNullOrWhiteSpace(ApplicationId)
            && lastApplication?.Metadata.Name != ApplicationId)
            await ShowApplicationAsync(ApplicationId);
    }

    private async Task LoadAsync()
    {
        busy = true; error = null;
        try
        {
            view = await Client.GetAsync(lifetime.Token);
            denied = false;
            if (!string.IsNullOrWhiteSpace(ApplicationId))
            {
                lastApplication = await Client.GetApplicationAsync(ApplicationId, lifetime.Token);
                selectedApplication = lastApplication;
                if (lastApplication is not null) UpdateApplication(lastApplication);
            }
            else
            {
                lastApplication ??= view.Applications.FirstOrDefault();
                selectedApplication ??= lastApplication;
            }
            observation ??= ObserveApplicationsAsync();
            if (TrySourceSelection() is { } selection)
            {
                sourceSelection = selection;
                sourceProfile = await Client.GetSourceProfileAsync(selection, lifetime.Token);
                selectedProfiles.Clear();
                selectedProfiles.Add(sourceProfile.Name);
                SyncBindings();
            }
        }
        catch (AgentstrationApiException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Forbidden) { Deny(); }
        catch (Exception exception) when (exception is not OperationCanceledException) { error = ApplicationError(exception.Message); }
        finally { busy = false; }
    }

    private void Deny()
    {
        denied = true; view = null; selectedApplication = lastApplication = null; sourceProfile = null; sourceSelection = null; preview = null;
        selectedProfiles.Clear(); targetChoices.Clear(); bindingTargets.Clear(); bindingOptions.Clear(); confirmApply = configurationOpen = false; screen = BootstrapScreen.Prepare;
    }

    private bool CanSelect(BootstrapProfileSummary profile) => sourceSelection is null && profile.Valid && (selectedProfiles.Contains(profile.Name) || selectedProfiles.Count < 16);
    private void ToggleProfile(BootstrapProfileSummary profile, ChangeEventArgs args)
    {
        if (args.Value is true && !selectedProfiles.Contains(profile.Name)) selectedProfiles.Add(profile.Name);
        else if (args.Value is not true) { selectedProfiles.Remove(profile.Name); targetChoices.Remove(profile.Name); }
        var ordered = selectedProfiles.OrderBy(name => Profile(name).Scope).ToArray();
        selectedProfiles.Clear(); selectedProfiles.AddRange(ordered);
        SyncBindings(); bindingOptions.Clear(); preview = null; previewSelection = null;
        foreach (var input in bindingTargets.Values.Where(input => input.TargetProfile is { } producer && !selectedProfiles.Contains(producer)))
        { input.Name = string.Empty; input.ScopeRef = null; input.TargetProfile = null; }
    }
    private bool CanMove(int index, int offset) => index + offset >= 0 && index + offset < selectedProfiles.Count
        && Profile(selectedProfiles[index]).Scope == Profile(selectedProfiles[index + offset]).Scope;
    private void Move(int index, int offset)
    {
        if (!CanMove(index, offset)) return;
        var item = selectedProfiles[index]; selectedProfiles.RemoveAt(index); selectedProfiles.Insert(index + offset, item); preview = null;
    }
    private sealed record TargetOption(string Value, string Label, BootstrapApplicationTarget? Target = null, BootstrapPlannedTarget? Planned = null);
    private TargetOption? SelectedTarget(string profile) => TargetOptions(profile).FirstOrDefault(option => option.Value == targetChoices.GetValueOrDefault(profile));
    private IReadOnlyList<TargetOption> TargetOptions(string profile)
    {
        if (view is null) return [];
        var kind = Profile(profile).Scope;
        if (kind == BootstrapProfileScope.Instance) return [];
        var options = kind == BootstrapProfileScope.Tenant
            ? view.Tenants.Select(tenant => new TargetOption(tenant.Id.ToString(), tenant.DisplayName + " — " + tenant.Name, new(tenant.Id))).ToList()
            : view.Workspaces.Select(workspace => new TargetOption(workspace.WorkspaceId.ToString(), workspace.TenantDisplayName + " / " + workspace.WorkspaceDisplayName + " — " + workspace.TenantName + "/" + workspace.WorkspaceName, new(workspace.TenantId, workspace.WorkspaceId))).ToList();
        foreach (var name in selectedProfiles.Where(name => Profile(name).Scope < kind))
        {
            var producer = Profile(name);
            // Tenant selection is acyclic: only Instance profiles can produce its future target.
            var producerTenant = producer.Scope == BootstrapProfileScope.Tenant ? SelectedTarget(name) : null;
            var tenantName = producerTenant?.Planned?.TenantName ?? view.Tenants.FirstOrDefault(tenant => tenant.Id == producerTenant?.Target?.TenantId)?.Name;
            foreach (var item in producer.Topology)
            {
                BootstrapPlannedTarget? planned = kind == BootstrapProfileScope.Tenant && item.Kind == "Tenant" ? new(item.Name)
                    : kind == BootstrapProfileScope.Workspace && item.Kind == "Workspace" && (item.TenantName ?? tenantName) is { } owner ? new(owner, item.Name) : null;
                if (planned is null) continue;
                if (planned.WorkspaceName is null && view.Tenants.Any(tenant => tenant.Name == planned.TenantName)
                    || planned.WorkspaceName is not null && view.Workspaces.Any(workspace => workspace.TenantName == planned.TenantName && workspace.WorkspaceName == planned.WorkspaceName)) continue;
                var value = "planned:" + System.Text.Json.JsonSerializer.Serialize(planned);
                if (!options.Any(option => option.Value == value)) options.Add(new(value, planned.TenantName + (planned.WorkspaceName is null ? string.Empty : " / " + planned.WorkspaceName) + " (" + T("Planned") + ")", Planned: planned));
            }
        }
        return options;
    }
    private async Task SelectProfileTargetAsync(string profile, string value)
    {
        targetChoices[profile] = value; preview = null; previewSelection = null; error = null;
        bindingOptions.Clear();
        foreach (var input in bindingTargets.Values.Where(input => input.TargetProfile is not null)) { input.Name = string.Empty; input.ScopeRef = null; input.TargetProfile = null; }
        foreach (var item in SelectedBindings.Where(item => item.Profile == profile))
            bindingTargets[BindingKey(profile, item.Binding.Name)] = new(item.Binding.DefaultTarget?.Name ?? string.Empty, item.Binding.DefaultTarget?.Namespace?.Value ?? "default", item.Binding.DefaultTarget?.ScopeRef);
        if (!selectedProfiles.All(name => Profile(name).Scope == BootstrapProfileScope.Instance || SelectedTarget(name) is not null)) return;
        busy = true;
        try
        {
            foreach (var item in SelectedBindings.Select(item => (item.Profile, item.Binding.TargetKind)).Distinct())
            {
                var target = SelectedTarget(item.Profile)?.Target;
                var request = sourceSelection is null && selectedProfiles.Count > 1
                    ? new BootstrapBindingTargetsRequest(null, item.TargetKind, [], Applications: Applications(), ConsumerProfile: item.Profile)
                    : new(target, item.TargetKind, sourceSelection is null ? [item.Profile] : [], sourceSelection);
                if (request.Applications is not null || target?.WorkspaceId is not null)
                    bindingOptions[item.Profile + "\n" + item.TargetKind] = await Client.GetBindingTargetsAsync(request, lifetime.Token);
            }
        }
        catch (Exception exception) when (exception is not OperationCanceledException) { error = ApplicationError(exception.Message); }
        finally { busy = false; }
    }
    private IReadOnlyList<BootstrapBindingTargetOption> BindingOptions(string profile, BootstrapBindingTargetKind kind)
    {
        var options = bindingOptions.GetValueOrDefault(profile + "\n" + kind) ?? [];
        var defaults = SelectedBindings.Where(item => item.Profile == profile && item.Binding.TargetKind == kind && item.Binding.DefaultTarget is not null)
            .Select(item => item.Binding.DefaultTarget!).Select(reference => new BootstrapBindingTargetOption(reference.Name, reference.Namespace?.Value ?? "default", reference.Name, Planned: true, ScopeRef: reference.ScopeRef));
        return options.Concat(defaults).DistinctBy(item => (item.TargetProfile, item.ScopeRef, item.Namespace, item.Name)).ToArray();
    }
    private void BackToPreparation()
    {
        screen = BootstrapScreen.Prepare; confirmApply = false;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["stage"] = null, ["applicationId"] = null }));
    }
    private IReadOnlyList<BootstrapBindingSelection> Bindings() => SelectedBindings
        .Where(item => !string.IsNullOrWhiteSpace(bindingTargets[BindingKey(item.Profile, item.Binding.Name)].Name))
        .Select(item =>
        {
            var input = bindingTargets[BindingKey(item.Profile, item.Binding.Name)];
            return new BootstrapBindingSelection(item.Profile, item.Binding.Name, new(input.Name.Trim(), input.ScopeRef, new(string.IsNullOrWhiteSpace(input.Namespace) ? "default" : input.Namespace.Trim())), TargetProfile: input.TargetProfile);
        }).ToArray();

    private async Task PreviewAsync()
    {
        if (!CanPreview) return;
        busy = previewing = true; error = null; lastApplication = null;
        try
        {
            previewSelection = Selection();
            preview = await Client.PreviewAsync(previewSelection, lifetime.Token); previewPage = 1; requestId = Guid.NewGuid();
            screen = BootstrapScreen.Preview;
            Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["stage"] = "preview", ["applicationId"] = null }));
        }
        catch (Exception exception) when (exception is not OperationCanceledException) { error = ApplicationError(exception.Message); }
        finally { busy = previewing = false; }
    }

    private async Task ApplyAsync()
    {
        if (preview is null || applying) return;
        busy = applying = true; error = null;
        try
        {
            lastApplication = await Client.ApplyAsync(previewSelection ?? Selection(), preview.Digest, lifetime.Token, requestId);
            selectedApplication = lastApplication;
            confirmApply = false; preview = null;
            UpdateApplication(lastApplication);
            PinApplication(lastApplication.Metadata.Name);
        }
        catch (Exception exception) when (exception is not OperationCanceledException) { error = ApplicationError(exception.Message); confirmApply = false; }
        finally { busy = applying = false; }
    }

    private async Task ShowApplicationAsync(string applicationId)
    {
        busy = true; error = null;
        try
        {
            selectedApplication = await Client.GetApplicationAsync(applicationId, lifetime.Token);
            if (selectedApplication is not null)
            {
                lastApplication = selectedApplication;
                UpdateApplication(selectedApplication);
                PinApplication(applicationId);
            }
        }
        catch (Exception exception) when (exception is not OperationCanceledException) { error = ApplicationError(exception.Message); }
        finally { busy = false; }
    }

    private void PinApplication(string applicationId)
    {
        screen = BootstrapScreen.Application;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["stage"] = null, ["applicationId"] = applicationId }), replace: true);
    }

    private async Task CancelApplicationAsync()
    {
        if (selectedApplication is null || busy || selectedApplication.Definition.Status != BootstrapApplicationStatus.Running) return;
        busy = true;
        try { UpdateApplication(await Client.CancelAsync(selectedApplication.Metadata.Name, lifetime.Token)); }
        catch (Exception exception) when (exception is not OperationCanceledException) { observationInterrupted = true; }
        finally { busy = false; }
    }

    private async Task ObserveApplicationsAsync()
    {
        var cancellationToken = lifetime.Token;
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                var running = view?.Applications.Where(application => application.Definition.Status == BootstrapApplicationStatus.Running).ToArray() ?? [];
                foreach (var application in running)
                {
                    try
                    {
                        var latest = await Client.GetApplicationAsync(application.Metadata.Name, cancellationToken);
                        if (latest is null) { observationInterrupted = true; continue; }
                        UpdateApplication(latest);
                        observationInterrupted = false;
                    }
                    catch (AgentstrationApiException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Forbidden)
                    {
                        Deny();
                        await InvokeAsync(StateHasChanged);
                        return;
                    }
                    catch (Exception exception) when (exception is not OperationCanceledException)
                    {
                        observationInterrupted = true;
                    }
                }
                if (running.Length > 0) await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    private void UpdateApplication(BootstrapApplicationResource application)
    {
        if (view is not null)
            view = view with { Applications = view.Applications.Where(item => item.Metadata.Name != application.Metadata.Name)
                .Append(application).OrderByDescending(item => item.Definition.StartedAt).ToArray() };
        if (lastApplication?.Metadata.Name == application.Metadata.Name) lastApplication = application;
        if (selectedApplication?.Metadata.Name == application.Metadata.Name) selectedApplication = application;
    }

    private string ApplicationTargetLabel(BootstrapApplicationResource application) => application.Definition.Applications.Count > 0
        ? string.Join(" · ", application.Definition.Applications.Select(item => item.TargetLabel).Distinct(StringComparer.Ordinal))
        : application.Definition.Selection?.Applications is { Count: > 0 } entries
        ? string.Join(" · ", entries.Select(item => item.PlannedTarget is { } target ? target.TenantName + (target.WorkspaceName is null ? string.Empty : " / " + target.WorkspaceName) : TargetLabel(item.Target)).Distinct(StringComparer.Ordinal))
        : TargetLabel(application.Definition.Target);
    private string TargetLabel(BootstrapApplicationTarget? target)
    {
        if (target?.WorkspaceId is { } workspaceId && view?.Workspaces.FirstOrDefault(value => value.WorkspaceId == workspaceId) is { } workspace) return $"{workspace.TenantDisplayName} / {workspace.WorkspaceDisplayName}";
        if (target?.TenantId is { } tenantId && view?.Tenants.FirstOrDefault(value => value.Id == tenantId) is { } tenant) return tenant.DisplayName;
        return T("Instance");
    }
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    private BootstrapProfileSelection Selection()
    {
        if (sourceSelection is not null || selectedProfiles.Count == 1)
            return new(sourceSelection is null ? selectedProfiles.ToArray() : [], SelectedTarget(selectedProfiles[0])?.Target, Bindings(), sourceSelection);
        return new([], Applications: Applications());
    }
    private IReadOnlyList<BootstrapProfileApplication> Applications() => selectedProfiles.Select(name => new BootstrapProfileApplication(name,
        SelectedTarget(name)?.Target, Bindings().Where(binding => binding.Profile == name).ToArray(), SelectedTarget(name)?.Planned)).ToArray();
    private BootstrapSourceProfileSelection? TrySourceSelection()
    {
        if (string.IsNullOrWhiteSpace(SourceScope) || string.IsNullOrWhiteSpace(SourcePublisher) || string.IsNullOrWhiteSpace(SourceName)
            || SourceVersionUid is null || string.IsNullOrWhiteSpace(SourceChannel) || SourceSnapshotUid is null
            || string.IsNullOrWhiteSpace(SourceCatalog) || string.IsNullOrWhiteSpace(SourceEntry)
            || string.IsNullOrWhiteSpace(SourceLocale) || string.IsNullOrWhiteSpace(SourcePath)) return null;
        return new(ResourceScopeRef.Parse(SourceScope), SourcePublisher, SourceName, SourceVersionUid.Value, SourceChannel, SourceSnapshotUid.Value, SourceCatalog, SourceEntry, SourceLocale, SourcePath);
    }
    private string ProgressLabel(BootstrapApplicationResource application) => application.Definition.TotalResources > 0
        ? T("ProcessedCount", application.Definition.Resources.Count, application.Definition.TotalResources)
        : T("ProcessedResources", application.Definition.Resources.Count);
    private string ApplicationError(string code) => code switch
    {
        "bootstrap_target_invalid" or "bootstrap_target_not_planned" or "bootstrap_target_not_ready" => T("PlanTargetInvalid"),
        "bootstrap_bindings_invalid" => T("PlanBindingsInvalid"),
        "bootstrap_application_cancelled" => T("ApplicationCancelled"),
        "bootstrap_application_interrupted" => T("ApplicationInterrupted"),
        "bootstrap_application_failed" or "bootstrap_resource_failed" => T("ApplicationFailed"),
        "bootstrap_application_invalid" or "bootstrap_request_identity_required" or "bootstrap_selection_invalid" => T("ApplicationInvalid"),
        "bootstrap_request_identity_conflict" => T("RequestIdentityConflict"),
        "bootstrap_request_identity_limit" or "bootstrap_application_queue_full" => T("ApplicationQueueFull"),
        _ => code
    };
    private string ScopeLabel(BootstrapProfileScope scope) => T($"Scope.{scope}");
    private string BindingTargetKindLabel(BootstrapBindingTargetKind kind) => T($"BindingTargetKind.{kind}");
    private string DispositionLabel(BootstrapResourceDisposition disposition) => T($"Disposition.{disposition}");
    private string ApplicationStatusLabel(BootstrapApplicationStatus status) => T($"ApplicationStatus.{status}");
    private static int Count(BootstrapApplicationResource application, BootstrapResourceDisposition disposition) => application.Definition.Resources.Count(value => value.Disposition == disposition);
    private static UiStatus DispositionTone(BootstrapResourceDisposition disposition) => disposition switch { BootstrapResourceDisposition.Create => UiStatus.Success, BootstrapResourceDisposition.Skip => UiStatus.Neutral, BootstrapResourceDisposition.Conflict => UiStatus.Warning, _ => UiStatus.Danger };
    private static UiStatus ApplicationTone(BootstrapApplicationStatus status) => status switch { BootstrapApplicationStatus.Succeeded => UiStatus.Success, BootstrapApplicationStatus.PartiallyApplied or BootstrapApplicationStatus.Interrupted => UiStatus.Warning, BootstrapApplicationStatus.Running => UiStatus.Info, _ => UiStatus.Danger };
    private void SyncBindings()
    {
        var active = SelectedBindings.Select(item => BindingKey(item.Profile, item.Binding.Name)).ToHashSet(StringComparer.Ordinal);
        foreach (var key in bindingTargets.Keys.Where(key => !active.Contains(key)).ToArray()) bindingTargets.Remove(key);
        foreach (var item in SelectedBindings)
        {
            var key = BindingKey(item.Profile, item.Binding.Name);
            if (!bindingTargets.ContainsKey(key))
                bindingTargets[key] = new(item.Binding.DefaultTarget?.Name ?? string.Empty, item.Binding.DefaultTarget?.Namespace?.Value ?? "default", item.Binding.DefaultTarget?.ScopeRef);
        }
    }
    private void UpdateBindingTarget(string key, ChangeEventArgs args)
    {
        var parts = (args.Value?.ToString() ?? string.Empty).Split('\n', 4);
        bindingTargets[key].TargetProfile = parts.Length == 4 ? parts[0] : null;
        if (parts.Length == 4) parts = parts.Skip(1).ToArray();
        bindingTargets[key].ScopeRef = parts.Length == 3 && !string.IsNullOrWhiteSpace(parts[0]) ? ResourceScopeRef.Parse(parts[0]) : null;
        bindingTargets[key].Namespace = parts.Length == 3 ? parts[1] : "default";
        bindingTargets[key].Name = parts.Length == 3 ? parts[2] : string.Empty;
        preview = null;
    }
    private static string BindingKey(string profile, string name) => $"{profile}\n{name}";
    private static string BindingTargetValue(BindingInput input) => string.IsNullOrWhiteSpace(input.Name) ? string.Empty : (input.TargetProfile is null ? string.Empty : input.TargetProfile + "\n") + $"{input.ScopeRef?.Value}\n{input.Namespace}\n{input.Name}";
    private static string BindingTargetValue(BootstrapBindingTargetOption option) => (option.TargetProfile is null ? string.Empty : option.TargetProfile + "\n") + $"{option.ScopeRef?.Value}\n{option.Namespace}\n{option.Name}";
    private static string BindingLabel(BootstrapBindingSelection binding) => $"{binding.Profile}/{binding.Name} → {binding.Target.Namespace?.Value ?? "default"}/{binding.Target.Name}";
    private sealed class BindingInput(string name, string @namespace, ResourceScopeRef? scopeRef = null) { public string Name { get; set; } = name; public string Namespace { get; set; } = @namespace; public ResourceScopeRef? ScopeRef { get; set; } = scopeRef; public string? TargetProfile { get; set; } }
    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); }
}
