@inject IServiceProvider Services
@page "/settings/resource-scopes"
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@implements IDisposable
@inject IResourceScopeInventoryClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<ResourceScopesStrings> Localizer

<PageTitle>@T("PageTitle")</PageTitle>
<PageHeader Title="@T("Title")" Description="@T("Description")">
    <Actions><button class="button-secondary" @onclick="LoadAsync" disabled="@loading">@T("Refresh")</button></Actions>
</PageHeader>

<div data-testid="distribution-resource-scopes">
@if (error is not null)
{
    <ErrorState Title="@T("UnableToLoad")" Message="@error.Message" ErrorId="@error.ErrorId">
        <button class="button-secondary" @onclick="LoadAsync">@T("Retry")</button>
    </ErrorState>
}
else if (inventory is null)
{
    <LoadingState Message="@T("Loading")" />
}
else
{
    <section class="metric-grid" aria-label="@T("Metrics")">
        <MetricCard Label="@T("Scopes")" Value="@inventory.Scopes.Count.ToString()" Status="UiStatus.Info" />
        <MetricCard Label="@T("Resources")" Value="@inventory.Scopes.Sum(scope => scope.Resources.Count).ToString()" Status="UiStatus.Success" />
        <MetricCard Label="@T("SelectedScopeResources")" Value="@(Selected?.Resources.Count.ToString() ?? "0")" />
    </section>

    <section class="scope-explorer">
        <aside class="panel scope-tree" aria-label="@T("Hierarchy")">
            <div class="panel-header"><div><p class="eyebrow">@T("Hierarchy")</p><h2>@T("OwnershipScopes")</h2><p class="scope-tree-intro">@T("HierarchyDescription")</p></div></div>
            @foreach (var root in inventory.Scopes.Where(scope => scope.ParentScopeRef is null))
            {
                <ResourceScopeTreeNode Scope="root" Depth="0" Selected="@(selectedScopeRef == root.ScopeRef)" OnSelected="Select" />
                @foreach (var child in Children(root.ScopeRef))
                {
                    <ResourceScopeTreeNode Scope="child" Depth="1" Selected="@(selectedScopeRef == child.ScopeRef)" OnSelected="Select" />
                    @foreach (var descendant in Children(child.ScopeRef))
                    {
                        <ResourceScopeTreeNode Scope="descendant" Depth="2" Selected="@(selectedScopeRef == descendant.ScopeRef)" OnSelected="Select" />
                    }
                }
            }
        </aside>

        <article class="panel scope-detail">
            @if (Selected is { } selected)
            {
                <div class="panel-header scope-detail-header">
                    <div class="scope-heading"><div><p class="eyebrow">@KindLabel(selected.Kind)</p><h2>@ScopeDisplayName(selected)</h2></div></div>
                    <div class="scope-detail-badges"><ResourceScopeBadge ScopeRef="selected.ScopeRef" />@if (selected.IsCurrent) { <StatusBadge Text="@T("Current")" Status="UiStatus.Info" /> }</div>
                </div>
                <code class="scope-reference">@selected.ScopeRef.Value</code>
                <p class="scope-visibility">@VisibilityDescription(selected.Kind)</p>

                @if (!CanOpenSelectedScopeResources && selected.Resources.Count > 0)
                {
                    <p class="scope-link-notice"><span aria-hidden="true">↗</span>@T("LinksRequireCurrentWorkspace")</p>
                }

                <div class="scope-inventory-header">
                    <div><p class="eyebrow">@T("Inventory")</p><h3>@T("ResourcesInScope")</h3></div>
                    <span class="scope-inventory-count" data-testid="resource-result-count" aria-live="polite">@T("ShowingResources", FilteredResources.Count, selected.Resources.Count)</span>
                </div>
                <ResourceToolbar Label="@T("InventoryFilters")">
                    <SearchBox Value="@search" ValueChanged="SearchChangedAsync" Label="@T("Search")" Placeholder="@T("SearchPlaceholder")" />
                    <label class="scope-kind-filter">
                        <span class="sr-only">@T("Kind")</span>
                        <select data-testid="resource-kind-filter" aria-label="@T("Kind")" value="@kind" @onchange="KindChanged">
                            <option value="">@T("AllKindsOption", selected.Resources.Count)</option>
                            @foreach (var value in Kinds)
                            {
                                <option value="@value">@T("KindOption", value, selected.Resources.Count(resource => resource.Kind == value))</option>
                            }
                        </select>
                    </label>
                </ResourceToolbar>

                @if (FilteredResources.Count == 0)
                {
                    <EmptyState Title="@T("NoResources")" Message="@T("NoResourcesMessage")" />
                }
                else
                {
                    <CollectionView TItem="ResourceScopeInventoryItemResponse" Items="FilteredResources" InformationLabels="@(new string[] { T("Kind"), T("Updated") })" IdentityLabel="@T("Resource")" ItemAttributes="@(resource => new Dictionary<string, object> { ["class"] = "resource-row" })">
        <Identity Context="resource">
<CollectionIdentity DisplayName="@resource.Name" Namespace="@resource.Namespace.Value" Name="@resource.Name" Href="@ResourceUrl(resource)" IconName="layers" ><IconBadges><ResourceScopeBadge ScopeRef="selected.ScopeRef" DisplayName="@selected.DisplayName" IconOnly /><ManagedResourceBadge IsManaged="@resource.IsManaged" IconOnly /></IconBadges></CollectionIdentity></Identity>
        <Information Context="resource">
            <CollectionValue Label="@T("Kind")"><span class="pack-kind">@resource.Kind</span></CollectionValue>
            <CollectionValue Label="@T("Updated")"><time datetime="@resource.UpdatedAt.ToString("O")">@resource.UpdatedAt.ToLocalTime().ToString("g")</time></CollectionValue>
        </Information>
        <Actions Context="resource">@if (ResourceUrl(resource) is not null || SupportedPreviewKinds.Contains(resource.Kind)) { <CollectionActions ResourceName="@resource.Name">@if (ResourceUrl(resource) is { } target) { <a href="@target"><UiIcon Name="arrow-up-right" />@Shared["OpenItem"]</a> }@if (CanEdit(resource) && ResourceUrl(resource) is { } editTarget) { <a href="@(editTarget.Split('#')[0] + "#definition/configuration")"><UiIcon Name="pencil" />@Shared["EditDefinition"]</a> }@if (SupportedPreviewKinds.Contains(resource.Kind)) { <button type="button" data-testid="scope-resource-preview" disabled="@(contextState?.Current is null)" @onclick="() => OpenPreview(resource)"><UiIcon Name="eye" />@Shared["Preview"]</button> }</CollectionActions> }</Actions>
    </CollectionView>
                }
            }
        </article>
    </section>
}

</div>

<ResourceCollectionPreview @ref="preview" ResourceKind="" ResourceKinds="SupportedPreviewKinds" ContextKey="@InspectionContextKey" Enabled="@(contextState?.Current is not null && contextState.Error is null && contextState.HasPermission(AuthorizationPermissions.ResourcesRead))">
    <ChildContent Context="address">
        @switch (address.Kind)
        {
            case "Agent": <AgentResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" RunHref="@InspectionRunUrl(address)" /> break;
            case "Flow": <FlowResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" DesignerHref="@InspectionDesignerUrl(address)" /> break;
            case "Entry": <EntryResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "Parameter": <ParameterResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "Schema": <SchemaResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "Vault": <VaultResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "Secret": <SecretResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "ConnectedService": <ConnectedServiceResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "StorageType": <StorageTypeResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "Storage": <StorageResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "DataSourceProfile": <DataSourceProfileResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "DataSource": <DataSourceResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "KnowledgeSource": <KnowledgeSourceResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "RuntimeProfile": <RuntimeProfileResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "ToolProvider": <ToolProviderResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "Tool": <ToolResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "ToolSet": <ToolSetResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "ToolCategory": <ToolCategoryResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "ToolDefinition": <ToolDefinitionResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "ModelProvider": <ModelProviderResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "ModelProfile": <ModelProfileResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "Model": <ModelResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "SourceProvider": <SourceProviderResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "SourceRegistryRegistration": <SourceRegistryRegistrationResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "Source": <SourceResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "Trigger": <TriggerResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "TransformationFunction": <TransformationFunctionResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "FunctionKind": <FunctionKindResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "InstalledPack": <InstalledPackResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "PackProject": <PackProjectResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "AwpWorkerIdentity": <RuntimeWorkerResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "FlowRunArtifact": <DurableArtifactResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" /> break;
            case "DataSourceQuery": <DataSourceQueryResourcePreview Address="address" OverviewHref="" DefinitionHref="" /> break;
            case "StagedArtifact": <StagedArtifactResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" /> break;
            case "AepEnrollmentRequest": <AepEnrollmentResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "ExtensionRegistration": <ExtensionResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
            case "ConnectedServiceOperation": <ConnectedServiceOperationResourcePreview Address="address" OverviewHref="@(InspectionUrl(address) ?? string.Empty)" DefinitionHref="@(InspectionUrl(address)?.Split('#')[0] + "#definition/configuration")" /> break;
        }
    </ChildContent>
</ResourceCollectionPreview>

@code {
    private ResourceCollectionPreview? preview;
    private ConsoleContextState? contextState;
    private CancellationTokenSource? pending;
    private bool disposed;
    private long revision;
    private string? InspectionContextKey => contextState?.Current is not { } context ? null : $"{context.UserId}|{context.SelectedScopeRef}|{context.WorkspaceId}";
    private static readonly IReadOnlySet<string> SupportedPreviewKinds = new HashSet<string>(StringComparer.Ordinal)
    { "Agent", "Flow", "Entry", "Parameter", "Schema", "Vault", "Secret", "ConnectedService", "StorageType", "Storage", "DataSourceProfile", "DataSource", "KnowledgeSource", "RuntimeProfile", "ToolProvider", "Tool", "ToolSet", "ToolCategory", "ToolDefinition", "ModelProvider", "ModelProfile", "Model", "SourceProvider", "SourceRegistryRegistration", "Source", "Trigger", "TransformationFunction", "FunctionKind", "InstalledPack", "PackProject", "AwpWorkerIdentity", "AepEnrollmentRequest", "ExtensionRegistration", "ConnectedServiceOperation", "FlowRunArtifact", "StagedArtifact", "DataSourceQuery" };
    private static readonly IReadOnlySet<string> DefinitionKinds = new HashSet<string>(StringComparer.Ordinal)
    { "Agent", "Flow", "Parameter", "Schema", "Vault", "Secret", "ConnectedService", "StorageType", "Storage", "DataSourceProfile", "DataSource", "KnowledgeSource", "RuntimeProfile", "ToolProvider", "ToolCategory", "ToolDefinition", "ModelProvider", "ModelProfile", "SourceProvider", "SourceRegistryRegistration", "Source", "Trigger", "TransformationFunction" };
    private bool CanEdit(ResourceScopeInventoryItemResponse value) => !value.IsManaged && DefinitionKinds.Contains(value.Kind)
        && Selected?.ScopeRef.Value == contextState?.Current?.SelectedScopeRef && contextState?.HasPermission(AuthorizationPermissions.ResourcesWrite) == true;
    private void OpenPreview(ResourceScopeInventoryItemResponse value)
    {
        if (CanOpenSelectedScopeResources && Selected is { } selected && SupportedPreviewKinds.Contains(value.Kind))
            preview?.Open(ScopedResourceAddress.Create(selected.ScopeRef, value.Namespace, value.Kind, value.Name));
    }
    private string InspectionRunUrl(ScopedResourceAddress address) => ConsoleResourceUrls.WithOwnerScope(ResourceOwnershipContext.PreserveNavigation($"/agents/{Uri.EscapeDataString(address.Name)}/run", Services), address.ScopeRef);
    private string InspectionDesignerUrl(ScopedResourceAddress address) => ResourceOwnershipContext.PreserveNavigation($"{(address.Namespace.IsDefault ? "/flows" : $"/namespaces/{Uri.EscapeDataString(address.Namespace.Value)}/flows")}/{Uri.EscapeDataString(address.Name)}/designer?scopeRef={Uri.EscapeDataString(address.ScopeRef.Value)}", Services);
    private string? InspectionUrl(ScopedResourceAddress address, Guid? uid = null)
    {
        if (!address.Namespace.IsDefault && address.Kind is "Parameter" or "Vault" or "Secret" or "SourceRegistryRegistration" or "InstalledPack" or "PackProject" or "AwpWorkerIdentity" or "AepEnrollmentRequest" or "FlowRunArtifact" or "StagedArtifact") return null;
        var name = Uri.EscapeDataString(address.Name); var ns = Uri.EscapeDataString(address.Namespace.Value);
        string? path = address.Kind switch
        {
            "Agent" => ConsoleResourceUrls.Agent(address.Namespace, address.Name),
            "Flow" => ConsoleResourceUrls.Flow(new(address.Name, address.Namespace)),
            "Entry" => ConsoleResourceUrls.Entry(new(address.Name, address.Namespace)),
            "Source" => $"/settings/sources/{ns}/{name}",
            "PackProject" when uid is { } projectId => $"/pack-projects/{projectId:D}?namespace={ns}&resourceName={name}",
            "PackProject" => null,
            "FlowRunArtifact" when Guid.TryParseExact(address.Name, "N", out _) => $"/artifacts/durable/{name}",
            "StagedArtifact" when Guid.TryParseExact(address.Name, "N", out _) => $"/artifacts/staged/{name}",
            "AwpWorkerIdentity" when Guid.TryParseExact(address.Name, "N", out var workerId) => $"/settings/runtime-workers/{workerId:D}",
            "AepEnrollmentRequest" when Guid.TryParseExact(address.Name, "N", out var enrollmentId) => $"/extensions/enrollment/{enrollmentId:D}",
            "Parameter" or "Secret" or "Vault" when address.Namespace.IsDefault => $"/{(address.Kind == "Parameter" ? "parameters" : address.Kind == "Secret" ? "secrets" : "vaults")}/{name}",
            "Schema" => "/schemas/" + name + "?namespace=" + ns,
            "ConnectedService" => "/connected-services/" + name + "?namespace=" + ns,
            "StorageType" => "/storage-types/" + name + "?namespace=" + ns,
            "Storage" => "/storages/" + name + "?namespace=" + ns,
            "DataSourceProfile" => "/data-source-profiles/" + name + "?namespace=" + ns,
            "DataSource" => "/data-sources/" + name + "?namespace=" + ns,
            "KnowledgeSource" => "/knowledge-sources/" + name + "?namespace=" + ns,
            "RuntimeProfile" => "/runtimeprofiles/" + name + "?namespace=" + ns,
            "ToolProvider" => "/tools/providers/" + name + "?namespace=" + ns,
            "Tool" => "/tools/" + name + "?namespace=" + ns,
            "ToolSet" => "/tools/sets/" + name + "?namespace=" + ns,
            "ToolCategory" => "/tools/categories/" + name + "?namespace=" + ns,
            "ToolDefinition" => "/tools/definitions/" + name + "?namespace=" + ns,
            "ModelProvider" => "/modelproviders/" + name + "?namespace=" + ns,
            "ModelProfile" => "/modelprofiles/" + name + "?namespace=" + ns,
            "Model" => "/models/" + name + "?namespace=" + ns,
            "SourceProvider" => "/sourceproviders/" + name + "?namespace=" + ns,
            "SourceRegistryRegistration" => "/settings/source-registries/" + name + "?namespace=" + ns,
            "Trigger" => "/triggers/" + name + "?namespace=" + ns,
            "TransformationFunction" => "/transformation-functions/" + name + "?namespace=" + ns,
            "FunctionKind" => "/function-kinds/" + name + "?namespace=" + ns,
            "InstalledPack" => "/packs/resources/" + name + "?namespace=" + ns,
            "ExtensionRegistration" => "/extensions/" + name + "?namespace=" + ns,
            "ConnectedServiceOperation" => "/connected-service-operations/" + name + "?namespace=" + ns,
            _ => null
        };
        return path is null ? null : ConsoleResourceUrls.WithOwnerScope(ResourceOwnershipContext.PreserveNavigation(path, Services), address.ScopeRef).Split('#')[0] + "#overview";
    }
    private readonly CancellationTokenSource cancellation = new();
    private ResourceScopeInventoryResponse? inventory;
    private ResourceScopeRef? selectedScopeRef;
    private AgentstrationApiException? error;
    private bool loading;
    private string search = string.Empty;
    private string kind = string.Empty;
    private ResourceScopeInventoryNodeResponse? Selected => inventory?.Scopes.SingleOrDefault(scope => scope.ScopeRef == selectedScopeRef);
    private IReadOnlyList<string> Kinds => Selected?.Resources.Select(resource => resource.Kind).Distinct(StringComparer.Ordinal).Order(StringComparer.CurrentCultureIgnoreCase).ToArray() ?? [];
    private bool CanOpenSelectedScopeResources
    {
        get
        {
            if (Selected is not { } selected || inventory?.Scopes.FirstOrDefault(scope => scope.IsCurrent) is not { } current) return false;
            return selected.Kind == ResourceScopeKind.Instance
                || selected.ScopeRef == current.ScopeRef
                || selected.ScopeRef == current.ParentScopeRef;
        }
    }
    private IReadOnlyList<ResourceScopeInventoryItemResponse> FilteredResources => Selected?.Resources.Where(resource =>
        (string.IsNullOrWhiteSpace(kind) || string.Equals(resource.Kind, kind, StringComparison.Ordinal))
        && (string.IsNullOrWhiteSpace(search)
            || resource.Name.Contains(search, StringComparison.CurrentCultureIgnoreCase)
            || resource.Kind.Contains(search, StringComparison.CurrentCultureIgnoreCase)
            || resource.Namespace.Value.Contains(search, StringComparison.CurrentCultureIgnoreCase))).ToArray() ?? [];

    protected override async Task OnInitializedAsync()
    {
        contextState = Services.GetService<ConsoleContextState>();
        if (contextState is not null) { await contextState.EnsureLoadedAsync(cancellation.Token); if (disposed) return; contextState.Changed += ContextChanged; }
        await LoadAsync();
    }
    private void ContextChanged() => _ = InvokeAsync(async () => { preview?.Close(); inventory = null; await LoadAsync(); if (!disposed) StateHasChanged(); });
    private async Task LoadAsync()
    {
        if (disposed) return;
        var request = ++revision; var key = InspectionContextKey; pending?.Cancel(); pending?.Dispose(); pending = CancellationTokenSource.CreateLinkedTokenSource(cancellation.Token); var token = pending.Token;
        loading = true; error = null;
        try
        {
            var saved = await Client.GetAsync(token);
            if (disposed || request != revision || key != InspectionContextKey) return;
            inventory = saved;
            selectedScopeRef = inventory.Scopes.FirstOrDefault(scope => scope.IsCurrent)?.ScopeRef ?? inventory.Scopes.FirstOrDefault()?.ScopeRef;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (AgentstrationApiException exception) { if (!disposed && request == revision && key == InspectionContextKey) { inventory = null; error = exception; } }
        finally { if (!disposed && request == revision) loading = false; }
    }
    private IEnumerable<ResourceScopeInventoryNodeResponse> Children(ResourceScopeRef parent) => inventory is null
        ? []
        : inventory.Scopes.Where(scope => scope.ParentScopeRef == parent).OrderBy(scope => scope.DisplayName, StringComparer.CurrentCultureIgnoreCase);
    private void Select(ResourceScopeRef scopeRef) { preview?.Close(); selectedScopeRef = scopeRef; search = kind = string.Empty; }
    private Task SearchChangedAsync(string value) { search = value; return Task.CompletedTask; }
    private void KindChanged(ChangeEventArgs args) => kind = args.Value?.ToString() ?? string.Empty;
    private string ScopeDisplayName(ResourceScopeInventoryNodeResponse scope) => scope.Kind == ResourceScopeKind.Instance ? T("InstanceName") : scope.DisplayName;
    private string KindLabel(ResourceScopeKind value) => T($"ScopeKind.{value}");
    private string VisibilityDescription(ResourceScopeKind value) => T($"Visibility.{value}");
    private string T(string key) => Localizer[key].Value;
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    private string? ResourceUrl(ResourceScopeInventoryItemResponse resource)
    {
        if (!CanOpenSelectedScopeResources || Selected is not { } selected) return null;
        if (SupportedPreviewKinds.Contains(resource.Kind)) return InspectionUrl(ScopedResourceAddress.Create(selected.ScopeRef, resource.Namespace, resource.Kind, resource.Name), resource.Uid);
        var name = Uri.EscapeDataString(resource.Name);
        var resourceNamespace = Uri.EscapeDataString(resource.Namespace.Value);
        var scopeRef = Uri.EscapeDataString(selected.ScopeRef.Value);
        var url = resource.Kind switch
        {
            AgentResourceKinds.Agent => resource.Namespace.IsDefault ? $"/agents/{name}" : $"/namespaces/{resourceNamespace}/agents/{name}",
            FlowResourceKinds.Flow => resource.Namespace.IsDefault ? $"/flows/{name}" : $"/namespaces/{resourceNamespace}/flows/{name}",
            EntryResourceKinds.Entry => resource.Namespace.IsDefault ? $"/entries/{name}" : $"/namespaces/{resourceNamespace}/entries/{name}",
            ModelResourceKinds.ModelProvider => $"/modelproviders/{name}?namespace={resourceNamespace}",
            SourceResourceKinds.SourceProvider => $"/sourceproviders/{name}?namespace={resourceNamespace}&scopeRef={scopeRef}",
            ModelResourceKinds.ModelProfile => $"/modelprofiles/{name}?namespace={resourceNamespace}",
            RuntimeProfileResourceKinds.RuntimeProfile => $"/runtimeprofiles/{name}?namespace={resourceNamespace}",
            SecretResourceKinds.Vault => $"/vaults/{name}?scopeRef={scopeRef}",
            SecretResourceKinds.Secret => $"/secrets/{name}?scopeRef={scopeRef}",
            ParameterResourceKinds.Parameter => $"/parameters/{name}?scopeRef={scopeRef}",
            StorageResourceKinds.Storage => $"/storages/{name}?scopeRef={scopeRef}&namespace={resourceNamespace}",
            StorageResourceKinds.StorageType => $"/storage-types/{name}?scopeRef={scopeRef}&namespace={resourceNamespace}",
            Agentstration.Functions.Contracts.FunctionResourceKinds.TransformationFunction => $"/transformation-functions/{name}?scopeRef={scopeRef}&namespace={resourceNamespace}",
            ConnectedServiceResourceKinds.ConnectedService => $"/connected-services/{name}?scopeRef={scopeRef}&namespace={resourceNamespace}",
            ToolResourceKinds.Tool => $"/tools/{name}?namespace={resourceNamespace}",
            ToolResourceKinds.ToolProvider => $"/tools/providers/{name}?namespace={resourceNamespace}",
            TriggerResourceKinds.Trigger when resource.Namespace.IsDefault => $"/triggers/{name}",
            AgentResourceKinds.AgentDeployment => $"/deployments#deployment-{resourceNamespace}-{name}",
            PackKinds.InstalledPack or PackKinds.PackConfiguration => "/packs",
            ExtensionKinds.ExtensionRegistration => "/extensions",
            BootstrapKinds.BootstrapApplication => "/settings/bootstrap",
            _ => null
        };
        return url is null ? null : ConsoleResourceUrls.WithOwnerScope(url, selected.ScopeRef);
    }
    public void Dispose() { disposed = true; revision++; if (contextState is not null) contextState.Changed -= ContextChanged; pending?.Cancel(); pending?.Dispose(); cancellation.Cancel(); cancellation.Dispose(); }

}
