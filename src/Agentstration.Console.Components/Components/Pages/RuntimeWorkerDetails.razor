@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@page "/settings/runtime-workers/{WorkerId:guid}"
@implements IDisposable
@inject IRuntimeApiClient Client
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<RuntimeWorkerStrings> Localizer

<PageTitle>@T("WorkerDetails") · Agentstration</PageTitle>
@if (loading) { <LoadingState Message="@T("Loading")" /> }
else if (error is not null) { <ErrorState Message="@error" /> }
else if (details is not null)
{
    <ResourceDetailsTemplate Name="@details.Worker.DisplayName" ResourceType="@T("WorkerDetails")" Domain="runtime" IconName="server"
                             Description="@T("DetailsDescription")" StatusText="@T($"Presence.{details.Worker.Presence}")" Status="@PresenceStatus(details.Worker.Presence)"
                             Sections="Sections" ResourceIdentity="@loadedKey" DefaultSection="overview" SelectionChanged="SelectSection" TestId="runtime-worker-details">
        <Metadata><CopyableValue Value="@details.Worker.WorkerId.ToString("D")" /></Metadata>
        <Actions><a class="button-secondary" href="@ResourceOwnershipContext.PreserveNavigation("/settings/runtime-workers", Services)">@T("BackToWorkers")</a></Actions>
        <Content>
        <div data-worker-section="overview" hidden="@(section != "overview")">
            <section class="metric-grid worker-metrics">
                <MetricCard Label="@T("Presence")" Value="@T($"Presence.{details.Worker.Presence}")" Detail="@T($"Enrollment.{details.Worker.EnrollmentState}")" Status="@PresenceStatus(details.Worker.Presence)" />
                <MetricCard Label="@T("Capacity")" Value="@(details.Worker.MaximumConcurrentAssignments?.ToString() ?? "—")" Detail="@T("ActiveAssignments", details.Worker.ActiveAssignments)" Status="@(details.Worker.ActiveAssignments > 0 ? UiStatus.Info : UiStatus.Neutral)" />
                <MetricCard Label="@T("Protocol")" Value="@details.Worker.ProtocolVersion" Detail="@T("ProtocolDetail")" Status="@UiStatus.Info" />
                <MetricCard Label="@T("LastSeen")" Value="@(details.Worker.LastSeenAt?.LocalDateTime.ToString("g") ?? "—")" Detail="@T("ServerObserved")" Status="@PresenceStatus(details.Worker.Presence)" />
            </section>
            <FormSection Title="@Shared["Identity"]">
                <dl class="details-list"><dt>@T("Worker")</dt><dd>@details.Worker.DisplayName</dd><dt>@T("WorkerId")</dt><dd><CopyableValue Value="@details.Worker.WorkerId.ToString("D")" /></dd><dt>@T("Session")</dt><dd><code>@(details.Worker.SessionId?.ToString("D") ?? "—")</code></dd><dt>@T("Registered")</dt><dd>@(details.Worker.RegisteredAt?.LocalDateTime.ToString("g") ?? "—")</dd></dl>
            </FormSection>
            <FormSection Title="@Shared["Configuration"]" Description="@T("CompatibilityAndCapacity")">
                <dl class="details-list"><dt>@T("Version")</dt><dd><span>@SoftwareVersion(details.Worker.SoftwareVersion)</span>@if (SoftwareBuild(details.Worker.SoftwareVersion) is { } build) { <small class="worker-build" title="@details.Worker.SoftwareVersion">+@build</small> }</dd><dt>@T("Protocol")</dt><dd>@details.Worker.ProtocolVersion</dd><dt>@T("Capacity")</dt><dd>@(details.Worker.MaximumConcurrentAssignments?.ToString() ?? "—")</dd><dt>@T("Capabilities")</dt><dd>@(details.Worker.Capabilities.Count == 0 ? "—" : string.Join(", ", details.Worker.Capabilities.Select(FormatCapability)))</dd></dl>
            </FormSection>
        </div>
        <div data-worker-section="assignments" hidden="@(section != "assignments")">
            <article class="panel worker-assignments" data-testid="runtime-worker-assignments">
                <div class="panel-header"><div><h2>@T("Assignments")</h2><p>@T("AssignmentsDescription")</p></div><span class="worker-count">@details.RecentAssignments.Count</span></div>
                @if (details.RecentAssignments.Count == 0) { <div class="worker-empty"><p>@T("NoAssignments")</p></div> }
                else
                {
                    <div class="worker-assignments-grid">
                    <CollectionView TItem="RuntimeAssignmentPlacementResponse" Items="details.RecentAssignments" InformationLabels="@(new string[] { T("Runtime"), T("Attempts"), T("Updated") })" RowTestId="runtime-worker-assignment-row" ItemAttributes="@((item) => new Dictionary<string, object> { ["data-run-id"] = item.RunId, ["data-assignment-id"] = item.AssignmentId.ToString("D"), ["data-assignment-state"] = item.State })" IdentityLabel="@T("Run")" StateLabel="@T("State")">
        <Identity Context="item">
<a class="text-button worker-run-link" href="@RunUrl(item)">@item.RunId</a><small>@T($"TargetKind.{item.TargetKind}")</small></Identity>
        <State Context="item">
<StatusBadge Text="@T($"AssignmentState.{item.State}")" Status="@PlatformDashboardService.ToStatus(item.State)" /></State>
        <Information Context="item">
            <CollectionValue Label="@T("Runtime")">@item.RuntimeCapability · @item.RuntimeCapabilityVersion</CollectionValue>
            <CollectionValue Label="@T("Attempts")">@item.Attempts.Count</CollectionValue>
            <CollectionValue Label="@T("Updated")">@item.UpdatedAt.LocalDateTime.ToString("g")</CollectionValue>
        </Information>
        <Actions Context="item"><CollectionActions ResourceName="@item.RunId"><a href="@RunUrl(item)">@Shared["OpenItem"]</a></CollectionActions></Actions>
    </CollectionView>
                    </div>
                    @foreach (var assignment in details.RecentAssignments.Where(item => item.Attempts.Count > 0))
                    {
                        <details class="worker-attempts"><summary>@T("RunAttempts", assignment.RunId, assignment.Attempts.Count)</summary><ol class="operations-list">@foreach (var attempt in assignment.Attempts.OrderByDescending(item => item.AcquiredAt)) { <li><span>@T($"AttemptState.{attempt.State}") · @attempt.AcquiredAt.LocalDateTime.ToString("g")</span><small>@T("AttemptDetails", attempt.WorkerSessionId, attempt.LastHeartbeatAt.LocalDateTime.ToString("g"), attempt.LeaseExpiresAt.LocalDateTime.ToString("g"), attempt.FencingGeneration, attempt.ErrorCode ?? "—")</small></li> }</ol></details>
                    }
                }
            </article>
        </div>
        </Content>
    </ResourceDetailsTemplate>
}

@code {
    [Parameter] public Guid WorkerId { get; set; }
    private readonly CancellationTokenSource cancellation = new();
    private RuntimeWorkerDetailsResponse? details;
    private string section = "overview";
    private void SelectSection(string? value) => section = value ?? "overview";
    private string? loadedKey, error;
    private bool loading = true;
    private long loadVersion;
    private IReadOnlyList<ResourceNavigationItem> Sections => [new("overview", Shared["Overview"], "home"), new("assignments", T("Assignments"), "list-check")];
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    protected override async Task OnParametersSetAsync()
    {
        var key = $"{WorkerId}|{ResourceOwnershipContext.TryGetCurrent(Services)}";
        if (loadedKey == key) return;
        loadedKey = key; var request = ++loadVersion;
        loading = true; error = null; details = null; section = "overview";
        try
        {
            var saved = await Client.GetRuntimeWorkerAsync(WorkerId, cancellation.Token);
            if (request != loadVersion) return;
            if (saved.Worker.WorkerId != WorkerId) throw new InvalidOperationException(T("IdentityMismatch"));
            details = saved;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception) { if (request == loadVersion) { error = exception.Message; loadedKey = null; } }
        finally { if (request == loadVersion) loading = false; }
    }
    private static string FormatCapability(RuntimeWorkerCapabilityResponse capability) => $"{capability.RuntimeKind} {capability.CapabilityVersion}";
    private static string SoftwareVersion(string? version) => string.IsNullOrWhiteSpace(version) ? "—" : version.Split('+', 2)[0];
    private static string? SoftwareBuild(string? version) => version?.Split('+', 2) is [_, var build] ? build : null;
    private static UiStatus PresenceStatus(RuntimeWorkerPresenceState presence) => PlatformDashboardService.ToStatus(presence.ToString());
    private static string RunUrl(RuntimeAssignmentPlacementResponse item)
    {
        var path = item.TargetKind == nameof(RuntimeAssignmentTargetKind.FlowRun)
            ? $"/flow-runs/{Uri.EscapeDataString(item.RunId)}"
            : $"/runs/{Uri.EscapeDataString(item.RunId)}";
        return item.ExecutionScopeRef is { } scopeRef
            ? $"{path}?scopeRef={Uri.EscapeDataString(scopeRef.Value)}"
            : path;
    }
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
