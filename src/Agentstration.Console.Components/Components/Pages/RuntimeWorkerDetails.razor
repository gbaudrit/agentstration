@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@page "/settings/runtime-workers/{WorkerId:guid}"
@implements IDisposable
@inject IRuntimeApiClient Client
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<RuntimeWorkerStrings> Localizer

<PageTitle>@T("WorkerDetails") · Agentstration</PageTitle>
    <ResourceDetailsTemplate Name="@(details?.Worker.DisplayName ?? T("WorkerDetails"))" ResourceType="@T("WorkerDetails")" Domain="runtime" IconName="server" CollectionHref="@ResourceOwnershipContext.PreserveNavigation("/settings/runtime-workers", Services)" CollectionLabel="@T("BackToWorkers")"
                             Description="@T("DetailsDescription")" StatusText="@(details is null ? null : T($"Presence.{details.Worker.Presence}"))" Status="@(details is null ? UiStatus.Neutral : PresenceStatus(details.Worker.Presence))"
                             Sections="Sections" ResourceIdentity="@(loadedKey ?? WorkerId.ToString("D"))" DefaultSection="overview" SectionState="sectionState" SelectionChanged="SelectSection"
                             LoadState="loadState" OnRetry="RetryAsync" OnRefresh="RefreshAsync" SectionTestIdPrefix="runtime-worker" TestId="runtime-worker-details">
        <Metadata>@if (details is not null) { <CopyableValue Value="@details.Worker.WorkerId.ToString("D")" /> }</Metadata>

        <Content>
        @if (details is not null) {
        <div class="worker-overview" data-worker-section="overview" hidden="@(!sectionState.Is("overview"))">
            <section class="metric-grid worker-metrics">
                <MetricCard Label="@T("Presence")" Value="@T($"Presence.{details.Worker.Presence}")" Detail="@T($"Enrollment.{details.Worker.EnrollmentState}")" Status="@PresenceStatus(details.Worker.Presence)" />
                <MetricCard Label="@T("Capacity")" Value="@(details.Worker.MaximumConcurrentAssignments?.ToString() ?? "—")" Detail="@T("ActiveAssignments", details.Worker.ActiveAssignments)" Status="@(details.Worker.ActiveAssignments > 0 ? UiStatus.Info : UiStatus.Neutral)" />
                <MetricCard Label="@T("Protocol")" Value="@details.Worker.ProtocolVersion" Detail="@T("ProtocolDetail")" Status="@UiStatus.Info" />
                <MetricCard Label="@T("LastSeen")" Value="@(details.Worker.LastSeenAt?.LocalDateTime.ToString("g") ?? "—")" Detail="@T("ServerObserved")" Status="@PresenceStatus(details.Worker.Presence)" />
            </section>
            <RuntimeWorkerResourceSummary Resource="details.Worker" />
        </div>
        <div data-worker-section="assignments" hidden="@(!sectionState.Is("assignments"))">
            <article class="panel worker-assignments" data-testid="runtime-worker-assignments">
                <div class="panel-header"><div><h2>@T("Assignments")</h2><p>@T("AssignmentsDescription")</p></div><span class="worker-count">@details.RecentAssignments.Count</span></div>
                @if (details.RecentAssignments.Count == 0) { <div class="worker-empty"><p>@T("NoAssignments")</p></div> }
                else
                {
                    <div class="worker-assignments-grid">
                    <CollectionView TItem="RuntimeAssignmentPlacementResponse" Items="details.RecentAssignments" InformationLabels="@(new string[] { T("Runtime"), T("Attempts"), T("Updated") })" RowTestId="runtime-worker-assignment-row" ItemAttributes="@((item) => new Dictionary<string, object> { ["data-run-id"] = item.RunId, ["data-assignment-id"] = item.AssignmentId.ToString("D"), ["data-assignment-state"] = item.State })" IdentityLabel="@T("Run")" StateLabel="@T("State")">
        <Identity Context="item">
<a class="text-button worker-run-link" href="@RunUrl(item)">@item.RunId</a><small>@T($"TargetKind.{item.TargetKind}")</small></Identity>
        <State Context="item">
<StatusBadge Text="@T($"AssignmentState.{item.State}")" Status="@PlatformDashboardService.ToStatus(item.State)" /></State>
        <Information Context="item">
            <CollectionValue Label="@T("Runtime")">@item.RuntimeCapability · @item.RuntimeCapabilityVersion</CollectionValue>
            <CollectionValue Label="@T("Attempts")">@item.Attempts.Count</CollectionValue>
            <CollectionValue Label="@T("Updated")">@item.UpdatedAt.LocalDateTime.ToString("g")</CollectionValue>
        </Information>
        <Actions Context="item"><CollectionActions ResourceName="@item.RunId"><a href="@RunUrl(item)">@Shared["OpenItem"]</a></CollectionActions></Actions>
    </CollectionView>
                    </div>
                    @foreach (var assignment in details.RecentAssignments.Where(item => item.Attempts.Count > 0))
                    {
                        <details @key="assignment.AssignmentId" class="worker-attempts"><summary>@T("RunAttempts", assignment.RunId, assignment.Attempts.Count)</summary><ol class="operations-list">@foreach (var attempt in assignment.Attempts.OrderByDescending(item => item.AcquiredAt)) { <li><span>@T($"AttemptState.{attempt.State}") · @attempt.AcquiredAt.LocalDateTime.ToString("g")</span><small>@T("AttemptDetails", attempt.WorkerSessionId, attempt.LastHeartbeatAt.LocalDateTime.ToString("g"), attempt.LeaseExpiresAt.LocalDateTime.ToString("g"), attempt.FencingGeneration, attempt.ErrorCode ?? "—")</small></li> }</ol></details>
                    }
                }
            </article>
        </div>
        }
        </Content>
    </ResourceDetailsTemplate>

@code {
    [Parameter] public Guid WorkerId { get; set; }
    private readonly CancellationTokenSource cancellation = new();
    private RuntimeWorkerDetailsResponse? details;
    private readonly ResourceSectionState sectionState = new();
    private string? loadedKey;
    private void SelectSection(string? path) => sectionState.Select(path ?? "overview");
    private bool loading;
    private long loadVersion;
    private ResourceLoadState loadState = new(ResourceLoadStatus.Loading);
    private IReadOnlyList<ResourceNavigationItem> Sections => [new("overview", Shared["Overview"], "home"), new("assignments", T("Assignments"), "list-check")];
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    protected override Task OnParametersSetAsync()
    {
        var key = $"{WorkerId}|{ResourceOwnershipContext.TryGetCurrent(Services)}";
        if (loadedKey == key) return Task.CompletedTask;
        loadedKey = key; sectionState.Reset(key); return LoadAsync(refresh: false);
    }
    private Task RetryAsync() => loading ? Task.CompletedTask : LoadAsync(refresh: details is not null);
    private Task RefreshAsync() => loading ? Task.CompletedTask : LoadAsync(refresh: true);
    private async Task LoadAsync(bool refresh)
    {
        var request = ++loadVersion; var requestedWorker = WorkerId;
        loading = true;
        if (!refresh) details = null;
        loadState = new(refresh && details is not null ? ResourceLoadStatus.Refreshing : ResourceLoadStatus.Loading) { HasContent = details is not null };
        try
        {
            var saved = await Client.GetRuntimeWorkerAsync(requestedWorker, cancellation.Token);
            if (request != loadVersion) return;
            if (saved.Worker.WorkerId != requestedWorker)
            {
                details = null; loadState = new(ResourceLoadStatus.Failed) { Message = T("IdentityMismatch") }; return;
            }
            details = saved; loadState = new(ResourceLoadStatus.Ready) { HasContent = true };
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception)
        {
            if (request != loadVersion) return;
            var status = exception is AgentstrationApiException api ? api.StatusCode switch
            {
                System.Net.HttpStatusCode.NotFound => ResourceLoadStatus.NotFound,
                System.Net.HttpStatusCode.Forbidden or System.Net.HttpStatusCode.Unauthorized => ResourceLoadStatus.Forbidden,
                _ => ResourceLoadStatus.Failed
            } : ResourceLoadStatus.Failed;
            if (status is ResourceLoadStatus.NotFound or ResourceLoadStatus.Forbidden) details = null;
            loadState = new(status) { HasContent = details is not null, ErrorId = (exception as AgentstrationApiException)?.ErrorId };
        }
        finally { if (request == loadVersion) loading = false; }
    }
    private static string FormatCapability(RuntimeWorkerCapabilityResponse capability) => $"{capability.RuntimeKind} {capability.CapabilityVersion}";
    private static string SoftwareVersion(string? version) => string.IsNullOrWhiteSpace(version) ? "—" : version.Split('+', 2)[0];
    private static string? SoftwareBuild(string? version) => version?.Split('+', 2) is [_, var build] ? build : null;
    private static UiStatus PresenceStatus(RuntimeWorkerPresenceState presence) => PlatformDashboardService.ToStatus(presence.ToString());
    private string RunUrl(RuntimeAssignmentPlacementResponse item)
    {
        var path = item.TargetKind == nameof(RuntimeAssignmentTargetKind.FlowRun)
            ? $"/flow-runs/{Uri.EscapeDataString(item.RunId)}"
            : $"/runs/{Uri.EscapeDataString(item.RunId)}";
        return ResourceOwnershipContext.PreserveNavigation(item.ExecutionScopeRef is { } scopeRef
            ? $"{path}?scopeRef={Uri.EscapeDataString(scopeRef.Value)}"
            : path, Services);
    }
    public void Dispose() { ++loadVersion; cancellation.Cancel(); cancellation.Dispose(); }
}
