        new(T("Schema"), Json(profile.Definition.ConfigurationSchema)),
        new(T("ToolBindings"), Json(profile.Definition.ToolBindings)),
        new(T("DiscoveryToolBindings"), Json(profile.Definition.DiscoveryToolBindings)),
        new(T("Limits"), Json(profile.Definition.Limits)),
        new(T("Policies"), Json(profile.Definition.Policies))
    ];
    private string FlowLabel(DataSourceFlowTarget flow) => $"{flow.ScopeRef} · {flow.Namespace ?? profile?.Namespace ?? ResourceNamespace.Parse(profileNamespace)}/{flow.Name} · {(flow.UseActiveVersion ? T("ActiveVersion") : flow.Version ?? "—")}";
    private static string Key(FlowSummary flow) => flow.ScopeRef is null ? string.Empty : $"{flow.ScopeRef.Value.Value}|{flow.Namespace.Value}|{flow.Id}";
