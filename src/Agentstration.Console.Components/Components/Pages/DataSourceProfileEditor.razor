@page "/data-source-profiles/new"
@page "/data-source-profiles/{Name}"
@implements IDisposable
@inject IDataSourceProfilesClient Client
@inject IFlowApiClient Flows
@inject NavigationManager Navigation
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<DataSourcesStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@inject Microsoft.Extensions.Localization.IStringLocalizer<ResourceIdentityFieldsStrings> IdentityLabels

<PageTitle>@(IsNew ? T("CreateProfile") : profile?.Definition.DisplayName ?? Name) · Agentstration</PageTitle>
@{ var presentations = Presentations; }
@if (IsNew)
{
    <UnsavedNavigationGuard IsDirty="HasDefinitionDraft" HasUnsavedChanges="@(() => HasDefinitionDraft)" />
    <PageHeader CollectionHref="/data-source-profiles" CollectionLabel="@T("Profiles")" Title="@T("CreateProfile")" Description="@T("ProfilesHelp")" TestId="data-source-profile-editor"></PageHeader>
    <ResourceLoadFeedback State="loadState" OnRetry="RetryAsync" />
    @if (loadState.HasContent)
    {
        @Feedback
        <ResourceDefinitionForm @key="model" @ref="definitionForm" EditContext="FormContext" FieldLabels="FieldLabels" Id="profile-resource-form" FormName="data-source-profile" Busy="busy" Disabled="@(!interactive)" ReadOnly="@(!CanManage)" InvalidInputChanged="value => invalidInput = value">
            <p class="required-fields-note"><span aria-hidden="true">*</span> @Shared["RequiredFields"]</p>
            <CreationWizard Steps="Steps" OnFinish="FinishAsync" Busy="busy" Disabled="@(!CanManage)" FinishLabel="@T("ProfileCreateAndPublish")" FinishTestId="profile-save" />
        </ResourceDefinitionForm>
    }
}
else
{
    <ConsoleResourceDetailsTemplate CollectionHref="@BackUrl" CollectionLabel="@T("Profiles")" Resource="profile" Name="@(profile?.Definition.DisplayName ?? Name!)" ResourceType="@T("Profile")" Domain="data" IconName="database" Description="@profile?.Definition.Description"
        Enabled="@(profile is null ? null : model.Enabled)" EnabledChanged="EnabledChanged" EnabledDisabled="@(!CanManage || busy || refreshing || HasRawDraft || !interactive)" EnabledTestId="profile-enabled"
        ResourceIdentity="@(loadedKey ?? Name!)" SectionState="sectionState" SectionPresentations="presentations" DefinitionSections="DefinitionSections" AdditionalSections="AdditionalSections"
        LoadState="loadState" OnRetry="RetryAsync" OnRefresh="RefreshAsync" DefinitionReadOnlyReason="@(HasWritePermission ? null : ResourceReadOnlyReason.InsufficientPermissions)"
        HasDraft="HasDefinitionDraft" Yaml="@rawYaml" YamlChanged="value => rawYaml = value" YamlReadOnly="@(!CanManage || HasMetadataDraft)" YamlInputTestId="profile-yaml" YamlLabel="@T("Manifest")"
        Busy="busy" TestId="data-source-profile-editor" SectionTestIdPrefix="data-source-profile">
        <Feedback>@Feedback</Feedback>
        <OverviewMetrics>@if (profile is not null) { <MetricCard Label="@T("ActiveVersion")" Value="@(profile.ActiveVersion ?? "—")" Detail="@T("Published")" Status="@(profile.ActiveVersion is null ? UiStatus.Neutral : UiStatus.Success)" /> }</OverviewMetrics>
        <OverviewConfiguration>@Configuration</OverviewConfiguration>
        <DefinitionContent Context="path"><ResourceDefinitionForm @key="model" @ref="definitionForm" EditContext="FormContext" FieldLabels="FieldLabels" Id="profile-resource-form" FormName="data-source-profile" data-resource-etag="@etag"
            Sections="presentations" SectionState="sectionState" SectionContent="DefinitionSection" SectionRequested="ShowSection" OnValidSubmit="SaveAsync"
            Busy="busy" ReadOnly="@(!CanManage)" Disabled="@(HasRawDraft || !interactive)" InvalidInputChanged="value => invalidInput = value" /></DefinitionContent>
        <AdditionalContent Context="path">@RevisionFields</AdditionalContent>
        <YamlFeedback>@if (HasMetadataDraft) { <p class="inline-info">@T("ProfileSaveBeforeYaml")</p> }</YamlFeedback>
        <Actions>@if (CanManage) { <button class="button-danger" type="button" disabled="@(busy || refreshing)" @onclick="() => confirmDelete = true">@T("Delete")</button> }</Actions>
        <DraftActions><button class="button-secondary" type="button" disabled="@(busy || refreshing)" @onclick="Discard">@Shared["Discard"]</button>@if (HasRawDraft) { <button class="button-primary" type="button" disabled="@(busy || refreshing)" @onclick="SaveYamlAsync">@T("ApplyYaml")</button> } else { <button class="button-primary" type="submit" form="profile-resource-form" disabled="@(busy || refreshing)" data-testid="profile-save">@(busy ? T("Saving") : T("Save"))</button> }</DraftActions>
    </ConsoleResourceDetailsTemplate>
}
<ConfirmationDialog IsOpen="confirmDelete" Title="@T("Delete")" Message="@T("DeleteConfirm")" ConfirmLabel="@T("Delete")" OnConfirm="DeleteAsync" OnCancel="() => confirmDelete = false" />

@code {
    private RenderFragment Feedback => @<div>
        @if (error is not null) { <div class="form-alert form-alert-danger" role="alert">@error</div> }
        @if (newer is not null) { <div class="form-alert form-alert-warning" role="status">@T("ProfileRefreshDraftConflict")</div> }
        @if (PublicationPending && profile is not null && !revisions.Any(r => r.Version == profile.Definition.Version)) { <div class="form-alert form-alert-warning" role="status">@T("ProfilePublicationPending")</div> }
    </div>;
    private RenderFragment IdentityFields => @<ResourceIdentityEditor ResourceKind="@DataSourceResourceKinds.DataSourceProfile" @bind-DisplayName="model.DisplayName" @bind-TechnicalName="model.Name"
        @bind-Namespace="model.Namespace" NamespaceEditable="true" ScopeRef="model.ScopeRef" ScopeRefChanged="ScopeChanged" ScopeValidation="ScopeValidation"
        @bind-Description="model.Description" DescriptionMaxLength="2000" Labels="@model.Tags" LabelsExpression="@(() => model.Tags)" LabelsReadOnly="true"
        IsNew="IsNew" ReadOnly="@(!CanManage)" DisplayNameTestId="profile-display-name" TechnicalNameTestId="profile-name" TestId="profile-identity-editor">
        <AdditionalPanels>@if (IsNew) { <FormSection Title="@T("State")"><label class="resource-enabled-toggle"><FormCheckbox @bind-Value="model.Enabled" role="switch" /><span>@T("Enabled")</span></label></FormSection> }</AdditionalPanels>
    </ResourceIdentityEditor>;
    private RenderFragment ScopeValidation => @<ValidationMessage For="() => model.ScopeRef" />;
    private RenderFragment Configuration => @<CollectionView TItem="ConfigurationEntry" Items="SavedConfiguration" IdentityLabel="@Shared["Configuration"]" InformationLabels="@(new[] { Shared["Saved"].Value })"><Identity Context="entry"><strong class="configuration-key">@entry.Label</strong></Identity><Information Context="entry"><CollectionValue Label="@Shared["Saved"]"><span class="configuration-value">@entry.Value</span></CollectionValue></Information></CollectionView>;
    private RenderFragment AcquisitionFields => @<FormSection Title="@T("WizardAcquisition")"><FormGrid>
        <FormField Label="@T("Version")" Required="true"><Validation><ValidationMessage For="() => model.Version" /></Validation><ChildContent><ClearableText @bind-Value="model.Version" data-testid="profile-version" /></ChildContent></FormField>
        <FormField Label="@T("Flow")" Required="true"><Validation><ValidationMessage For="() => model.FlowKey" /></Validation><ChildContent><ClearableSelect TValue="string" @bind-Value="model.FlowKey" data-testid="profile-flow"><option value="">@T("Select")</option>@if (profile is not null) { <option value="saved-acquisition">@FlowLabel(profile.Definition.AcquisitionFlow)</option> }@foreach (var flow in flows.Where(f => f.ScopeRef is not null)) { <option value="@Key(flow)">@flow.ScopeRef · @flow.Namespace/@flow.Name · @(flow.PublishedVersion ?? flow.ActiveVersion ?? "—")</option> }</ClearableSelect></ChildContent></FormField>
        <FormField Label="@T("DiscoveryFlow")" Optional="true"><ClearableSelect TValue="string" @bind-Value="model.DiscoveryFlowKey" data-testid="profile-discovery"><option value="">@T("None")</option>@if (profile?.Definition.DiscoveryFlow is { } discovery) { <option value="saved-discovery">@FlowLabel(discovery)</option> }@foreach (var flow in flows.Where(f => f.ScopeRef is not null)) { <option value="@Key(flow)">@flow.ScopeRef · @flow.Namespace/@flow.Name · @(flow.PublishedVersion ?? flow.ActiveVersion ?? "—")</option> }</ClearableSelect></FormField>
    </FormGrid></FormSection>;
    private RenderFragment ContractFields => @<FormSection Title="@T("WizardContracts")"><FormGrid><FormField Label="@T("Schema")" Class="form-span-2"><Validation><ValidationMessage For="() => model.SchemaJson" /></Validation><ChildContent><ClearableText Multiline="true" class="form-code-editor runner-json" rows="14" @bind-Value="model.SchemaJson" data-testid="profile-schemaJson" /></ChildContent></FormField><FormField Label="@T("ToolBindings")" Class="form-span-2"><Validation><ValidationMessage For="() => model.ToolBindingsJson" /></Validation><ChildContent><ClearableText Multiline="true" class="form-code-editor runner-json" rows="10" @bind-Value="model.ToolBindingsJson" data-testid="profile-toolBindingsJson" /></ChildContent></FormField><FormField Label="@T("DiscoveryToolBindings")" Class="form-span-2"><Validation><ValidationMessage For="() => model.DiscoveryToolBindingsJson" /></Validation><ChildContent><ClearableText Multiline="true" class="form-code-editor runner-json" rows="10" @bind-Value="model.DiscoveryToolBindingsJson" data-testid="profile-discoveryToolBindingsJson" /></ChildContent></FormField></FormGrid></FormSection>;
    private RenderFragment PolicyFields => @<FormSection Title="@T("ProfileExecution")"><FormGrid><FormField Label="@T("Limits")" Class="form-span-2"><Validation><ValidationMessage For="() => model.LimitsJson" /></Validation><ChildContent><ClearableText Multiline="true" class="form-code-editor runner-json" rows="6" @bind-Value="model.LimitsJson" data-testid="profile-limitsJson" /></ChildContent></FormField><FormField Label="@T("Policies")" Class="form-span-2"><Validation><ValidationMessage For="() => model.PoliciesJson" /></Validation><ChildContent><ClearableText Multiline="true" class="form-code-editor runner-json" rows="6" @bind-Value="model.PoliciesJson" data-testid="profile-policiesJson" /></ChildContent></FormField></FormGrid></FormSection>;
    private RenderFragment RevisionFields => @<FormSection Title="@T("Revisions")"><ChildContent>@if (HasDefinitionDraft) { <p class="inline-info">@T("ProfileSaveBeforePublication")</p> }<fieldset class="resource-definition-fields" disabled="@(!CanManage || busy || refreshing || HasDefinitionDraft)"><FormGrid><FormField Label="@T("Version")" Required="true"><ClearableText @bind-Value="publishVersion" data-testid="profile-publish-version" /></FormField></FormGrid>@if (CanManage) { <FormActions><button class="button-primary" type="button" disabled="@(busy || refreshing || HasDefinitionDraft)" @onclick="PublishAsync">@T("Publish")</button></FormActions> }        @if (revisions.Count == 0) { <p class="muted">@T("NoRevisions")</p> } else { <CollectionView TItem="DataSourceProfileRevisionResource" Items="revisions" InformationLabels="@(new string[] { T("Created") })" IdentityLabel="@T("Version")" StateLabel="@T("State")">
        <Identity Context="revision">
<code>@revision.Version</code></Identity>
        <State Context="revision">
<StatusBadge Text="@T(revision.Version == profile!.ActiveVersion ? "VersionState.Active" : "VersionState.Published")" Status="@(revision.Version == profile!.ActiveVersion ? UiStatus.Success : UiStatus.Neutral)" /></State>
        <Information Context="revision">
            <CollectionValue Label="@T("Created")">@revision.PublishedAt.ToLocalTime().ToString("g")</CollectionValue>
        </Information>
        <Actions Context="revision">
@if (CanManage && revision.Version != profile!.ActiveVersion) { <CollectionActions ResourceName="@(revision.Version)"><Primary><button class="text-button" type="button" disabled="@(busy || refreshing || HasDefinitionDraft)" @onclick="() => ActivateAsync(revision.Version)">@T("Activate")</button></Primary></CollectionActions> }</Actions>
    </CollectionView> }</fieldset></ChildContent></FormSection>;
    private RenderFragment Review => @<FormSection Title="@Shared["Verification"]"><ChildContent><p>@T("ProfileCreateAndPublishHelp")</p><dl class="resource-details"><dt>@T("WizardIdentity")</dt><dd>@model.DisplayName<br /><code>@model.Namespace/@model.Name</code></dd><dt>@T("Scope")</dt><dd><ResourceScopeBadge ScopeRef="model.ScopeRef" /></dd><dt>@T("Version")</dt><dd>@model.Version</dd><dt>@T("Flow")</dt><dd>@(flows.FirstOrDefault(f => Key(f) == model.FlowKey)?.Name ?? T("None"))</dd><dt>@T("State")</dt><dd>@T(model.Enabled ? "Enabled" : "Disabled")</dd></dl></ChildContent></FormSection>;

    [Parameter] public string? Name { get; set; }
    [SupplyParameterFromQuery(Name = "namespace")] public string? Namespace { get; set; }
    [SupplyParameterFromQuery(Name = "scopeRef")] public string? ScopeRef { get; set; }
    [SupplyParameterFromQuery(Name = "publicationPending")] public bool PublicationPending { get; set; }
    private readonly CancellationTokenSource cancellation = new();
    private readonly ResourceSectionState sectionState = new();
    private DataSourceProfileEditorModel model = new();
    private DataSourceProfileResource? profile;
    private IReadOnlyList<FlowSummary> flows = [];
    private IReadOnlyList<DataSourceProfileRevisionResource> revisions = [];
    private BufferedProfile? newer;
    private sealed record BufferedProfile(ResourceSnapshot<DataSourceProfileResource> Snapshot, IReadOnlyList<DataSourceProfileRevisionResource> History);
    private string? etag, error, loadedKey, returnAfterCommand;
    private string baseline = string.Empty, rawYaml = string.Empty, savedYaml = string.Empty, publishVersion = "1.0.0";
    private bool busy, refreshing, loading, confirmDelete, interactive, invalidInput;
    private long loadVersion;
    private EditContext? formContext;
    private ValidationMessageStore? messages;
    private ResourceDefinitionForm? definitionForm;
    private ResourceLoadState loadState = new(ResourceLoadStatus.Loading);
    private bool IsNew => string.IsNullOrWhiteSpace(Name);
    private bool HasWritePermission => Services.GetService(typeof(ConsoleContextState)) is not ConsoleContextState context || context.HasPermission("resources/write");
    private bool CanManage => HasWritePermission && (IsNew || profile is { Governance.IsManaged: false, ScopeRef: { } owner } && ResourceOwnershipContext.CanManage(owner, Services));
    private string Fingerprint => JsonSerializer.Serialize(model);
    private bool HasMetadataDraft => !loading && baseline.Length > 0 && (Fingerprint != baseline || invalidInput);
    private bool HasRawDraft => !loading && rawYaml != savedYaml;
    private bool HasDefinitionDraft => HasMetadataDraft || HasRawDraft;
    private string? NavigationScope => ResourceOwnershipContext.TryGetCurrent(Services)?.Value ?? (Services.GetService(typeof(ConsoleContextState)) as ConsoleContextState)?.Current?.SelectedScopeRef;
    private string BackUrl => ResourceOwnershipContext.PreserveNavigation("/data-source-profiles", Services);
    private string T(string key) => Localizer[key];
    private EditContext FormContext
    {
        get
        {
            if (formContext is not null && ReferenceEquals(formContext.Model, model)) return formContext;
            ReleaseContext(); formContext = new(model); messages = new(formContext);
            formContext.OnValidationRequested += ValidateModel; formContext.OnFieldChanged += FieldChanged; return formContext;
        }
    }
    private void ReleaseContext() { if (formContext is not null) { formContext.OnValidationRequested -= ValidateModel; formContext.OnFieldChanged -= FieldChanged; } formContext = null; messages = null; }
    private void ValidateModel(object? sender, ValidationRequestedEventArgs args)
    {
        messages!.Clear();
        foreach (var result in model.Validate(profile, flows)) foreach (var field in result.MemberNames) messages.Add(FormContext.Field(field), T(result.ErrorMessage!));
        FormContext.NotifyValidationStateChanged();
    }
    private void FieldChanged(object? sender, FieldChangedEventArgs args) { messages!.Clear(args.FieldIdentifier); FormContext.NotifyValidationStateChanged(); }
    private IReadOnlyDictionary<string, ResourceSectionPresentation> Presentations => new Dictionary<string, ResourceSectionPresentation>(StringComparer.Ordinal)
    {
        ["definition/identity"] = new() { ReadOnly = !CanManage, HasRequiredFields = true, Fields = [nameof(model.Name), nameof(model.DisplayName), nameof(model.Namespace), nameof(model.ScopeRef), nameof(model.Description), nameof(model.Tags)] },
        ["definition/configuration"] = new() { ReadOnly = !CanManage, HasRequiredFields = true, Fields = [nameof(model.Enabled), nameof(model.Version), nameof(model.FlowKey), nameof(model.DiscoveryFlowKey)] },
        ["definition/contracts"] = new() { ReadOnly = !CanManage, Fields = [nameof(model.SchemaJson), nameof(model.ToolBindingsJson), nameof(model.DiscoveryToolBindingsJson)] },
        ["definition/policies"] = new() { ReadOnly = !CanManage, Fields = [nameof(model.LimitsJson), nameof(model.PoliciesJson)] },
        ["yaml"] = new() { ReadOnly = !CanManage || HasMetadataDraft }
    };
    private IReadOnlyDictionary<string, string> FieldLabels => new Dictionary<string, string>(StringComparer.Ordinal)
    {
        [nameof(model.Name)] = IdentityLabels["TechnicalName"], [nameof(model.DisplayName)] = IdentityLabels["DisplayName"], [nameof(model.Namespace)] = T("Namespace"), [nameof(model.ScopeRef)] = T("Scope"),
        [nameof(model.Description)] = T("Description"), [nameof(model.Tags)] = Shared["Labels"], [nameof(model.Version)] = T("Version"), [nameof(model.FlowKey)] = T("Flow"), [nameof(model.DiscoveryFlowKey)] = T("DiscoveryFlow"),
        [nameof(model.SchemaJson)] = T("Schema"), [nameof(model.ToolBindingsJson)] = T("ToolBindings"), [nameof(model.DiscoveryToolBindingsJson)] = T("DiscoveryToolBindings"), [nameof(model.LimitsJson)] = T("Limits"), [nameof(model.PoliciesJson)] = T("Policies")
    };
    private IReadOnlyList<ResourceNavigationItem> DefinitionSections => [new("definition/contracts", T("WizardContracts"), "file-code"), new("definition/policies", T("ProfileExecution"), "shield")];
    private IReadOnlyList<ResourceNavigationItem> AdditionalSections => [new("revisions", T("Revisions"), "history")];
    private RenderFragment DefinitionSection(string path) => path switch { "definition/identity" => IdentityFields, "definition/configuration" => AcquisitionFields, "definition/contracts" => ContractFields, "definition/policies" => PolicyFields, _ => throw new ArgumentOutOfRangeException(nameof(path)) };
    private bool IdentityComplete => model.IdentityComplete;
    private bool AcquisitionComplete => model.AcquisitionComplete(profile, flows);
    private bool ContractsComplete => model.ContractsComplete;
    private bool PoliciesComplete => model.PoliciesComplete;
    private IReadOnlyList<CreationWizardStep> Steps => [new("identity", T("WizardIdentity"), IdentityFields) { IsComplete = IdentityComplete }, new("acquisition", T("WizardAcquisition"), AcquisitionFields) { IsComplete = AcquisitionComplete }, new("contracts", T("WizardContracts"), ContractFields) { IsComplete = ContractsComplete }, new("policies", T("ProfileExecution"), PolicyFields) { IsComplete = PoliciesComplete }, new("review", Shared["Verification"], Review) { IsComplete = IdentityComplete && AcquisitionComplete && ContractsComplete && PoliciesComplete }];
    private void ScopeChanged(ResourceScopeRef? value) { var initializing = model.ScopeRef is null && Fingerprint == baseline; model.ScopeRef = value; if (initializing) baseline = Fingerprint; }
    private void EnabledChanged(bool value) { if (!CanManage || busy || refreshing || HasRawDraft) return; model.Enabled = value; sectionState.Visit("definition/identity"); }
    private void ShowSection(string path) => Navigation.NavigateTo(Navigation.Uri.Split('#')[0] + "#" + path);
    private async Task FinishAsync(CreationWizardFinish finish)
    {
        if (!FormContext.Validate()) { finish.ReturnToStepId = !IdentityComplete ? "identity" : !AcquisitionComplete ? "acquisition" : !ContractsComplete ? "contracts" : "policies"; definitionForm?.RequestValidationFocus(); return; }
        await SaveAsync();
    }
    private void Clear()
    {
        ReleaseContext(); profile = null; model = new(); newer = null; etag = error = null; baseline = rawYaml = savedYaml = string.Empty;
        flows = []; revisions = []; invalidInput = confirmDelete = false;
    }
    private void Apply(ResourceSnapshot<DataSourceProfileResource> saved, IReadOnlyList<DataSourceProfileRevisionResource> history, bool preservePublicationInput = false)
    {
        var pendingVersion = preservePublicationInput && profile is not null && publishVersion != profile.Definition.Version ? publishVersion : null;
        ReleaseContext(); profile = saved.Value; etag = saved.ETag; revisions = history; model = DataSourceProfileEditorModel.From(profile);
        publishVersion = pendingVersion ?? profile.Definition.Version; newer = null; invalidInput = false; rawYaml = savedYaml = ToYaml(profile); baseline = Fingerprint;
    }
    protected override Task OnParametersSetAsync()
    {
        var key = $"{Name}|{Namespace}|{ScopeRef}|{NavigationScope}";
        if (key == loadedKey) return Task.CompletedTask;
        loadedKey = key; return LoadAsync();
    }
    private async Task LoadAsync()
    {
        var request = ++loadVersion; loading = true; busy = refreshing = false; Clear(); loadState = new(ResourceLoadStatus.Loading);
        try
        {
            if (Services.GetService(typeof(ConsoleContextState)) is ConsoleContextState context)
            {
                await context.EnsureLoadedAsync(cancellation.Token); if (request != loadVersion) return;
                if (context.Current is null) throw new InvalidOperationException(context.Error);
            }
            loadedKey = $"{Name}|{Namespace}|{ScopeRef}|{NavigationScope}";
            var available = await Flows.GetFlowsAsync(cancellation.Token); if (request != loadVersion) return;
            if (IsNew)
            {
                model.ScopeRef = string.IsNullOrWhiteSpace(ScopeRef) ? null : ResourceScopeRef.Parse(ScopeRef);
                model.Namespace = ResourceNamespace.Parse(Namespace).Value; baseline = Fingerprint;
            }
            else
            {
                var ownerValue = string.IsNullOrWhiteSpace(ScopeRef) ? NavigationScope : ScopeRef;
                if (string.IsNullOrWhiteSpace(ownerValue)) throw new ArgumentException(T("ProfileIdentityInvalid"));
                var owner = ResourceScopeRef.Parse(ownerValue);
                var ns = ResourceNamespace.Parse(Namespace); var requestedName = Name!;
                var saved = await Client.GetAsync(ns, requestedName, owner, cancellation.Token); if (request != loadVersion) return;
                if (saved.Value.Name != requestedName || saved.Value.Namespace != ns || saved.Value.ScopeRef != owner) throw new InvalidOperationException(T("ProfileResourceIdentityMismatch"));
                var history = await Client.GetRevisionsAsync(ns, requestedName, owner, cancellation.Token); if (request != loadVersion) return;
                Apply(saved, history);
            }
            flows = available; loadState = new(ResourceLoadStatus.Ready) { HasContent = true };
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception) { if (request == loadVersion) { Clear(); loadState = Failure(exception); } }
        finally { if (request == loadVersion) loading = false; }
    }
    private Task RetryAsync() => busy || refreshing || loading ? Task.CompletedTask : profile is null ? LoadAsync() : RefreshAsync();
    private async Task RefreshAsync()
    {
        if (busy || refreshing || loading || profile is not { ScopeRef: { } owner } current) return;
        var request = ++loadVersion; refreshing = true; loadState = new(ResourceLoadStatus.Refreshing) { HasContent = true };
        try
        {
            var saved = await Client.GetAsync(current.Namespace, current.Name, owner, cancellation.Token); if (request != loadVersion) return;
            if (!SameIdentity(current, saved.Value)) { Clear(); loadState = new(ResourceLoadStatus.NotFound); return; }
            var history = await Client.GetRevisionsAsync(current.Namespace, current.Name, owner, cancellation.Token); if (request != loadVersion) return;
            if (HasDefinitionDraft) newer = saved.ETag != etag || saved.Value.Generation != current.Generation ? new(saved, history) : null;
            else Apply(saved, history, preservePublicationInput: true);
            loadState = new(ResourceLoadStatus.Ready) { HasContent = true };
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception) { if (request == loadVersion) { var state = Failure(exception); if (state.Status is ResourceLoadStatus.Forbidden or ResourceLoadStatus.NotFound) Clear(); loadState = state with { HasContent = profile is not null }; } }
        finally { if (request == loadVersion) refreshing = false; }
    }
    private static bool SameIdentity(DataSourceProfileResource original, DataSourceProfileResource next) => original.Uid == next.Uid && original.Address == next.Address && original.ScopeRef == next.ScopeRef;
    private static ResourceLoadState Failure(Exception exception) => new(exception is AgentstrationApiException api ? api.StatusCode switch { System.Net.HttpStatusCode.NotFound => ResourceLoadStatus.NotFound, System.Net.HttpStatusCode.Forbidden or System.Net.HttpStatusCode.Unauthorized => ResourceLoadStatus.Forbidden, _ => ResourceLoadStatus.Failed } : ResourceLoadStatus.Failed) { ErrorId = (exception as AgentstrationApiException)?.ErrorId };
    private void Discard() { if (busy || refreshing || profile is null) return; Apply(newer?.Snapshot ?? new(profile, etag!), newer?.History ?? revisions); error = null; }
    private async Task SaveAsync()
    {
        if (!CanManage || busy || refreshing || loading || HasRawDraft || !interactive) return;
        if (!FormContext.Validate()) { if (definitionForm is not null && !IsNew) await definitionForm.RevealValidationAsync(); return; }
        var request = loadVersion; busy = true; error = null;
        try
        {
            if (IsNew)
            {
                var saved = await Client.CreateAsync(new(model.Name.Trim(), model.Definition(profile, flows), model.Namespace.Trim(), model.ScopeRef), cancellation.Token); if (request != loadVersion) return;
                Apply(saved, []);
                try { await Client.PublishAsync(saved.Value.Namespace, saved.Value.Name, saved.Value.ScopeRef!.Value, new(model.Version.Trim()), cancellation.Token); }
                catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { return; }
                catch (Exception) { if (request == loadVersion) returnAfterCommand = Url(saved.Value) + "&publicationPending=true#revisions"; return; }
                if (request == loadVersion) returnAfterCommand = Url(saved.Value);
            }
            else
            {
                var current = profile!; var saved = await Client.UpdateAsync(current.Namespace, current.Name, current.ScopeRef!.Value, new(model.Definition(current, flows)), etag!, cancellation.Token); if (request != loadVersion) return;
                if (!SameIdentity(current, saved.Value)) { Clear(); loadState = new(ResourceLoadStatus.NotFound); return; }
                Apply(saved, revisions);
            }
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception) { if (request == loadVersion) error = exception.Message; }
        finally { if (request == loadVersion) busy = false; }
    }
    private async Task SaveYamlAsync()
    {
        if (!CanManage || busy || refreshing || HasMetadataDraft || profile is not { ScopeRef: { } owner } current) return;
        var request = loadVersion; busy = true; error = null;
        try
        {
            var raw = ResourceManifestSerializer.FromYaml<RawProfile>(rawYaml);
            if (raw.Metadata.Name != current.Name || raw.Metadata.Namespace != current.Namespace || raw.ScopeRef != owner) throw new ArgumentException(T("IdentityImmutable"));
            var saved = await Client.UpdateAsync(current.Namespace, current.Name, owner, new(raw.Definition), etag!, cancellation.Token); if (request != loadVersion) return;
            if (!SameIdentity(current, saved.Value)) { Clear(); loadState = new(ResourceLoadStatus.NotFound); return; }
            Apply(saved, revisions);
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception) { if (request == loadVersion) error = exception.Message; }
        finally { if (request == loadVersion) busy = false; }
    }
    private async Task PublishAsync()
    {
        if (!CanManage || busy || refreshing || HasDefinitionDraft || profile is not { ScopeRef: { } owner } current) return;
        var request = loadVersion; busy = true; error = null;
        try
        {
            await Client.PublishAsync(current.Namespace, current.Name, owner, new(publishVersion.Trim()), cancellation.Token); if (request != loadVersion) return;
            await ReloadAfterCommandAsync(current, request);
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
