@page "/data-source-profiles/new"
@page "/data-source-profiles/{Name}"
@implements IDisposable
@inject IDataSourceProfilesClient Client
@inject IFlowApiClient Flows
@inject NavigationManager Navigation
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<DataSourcesStrings> Localizer

<PageTitle>@(profile?.Definition.DisplayName ?? T(IsNew ? "CreateProfile" : "Profiles")) · Agentstration</PageTitle>
<PageHeader Title="@(profile?.Definition.DisplayName ?? T("CreateProfile"))" Description="@T("ProfilesHelp")" TestId="data-source-profile-editor">
    <Actions>@if (!IsNew && CanManage) { <button class="button-danger" type="button" @onclick="() => confirmDelete = true">@T("Delete")</button> }<a class="button-secondary" href="/data-source-profiles">@T("Back")</a></Actions>
</PageHeader>
@if (loading) { <LoadingState Message="@T("Loading")" /> }
else
{
    @if (error is not null) { <div class="form-alert form-alert-danger" role="alert">@error</div> }
    @if (!IsNew && selectedScope is not null) { <InheritedResourceNotice OwnerScopeRef="selectedScope.Value" /> }
    @if (!IsNew)
    {
        <ResourceTabs Label="@T("Profiles")">@foreach (var value in Enum.GetValues<Tab>().Where(value => CanManageAccess || value is not Tab.Access)) { <button type="button" role="tab" class="@(tab == value ? "active" : null)" @onclick="() => tab = value">@T(value.ToString())</button> }</ResourceTabs>
    }
    @if (tab == Tab.Overview && !IsNew)
    {
        <section class="metric-grid"><MetricCard Label="@T("ActiveVersion")" Value="@(profile?.ActiveVersion ?? "—")" Detail="@T("Published")" Status="@(profile?.ActiveVersion is null ? UiStatus.Warning : UiStatus.Success)" /><MetricCard Label="@T("DraftVersion")" Value="@version" Detail="@T(enabled ? "Enabled" : "Disabled")" Status="@(enabled ? UiStatus.Success : UiStatus.Warning)" /></section>
        <ExtensionManagedResourcePanel Governance="profile!.Governance" ScopeRef="profile.ScopeRef!.Value" Namespace="profile.Namespace" Kind="@DataSourceResourceKinds.DataSourceProfile" Name="@profile.Name" Uid="profile.Uid" />
        <FormSection Title="@profile!.Definition.AcquisitionFlow.Name" Eyebrow="@T("Flow")"><ChildContent><ResourceScopeBadge ScopeRef="profile.ScopeRef" /></ChildContent></FormSection>
    }
    else if (tab == Tab.Definition || IsNew)
    {
        <EditForm Model="this" OnValidSubmit="SaveAsync" class="panel form-section"><fieldset class="resource-definition-fields" disabled="@(!CanManage)">
            <FormGrid>
                <ResourceIdentityFields @bind-DisplayName="displayName" @bind-TechnicalName="technicalName" IsNew="@IsNew" />
                <FormField Label="@T("Namespace")"><ClearableText @bind-Value="profileNamespace" Disabled="@(!IsNew)" /></FormField>
                @if (IsNew) { <ResourceScopeFormField ResourceKind="@DataSourceResourceKinds.DataSourceProfile" @bind-Value="selectedScope" /> }
                else { <label><span>@T("Scope")</span><ResourceScopeBadge ScopeRef="selectedScope" /></label> }
                <FormField Label="@T("Description")" Optional="true" Class="form-span-2"><ClearableText Multiline="true" @bind-Value="description" maxlength="2000"></ClearableText></FormField>
                <FormField Label="@T("Version")" Required="true"><ClearableText @bind-Value="version" required /></FormField>
                <FormField Label="@T("Flow")" Required="true"><ClearableSelect TValue="string" @bind-Value="flowKey" required><option value="">@T("Select")</option>@foreach (var flow in flows) { <option value="@Key(flow)">@flow.ScopeRef · @flow.Namespace/@flow.Name · @(flow.ActiveVersion ?? flow.Version ?? "—")</option> }</ClearableSelect></FormField>
                <FormField Label="@T("DiscoveryFlow")"><ClearableSelect TValue="string" @bind-Value="discoveryFlowKey"><option value="">@T("None")</option>@foreach (var flow in flows) { <option value="@Key(flow)">@flow.ScopeRef · @flow.Namespace/@flow.Name · @(flow.ActiveVersion ?? flow.Version ?? "—")</option> }</ClearableSelect></FormField>
                <FormField Label="@T("Schema")" Class="form-field-wide form-span-2"><ChildContent><ClearableText UpdateOnInput="false" Multiline="true" class="form-code-editor runner-json" rows="14" @bind-Value="schemaJson"></ClearableText></ChildContent></FormField>
                <FormField Label="@T("ToolBindings")" Class="form-field-wide form-span-2"><ChildContent><ClearableText UpdateOnInput="false" Multiline="true" class="form-code-editor runner-json" rows="10" @bind-Value="toolBindingsJson"></ClearableText></ChildContent></FormField>
                <FormField Label="@T("DiscoveryToolBindings")" Class="form-field-wide form-span-2"><ChildContent><ClearableText UpdateOnInput="false" Multiline="true" class="form-code-editor runner-json" rows="10" @bind-Value="discoveryToolBindingsJson"></ClearableText></ChildContent></FormField>
                <FormField Label="@T("Limits")" Class="form-field-wide form-span-2"><ChildContent><ClearableText UpdateOnInput="false" Multiline="true" class="form-code-editor runner-json" rows="6" @bind-Value="limitsJson"></ClearableText></ChildContent></FormField>
                <FormField Label="@T("Policies")" Class="form-field-wide form-span-2"><ChildContent><ClearableText UpdateOnInput="false" Multiline="true" class="form-code-editor runner-json" rows="6" @bind-Value="policiesJson"></ClearableText></ChildContent></FormField>
                <label class="profile-choice form-span-2"><FormCheckbox @bind-Value="enabled" /><span class="profile-choice-icon"><UiIcon Name="check" /></span><span><strong>@T("Enabled")</strong></span></label>
            </FormGrid>
            @if (CanManage) { <FormActions><button class="button-primary" type="submit" disabled="@busy">@(busy ? T("Saving") : T("Save"))</button></FormActions> }
        </fieldset></EditForm>
    }
    else if (tab == Tab.Revisions)
    {
        <section class="panel form-section"><fieldset class="resource-definition-fields" disabled="@(!CanManage)"><FormGrid><FormField Label="@T("Version")" Required="true"><ClearableText @bind-Value="publishVersion" /></FormField></FormGrid>@if (CanManage) { <FormActions><button class="button-primary" type="button" disabled="@busy" @onclick="PublishAsync">@T("Publish")</button></FormActions> }
        @if (revisions.Count == 0) { <p class="muted">@T("NoRevisions")</p> } else { <CollectionView TItem="DataSourceProfileRevisionResource" Items="revisions" InformationLabels="@(new string[] { T("Created") })" IdentityLabel="@T("Version")" StateLabel="@T("State")">
        <Identity Context="revision">
<code>@revision.Version</code></Identity>
        <State Context="revision">
<StatusBadge Text="@T(revision.Version == profile!.ActiveVersion ? "VersionState.Active" : "VersionState.Published")" Status="@(revision.Version == profile!.ActiveVersion ? UiStatus.Success : UiStatus.Neutral)" /></State>
        <Information Context="revision">
            <CollectionValue Label="@T("Created")">@revision.PublishedAt.ToLocalTime().ToString("g")</CollectionValue>
        </Information>
        <Actions Context="revision">
@if (CanManage && revision.Version != profile!.ActiveVersion) { <CollectionActions ResourceName="@(revision.Version)"> <button class="text-button" type="button" @onclick="() => ActivateAsync(revision.Version)">@T("Activate")</button> </CollectionActions> }</Actions>
    </CollectionView> }</fieldset></section>
    }
    else if (tab == Tab.Access && CanManageAccess)
    {
        <ResourceAccessPanel OwnerScopeRef="selectedScope!.Value" Namespace="profile!.Namespace" Kind="@DataSourceResourceKinds.DataSourceProfile" Name="@profile.Name" Generation="profile.Generation" Governance="profile.Governance" />
    }
    else if (tab == Tab.Yaml)
    {
        <section class="panel form-section"><FormField Label="@T("Manifest")" Class="profile-yaml-field"><ChildContent><ClearableText UpdateOnInput="false" Multiline="true" class="form-code-editor runner-json" rows="30" @bind-Value="rawYaml" ReadOnly="@(!CanManage)"></ClearableText></ChildContent></FormField>@if (CanManage) { <FormActions><button class="button-primary" type="button" disabled="@busy" @onclick="SaveYamlAsync">@T("ApplyYaml")</button></FormActions> }</section>
    }
}
<ConfirmationDialog IsOpen="@confirmDelete" Title="@T("Delete")" Message="@T("DeleteConfirm")" ConfirmLabel="@T("Delete")" OnConfirm="DeleteAsync" OnCancel="() => confirmDelete = false" />

@code {
    [Parameter] public string? Name { get; set; }
    [SupplyParameterFromQuery(Name = "namespace")] public string? Namespace { get; set; }
    [SupplyParameterFromQuery(Name = "scopeRef")] public string? ScopeRef { get; set; }
    private readonly CancellationTokenSource cancellation = new();
    private IReadOnlyList<FlowSummary> flows = [];
    private IReadOnlyList<DataSourceProfileRevisionResource> revisions = [];
    private DataSourceProfileResource? profile;
    private ResourceScopeRef? selectedScope;
    private string? etag, error;
    private string technicalName = string.Empty, displayName = string.Empty, profileNamespace = "default", description = string.Empty, version = "1.0.0", publishVersion = "1.0.0", flowKey = string.Empty, discoveryFlowKey = string.Empty;
    private string schemaJson = "{\n  \"type\": \"object\",\n  \"additionalProperties\": true\n}", toolBindingsJson = "[]", discoveryToolBindingsJson = "[]", limitsJson = "{}", policiesJson = "{}", rawYaml = string.Empty;
    private bool enabled = true, loading = true, busy, confirmDelete;
    private Tab tab = Tab.Definition;
    private bool IsNew => string.IsNullOrWhiteSpace(Name);
    private bool CanManageAccess => selectedScope is not null && ResourceOwnershipContext.CanManage(selectedScope.Value, Services);
    private bool CanManage => IsNew || profile?.Governance.IsManaged != true && CanManageAccess;
    private string T(string key) => Localizer[key];
    protected override Task OnParametersSetAsync() => LoadAsync();
    private async Task LoadAsync() { loading = true; error = null; try { flows = await Flows.GetFlowsAsync(cancellation.Token); if (!IsNew) { selectedScope = ResourceScopeRef.Parse(ScopeRef!); var snapshot = await Client.GetAsync(ResourceNamespace.Parse(Namespace), Name!, selectedScope.Value, cancellation.Token); profile = snapshot.Value; etag = snapshot.ETag; revisions = await Client.GetRevisionsAsync(profile.Namespace, profile.Name, selectedScope.Value, cancellation.Token); LoadForm(); tab = Tab.Overview; } } catch (Exception exception) { error = exception.Message; } finally { loading = false; } }
    private void LoadForm() { technicalName = profile!.Name; displayName = profile.Definition.DisplayName; profileNamespace = profile.Namespace.Value; description = profile.Definition.Description ?? string.Empty; version = profile.Definition.Version; publishVersion = version; enabled = profile.Definition.Enabled; flowKey = Key(profile.Definition.AcquisitionFlow, profile.Namespace); discoveryFlowKey = profile.Definition.DiscoveryFlow is null ? string.Empty : Key(profile.Definition.DiscoveryFlow, profile.Namespace); var options = new JsonSerializerOptions { WriteIndented = true }; schemaJson = JsonSerializer.Serialize(profile.Definition.ConfigurationSchema, options); toolBindingsJson = JsonSerializer.Serialize(profile.Definition.ToolBindings, options); discoveryToolBindingsJson = JsonSerializer.Serialize(profile.Definition.DiscoveryToolBindings, options); limitsJson = JsonSerializer.Serialize(profile.Definition.Limits, options); policiesJson = JsonSerializer.Serialize(profile.Definition.Policies, options); rawYaml = ResourceManifestSerializer.ToYaml(new RawProfile { ApiVersion = profile.ApiVersion, Kind = profile.Kind, Metadata = profile.Metadata, ScopeRef = profile.ScopeRef, Definition = profile.Definition }); }
    private DataSourceProfileProperties Definition() { using var schema = JsonDocument.Parse(schemaJson); var parts = flowKey.Split('|', 3); var discoveryParts = discoveryFlowKey.Split('|', 3); if (parts.Length != 3) throw new InvalidOperationException(T("Select")); return new() { DisplayName = displayName.Trim(), Description = string.IsNullOrWhiteSpace(description) ? null : description.Trim(), Enabled = enabled, Version = version.Trim(), ConfigurationSchema = schema.RootElement.Clone(), AcquisitionFlow = new() { ScopeRef = ResourceScopeRef.Parse(parts[0]), Name = parts[2], Namespace = ResourceNamespace.Parse(parts[1]), UseActiveVersion = true }, DiscoveryFlow = discoveryParts.Length == 3 ? new() { ScopeRef = ResourceScopeRef.Parse(discoveryParts[0]), Name = discoveryParts[2], Namespace = ResourceNamespace.Parse(discoveryParts[1]), UseActiveVersion = true } : null, ToolBindings = JsonSerializer.Deserialize<IReadOnlyList<DataSourceProfileToolBinding>>(toolBindingsJson) ?? [], DiscoveryToolBindings = JsonSerializer.Deserialize<IReadOnlyList<DataSourceProfileToolBinding>>(discoveryToolBindingsJson) ?? [], Limits = JsonSerializer.Deserialize<IReadOnlyDictionary<string, JsonElement>>(limitsJson) ?? new Dictionary<string, JsonElement>(), Policies = JsonSerializer.Deserialize<IReadOnlyDictionary<string, JsonElement>>(policiesJson) ?? new Dictionary<string, JsonElement>() }; }
    private async Task SaveAsync() { busy = true; error = null; try { if (IsNew) { if (selectedScope is null) throw new InvalidOperationException(T("Scope")); var saved = await Client.CreateAsync(new(technicalName.Trim(), Definition(), profileNamespace.Trim(), selectedScope), cancellation.Token); await Client.PublishAsync(saved.Value.Namespace, saved.Value.Name, selectedScope.Value, new(version.Trim()), cancellation.Token); Navigation.NavigateTo(Url(saved.Value)); } else { var saved = await Client.UpdateAsync(profile!.Namespace, profile.Name, selectedScope!.Value, new(Definition()), etag!, cancellation.Token); profile = saved.Value; etag = saved.ETag; LoadForm(); } } catch (Exception exception) { error = exception.Message; } finally { busy = false; } }
    private async Task PublishAsync() { busy = true; try { await Client.PublishAsync(profile!.Namespace, profile.Name, selectedScope!.Value, new(publishVersion.Trim()), cancellation.Token); await ReloadAsync(); } catch (Exception exception) { error = exception.Message; } finally { busy = false; } }
    private async Task ActivateAsync(string value) { busy = true; try { var saved = await Client.ActivateAsync(profile!.Namespace, profile.Name, selectedScope!.Value, new(value), etag!, cancellation.Token); profile = saved.Value; etag = saved.ETag; } catch (Exception exception) { error = exception.Message; } finally { busy = false; } }
    private async Task SaveYamlAsync() { try { var raw = ResourceManifestSerializer.FromYaml<RawProfile>(rawYaml); if (raw.Metadata.Name != profile!.Name || raw.Metadata.Namespace != profile.Namespace || raw.ScopeRef != profile.ScopeRef) throw new ArgumentException(T("IdentityImmutable")); var saved = await Client.UpdateAsync(profile.Namespace, profile.Name, selectedScope!.Value, new(raw.Definition), etag!, cancellation.Token); profile = saved.Value; etag = saved.ETag; LoadForm(); } catch (Exception exception) { error = exception.Message; } }
    private async Task ReloadAsync() { var saved = await Client.GetAsync(profile!.Namespace, profile.Name, selectedScope!.Value, cancellation.Token); profile = saved.Value; etag = saved.ETag; revisions = await Client.GetRevisionsAsync(profile.Namespace, profile.Name, selectedScope.Value, cancellation.Token); LoadForm(); }
    private async Task DeleteAsync() { confirmDelete = false; await Client.DeleteAsync(profile!.Namespace, profile.Name, selectedScope!.Value, etag!, cancellation.Token); Navigation.NavigateTo("/data-source-profiles"); }
    private static string Key(FlowSummary flow) => flow.ScopeRef is null ? string.Empty : $"{flow.ScopeRef.Value.Value}|{flow.Namespace.Value}|{flow.Id}";
    private string Key(DataSourceFlowTarget target, ResourceNamespace owner)
    {
        var @namespace = target.Namespace ?? owner;
        var scopeRef = target.ScopeRef ?? flows.Where(value => value.Namespace == @namespace && value.Id == target.Name)
            .Select(value => value.ScopeRef).SingleOrDefault();
        return scopeRef is null ? string.Empty : $"{scopeRef.Value.Value}|{@namespace.Value}|{target.Name}";
    }
    private static string Url(DataSourceProfileResource item) => $"/data-source-profiles/{Uri.EscapeDataString(item.Name)}?namespace={Uri.EscapeDataString(item.Namespace.Value)}&scopeRef={Uri.EscapeDataString(item.ScopeRef!.Value.Value)}";
    private sealed record RawProfile { public required string ApiVersion { get; init; } public required string Kind { get; init; } public required ResourceMetadata Metadata { get; init; } public ResourceScopeRef? ScopeRef { get; init; } public required DataSourceProfileProperties Definition { get; init; } }
    private enum Tab { Overview, Definition, Revisions, Access, Yaml }
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
