@implements IDisposable
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<DataSourcesStrings> Localizer

<section class="form-section" data-testid="flow-sequence-editor">
    <h3>@Title</h3><p>@T("SequenceHelp")</p>
    @if (loadFailed) { <p role="status">@T("SequenceUnavailable")</p> }
    @if (!loading && !loadFailed && options.Count == 0) { <p role="status">@T("SequenceNoPublishedFlows")</p> }
    @if (Value.Count == 0) { <p class="muted">@T("SequenceIdentity")</p> }
    @for (var index = 0; index < Value.Count; index++)
    {
        var position = index; var call = Value[index]; var selected = options.FirstOrDefault(option => Key(option.Reference) == Key(call.Flow));
        <fieldset class="form-section" disabled="@ReadOnly" data-testid="flow-sequence-call" data-flow-reference="@Key(call.Flow)">
            <legend>@Localizer["SequencePosition", index + 1]</legend>
            <label><span>@T("SequenceFlow")</span><select value="@Key(call.Flow)" @onchange="args => SelectAsync(position, args.Value?.ToString())" data-testid="flow-sequence-target">
                @if (selected is null) { <option value="@Key(call.Flow)" selected>@call.Flow.ResourceId · @call.Flow.Version · @T("SequenceUnavailable")</option> }
                @foreach (var option in options) { <option value="@Key(option.Reference)" selected="@(Key(option.Reference) == Key(call.Flow))">@option.Label</option> }
            </select></label>
            <div><span>@T("Parameters")</span><JsonSchemaInputEditor Schema="selected?.Parameters" Value="call.Parameters" ValueChanged="value => SetParametersAsync(position, value)" Disabled="ReadOnly" /></div>
            <div class="form-actions">
                <button type="button" class="button-secondary" disabled="@(ReadOnly || index == 0)" @onclick="() => MoveAsync(position, -1)" data-testid="flow-sequence-up">@T("SequenceUp")</button>
                <button type="button" class="button-secondary" disabled="@(ReadOnly || index == Value.Count - 1)" @onclick="() => MoveAsync(position, 1)" data-testid="flow-sequence-down">@T("SequenceDown")</button>
                <button type="button" class="text-button" disabled="@ReadOnly" @onclick="() => RemoveAsync(position)" data-testid="flow-sequence-remove">@T("SequenceRemove")</button>
            </div>
        </fieldset>
    }
    <div class="form-actions">
        <button type="button" class="button-secondary" disabled="@(ReadOnly || loading || options.Count == 0 || Value.Count >= 32)" @onclick="AddAsync" data-testid="flow-sequence-add">@T("SequenceAdd")</button>
        <button type="button" class="button-secondary" disabled="@(ReadOnly || loading || loadFailed || CreationInput is null || CreationOutput is null)" @onclick="OpenCreator" data-testid="flow-sequence-create">@T("SequenceCreate")</button>
        <button type="button" class="text-button" disabled="@loading" @onclick="LoadAsync" data-testid="flow-sequence-refresh">@T("SequenceRefresh")</button>
    </div>
    @if (showCreator && creation is { } contract)
    {
        <FlowTransformationCreator @key="creationRevision" InputSchema="contract.InputSchema" OutputSchema="contract.OutputSchema" ReadOnly="ReadOnly" Created="LoadAsync" Close="() => showCreator = false" />
    }
</section>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<FlowCompositionCall> Value { get; set; } = [];
    [Parameter] public EventCallback<IReadOnlyList<FlowCompositionCall>> ValueChanged { get; set; }
    [Parameter] public JsonElement? InputSchema { get; set; }
    [Parameter] public JsonElement? OutputSchema { get; set; }
    [Parameter] public FlowCallReference? TemplateFlow { get; set; }
    [Parameter] public string TemplatePoint { get; set; } = "transformations";
    [Parameter] public bool ReadOnly { get; set; }
    private readonly CancellationTokenSource cancellation = new();
    private readonly List<Option> options = [];
    private bool loadFailed, loading, showCreator;
    private JsonElement? templateInput, templateOutput;
    private FlowTransformationTemplate? creation;
    private int creationRevision;
    private JsonElement? CreationInput => Value.Count == 0 ? InputSchema ?? templateInput
        : options.FirstOrDefault(option => Key(option.Reference) == Key(Value[^1].Flow))?.OutputSchema;
    private JsonElement? CreationOutput => OutputSchema ?? templateOutput;
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        options.Clear(); templateInput = null; templateOutput = null; loadFailed = false;
        if (Services.GetService(typeof(IFlowApiClient)) is not IFlowApiClient flows) { loadFailed = true; return; }
        loading = true;
        try
        {
            var summaries = await flows.GetFlowsAsync(cancellation.Token);
            foreach (var summary in summaries.Take(200))
            {
                var flow = await flows.GetFlowAsync(summary.Namespace, summary.Id, summary.ScopeRef, cancellation.Token);
                if (!flow.Enabled || flow.ScopeRef is null) continue;
                foreach (var version in await flows.GetFlowVersionsAsync(flow.Namespace, flow.Id, flow.ScopeRef, cancellation.Token))
                {
                    if (TemplateFlow is { } template && flow.Id == template.ResourceId && flow.ScopeRef == template.ScopeRef && flow.Namespace == (template.Namespace ?? ResourceNamespace.Default)
                        && (template.Version is null || version.Version == template.Version))
                    {
                        var point = version.Graph?.Steps.OfType<FlowCompositionPointStepDefinition>().SingleOrDefault(value => value.Point == TemplatePoint);
                        templateInput = point?.InputSchema.Clone(); templateOutput = point?.OutputSchema.Clone();
                    }
                    if (version.Graph?.ResolveInputSchema() is { } input && input.TryGetProperty("properties", out var properties)
                        && properties.TryGetProperty("value", out _) && properties.TryGetProperty("parameters", out var parameters))
                        options.Add(new(new(flow.Id, FlowCallVersionStrategy.Exact, version.Version, flow.Namespace, flow.ScopeRef),
                            $"{flow.DisplayName ?? flow.Name} · {flow.ScopeRef} · {flow.Namespace}/{flow.Name}:{version.Version}", parameters.Clone(), version.Graph.ResolveSingleSuccessOutputSchema(out _)));
                }
            }
        }
        catch (Exception exception) when (exception is not OperationCanceledException) { options.Clear(); loadFailed = true; }
        finally { loading = false; }
    }
    private void OpenCreator()
    {
        if (ReadOnly || loading || loadFailed || CreationInput is not { } input || CreationOutput is not { } output) return;
        creation = new(input.Clone(), output.Clone()); creationRevision++; showCreator = true;
    }
    private static string Key(FlowCallReference reference) => $"{reference.ScopeRef}|{reference.Namespace}|{reference.ResourceId}|{reference.Version}";
    private Task AddAsync() => ValueChanged.InvokeAsync([.. Value, new FlowCompositionCall { Flow = options[0].Reference }]);
    private Task RemoveAsync(int position) => ValueChanged.InvokeAsync(Value.Where((_, index) => index != position).ToArray());
    private Task SetParametersAsync(int position, JsonElement parameters) => ValueChanged.InvokeAsync(Value.Select((value, index) => index == position ? value with { Parameters = parameters.Clone() } : value).ToArray());
    private Task SelectAsync(int position, string? key) => ValueChanged.InvokeAsync(Value.Select((value, index) => index == position ? new FlowCompositionCall { Flow = options.Single(option => Key(option.Reference) == key).Reference } : value).ToArray());
    private Task MoveAsync(int position, int direction)
    { var values = Value.ToArray(); (values[position], values[position + direction]) = (values[position + direction], values[position]); return ValueChanged.InvokeAsync(values); }
    private string T(string key) => Localizer[key];
    private sealed record Option(FlowCallReference Reference, string Label, JsonElement Parameters, JsonElement? OutputSchema);
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
