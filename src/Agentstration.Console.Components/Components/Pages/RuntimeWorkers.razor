@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@page "/settings/runtime-workers"
@implements IDisposable
@inject IRuntimeApiClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<RuntimeWorkerStrings> Localizer

<PageTitle>@T("RuntimeWorkers") · Agentstration</PageTitle>
<PageHeader Title="@T("RuntimeWorkers")" Description="@T("Description")" TestId="runtime-workers" />
@if (items is null) { <LoadingState Message="@T("Loading")" /> }
else if (items.Count == 0) { <EmptyState Title="@T("Empty")" Message="@T("EmptyMessage")" /> }
else
{
    <section class="runtime-workers-grid">
    <CollectionView TItem="RuntimeWorkerSummaryResponse" Items="items" InformationLabels="@(new string[] { T("Session"), T("Version"), T("Capacity"), T("Capabilities"), T("LastSeen") })" RowTestId="runtime-worker-row" ItemAttributes="@((item) => new Dictionary<string, object> { ["data-worker-id"] = item.WorkerId.ToString("D"), ["data-presence"] = item.Presence.ToString(), ["data-session-id"] = item.SessionId?.ToString("D") ?? string.Empty })" IdentityLabel="@T("Worker")" StateLabel="@T("Presence")">
        <Identity Context="item">
<CollectionIdentity DisplayName="@item.DisplayName" Name="@item.WorkerId.ToString()" Href="@WorkerUrl(item)" IconName="server" /></Identity>
        <State Context="item">
<StatusBadge Text="@T($"Presence.{item.Presence}")" Status="@PlatformDashboardService.ToStatus(item.Presence.ToString())" /><small>@T($"Enrollment.{item.EnrollmentState}")</small></State>
        <Information Context="item">
            <CollectionValue Label="@T("Session")"><code class="runtime-token" title="@item.SessionId?.ToString("D")">@(item.SessionId?.ToString("D") ?? "—")</code></CollectionValue>
            <CollectionValue Label="@T("Version")"><span class="runtime-primary">@SoftwareVersion(item.SoftwareVersion)</span>@if (SoftwareBuild(item.SoftwareVersion) is { } build) { <small class="runtime-token" title="@item.SoftwareVersion">+@build</small> }</CollectionValue>
            <CollectionValue Label="@T("Capacity")"><span class="runtime-primary">@(item.MaximumConcurrentAssignments?.ToString() ?? "—")</span><small>@T("ActiveAssignments", item.ActiveAssignments)</small></CollectionValue>
            <CollectionValue Label="@T("Capabilities")">@string.Join(", ", item.Capabilities.Select(FormatCapability))</CollectionValue>
            <CollectionValue Label="@T("LastSeen")">@(item.LastSeenAt?.LocalDateTime.ToString("g") ?? "—")</CollectionValue>
        </Information>
        <Actions Context="item"><CollectionActions ResourceName="@item.DisplayName"><a href="@WorkerUrl(item)">@Shared["OpenItem"]</a></CollectionActions></Actions>
    </CollectionView>
    </section>
}

@code {
    private readonly CancellationTokenSource cancellation = new();
    private IReadOnlyList<RuntimeWorkerSummaryResponse>? items;
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    protected override async Task OnInitializedAsync() => items = await Client.GetRuntimeWorkersAsync(cancellation.Token);
    private static string FormatCapability(RuntimeWorkerCapabilityResponse capability) =>
        $"{capability.RuntimeKind} {capability.CapabilityVersion} · material {string.Join('/', capability.ExecutionMaterialVersions)}"
        + (string.IsNullOrWhiteSpace(capability.RuntimeImplementationVersion) ? string.Empty : $" · {capability.RuntimeImplementationVersion}");
    private static string SoftwareVersion(string? version) => string.IsNullOrWhiteSpace(version) ? "—" : version.Split('+', 2)[0];
    private static string? SoftwareBuild(string? version) => version?.Split('+', 2) is [_, var build] ? build : null;
    private static string WorkerUrl(RuntimeWorkerSummaryResponse worker) => $"/settings/runtime-workers/{worker.WorkerId:D}";
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
