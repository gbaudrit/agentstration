@page "/knowledge-sources"
@implements IDisposable
@inject IServiceProvider Services
@inject IKnowledgeSourcesClient Client
@inject ConsoleContextState Context
@inject Microsoft.Extensions.Localization.IStringLocalizer<KnowledgeSourcesStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared

<PageTitle>@T("Title") · Agentstration</PageTitle>
<ResourceCollectionTemplate TItem="KnowledgeSourceResource" Title="@T("Title")" Description="@T("Description")" TestId="resource-knowledge-sources"
                            IdentityColumn="IdentityColumn" Columns="Columns" AdditionalFilters="ExtraFilters" Items="PageItems" ContextKey="@contextKey" RowTestId="knowledge-source-row"
                            Query="query" QueryChanged="ChangeQueryAsync" Pagination="Pagination" LoadState="loadState" Disabled="@(!interactive)"
                            SearchEnabled SearchLabel="@Shared["Search"]" SearchPlaceholder="@Shared["Search"]"
                            EmptyTitle="@T("EmptyTitle")" EmptyMessage="@T("EmptyMessage")" PrimaryActions="CreateAction" EmptyActions="CreateAction" OnRefresh="LoadAsync" OnRetry="RetryAsync">
    <Actions><a class="button-secondary" href="@Navigate("/artifacts")">@T("OpenArtifacts")</a><a class="button-secondary" href="@Navigate("/tools/sets")">@T("OpenToolSets")</a></Actions>
</ResourceCollectionTemplate>

@code {
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string Navigate(string path) => ResourceOwnershipContext.PreserveNavigation(path, Services);
    private RenderFragment? CreateAction => Context.HasPermission(AuthorizationPermissions.ResourcesWrite)
        ? @<PermissionGate Permission="@AuthorizationPermissions.ResourcesWrite"><a class="button-primary" href="@Navigate("/knowledge-sources/new")">@T("CreateSource")</a></PermissionGate> : null;
    private CollectionColumn<KnowledgeSourceResource> IdentityColumn => new("identity", T("KnowledgeSource"), source => @<CollectionIdentity DisplayName="@source.Definition.DisplayName" Namespace="@source.Namespace.Value" Name="@source.Name" Href="@DetailsUrl(source)" IconName="database" data-testid="knowledge-source-name-link">
        <IconBadges><ResourceScopeBadge ScopeRef="source.ScopeRef" ShowName IconOnly /><StatusBadge Text="@T(source.Definition.Enabled ? "Enabled" : "Disabled")" Status="@(source.Definition.Enabled ? UiStatus.Success : UiStatus.Warning)" IconOnly /><ManagedResourceBadge IsManaged="@source.Governance.IsManaged" IsReadOnly="@(!ResourceOwnershipContext.CanManage(source.ScopeRef, Services))" IconOnly /></IconBadges>
    </CollectionIdentity>)
    {
        Filters = [new("enabled", T("State"), CollectionFilterKind.Choice) { Options = [new("true", T("Enabled")), new("false", T("Disabled"))] }]
    };
    private IReadOnlyList<CollectionColumn<KnowledgeSourceResource>> Columns =>
    [
        new("inputs", T("DataSources"), source => @<text>@if (source.Definition.DataSources.Count > 0) { <span class="knowledge-source-inputs">@foreach (var binding in source.Definition.DataSources) { <a class="text-button" href="@DataSourceUrl(source, binding.DataSource)" data-testid="knowledge-source-data-source-link">@binding.DataSource.Name</a> }</span> } else { <span>—</span> }</text>)
        {
            Filters = [new("inputs", T("DataSources"), CollectionFilterKind.Text) { Advanced = true }]
        },
        new("projection", T("ProjectionFlow"), source => @<text>@if (source.Definition.ProjectionFlow is { } projection) { <a class="text-button knowledge-source-flow" href="@FlowUrl(source, projection)" data-testid="knowledge-source-projection-flow-link">@Flow(source, projection)</a> } else { <span>—</span> }</text>)
        {
            Filters = [new("projection", T("ProjectionFlow"), CollectionFilterKind.Text) { Advanced = true }]
        },
        new("retrieval", T("RetrievalFlow"), source => @<text>@if (source.Definition.RetrievalFlow is { } retrieval) { <a class="text-button knowledge-source-flow" href="@FlowUrl(source, retrieval)">@Flow(source, retrieval)</a> } else { <span>—</span> }</text>)
        {
            Filters = [new("retrieval", T("RetrievalFlow"), CollectionFilterKind.Text) { Advanced = true }]
        }
    ];
    private IReadOnlyList<CollectionFilter> ExtraFilters =>
    [
        new("namespace", Shared["Namespace"], CollectionFilterKind.Choice)
        {
            Options = (items ?? []).Select(source => source.Namespace.Value).Distinct(StringComparer.Ordinal).Order().Select(value => new CollectionFilterOption(value, value)).ToArray()
        },
        new("scope", T("Scope"), CollectionFilterKind.Choice)
        {
            Options = (items ?? []).Select(source => source.ScopeRef?.Value).OfType<string>().Distinct(StringComparer.Ordinal).Order().Select(value => new CollectionFilterOption(value, value)).ToArray()
        }
    ];
    private string Flow(KnowledgeSourceResource source, KnowledgeFlowTarget value) => $"{value.Namespace ?? source.Namespace}/{value.Name}:{value.Version ?? T("ActiveVersionLabel")}";
    private string DetailsUrl(KnowledgeSourceResource value) => ResourceOwnershipContext.Resource(Services, "/knowledge-sources", value.Name, value.Namespace, value.ScopeRef);
    private string DataSourceUrl(KnowledgeSourceResource source, ResourceReference value) => ResourceOwnershipContext.Resource(Services, "/data-sources", value.Name, value.Namespace ?? source.Namespace, value.ScopeRef ?? source.ScopeRef);
    private string FlowUrl(KnowledgeSourceResource source, KnowledgeFlowTarget value) => Navigate(ConsoleResourceUrls.Flow(new FlowId(value.Name, value.Namespace ?? source.Namespace), value.ScopeRef ?? source.ScopeRef));
}
