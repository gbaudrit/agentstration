@page "/tools/sets/{Name}"
@implements IDisposable
@inject IToolSetsClient Client
@inject NavigationManager Navigation
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<ToolSetsStrings> Localizer

<PageTitle>@(toolSet?.Definition.DisplayName ?? Name) · Agentstration</PageTitle>
<PageHeader Title="@(toolSet?.Definition.DisplayName ?? Name)" Description="@(toolSet?.Definition.Description ?? T("DetailsDescription"))" TestId="resource-toolset-details">
    <Actions><a class="button-secondary" href="/tools/sets">@T("Back")</a>@if (toolSet is not null && CanMutate) { <button class="button-danger" type="button" @onclick="() => confirmDelete = true">@T("Delete")</button> }</Actions>
</PageHeader>

@if (loading) { <LoadingState Message="@T("LoadingDetails")" /> }
else if (error is not null) { <ErrorState Message="@error" /> }
else if (toolSet is not null)
{
    @if (message is not null) { <div class="form-alert form-alert-danger" role="alert">@message</div> }
    <InheritedResourceNotice OwnerScopeRef="@(toolSet.ScopeRef ?? ResourceScopeRef.Instance)" />
    <ResourceTabs Label="@T("DetailsDescription")"><button type="button" class="@(activeTab == DetailsTab.Overview ? "active" : null)" @onclick="() => activeTab = DetailsTab.Overview">@T("Overview")</button>@if (CanManage) { <button type="button" class="@(activeTab == DetailsTab.Access ? "active" : null)" data-testid="toolset-access-tab" @onclick="() => activeTab = DetailsTab.Access">@T("Access")</button> }</ResourceTabs>
    @if (activeTab == DetailsTab.Overview)
    {
    <section class="metric-grid" aria-label="@T("Overview")">
        <MetricCard Label="@T("DraftVersion")" Value="@toolSet.Definition.Version" Detail="@T(toolSet.Definition.Publish ? "PublishRequested" : "Draft")" Status="UiStatus.Info" />
        <MetricCard Label="@T("Members")" Value="@toolSet.Definition.Members.Count.ToString()" Detail="@T("GovernedIndividually")" Status="UiStatus.Neutral" />
        <MetricCard Label="@T("PublishedVersions")" Value="@versions.Count.ToString()" Detail="@T("Immutable")" Status="UiStatus.Success" />
    </section>
    <ExtensionManagedResourcePanel Governance="toolSet.Governance" ScopeRef="@(toolSet.ScopeRef ?? ResourceScopeRef.Instance)" Namespace="toolSet.Namespace" Kind="@ToolResourceKinds.ToolSet" Name="@toolSet.Name" Uid="toolSet.Uid" />
    <FormSection Title="@T("DescriptiveMetadata")" Eyebrow="@T("Metadata")" Description="@T("MetadataHelp")"><ChildContent>
        <dl class="resource-details"><dt>@T("Identity")</dt><dd><code>@toolSet.Namespace/@toolSet.Name</code></dd><dt>@T("Category")</dt><dd>@(toolSet.Definition.Category?.Name ?? "—")</dd><dt>@T("Tags")</dt><dd>@Map(toolSet.Metadata.Tags)</dd><dt>@T("Annotations")</dt><dd>@Map(toolSet.Metadata.Annotations)</dd></dl>
    </ChildContent></FormSection>
    <FormSection Title="@T("PublishedVersions")" Eyebrow="@T("Publication")" Description="@T("PinnedHelp")" TestId="toolset-versions"><ChildContent>
        @if (versions.Count == 0) { <p class="muted">@T("NoVersions")</p> }
        @foreach (var version in versions.OrderByDescending(value => value.PublishedAt))
        {
            <article class="panel" data-testid="toolset-version">
                <div class="panel-header"><div><h3>@T("VersionLabel", version.Version)</h3><code>@version.DefinitionHash</code></div><StatusBadge Text="@T("Immutable")" Status="UiStatus.Success" /></div>
                <CollectionView TItem="PublishedToolSetMember" Items="version.Members" InformationLabels="@(new string[] { T("Capability"), T("Route"), T("Provider"), T("Generation"), T("Approval") })" IdentityLabel="@T("Tool")">
        <Identity Context="member"><CollectionIdentity DisplayName="@member.ToolName" Namespace="@member.ToolNamespace.Value" Name="@member.ToolName" Href="@ToolUrl(member)" IconName="wrench" ><IconBadges><ResourceScopeBadge ScopeRef="member.ToolScopeRef" IconOnly /><ManagedResourceBadge IsReadOnly="@(!ResourceOwnershipContext.CanManage(member.ToolScopeRef, Services))" IconOnly /></IconBadges></CollectionIdentity></Identity>
        <Information Context="member">
            <CollectionValue Label="@T("Capability")"><code>@member.Capability</code></CollectionValue>
            <CollectionValue Label="@T("Route")"><code>@member.Route</code></CollectionValue>
            <CollectionValue Label="@T("Provider")">@member.ProviderNamespace/@member.ProviderName</CollectionValue>
            <CollectionValue Label="@T("Generation")">@member.ToolGeneration</CollectionValue>
            <CollectionValue Label="@T("Approval")">@T(member.RequiresApproval ? "Required" : "NotRequired")</CollectionValue>
        </Information>
    <Actions Context="member"><CollectionActions ResourceName="@($"{member.ToolNamespace}/{member.ToolName}, {member.ToolScopeRef}")"><a href="@ToolUrl(member)">@T("Inspect")</a></CollectionActions></Actions>
                </CollectionView>
            </article>
        }
    </ChildContent></FormSection>
    }
    else if (CanManage)
    {
        <ResourceAccessPanel OwnerScopeRef="@(toolSet.ScopeRef ?? ResourceScopeRef.Instance)" Namespace="toolSet.Namespace" Kind="@ToolResourceKinds.ToolSet" Name="@toolSet.Name" Generation="toolSet.Generation" Version="toolSet.Definition.Version" Governance="toolSet.Governance" />
    }
}

@if (confirmDelete)
{
    <section class="dialog" role="dialog" aria-modal="true" aria-labelledby="delete-toolset-title"><h2 id="delete-toolset-title">@T("DeleteTitle")</h2><p>@T("DeleteHelp")</p><FormActions><button class="button-secondary" type="button" @onclick="() => confirmDelete = false">@T("Cancel")</button><button class="button-danger" type="button" @onclick="DeleteAsync" disabled="@busy">@T("ConfirmDelete")</button></FormActions></section>
}

@code {
    [Parameter] public string Name { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "namespace")] public string? Namespace { get; set; }
    [SupplyParameterFromQuery(Name = "scopeRef")] public string? ScopeRefValue { get; set; }
    private readonly CancellationTokenSource cancellation = new();
    private ToolSetResource? toolSet;
    private IReadOnlyList<ToolSetVersionResource> versions = [];
    private string? etag, error, message;
    private bool loading = true, busy, confirmDelete;
    private DetailsTab activeTab;
    private ResourceNamespace ResourceNamespace => Agentstration.Resources.ResourceNamespace.Parse(Namespace);
    private bool CanManage => toolSet is not null && ResourceOwnershipContext.CanManage(toolSet.ScopeRef ?? ResourceScopeRef.Instance, Services);
    private bool CanMutate => CanManage && toolSet?.Governance.IsManaged == false;
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        error = null;
        try
        {
            var scopeRef = string.IsNullOrWhiteSpace(ScopeRefValue) ? (ResourceScopeRef?)null : ResourceScopeRef.Parse(ScopeRefValue);
            var snapshotTask = scopeRef is { } exact
                ? Client.GetToolSetAsync(exact, ResourceNamespace, Name, cancellation.Token)
                : Client.GetToolSetAsync(ResourceNamespace, Name, cancellation.Token);
            var versionsTask = scopeRef is { } owner
                ? Client.GetVersionsAsync(owner, ResourceNamespace, Name, cancellation.Token)
                : Client.GetVersionsAsync(ResourceNamespace, Name, cancellation.Token);
            await Task.WhenAll(snapshotTask, versionsTask);
            var snapshot = await snapshotTask;
            toolSet = snapshot.Value;
            etag = snapshot.ETag;
            versions = await versionsTask;
        }
        catch (Exception exception) { error = exception.Message; }
        finally { loading = false; }
    }
    private async Task DeleteAsync()
    {
        if (!CanMutate || etag is null || busy) return;
        busy = true;
        message = null;
        try
        {
            if (ScopeRefValue is { Length: > 0 })
                await Client.DeleteAsync(ResourceScopeRef.Parse(ScopeRefValue), ResourceNamespace, Name, etag, cancellation.Token);
            else await Client.DeleteAsync(ResourceNamespace, Name, etag, cancellation.Token);
            Navigation.NavigateTo("/tools/sets");
        }
        catch (Exception exception) { message = exception.Message; confirmDelete = false; }
        finally { busy = false; }
    }
    private static string ToolUrl(PublishedToolSetMember member) =>
        $"/tools/{Uri.EscapeDataString(member.ToolName)}?namespace={Uri.EscapeDataString(member.ToolNamespace.Value)}&scopeRef={Uri.EscapeDataString(member.ToolScopeRef.Value)}&context={Uri.EscapeDataString(member.ToolScopeRef.Value)}";
    private static string Map(IReadOnlyDictionary<string, string> values) => values.Count == 0 ? "—" : string.Join(" · ", values.Select(value => $"{value.Key}={value.Value}"));
    private enum DetailsTab { Overview, Access }
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
