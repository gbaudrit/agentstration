@page "/tools/sets/{Name}"
@implements IDisposable
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@inject IToolSetsClient Client
@inject NavigationManager Navigation
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<ToolSetsStrings> Localizer

<UnsavedNavigationGuard IsDirty="policyDirty" HasUnsavedChanges="@(() => policyDirty)" />
<PageTitle>@(toolSet?.Definition.DisplayName ?? Name) · Agentstration</PageTitle>
@if (loading) { <LoadingState Message="@T("LoadingDetails")" /> }
else if (error is not null) { <ErrorState Message="@error" /> }
else if (toolSet is not null)
{
    <ResourceDetailsTemplate Name="@toolSet.Definition.DisplayName" Description="@toolSet.Definition.Description" ResourceType="@T("ToolSet")" Domain="tool" IconName="layers"
                             TechnicalName="@toolSet.Name" Namespace="@toolSet.Namespace.Value" ScopeRef="toolSet.ScopeRef" Enabled="toolSet.Definition.Enabled"
                             Sections="Sections" ResourceIdentity="@($"{loadedKey}|{toolSet.Uid}")" DefaultSection="overview" SelectionChanged="SelectSection" TestId="resource-toolset-details">
        <Actions><a class="button-secondary" href="@BackUrl">@T("Back")</a>@if (CanMutate) { <button class="button-danger" type="button" disabled="@busy" @onclick="() => confirmDelete = true">@T("Delete")</button> }</Actions>
        <Feedback>@if (message is not null) { <div class="form-alert form-alert-danger" role="alert">@message</div> }@if (toolSet.ScopeRef is { } owner) { <InheritedResourceNotice OwnerScopeRef="owner" /> }</Feedback>
        <Content>
        <div hidden="@(section != "overview")">
    <section class="metric-grid" aria-label="@T("Overview")">
        <MetricCard Label="@T("DraftVersion")" Value="@toolSet.Definition.Version" Detail="@T(toolSet.Definition.Publish ? "PublishRequested" : "Draft")" Status="UiStatus.Info" />
        <MetricCard Label="@T("Members")" Value="@toolSet.Definition.Members.Count.ToString()" Detail="@T("GovernedIndividually")" Status="UiStatus.Neutral" />
        <MetricCard Label="@T("PublishedVersions")" Value="@versions.Count.ToString()" Detail="@T("Immutable")" Status="UiStatus.Success" />
    </section>
    <ResourceIdentitySummary DisplayName="@toolSet.Definition.DisplayName" TechnicalName="@toolSet.Name" Namespace="@toolSet.Namespace.Value" Description="@toolSet.Definition.Description"><Scope><ResourceScopeBadge ScopeRef="toolSet.ScopeRef" /></Scope></ResourceIdentitySummary>
    <FormSection Title="@Shared["Configuration"]" Class="resource-configuration-summary"><CollectionView TItem="ConfigurationEntry" Items="SavedConfiguration" IdentityLabel="@Shared["Configuration"]" InformationLabels="@(new[] { Shared["Saved"].Value })"><Identity Context="entry"><strong class="configuration-key">@entry.Label</strong></Identity><Information Context="entry"><CollectionValue Label="@Shared["Saved"]"><span class="configuration-value">@entry.Value</span></CollectionValue></Information></CollectionView></FormSection>
    @if (toolSet.ScopeRef is { } managedOwner) { <ExtensionManagedResourcePanel Governance="toolSet.Governance" ScopeRef="managedOwner" Namespace="toolSet.Namespace" Kind="@ToolResourceKinds.ToolSet" Name="@toolSet.Name" Uid="toolSet.Uid" /> }
    </div>
    <div hidden="@(section != "versions")">
    <FormSection Title="@T("PublishedVersions")" Eyebrow="@T("Publication")" Description="@T("PinnedHelp")" TestId="toolset-versions"><ChildContent>
        @if (versions.Count == 0) { <p class="muted">@T("NoVersions")</p> }
        @foreach (var version in versions.OrderByDescending(value => value.PublishedAt))
        {
            <article class="panel" data-testid="toolset-version">
                <div class="panel-header"><div><h3>@T("VersionLabel", version.Version)</h3><code>@version.DefinitionHash</code></div><StatusBadge Text="@T("Immutable")" Status="UiStatus.Success" /></div>
                <CollectionView TItem="PublishedToolSetMember" Items="version.Members" InformationLabels="@(new string[] { T("Capability"), T("Route"), T("Provider"), T("Generation"), T("Approval") })" IdentityLabel="@T("Tool")">
        <Identity Context="member"><CollectionIdentity DisplayName="@member.ToolName" Namespace="@member.ToolNamespace.Value" Name="@member.ToolName" Href="@ToolUrl(member)" IconName="wrench" ><IconBadges><ResourceScopeBadge ScopeRef="member.ToolScopeRef" IconOnly /><ManagedResourceBadge IsReadOnly="@(!ResourceOwnershipContext.CanManage(member.ToolScopeRef, Services))" IconOnly /></IconBadges></CollectionIdentity></Identity>
        <Information Context="member">
            <CollectionValue Label="@T("Capability")"><code>@member.Capability</code></CollectionValue>
            <CollectionValue Label="@T("Route")"><code>@member.Route</code></CollectionValue>
            <CollectionValue Label="@T("Provider")">@member.ProviderNamespace/@member.ProviderName</CollectionValue>
            <CollectionValue Label="@T("Generation")">@member.ToolGeneration</CollectionValue>
            <CollectionValue Label="@T("Approval")">@T(member.RequiresApproval ? "Required" : "NotRequired")</CollectionValue>
        </Information>
    <Actions Context="member"><CollectionActions ResourceName="@($"{member.ToolNamespace}/{member.ToolName}, {member.ToolScopeRef}")"><a href="@ToolUrl(member)">@T("Inspect")</a></CollectionActions></Actions>
                </CollectionView>
            </article>
        }
    </ChildContent></FormSection>
        </div>
    @if (accessVisited && CanManage && toolSet.ScopeRef is { } accessOwner)
    {
        <div hidden="@(section != "access")"><ResourceAccessPanel ResourceUid="toolSet.Uid" DraftChanged="value => policyDirty = value" OwnerScopeRef="accessOwner" Namespace="toolSet.Namespace" Kind="@ToolResourceKinds.ToolSet" Name="@toolSet.Name" Generation="toolSet.Generation" Version="toolSet.Definition.Version" Governance="toolSet.Governance" /></div>
    }
        </Content>
    </ResourceDetailsTemplate>
}
<ConfirmationDialog IsOpen="confirmDelete" Title="@T("DeleteTitle")" Message="@T("DeleteHelp")" ConfirmLabel="@T("ConfirmDelete")" OnConfirm="DeleteAsync" OnCancel="() => confirmDelete = false" />

@code {
    [Parameter] public string Name { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "namespace")] public string? Namespace { get; set; }
    [SupplyParameterFromQuery(Name = "scopeRef")] public string? ScopeRefValue { get; set; }
    private readonly CancellationTokenSource cancellation = new();
    private ToolSetResource? toolSet;
    private IReadOnlyList<ToolSetVersionResource> versions = [];
    private string? etag, error, message;
    private bool loading = true, busy, confirmDelete;
    private string section = "overview";
    private bool accessVisited, policyDirty;
    private string? loadedKey;
    private long loadVersion;
    private string BackUrl => ResourceOwnershipContext.PreserveNavigation("/tools/sets", Services);
    private IReadOnlyList<ResourceNavigationItem> Sections => [new("overview", T("Overview"), "home"), new("versions", T("PublishedVersions"), "history"), new("access", T("Access"), "lock") { Visible = CanManage }];
    private void SelectSection(string? value) { section = value ?? "overview"; accessVisited |= section == "access"; }
    private sealed record ConfigurationEntry(string Label, string Value);
    private IReadOnlyList<ConfigurationEntry> SavedConfiguration => toolSet is null ? [] : [
        new(Shared["Enabled"], T(toolSet.Definition.Enabled ? "Enabled" : "Disabled")),
        new(T("Category"), toolSet.Definition.Category is { } category ? ReferenceText(category) : "—"),
        new(T("DraftVersion"), toolSet.Definition.Version), new(T("Publication"), T(toolSet.Definition.Publish ? "PublishRequested" : "Draft")),
        new(T("Members"), string.Join("\n", toolSet.Definition.Members.Select(m => $"{m.Capability} · {m.Route} · {ReferenceText(m.Tool)}"))),
        new(T("Tags"), Map(toolSet.Metadata.Tags)), new(T("Annotations"), Map(toolSet.Metadata.Annotations))];
    private ResourceNamespace ResourceNamespace => Agentstration.Resources.ResourceNamespace.Parse(Namespace);
    private bool CanManage => toolSet is not null && toolSet.ScopeRef is { } owner && ResourceOwnershipContext.CanManage(owner, Services);
    private bool CanMutate => CanManage && toolSet?.Governance.IsManaged == false;
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Name}|{Namespace}|{ScopeRefValue}|{ResourceOwnershipContext.TryGetCurrent(Services)}";
        if (key == loadedKey) return;
        loadedKey = key; var request = ++loadVersion;
        loading = true; error = message = null; toolSet = null; versions = [];
        section = "overview"; accessVisited = policyDirty = confirmDelete = busy = false;
        try
        {
            var requestedName = Name; var requestedNamespace = ResourceNamespace;
            var scopeRef = string.IsNullOrWhiteSpace(ScopeRefValue) ? (ResourceScopeRef?)null : ResourceScopeRef.Parse(ScopeRefValue);
            var snapshotTask = scopeRef is { } exact
                ? Client.GetToolSetAsync(exact, requestedNamespace, requestedName, cancellation.Token)
                : Client.GetToolSetAsync(requestedNamespace, requestedName, cancellation.Token);
            var versionsTask = scopeRef is { } owner
                ? Client.GetVersionsAsync(owner, requestedNamespace, requestedName, cancellation.Token)
                : Client.GetVersionsAsync(requestedNamespace, requestedName, cancellation.Token);
            await Task.WhenAll(snapshotTask, versionsTask);
            if (request != loadVersion) return;
            var snapshot = await snapshotTask;
            if (snapshot.Value.Name != requestedName || snapshot.Value.Namespace != requestedNamespace || scopeRef is { } requestedOwner && snapshot.Value.ScopeRef != requestedOwner)
                throw new InvalidOperationException(T("ResourceIdentityMismatch"));
            toolSet = snapshot.Value;
            etag = snapshot.ETag;
            versions = await versionsTask;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception) { if (request == loadVersion) { error = exception.Message; loadedKey = null; } }
        finally { if (request == loadVersion) loading = false; }
    }
    private async Task DeleteAsync()
    {
        if (!CanMutate || etag is null || busy) return;
        busy = true; confirmDelete = false;
        message = null; var request = loadVersion;
        try
        {
            await Client.DeleteAsync(toolSet!.ScopeRef!.Value, toolSet.Namespace, toolSet.Name, etag, cancellation.Token);
            if (request == loadVersion) Navigation.NavigateTo(BackUrl);
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception) { if (request == loadVersion) message = exception.Message; }
        finally { if (request == loadVersion) busy = false; }
    }
    private string ToolUrl(PublishedToolSetMember member) => ResourceOwnershipContext.Resource(Services, "/tools", member.ToolName, member.ToolNamespace, member.ToolScopeRef);

    private string ReferenceText(ResourceReference reference) => $"{(reference.ScopeRef is { } owner ? owner.Value + " · " : "")}{reference.Namespace ?? toolSet!.Namespace}/{reference.Name}";
    private static string Map(IReadOnlyDictionary<string, string> values) => values.Count == 0 ? "—" : string.Join(" · ", values.Select(value => $"{value.Key}={value.Value}"));
    public void Dispose() { loadVersion++; cancellation.Cancel(); cancellation.Dispose(); }
}
