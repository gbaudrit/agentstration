@page "/tools/definitions"
@implements IDisposable
@inject IServiceProvider Services
@inject IToolDefinitionsClient Client
@inject IConsoleNavigationContext NavigationContext
@inject ConsoleContextState Context
@inject Microsoft.Extensions.Localization.IStringLocalizer<ToolsStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared

<PageTitle>@T("DefinitionsTitle") · Agentstration</PageTitle>
<ResourceCollectionTemplate TItem="ToolDefinitionResource" Title="@T("DefinitionsTitle")" Description="@T("DefinitionsDescription")"
                            TestId="resource-tool-definitions" ContextKey="@contextKey" IconName="wrench"
                            IdentityColumn="IdentityColumn" Columns="Columns" AdditionalFilters="ExtraFilters" Items="PageItems"
                            Query="query" QueryChanged="ChangeQueryAsync" Pagination="Pagination" LoadState="loadState" Disabled="@(!interactive)"
                            SearchEnabled SearchLabel="@Shared["Search"]" SearchPlaceholder="@Shared["Search"]"
                            EmptyTitle="@T("DefinitionsEmptyTitle")" EmptyMessage="@T("DefinitionsEmptyMessage")" PrimaryActions="CreateAction" EmptyActions="CreateAction"
                            OnRefresh="LoadAsync" OnRetry="RetryAsync">
    <Navigation>
        <ResourceTabs Label="@T("SectionsLabel")"><a href="@Navigate("/tools")">@T("Catalog")</a><a href="@Navigate("/tools/sets")">@T("ToolSets")</a><a href="@Navigate("/tools/categories")">@T("Categories")</a><a class="active" href="@Navigate("/tools/definitions")">@T("Definitions")</a><a href="@Navigate("/tools/providers")">@T("Providers")</a></ResourceTabs>
    </Navigation>
    <ItemActions Context="definition">
        <CollectionActions ResourceName="@($"{definition.Definition.DisplayName} ({definition.Namespace}/{definition.Name}, {definition.ScopeRef})")"><Primary><a class="button-secondary" href="@EditUrl(definition)">@T("EditAction")</a></Primary></CollectionActions>
    </ItemActions>
</ResourceCollectionTemplate>

@code {
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string BooleanLabel(bool value) => T(value ? "Yes" : "No");
    private RenderFragment? CreateAction => Context.HasPermission(AuthorizationPermissions.ResourcesWrite)
        ? @<PermissionGate Permission="@AuthorizationPermissions.ResourcesWrite"><a class="button-primary" href="@NavigationContext.AddToUri("/tools/definitions/new")">@T("NewDefinition")</a></PermissionGate> : null;
    private CollectionColumn<ToolDefinitionResource> IdentityColumn => new("identity", T("Tool"), definition => @<CollectionIdentity DisplayName="@definition.Definition.DisplayName" Namespace="@definition.Namespace.Value" Name="@definition.Name" Href="@EditUrl(definition)" IconName="wrench">
        <IconBadges><ResourceScopeBadge ScopeRef="definition.ScopeRef" ShowName IconOnly /><StatusBadge Text="@BooleanLabel(definition.Definition.Enabled)" Status="@(definition.Definition.Enabled ? UiStatus.Success : UiStatus.Neutral)" IconOnly /><ManagedResourceBadge IsManaged="@definition.Governance.IsManaged" IsReadOnly="@(!ResourceOwnershipContext.CanManage(definition.ScopeRef, Services))" IconOnly /></IconBadges>
    </CollectionIdentity>)
    {
        Filters = [BooleanFilter("enabled", T("Enabled"))]
    };
    private IReadOnlyList<CollectionColumn<ToolDefinitionResource>> Columns =>
    [
        new("kind", T("ToolKind"), definition => @<span>@T($"Kind.{Kind(definition)}")<br /><code>@Target(definition)</code></span>)
        {
            Filters = [new("kind", T("ToolKind"), CollectionFilterKind.Choice)
            {
                Options = new[] { "Flow", "Relay", "Acquisition" }.Select(value => new CollectionFilterOption(value, T($"Kind.{value}"))).ToArray()
            }]
        },
        new("approval", T("RequiresApproval"), definition => @<span>@BooleanLabel(definition.Definition.RequiresApproval)</span>)
        {
            Filters = [BooleanFilter("approval", T("RequiresApproval"))]
        }
    ];
    private CollectionFilter BooleanFilter(string key, string label) => new(key, label, CollectionFilterKind.Choice)
    {
        Options = [new("true", BooleanLabel(true)), new("false", BooleanLabel(false))]
    };
    private IReadOnlyList<CollectionFilter> ExtraFilters =>
    [
        new("namespace", Shared["Namespace"], CollectionFilterKind.Choice)
        {
            Options = (definitions ?? []).Select(definition => definition.Namespace.Value).Distinct(StringComparer.Ordinal).Order().Select(value => new CollectionFilterOption(value, value)).ToArray()
        }
    ];
    private static string Kind(ToolDefinitionResource value) => value.Definition switch { RelayToolDefinitionProperties => "Relay", AcquisitionToolDefinitionProperties => "Acquisition", _ => "Flow" };
    private static string Target(ToolDefinitionResource value) => value.Definition switch
    {
        RelayToolDefinitionProperties relay => $"{relay.Target.Namespace}/{relay.Target.Name} · {relay.Target.Generation}",
        AcquisitionToolDefinitionProperties acquisition => $"{acquisition.Acquisition.TemplateNamespace}/{acquisition.Acquisition.TemplateId}",
        FlowToolDefinitionProperties flow => $"{flow.Flow.Namespace ?? value.Namespace}/{flow.Flow.Name}:{(flow.Flow.UseActiveVersion ? "active" : flow.Flow.Version)}",
        _ => "—"
    };
    private string Navigate(string path) => ResourceOwnershipContext.PreserveNavigation(path, Services);
    private string EditUrl(ToolDefinitionResource value) => ResourceOwnershipContext.Resource(Services, "/tools/definitions", value.Name, value.Namespace, value.ScopeRef);
}
