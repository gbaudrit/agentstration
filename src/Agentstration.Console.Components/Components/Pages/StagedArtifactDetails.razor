@page "/artifacts/staged/{Id}"
@implements IDisposable
@inject IArtifactsClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@inject IServiceProvider Services
@inject NavigationManager Navigation
@inject TimeProvider TimeProvider
@inject Microsoft.Extensions.Localization.IStringLocalizer<ArtifactsStrings> Localizer

<PageTitle>@(artifact?.FileName ?? Id) · Agentstration</PageTitle>
<ConfirmationDialog IsOpen="confirmPurge" Title="@T("DeleteTitle")" Message="@T("PurgeHelp")" ConfirmLabel="@T("ConfirmDelete")" CancelLabel="@T("Cancel")" TestId="staged-artifact-purge-confirmation" OnConfirm="PurgeAsync" OnCancel="() => confirmPurge = false" />

@if (loading)
{
    <LoadingState Message="@T("Loading")" />
}
else if (error is not null)
{
    <ErrorState Message="@error" />
}
else if (artifact is not null)
{
    <ResourceDetailsTemplate Name="@artifact.FileName" ResourceType="@T("Staged")" Domain="artifact" IconName="file"
                             Description="@T("DetailsDescription")" StatusText="@T($"Status.{artifact.Status}")" Status="@Tone(artifact.Status)"
                             Sections="Sections" ResourceIdentity="@loadedKey" DefaultSection="overview" SelectionChanged="SelectSection" TestId="staged-artifact-details">
        <Metadata><CopyableValue Value="@artifact.ArtifactId.ToString()" /></Metadata>
        <Actions><button class="button-danger" type="button" disabled="@(busy || !PurgeEligible)" title="@(!PurgeEligible ? T("PurgeIneligible") : null)" data-testid="staged-artifact-delete" @onclick="() => confirmPurge = true">@T("Delete")</button><a class="button-secondary" href="@ResourceOwnershipContext.PreserveNavigation("/artifacts", Services)">@T("Back")</a></Actions>
        <Feedback>@if (message is not null) { <div class="form-alert @(failed ? "form-alert-danger" : "form-alert-success")" role="status">@message</div> }</Feedback>
        <Content>
        <div data-artifact-section="overview" hidden="@(activeTab != DetailsTab.Overview)">
            <section class="metric-grid artifact-overview-metrics">
                <MetricCard Label="@T("State")" Value="@T($"Status.{artifact.Status}")" Detail="@artifact.MediaType" HelpText="@T($"StatusHelp.{artifact.Status}")" Status="@Tone(artifact.Status)" />
                <MetricCard Label="@T("Size")" Value="@SizeInMegabytes(artifact.Length)" Detail="@ExactSize(artifact.Length)" />
                <MetricCard Label="@T("Expires")" Value="@artifact.ExpiresAt.ToLocalTime().ToString("g")" Detail="@T("LeaseCount", artifact.Leases.Count)" />
            </section>

            <FormSection Title="@Shared["Identity"]" Class="resource-identity-summary"><dl class="resource-details artifact-details-grid"><dt>@T("Artifact")</dt><dd>@artifact.FileName</dd><dt>@T("Identifier")</dt><dd><CopyableValue Value="@artifact.ArtifactId.ToString()" /></dd><dt>@T("Created")</dt><dd>@artifact.CreatedAt.ToLocalTime().ToString("g")</dd></dl></FormSection>

            <FormSection Title="@T("Producer")" Eyebrow="@T("Provenance")"><ChildContent>
                <dl class="resource-details artifact-details-grid">
                    <dt>@T("ProducerKind")</dt><dd>@artifact.Producer.Kind</dd>
                    <dt>@T("ProducerId")</dt><dd>@if (ProducerUrl(artifact.Producer) is { } producerUrl) { <a class="text-button" href="@producerUrl"><code>@artifact.Producer.Id</code></a> } else { <code>@artifact.Producer.Id</code> }</dd>
                    <dt>SHA-256</dt><dd><code>@(artifact.Sha256 ?? T("NotSealed"))</code></dd>
                    <dt>@T("FlowRun")</dt><dd>@if (artifact.Producer.FlowRunId is { } flowRunId) { <a class="text-button" href="@FlowRunUrl(flowRunId)" data-testid="artifact-producer-flow-run">@flowRunId</a> } else { <text>—</text> }</dd>
                    <dt>@T("FlowStep")</dt><dd>@(artifact.Producer.FlowStepId ?? "—")</dd>
                    <dt>@T("Agent")</dt><dd>@if (artifact.Producer.AgentId is { } agentId) { <a class="text-button" href="@AgentUrl(agentId)">@agentId</a> } else { <text>—</text> }</dd>
                    <dt>@T("ToolCall")</dt><dd>@if (ToolCallUrl(artifact.Producer) is { } toolCallUrl) { <a class="text-button" href="@toolCallUrl">@artifact.Producer.ToolCallId</a> } else { <text>@(artifact.Producer.ToolCallId ?? "—")</text> }</dd>
                    <dt>@T("Correlation")</dt><dd>@(artifact.Producer.CorrelationId ?? "—")</dd>
                    <dt>@T("StagingService")</dt><dd>@artifact.BindingNamespace/@artifact.BindingName · <a class="text-button" href="@ToolSetUrl(artifact)">@artifact.ToolSetNamespace/@artifact.ToolSetName:@artifact.ToolSetVersion</a></dd>
                </dl>
            </ChildContent></FormSection>

            @if (artifact.FailureCode is not null)
            {
                <section class="panel form-section"><h2>@T("Failure")</h2><p><code>@artifact.FailureCode</code> — @artifact.FailureMessage</p></section>
            }
        </div>
        <div data-artifact-section="content" hidden="@(activeTab != DetailsTab.Content)">
        @if (contentVisited)
        {
            <StagedArtifactContent @key="ArtifactId" ArtifactId="ArtifactId" Metadata="artifact" ContextScope="@ResourceOwnershipContext.TryGetCurrent(Services)" />
        }
        </div>
        <div data-artifact-section="retention" hidden="@(activeTab != DetailsTab.Retention)">
            <section class="panel form-section artifact-retention-panel">
                <div class="panel-header"><div><p class="eyebrow">@T("Retention")</p><h2>@T("RetentionAndLeases")</h2><p>@T("RetentionHelp")</p></div></div>
                <div class="artifact-retention-summary">
                    <div><span>@T("CurrentExpiration")</span><strong><time datetime="@artifact.ExpiresAt.ToString("O")">@artifact.ExpiresAt.ToLocalTime().ToString("g")</time></strong></div>
                    <div><span>@T("ConsumerLeases")</span><strong>@artifact.Leases.Count</strong></div>
                </div>
                <div class="artifact-retention-editor">
                    <FormField Label="@T("NewExpiration")"><ChildContent><ClearableText UpdateOnInput="false" Type="datetime-local" Value="@expiration" aria-describedby="retention-help" ValueChanged="changed => SetExpiration(new ChangeEventArgs { Value = changed })" /></ChildContent></FormField>
                    <button class="button-primary" type="button" disabled="@(busy || !CanExtendRetention)" @onclick="ExtendAsync">@T("ExtendRetention")</button>
                </div>
                <small id="retention-help" class="artifact-retention-help">@T(CanExtendRetention ? "RetentionReady" : "RetentionMustExtend")</small>
                @if (artifact.Leases.Count == 0)
                {
                    <p class="artifact-empty-leases">@T("NoLeases")</p>
                }
                else
                {
                    <CollectionView TItem="ArtifactLease" Items="artifact.Leases" InformationLabels="@(new string[] { T("Operations"), T("Expires") })" IdentityLabel="@T("Consumer")" StateLabel="@T("State")">
        <Identity Context="lease">
@lease.ConsumerKind · <code>@lease.ConsumerId</code></Identity>
        <State Context="lease">
<StatusBadge Text="@(lease.RevokedAt is null ? T("Active") : T("Revoked"))" Status="@(lease.RevokedAt is null ? UiStatus.Success : UiStatus.Neutral)" /></State>
        <Information Context="lease">
            <CollectionValue Label="@T("Operations")">@string.Join(", ", lease.Operations)</CollectionValue>
            <CollectionValue Label="@T("Expires")">@lease.ExpiresAt.ToLocalTime().ToString("g")</CollectionValue>
        </Information>
    </CollectionView>
                }
            </section>
        </div>
        </Content>
    </ResourceDetailsTemplate>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    private readonly CancellationTokenSource cancellation = new();
    private StagedArtifactView? artifact;
    private DetailsTab activeTab;
    private bool contentVisited;
    private string? loadedKey;
    private long loadVersion;
    private IReadOnlyList<ResourceNavigationItem> Sections => [new("overview", T("Tab.Overview"), "home"), new("content", T("Tab.Content"), "file"), new("retention", T("Tab.Retention"), "history")];
    private void SelectSection(string? value)
    {
        activeTab = value switch { "content" => DetailsTab.Content, "retention" => DetailsTab.Retention, _ => DetailsTab.Overview };
        if (activeTab == DetailsTab.Content) contentVisited = true;
    }
    private bool loading = true, busy, failed, confirmPurge;
    private string expiration = string.Empty;
    private string? error, message;
    private StagedArtifactId ArtifactId => StagedArtifactId.Parse(Id);
    private bool CanExtendRetention => artifact is not null && TryGetExpiration(out var value) && value > artifact.ExpiresAt;
    private bool PurgeEligible => artifact is not null
        && artifact.Status is not (StagedArtifactStatus.Open or StagedArtifactStatus.Persisting or StagedArtifactStatus.Purging or StagedArtifactStatus.Purged)
        && !artifact.Leases.Any(value => value.RevokedAt is null && value.ExpiresAt > TimeProvider.GetUtcNow());
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string SizeInMegabytes(long value) => T("SizeMegabytes", value / 1024d / 1024d);
    private string ExactSize(long value) => T("ExactBytes", value);
    private static string FlowRunUrl(string id) => $"/flow-runs/{Uri.EscapeDataString(id)}";
    private static string AgentUrl(string id) => $"/agents/{Uri.EscapeDataString(id)}";
    private static string? ProducerUrl(ArtifactProducer producer) => producer.FlowRunId is not null
        ? FlowRunUrl(producer.FlowRunId)
        : producer.RuntimeRunId is not null ? $"/runs/{Uri.EscapeDataString(producer.RuntimeRunId)}" : null;
    private static string? ToolCallUrl(ArtifactProducer producer) => producer.FlowRunId is not null && producer.ToolCallId is not null
        ? $"/tool-governance/flow/{Uri.EscapeDataString(producer.FlowRunId)}?toolCallId={Uri.EscapeDataString(producer.ToolCallId)}"
        : producer.RuntimeRunId is not null && producer.ToolCallId is not null
            ? $"/tool-governance/runtime/{Uri.EscapeDataString(producer.RuntimeRunId)}?toolCallId={Uri.EscapeDataString(producer.ToolCallId)}"
            : null;
    private static string ToolSetUrl(StagedArtifactView value) => value.ToolSetNamespace.IsDefault
        ? $"/tools/sets/{Uri.EscapeDataString(value.ToolSetName)}"
        : $"/tools/sets/{Uri.EscapeDataString(value.ToolSetName)}?namespace={Uri.EscapeDataString(value.ToolSetNamespace.Value)}";
    private static UiStatus Tone(StagedArtifactStatus status) => status switch
    {
        StagedArtifactStatus.Sealed or StagedArtifactStatus.Persisted => UiStatus.Success,
        StagedArtifactStatus.Failed or StagedArtifactStatus.Expired => UiStatus.Warning,
        StagedArtifactStatus.Purged or StagedArtifactStatus.Discarded => UiStatus.Neutral,
        _ => UiStatus.Info
    };

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Id}|{ResourceOwnershipContext.TryGetCurrent(Services)}";
        if (loadedKey == key) return;
        loadedKey = key; var request = ++loadVersion;
        loading = true; error = message = null; artifact = null; busy = confirmPurge = contentVisited = false; activeTab = DetailsTab.Overview;
        expiration = string.Empty;
        try
        {
            var saved = await Client.GetStagedAsync(ArtifactId, cancellation.Token);
            if (request != loadVersion) return;
            if (saved is null || saved.ArtifactId != ArtifactId) error = T("NotFound");
            else { artifact = saved; expiration = artifact.ExpiresAt.ToLocalTime().ToString("yyyy-MM-ddTHH:mm"); }
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception) { if (request == loadVersion) error = exception.Message; }
        finally { if (request == loadVersion) { loading = false; if (error is not null) loadedKey = null; } }
    }

    private void SetExpiration(ChangeEventArgs value) => expiration = value.Value?.ToString() ?? string.Empty;

    private bool TryGetExpiration(out DateTimeOffset value)
    {
        if (DateTime.TryParse(expiration, System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var parsed))
        {
            value = new DateTimeOffset(DateTime.SpecifyKind(parsed, DateTimeKind.Local));
            return true;
        }

        value = default;
        return false;
    }

    private async Task ExtendAsync()
    {
        if (busy || artifact is null || !TryGetExpiration(out var requestedExpiration) || requestedExpiration <= artifact.ExpiresAt) return;
        var request = loadVersion; var id = ArtifactId;
        busy = true;
        failed = false;
        message = null;
        try
        {
            var saved = await Client.ExtendRetentionAsync(id, requestedExpiration, cancellation.Token);
            if (request != loadVersion) return;
            if (saved.ArtifactId != id) throw new InvalidOperationException(T("NotFound"));
            artifact = saved;
            expiration = artifact.ExpiresAt.ToLocalTime().ToString("yyyy-MM-ddTHH:mm");
            message = T("RetentionExtended");
        }
        catch (Exception exception) { if (request == loadVersion) { failed = true; message = exception.Message; } }
        finally { if (request == loadVersion) busy = false; }
    }

    private async Task PurgeAsync()
    {
        if (busy || !PurgeEligible) return;
        var request = loadVersion; var id = ArtifactId;
        busy = true;
        failed = false;
        message = null;
        try
        {
            await Client.PurgeAsync(id, cancellation.Token);
            if (request == loadVersion) Navigation.NavigateTo(ResourceOwnershipContext.PreserveNavigation("/artifacts", Services));
        }
        catch (Exception exception) { if (request == loadVersion) { failed = true; message = exception.Message; busy = false; confirmPurge = false; } }
    }

    private enum DetailsTab { Overview, Content, Retention }

    public void Dispose()
    {
        cancellation.Cancel();
        cancellation.Dispose();
    }
}
