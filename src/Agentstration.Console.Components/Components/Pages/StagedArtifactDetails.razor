@page "/artifacts/staged/{Id}"
@implements IDisposable
@inject IArtifactsClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@inject IServiceProvider Services
@inject NavigationManager Navigation
@inject TimeProvider TimeProvider
@inject Microsoft.Extensions.Localization.IStringLocalizer<ArtifactsStrings> Localizer

<PageTitle>@(artifact?.FileName ?? Id) · Agentstration</PageTitle>
<ConfirmationDialog IsOpen="confirmPurge" Title="@T("DeleteTitle")" Message="@T("PurgeHelp")" ConfirmLabel="@T("ConfirmDelete")" CancelLabel="@T("Cancel")" TestId="staged-artifact-purge-confirmation" OnConfirm="PurgeAsync" OnCancel="() => confirmPurge = false" />

<UnsavedNavigationGuard IsDirty="@HasRetentionDraft" HasUnsavedChanges="@(() => HasRetentionDraft)" />
<ResourceDetailsTemplate Name="@(artifact?.FileName ?? Id)" ResourceType="@T("Staged")" Domain="artifact" IconName="file" CollectionHref="@ResourceOwnershipContext.PreserveNavigation("/artifacts", Services)" CollectionLabel="@T("Back")"
    Description="@T("DetailsDescription")" StatusText="@(artifact is null ? null : T($"Status.{artifact.Status}"))" Status="@(artifact is null ? UiStatus.Neutral : Tone(artifact.Status))"
    Sections="Sections" SelectionChanged="SelectSection" ResourceIdentity="@loadedKey" SectionState="sectionState" DefaultSection="overview" LoadState="loadState" OnRefresh="RefreshAsync" OnRetry="RefreshAsync"
    Busy="IsBusy" HasDraft="HasRetentionDraft" SectionTestIdPrefix="staged-artifact" TestId="staged-artifact-details">
        <Metadata>@if (artifact is not null) { <CopyableValue Value="@artifact.ArtifactId.ToString()" /> }</Metadata>
        <Actions><button class="button-danger" type="button" disabled="@(IsBusy || !CanDelete || !PurgeEligible)" title="@(!PurgeEligible ? T("PurgeIneligible") : null)" data-testid="staged-artifact-delete" @onclick="() => confirmPurge = true">@T("Delete")</button></Actions>
        <Feedback>@if (message is not null) { <div class="form-alert @(failed ? "form-alert-danger" : "form-alert-success")" role="status">@message</div> }@if (newerArtifact is not null) { <div class="form-alert form-alert-warning" role="status">@T("RetentionRefreshDraft")</div> }</Feedback>
        <Content>@if (artifact is not null) {
        <div data-artifact-section="overview" hidden="@(!sectionState.Is("overview"))">
            <section class="metric-grid artifact-overview-metrics">
                <MetricCard Label="@T("State")" Value="@T($"Status.{artifact.Status}")" Detail="@artifact.MediaType" HelpText="@T($"StatusHelp.{artifact.Status}")" Status="@Tone(artifact.Status)" />
                <MetricCard Label="@T("Size")" Value="@SizeInMegabytes(artifact.Length)" Detail="@ExactSize(artifact.Length)" />
                <MetricCard Label="@T("Expires")" Value="@artifact.ExpiresAt.ToLocalTime().ToString("g")" Detail="@T("LeaseCount", artifact.Leases.Count)" />
            </section>

            <StagedArtifactResourceSummary Resource="artifact" Metadata="savedMetadata" PresentationScopeRef="PresentationScope" />

            <FormSection Title="@T("Producer")" Eyebrow="@T("Provenance")"><ChildContent>
                <dl class="resource-details artifact-details-grid">
                    <dt>@T("ProducerKind")</dt><dd>@T($"ProducerKind.{artifact.Producer.Kind}")</dd>
                    <dt>@T("ProducerId")</dt><dd>@if (ProducerUrl(artifact.Producer) is { } producerUrl) { <a class="text-button" href="@NavigationUrl(producerUrl)"><code>@artifact.Producer.Id</code></a> } else { <code>@artifact.Producer.Id</code> }</dd>
                    <dt>SHA-256</dt><dd><code>@(artifact.Sha256 ?? T("NotSealed"))</code></dd>
                    <dt>@T("FlowRun")</dt><dd>@if (artifact.Producer.FlowRunId is { } flowRunId) { <a class="text-button" href="@NavigationUrl(FlowRunUrl(flowRunId))" data-testid="artifact-producer-flow-run">@flowRunId</a> } else { <text>—</text> }</dd>
                    <dt>@T("FlowStep")</dt><dd>@(artifact.Producer.FlowStepId ?? "—")</dd>
                    <dt>@T("Agent")</dt><dd>@if (artifact.Producer.AgentId is { } agentId) { <a class="text-button" href="@NavigationUrl(AgentUrl(agentId))">@agentId</a> } else { <text>—</text> }</dd>
                    <dt>@T("ToolCall")</dt><dd>@if (ToolCallUrl(artifact.Producer) is { } toolCallUrl) { <a class="text-button" href="@NavigationUrl(toolCallUrl)">@artifact.Producer.ToolCallId</a> } else { <text>@(artifact.Producer.ToolCallId ?? "—")</text> }</dd>
                    <dt>@T("Correlation")</dt><dd>@(artifact.Producer.CorrelationId ?? "—")</dd>
                    <dt>@T("StagingService")</dt><dd>@artifact.BindingNamespace/@artifact.BindingName · <a class="text-button" href="@NavigationUrl(ToolSetUrl(artifact))">@artifact.ToolSetNamespace/@artifact.ToolSetName:@artifact.ToolSetVersion</a></dd>
                </dl>
            </ChildContent></FormSection>

            @if (artifact.FailureCode is not null)
            {
                <section class="panel form-section"><h2>@T("Failure")</h2><p><code>@artifact.FailureCode</code> — @artifact.FailureMessage</p></section>
            }
        </div>
        <div data-artifact-section="content" hidden="@(!sectionState.Is("content"))">
        @if (sectionState.HasVisited("content"))
        {
            <StagedArtifactContent @key="ContentIdentity" ArtifactId="ArtifactId" Metadata="ContentMetadata" ContextScope="@ResourceOwnershipContext.TryGetCurrent(Services)" />
        }
        </div>
        <div data-artifact-section="retention" hidden="@(!sectionState.Is("retention"))">
            <section class="panel form-section artifact-retention-panel">
                <div class="panel-header"><div><p class="eyebrow">@T("Retention")</p><h2>@T("RetentionAndLeases")</h2><p>@T("RetentionHelp")</p></div></div>
                <div class="artifact-retention-summary">
                    <div><span>@T("CurrentExpiration")</span><strong><time datetime="@artifact.ExpiresAt.ToString("O")">@artifact.ExpiresAt.ToLocalTime().ToString("g")</time></strong></div>
                    <div><span>@T("ConsumerLeases")</span><strong>@artifact.Leases.Count</strong></div>
                </div>
                <div class="artifact-retention-editor">
                    <FormField Label="@T("NewExpiration")"><ChildContent><ClearableText UpdateOnInput="false" Type="datetime-local" Value="@expiration" Disabled="@(busy || !CanWrite)" aria-describedby="retention-help" ValueChanged="changed => SetExpiration(new ChangeEventArgs { Value = changed })" /></ChildContent></FormField>
                    <button class="button-primary" type="button" disabled="@(IsBusy || !CanWrite || !CanExtendRetention)" @onclick="ExtendAsync">@T("ExtendRetention")</button>
                </div>
                <small id="retention-help" class="artifact-retention-help">@T(CanExtendRetention ? "RetentionReady" : "RetentionMustExtend")</small>
                @if (artifact.Leases.Count == 0)
                {
                    <p class="artifact-empty-leases">@T("NoLeases")</p>
                }
                else
                {
                    <CollectionView TItem="ArtifactLease" Items="artifact.Leases" InformationLabels="@(new string[] { T("Operations"), T("Expires") })" IdentityLabel="@T("Consumer")" StateLabel="@T("State")">
        <Identity Context="lease">
@lease.ConsumerKind · <code>@lease.ConsumerId</code></Identity>
        <State Context="lease">
<StatusBadge Text="@(lease.RevokedAt is null ? T("Active") : T("Revoked"))" Status="@(lease.RevokedAt is null ? UiStatus.Success : UiStatus.Neutral)" /></State>
        <Information Context="lease">
            <CollectionValue Label="@T("Operations")">@string.Join(", ", lease.Operations)</CollectionValue>
            <CollectionValue Label="@T("Expires")">@lease.ExpiresAt.ToLocalTime().ToString("g")</CollectionValue>
        </Information>
    </CollectionView>
                }
            </section>
        </div>
        }</Content>
        <DraftActions><button type="button" class="button-secondary" disabled="@IsBusy" @onclick="DiscardRetention">@Shared["Discard"]</button></DraftActions>
</ResourceDetailsTemplate>

@code {
    [SupplyParameterFromQuery(Name = "scopeRef")] public string? RequestedOwner { get; set; }
    [SupplyParameterFromQuery(Name = "namespace")] public string? RequestedNamespace { get; set; }
    private ScopedResourceAddress? ExactAddress => RequestedOwner is null ? null : ScopedResourceAddress.Create(ResourceScopeRef.Parse(RequestedOwner), ResourceNamespace.Parse(RequestedNamespace), ArtifactResourceKinds.StagedArtifact, ArtifactId.ToString());
    private ResourceScopeRef? PresentationScope => ResourceOwnershipContext.TryGetCurrent(Services);
    [Parameter] public string Id { get; set; } = string.Empty;
    private readonly CancellationTokenSource cancellation = new();
    private StagedArtifactView? artifact;
    private StagedArtifactSavedSummary? savedMetadata;
    private readonly ResourceSectionState sectionState = new();
    private readonly CancellationToken lifetimeToken;
    public StagedArtifactDetails() => lifetimeToken = cancellation.Token;
    private StagedArtifactView? newerArtifact;
    private ResourceLoadState loadState = new(ResourceLoadStatus.Loading);
    private string? loadedKey;
    private long loadVersion;
    private bool busy, loading, failed, confirmPurge, disposed;
    private readonly StagedArtifactRetentionModel retention = new();
    private string expiration { get => retention.Expiration; set => retention.Expiration = value; }
    private string? message;
    private IReadOnlyList<ResourceNavigationItem> Sections => [new("overview", T("Tab.Overview"), "home"), new("content", T("Tab.Content"), "file"), new("retention", T("Tab.Retention"), "history")];
    private void SelectSection(string? path) { if (path is not null) sectionState.Select(path); }
    private bool IsBusy => busy || loading;
    private bool HasRetentionDraft => artifact is not null && retention.IsDirty;
    private bool HasPermission(string permission) => Services.GetService(typeof(ConsoleContextState)) is not ConsoleContextState context || context.Current is null || context.HasPermission(permission);
    private bool CanWrite => HasPermission(AuthorizationPermissions.ResourcesWrite) && HasPermission(AuthorizationPermissions.ArtifactsManageRetention);
    private bool CanDelete => HasPermission(AuthorizationPermissions.ResourcesDelete) && HasPermission(AuthorizationPermissions.ArtifactsPurge);
    private StagedArtifactId ArtifactId => StagedArtifactId.Parse(Id);
    private StagedArtifactView? ContentMetadata => newerArtifact ?? artifact;
    private string ContentIdentity => $"{ContentMetadata?.ArtifactId}|{ContentMetadata?.Status}|{ContentMetadata?.Sha256}|{ContentMetadata?.Length}";
    private bool CanExtendRetention => artifact is not null && retention.CanExtend(artifact.ExpiresAt);
    private bool PurgeEligible => StagedArtifactRetentionModel.CanPurge(artifact, TimeProvider.GetUtcNow());
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string SizeInMegabytes(long value) => T("SizeMegabytes", value / 1024d / 1024d);
    private string ExactSize(long value) => T("ExactBytes", value);
    private string NavigationUrl(string uri) => ResourceOwnershipContext.PreserveNavigation(uri, Services);
    private static string FlowRunUrl(string id) => $"/flow-runs/{Uri.EscapeDataString(id)}";
    private static string AgentUrl(string id) => $"/agents/{Uri.EscapeDataString(id)}";
    private static string? ProducerUrl(ArtifactProducer producer) => producer.FlowRunId is not null
        ? FlowRunUrl(producer.FlowRunId)
        : producer.RuntimeRunId is not null ? $"/runs/{Uri.EscapeDataString(producer.RuntimeRunId)}" : null;
    private static string? ToolCallUrl(ArtifactProducer producer) => producer.FlowRunId is not null && producer.ToolCallId is not null
        ? $"/tool-governance/flow/{Uri.EscapeDataString(producer.FlowRunId)}?toolCallId={Uri.EscapeDataString(producer.ToolCallId)}"
        : producer.RuntimeRunId is not null && producer.ToolCallId is not null
            ? $"/tool-governance/runtime/{Uri.EscapeDataString(producer.RuntimeRunId)}?toolCallId={Uri.EscapeDataString(producer.ToolCallId)}"
            : null;
    private static string ToolSetUrl(StagedArtifactView value) => value.ToolSetNamespace.IsDefault
        ? $"/tools/sets/{Uri.EscapeDataString(value.ToolSetName)}"
        : $"/tools/sets/{Uri.EscapeDataString(value.ToolSetName)}?namespace={Uri.EscapeDataString(value.ToolSetNamespace.Value)}";
    private static UiStatus Tone(StagedArtifactStatus status) => status switch
    {
        StagedArtifactStatus.Sealed or StagedArtifactStatus.Persisted => UiStatus.Success,
        StagedArtifactStatus.Failed or StagedArtifactStatus.Expired => UiStatus.Warning,
        StagedArtifactStatus.Purged or StagedArtifactStatus.Discarded => UiStatus.Neutral,
        _ => UiStatus.Info
    };

    protected override Task OnParametersSetAsync()
    {
        var key = $"{Id}|{RequestedOwner}|{RequestedNamespace}|{ResourceOwnershipContext.TryGetCurrent(Services)}";
        if (loadedKey == key) return Task.CompletedTask;
        loadedKey = key; ClearPrivate(); sectionState.Reset(key);
        return LoadAsync();
    }
    private void ClearPrivate()
    {
        artifact = newerArtifact = null; savedMetadata = null; retention.Clear(); message = null; busy = confirmPurge = failed = false;
    }
    private Task RefreshAsync() => IsBusy ? Task.CompletedTask : LoadAsync();
    private async Task LoadAsync()
    {
        var request = ++loadVersion; var previous = artifact; loading = true;
        loadState = new(previous is null ? ResourceLoadStatus.Loading : ResourceLoadStatus.Refreshing) { HasContent = previous is not null };
        try
        {
            var id = ArtifactId;
            var summary = ExactAddress is { } exact ? await Client.GetStagedAtAddressAsync(exact, lifetimeToken) : null;
            var saved = summary?.Value ?? await Client.GetStagedAsync(id, lifetimeToken);
            if (request != loadVersion || disposed) return;
            if (saved is null || saved.ArtifactId != id || ExactAddress is { } requested && (summary is null || summary.ScopeRef != requested.ScopeRef || summary.Metadata.Namespace != requested.Namespace || summary.Metadata.Name != requested.Name))
            { ClearPrivate(); loadState = new(ResourceLoadStatus.NotFound); return; }
            if (HasRetentionDraft)
            {
                if (JsonSerializer.Serialize(saved) != JsonSerializer.Serialize(artifact)) newerArtifact = saved;
            }
            else { savedMetadata = summary; Adopt(saved); }
            loadState = new(ResourceLoadStatus.Ready) { HasContent = true };
        }
        catch (OperationCanceledException) when (lifetimeToken.IsCancellationRequested) { }
        catch (Exception exception)
        {
            if (request != loadVersion || disposed) return;
            var status = exception is AgentstrationApiException api ? api.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden => ResourceLoadStatus.Forbidden,
                System.Net.HttpStatusCode.NotFound => ResourceLoadStatus.NotFound,
                _ => ResourceLoadStatus.Failed
            } : ResourceLoadStatus.Failed;
            if (status is ResourceLoadStatus.Forbidden or ResourceLoadStatus.NotFound) ClearPrivate();
            loadState = new(status) { HasContent = artifact is not null, ErrorId = (exception as AgentstrationApiException)?.ErrorId };
        }
        finally { if (request == loadVersion && !disposed) loading = false; }
    }
    private void Adopt(StagedArtifactView saved)
    {
        artifact = saved; newerArtifact = null;
        retention.Reset(saved.ExpiresAt);
    }
    private void DiscardRetention()
    {
        if (IsBusy || artifact is null) return;
        Adopt(newerArtifact ?? artifact); message = null;
    }
    private void SetExpiration(ChangeEventArgs value) { if (!busy && CanWrite) expiration = value.Value?.ToString() ?? string.Empty; }

    private bool TryGetExpiration(out DateTimeOffset value) => retention.TryGetExpiration(out value);

    private async Task ExtendAsync()
    {
        if (IsBusy || !CanWrite || artifact is null || !TryGetExpiration(out var requestedExpiration) || requestedExpiration <= artifact.ExpiresAt) return;
        var request = loadVersion; var id = ArtifactId;
        busy = true;
        failed = false;
        message = null;
        try
        {
            var saved = await Client.ExtendRetentionAsync(id, requestedExpiration, lifetimeToken);
            if (request != loadVersion || disposed) return;
            if (saved.ArtifactId != id) { ClearPrivate(); loadState = new(ResourceLoadStatus.NotFound); return; }
            Adopt(saved);
            message = T("RetentionExtended");
        }
        catch (Exception exception) { if (request == loadVersion && !disposed) { failed = true; message = exception.Message; } }
        finally { if (request == loadVersion && !disposed) busy = false; }
    }

    private async Task PurgeAsync()
    {
        if (IsBusy || !CanDelete || !PurgeEligible) return;
        var request = loadVersion; var id = ArtifactId;
        busy = true;
        failed = false;
        message = null;
        try
        {
            await Client.PurgeAsync(id, lifetimeToken);
            if (request == loadVersion && !disposed) { ClearPrivate(); loadState = new(ResourceLoadStatus.NotFound); Navigation.NavigateTo(ResourceOwnershipContext.PreserveNavigation("/artifacts", Services)); }
        }
        catch (Exception exception) { if (request == loadVersion && !disposed) { failed = true; message = exception.Message; busy = false; confirmPurge = false; } }
    }

    public void Dispose()
    {
        if (disposed) return;
        disposed = true; ++loadVersion;
        cancellation.Cancel();
        cancellation.Dispose();
    }
}
