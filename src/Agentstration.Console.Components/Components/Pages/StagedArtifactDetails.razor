@page "/artifacts/staged/{Id}"
@implements IDisposable
@inject IArtifactsClient Client
@inject NavigationManager Navigation
@inject TimeProvider TimeProvider
@inject Microsoft.Extensions.Localization.IStringLocalizer<ArtifactsStrings> Localizer

<PageTitle>@(artifact?.FileName ?? Id) · Agentstration</PageTitle>
<PageHeader Title="@(artifact?.FileName ?? Id)" Description="@T("DetailsDescription")" TestId="staged-artifact-details"><Actions><a class="button-secondary" href="/artifacts">@T("Back")</a></Actions></PageHeader>
@if (loading) { <LoadingState Message="@T("Loading")" /> }
else if (error is not null) { <ErrorState Message="@error" /> }
else if (artifact is not null)
{
    @if (message is not null) { <div class="form-alert @(failed ? "form-alert-danger" : "form-alert-success")" role="status">@message</div> }
    <section class="metric-grid"><MetricCard Label="@T("State")" Value="@T($"Status.{artifact.Status}")" Detail="@artifact.MediaType" Status="@(artifact.Status == StagedArtifactStatus.Failed ? UiStatus.Warning : UiStatus.Info)" /><MetricCard Label="@T("Size")" Value="@artifact.Length.ToString()" Detail="@(artifact.Sha256 ?? T("NotSealed"))" /><MetricCard Label="@T("Expires")" Value="@artifact.ExpiresAt.ToLocalTime().ToString("g")" Detail="@T("LeaseCount", artifact.Leases.Count)" /></section>
    <section class="panel form-section"><div class="panel-header"><div><p class="eyebrow">@T("Provenance")</p><h2>@T("Producer")</h2></div></div><dl class="resource-details"><dt>@T("ProducerKind")</dt><dd>@artifact.Producer.Kind</dd><dt>@T("ProducerId")</dt><dd><code>@artifact.Producer.Id</code></dd><dt>@T("FlowRun")</dt><dd>@(artifact.Producer.FlowRunId ?? "—")</dd><dt>@T("FlowStep")</dt><dd>@(artifact.Producer.FlowStepId ?? "—")</dd><dt>@T("Agent")</dt><dd>@(artifact.Producer.AgentId ?? "—")</dd><dt>@T("ToolCall")</dt><dd>@(artifact.Producer.ToolCallId ?? "—")</dd><dt>@T("Correlation")</dt><dd>@(artifact.Producer.CorrelationId ?? "—")</dd><dt>@T("StagingService")</dt><dd>@artifact.BindingNamespace/@artifact.BindingName · @artifact.ToolSetNamespace/@artifact.ToolSetName:@artifact.ToolSetVersion</dd></dl></section>
    <section class="panel form-section"><div class="panel-header"><div><p class="eyebrow">@T("Retention")</p><h2>@T("RetentionAndLeases")</h2><p>@T("RetentionHelp")</p></div></div><label><span>@T("NewExpiration")</span><input type="datetime-local" value="@expiration" @onchange="SetExpiration" /></label><div class="form-actions"><button class="button-primary" type="button" disabled="@busy" @onclick="ExtendAsync">@T("ExtendRetention")</button></div>@if (artifact.Leases.Count == 0) { <p class="muted">@T("NoLeases")</p> } else { <DataGrid TItem="ArtifactLease" Items="artifact.Leases"><Header><tr><th>@T("Consumer")</th><th>@T("Operations")</th><th>@T("Expires")</th><th>@T("State")</th></tr></Header><Row Context="lease"><tr><td>@lease.ConsumerKind · <code>@lease.ConsumerId</code></td><td>@string.Join(", ", lease.Operations)</td><td>@lease.ExpiresAt.ToLocalTime().ToString("g")</td><td>@(lease.RevokedAt is null ? T("Active") : T("Revoked"))</td></tr></Row></DataGrid> }</section>
    <section class="panel form-section"><div class="panel-header"><div><p class="eyebrow">@T("ProtectedContent")</p><h2>@T("ContentPreview")</h2><p>@T("ContentHelp")</p></div></div>@if (content is null) { <button class="button-secondary" type="button" disabled="@busy" @onclick="ReadContentAsync">@T("ReadContent")</button> } else { <pre class="code-block">@content</pre> }</section>
    @if (artifact.FailureCode is not null) { <section class="panel form-section"><h2>@T("Failure")</h2><p><code>@artifact.FailureCode</code> — @artifact.FailureMessage</p></section> }
    <section class="panel danger-zone"><div><h2>@T("Purge")</h2><p>@T(PurgeEligible ? "PurgeHelp" : "PurgeIneligible")</p></div>@if (!confirmPurge) { <button class="button-danger" type="button" disabled="@(!PurgeEligible)" @onclick="() => confirmPurge = true">@T("Purge")</button> } else { <div class="form-actions"><button class="button-secondary" type="button" @onclick="() => confirmPurge = false">@T("Cancel")</button><button class="button-danger" type="button" disabled="@busy" @onclick="PurgeAsync">@T("ConfirmPurge")</button></div> }</section>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    private readonly CancellationTokenSource cancellation = new();
    private StagedArtifactView? artifact;
    private bool loading = true, busy, failed, confirmPurge;
    private string expiration = string.Empty;
    private string? error, message, content;
    private StagedArtifactId ArtifactId => StagedArtifactId.Parse(Id);
    private bool PurgeEligible => artifact is not null
        && artifact.Status is not (StagedArtifactStatus.Open or StagedArtifactStatus.Persisting or StagedArtifactStatus.Purging or StagedArtifactStatus.Purged)
        && !artifact.Leases.Any(value => value.RevokedAt is null && value.ExpiresAt > TimeProvider.GetUtcNow());
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    protected override async Task OnParametersSetAsync() { loading = true; error = null; try { artifact = await Client.GetStagedAsync(ArtifactId, cancellation.Token); if (artifact is null) error = T("NotFound"); else expiration = artifact.ExpiresAt.ToLocalTime().ToString("yyyy-MM-ddTHH:mm"); } catch (Exception exception) { error = exception.Message; } finally { loading = false; } }
    private void SetExpiration(ChangeEventArgs value) => expiration = value.Value?.ToString() ?? string.Empty;
    private async Task ExtendAsync() { if (busy || artifact is null) return; busy = true; failed = false; message = null; try { var parsed = DateTime.SpecifyKind(DateTime.Parse(expiration, System.Globalization.CultureInfo.InvariantCulture), DateTimeKind.Local); artifact = await Client.ExtendRetentionAsync(ArtifactId, new DateTimeOffset(parsed), cancellation.Token); message = T("RetentionExtended"); } catch (Exception exception) { failed = true; message = exception.Message; } finally { busy = false; } }
    private async Task ReadContentAsync() { if (busy || artifact is null) return; busy = true; failed = false; message = null; try { var chunk = await Client.ReadContentAsync(ArtifactId, 0, 8192, cancellation.Token); var bytes = Convert.FromBase64String(chunk.ContentBase64); content = IsTextMediaType(artifact.MediaType) ? System.Text.Encoding.UTF8.GetString(bytes) : $"{T("BinaryPreview", bytes.Length)}\n{chunk.ContentBase64}"; if (!chunk.EndOfContent) content += $"\n{T("PreviewTruncated")}"; } catch (Exception exception) { failed = true; message = exception.Message; } finally { busy = false; } }
    private async Task PurgeAsync() { if (busy) return; busy = true; failed = false; message = null; try { await Client.PurgeAsync(ArtifactId, cancellation.Token); Navigation.NavigateTo("/artifacts"); } catch (Exception exception) { failed = true; message = exception.Message; busy = false; } }
    private static bool IsTextMediaType(string mediaType) => mediaType.StartsWith("text/", StringComparison.OrdinalIgnoreCase)
        || mediaType.Contains("json", StringComparison.OrdinalIgnoreCase)
        || mediaType.Contains("xml", StringComparison.OrdinalIgnoreCase)
        || mediaType.Contains("yaml", StringComparison.OrdinalIgnoreCase)
        || mediaType.Contains("javascript", StringComparison.OrdinalIgnoreCase);
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
