@page "/agent-instances"
@page "/deployments"
@implements IDisposable
@inject IRuntimeApiClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<DeploymentStrings> Localizer

<PageTitle>@T("AgentInstances") · Agentstration</PageTitle>
<PageHeader Title="@T("AgentInstances")" Description="@T("AgentInstances.Description")" TestId="runtime-agent-instances" />
@if (items is null)
{
    <LoadingState Message="@T("LoadingInstances")" />
}
else if (items.Count == 0)
{
    <section data-testid="runtime-agent-instances-empty">
        <EmptyState Title="@T("NoInstances")" Message="@T("NoInstancesMessage")" />
    </section>
}
else
{
    <section data-testid="runtime-agent-instances-list">
    <CollectionView TItem="AgentInstanceResponse" Items="items" InformationLabels="@(new string[] { T("Run"), T("Execution"), T("Worker"), T("RuntimeProfile"), T("Started"), T("LastActivity"), T("Lease") })" RowTestId="runtime-agent-instance-row" ItemAttributes="@((item) => new Dictionary<string, object> { ["id"] = InstanceAnchor(item), ["data-instance-id"] = item.InstanceId, ["data-agent-name"] = item.AgentName, ["data-agent-generation"] = item.AgentGeneration, ["data-revision-id"] = item.RevisionId, ["data-run-kind"] = item.RunKind, ["data-run-id"] = item.RunId, ["data-worker-id"] = item.WorkerId.ToString("D") })" IdentityLabel="@T("Agent")">
        <Identity Context="item">
<a class="resource-name-link" href="@AgentUrl(item)">@item.AgentName</a><br /><small><code>@item.AgentNamespace.Value</code> · @T("Generation", item.AgentGeneration)</small></Identity>
        <Information Context="item">
            <CollectionValue Label="@T("Run")"><a class="text-button" href="@RunUrl(item)">@item.RunId</a><br /><small>@T($"RunKind.{item.RunKind}")</small></CollectionValue>
            <CollectionValue Label="@T("Execution")">@(item.ParticipantId ?? "—")<br /><small>@T("Turns", item.TurnCount)</small></CollectionValue>
            <CollectionValue Label="@T("Worker")"><a class="text-button" href="@WorkerUrl(item)">@Short(item.WorkerId)</a><br /><small>@Short(item.WorkerSessionId)</small></CollectionValue>
            <CollectionValue Label="@T("RuntimeProfile")">@item.RuntimeProfile<br /><small><code>@item.RevisionId</code></small></CollectionValue>
            <CollectionValue Label="@T("Started")">@item.StartedAt.LocalDateTime.ToString("g")</CollectionValue>
            <CollectionValue Label="@T("LastActivity")">@item.LastActivityAt.LocalDateTime.ToString("g")</CollectionValue>
            <CollectionValue Label="@T("Lease")">@item.LeaseExpiresAt.LocalDateTime.ToString("T")</CollectionValue>
        </Information>
    </CollectionView>
    </section>
}

@code {
    private readonly CancellationTokenSource cancellation = new();
    private IReadOnlyList<AgentInstanceResponse>? items;
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    protected override async Task OnInitializedAsync() => items = await Client.GetAgentInstancesAsync(cancellation.Token);
    private static string InstanceAnchor(AgentInstanceResponse item) => $"agent-instance-{Uri.EscapeDataString(item.InstanceId)}";
    private static string WorkerUrl(AgentInstanceResponse item) => $"/settings/runtime-workers/{item.WorkerId:D}";
    private static string RunUrl(AgentInstanceResponse item) => item.RunKind == nameof(RuntimeAssignmentTargetKind.FlowRun)
        ? $"/flow-runs/{Uri.EscapeDataString(item.RunId)}"
        : $"/runs/{Uri.EscapeDataString(item.RunId)}";
    private static string AgentUrl(AgentInstanceResponse item) => item.AgentNamespace.IsDefault
        ? $"/agents/{Uri.EscapeDataString(item.AgentName)}"
        : $"/namespaces/{Uri.EscapeDataString(item.AgentNamespace.Value)}/agents/{Uri.EscapeDataString(item.AgentName)}";
    private static string Short(Guid value) => value.ToString("N")[..8];
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
