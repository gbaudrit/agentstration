@page "/agent-instances"
@page "/deployments"
@implements IDisposable
@inject IServiceProvider Services
@inject IRuntimeApiClient Client
@inject ConsoleContextState Context
@inject Microsoft.Extensions.Localization.IStringLocalizer<DeploymentStrings> Localizer

<PageTitle>@T("AgentInstances") · Agentstration</PageTitle>
<div data-testid="@SurfaceTestId">
<ResourceCollectionTemplate TItem="AgentInstanceResponse" Title="@T("AgentInstances")" Description="@T("AgentInstances.Description")" TestId="runtime-agent-instances"
                            IdentityColumn="IdentityColumn" Columns="Columns" Items="@(items ?? [])" ContextKey="@contextKey" RowTestId="runtime-agent-instance-row" ItemAttributes="InstanceAttributes"
                            LoadState="loadState" Disabled="@(!interactive)"
                            EmptyTitle="@T("SnapshotEmptyTitle")" EmptyMessage="@T("NoInstancesMessage")" OnRefresh="LoadAsync" OnRetry="RetryAsync">
    <Feedback><p class="help-text">@T("SnapshotHelp")</p></Feedback>
</ResourceCollectionTemplate>
</div>

@code {
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    private string? SurfaceTestId => loadState.BlocksContent || items is null ? null : items.Count == 0 ? "runtime-agent-instances-empty" : "runtime-agent-instances-list";
    private CollectionColumn<AgentInstanceResponse> IdentityColumn => new("identity", T("AgentInstance"), item => @<CollectionIdentity DisplayName="@item.AgentName" Name="@item.InstanceId" Href="@RunUrl(item)" IconName="agent">
        <IconBadges><ResourceScopeBadge ScopeRef="item.ExecutionScopeRef" IconOnly /></IconBadges>
    </CollectionIdentity>);
    private IReadOnlyList<CollectionColumn<AgentInstanceResponse>> Columns =>
    [
        new("agent", T("Agent"), item => @<text>
            <a href="@AgentUrl(item)">@item.AgentNamespace.Value/@item.AgentName</a><br /><small>@T("Generation", item.AgentGeneration)</small>
            <div><small>@T("RuntimeProfile"): @item.RuntimeProfile</small><br /><code>@item.RevisionId</code></div>
        </text>),
        new("run", T("Run"), item => @<text>
            <a class="text-button instance-run-link" href="@RunUrl(item)">@item.RunId</a><br /><small>@RunKindText(item.RunKind)</small>
            <div><small>@T("Execution"): @(item.ParticipantId ?? "—")</small><br /><small>@T("Turns", item.TurnCount)</small></div>
        </text>),
        new("worker", T("Worker"), item => @<text>
            <a class="text-button" href="@WorkerUrl(item)" title="@item.WorkerId.ToString("D")">@Short(item.WorkerId)</a><br />
            <small title="@item.WorkerSessionId.ToString("D")">@T("Session"): @Short(item.WorkerSessionId)</small>
        </text>),
        new("timing", T("ExecutionTiming"), item => @<text>
            <div><small>@T("Started"):</small> <time datetime="@item.StartedAt.ToString("O")">@item.StartedAt.LocalDateTime.ToString("g")</time></div>
            <div><small>@T("LastActivity"):</small> <time datetime="@item.LastActivityAt.ToString("O")">@item.LastActivityAt.LocalDateTime.ToString("g")</time></div>
            <div><small>@T("Lease"):</small> <time datetime="@item.LeaseExpiresAt.ToString("O")">@item.LeaseExpiresAt.LocalDateTime.ToString("T")</time></div>
        </text>)
    ];
    private string RunKindText(string kind) => T($"RunKind.{(kind is "RuntimeRun" or "FlowRun" ? kind : "Unknown")}");
    private string WorkerUrl(AgentInstanceResponse item) => ResourceOwnershipContext.PreserveNavigation($"/settings/runtime-workers/{item.WorkerId:D}", Services);
    private string RunUrl(AgentInstanceResponse item)
    {
        var path = item.RunKind == nameof(RuntimeAssignmentTargetKind.FlowRun) ? $"/flow-runs/{Uri.EscapeDataString(item.RunId)}" : $"/runs/{Uri.EscapeDataString(item.RunId)}";
        return ResourceOwnershipContext.PreserveNavigation(item.ExecutionScopeRef is { } scope ? $"{path}?scopeRef={Uri.EscapeDataString(scope.Value)}" : path, Services);
    }
    private string AgentUrl(AgentInstanceResponse item) => ResourceOwnershipContext.PreserveNavigation(item.AgentNamespace.IsDefault
        ? $"/agents/{Uri.EscapeDataString(item.AgentName)}" : $"/namespaces/{Uri.EscapeDataString(item.AgentNamespace.Value)}/agents/{Uri.EscapeDataString(item.AgentName)}", Services);
    private static string Short(Guid value) => value.ToString("N")[..8];
    private static IReadOnlyDictionary<string, object> InstanceAttributes(AgentInstanceResponse item) => new Dictionary<string, object>
    {
        ["id"] = $"agent-instance-{Uri.EscapeDataString(item.InstanceId)}", ["data-instance-id"] = item.InstanceId, ["data-agent-name"] = item.AgentName,
        ["data-agent-generation"] = item.AgentGeneration, ["data-revision-id"] = item.RevisionId, ["data-run-kind"] = item.RunKind,
        ["data-run-id"] = item.RunId, ["data-worker-id"] = item.WorkerId.ToString("D")
    };
}
