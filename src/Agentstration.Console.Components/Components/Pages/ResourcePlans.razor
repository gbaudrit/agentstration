@page "/resource-plans"
@rendermode InteractiveServer
@implements IDisposable
@inject IResourcePlansApiClient Client
@inject IServiceProvider Services
@inject ConsoleContextState Context
@inject Microsoft.Extensions.Localization.IStringLocalizer<ResourcePlansStrings> Localizer

<PageTitle>@T("Title") · Agentstration</PageTitle>
<ResourceCollectionTemplate TItem="ResourcePlanSnapshot" Title="@T("Title")" Description="@($"{T("ListDescription")} {T("CurrentWorkspace", Context.Current?.WorkspaceDisplayName ?? "—")}")" TestId="resource-plans"
                            IdentityColumn="IdentityColumn" Columns="Columns" Items="@(items ?? [])" ContextKey="@contextKey"
                            Query="query" QueryChanged="ChangeQueryAsync" Pagination="pagination" LoadState="loadState" Disabled="@(!interactive)"
                            EmptyTitle="@T("EmptyTitle")" EmptyMessage="@T("EmptyDescription")" OnRefresh="ReloadAsync" OnRetry="RetryAsync" />

@code {
    private string T(string key, params object[] args) => Localizer[key, args].Value;
    private CollectionColumn<ResourcePlanSnapshot> IdentityColumn => new("identity", T("Plan"), item => @<text>
        <CollectionIdentity DisplayName="@item.Value.Title" Name="@item.Value.Id.ToString()" Href="@PlanUrl(item)" IconName="clipboard-list">
            <IconBadges><ResourceScopeBadge ScopeRef="@ResourceScopeRef.Workspace(item.Value.Scope.WorkspaceId.Value)" IconOnly /><StatusBadge Text="@StatusText(item.Value.Status)" Status="@Tone(item.Value.Status)" IconOnly /></IconBadges>
            <Versions><CollectionVersion Label="@T("RevisionLabel")" Value="@item.Value.Revision.ToString(System.Globalization.CultureInfo.InvariantCulture)" /></Versions>
        </CollectionIdentity><small class="resource-secondary resource-plan-goal">@item.Value.Goal</small>
    </text>)
    {
        Filters = [new("status", T("Status"), CollectionFilterKind.Choice)
        {
            Options = Enum.GetValues<ResourcePlanStatus>().Select(value => new CollectionFilterOption(value.ToString(), T($"Status.{value}"))).ToArray()
        }]
    };
    private IReadOnlyList<CollectionColumn<ResourcePlanSnapshot>> Columns =>
    [
        new("changes", T("Changes"), item => @<text>@{ var summary = summaries.GetValueOrDefault(item.Value.Id.Value); }<strong>@(summary?.Changes?.ToString() ?? "—")</strong>@if (summary?.Stale == true) { <StatusBadge Text="@T("Stale")" Status="UiStatus.Warning" /> }</text>),
        new("validation", T("Validation"), item => @<text>@if (summaries.TryGetValue(item.Value.Id.Value, out var summary)) { <StatusBadge Text="@(summary.Readiness is null ? T("NotValidated") : T($"Readiness.{summary.Readiness}"))" Status="@ReadinessTone(summary.Readiness)" /> } else { <span>—</span> }</text>),
        new("updated", T("Updated"), item => @<time datetime="@item.Value.UpdatedAt.ToString("O")">@item.Value.UpdatedAt.ToLocalTime().ToString("g")</time>)
    ];
    private string StatusText(ResourcePlanStatus status) => T($"Status.{(Enum.IsDefined(status) ? status.ToString() : "Unknown")}");
    private string PlanUrl(ResourcePlanSnapshot item) => ResourceOwnershipContext.PreserveNavigation($"/resource-plans/{item.Value.Id.Value:D}", Services);
    private static UiStatus Tone(ResourcePlanStatus status) => status switch
    {
        ResourcePlanStatus.Validated or ResourcePlanStatus.Applied => UiStatus.Success,
        ResourcePlanStatus.Failed or ResourcePlanStatus.Cancelled => UiStatus.Danger,
        ResourcePlanStatus.Ready or ResourcePlanStatus.Materialized => UiStatus.Info,
        _ => UiStatus.Neutral
    };

    private static UiStatus ReadinessTone(ResourceChangeSetReadiness? readiness) => readiness switch
    {
        ResourceChangeSetReadiness.Ready => UiStatus.Success,
        ResourceChangeSetReadiness.Blocked => UiStatus.Danger,
        _ => UiStatus.Neutral
    };

}
