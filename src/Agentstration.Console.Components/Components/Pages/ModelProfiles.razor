@page "/modelprofiles"
@implements IDisposable
@inject IServiceProvider Services
@inject IModelProfilesClient Client
@inject ConsoleContextState Context
@inject NotificationState Notifications
@inject Microsoft.Extensions.Localization.IStringLocalizer<ModelProfilesStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared

<PageTitle>@T("Title") · Agentstration</PageTitle>
<ResourceCollectionTemplate TItem="ModelProfileSummaryResponse" Title="@T("Title")" Description="@T("Description")" TestId="resource-model-profiles"
                            IdentityColumn="IdentityColumn" Columns="Columns" AdditionalFilters="ExtraFilters" Items="PageItems" ContextKey="@contextKey" ItemActions="RowActions"
                            Query="query" QueryChanged="ChangeQueryAsync" Pagination="Pagination" LoadState="loadState" Disabled="@(!interactive || operationBusy)"
                            SearchEnabled SearchLabel="@Shared["Search"]" SearchPlaceholder="@Shared["Search"]"
                            EmptyTitle="@T("EmptyTitle")" EmptyMessage="@T("EmptyMessage")" PrimaryActions="CreateAction" EmptyActions="CreateAction"
                            OnRefresh="RefreshAsync" OnRetry="RetryAsync" Feedback="OperationFeedback" />

<ConfirmationDialog IsOpen="@(pendingDelete is not null)" Title="@T("DeleteDialogTitle")" Message="@DeleteMessage" ConfirmLabel="@T("DeleteDialogConfirm")" OnConfirm="DeleteAsync" OnCancel="CancelDelete" />

@code {
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    private string DeleteMessage => pendingDelete is null ? string.Empty : T("DeleteMessage", pendingDelete.Name);
    private string AgentCount(int count) => T(count == 1 ? "AgentCount.One" : "AgentCount.Many", count);
    private RenderFragment? OperationFeedback => operationFailed || deleteConflictUsages.Count > 0 ? @<text>
        @if (operationFailed) { <ErrorState Title="@T("OperationFailedTitle")" Message="@T("OperationFailedMessage")" ErrorId="@operationErrorId" /> }
        @if (deleteConflictUsages.Count > 0)
        {
            <section class="panel resource-section"><div class="panel-header"><h2>@T("DeleteConflictTitle")</h2></div><p>@T("DeleteConflictMessage", AgentCount(deleteConflictUsages.Count))</p><ul>@foreach (var usage in deleteConflictUsages) { <li><CollectionIdentity DisplayName="@usage.DisplayName" Namespace="@usage.Namespace" Name="@usage.Name" Href="@AgentUrl(usage)" IconName="agent" Domain="agent"><IconBadges><ResourceScopeBadge ScopeRef="usage.ScopeRef" DisplayName="@usage.ScopeDisplayName" IconOnly /><ManagedResourceBadge IsManaged="@usage.IsManaged" IconOnly /></IconBadges></CollectionIdentity></li> }</ul></section>
        }
    </text> : null;
    private RenderFragment? CreateAction => Context.HasPermission(AuthorizationPermissions.ResourcesWrite)
        ? @<PermissionGate Permission="@AuthorizationPermissions.ResourcesWrite"><a class="button-primary" href="@Navigate("/modelprofiles/new")">@T("CreateModelProfile")</a></PermissionGate> : null;
    private CollectionColumn<ModelProfileSummaryResponse> IdentityColumn => new("identity", T("Profile"), profile => @<CollectionIdentity DisplayName="@profile.Properties.DisplayName" Namespace="@profile.Namespace" Name="@profile.Name" Href="@DetailsUrl(profile)" IconName="layers" Domain="model">
        <IconBadges><ResourceScopeBadge ShowName ScopeRef="@profile.ScopeRef" Kind="ResourceScopeKind.Workspace" IconOnly /><StatusBadge Text="@StatusLabel(profile.Properties.Status)" Status="@StatusTone(profile.Properties.Status)" IconOnly /><ManagedResourceBadge IsManaged="@profile.IsManaged" IsReadOnly="@(!ResourceOwnershipContext.CanManage(profile.ScopeRef, Services))" IconOnly /></IconBadges>
    </CollectionIdentity>)
    {
        Filters = [new("status", T("Status"), CollectionFilterKind.Choice)
        {
            Options = new[] { "Available", "Unavailable", "Incompatible", "Ready", "ProviderUnavailable", "ModelUnavailable", "InvalidConfiguration", "Unknown" }.Select(value => new CollectionFilterOption(value, StatusLabel(value))).ToArray()
        }]
    };
    private IReadOnlyList<CollectionColumn<ModelProfileSummaryResponse>> Columns =>
    [
        new("provider", T("Provider"), profile => @<span>@(profile.Properties.Provider.DisplayName ?? profile.Properties.Provider.Name)</span>)
        {
            Filters = [new("provider", T("Provider"), CollectionFilterKind.Choice)
            {
                Options = (items ?? []).Select(profile => profile.Properties.Provider).GroupBy(provider => provider.Name, StringComparer.Ordinal).OrderBy(group => group.Key, StringComparer.Ordinal).Select(group => new CollectionFilterOption(group.Key, group.First().DisplayName ?? group.Key)).ToArray()
            }]
        },
        new("model", T("Model"), profile => @<code>@profile.Properties.Model.Name</code>)
        {
            Filters = [new("model", T("Model"), CollectionFilterKind.Text) { Advanced = true }]
        },
        new("usage", T("Usage"), profile => @<span>@(profile.Properties.UsageCount is { } count ? AgentCount(count) : "—")</span>)
        {
            Filters = [new("usage", T("Usage"), CollectionFilterKind.Number) { Advanced = true }]
        }
    ];
    private IReadOnlyList<CollectionFilter> ExtraFilters =>
    [
        new("namespace", T("Namespace"), CollectionFilterKind.Choice)
        {
            Options = (items ?? []).Select(profile => profile.Namespace).Distinct(StringComparer.Ordinal).Order().Select(value => new CollectionFilterOption(value, value)).ToArray()
        },
        new("scope", Shared["Scope"], CollectionFilterKind.Choice)
        {
            Options = (items ?? []).Select(profile => profile.ScopeRef?.Value).OfType<string>().Distinct(StringComparer.Ordinal).Order().Select(value => new CollectionFilterOption(value, Context.Current?.Contexts.FirstOrDefault(context => context.ScopeRef == value)?.DisplayName ?? value)).ToArray()
        }
    ];
    private RenderFragment<ModelProfileSummaryResponse>? RowActions => (items ?? []).Any(CanDelete) ? profile => @<text>
        @if (CanDelete(profile)) { <CollectionActions ResourceName="@($"{profile.Properties.DisplayName} ({profile.Namespace}/{profile.Name}, {profile.ScopeRef})")"><button class="danger-text" type="button" disabled="@(operationBusy || loadState.Status == ResourceLoadStatus.Refreshing)" @onclick="() => RequestDeleteAsync(profile)">@T("Delete")</button></CollectionActions> }
    </text> : null;
    private static string StatusKey(string? status) => status?.ToLowerInvariant() switch
    {
        "available" => "Available", "unavailable" => "Unavailable", "incompatible" => "Incompatible", "ready" => "Ready",
        "providerunavailable" => "ProviderUnavailable", "modelunavailable" => "ModelUnavailable", "invalidconfiguration" => "InvalidConfiguration", _ => "Unknown"
    };
    private string StatusLabel(string? status) => T($"Status.{StatusKey(status)}");
    private static UiStatus StatusTone(string? status) => StatusKey(status) == "Unknown" ? UiStatus.Neutral : ModelManagementUi.Status(status);
    private Task RefreshAsync() { operationFailed = false; operationErrorId = null; deleteConflictUsages = []; return LoadAsync(); }
    private string Navigate(string path) => ResourceOwnershipContext.PreserveNavigation(path, Services);
    private string DetailsUrl(ModelProfileSummaryResponse profile) => Navigate(ConsoleResourceUrls.ModelProfile(ResourceAddress.Create(ResourceNamespace.Parse(profile.Namespace), ModelResourceKinds.ModelProfile, profile.Name), profile.ScopeRef));
    private static string AgentUrl(ModelProfileUsageResponse usage) => ConsoleResourceUrls.Agent(ResourceNamespace.Parse(usage.Namespace), usage.Name, usage.ScopeRef, usage.ScopeRef);
}
