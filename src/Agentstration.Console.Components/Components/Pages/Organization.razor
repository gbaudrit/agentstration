@using Agentstration.Resources
@page "/settings/organization"
@inject Agentstration.Web.Console.IIdentityAdministrationApiClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<OrganizationStrings> Localizer

<PageTitle>@T("Organization") · Agentstration</PageTitle>
<PageHeader Title="@T("Organization")" Description="@T("Organization.Description")" />
<OrganizationSettingsNav />
<div data-testid="console-admin-organization">

@if (view is null)
{
    <LoadingState Message="@T("LoadingOrganization")" />
}
else
{
    <section class="dashboard-grid">
        <article class="panel">
            <div class="panel-header"><h2>@view.Tenant.DisplayName</h2><StatusBadge Text="@T($"Status.{view.Tenant.Status}")" Status="UiStatus.Success" /></div>
            <p><strong>@T("TechnicalName"):</strong> @view.Tenant.Name</p>
            <p><strong>@T("TenantId"):</strong> <code>@view.Tenant.Id</code></p>
            <p><strong>@T("Created"):</strong> <time datetime="@view.Tenant.CreatedAt.ToString("O")">@view.Tenant.CreatedAt.ToLocalTime().ToString("g")</time></p>
        </article>
        <article class="panel">
            <div class="panel-header"><h2>@T("Workspaces")</h2></div>
            @foreach (var workspace in view.Workspaces)
            {
                <article><CollectionIdentity DisplayName="@workspace.DisplayName" Name="@workspace.Name" IconName="workspace" ><IconBadges><ResourceScopeBadge ScopeRef="@ResourceScopeRef.Workspace(workspace.Id)" DisplayName="@workspace.DisplayName" IconOnly /></IconBadges></CollectionIdentity><small>@workspace.Id</small></article>
            }
        </article>
    </section>
    <section class="panel">
        <div class="panel-header"><h2>@T("MembersAndRoles")</h2></div>
        @foreach (var member in view.Members)
        {
            <article>
                <CollectionIdentity DisplayName="@member.Principal.DisplayName" IconName="users" /><p><StatusBadge Text="@T($"Status.{member.Membership.Status}")" Status="UiStatus.Success" /></p>
                @foreach (var role in member.Roles)
                {
                    <p><strong>@role.Role.DisplayName</strong><br /><small>@role.Scope</small></p>
                }
            </article>
        }
    </section>
}
</div>

@code {
    private Agentstration.Identity.Contracts.OrganizationAdministrationResponse? view;
    private string T(string key) => Localizer[key].Value;
    protected override async Task OnInitializedAsync() => view = await Client.GetOrganizationAsync(CancellationToken.None);
}
