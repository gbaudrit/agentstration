@page "/settings/organization/access"
@inject Agentstration.Web.Console.IIdentityAdministrationApiClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<OrganizationStrings> Localizer

<PageTitle>@T("AccessControl") · @T("Organization") · Agentstration</PageTitle>
<PageHeader Title="@T("AccessControl")" Description="@T("Access.Description")" />
<OrganizationSettingsNav />
<div data-testid="console-admin-organization-access">
@if (view is null) { <LoadingState Message="@T("LoadingAccess")" /> }
else
{
    <CollectionView TItem="AccessRow" Items="Rows" InformationLabels="@(new string[] { T("Role"), T("Inheritance") })" IdentityLabel="@T("Principal")" ScopeLabel="@T("Scope")">
        <Identity Context="row">
@row.Member.Principal.DisplayName</Identity>
        <Scope Context="row">
<ResourceScopeBadge ScopeRef="@ResourceScopeRef.Parse(row.Assignment.Scope)" /></Scope>
        <Information Context="row">
            <CollectionValue Label="@T("Role")"><strong>@row.Assignment.Role.DisplayName</strong></CollectionValue>
            <CollectionValue Label="@T("Inheritance")">@if(row.Assignment.Scope.StartsWith("/tenants/",StringComparison.Ordinal)){<StatusBadge Text="@T("Inherited")" Status="UiStatus.Info" />}else{<span>@T("Explicit")</span>}</CollectionValue>
        </Information>
    </CollectionView>
}
</div>
@code {
    private sealed record AccessRow(Agentstration.Identity.Contracts.OrganizationMemberResponse Member, Agentstration.Identity.Contracts.AssignedRoleResponse Assignment);
    private Agentstration.Identity.Contracts.OrganizationAdministrationResponse? view;
    private string T(string key) => Localizer[key].Value;
    private IReadOnlyList<AccessRow> Rows => view?.Members.SelectMany(member => member.Roles.Select(role => new AccessRow(member, role))).ToArray() ?? [];
    protected override async Task OnInitializedAsync() => view = await Client.GetOrganizationAsync(default);
}
