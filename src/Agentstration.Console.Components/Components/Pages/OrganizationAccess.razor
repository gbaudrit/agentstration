@page "/settings/organization/access"
@implements IDisposable
@inject IIdentityAdministrationApiClient Client
@inject IServiceProvider Services
@inject ConsoleContextState Context
@inject Microsoft.Extensions.Localization.IStringLocalizer<OrganizationStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared

<PageTitle>@T("AccessControl") · @T("Organization") · Agentstration</PageTitle>
<ResourceCollectionTemplate TItem="AccessRow" Title="@T("AccessControl")" Description="@T("Access.Description")" TestId="console-admin-organization-access" ContextKey="@contextKey"
                            IdentityColumn="IdentityColumn" Columns="Columns" Items="PageItems" RowTestId="organization-access-row"
                            Query="query" QueryChanged="ChangeQueryAsync" Pagination="Pagination" LoadState="loadState" Disabled="@(!interactive)"
                            SearchEnabled SearchLabel="@Shared["Search"]" SearchPlaceholder="@Shared["Search"]"
                            EmptyTitle="@T("Access.EmptyTitle")" EmptyMessage="@T("Access.EmptyMessage")" OnRefresh="LoadAsync" OnRetry="RetryAsync">
    <Navigation><OrganizationSettingsNav /></Navigation>
</ResourceCollectionTemplate>

@code {
    private string T(string key) => Localizer[key].Value;
    private CollectionColumn<AccessRow> IdentityColumn => new("identity", T("Principal"), row => @<CollectionIdentity DisplayName="@row.Member.Principal.DisplayName" Name="@row.Member.Principal.Id.ToString("D")" Href="@MemberUrl(row)" IconName="user" />);
    private IReadOnlyList<CollectionColumn<AccessRow>> Columns =>
    [
        new("scope", T("Scope"), row => @<ResourceScopeBadge ScopeRef="@ResourceScopeRef.Parse(row.Assignment.Scope)" />)
        {
            Filters = [new("scope", T("Scope"), CollectionFilterKind.Choice) { Advanced = true, Options = (items ?? []).Select(row => row.Assignment.Scope).Distinct(StringComparer.Ordinal).Order().Select(value => new CollectionFilterOption(value, value)).ToArray() }]
        },
        new("role", T("Role"), row => @<strong>@row.Assignment.Role.DisplayName</strong>)
        {
            Filters = [new("role", T("Role"), CollectionFilterKind.Choice) { Options = (items ?? []).Select(row => row.Assignment.Role).DistinctBy(role => role.Id).OrderBy(role => role.DisplayName, StringComparer.OrdinalIgnoreCase).Select(role => new CollectionFilterOption(role.Id.ToString("D"), role.DisplayName)).ToArray() }]
        },
        new("inheritance", T("Inheritance"), row => @<text>@if (Inherited(row)) { <StatusBadge Text="@T("Inherited")" Status="UiStatus.Info" /> } else { <span>@T("Explicit")</span> }</text>)
        {
            Filters = [new("inheritance", T("Inheritance"), CollectionFilterKind.Choice) { Options = [new("inherited", T("Inherited")), new("explicit", T("Explicit"))] }]
        }
    ];
    private string MemberUrl(AccessRow row) => ResourceOwnershipContext.PreserveNavigation($"/settings/organization/members/{row.Member.Principal.Id:D}", Services);
    private static bool Inherited(AccessRow row) => row.Assignment.Scope.StartsWith("/tenants/", StringComparison.Ordinal);
}
