@page "/storages/new"
@page "/storages/{Name}/edit"
@implements IDisposable
@using static Agentstration.Web.Console.StorageEditorModel
@inject IStoragesClient Client
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@inject IConnectedServicesClient ServicesClient
@inject ConsoleContextState Context
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<StorageStrings> Localizer

@if (!Embedded) { <UnsavedNavigationGuard IsDirty="@IsDirty" HasUnsavedChanges="@(() => IsDirty)" /> }
@if (!Embedded)
{
    <PageTitle>@T(IsNew ? "Create" : "Edit") · Agentstration</PageTitle>
    <PageHeader CollectionHref="/storages" CollectionLabel="@T("Storages")" Enabled="model.Enabled" EnabledChanged="value => model.Enabled = value" EnabledDisabled="@(busy || !CanWrite)" ScopeRef="ownerScope" EnabledTestId="storage-enabled" Title="@T(IsNew ? "Create" : "Edit")" Description="@T("Editor.Description")" TestId="storage-editor"><Actions>@if (!IsNew) { <a class="button-secondary" href="@BackUrl">@T("Cancel")</a> }</Actions></PageHeader>
}
@if (loadState.BlocksContent) { <ResourceLoadFeedback State="loadState" OnRetry="RetryAsync" /> }
else
{
    <StorageError Error="error" />
    @if (!Embedded && !CanWrite) { <ResourceReadOnlyNotice Reason="@(ReadOnlyReason ?? (original?.Governance.IsManaged == true ? ResourceReadOnlyReason.Managed : ownerScope?.Value != Context.Current?.SelectedScopeRef ? ResourceReadOnlyReason.Inherited : ResourceReadOnlyReason.InsufficientPermissions))" /> }

    @EditorForm

}
<StorageConfirmation IsOpen="confirmRebind" Title="@T("Rebind")" Message="@T("Rebind.Confirm")" ConfirmLabel="@T("Rebind")" TestId="storage-rebind-confirmation" OnConfirm="ConfirmSaveAsync" OnCancel="() => confirmRebind = false" />

@code {
    private RenderFragment EditorForm => @<ResourceDefinitionForm @key="editContext" @ref="definitionForm" EditContext="editContext" FieldLabels="FieldLabels" Id="@FormId" FormName="storage-editor"
        Sections="@(SectionPresentations ?? DefinitionPresentations())" SectionState="SectionState" SectionContent="@(SectionState is null ? null : DefinitionContent)" SectionRequested="SectionRequested"
        OnValidSubmit="RequestSaveAsync" OnInvalidSubmit="InvalidSubmitAsync" InvalidInputChanged="value => invalidInput = value" Busy="@(busy || ExternalBusy)" ReadOnly="@(!CanWrite)" FieldsTestId="storage-definition-fields" Class="storage-fields" data-testid="storage-form" data-resource-etag="@etag">
        <ChildContent>
            @if (IsNew) { <p class="required-fields-note"><span aria-hidden="true">*</span> @Shared["RequiredFields"]</p><CreationWizard @ref="wizard" Steps="Steps" OnFinish="FinishAsync" Busy="@(busy || ExternalBusy)" Disabled="@(!CanWrite)" CanFinish="CanSave" FinishLabel="@T("Save")" FinishTestId="storage-save" /> }
            else if (SectionState is null) { @IdentityFields @ConfigurationFields @SharingFields }
            @if (!IsNew && !ExternalActions && CanWrite) { <FormActions><button type="submit" form="@FormId" class="button-primary" disabled="@(!CanEdit)" data-testid="storage-save">@T(busy ? "Saving" : "Save")</button></FormActions> }
        </ChildContent>
    </ResourceDefinitionForm>;
    private RenderFragment IdentityFields => @<ResourceIdentityEditor ResourceKind="@StorageResourceKinds.Storage"
        DisplayName="@model.DisplayName" DisplayNameChanged="value => model.DisplayName = value" DisplayNameExpression="@(() => model.DisplayName)" TechnicalName="@model.Name" TechnicalNameChanged="value => model.Name = value" TechnicalNameExpression="@(() => model.Name)"
        Namespace="@model.Namespace" NamespaceExpression="@(() => model.Namespace)" ScopeRef="ownerScope" ScopeTargets="IdentityScopeTargets" IsNew="IsNew" ReadOnly="@(!CanWrite)"
        Description="@model.Description" DescriptionChanged="value => model.Description = value" DescriptionExpression="@(() => model.Description)" Labels="@model.Tags" LabelsExpression="@(() => model.Tags)" LabelsReadOnly="true"
        DisplayNameTestId="storage-display-name" TechnicalNameTestId="storage-name" TestId="storage-identity-editor" />;
    private RenderFragment ConfigurationFields => @<div class="resource-editor-view">            <FormSection Title="@T("ExactType")">
                @if (model.Type is { } savedType)
                {
                    <div class="storage-reference-summary"><CollectionIdentity DisplayName="@(SelectedType?.Resource.Definition.DisplayName ?? savedType.Type.Name)" Name="@savedType.Type.Name" Namespace="@((savedType.Type.Namespace ?? resourceNamespace).Value)" Href="@(savedType.Type.ScopeRef is { } typeOwner ? ResourceOwnershipContext.Resource(Services, "/storage-types", savedType.Type.Name, savedType.Type.Namespace ?? resourceNamespace, typeOwner) : null)" IconName="database"><IconBadges>@if (savedType.Type.ScopeRef is { } typeScope) { <ResourceScopeBadge ScopeRef="typeScope" IconOnly /> }</IconBadges></CollectionIdentity><span>@T("Version") · <strong>@savedType.Version</strong></span></div>
                }
                <FormField Label="@T("Type")" Tooltip="@T("Type.AccessHelp")" Required><ChildContent><ClearableSelect TValue="string" Value="@TypeKey" ValueChanged="value => TypeChanged(new ChangeEventArgs { Value = value })" data-testid="storage-type">
                    <option value="">@T("SelectType")</option>
                    @if (model.Type is not null && SelectedType is null) { <option value="@TypeKey" disabled>@T("SavedTypeUnavailable")</option> }
                    @foreach (var choice in variants) { <option value="@choice.Key" disabled="@(!Available(choice))">@choice.Resource.Definition.DisplayName · @choice.Version.Version · @choice.Resource.ScopeRef/@choice.Resource.Namespace/@choice.Resource.Name · @T($"Origin.{choice.Resource.Governance.Origin.Kind}") · @T($"Availability.{TypeAvailability(choice)}") · @T(choice.Resource.ObservedUse?.Use.Allowed == true ? "Type.UseGranted" : "Type.UseNotGranted")</option> }
                </ClearableSelect></ChildContent><Validation><ValidationMessage For="() => model.Type" /></Validation></FormField>
                @if (model.Type is { } pinnedType) { <details><summary>@T("Type.VersionContract")</summary><p>@T("SelectedType"): <code>@pinnedType.Type.ScopeRef/@pinnedType.Type.Namespace/@pinnedType.Type.Name · @pinnedType.TypeUid · @pinnedType.Version · @pinnedType.SchemaDigest · @pinnedType.ContractDigest</code></p><StorageTypeEvidence Choice="SelectedType" /></details> }
            </FormSection>
            @if (SelectedType is { } current)
            {
                @if (current.Version.RequiresConnectedService)
                {
                    <FormSection Title="@T("ConnectedService")" Description="@T("ManualMapping.Help")">
                        @if (model.ConnectedService is { } savedService) { <div class="storage-reference-summary"><CollectionIdentity DisplayName="@(SelectedService?.Definition.DisplayName ?? savedService.Service.Address.Name)" Name="@savedService.Service.Address.Name" Namespace="@savedService.Service.Address.Namespace.Value" Href="@ResourceOwnershipContext.Resource(Services, "/connected-services", savedService.Service.Address.Name, savedService.Service.Address.Namespace, savedService.Service.ScopeRef)" IconName="plug"><IconBadges><ResourceScopeBadge ScopeRef="savedService.Service.ScopeRef" IconOnly /></IconBadges></CollectionIdentity><span>@T("Generation") · <strong>@savedService.Generation</strong></span></div> }
                        <FormField Label="@T("ConnectedService")" Required><ChildContent><ClearableSelect TValue="string" Value="@ServiceKey" ValueChanged="value => ServiceChanged(new ChangeEventArgs { Value = value })" data-testid="storage-service">
                            <option value="">@T("SelectService")</option>
                            @if (model.ConnectedService is not null && SelectedService is null) { <option value="@ServiceKey" disabled>@T("SavedServiceUnavailable")</option> }
                            @foreach (var service in services.Where(ServiceAvailable)) { <option value="@Key(service)">@service.Definition.DisplayName · @service.ScopeRef/@service.Namespace/@service.Name · @T("Generation") @service.Generation</option> }
                        </ClearableSelect></ChildContent><Validation><ValidationMessage For="() => model.ConnectedService" /></Validation></FormField>
                        <p>@T("Service.Help") <a href="@ResourceOwnershipContext.PreserveNavigation("/connected-services", Services)">@T("ManageConnectedServices")</a></p>
                        @if (servicesUnavailable) { <p role="status">@T("Error.Service")</p> }
                        <FormField Label="@T("Mappings")"><ChildContent>
                        @foreach (var requirement in current.Version.Requirements)
                        {
                            var savedExport = model.Bindings.SingleOrDefault(value => value.RequirementId == requirement.Id)?.Export;
                            var candidates = Exports.Where(value => Compatible(requirement, value)).ToArray();
                            <FormField Label="@requirement.Id" Class="storage-requirement"><LabelContent><code>@requirement.Id</code> · @T(requirement.Required ? "Required" : "Optional") · @T($"ValueType.{requirement.Type}") · @T($"Protection.{requirement.Protection}") @requirement.Format</LabelContent><ChildContent>
                                <ClearableSelect TValue="string" Value="@ExportKey(savedExport)" ValueChanged="value => ExportChanged(requirement.Id, new ChangeEventArgs { Value = value })" disabled="@(SelectedService is null)" data-testid="storage-export">
                                    <option value="">@T("SelectExport")</option>
                                    @if (savedExport is not null && !candidates.Contains(savedExport)) { <option value="@ExportKey(savedExport)" disabled>@savedExport.Id · @T("SavedExportUnavailable")</option> }
                                    @foreach (var export in candidates) { <option value="@ExportKey(export)">@export.Id · @T($"ValueType.{export.Type}") · @T($"Protection.{export.Protection}") · @export.Format</option> }
                                </ClearableSelect>
                            </ChildContent></FormField>
                        }
                        </ChildContent><Validation><ValidationMessage For="() => model.Bindings" /></Validation></FormField>
                    </FormSection>
                }
                <FormSection Title="@T("Configuration")" TestId="storage-configuration"><JsonSchemaInputEditor @key="TypeKey" Schema="current.Version.ConfigurationSchema" Value="model.Configuration" ValueChanged="SetConfiguration" ValidationChanged="ConfigurationValidationChanged" Disabled="@(busy || ExternalBusy)" ReadOnly="@(!CanWrite)" /></FormSection>
                <FormSection Title="@T("Envelope")" Description="@T("Envelope.Help")" TestId="storage-envelope"><JsonSchemaInputEditor @key="TypeKey" Schema="current.Version.EnvelopeSchema" Value="model.Envelope" ValueChanged="SetEnvelope" ValidationChanged="EnvelopeValidationChanged" Disabled="@(busy || ExternalBusy)" ReadOnly="@(!CanWrite)" /></FormSection>
            }
            else if (!IsNew) { <p role="status">@T("SavedTypeUnavailable")</p> }
            @if (SelectedType?.Version.Documents is { } documentCapabilities)
            {
                <StorageCollectionsEditor Value="model.Collections" ValueChanged="SetCollections" Capabilities="documentCapabilities" ReadOnly="@(!CanWrite)" ValidationChanged="CollectionsValidationChanged" />
            }
</div>;
    private RenderFragment SharingFields => @<div class="resource-editor-view">            <DescendantUseGrantEditor OwnerScopeRef="ownerScope" Targets="scopeTargets" Grants="model.UseGrants" OnChanged="UseGrantsChanged" /></div>;
    private RenderFragment Review => @<div><ResourceIdentitySummary DisplayName="@model.DisplayName" TechnicalName="@model.Name" Namespace="@model.Namespace" Description="@model.Description" Labels="original?.Metadata.Tags"><Scope><ResourceScopeBadge ScopeRef="ownerScope" /></Scope></ResourceIdentitySummary>
        <FormSection Title="@Shared["Configuration"]"><dl class="resource-details"><dt>@T("Type")</dt><dd>@model.Type?.Type.ScopeRef · @model.Type?.Type.Namespace/@model.Type?.Type.Name · @model.Type?.Version</dd><dt>@T("Enabled")</dt><dd>@T(model.Enabled ? "Yes" : "No")</dd></dl>@if (model.Type is not null) { <details><summary>@T("Configuration")</summary><pre>@JsonSerializer.Serialize(model.Properties(), new JsonSerializerOptions { WriteIndented = true })</pre></details> }</FormSection></div>;
    [Parameter] public ResourceSectionState? SectionState { get; set; }
    [Parameter] public IReadOnlyDictionary<string, ResourceSectionPresentation>? SectionPresentations { get; set; }
    [Parameter] public EventCallback<string> SectionRequested { get; set; }
    [Parameter] public ResourceReadOnlyReason? ReadOnlyReason { get; set; }
    [Parameter] public bool SaveBlocked { get; set; }
    [Parameter] public EventCallback<ResourceSnapshot<StorageResource>> SnapshotSaved { get; set; }
    private ResourceDefinitionForm? definitionForm;
    private CreationWizard? wizard;
    private bool validationAttempted, disposed;
    private ResourceLoadState loadState = new(ResourceLoadStatus.Loading);
    private readonly CancellationToken lifetimeToken;
    public StorageEditor() => lifetimeToken = cancellation.Token;
    public bool CanEdit => !loading && !busy && !ExternalBusy && !SaveBlocked && CanWrite;
    public string? Version => etag;
    public static IReadOnlyDictionary<string, ResourceSectionPresentation> DefinitionPresentations() => new Dictionary<string, ResourceSectionPresentation>(StringComparer.Ordinal)
    {
        ["definition/identity"] = new() { HasRequiredFields = true, Fields = [nameof(StorageEditorModel.Name), nameof(StorageEditorModel.DisplayName), nameof(StorageEditorModel.Description), nameof(StorageEditorModel.Namespace), nameof(StorageEditorModel.ScopeRef), nameof(StorageEditorModel.Tags)] },
        ["definition/configuration"] = new() { HasRequiredFields = true, Fields = [nameof(StorageEditorModel.Type), nameof(StorageEditorModel.ConnectedService), nameof(StorageEditorModel.ConnectedServiceType), nameof(StorageEditorModel.Bindings), nameof(StorageEditorModel.Configuration), nameof(StorageEditorModel.Envelope), nameof(StorageEditorModel.Collections)] },
        ["definition/use-policy"] = new() { Fields = [nameof(StorageEditorModel.UseGrants)] }
    };
    private IReadOnlyDictionary<string, string> FieldLabels => new Dictionary<string, string>(StringComparer.Ordinal)
    {
        [nameof(model.Name)] = T("TechnicalName"), [nameof(model.DisplayName)] = T("DisplayNameLabel"), [nameof(model.Description)] = T("Description"), [nameof(model.Namespace)] = T("Namespace"), [nameof(model.ScopeRef)] = T("Scope"), [nameof(model.Tags)] = Shared["Labels"],
        [nameof(model.Type)] = T("Type"), [nameof(model.ConnectedService)] = T("ConnectedService"), [nameof(model.ConnectedServiceType)] = T("ServiceType"), [nameof(model.Bindings)] = T("Mappings"), [nameof(model.Configuration)] = T("Configuration"), [nameof(model.Envelope)] = T("Envelope"), [nameof(model.Collections)] = T("Documents.Collections"), [nameof(model.UseGrants)] = T("DescendantUsePolicy")
    };
    private IReadOnlyList<ResourceScopeTargetResponse> IdentityScopeTargets => ownerScope is not { } scope ? [] : [new(scope, scope.Kind,
        scopeTargets.FirstOrDefault(target => target.ScopeRef == scope)?.DisplayName ?? Context.Current?.Contexts.FirstOrDefault(target => target.ScopeRef == scope.Value)?.DisplayName ?? scope.Value, CanWrite)];
    private RenderFragment DefinitionContent(string path) => path switch { "definition/identity" => IdentityFields, "definition/configuration" => ConfigurationFields, "definition/use-policy" => SharingFields, _ => throw new ArgumentOutOfRangeException(nameof(path)) };
    private async Task InvalidSubmitAsync(EditContext context)
    {
        if (!IsNew) return;
        var step = ResourceDefinitionForm.FirstInvalidSection(context, DefinitionPresentations()) == "definition/identity" ? "identity" : "configuration";
        if (wizard is not null) await wizard.GoToStepAsync(step);
        definitionForm?.RequestValidationFocus();
    }
    private void UseGrantsChanged() { editContext.NotifyFieldChanged(editContext.Field(nameof(model.UseGrants))); }
    private void SetConfiguration(JsonElement value) { if (CanWrite && !busy && !ExternalBusy) { model.Configuration = value; editContext.NotifyFieldChanged(editContext.Field(nameof(model.Configuration))); } }
    private void SetEnvelope(JsonElement value) { if (CanWrite && !busy && !ExternalBusy) { model.Envelope = value; editContext.NotifyFieldChanged(editContext.Field(nameof(model.Envelope))); } }
    private void SetCollections(IReadOnlyList<StorageDocumentCollection> value) { if (CanWrite && !busy && !ExternalBusy) { model.Collections = value.ToList(); editContext.NotifyFieldChanged(editContext.Field(nameof(model.Collections))); } }
    private void ConfigurationValidationChanged(JsonSchemaInputValidationState state) { configurationValid = state.IsValid; ValidateSpecializedField(nameof(model.Configuration), state.IsValid); }
    private void EnvelopeValidationChanged(JsonSchemaInputValidationState state) { envelopeValid = state.IsValid; ValidateSpecializedField(nameof(model.Envelope), state.IsValid); }
    private void CollectionsValidationChanged(bool valid) { collectionsValid = valid; ValidateSpecializedField(nameof(model.Collections), valid); }
    private void ValidateSpecializedField(string field, bool valid)
    {
        if (editContext is null || disposed) return;
        messages.Clear(editContext.Field(field));
        if (!valid) messages.Add(editContext.Field(field), T("Validation.Configuration"));
        editContext.NotifyValidationStateChanged();
    }
    private Task RetryAsync() { loadedKey = null; return OnParametersSetAsync(); }
    private void ResetDraft(StorageResource value)
    {
        model = StorageEditorModel.From(value); NewContext(); invalidInput = false; configurationValid = envelopeValid = collectionsValid = true;
        confirmRebind = validationFailed = false; pendingProperties = null; error = null; baseline = Fingerprint;
    }
    public void ApplySnapshot(ResourceSnapshot<StorageResource> snapshot, bool discard = false)
    {
        if (disposed || original is null || snapshot.Value.ScopeRef is null || snapshot.Value.Uid != original.Uid || StorageLinks.Address(snapshot.Value) != StorageLinks.Address(original) || !discard && IsDirty) return;
        original = snapshot.Value; etag = snapshot.ETag; ResetDraft(original); StateHasChanged();
    }
    [Parameter] public bool ExternalActions { get; set; }
    [Parameter] public bool ExternalBusy { get; set; }
    [Parameter] public EventCallback<bool> DraftChanged { get; set; }
    [Parameter] public EventCallback<bool> SavingChanged { get; set; }
    [Parameter] public ResourceSnapshot<StorageResource>? InitialSnapshot { get; set; }
    public string FormId { get; } = $"storage-form-{Guid.NewGuid():N}";
    public bool CanSubmit => CanSave;
    public bool IsDirty => !loading && baseline is not null && (baseline != Fingerprint || invalidInput);
    private string Fingerprint => JsonSerializer.Serialize(model);
    private string? baseline, redirectedKey;
    private EditContext editContext = null!;
    private ValidationMessageStore messages = null!;
    private bool invalidInput, reportedDirty, reportedCanSubmit;
    private long loadVersion;
    private bool IdentityComplete => model.InvalidIdentityFields().Count == 0;
    private void NewContext()
    {
        if (editContext is not null) { editContext.OnFieldChanged -= FieldChanged; editContext.OnValidationRequested -= ValidateRequested; }
        editContext = new(model); messages = new(editContext); validationAttempted = false;
        editContext.OnFieldChanged += FieldChanged; editContext.OnValidationRequested += ValidateRequested;
    }
    private void FieldChanged(object? sender, FieldChangedEventArgs args)
    {
        if (validationAttempted) ValidateFields();
        else { messages.Clear(args.FieldIdentifier); editContext.NotifyValidationStateChanged(); }
    }
    private void ValidateRequested(object? sender, ValidationRequestedEventArgs args) { validationAttempted = true; ValidateFields(); }
    private void ValidateFields()
    {
        messages.Clear();
        foreach (var field in model.InvalidIdentityFields()) messages.Add(editContext.Field(field), T(field == nameof(model.Name) ? "Validation.TechnicalNameInvalid" : "Validation.DisplayNameRequired"));
        if (model.Type is null || BindingChanged && (SelectedType is not { } type || !Available(type))) messages.Add(editContext.Field(nameof(model.Type)), T("Validation.Configuration"));
        else if (BindingChanged && SelectedType is { } selected)
        {
            if (selected.Version.RequiresConnectedService && (SelectedService is not { } service || !ServiceAvailable(service))) messages.Add(editContext.Field(nameof(model.ConnectedService)), T("Validation.Configuration"));
            else if (!ValidBinding) messages.Add(editContext.Field(nameof(model.Bindings)), T("Error.Mapping"));
        }
        if (!configurationValid) messages.Add(editContext.Field(nameof(model.Configuration)), T("Validation.Configuration"));
        if (!envelopeValid) messages.Add(editContext.Field(nameof(model.Envelope)), T("Validation.Configuration"));
        if (!collectionsValid) messages.Add(editContext.Field(nameof(model.Collections)), T("Validation.Configuration"));
        editContext.NotifyValidationStateChanged();
    }
    private bool ValidateIdentity() => editContext.Validate();
    private IReadOnlyList<CreationWizardStep> Steps => [new("identity", Shared["Identity"], IdentityFields) { IsComplete = IdentityComplete }, new("configuration", Shared["Configuration"], ConfigurationFields) { IsComplete = CanSave }, new("access", T("DescendantUsePolicy"), SharingFields) { IsComplete = true }, new("review", Shared["Verification"], Review) { IsComplete = IdentityComplete && CanSave }];
    private async Task FinishAsync(CreationWizardFinish finish)
    {
        if (!ValidateIdentity() || invalidInput) { finish.ReturnToStepId = ResourceDefinitionForm.FirstInvalidSection(editContext, DefinitionPresentations()) == "definition/identity" ? "identity" : "configuration"; definitionForm?.RequestValidationFocus(); return; }
        await RequestSaveAsync();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (reportedDirty != IsDirty || reportedCanSubmit != CanSubmit) { reportedDirty = IsDirty; reportedCanSubmit = CanSubmit; await DraftChanged.InvokeAsync(IsDirty); }
    }
    public void Discard()
    {
        if (disposed || busy || ExternalBusy || original is null) return;
        ResetDraft(original);
        StateHasChanged();
    }
    public void ApplyOperationalSnapshot(ResourceSnapshot<StorageResource> snapshot)
    {
        if (disposed || original is null || original.Uid != snapshot.Value.Uid || StorageLinks.Address(original) != StorageLinks.Address(snapshot.Value)) return;
        model.Enabled = original.Definition.Enabled;
        var otherChanges = Fingerprint != baseline;
        model.Enabled = snapshot.Value.Definition.Enabled; original = snapshot.Value; etag = snapshot.ETag;
        if (!otherChanges) baseline = Fingerprint;
        StateHasChanged();
    }

    [Parameter] public string? Name { get; set; }
    [SupplyParameterFromQuery(Name = "scopeRef")] public string? ScopeRefValue { get; set; }
    [SupplyParameterFromQuery(Name = "namespace")] public string? NamespaceValue { get; set; }
    [Parameter] public bool Embedded { get; set; }
    [Parameter] public ScopedResourceAddress? EmbeddedAddress { get; set; }
    [Parameter] public EventCallback Saved { get; set; }
    private readonly CancellationTokenSource cancellation = new();
    private StorageEditorModel model = new();
    private StorageResource? original;
    private StorageProperties? pendingProperties;
    private IReadOnlyList<StorageTypeChoice> variants = [];
    private IReadOnlyList<ConnectedServiceResource> services = [];
    private IReadOnlyList<ConnectedServiceTypeResource> serviceTypes = [];
    private IReadOnlyList<ResourceScopeTargetResponse> scopeTargets = [];
    private ResourceScopeRef? ownerScope;
    private ResourceNamespace resourceNamespace = ResourceNamespace.Default;
    private string? etag, loadedKey;
    private bool loading = true, busy, configurationValid = true, envelopeValid = true, collectionsValid = true, validationFailed, confirmRebind, servicesUnavailable;
    private Exception? error;
    private bool IsNew => EmbeddedAddress is null && (string.IsNullOrEmpty(Name) || Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath.TrimEnd('/').Equals("/storages/new", StringComparison.OrdinalIgnoreCase));
    private bool CanWrite => ReadOnlyReason is null && Context.HasPermission("resources/write") && ownerScope?.Value == Context.Current?.SelectedScopeRef && original?.Governance.IsManaged != true;
    private string TypeKey => model.Type is null ? string.Empty : JsonSerializer.Serialize(model.Type);
    private string ServiceKey => model.ConnectedService is null ? string.Empty : JsonSerializer.Serialize(model.ConnectedService);
    private StorageTypeChoice? SelectedType => variants.FirstOrDefault(value => value.Matches(model.Type));
    private ConnectedServiceResource? SelectedService => services.FirstOrDefault(value => Key(value) == ServiceKey && value.Definition.Type == model.ConnectedServiceType);
    private bool BindingChanged => model.HasBindingChange(original);
    private bool CanSave => CanEdit && !invalidInput && CanWrite && model.Type is not null && configurationValid && envelopeValid && collectionsValid && (!BindingChanged || ValidBinding);
    private bool ValidBinding => model.HasValidBinding(SelectedType, SelectedService, Exports);
    private IReadOnlyList<ConnectedServiceExportDescriptor> Exports => SelectedService is not { } service ? [] : serviceTypes.Where(type => type.Uid == service.Definition.Type.TypeUid && type.Name == service.Definition.Type.Type.Name && type.ScopeRef == service.Definition.Type.Type.ScopeRef && type.Namespace == (service.Definition.Type.Type.Namespace ?? service.Namespace)).SelectMany(type => type.Definition.Versions.Where(version => version.Version == service.Definition.Type.Version && version.SchemaDigest == service.Definition.Type.SchemaDigest)).SelectMany(version => version.Exports).ToArray();
    private string BackUrl => ResourceOwnershipContext.PreserveNavigation(original is null ? "/storages" : StorageLinks.Details(original), Services);
    private string T(string key) => Localizer[key].Value;
    protected override async Task OnParametersSetAsync()
    {
        var key = $"{IsNew}|{Name}|{ScopeRefValue}|{NamespaceValue}|{EmbeddedAddress}|{Context.Current?.SelectedScopeRef}";
        if (key == loadedKey) { if (InitialSnapshot is { } incoming && incoming.ETag != etag) ApplySnapshot(incoming); return; }
        loadedKey = key; var request = ++loadVersion; loading = true; busy = false; loadState = new(ResourceLoadStatus.Loading); error = null; original = null; model = new(); etag = baseline = null; variants = []; services = []; serviceTypes = []; scopeTargets = []; ownerScope = null; pendingProperties = null; invalidInput = confirmRebind = validationFailed = false; configurationValid = envelopeValid = collectionsValid = true;
        try
        {
            await Context.EnsureLoadedAsync(lifetimeToken);
            if (!Context.HasPermission("resources/read")) { loadState = new(ResourceLoadStatus.Forbidden); return; }
            if (request != loadVersion || disposed) return;
            var contextScope = ResourceScopeRef.Parse(Context.Current!.SelectedScopeRef);
            loadedKey = $"{IsNew}|{Name}|{ScopeRefValue}|{NamespaceValue}|{EmbeddedAddress}|{Context.Current.SelectedScopeRef}";
            ownerScope = IsNew ? contextScope : EmbeddedAddress?.ScopeRef ?? ResourceScopeRef.Parse(ScopeRefValue ?? throw new ArgumentException("scopeRef"));
            resourceNamespace = EmbeddedAddress?.Namespace ?? ResourceNamespace.Parse(NamespaceValue);
            if (!Embedded && !IsNew)
            {
                var route = $"{Name}|{ownerScope}|{resourceNamespace}|{Context.Current.SelectedScopeRef}";
                if (redirectedKey != route) { redirectedKey = route; Navigation.NavigateTo(ResourceOwnershipContext.Resource(Services, "/storages", Name!, resourceNamespace, ownerScope) + "#definition/configuration", replace: true); }
                return;
            }
            if (!IsNew)
            {
                var snapshot = InitialSnapshot ?? await Client.GetAsync(EmbeddedAddress ?? ScopedResourceAddress.Create(ownerScope.Value, resourceNamespace, StorageResourceKinds.Storage, Name!), lifetimeToken);
                if (request != loadVersion || disposed) return;
                if (snapshot.Value.ScopeRef != ownerScope || snapshot.Value.Namespace != resourceNamespace || snapshot.Value.Name != (EmbeddedAddress?.Name ?? Name)) throw new InvalidOperationException(T("Error.IdentityMismatch"));
                original = snapshot.Value; etag = snapshot.ETag; model = StorageEditorModel.From(original);
            }
            if (IsNew) { model.ScopeRef = ownerScope; model.Namespace = resourceNamespace.Value; }
            var typesTask = Client.GetTypesAsync(ownerScope.Value, lifetimeToken);
            var servicesTask = LoadServiceMetadataAsync(request);
            var scopesTask = Client.GetScopeTargetsAsync(lifetimeToken);
            await Task.WhenAll(typesTask, servicesTask, scopesTask);
            if (request != loadVersion || disposed) return;
            variants = (await typesTask).SelectMany(type => type.Definition.Versions.Select(version => new StorageTypeChoice(type, version))).ToArray();
            scopeTargets = await scopesTask;
        }
        catch (OperationCanceledException) when (lifetimeToken.IsCancellationRequested) { }
        catch (Exception exception)
        {
            if (request == loadVersion && !disposed)
            {
                error = exception;
                var status = exception is AgentstrationApiException api ? api.StatusCode switch
                {
                    System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden => ResourceLoadStatus.Forbidden,
                    System.Net.HttpStatusCode.NotFound => ResourceLoadStatus.NotFound,
                    _ => ResourceLoadStatus.Failed
                } : ResourceLoadStatus.Failed;
