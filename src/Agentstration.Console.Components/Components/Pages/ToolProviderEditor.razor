@page "/tools/providers/new"
@page "/tools/providers/{Name}"
@inject IToolsClient Client
@inject NavigationManager Navigation
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<ExtensionStrings> ExtensionLocalizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<ToolProviderEditorStrings> Localizer

<PageTitle>@(IsNew ? T("AddProvider") : displayName) · Agentstration</PageTitle>
<PageHeader Title="@(IsNew ? T("AddProvider") : displayName)" Description="@T("Description")" TestId="resource-tool-provider-editor"><Actions><a class="button-secondary" href="/tools/providers">@T("Back")</a>@if (!IsNew && CanMutate) { <button class="button-secondary" @onclick="TestAsync" disabled="@busy"><UiIcon Name="activity" />@T("TestConnection")</button><button class="button-primary" @onclick="RefreshAsync" disabled="@busy"><UiIcon Name="refresh" />@T("RefreshDiscovery")</button> }</Actions></PageHeader>

@if (loading) { <LoadingState Message="@T("Loading")" /> }
else
{
    @if (message is not null) { <div class="form-alert @(failed ? "form-alert-danger" : "form-alert-success")">@message</div> }
    @if (!IsNew)
    {
        @if (provider?.Definition.Aep?.Extension is { } extension)
        {
            <section class="panel form-section">
                <p>@ExtensionLocalizer["ManagingExtension"]: <a href="@ExtensionUrl(extension)">@provider.Definition.DisplayName</a></p>
                @if (provider.Governance.IsManaged) { <p>@ExtensionLocalizer["ManagedReadOnly"] · @ExtensionLocalizer["ManagedResourceHelp"]</p> }
            </section>
        }
        <ResourceTabs Label="@T("SectionsLabel")"><button type="button" class="@(activeTab == ProviderTab.Overview ? "active" : null)" @onclick="() => activeTab = ProviderTab.Overview" data-testid="provider-overview-tab">@T("Overview")</button><button type="button" class="@(activeTab == ProviderTab.Tools ? "active" : null)" @onclick="() => activeTab = ProviderTab.Tools" data-testid="provider-tools-tab">@T("Tools")<span class="provider-tab-count">@tools.Count</span></button><button type="button" class="@(activeTab == ProviderTab.Connection ? "active" : null)" @onclick="() => activeTab = ProviderTab.Connection" data-testid="provider-connection-tab">@T("Connection")</button></ResourceTabs>
    }

    @if (IsNew || activeTab == ProviderTab.Overview)
    {
    <fieldset class="resource-definition-fields" disabled="@(!CanMutate)">
    <section class="panel form-section tool-provider-section" id="overview" data-testid="provider-overview-panel"><div class="panel-header tool-provider-section-header"><div class="tool-provider-section-heading"><span class="tool-provider-section-icon"><UiIcon Name="server" /></span><div><p class="eyebrow">@T("OverviewEyebrow")</p><h2>@T("Overview")</h2><p>@T("OverviewHelp")</p></div></div>@if (!IsNew) { <StatusBadge Text="@StatusLabel(provider?.Definition.Discovery.Status)" Status="@ProviderStatus(provider?.Definition.Discovery.Status)" /> }</div><div class="form-grid tool-provider-form-grid">
        <ResourceIdentityFields @bind-DisplayName="displayName" @bind-TechnicalName="name" IsNew="@IsNew" />
        <label><span>@T("ProviderType")</span><select @bind="providerType" disabled="@(!IsNew)"><option value="Mcp">MCP</option><option value="Aep">AEP</option></select></label>
        <ResourceScopeFormField ResourceKind="@ToolResourceKinds.ToolProvider" @bind-Value="selectedScope" Disabled="@(!IsNew)" />
        <label class="provider-enabled-toggle form-span-2"><input type="checkbox" @bind="enabled" /><span class="provider-toggle-icon"><UiIcon Name="check" /></span><span><strong>@T("Enabled")</strong><small>@T("EnabledHelp")</small></span></label>
        @if (!IsNew) { <div class="provider-observation form-span-2"><div><span class="provider-observation-icon"><UiIcon Name="activity" /></span><span><small>@T("Status")</small><strong>@StatusLabel(provider?.Definition.Discovery.Status)</strong></span></div><div><span class="provider-observation-icon"><UiIcon Name="clock" /></span><span><small>@T("LastDiscovery")</small><strong>@(provider?.Definition.Discovery.LastDiscoveryAt?.ToString("g") ?? T("Never"))</strong></span></div></div> }
    </div></section></fieldset>
    }

    @if (IsNew || activeTab == ProviderTab.Connection)
    {
    <fieldset class="resource-definition-fields" disabled="@(!CanMutate)">
    <section class="panel form-section tool-provider-section" id="connection" data-testid="provider-connection-panel"><div class="panel-header tool-provider-section-header"><div class="tool-provider-section-heading"><span class="tool-provider-section-icon"><UiIcon Name="settings" /></span><div><p class="eyebrow">@T("ConnectionEyebrow")</p><h2>@T("Connection")</h2><p>@T("ConnectionHelp")</p></div></div></div><div class="form-grid tool-provider-form-grid">
        @if (providerType == ToolProviderType.Aep) { <label class="form-span-2"><span>@T("AepExtensionId")</span><input @bind="extensionId" /></label> }
        else { <label><span>@T("Transport")</span><select @bind="transport"><option value="Stdio">STDIO</option><option value="StreamableHttp">Streamable HTTP</option></select></label>
            @if (transport == McpToolProviderTransport.Stdio) { <label><span>@T("Command")</span><input @bind="command" placeholder="npx" /></label><label class="form-span-2"><span>@T("Arguments")</span><textarea @bind="arguments" rows="4"></textarea></label><label><span>@T("WorkingDirectory")</span><input @bind="workingDirectory" /></label><label><span>@T("EnvironmentReferences")</span><textarea @bind="environmentReferences" rows="4" placeholder="TOKEN=Secrets:Mcp:Token"></textarea><small>@T("EnvironmentReferencesHelp")</small></label> }
            else { <label class="form-span-2"><span>@T("Endpoint")</span><input @bind="endpoint" placeholder="https://server.example/mcp" /></label> }
        }
    </div></section></fieldset>
    }

    @if (CanMutate && (IsNew || activeTab != ProviderTab.Tools))
    {
        <div class="form-actions tool-provider-actions"><button class="button-primary" @onclick="SaveAsync" disabled="@busy"><UiIcon Name="check" />@(busy ? T("Saving") : T("SaveProvider"))</button></div>
    }

    @if (!IsNew && activeTab == ProviderTab.Tools) { <section class="panel tool-provider-section" id="tools" data-testid="provider-tools-panel"><div class="panel-header tool-provider-section-header"><div class="tool-provider-section-heading"><span class="tool-provider-section-icon"><UiIcon Name="wrench" /></span><div><p class="eyebrow">@T("ToolsEyebrow")</p><h2>@T("Tools")</h2><p>@T("ToolsDiscovered", ToolCount(tools.Count))</p></div></div></div>
        @if (tools.Count == 0) { <EmptyState Title="@T("NoToolsTitle")" Message="@T("NoToolsMessage")" /> }
        else { <DataGrid TItem="ToolResource" Items="tools"><Header><tr><th>@T("Name")</th><th>@T("Status")</th><th>@T("Enabled")</th><th></th></tr></Header><Row Context="tool"><tr><td><span class="resource-name-with-scope"><strong>@tool.Definition.DisplayName</strong><ResourceScopeBadge ScopeRef="tool.ScopeRef" Compact /></span><code>@tool.Definition.ExternalId</code></td><td>@AvailabilityLabel(tool.Definition.Discovery?.Available == true)</td><td><input type="checkbox" checked="@tool.Definition.Enabled" disabled="@(!CanMutate || tool.Governance.IsManaged)" @onchange="args => EnableAsync(tool, (bool)args.Value!)" /></td><td><a class="text-button" href="@ToolUrl(tool)">@T("Inspect")</a></td></tr></Row></DataGrid> }
    </section> }
}

@code {
    [Parameter] public string? Name { get; set; }
    [SupplyParameterFromQuery(Name = "scopeRef")] public string? ScopeRefValue { get; set; }
    [SupplyParameterFromQuery(Name = "namespace")] public string? NamespaceValue { get; set; }
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string ToolCount(int count) => T(count == 1 ? "ToolCount.One" : "ToolCount.Many", count);
    private string AvailabilityLabel(bool available) => T(available ? "Available" : "Unavailable");
    private string StatusLabel(string? status) { if (status is null) return "—"; var value = Localizer[$"Status.{status}"]; return value.ResourceNotFound ? status : value.Value; }
    private bool IsNew => string.IsNullOrWhiteSpace(Name); private bool loading = true, busy, failed; private string? message, etag; private ToolProviderResource? provider; private IReadOnlyList<ToolResource> tools = [];
    private ResourceScopeRef? selectedScope;
    private bool CanMutate => IsNew || provider?.Governance.IsManaged == false
        && ResourceOwnershipContext.CanManage(provider.ScopeRef ?? ResourceScopeRef.Instance, Services);
    private string ExtensionUrl(ResourceReference extension) => $"/extensions/{Uri.EscapeDataString(extension.Name)}?namespace={Uri.EscapeDataString((extension.Namespace ?? provider!.Namespace).Value)}&scopeRef={Uri.EscapeDataString((extension.ScopeRef ?? provider!.ScopeRef ?? ResourceScopeRef.Instance).Value)}&context={Uri.EscapeDataString((extension.ScopeRef ?? provider!.ScopeRef ?? ResourceScopeRef.Instance).Value)}";
    private static string ToolUrl(ToolResource tool) => $"/tools/{Uri.EscapeDataString(tool.Name)}?namespace={Uri.EscapeDataString(tool.Namespace.Value)}&scopeRef={Uri.EscapeDataString((tool.ScopeRef ?? ResourceScopeRef.Instance).Value)}&context={Uri.EscapeDataString((tool.ScopeRef ?? ResourceScopeRef.Instance).Value)}";
    private string name = "", displayName = "", extensionId = "", command = "", arguments = "", workingDirectory = "", endpoint = "", environmentReferences = ""; private ResourceNamespace extensionNamespace = ResourceNamespace.Default; private bool enabled = true; private ToolProviderType providerType = ToolProviderType.Mcp; private McpToolProviderTransport transport = McpToolProviderTransport.Stdio;
    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        try
        {
            if (!IsNew)
            {
                var snapshot = ScopeRefValue is { Length: > 0 }
                    ? await Client.GetProviderAsync(ResourceScopeRef.Parse(ScopeRefValue), ResourceNamespace.Parse(NamespaceValue), Name!, default)
                    : await Client.GetProviderAsync(Name!, default);
                provider = snapshot.Value; selectedScope = provider.ScopeRef; etag = snapshot.ETag; From(provider);
                tools = selectedScope is { } scope ? await Client.GetToolsAsync(scope, provider.Name) : await Client.GetToolsAsync(provider.Name);
                tools = tools.Where(tool => tool.ScopeRef == provider.ScopeRef && tool.Namespace == provider.Namespace).ToArray();
            }
        }
        catch (Exception exception) { failed = true; message = exception.Message; }
        finally { loading = false; }
    }
    private void From(ToolProviderResource value) { name=value.Name; displayName=value.Definition.DisplayName; enabled=value.Definition.Enabled; providerType=value.Definition.ProviderType; extensionId=value.Definition.Aep?.Extension.Name??""; extensionNamespace=value.Definition.Aep?.Extension.Namespace??value.Namespace; transport=value.Definition.Mcp?.Transport??McpToolProviderTransport.Stdio; command=value.Definition.Mcp?.Command??""; arguments=string.Join(Environment.NewLine,value.Definition.Mcp?.Arguments??[]); workingDirectory=value.Definition.Mcp?.WorkingDirectory??""; endpoint=value.Definition.Mcp?.Endpoint?.ToString()??""; environmentReferences=string.Join(Environment.NewLine,(value.Definition.Mcp?.EnvironmentReferences??new Dictionary<string,string>()).Select(x=>$"{x.Key}={x.Value}")); }
    private ToolProviderProperties Properties() => new() { DisplayName=displayName, ProviderType=providerType, Enabled=enabled, Aep=providerType==ToolProviderType.Aep?new AepToolProviderConfiguration{Extension=new ResourceReference(extensionId,selectedScope,extensionNamespace)}:null, Mcp=providerType==ToolProviderType.Mcp?new McpToolProviderConfiguration{Transport=transport,Command=Null(command),Arguments=Lines(arguments),WorkingDirectory=Null(workingDirectory),Endpoint=Uri.TryCreate(endpoint,UriKind.Absolute,out var uri)?uri:null,EnvironmentReferences=Pairs(environmentReferences)}:null };
    private async Task SaveAsync() { busy=true; failed=false; message=null; try { if(IsNew){var saved=await Client.CreateProviderAsync(new(name,Properties(),selectedScope),default); Navigation.NavigateTo($"/tools/providers/{Uri.EscapeDataString(saved.Value.Name)}");}else{var saved=await Client.UpdateProviderAsync(Name!,new(Properties()),etag!,default);provider=saved.Value;selectedScope=provider.ScopeRef;etag=saved.ETag;tools=await Client.GetToolsAsync(provider.Name);message=provider.Definition.Discovery.Status=="connected"?T("SavedAndRefreshed"):T("SavedWithStatus",StatusLabel(provider.Definition.Discovery.Status));}}catch(Exception ex){failed=true;message=ex.Message;}finally{busy=false;} }
    private async Task TestAsync(){busy=true;try{var result=await Client.TestAsync(Name!,default);failed=false;message=T("ConnectionSucceeded",ToolCount(result.ToolCount));}catch(Exception ex){failed=true;message=ex.Message;}finally{busy=false;}}
    private async Task RefreshAsync(){busy=true;try{var diff=await Client.RefreshAsync(Name!,default);tools=await Client.GetToolsAsync(Name!);failed=false;message=T("DiscoverySummary",diff.Unchanged,diff.New,diff.Changed,diff.Unavailable);}catch(Exception ex){failed=true;message=ex.Message;}finally{busy=false;}}
    private async Task EnableAsync(ToolResource tool,bool value){await Client.SetEnabledAsync(tool.Name,value,null,default);tools=await Client.GetToolsAsync(Name!);}
    private static string? Null(string value)=>string.IsNullOrWhiteSpace(value)?null:value.Trim(); private static string[] Lines(string value)=>value.Split(['\r','\n'],StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries); private static IReadOnlyDictionary<string,string> Pairs(string value)=>Lines(value).Select(line=>line.Split('=',2)).Where(x=>x.Length==2).ToDictionary(x=>x[0].Trim(),x=>x[1].Trim(),StringComparer.Ordinal);
    private static UiStatus ProviderStatus(string? status) => status switch { "connected" => UiStatus.Success, "error" => UiStatus.Danger, _ => UiStatus.Neutral };
    private ProviderTab activeTab;
    private enum ProviderTab { Overview, Tools, Connection }
}
