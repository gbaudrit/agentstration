@page "/parameters/new"
@page "/parameters/{Name}"
@implements IDisposable
@inject IParametersClient Client
@inject NavigationManager Navigation
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<ParameterStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared

<UnsavedNavigationGuard IsDirty="@IsDirty" HasUnsavedChanges="@(() => IsDirty)" ViewQueryParameters="@(new[] { "view", "tab" })" />
<PageTitle>@(IsNew ? T("CreateParameter") : $"{Name} · {T("Parameter")}") · Agentstration</PageTitle>
@{
    RenderFragment feedback = @<div>
        @if (!IsNew && selectedScope is { } owner) { <InheritedResourceNotice OwnerScopeRef="owner" /> }
        @if (error is not null) { <div class="form-alert form-alert-danger" role="alert">@error.Message</div> }
        @if (usages.Count > 0) { <div class="form-alert form-alert-warning">@T("Referenced", usages.Count)</div> }
    </div>;
}
@if (loading) { <LoadingState Message="@T("Loading")" /> }
else if (!IsNew && savedResource is null) { @feedback }
else if (IsNew)
{
    <PageHeader Title="@T("CreateParameter")" Description="@T("Editor.Description")" TestId="resource-parameter-editor"><Actions><a class="button-secondary" href="/parameters">@T("Back")</a></Actions></PageHeader>
    @feedback
    <EditForm EditContext="FormContext" FormName="parameter-editor" class="resource-form" data-testid="parameter-form">
        <DataAnnotationsValidator /><FormDraftMonitor InvalidInputChanged="value => invalidInput = value" />
        <p class="required-fields-note"><span aria-hidden="true">*</span> @Shared["RequiredFields"]</p>
        <fieldset class="resource-definition-fields" disabled="@busy"><CreationWizard @ref="wizard" Steps="Steps" Busy="busy" OnFinish="FinishAsync" FinishLabel="@T("Save")" FinishTestId="parameter-save" /></fieldset>
    </EditForm>
}
else if (savedResource is not null)
{
    <ResourceDetailsTemplate Name="@savedResource.Definition.DisplayName" ResourceType="@T("Parameter")" Domain="parameter" IconName="settings"
                             TechnicalName="@savedResource.Name" Namespace="@savedResource.Namespace.Value" ScopeRef="savedResource.ScopeRef" Description="@savedResource.Definition.Description"
                             Sections="Sections" ResourceIdentity="@loadedKey" DefaultSection="overview" SelectionChanged="SelectSection" Feedback="@feedback" HasDraft="@IsDirty" TestId="resource-parameter-editor">
        <Metadata>@if (section == "definition/configuration") { <span class="required-fields-note"><span aria-hidden="true">*</span> @Shared["RequiredFields"]</span> }</Metadata>
        <Actions>@if (CanManage) { <button type="button" class="button-danger" @onclick="RequestDelete" disabled="@busy" data-testid="parameter-delete">@T("Delete")</button> }<a class="button-secondary" href="/parameters">@T("Back")</a></Actions>
        <Content>
            <div hidden="@(section != "overview")">
                <ResourceIdentitySummary DisplayName="@savedResource.Definition.DisplayName" TechnicalName="@savedResource.Name" Namespace="@savedResource.Namespace.Value" Description="@savedResource.Definition.Description"><Scope><ResourceScopeBadge ScopeRef="savedResource.ScopeRef" /></Scope></ResourceIdentitySummary>
                <FormSection Title="@Shared["Configuration"]" Class="resource-configuration-summary">
                    <CollectionView TItem="ConfigurationEntry" Items="SavedConfiguration" IdentityLabel="@Shared["Configuration"]" InformationLabels="@(new[] { T("Value") })">
                        <Identity Context="entry"><strong class="configuration-key">@entry.Label</strong></Identity>
                        <Information Context="entry"><CollectionValue Label="@T("Value")"><span class="configuration-value">@entry.Value</span></CollectionValue></Information>
                    </CollectionView>
                </FormSection>
            </div>
            <div hidden="@(!section.StartsWith("definition/", StringComparison.Ordinal))">
                <EditForm EditContext="FormContext" OnValidSubmit="SaveAsync" OnInvalidSubmit="InvalidSubmit" FormName="parameter-editor" id="parameter-resource-form" class="resource-form" data-testid="parameter-form">
                    <DataAnnotationsValidator /><FormDraftMonitor InvalidInputChanged="value => invalidInput = value" />
                    <fieldset class="resource-definition-fields" disabled="@(busy || !CanManage)">
                        <div hidden="@(section != "definition/configuration")">@IdentityFields @ConfigurationFields</div>
                        <div hidden="@(section != "definition/access")">@AccessFields</div>
                    </fieldset>
                </EditForm>
            </div>
            <div hidden="@(section != "usages")">@Usages</div>
        </Content>
        <DraftActions><button class="text-button" type="button" disabled="@busy" @onclick="Discard">@Shared["Discard"]</button><button type="submit" form="parameter-resource-form" class="button-primary" disabled="@busy" data-testid="parameter-save">@(busy ? T("Saving") : T("Save"))</button></DraftActions>
    </ResourceDetailsTemplate>
}
<ConfirmationDialog IsOpen="@confirmDelete" Title="@T("DeleteParameter")" Message="@T("DeleteMessage", Name ?? string.Empty)" ConfirmLabel="@T("Delete")" OnConfirm="DeleteAsync" OnCancel="() => confirmDelete = false" />

@code {
    private RenderFragment IdentityFields => @<FormSection Title="@T("Identity")"><ChildContent><FormGrid>
        <ResourceIdentityFields @bind-DisplayName="model.DisplayName" @bind-TechnicalName="model.Name" Policy="ResourceNamePolicy.Parameter" IsNew="@IsNew" DisplayNameTestId="parameter-display-name" TechnicalNameTestId="parameter-name" />
        <FormField Optional="true" Label="@T("Description")" Class="form-span-2"><ChildContent><ClearableText Multiline @bind-Value="model.Description" /></ChildContent><Validation><ValidationMessage For="() => model.Description" /></Validation></FormField>
        @if (IsNew) { <ResourceScopePicker Targets="scopeTargets" @bind-Value="selectedScope" /> } else { <label><span>@T("Scope")</span><ResourceScopeBadge ScopeRef="selectedScope" /></label> }
    </FormGrid></ChildContent></FormSection>;
    private RenderFragment ConfigurationFields => @<FormSection Title="@Shared["Configuration"]"><ChildContent>
        <div class="form-alert form-alert-info"><strong>@T("ReadableConfiguration")</strong><span>@T("SecretGuidance")</span></div>
        <FormGrid>
        <FormField Required="true" Label="@T("ValueType")"><ChildContent><ClearableSelect @bind-Value="model.ValueType" data-testid="parameter-value-type">@foreach (var type in Enum.GetValues<ParameterValueType>()) { <option value="@type">@T($"ValueType.{type}")</option> }</ClearableSelect></ChildContent><Validation><ValidationMessage For="() => model.ValueType" /></Validation></FormField>
        <FormField Required="true" Label="@T("Value")" Class="form-span-2"><ChildContent><ClearableText @bind-Value="model.Value" data-testid="parameter-value" /><small>@T("Value.Help")</small></ChildContent><Validation><ValidationMessage For="() => model.Value" /></Validation></FormField>
        </FormGrid>
    </ChildContent></FormSection>;
    private RenderFragment AccessFields => @<DescendantUseGrantEditor OwnerScopeRef="selectedScope" Targets="scopeTargets" Grants="model.UseGrants" />;
    private RenderFragment Review => @<FormSection Title="@Shared["Verification"]"><ChildContent><dl class="resource-details">
        <dt>@T("DisplayName")</dt><dd>@model.DisplayName</dd><dt>@T("Name")</dt><dd>@model.Name</dd><dt>@T("Scope")</dt><dd><ResourceScopeBadge ScopeRef="selectedScope" /></dd>
        <dt>@T("ValueType")</dt><dd>@T($"ValueType.{model.ValueType}")</dd><dt>@T("Value")</dt><dd class="resource-text">@model.Value</dd>
    </dl></ChildContent></FormSection>;
    private RenderFragment Usages => @<div>@if (usages.Count > 0) { <FormSection Title="@T("Usages")"><ul class="resource-links">@foreach (var usage in usages) { <li><CollectionIdentity DisplayName="@usage.DisplayName" Name="@usage.Name" Href="@usage.Url" IconName="layers" /><CollectionActions ResourceName="@usage.DisplayName"><a href="@usage.Url">@Shared["OpenItem"]</a></CollectionActions></li> }</ul></FormSection> }</div>;

    [Parameter] public string? Name { get; set; }
    [SupplyParameterFromQuery(Name = "scopeRef")] public string? ScopeRefValue { get; set; }
    private readonly CancellationTokenSource cancellation = new();
    private ParameterEditorModel model = new();
    private ParameterResource? savedResource;
    private EditContext? editContext;
    private EditContext FormContext => editContext is not null && ReferenceEquals(editContext.Model, model) ? editContext : editContext = new(model);
    private CreationWizard? wizard;
    private string section = "overview";
    private string? loadedKey;
    private long loadVersion;
    private bool loading;
    private bool CanManage => IsNew || savedResource is not null && !savedResource.Governance.IsManaged && ResourceOwnershipContext.CanManage(selectedScope, Services);
    private IReadOnlyList<ResourceScopeTargetResponse> scopeTargets = [];
    private IReadOnlyList<ParameterUsageResponse> usages = [];
    private ResourceScopeRef? selectedScope;
    private string? etag;
    private bool busy, confirmDelete;
    private Exception? error;
    private string savedFingerprint = string.Empty;
    private bool invalidInput;
    private string Fingerprint => JsonSerializer.Serialize(new { model, selectedScope });
    private bool IsDirty => !loading && CanManage && (Fingerprint != savedFingerprint || invalidInput);
    private bool IsNew => string.IsNullOrWhiteSpace(Name);
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    private IReadOnlyList<ResourceNavigationItem> Sections =>
    [
        new("overview", Shared["Overview"], "home"),
        new("definition", Shared["Definition"], "settings") { Navigable = false, Visible = CanManage },
        new("definition/configuration", Shared["Configuration"], "settings") { Visible = CanManage },
        new("definition/access", Shared["Access"], "key") { Visible = CanManage },
        new("usages", T("Usages"), "list-check") { Visible = usages.Count > 0 }
    ];
    private IReadOnlyList<CreationWizardStep> Steps =>
    [
        new("identity", T("Identity"), IdentityFields) { IsComplete = IdentityComplete },
        new("configuration", Shared["Configuration"], ConfigurationFields) { IsComplete = ValueComplete },
        new("access", Shared["Access"], AccessFields) { IsComplete = true },
        new("review", Shared["Verification"], Review) { IsComplete = IdentityComplete && ValueComplete }
    ];
    private bool IdentityComplete => selectedScope is not null && ValidIdentityField(nameof(model.Name), model.Name) && ValidIdentityField(nameof(model.DisplayName), model.DisplayName);
    private bool ValidIdentityField(string name, object value) => System.ComponentModel.DataAnnotations.Validator.TryValidateProperty(value, new(model) { MemberName = name }, null);
    private bool ValueComplete { get { try { return !string.IsNullOrWhiteSpace(model.Value) && model.Properties() is not null; } catch (ArgumentException) { return false; } } }
    private sealed record ConfigurationEntry(string Label, string Value);
    private IReadOnlyList<ConfigurationEntry> SavedConfiguration => savedResource is null ? [] :
        [new(T("ValueType"), T($"ValueType.{savedResource.Definition.ValueType}")), new(T("Value"), ParameterEditorModel.From(savedResource).Value)];
    private void SelectSection(string? path) => section = path ?? "overview";
    private void InvalidSubmit(EditContext _)
    {
        section = "definition/configuration";
        Navigation.NavigateTo(Navigation.Uri.Split('#')[0] + "#" + section);
    }
    private async Task FinishAsync(CreationWizardFinish finish)
    {
        if (!FormContext.Validate() || selectedScope is null || !ValueComplete)
        {
            finish.ReturnToStepId = !IdentityComplete ? "identity" : "configuration";
            if (IdentityComplete && !ValueComplete) error = new ArgumentException(T("Value.Help"));
            return;
        }
        await SaveAsync();
    }
    private void Discard()
    {
        if (busy || savedResource is null) return;
        model = ParameterEditorModel.From(savedResource); selectedScope = savedResource.ScopeRef;
        invalidInput = false; savedFingerprint = Fingerprint; error = null;
    }
    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Name}|{ScopeRefValue}|{ResourceOwnershipContext.TryGetCurrent(Services)}";
        if (loadedKey == key) return;
        loadedKey = key;
        var version = ++loadVersion;
        loading = true; error = null; savedResource = null; usages = []; section = "overview";
        try
        {
            var targets = await Client.GetScopeTargetsAsync(cancellation.Token);
            if (version != loadVersion) return;
            scopeTargets = targets;
            if (IsNew) { model = new(); selectedScope = scopeTargets.FirstOrDefault(target => target.Kind == ResourceScopeKind.Workspace && target.CanWrite)?.ScopeRef ?? scopeTargets.FirstOrDefault(target => target.CanWrite)?.ScopeRef; return; }
            var scope = ResourceScopeRef.Parse(ScopeRefValue ?? throw new ArgumentException(T("ScopeRequired")));
            var snapshot = await Client.GetParameterAsync(Name!, scope, cancellation.Token);
            var references = (await Client.GetParameterUsagesAsync(Name!, scope, cancellation.Token)).Value;
            if (version != loadVersion) return;
            savedResource = snapshot.Value; model = ParameterEditorModel.From(snapshot.Value);
            selectedScope = snapshot.Value.ScopeRef; etag = snapshot.ETag; usages = references;
        }
        catch (Exception exception) { if (version == loadVersion) { error = exception; loadedKey = null; } }
        finally { if (version == loadVersion) { savedFingerprint = Fingerprint; invalidInput = false; loading = false; } }
    }
    private async Task SaveAsync()
    {
        if (!CanManage) return;
        if (selectedScope is null) { error = new ArgumentException(T("ScopeRequired")); return; }
        if (busy) return;
        busy = true; error = null;
        try
        {
            var snapshot = IsNew
                ? await Client.CreateParameterAsync(new(model.Name, model.Properties(), selectedScope), cancellation.Token)
                : await Client.UpdateParameterAsync(model.Name, selectedScope.Value, new(model.Properties()), etag!, cancellation.Token);
            savedFingerprint = Fingerprint; invalidInput = false;
            if (IsNew) Navigation.NavigateTo(ResourceUrl(snapshot.Value));
            else { savedResource = snapshot.Value; model = ParameterEditorModel.From(snapshot.Value); etag = snapshot.ETag; savedFingerprint = Fingerprint; }
        }
        catch (Exception exception) { error = exception; }
        finally { busy = false; }
    }
    private void RequestDelete() { if (!CanManage) return; if (usages.Count > 0) error = new AgentstrationApiException(T("InUse", usages.Count), Guid.NewGuid().ToString("N")); else confirmDelete = true; }
    private async Task DeleteAsync() { if (!CanManage) return; confirmDelete = false; try { await Client.DeleteParameterAsync(model.Name, selectedScope!.Value, etag!, cancellation.Token); savedFingerprint = Fingerprint; invalidInput = false; Navigation.NavigateTo("/parameters"); } catch (Exception exception) { error = exception; } }
    private string ResourceUrl(ParameterResource resource) => ResourceOwnershipContext.Resource(Services, "/parameters", resource.Name, resource.Namespace, resource.ScopeRef);
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
