                        </details></CollectionValue>
                </Information>
            </CollectionView>
        }
        @if (CanManage)
        {
            <FormGrid><FormField Label="@T("Version")"><ClearableText @bind-Value="version" Disabled="@(busy || !interactive)" data-testid="knowledge-tool-exposure-version" /></FormField><label class="resource-enabled-toggle" data-testid="knowledge-source-approval-option"><FormCheckbox role="switch" @bind-Value="requiresApproval" disabled="@(busy || !interactive)" /><span class="knowledge-choice-icon"><UiIcon Name="shield" /></span><span><strong>@T("RequireApproval")</strong><small>@T("RequireApprovalHelp")</small></span></label></FormGrid>
            <div class="form-actions"><button class="button-primary" type="button" @onclick="PublishAsync" data-testid="knowledge-publish-tools" disabled="@(!CanPublishTools)">@(busy ? T("Publishing") : T(exposure is null ? "PublishExposure" : "PublishNewExposureVersion"))</button></div>
            @if (!readiness.Ready) { <p class="inline-warning">@T("ReadyRequired")</p> }
            @if (exposure is not null && string.Equals(version.Trim(), exposure.ToolSetVersion, StringComparison.Ordinal)) { <p class="inline-warning">@T("NewExposureVersionRequired")</p> }
        }
        @if (exposure is not null)
        {
            <CollectionView TItem="KnowledgeSourceToolOperationExposure" Items="exposure.Operations" InformationLabels="@(new string[] { T("Capability"), T("Route"), T("Tool") })" IdentityLabel="@T("Operation")">
        <Identity Context="operation">
@OperationLabel(operation.Operation)</Identity>
        <Information Context="operation">
            <CollectionValue Label="@T("Capability")"><code>@operation.Capability</code></CollectionValue>
            <CollectionValue Label="@T("Route")"><code>@operation.Route</code></CollectionValue>
            <CollectionValue Label="@T("Tool")"><a class="resource-name-link knowledge-tool-link" href="@ToolUrl(operation.Tool)" data-testid="knowledge-tool-link"><strong>@operation.Tool.Name</strong><span>@ToolNamespace(operation.Tool)</span></a></CollectionValue>
        </Information>
    </CollectionView>
            <p class="resource-hint">@T("PinnedSourceHelp")</p>
        }
        </ChildContent></FormSection> }</div>;
}
