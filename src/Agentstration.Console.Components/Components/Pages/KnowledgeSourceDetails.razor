    private string ProposalIssueLabel(string issue) => T(issue switch
    {
        "knowledge_source_tool_set_conflict" or "knowledge_source_tool_definition_conflict" => "ToolIssue.NameConflict",
        "knowledge_contribution_unresolved" => "ToolIssue.UnresolvedContribution",
        "knowledge_contribution_evidence_unavailable" => "ToolIssue.MissingEvidence",
        "knowledge_contribution_no_published_members" => "ToolIssue.NoMembers",
        "knowledge_contribution_text_unsupported" => "ToolIssue.TextUnsupported",
        "knowledge_read_unsupported" => "ToolIssue.ReadDenied",
        "knowledge_documents_unavailable" => "ToolIssue.DocumentsUnavailable",
        "knowledge_contribution_query_unsupported" => "ToolIssue.QueryUnsupported",
        _ => "ToolIssue.Unavailable"
    });
    private static string FormatSize(long length) => length < 1024
        ? $"{length:N0} B"
        : length < 1024 * 1024
            ? $"{length / 1024d:N1} KiB"
            : $"{length / (1024d * 1024d):N1} MiB";
    private string FlowRunUrl(string flowRunId, ResourceScopeRef? executionScope, ResourceScopeRef? logicalScope = null)
    {
        var url = $"/flow-runs/{Uri.EscapeDataString(flowRunId)}";
        if (executionScope is not null) url += $"?scopeRef={Uri.EscapeDataString(executionScope.Value.Value)}";
        var context = logicalScope ?? ResourceOwnershipContext.TryGetCurrent(Services);
        if (context is not null) url += $"{(executionScope is null ? "?" : "&")}context={Uri.EscapeDataString(context.Value.Value)}";
        return url;
    }
    private static string SnapshotArtifactUrl(KnowledgeSnapshotArtifact value, KnowledgeSnapshotResource snapshot) =>
        value.Content is { } content
            ? $"/artifacts/durable/{ArtifactStorageReferences.Identity(new(snapshot.ScopeRef!.Value.TargetId!.Value), ArtifactStorageReferences.PublicationIdentity(content))}"
            : $"/artifacts/durable/{Uri.EscapeDataString(value.ArtifactId)}";
    private static string ArtifactOptionLabel(KnowledgeSnapshotArtifact value) =>
        $"{ShortIdentifier(value.ArtifactId)} · {value.MediaType} · {FormatSize(value.Length)}";
    private string TransformationLabel(KnowledgeDataSourceBindingReadiness binding)
    {
        var sequence = source?.Composition?.InputCompositions.GetValueOrDefault(binding.Name)?.Receipt?.Bindings.GetValueOrDefault("transformations")
            ?? source?.Definition.DataSources.FirstOrDefault(value => value.Name == binding.Name)?.Transformations ?? [];
        if (sequence.Count > 0)
            return string.Join(" → ", sequence.Select(call => call.Function is { } function ? $"{function.Namespace ?? source!.Namespace}/{function.Name}:{function.Version}" : $"{call.Flow!.Namespace ?? source!.Namespace}/{call.Flow.ResourceId}:{call.Flow.Version ?? "—"}"));
        return binding.Transformation is { } flow ? $"{flow.Namespace}/{flow.Name}:{flow.Version}" : T("IdentityTransformation");
    }
    private static string FlowIdentity(ResolvedKnowledgeFlowBinding value) => $"{value.Namespace} · {value.Version}";
    private string FlowUrl(ResolvedKnowledgeFlowBinding value) => ResourceOwnershipContext.Resource(Services, "/flows", value.Name, value.Namespace, value.ScopeRef);
    private static string DataSourceUrl(KnowledgeProjectionInputEvidence value) =>
        $"/data-sources/{Uri.EscapeDataString(value.DataSourceName)}?namespace={Uri.EscapeDataString(value.DataSourceNamespace.Value)}&scopeRef={Uri.EscapeDataString(value.DataSourceScopeRef.Value)}";
    private static string ArtifactUrl(KnowledgeProjectionArtifact value) => value.Kind == KnowledgeArtifactKind.Durable
        ? $"/artifacts/durable/{Uri.EscapeDataString(value.ArtifactId)}"
        : $"/artifacts/staged/{Uri.EscapeDataString(value.ArtifactId)}";
    private string ToolUrl(ResourceReference value)
    {
        var address = value.Resolve(SourceNamespace, ToolResourceKinds.Tool);
        return ScopedToolUrl(address.Namespace.IsDefault
            ? $"/tools/{Uri.EscapeDataString(address.Name)}"
            : $"/tools/{Uri.EscapeDataString(address.Name)}?namespace={Uri.EscapeDataString(address.Namespace.Value)}", value.ScopeRef);
    }
    private string ScopedToolUrl(string url, ResourceScopeRef? scope)
    {
        if (scope is null) return url;
        url += $"{(url.Contains('?') ? "&" : "?")}scopeRef={Uri.EscapeDataString(scope.Value.Value)}";
        var context = ResourceOwnershipContext.TryGetCurrent(Services) ?? scope.Value;
        return url + $"&context={Uri.EscapeDataString(context.Value)}";
    }
    private string ToolNamespace(ResourceReference value) => value.Resolve(SourceNamespace, ToolResourceKinds.Tool).Namespace.Value;
    public async ValueTask DisposeAsync()
    {
        disposed = true; sourceRevision++;
        await cancellation.CancelAsync();
