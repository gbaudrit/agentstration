@page "/knowledge-sources/{Name}"
@implements IAsyncDisposable
@inject IKnowledgeSourcesClient Client
@inject IFlowApiClient Flows
@inject TimeProvider Clock
@inject NavigationManager Navigation
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<KnowledgeSourcesStrings> Localizer

<PageTitle>@(source?.Definition.DisplayName ?? Name) · Agentstration</PageTitle>
@{ var presentations = Presentations; }
<ConsoleResourceDetailsTemplate CollectionHref="/knowledge-sources" CollectionLabel="@T("Title")" Resource="source" RequestedAddress="@ResourceAddress.Create(SourceNamespace, KnowledgeResourceKinds.KnowledgeSource, Name)"
    ResourceIdentity="@($"{loadedKey}|{source?.Uid}")" Name="@(source?.Definition.DisplayName ?? Name)" ResourceType="@T("KnowledgeSource")" Domain="knowledge" IconName="database"
    Description="@source?.Definition.Description" SectionState="sectionState" SectionPresentations="presentations" AdditionalSections="BusinessSections" LoadState="loadState"
    OnRetry="RefreshResourceAsync" OnRefresh="RefreshResourceAsync" HasDraft="HasDraft" HasAdditionalDraft="businessTouched" Busy="@(busy || resourceRefreshing)"
    DefinitionReadOnlyReason="@(CanEdit ? null : ResourceReadOnlyReason.InsufficientPermissions)" Feedback="Feedback"
    Enabled="source?.Definition.Enabled" EnabledChanged="ToggleEnabledAsync" EnabledDisabled="@(!CanEdit || busy || resourceRefreshing)" EnabledTestId="knowledge-source-enabled"
    Yaml="@rawYaml" YamlChanged="value => rawYaml = value" YamlReadOnly="@(!CanEdit || DefinitionDirty)" YamlError="@rawError" YamlInputTestId="knowledge-source-yaml-source"
    YamlTitle="@T("KnowledgeSourceYaml")" YamlDescription="@T("KnowledgeSourceYamlHelp")" TestId="resource-knowledge-source-details" SectionTestIdPrefix="knowledge-source">
    <Actions>@if (CanEdit) { <button class="button-danger" type="button" disabled="@busy" data-testid="knowledge-source-delete" @onclick="() => confirmDelete = true">@T("Delete")</button> }</Actions>
    <OverviewMetrics>@if (source is not null && readiness is not null) {         <section class="metric-grid" aria-label="@T("Readiness")">
            <MetricCard Label="@T("Readiness")" Value="@T(readiness.Ready ? "Ready" : "NotReady")" Detail="@(IsUnresolvedDraft ? T("DisabledDraftNotReady") : readiness.Issues.Count == 0 ? T("NoIssues") : string.Join(" · ", readiness.Issues))" Status="@(readiness.Ready ? UiStatus.Success : UiStatus.Warning)" />
            <MetricCard Label="@T("Generation")" Value="@source.Generation.ToString()" Detail="@T(source.Definition.Enabled ? "Enabled" : "Disabled")" Status="@(source.Definition.Enabled ? UiStatus.Info : UiStatus.Warning)" />
            <MetricCard Label="@T("ActiveSnapshot")" Value="@(ActiveSnapshot is null ? T("None") : ShortMetricIdentifier(ActiveSnapshot.Snapshot.Name))" Detail="@T("SnapshotCount", snapshots.Count)" HelpText="@ActiveSnapshot?.Snapshot.Name" Status="@(ActiveSnapshot is null ? UiStatus.Warning : UiStatus.Success)" Url="@(ActiveSnapshot is null ? null : SnapshotsUrl)" />
            <MetricCard Label="@T("ToolExposure")" Value="@(exposure is null ? T("NotPublished") : exposure.ToolSetVersion)" Detail="@(exposure is null ? T("ExposureHelp") : $"{exposure.ToolSet.Name} · {exposure.Operations.Count} {T("Operations")}")" Status="@(exposure is null ? UiStatus.Neutral : UiStatus.Success)" />
        </section> }</OverviewMetrics>
    <OverviewConfiguration><CollectionView TItem="KeyValuePair<string,string>" Items="SavedSettings" IdentityLabel="@T("SettingName")" InformationLabels="@(new[] { T("SettingValue") })"><Identity Context="row"><strong class="configuration-key">@row.Key</strong></Identity><Information Context="row"><CollectionValue Label="@T("SettingValue")"><span class="configuration-value">@row.Value</span></CollectionValue></Information></CollectionView></OverviewConfiguration>
    <OverviewContent>@if (source is not null && readiness is not null) {
        <section class="panel form-section knowledge-flow-composition">
            <div class="panel-header"><div><p class="eyebrow">@T("FlowBindings")</p><h2>@T("ResolvedFlows")</h2><p>@T("ResolvedFlowsHelp")</p></div></div>
            <div class="knowledge-flow-grid">
                @if (readiness.Projection is { } projection)
                {
                    <a class="knowledge-flow-card" href="@FlowUrl(projection)" data-testid="knowledge-projection-flow-link"><span class="knowledge-composition-icon"><UiIcon Name="workflow" /></span><span><small>@T("ProjectionFlow")</small><strong>@projection.Name</strong><code>@FlowIdentity(projection)</code></span><UiIcon Name="arrow-right" /></a>
                }
                @if (readiness.Retrieval is { } retrieval)
                {
                    <a class="knowledge-flow-card" href="@FlowUrl(retrieval)" data-testid="knowledge-retrieval-flow-link"><span class="knowledge-composition-icon"><UiIcon Name="search" /></span><span><small>@T("RetrievalFlow")</small><strong>@retrieval.Name</strong><code>@FlowIdentity(retrieval)</code></span><UiIcon Name="arrow-right" /></a>
                }
            </div>
            @if (readiness.DataSources is { Count: > 0 } inputReadiness)
            {
                <CollectionView TItem="KnowledgeDataSourceBindingReadiness" Items="inputReadiness" InformationLabels="@(new string[] { T("DataSource"), T("TransformationFlowOptional") })" IdentityLabel="@T("BindingName")" StateLabel="@T("State")">
        <Identity Context="item">
<strong>@item.Name</strong></Identity>
        <State Context="item">
<StatusBadge Text="@T(item.Ready ? "Ready" : "NotReady")" Status="@(item.Ready ? UiStatus.Success : UiStatus.Warning)" />@if (item.Issue is not null) { <small>@(IsUnresolvedDraft ? T("DisabledDraftNotReady") : item.Issue)</small> }</State>
        <Information Context="item">
            <CollectionValue Label="@T("DataSource")"><code>@(item.DataSourceUid?.ToString("D") ?? "—")</code></CollectionValue>
            <CollectionValue Label="@T("TransformationFlowOptional")">@TransformationLabel(item)</CollectionValue>
        </Information>
    </CollectionView>
            }
        </section> }</OverviewContent>
    <DefinitionContent Context="path"><KnowledgeSourceEditor @ref="editor" Name="@Name" Namespace="@Namespace" ScopeRef="@ScopeRef" Embedded="true" Snapshot="snapshot" SectionState="sectionState" SectionPresentations="presentations"
        SectionRequested="ShowSection" DraftChanged="value => definitionDirty = value" ReadOnly="@(!CanEdit || resourceRefreshing)" Saved="SourceProjectionSaved" ResourceUnavailable="EditorUnavailable" DiscardRevision="discardRevision" /></DefinitionContent>
    <AdditionalContent Context="path"><div @oninput="() => businessTouched = true" @onchange="() => businessTouched = true">@BusinessContent(path)</div></AdditionalContent>
    <DraftActions><button class="text-button" type="button" disabled="@(busy || resourceRefreshing)" @onclick="DiscardAsync">@T("DiscardDraft")</button>
        @if (sectionState.Is("yaml")) { <button class="button-primary" type="button" data-testid="knowledge-source-yaml-save" @onclick="SaveRawAsync" disabled="@(busy || DefinitionDirty || !CanEdit)">@T("SaveYaml")</button> }
        else { <button class="button-primary" type="submit" form="knowledge-source-definition" disabled="@(busy || !CanEdit)">@T("Save")</button> }
    </DraftActions>
</ConsoleResourceDetailsTemplate>
<ConfirmationDialog IsOpen="@confirmDelete" Title="@T("DeleteSource")" Message="@T("DeleteSourceHelp")" ConfirmLabel="@T("ConfirmDelete")" OnConfirm="DeleteAsync" OnCancel="() => confirmDelete = false" TestId="knowledge-source-delete-dialog" />

@code {
    [Parameter] public string Name { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "namespace")] public string? Namespace { get; set; }
    [SupplyParameterFromQuery(Name = "scopeRef")] public string? ScopeRef { get; set; }
    private readonly CancellationTokenSource cancellation = new();
    private KnowledgeSourceResource? source;
    private KnowledgeSourceReadiness? readiness;
    private KnowledgeSourceToolExposureResource? exposure;
    private KnowledgeSourceToolProposal? toolProposal;
    private bool refreshingTools;
    private string? proposalError;
    private IReadOnlyList<KnowledgeProjectionResource> projections = [];
    private KnowledgeProjectionResource? selectedProjection;
    private IReadOnlyList<KnowledgeSnapshotView> snapshots = [];
    private KnowledgeSnapshotView? selectedSnapshot;
    private readonly SemaphoreSlim projectionRefreshGate = new(1, 1);
    private Task polling = Task.CompletedTask;
    private int sourceRevision;
    private bool projectionStarting, refreshingProjections;
    private string? projectionRequestId, projectionRefreshError;
    private DateTimeOffset? projectionStartedAt;
    private FlowRun? projectionRun, projectionFailureRun;
    private IReadOnlyList<FlowRun> activeProjectionRuns = [], projectionFailureOrigins = [];
    private string? projectionFailureCode, projectionFailureDetails, projectionFailureMessage;
    private KnowledgeProjectionResource? LiveProjection => projections.FirstOrDefault(value => value.IdempotencyKey == projectionRequestId && projectionRequestId is not null)
        ?? projections.FirstOrDefault(value => IsActiveProjection(value.State));
    private bool HasActiveProjection => projections.Any(value => IsActiveProjection(value.State));
    private static bool IsActiveProjection(KnowledgeProjectionState state) => state is KnowledgeProjectionState.Pending or KnowledgeProjectionState.Running or KnowledgeProjectionState.WaitingForChild or KnowledgeProjectionState.WaitingForInput;
    private string ProjectionProgressLabel => LiveProjection is null ? T("ProjectionStarting")
        : projectionRun?.Status == FlowRunStatus.Succeeded ? T("ProjectionPublishing")
        : projectionRun is not null ? T("ProjectionRunning")
        : LiveProjection.Inputs.Count == 0 ? T("ProjectionAcquiring") : T("ProjectionPreparing");
    private bool loading = true, busy, failed, requiresApproval, confirmDelete, interactive, projectionParametersValid = true;

    private string version = "1.0.0",
        rawYaml = string.Empty;
    private JsonElement projectionParameters = JsonSerializer.SerializeToElement(new { });
    private string? etag, message, rawError;
    private ResourceNamespace SourceNamespace => Agentstration.Resources.ResourceNamespace.Parse(Namespace);
    private bool CanManage => source is not null && ResourceOwnershipContext.CanManage(source.ScopeRef, Services);
    private bool CanPublishTools => interactive && CanManage && readiness?.Ready == true && toolProposal?.Ready == true && !busy && !refreshingTools && !string.IsNullOrWhiteSpace(version)
        && (exposure is null || !string.Equals(version.Trim(), exposure.ToolSetVersion, StringComparison.Ordinal));
    private string ToolSetUrl => exposure is null ? "/tools/sets" : ScopedToolUrl(
        exposure.ToolSet.Resolve(SourceNamespace, ToolResourceKinds.ToolSet).Namespace.IsDefault
            ? $"/tools/sets/{Uri.EscapeDataString(exposure.ToolSet.Name)}"
            : $"/tools/sets/{Uri.EscapeDataString(exposure.ToolSet.Name)}?namespace={Uri.EscapeDataString((exposure.ToolSet.Namespace ?? SourceNamespace).Value)}", exposure.ToolSet.ScopeRef);
    private bool IsUnresolvedDraft => source is { Definition.Enabled: false, Composition: null };
    private bool CanStartProjection => interactive && readiness?.Ready == true && projectionParametersValid && !busy && !HasActiveProjection;
    private JsonElement? ProjectionParametersSchema => JsonSchemaInputSchema.ObjectProperty(
        readiness?.Projection?.InputSchema, "parameters");
    private KnowledgeSnapshotView? ActiveSnapshot => snapshots.FirstOrDefault(value => value.LifecycleState == KnowledgeSnapshotLifecycleState.Active);
    private string SnapshotsUrl => SectionUrl("snapshots");
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    protected override void OnInitialized() => polling = PollProjectionsAsync();
    private async Task PollProjectionsAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1), Clock);
        try
        {
            while (await timer.WaitForNextTickAsync(cancellation.Token))
                if (interactive && !loading && source is not null && (projectionStarting || HasActiveProjection || sectionState.Is("projections")))
                    await InvokeAsync(() => RefreshProjectionStatusAsync(false));
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (destination is { } url) { destination = null; Navigation.NavigateTo(url); }
        if (firstRender) { interactive = true; StateHasChanged(); }
        if (pendingYamlProperties is { } properties && editor is not null) { pendingYamlProperties = null; await editor.ApplyDefinitionAsync(properties, yamlEtag!); }
    }
    private readonly ResourceSectionState sectionState = new();
    private KnowledgeSourceEditor? editor;
    private ResourceSnapshot<KnowledgeSourceResource>? snapshot, newerSnapshot;
    private string? loadedKey, yamlEtag, destination;
    private string yamlBaseline = "";
    private bool definitionDirty, resourceRefreshing, businessTouched, disposed;
    private int discardRevision;
    private ResourceLoadState loadState = new(ResourceLoadStatus.Loading);
    private bool DefinitionDirty => definitionDirty || editor?.HasDraft == true;
    private bool YamlDirty => rawYaml != yamlBaseline;
    private bool HasDraft => source is not null && (DefinitionDirty || YamlDirty);
    private bool CanEdit => CanManage && source is { Governance.IsManaged: false };
    private IKnowledgeSourcesClient ScopedClient => Client.WithOwner(source?.ScopeRef ?? (ResourceScopeRef.TryParse(ScopeRef, out var owner) ? owner : null));
    private IReadOnlyDictionary<string, ResourceSectionPresentation> Presentations
    {
        get
        {
            var sections = KnowledgeSourceEditor.DefinitionPresentations(!CanEdit).ToDictionary();
            sections["yaml"] = new() { ReadOnly = !CanEdit || DefinitionDirty, Actions = YamlActions, ReadOnlyActions = DefinitionDirty ? ReturnToDefinition : null };
            return sections;
        }
    }
    private RenderFragment YamlActions => @<button class="button-secondary" type="button" @onclick="ApplyRawYamlAsync" disabled="@(busy || resourceRefreshing || DefinitionDirty || !CanEdit)">@T("ApplyToForm")</button>;
    private RenderFragment ReturnToDefinition => @<button class="button-secondary" type="button" @onclick='() => ShowSection("definition/identity")' >@T("Tab.Definition")</button>;
    private IReadOnlyList<ResourceNavigationItem> BusinessSections => [new("projections", T("Tab.Projections"), "git-branch"), new("snapshots", T("Tab.Snapshots"), "archive"), new("retrieval", T("Tab.Retrieval"), "search"), new("tools", T("Tab.Tools"), "tool")];
    private string SectionUrl(string path) => Navigation.Uri.Split('#')[0] + "#" + path;
    private void ShowSection(string path) => Navigation.NavigateTo(SectionUrl(path));
    private IReadOnlyList<KeyValuePair<string,string>> SavedSettings => source is null ? [] : [new(T("Enabled"), T(source.Definition.Enabled ? "Enabled" : "Disabled")), new(T("ProjectionFlow"), FlowLabel(source.Definition.ProjectionFlow)), new(T("NativeLegacyRetrieval"), FlowLabel(source.Definition.RetrievalFlow)), new(T("ProjectionParameters"), source.Definition.ProjectionParameters.GetRawText()), new(T("OutputStorage"), source.Definition.Output is { } output ? $"{output.Storage.Storage.Namespace}/{output.Storage.Storage.Name} · {output.Storage.Storage.ScopeRef} · g{output.Storage.Generation}" : T("ArtifactOutputDefault"))];
    private string FlowLabel(KnowledgeFlowTarget? target) => target is null ? "—" : $"{target.Namespace ?? source!.Namespace}/{target.Name}:{target.Version ?? "active"} · {target.ScopeRef}";
    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Name}|{Namespace}|{ScopeRef}|{new Uri(Navigation.Uri).Query}";
        if (loadedKey == key) return;
        loadedKey = key; ClearPrivate(); loading = true; loadState = new(ResourceLoadStatus.Loading);
        await ReadResourceAsync(false);
    }
    private Task RefreshResourceAsync() => resourceRefreshing || busy ? Task.CompletedTask : ReadResourceAsync(true);
    private async Task ReadResourceAsync(bool refresh)
    {
        var revision = sourceRevision;
        resourceRefreshing = refresh;
        if (refresh && source is not null) loadState = new(ResourceLoadStatus.Refreshing) { HasContent = true };
        try
        {
            var current = await ScopedClient.GetAsync(SourceNamespace, Name, cancellation.Token);
            if (revision != sourceRevision || disposed) return;
            if (current.Value.Name != Name || current.Value.Namespace != SourceNamespace || current.Value.ScopeRef is null
                || ResourceScopeRef.TryParse(ScopeRef, out var requested) && requested != current.Value.ScopeRef
                || source is not null && (source.Uid != current.Value.Uid || source.ScopeRef != current.Value.ScopeRef))
            { ClearPrivate(); loading = false; loadState = new(ResourceLoadStatus.NotFound) { Message = T("IdentityChanged") }; return; }
            var client = Client.WithOwner(current.Value.ScopeRef);
            var readinessTask = client.GetReadinessAsync(SourceNamespace, Name, cancellation.Token);
            var exposureTask = client.GetExposureAsync(SourceNamespace, Name, cancellation.Token);
            var projectionsTask = client.GetProjectionsAsync(SourceNamespace, Name, cancellation.Token);
            var snapshotsTask = client.GetSnapshotsAsync(SourceNamespace, Name, cancellation.Token);
            await Task.WhenAll(readinessTask, exposureTask, projectionsTask, snapshotsTask);
            if (revision != sourceRevision || disposed) return;
            var first = source is null;
            if (refresh && HasDraft && snapshot?.ETag != current.ETag) newerSnapshot = current;
            Adopt(current);
            readiness = await readinessTask; exposure = await exposureTask;
            if (first) version = exposure is null ? "1.0.0" : NextExposureVersion(exposure.ToolSetVersion);
            var selectedName = selectedProjection?.Name;
            projections = (await projectionsTask).OrderByDescending(value => value.CreatedAt).ToArray();
            selectedProjection = projections.FirstOrDefault(value => value.Name == selectedName) ?? projections.FirstOrDefault();
            snapshots = (await snapshotsTask).OrderByDescending(value => value.Snapshot.PublishedAt).ToArray();
            selectedSnapshot = snapshots.FirstOrDefault(value => value.Snapshot.Name == selectedSnapshot?.Snapshot.Name) ?? snapshots.FirstOrDefault();
            await RefreshToolsAsync();
            if (revision == sourceRevision) loadState = new(ResourceLoadStatus.Ready) { HasContent = true };
        }
        catch (OperationCanceledException) when (disposed || cancellation.IsCancellationRequested) { }
        catch (Exception exception)
        {
            if (revision != sourceRevision || disposed) return;
            var failure = Failure(exception);
            if (failure.Status is ResourceLoadStatus.Forbidden or ResourceLoadStatus.NotFound) ClearPrivate();
            loadState = failure with { HasContent = source is not null };
        }
        finally { if (!disposed) { loading = false; resourceRefreshing = false; } }
    }
    private static ResourceLoadState Failure(Exception exception) => new(exception is AgentstrationApiException api ? api.StatusCode switch
    { System.Net.HttpStatusCode.Forbidden or System.Net.HttpStatusCode.Unauthorized => ResourceLoadStatus.Forbidden, System.Net.HttpStatusCode.NotFound => ResourceLoadStatus.NotFound, _ => ResourceLoadStatus.Failed } : ResourceLoadStatus.Failed);
    private void Adopt(ResourceSnapshot<KnowledgeSourceResource> current)
    {
        var keepYaml = YamlDirty;
        source = current.Value; snapshot = current; etag = current.ETag;
        if (!keepYaml) { rawYaml = yamlBaseline = ResourceManifestSerializer.ToYaml(RawResource()); yamlEtag = current.ETag; rawError = null; }
    }
    private void ClearPrivate()
    {
        sourceRevision++; source = null; snapshot = newerSnapshot = null; editor = null; readiness = null; exposure = null; toolProposal = null;
        projections = []; snapshots = []; selectedProjection = null; selectedSnapshot = null; projectionParameters = JsonSerializer.SerializeToElement(new { });
        projectionRun = projectionFailureRun = null; activeProjectionRuns = projectionFailureOrigins = []; projectionFailureCode = projectionFailureDetails = projectionFailureMessage = null;
        rawYaml = yamlBaseline = ""; yamlEtag = etag = rawError = message = proposalError = null; definitionDirty = businessTouched = false;
        version = "1.0.0"; requiresApproval = false; pendingYamlProperties = null; projectionRequestId = projectionRefreshError = null; projectionStartedAt = null;
    }
    private async Task DiscardAsync()
    {
        if (source is null || busy || resourceRefreshing) return;
        rawYaml = yamlBaseline = ResourceManifestSerializer.ToYaml(RawResource()); yamlEtag = etag; rawError = null;
        definitionDirty = false; newerSnapshot = null; discardRevision++;
        if (editor is not null) await editor.DiscardAsync();
    }
    private void EditorUnavailable(Exception exception) { ClearPrivate(); loadState = Failure(exception); }
    private async Task SourceProjectionSaved(KnowledgeSourceResource saved)
    {
        if (source is null || saved.Uid != source.Uid || saved.ScopeRef != source.ScopeRef) return;
        var revision = sourceRevision;
        definitionDirty = false;
        await ReadResourceAsync(true);
        if (revision == sourceRevision && source is not null) { message = T("SourceSaved"); failed = false; }
    }
    private KnowledgeSourceProperties? ReadYaml()
    {
        rawError = null;
        try
        {
            var manifest = ResourceManifestSerializer.FromYaml<KnowledgeSourceManifest>(rawYaml);
            if (KnowledgeSourceDetailsModel.IdentityError(manifest, source!) is { } key)
                throw new ArgumentException(T(key, key == "ApiVersionRequired" ? ResourceApiVersions.CoreV1 : KnowledgeResourceKinds.KnowledgeSource));
            return manifest.Definition;
        }
        catch (Exception exception) { rawError = exception.Message; return null; }
    }
    private async Task ApplyRawYamlAsync()
    {
        if (!CanEdit || DefinitionDirty || busy || ReadYaml() is not { } properties) return;
        sectionState.Visit("definition/identity"); sectionState.Visit("definition/configuration");
        pendingYamlProperties = properties;
        ShowSection("definition/identity");
        await InvokeAsync(StateHasChanged);
    }
    private KnowledgeSourceProperties? pendingYamlProperties;
    private async Task SaveRawAsync()
    {
        if (!CanEdit || DefinitionDirty || busy || ReadYaml() is not { } properties) return;
        var revision = sourceRevision; busy = true; failed = false;
        try
        {
            var saved = await ScopedClient.UpdateAsync(SourceNamespace, Name, new PutKnowledgeSourceRequest(properties), yamlEtag!, cancellation.Token);
            if (revision != sourceRevision || disposed) return;
            rawYaml = yamlBaseline = ""; Adopt(saved); newerSnapshot = null;
            var currentReadiness = await ScopedClient.GetReadinessAsync(SourceNamespace, Name, cancellation.Token);
            if (revision == sourceRevision && !disposed) { readiness = currentReadiness; message = T("SourceSaved"); }
        }
        catch (Exception exception) { if (revision == sourceRevision) { if (Failure(exception).Status is ResourceLoadStatus.Forbidden or ResourceLoadStatus.NotFound) CommandFailure(exception); else { rawError = exception.Message; failed = true; } } }
        finally { busy = false; }
    }

    private KnowledgeSourceManifest RawResource() => new()
    {
        ApiVersion = source!.ApiVersion,
        Kind = source.Kind,
        Metadata = source.Metadata,
        Definition = source.Definition, ScopeRef = source.ScopeRef
    };
    private async Task RefreshToolsAsync()
    {
        if (refreshingTools) return;
        var revision = sourceRevision;
        refreshingTools = true;
        proposalError = null;
        try { var proposal = await ScopedClient.GetToolProposalAsync(SourceNamespace, Name, cancellation.Token); if (revision == sourceRevision && !disposed) toolProposal = proposal; }
        catch (Exception) when (disposed || revision != sourceRevision) { }
        catch (Exception exception) when (exception is not OperationCanceledException)
        { toolProposal = null; proposalError = T("ToolProposalRefreshFailed"); }
        finally { refreshingTools = false; }
    }
    private async Task PublishAsync()
    {
        if (!CanPublishTools) return;
        var revision = sourceRevision;
        busy = true;
        failed = false;
        message = null;
        try
        {
            var published = (await ScopedClient.PublishExposureAsync(SourceNamespace, Name,
                new PublishKnowledgeSourceToolExposureRequest { Version = version.Trim(), RequiresApproval = requiresApproval, ProposalDigest = toolProposal?.Digest }, cancellation.Token)).Value;
            if (revision != sourceRevision || disposed) return;
            exposure = published;
            version = NextExposureVersion(exposure.ToolSetVersion);
            message = T("ExposurePublished");
            await RefreshToolsAsync();
        }
        catch (Exception) when (disposed || revision != sourceRevision) { }
        catch (Exception exception) { CommandFailure(exception); }
        finally { busy = false; }
    }
    private static string NextExposureVersion(string current) => System.Version.TryParse(current, out var parsed)
        && parsed.Build >= 0 && parsed.Revision < 0 && parsed.Build < int.MaxValue
            ? $"{parsed.Major}.{parsed.Minor}.{parsed.Build + 1}" : string.Empty;
    private async Task RunActionAsync(Func<Task> action, string success)
    {
        if (busy) return;
        var revision = sourceRevision;
        projectionFailureCode = null; projectionFailureDetails = null; projectionFailureMessage = null; projectionFailureRun = null; projectionFailureOrigins = [];
        busy = true; failed = false; message = null;
        try { await action(); if (revision != sourceRevision || disposed) return; message = T(success); await ReloadChildrenAsync(); }
        catch (Exception) when (disposed || revision != sourceRevision) { }
        catch (AgentstrationApiException exception) when (exception.ProblemType?.Contains("/storage_", StringComparison.Ordinal) == true
            || exception.ProblemType?.Contains("/knowledge_output_", StringComparison.Ordinal) == true)
        { failed = true; message = T("OutputStorageInvalid"); }
        catch (AgentstrationApiException exception) when (exception.ProblemType == "https://agentstration.dev/problems/knowledge_projection_dataset_input_unsupported")
        { failed = true; message = T("NativeDatasetProjectionUnavailable"); }
        catch (Exception exception) { CommandFailure(exception); }
        finally { busy = false; }
    }
    private async Task ReloadChildrenAsync()
    {
        var revision = sourceRevision;
        var projectionsTask = ScopedClient.GetProjectionsAsync(SourceNamespace, Name, cancellation.Token);
        var snapshotsTask = ScopedClient.GetSnapshotsAsync(SourceNamespace, Name, cancellation.Token);
        await Task.WhenAll(projectionsTask, snapshotsTask);
        if (revision != sourceRevision || disposed) return;
        projections = (await projectionsTask).OrderByDescending(value => value.CreatedAt).ToArray();
        selectedProjection = projections.FirstOrDefault(value => value.Name == selectedProjection?.Name) ?? projections.FirstOrDefault();
        snapshots = (await snapshotsTask).OrderByDescending(value => value.Snapshot.PublishedAt).ToArray();
        selectedSnapshot = snapshots.FirstOrDefault(value => value.Snapshot.Name == selectedSnapshot?.Snapshot.Name) ?? snapshots.FirstOrDefault();
    }
    private async Task RefreshProjectionStatusAsync(bool includeSnapshots)
    {
        try { await projectionRefreshGate.WaitAsync(cancellation.Token); }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { return; }
        var revision = sourceRevision;
        refreshingProjections = true;
        var requestedName = Name;
        var requestedNamespace = SourceNamespace;
        var requestedUid = source?.Uid;
        try
        {
            var hadActive = HasActiveProjection;
            var history = await ScopedClient.GetProjectionsAsync(requestedNamespace, requestedName, cancellation.Token);
            if (revision != sourceRevision || requestedName != Name || requestedNamespace != SourceNamespace || requestedUid != source?.Uid || cancellation.IsCancellationRequested) return;
            var selectedName = selectedProjection?.Name;
            projections = history.OrderByDescending(value => value.CreatedAt).ToArray();
            selectedProjection = projections.FirstOrDefault(value => value.Name == selectedName) ?? LiveProjection ?? projections.FirstOrDefault();
            projectionStartedAt = LiveProjection?.CreatedAt ?? projectionStartedAt;
            projectionRun = null; activeProjectionRuns = [];
            if (LiveProjection is { Inputs.Count: > 0 } active)
            {
                try
                {
                    var liveRun = await Flows.GetFlowRunAsync(active.ProjectionFlowRunId, ResourceScopeRef.Workspace(active.WorkspaceId), cancellation.Token);
                    if (revision != sourceRevision || cancellation.IsCancellationRequested) return;
                    var activeRuns = await FlowRunInspection.ReadActiveAsync(Flows, liveRun, cancellation.Token);
                    if (revision != sourceRevision || cancellation.IsCancellationRequested) return;
                    projectionRun = liveRun; activeProjectionRuns = activeRuns;
                }
                catch (AgentstrationApiException exception) when (exception.StatusCode == System.Net.HttpStatusCode.NotFound) { }
                catch (NotSupportedException) { }
            }
            if (!HasActiveProjection && selectedProjection is { State: KnowledgeProjectionState.Failed } failedProjection)
                await ReadProjectionFailureAsync(failedProjection, revision);
            if (includeSnapshots || hadActive && !HasActiveProjection)
            {
                var latestSnapshots = await ScopedClient.GetSnapshotsAsync(requestedNamespace, requestedName, cancellation.Token);
                var latestReadiness = await ScopedClient.GetReadinessAsync(requestedNamespace, requestedName, cancellation.Token);
                if (revision != sourceRevision || cancellation.IsCancellationRequested) return;
                snapshots = latestSnapshots.OrderByDescending(value => value.Snapshot.PublishedAt).ToArray();
                selectedSnapshot = snapshots.FirstOrDefault(value => value.Snapshot.Name == selectedSnapshot?.Snapshot.Name) ?? snapshots.FirstOrDefault();
                readiness = latestReadiness;
            }
            projectionRefreshError = null;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (AgentstrationApiException exception) when (exception.StatusCode is System.Net.HttpStatusCode.Forbidden or System.Net.HttpStatusCode.NotFound) { if (revision == sourceRevision) { ClearPrivate(); loadState = Failure(exception); } }
        catch (Exception) { if (revision == sourceRevision) projectionRefreshError = T("ProjectionRefreshUnavailable"); }
        finally
        {
            refreshingProjections = false;
            projectionRefreshGate.Release();
            if (!cancellation.IsCancellationRequested) StateHasChanged();
        }
    }
    private Task RefreshProjectionsManuallyAsync() => RefreshProjectionStatusAsync(true);
    private async Task StartProjectionAsync()
    {
        if (!CanStartProjection) return;
        var revision = sourceRevision;
        busy = true; projectionStarting = true; failed = false; message = null; projectionRefreshError = null;
        projectionStartedAt = Clock.GetUtcNow();
        projectionRequestId = Guid.NewGuid().ToString("N");
        projectionFailureCode = null; projectionFailureDetails = null; projectionFailureMessage = null; projectionFailureRun = null; projectionFailureOrigins = []; activeProjectionRuns = [];
        projectionRun = null;
        try
        {
            var started = await ScopedClient.StartProjectionAsync(SourceNamespace, Name,
                new StartKnowledgeProjectionRequest { Parameters = projectionParameters.Clone(), IdempotencyKey = projectionRequestId }, cancellation.Token);
            if (revision != sourceRevision || cancellation.IsCancellationRequested) return;
            projections = projections.Where(value => value.Name != started.Value.Name).Prepend(started.Value).OrderByDescending(value => value.CreatedAt).ToArray();
            selectedProjection = started.Value;
            failed = started.Value.State is KnowledgeProjectionState.Failed or KnowledgeProjectionState.Cancelled or KnowledgeProjectionState.TimedOut;
            if (started.Value.State == KnowledgeProjectionState.Failed) await ReadProjectionFailureAsync(started.Value, revision);
            if (revision != sourceRevision || disposed) return;
            message = failed ? T("ProjectionFailed", started.Value.ErrorMessage ?? started.Value.ErrorCode ?? T($"ProjectionState.{started.Value.State}"))
                : T(started.Value.State == KnowledgeProjectionState.Succeeded ? "ProjectionCompleted" : "ProjectionAccepted");
        }
        catch (Exception) when (disposed || revision != sourceRevision) { }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (AgentstrationApiException exception) when (exception.ProblemType?.Contains("/storage_", StringComparison.Ordinal) == true
            || exception.ProblemType?.Contains("/knowledge_output_", StringComparison.Ordinal) == true)
        { failed = true; message = T("OutputStorageInvalid"); }
        catch (AgentstrationApiException exception) when (exception.ProblemType == "https://agentstration.dev/problems/knowledge_projection_dataset_input_unsupported")
        { failed = true; message = T("NativeDatasetProjectionUnavailable"); }
        catch (Exception exception) { CommandFailure(exception); }
        finally
        {
            try { if (!cancellation.IsCancellationRequested && revision == sourceRevision) await RefreshProjectionStatusAsync(true); }
            finally { busy = false; projectionStarting = false; projectionRequestId = null; }
        }
    }
    private async Task ReadProjectionFailureAsync(KnowledgeProjectionResource projection, int revision)
    {
        FlowRun? failedRun = null; IReadOnlyList<FlowRun> origins = [];
        if (projection.Inputs.Count > 0)
        {
            try
            {
                failedRun = await Flows.GetFlowRunAsync(projection.ProjectionFlowRunId, ResourceScopeRef.Workspace(projection.WorkspaceId), cancellation.Token);
                origins = await FlowRunInspection.ReadErrorOriginsAsync(Flows, failedRun, cancellation.Token);
            }
            catch (AgentstrationApiException) { }
            catch (NotSupportedException) { }
            catch (HttpRequestException) { }
        }
        if (revision != sourceRevision || cancellation.IsCancellationRequested) return;
        var diagnostic = Agentstration.Schemas.DataContracts.ParseFailure(failedRun?.Error?.Details);
        projectionFailureCode = diagnostic?.Code ?? failedRun?.Error?.Code ?? projection.ErrorCode ?? "knowledge_projection_failed";
        projectionFailureDetails = failedRun?.Error?.Details;
        projectionFailureMessage = projection.ErrorMessage;
        // Authoritative execution diagnostics replace an earlier launch/transport message.
        message = null;
        projectionFailureRun = failedRun; projectionFailureOrigins = origins;
    }
    private Task SelectSnapshotAsync(KnowledgeSnapshotView value) => RunActionAsync(async () => { await ScopedClient.SelectActiveSnapshotAsync(SourceNamespace, Name, value.Snapshot.Name, cancellation.Token); }, "SnapshotActivated");
    private Task ToggleEnabledAsync(bool value) => value == source?.Definition.Enabled || !CanEdit ? Task.CompletedTask : RunActionAsync(async () =>
    {
        var revision = sourceRevision;
        var wasEnabled = source!.Definition.Enabled;
        var saved = await ScopedClient.SetEnabledAsync(SourceNamespace, Name, !wasEnabled, etag!, cancellation.Token);
        if (disposed || revision != sourceRevision) return;
        Adopt(saved);
        var currentReadiness = await ScopedClient.GetReadinessAsync(SourceNamespace, Name, cancellation.Token);
        if (revision == sourceRevision && !disposed) readiness = currentReadiness;
    }, source!.Definition.Enabled ? "SourceDisabled" : "SourceEnabled");
    private async Task DeleteAsync()
    {
        if (busy || !CanEdit) return;
        busy = true; failed = false; message = null; confirmDelete = false;
        var revision = sourceRevision;
        try { await ScopedClient.DeleteAsync(SourceNamespace, Name, etag!, cancellation.Token); if (revision != sourceRevision || disposed) return; ClearPrivate(); loadState = new(ResourceLoadStatus.NotFound); destination = "/knowledge-sources"; }
        catch (Exception exception) { if (revision == sourceRevision) { CommandFailure(exception); busy = false; } }
    }
    private void CommandFailure(Exception exception)
    {
        if (disposed) return;
        var failure = Failure(exception);
        if (failure.Status is ResourceLoadStatus.Forbidden or ResourceLoadStatus.NotFound) { ClearPrivate(); loadState = failure; }
        else { failed = true; message = exception.Message; }
    }
    private static UiStatus ProjectionTone(KnowledgeProjectionState state) => state switch { KnowledgeProjectionState.Succeeded => UiStatus.Success, KnowledgeProjectionState.Failed or KnowledgeProjectionState.Cancelled or KnowledgeProjectionState.TimedOut => UiStatus.Warning, _ => UiStatus.Info };
