@page "/flows/{FlowId}/orchestration"
@page "/namespaces/{FlowNamespace}/flows/{FlowId}/orchestration"
@using Agentstration.Resources
@implements IDisposable
@inject IFlowApiClient Client
@inject IManagementApiClient Management
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<FlowOrchestrationEditorStrings> Localizer
@if (!Embedded)
{
    <PageTitle>@(model?.Name ?? T("Orchestration")) · Agentstration</PageTitle>
}

@if (loading)
{
    <LoadingState Message="@T("Loading")" />
}
else if (model is null)
{
    <ErrorState Title="@T("Unavailable")" Message="@(error ?? T("CouldNotLoad"))" />
}
else
{
    @if (!Embedded)
    {
        <PageHeader Title="@model.Name" Description="@(IsReadOnly ? T("ReadOnlyDescription") : T("EditDescription"))">
            <Actions><a class="button-secondary" href="@DetailsUrl">@T("FlowDetails")</a></Actions>
        </PageHeader>
    }
    @if (IsReadOnly)
    {
        <p class="muted"><span class="read-only-badge">@T("ReadOnly")</span> @T("Namespace") <code>@FlowResourceNamespace.Value</code> · @T("PublishedVersion") <strong>@publishedVersion</strong></p>
    }
    <EditForm Model="model" OnValidSubmit="SaveAsync" data-testid="flow-orchestration-editor">
        <fieldset class="panel orchestration-metadata" disabled="@IsReadOnly">
            <div class="form-columns"><label>@T("TechnicalName")<input value="@model.Name" readonly /></label><label>@T("CurrentDefinitionVersion")<InputText @bind-Value="model.Version" /></label><ResourceScopeFormField ResourceKind="@FlowResourceKinds.Flow" @bind-Value="selectedScope" Disabled="true" /></div>
            <label>@T("Description")<InputTextArea @bind-Value="model.Description" /></label>
            <label class="check-option"><InputCheckbox @bind-Value="model.Enabled" /> @T("Enabled")</label>
        </fieldset>
        <OrchestrationDefinitionEditor Model="model" Agents="agents" IsReadOnly="@IsReadOnly" />
        @if (error is not null) { <p class="error-panel orchestration-message">@error</p> }
        @if (message is not null) { <p class="success-panel orchestration-message" data-testid="flow-status-message" data-published-version="@lastPublishedVersion">@message</p> }
        @if (!IsReadOnly)
        {
            <div class="orchestration-actions">
                <span class="save-state">@T("EtagProtected") · @(saving ? T("Saving") : T("Ready"))</span>
                <button type="submit" class="button-secondary" disabled="@saving">@T("Save")</button>
                <label>@T("PublishVersion")<input @bind="publishVersion" /></label>
                <button type="button" class="button-primary" disabled="@saving" @onclick="PublishAsync" data-testid="flow-publish-and-activate">@T("PublishAndActivate")</button>
            </div>
        }
    </EditForm>
}

@code {
    [Parameter] public string FlowId { get; set; } = string.Empty;
    [Parameter] public string? FlowNamespace { get; set; }
    [Parameter] public ResourceScopeRef? ScopeRef { get; set; }
    [SupplyParameterFromQuery(Name = "scopeRef")] public string? ScopeRefValue { get; set; }
    [Parameter] public bool Embedded { get; set; }
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private readonly CancellationTokenSource cancellation = new();
    private OrchestrationEditorModel? model;
    private ResourceScopeRef? selectedScope;
    private IReadOnlyList<AgentSummary> agents = [];
    private string? etag;
    private string publishVersion = "0.1.0";
    private string? error;
    private string? message;
    private bool loading = true;
    private bool saving;
    private bool isReadOnly;
    private string? publishedVersion;
    private string? lastPublishedVersion;
    private ResourceNamespace FlowResourceNamespace => string.IsNullOrWhiteSpace(FlowNamespace) ? ResourceNamespace.Default : ResourceNamespace.Parse(FlowNamespace);
    private bool IsReadOnly => isReadOnly;
    private ResourceScopeRef? RequestedScope => ScopeRef ?? (string.IsNullOrWhiteSpace(ScopeRefValue) ? null : ResourceScopeRef.Parse(ScopeRefValue));
    private string DetailsUrl
    {
        get
        {
            var path = FlowResourceNamespace.IsDefault
                ? $"/flows/{Uri.EscapeDataString(FlowId)}"
                : $"/namespaces/{Uri.EscapeDataString(FlowResourceNamespace.Value)}/flows/{Uri.EscapeDataString(FlowId)}";
            return selectedScope is null ? path : $"{path}?scopeRef={Uri.EscapeDataString(selectedScope.Value.Value)}";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            loading = true; error = null;
            var agentsTask = Management.GetAgentsAsync(cancellation.Token);
            var requestedScope = RequestedScope;
            var snapshot = requestedScope is null
                ? await Client.GetFlowSnapshotAsync(FlowId, cancellation.Token)
                : await Client.GetFlowSnapshotAsync(FlowResourceNamespace, FlowId, requestedScope.Value, cancellation.Token);
            selectedScope = snapshot.Value.ScopeRef;
            isReadOnly = snapshot.Value.Metadata.ContainsKey("agentstration.io/pack.name");
            if (IsReadOnly)
            {
                var flow = snapshot.Value;
                if (string.IsNullOrWhiteSpace(flow.ActiveVersion))
                    throw new InvalidOperationException(T("NoActivePublishedVersion", $"{FlowResourceNamespace.Value}/{FlowId}"));
                var version = await Client.GetFlowVersionAsync(FlowResourceNamespace, FlowId, flow.ActiveVersion, flow.ScopeRef, cancellation.Token);
                if (version.Definition is not OrchestrationFlowDefinition)
                    throw new InvalidOperationException(T("NotOrchestration", version.Version));
                model = OrchestrationEditorModel.From(flow with { Version = version.Version, Definition = version.Definition, Description = version.Description });
                publishedVersion = version.Version;
                etag = null;
                agents = await agentsTask;
            }
            else
            {
                model = OrchestrationEditorModel.From(snapshot.Value);
                etag = snapshot.ETag;
                agents = await agentsTask;
                publishVersion = snapshot.Value.ActiveVersion is null ? snapshot.Value.Version : NextVersion(snapshot.Value.Version);
            }
        }
        catch (Exception exception) { error = exception.Message; model = null; }
        finally { loading = false; }
    }

    private async Task SaveAsync()
    {
        if (IsReadOnly || model is null || etag is null) return;
        try
        {
            saving = true; error = null; message = null;
            var request = new UpdateFlowRequest(
                model.Description,
                model.Version,
                model.Enabled,
                model.CreateDefinition());
            var saved = selectedScope is { } ownerScope
                ? await Client.UpdateFlowAsync(FlowResourceNamespace, FlowId, ownerScope, request, etag, cancellation.Token)
                : await Client.UpdateFlowAsync(FlowId, request, etag, cancellation.Token);
            model = OrchestrationEditorModel.From(saved.Value);
            etag = saved.ETag;
            message = T("Saved");
        }
        catch (Exception exception) { error = exception.Message; }
        finally { saving = false; }
    }

    private async Task PublishAsync()
    {
        if (IsReadOnly) return;
        await SaveAsync();
        if (error is not null || model is null) return;
        try
        {
            saving = true; message = null;
            var request = new CreateFlowVersionRequest(publishVersion, true);
            var published = selectedScope is { } ownerScope
                ? await Client.CreateFlowVersionAsync(FlowResourceNamespace, FlowId, ownerScope, request, cancellation.Token)
                : await Client.CreateFlowVersionAsync(FlowId, request, cancellation.Token);
            lastPublishedVersion = published.Version;
            message = T("VersionPublished", published.Version);
            publishVersion = NextVersion(published.Version);
        }
        catch (Exception exception) { error = exception.Message; }
        finally { saving = false; }
    }

    private static string NextVersion(string version)
    {
        var parts = version.Split('.');
        return parts.Length == 3 && int.TryParse(parts[2], out var patch) ? $"{parts[0]}.{parts[1]}.{patch + 1}" : version;
    }

    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
