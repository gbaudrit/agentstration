@inject Microsoft.Extensions.Localization.IStringLocalizer<DataSourcesStrings> Localizer

<section class="panel form-section" data-testid="source-lifecycle-editor">
    <h2>@Title</h2>
    <label class="checkbox-field"><input type="checkbox" checked="@Enabled" @onchange="args => EnabledChanged.InvokeAsync(args.Value is true)" data-testid="lifecycle-enable" /><span>@T("LifecycleEnable")</span></label>
    @if (Enabled)
    {
        <div class="form-grid">
            <label><span>@T("LifecycleTtl")</span><input value="@TimeToLiveText" @onchange="args => TimeToLiveTextChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty)" placeholder="hh:mm:ss" inputmode="numeric" data-testid="lifecycle-ttl" /><small>@T("LifecycleTtlHelp")</small></label>
            <label class="checkbox-field"><input type="checkbox" checked="@KeepHistory" @onchange="args => KeepHistoryChanged.InvokeAsync(args.Value is true)" data-testid="lifecycle-history" /><span>@T("LifecycleHistory")</span></label>
            @if (KeepHistory)
            {
                <label><span>@T("LifecycleRetention")</span><input value="@HistoryRetentionText" @onchange="args => HistoryRetentionTextChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty)" placeholder="hh:mm:ss" inputmode="numeric" data-testid="lifecycle-retention" /></label>
            }
        </div>
        <p>@T("LifecycleHistoryHelp")</p>
        @if (!Valid) { <p class="form-alert form-alert-danger" role="alert">@T("LifecycleDurationInvalid")</p> }
    }
</section>
@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public bool Enabled { get; set; }
    [Parameter] public EventCallback<bool> EnabledChanged { get; set; }
    [Parameter] public string TimeToLiveText { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> TimeToLiveTextChanged { get; set; }
    [Parameter] public bool KeepHistory { get; set; }
    [Parameter] public EventCallback<bool> KeepHistoryChanged { get; set; }
    [Parameter] public string HistoryRetentionText { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> HistoryRetentionTextChanged { get; set; }
    private bool Valid => LifecycleDuration.TryParse(TimeToLiveText, out _) && (!KeepHistory || LifecycleDuration.TryParse(HistoryRetentionText, out var retention) && retention is not null);
    private string T(string key) => Localizer[key];
}
