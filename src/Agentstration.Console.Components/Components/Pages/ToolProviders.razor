@page "/tools/providers"
@inject IToolsClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<ToolProvidersStrings> Localizer

<PageTitle>@T("Title") · Agentstration</PageTitle>
<PageHeader Title="@T("Title")" Description="@T("Description")" TestId="resource-tool-providers"><Actions><a class="button-secondary" href="/tools">@T("Catalog")</a><a class="button-primary" href="/tools/providers/new">@T("AddProvider")</a></Actions></PageHeader>
<ResourceTabs Label="@T("SectionsLabel")"><a href="/tools">@T("Catalog")</a><a href="/tools/sets">@T("ToolSets")</a><a href="/tools/categories">@T("Categories")</a><a href="/tools/definitions">@T("Definitions")</a><a class="active" href="/tools/providers">@T("Providers")</a></ResourceTabs>
@if (loading) { <LoadingState Message="@T("Loading")" /> }
else if (providers.Count == 0) { <EmptyState Title="@T("EmptyTitle")" Message="@T("EmptyMessage")" /> }
else { <CollectionView TItem="ToolProviderResource" Items="providers" InformationLabels="@(new string[] { T("Type"), T("Tools"), T("Enabled") })" IdentityLabel="@T("Name")" StateLabel="@T("Status")">
        <Identity Context="provider">
<CollectionIdentity DisplayName="@provider.Definition.DisplayName" Namespace="@provider.Namespace.Value" Name="@provider.Name" Href="@ProviderUrl(provider)" IconName="server"><Badges><ManagedResourceBadge IsManaged="@provider.Governance.IsManaged" /></Badges></CollectionIdentity></Identity>
        <Scope Context="provider">
<ResourceScopeBadge ScopeRef="provider.ScopeRef" ShowName /></Scope>
        <State Context="provider">
<StatusBadge Text="@StatusLabel(provider.Definition.Discovery.Status)" Status="@Tone(provider.Definition.Discovery.Status)" /></State>
        <Information Context="provider">
            <CollectionValue Label="@T("Type")">@provider.Definition.ProviderType</CollectionValue>
            <CollectionValue Label="@T("Tools")">@provider.Definition.Discovery.ToolCount</CollectionValue>
            <CollectionValue Label="@T("Enabled")">@BooleanLabel(provider.Definition.Enabled)</CollectionValue>
        </Information>
        <Actions Context="provider">
<CollectionActions ResourceName="@($"{provider.Definition.DisplayName} ({provider.Namespace}/{provider.Name}, {provider.ScopeRef})")"><a class="text-button" href="@ProviderUrl(provider)">@T("Manage")</a></CollectionActions></Actions>
    </CollectionView> }
@code { private static string ProviderUrl(ToolProviderResource provider) => ConsoleResourceUrls.Resource("/tools/providers", provider.Name, provider.Namespace, provider.ScopeRef); private IReadOnlyList<ToolProviderResource> providers = []; private bool loading = true; private string T(string key, params object[] arguments) => Localizer[key, arguments]; private string BooleanLabel(bool value) => T(value ? "Yes" : "No"); private string StatusLabel(string status) { var value = Localizer[$"Status.{status}"]; return value.ResourceNotFound ? status : value.Value; } protected override async Task OnInitializedAsync() { providers = await Client.GetProvidersAsync(default); loading = false; } private static UiStatus Tone(string status) => status == "connected" ? UiStatus.Success : status == "error" ? UiStatus.Danger : UiStatus.Neutral; }
