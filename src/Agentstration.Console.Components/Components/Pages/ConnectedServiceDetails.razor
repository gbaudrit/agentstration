@page "/connected-services/{Name}"
@implements IDisposable
@inject IConnectedServicesClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<ConnectedServiceStrings> Localizer

<PageTitle>@(resource?.Definition.DisplayName ?? Name) · Agentstration</PageTitle>
<UnsavedNavigationGuard IsDirty="@(editorDirty || policyDirty)" HasUnsavedChanges="@(() => editorDirty || policyDirty)" />
@if (loading) { <LoadingState Message="@T("LoadingDetails")" /> }
else if (error is not null && resource is null) { <ErrorState Message="@error.Message"><button class="button-secondary" @onclick="LoadAsync">@T("Retry")</button></ErrorState> }
else if (resource is not null)
{
    <ResourceDetailsTemplate Name="@resource.Definition.DisplayName" ResourceType="@T("ConnectedService")" Domain="source" IconName="plug" Description="@resource.Definition.Description"
                             ScopeRef="resource.ScopeRef" Namespace="@resource.Namespace.Value" TechnicalName="@resource.Name" Enabled="resource.Definition.Enabled" EnabledChanged="ChangeEnabledAsync" EnabledDisabled="@(changingEnabled || editorBusy || !CanChangeEnabled)" EnabledTestId="connected-service-enabled"
                             StatusText="@StatusLabel(Availability)" Status="@StatusColor(Availability)" Sections="Sections" ResourceIdentity="@($"{loadedKey}|{resource.Uid}")" DefaultSection="overview" SelectionChanged="SelectSection" HasDraft="editorDirty" TestId="connected-service-details">
        <Metadata><ManagedResourceBadge IsManaged="resource.Governance.IsManaged" IsReadOnly="@(!CanManageAccess)" /></Metadata>
        <Actions><button class="button-secondary" disabled="@(loading || changingEnabled || editorBusy)" @onclick="RequestReconcile">@T("Reconcile")</button><a class="button-secondary" href="@ResourceOwnershipContext.PreserveNavigation("/connected-services", Services)">@T("Back")</a></Actions>
        <Feedback>@if (error is not null) { <div class="form-alert form-alert-danger" role="alert">@error.Message</div> }@if (resource.ScopeRef is { } owner) { <InheritedResourceNotice OwnerScopeRef="owner" /> }</Feedback>
        <Content>
    <div hidden="@(section != "overview")">
        <div class="resource-overview connected-service-overview">
        <section class="metric-grid">
            <MetricCard Label="@T("Availability")" Value="@StatusLabel(Availability)" Status="@StatusColor(Availability)" />
            <MetricCard Label="@T("Enabled")" Value="@(resource.Definition.Enabled ? T("Yes") : T("No"))" />
            <MetricCard Label="@T("Generation")" Value="@resource.Generation.ToString()" />
        </section>
        <ResourceIdentitySummary DisplayName="@resource.Definition.DisplayName" TechnicalName="@resource.Name" Description="@resource.Definition.Description" Namespace="@resource.Namespace.Value">
            <Scope><ResourceScopeBadge ScopeRef="resource.ScopeRef" /></Scope>
            <AdditionalDetails><dt>@T("ServiceType")</dt><dd>@(TypeResource?.Definition.DisplayName ?? resource.Definition.Type.Type.Name) · @resource.Definition.Type.Version</dd></AdditionalDetails>
        </ResourceIdentitySummary>
        <FormSection Title="@T("Configuration")" Class="connected-service-configuration-summary">
            @if (ConfigurationRows.Count == 0) { <p>@T("NoBindings")</p> }
            else
            {
                <CollectionView TItem="ConfigurationRow" Items="ConfigurationRows" IdentityLabel="@T("Input")" InformationLabels="@(new[] { T("SourceKind"), T("ValueOrResource") })">
                    <Identity Context="row"><strong class="configuration-key">@row.Name</strong></Identity>
                    <Information Context="row"><CollectionValue Label="@T("SourceKind")">@row.Source</CollectionValue><CollectionValue Label="@T("ValueOrResource")"><span class="configuration-value">@row.Value</span></CollectionValue></Information>
                </CollectionView>
            }
        </FormSection>

        <section class="panel form-section"><div class="panel-header"><h2>@T("Diagnostics")</h2></div>@if (resource.ObservedState is null) { <p>@T("NotObserved")</p> } else { <dl class="details-list"><dt>@T("ObservedAt")</dt><dd>@resource.ObservedState.ObservedAt.ToLocalTime().ToString("g")</dd><dt>@T("Code")</dt><dd><code>@(resource.ObservedState.Code ?? "—")</code></dd><dt>@T("Message")</dt><dd>@(resource.ObservedState.Message ?? "—")</dd></dl> }</section>
        <section class="panel form-section"><div class="panel-header"><h2>@T("Dependents")</h2><span>@usages.Count</span></div><p>@T("DependentsExplanation")</p>@if (usages.Count == 0) { <p>@T("NoDependents")</p> } else { <ul class="resource-links">@foreach (var usage in usages) { <li><CollectionIdentity DisplayName="@usage.DisplayName" Name="@usage.Name" Href="@UsageUrl(usage)" IconName="layers"><Badges><small>@usage.ResourceType</small></Badges></CollectionIdentity><CollectionActions ResourceName="@usage.DisplayName"><a href="@UsageUrl(usage)">@Shared["OpenItem"]</a></CollectionActions></li> }</ul> }</section>
        </div>
    </div>
    @if (discoveryVisited)
    {
        <div hidden="@(section != "discovery")"><ConnectedServiceDiscoveryPanel @key="resource.Uid" Service="resource" Supported="@(TypeVersion?.OperationDiscovery is not null)" /></div>
    }
    @if (accessVisited && CanManageAccess)
    {
        <div hidden="@(section != "access")"><ResourceAccessPanel ResourceUid="resource.Uid" DraftChanged="value => policyDirty = value" OwnerScopeRef="resource.ScopeRef!.Value" Namespace="resource.Namespace" Kind="@ConnectedServiceResourceKinds.ConnectedService" Name="@resource.Name" Generation="resource.Generation" Governance="resource.Governance" /></div>
    }
    <div hidden="@(section != "yaml")"><FormSection Title="@Shared["Yaml"]" TestId="connected-service-yaml-viewer"><FormField Label="@T("YamlDefinition")"><ClearableText Multiline Value="@ResourceYaml" ReadOnly class="form-code-editor runner-json" rows="30" /></FormField></FormSection></div>
    @if (definitionVisited)
    {
        <div hidden="@(section != "definition/configuration")">
            <ConnectedServiceEditor @ref="editor" @key="loadedKey" Name="@resource.Name" EmbeddedScopeRef="resource.ScopeRef" EmbeddedNamespace="resource.Namespace" Embedded="true" ExternalBusy="changingEnabled" SavingChanged="EditorSavingChanged" Saved="DefinitionSavedAsync" InitialSnapshot="@(new ResourceSnapshot<ConnectedServiceResource>(resource, etag!))" ExternalActions="true" DraftChanged="value => editorDirty = value" />
        </div>
    }
        </Content>
        <DraftActions><button type="button" class="button-secondary" disabled="@(editorBusy || changingEnabled)" @onclick="DiscardDefinition">@Shared["Discard"]</button><button type="submit" form="@editor?.FormId" class="button-primary" disabled="@(editor?.CanSubmit != true || changingEnabled)" data-testid="connected-service-save">@T("Save")</button></DraftActions>
    </ResourceDetailsTemplate>
}
<ConfirmationDialog IsOpen="@confirmReconcile" Title="@T("Reconcile")" Message="@T("ReconcileConfirm")" ConfirmLabel="@T("Reconcile")" OnConfirm="ReconcileAsync" OnCancel="() => confirmReconcile = false" />
<ConfirmationDialog IsOpen="@confirmDeactivate" Title="@T("Deactivate")" Message="@T("DeactivateConfirm")" ConfirmLabel="@T("Deactivate")" OnConfirm="DeactivateAsync" OnCancel="() => confirmDeactivate = false" />

@code {
    [Parameter] public string? Name { get; set; }
    [SupplyParameterFromQuery(Name = "scopeRef")] public string? ScopeRefValue { get; set; }
    [SupplyParameterFromQuery(Name = "namespace")] public string? Namespace { get; set; }
    private ConnectedServiceEditor? editor;
    private bool definitionVisited, discoveryVisited, accessVisited, editorDirty, policyDirty, changingEnabled, editorBusy;
    private long loadVersion;
    private readonly CancellationTokenSource cancellation = new();
    private ConnectedServiceResource? resource;
    private IReadOnlyList<ConnectedServiceTypeResource> catalog = [];
    private IReadOnlyList<ConnectedServiceUsageResponse> usages = [];
    private string? etag, loadedKey;
    private bool loading = true, confirmReconcile, confirmDeactivate;
    private AgentstrationApiException? error;
    private string section = "overview";
    private ConnectedServiceAvailability Availability => resource?.ObservedState?.Availability ?? (resource?.Definition.Enabled == true ? ConnectedServiceAvailability.Stale : ConnectedServiceAvailability.Disabled);
    private ConnectedServiceTypeResource? TypeResource => resource is null ? null : catalog.SingleOrDefault(type => MatchesType(type));
    private ConnectedServiceTypeVersionDescriptor? TypeVersion => TypeResource?.Definition.Versions.SingleOrDefault(version => resource is not null && version.Version == resource.Definition.Type.Version && version.SchemaDigest == resource.Definition.Type.SchemaDigest);
    private bool CanChangeEnabled => !loading && CanManageAccess && resource?.Governance.IsManaged == false;
    private bool CanManageAccess => resource?.ScopeRef is { } scopeRef && ResourceOwnershipContext.CanManage(scopeRef, Services);
    private IReadOnlyList<ResourceNavigationItem> Sections => [new("overview", Shared["Overview"], "home"), new("definition", Shared["Definition"], "settings") { Navigable = false, Visible = CanChangeEnabled }, new("definition/configuration", Shared["Configuration"], "forms") { Visible = CanChangeEnabled }, new("discovery", T("Tab.Discovery"), "search"), new("access", Shared["Access"], "lock") { Visible = CanManageAccess }, new("yaml", Shared["Yaml"], "code")];
    private void SelectSection(string? value) { section = value ?? "overview"; definitionVisited |= section == "definition/configuration"; discoveryVisited |= section == "discovery"; accessVisited |= section == "access"; }
    private void DiscardDefinition() => editor?.Discard();
    private string ResourceYaml => resource is null ? string.Empty : ResourceManifestSerializer.ToYaml(new RawConnectedService
    {
        ApiVersion = resource.ApiVersion,
        Kind = resource.Kind,
        Metadata = resource.Metadata,
        ScopeRef = resource.ScopeRef,
        Definition = resource.Definition
    });
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Name}|{ScopeRefValue}|{Namespace}|{ResourceOwnershipContext.TryGetCurrent(Services)}";
        if (string.Equals(loadedKey, key, StringComparison.Ordinal)) return;
        loadedKey = key; confirmDeactivate = confirmReconcile = false;
        section = "overview"; definitionVisited = discoveryVisited = accessVisited = editorDirty = policyDirty = editorBusy = changingEnabled = false;
        editor = null; resource = null;
        await LoadAsync();
    }
    private async Task LoadAsync()
    {
        var request = ++loadVersion; loading = true; error = null;
        try
        {
            var scope = ResourceScopeRef.Parse(ScopeRefValue ?? throw new ArgumentException(T("ScopeRequired")));
            var ns = ResourceNamespace.Parse(Namespace ?? ResourceNamespace.DefaultValue); var requestedName = Name!;
            var resourceTask = Client.GetConnectedServiceAsync(requestedName, scope, ns, cancellation.Token);
            var catalogTask = Client.GetTypesAsync(cancellation.Token); var usagesTask = Client.GetUsagesAsync(requestedName, scope, ns, cancellation.Token);
            await Task.WhenAll(resourceTask, catalogTask, usagesTask);
            if (request != loadVersion) return;
            var snapshot = await resourceTask;
            if (snapshot.Value.Name != requestedName || snapshot.Value.ScopeRef != scope || snapshot.Value.Namespace != ns) throw new InvalidOperationException(T("IdentityMismatch"));
            resource = snapshot.Value; etag = snapshot.ETag; catalog = await catalogTask; usages = (await usagesTask).Value;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (AgentstrationApiException exception) { if (request == loadVersion) error = exception; }
        catch (Exception exception) { if (request == loadVersion) error = new(exception.Message, Guid.NewGuid().ToString("N")); }
        finally { if (request == loadVersion) loading = false; }
    }
    private void EditorSavingChanged(bool value) => editorBusy = value;
    private async Task DefinitionSavedAsync()
    {
        var request = loadVersion; var identity = resource!.Uid;
        var snapshot = await Client.GetConnectedServiceAsync(resource.Name, resource.ScopeRef!.Value, resource.Namespace, cancellation.Token);
        if (request != loadVersion || snapshot.Value.Uid != identity) return;
        resource = snapshot.Value;
        etag = snapshot.ETag;
    }
    private Task ChangeEnabledAsync(bool value)
    {
        if (!CanChangeEnabled || changingEnabled || editorBusy || resource is null || resource.Definition.Enabled == value) return Task.CompletedTask;
        if (!value) { confirmDeactivate = true; return Task.CompletedTask; }
        return ExecuteAsync(() => Client.UpdateConnectedServiceAsync(resource.Name, resource.ScopeRef!.Value, resource.Namespace,
            new(resource.Definition with { Enabled = true }), etag!, cancellation.Token));
    }
    private bool MatchesType(ConnectedServiceTypeResource type) { if (resource is null) return false; var reference = resource.Definition.Type.Type; return reference.Name == type.Name && reference.ScopeRef == type.ScopeRef && (reference.Namespace ?? resource.Namespace) == type.Namespace && resource.Definition.Type.TypeUid == type.Uid; }
    private void RequestReconcile() => confirmReconcile = true;
    private async Task ReconcileAsync() { confirmReconcile = false; await ExecuteAsync(() => Client.ReconcileAsync(resource!.Name, resource.ScopeRef!.Value, resource.Namespace, etag!, cancellation.Token)); }
    private async Task DeactivateAsync() { confirmDeactivate = false; if (!CanChangeEnabled) return; await ExecuteAsync(() => Client.DeactivateAsync(resource!.Name, resource.ScopeRef!.Value, resource.Namespace, etag!, cancellation.Token)); }
    private async Task ExecuteAsync(Func<Task<ResourceSnapshot<ConnectedServiceResource>>> action)
    {
        if (loading || changingEnabled || editorBusy) return;
        var request = loadVersion;
        changingEnabled = true;
        error = null;
        try
        {
            var snapshot = await action();
            if (request != loadVersion || snapshot.Value.Uid != resource?.Uid) return;
            resource = snapshot.Value;
            etag = snapshot.ETag;
            editor?.ApplyActivationSnapshot(snapshot);
        }
        catch (AgentstrationApiException exception) { if (request == loadVersion) error = exception; }
        finally { if (request == loadVersion) changingEnabled = false; }
    }

    private string StatusLabel(ConnectedServiceAvailability status) => T($"Availability.{status}");
    private static UiStatus StatusColor(ConnectedServiceAvailability status) => status switch { ConnectedServiceAvailability.Ready => UiStatus.Success, ConnectedServiceAvailability.Stale => UiStatus.Warning, ConnectedServiceAvailability.Unavailable => UiStatus.Danger, _ => UiStatus.Neutral };
    private IReadOnlyList<ConfigurationRow> ConfigurationRows
    {
        get
        {
            if (resource is null) return [];
            var rows = resource.Definition.Bindings.Select(binding => new ConfigurationRow(binding.InputId, BindingKindLabel(binding.Kind), BindingValue(binding))).ToList();
            if (resource.Definition.Options.ValueKind == JsonValueKind.Object)
                rows.AddRange(resource.Definition.Options.EnumerateObject().Select(option => new ConfigurationRow(option.Name, BindingKindLabel(ConnectedServiceBindingKind.Literal), ConfigurationValue(option.Value))));
            return rows;
        }
    }
    private static string ConfigurationValue(JsonElement value) => value.ValueKind == JsonValueKind.String
        ? value.GetString() ?? string.Empty : JsonSerializer.Serialize(value, new JsonSerializerOptions { WriteIndented = true });
    private sealed record ConfigurationRow(string Name, string Source, string Value);
    private string BindingKindLabel(ConnectedServiceBindingKind kind) => T($"BindingKind.{kind}");
    private static string BindingValue(ConnectedServiceValueBinding binding)
    {
        if (binding.Kind == ConnectedServiceBindingKind.Literal && binding.Literal is { } literal)
            return literal.ValueKind == JsonValueKind.String ? literal.GetString() ?? string.Empty : literal.GetRawText();
        var address = binding.Parameter?.Address ?? binding.Secret?.Address;
        var scope = binding.Parameter?.ScopeRef ?? binding.Secret?.ScopeRef;
        return address is not { } exact ? "—" : $"{scope}/{exact.Namespace}/{exact.Name}";
    }
    private static string UsageUrl(ConnectedServiceUsageResponse usage) => usage.ResourceType == StorageResourceKinds.Storage ? StorageLinks.FromApi(usage.Url) : usage.Url;
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
    private sealed record RawConnectedService
    {
        public required string ApiVersion { get; init; }
        public required string Kind { get; init; }
        public required ResourceMetadata Metadata { get; init; }
        public ResourceScopeRef? ScopeRef { get; init; }
        public required ConnectedServiceProperties Definition { get; init; }
    }
}
