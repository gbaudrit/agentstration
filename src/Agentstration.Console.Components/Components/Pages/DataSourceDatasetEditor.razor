    private async Task SaveAsync() => await RunAsync(async () =>
    {
        if (!CanManage || !CanSave || IsNew && !IdentityValid) return;
        var version = loadVersion; var creating = IsNew;
        var storage = storages.SingleOrDefault(item => StorageKey(item) == model.StorageKey);
        var operation = SelectedOperation;
        var storageReference = storage is null ? (string.IsNullOrEmpty(model.StorageKey) ? null : source?.Definition.Dataset?.Storage) : new StorageRevisionReference(
            new(storage.ScopeRef!.Value, storage.Namespace, storage.Kind, storage.Name), storage.Uid, storage.Generation, storage.ObservedState!.BindingDigest!);
        var operationReference = operation is null ? source!.Definition.Dataset!.Acquisition.Operation : new ConnectedServiceOperationRevisionReference(
            new(operation.ScopeRef!.Value, operation.Namespace, operation.Kind, operation.Name), operation.Uid, operation.Generation, operation.Definition.DefinitionDigest);
        var rule = (source?.Definition.Dataset?.Rule ?? new StorageContentPolicy(Write: true)) with { Prefix = model.Prefix };
        var definition = new DataSourceProperties { DisplayName = model.DisplayName.Trim(), Description = model.Description, Enabled = model.Enabled,
            Dataset = new(storageReference, rule, new(operationReference, model.Parameters) { OutputSchemaBinding = model.AcquisitionOutputBinding }) { DocumentCollectionUid = model.DocumentCollectionUid == Guid.Empty ? null : model.DocumentCollectionUid, OutputSchemaBinding = model.OutputBinding, Orchestration = model.Orchestration, Compositions = model.CompositionPoints, Lifecycle = LifecycleSelection() } };
        var saved = IsNew ? await Client.CreateAsync(new(model.Name, definition, DraftNamespace, scope), cancellation.Token)
            : await Client.UpdateAsync(source!.Namespace, source.Name, scope!.Value, new(definition), etag!, cancellation.Token);
        if (disposed || version != loadVersion) return;
        savedOperation = operation ?? savedOperation; ApplySnapshot(saved);
        if (creating) Navigation.NavigateTo($"/data-sources/{Uri.EscapeDataString(saved.Value.Name)}?scopeRef={Uri.EscapeDataString(saved.Value.ScopeRef!.Value.Value)}&namespace={Uri.EscapeDataString(saved.Value.Namespace.Value)}&context={Uri.EscapeDataString(ResourceOwnershipContext.TryGetCurrent(Services)?.Value ?? saved.Value.ScopeRef.Value.Value)}");
        await RefreshCoreAsync();
    });
    private async Task StartAsync() => await RunAsync(async () =>
    {
        if (readiness?.CanAcquire != true || source is null) return;
        var version = loadVersion;
        _ = await Client.StartAcquisitionAsync(source!.Namespace, source.Name, scope!.Value, new(), cancellation.Token);
        if (disposed || version != loadVersion) return;
        await RefreshCoreAsync();
        if (!disposed && version == loadVersion) SelectTab(DatasetTab.Acquisitions);
    });
    private async Task ReadAsync(DataSourceAcquisitionResource item) => await RunAsync(async () =>
    {
        var version = loadVersion;
        var content = await Client.ReadContentAsync(item.Namespace, item.Name, cancellation.Token);
        if (disposed || version != loadVersion) return;
        preview = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(content.ContentBase64));
        previewTruncated = !content.EndOfObject;
        contentAcquisitionKey = item.Uid.ToString();
        SelectTab(DatasetTab.Content);
    });
    private async Task RunAsync(Func<Task> action)
    {
        if (busy || resourceRefreshing || disposed) return;
        var version = loadVersion;
        busy = true; error = null; errorCode = null; errorId = null; compositionErrorCode = null;
        try { await action(); }
        catch (AgentstrationApiException exception)
        {
            if (disposed || version != loadVersion) return;
            const string problemPrefix = "https://agentstration.dev/problems/";
            var code = exception.ProblemType?.StartsWith(problemPrefix, StringComparison.Ordinal) == true ? exception.ProblemType[problemPrefix.Length..] : null;
            errorCode = code is { Length: > 0 and <= 96 } && code.All(value => char.IsAsciiLetterOrDigit(value) || value is '_' or '-') ? code : null;
            errorId = exception.ErrorId;
            compositionErrorCode = exception.CompositionErrorCode is { Length: > 0 and <= 96 } reason
                && reason.All(value => char.IsAsciiLetterOrDigit(value) || value is '_' or '-') ? reason : null;
            error = T(errorCode switch
            {
                "data_source_operation_adapter_unavailable" => "DatasetOperationAdapterUnavailable",
                "data_source_operation_not_read_only" => "DatasetOperationNotReadOnly",
                "data_source_operation_schema_missing" or "data_source_schema_unsupported" => "DatasetOperationSchemaMissing",
                "data_source_parameters_invalid" => "DatasetParametersInvalid",
                "data_source_retained_storage_required" => "LifecycleStorageRequired",
                "data_source_lifecycle_invalid" => "LifecycleDurationInvalid",
                "data_source_direct_permission_required" => "DirectPermission",
                "data_source_composition_invalid" or "data_source_composition_ambiguous" => "SequenceInvalid",
                "data_source_rule_invalid" => "DatasetPrefixInvalid",
                _ => "DatasetActionFailed"
            });
        }
        catch (Exception exception) when (exception is not OperationCanceledException) { if (!disposed && version == loadVersion) error = T("DatasetActionFailed"); }
        finally { if (version == loadVersion) busy = false; }
    }
    private string ServiceDiscoveryUrl(ConnectedServiceResource service) => $"/connected-services/{Uri.EscapeDataString(service.Name)}?scopeRef={Uri.EscapeDataString(service.ScopeRef!.Value.Value)}&namespace={Uri.EscapeDataString(service.Namespace.Value)}&context={Uri.EscapeDataString(ResourceOwnershipContext.TryGetCurrent(Services)?.Value ?? service.ScopeRef.Value.Value)}#discovery";
