    private Task InvalidDefinitionAsync(EditContext context) => IsNew ? SubmitDefinitionAsync(context) : Task.CompletedTask;
    private async Task SubmitDefinitionAsync(EditContext context)
    {
        if (!IsNew) { ValidateFamily(); if (!context.GetValidationMessages().Any()) await SaveAsync(); else if (definitionForm is not null) await definitionForm.RevealValidationAsync(); }
        else if (creationWizard?.CurrentStepId == "review") await creationWizard.FinishAsync();
        else if (creationWizard is not null) await creationWizard.ContinueAsync();
    }
    private async Task CreateFromReviewAsync(CreationWizardFinish finish)
    {
        if (creationWizard?.CurrentStepId != "review" || !CanManage || busy) return;
        _ = FormContext.Validate(); ValidateFamily();
        foreach (var step in CreationSteps)
        {
            if (StepIssue(step.Id) is not { } issue) continue;
            finish.ReturnToStepId = step.Id;
            error = T(issue); creationValidationFocus = true;
            return;
        }
        if (!CanSave || FormContext.Validate() != true)
        {
            error = T("WizardFormInvalid");
            if (ResourceDefinitionForm.FirstInvalidSection(FormContext, Presentations) is { } invalidSection)
            {
                finish.ReturnToStepId = invalidSection switch { "definition/identity" => "identity", "definition/contracts" => "contracts", "definition/treatments" => "treatments", _ => "acquisition" };
                creationValidationFocus = true;
            }
            else definitionForm?.RequestValidationFocus();
            return;
        }
        await SaveAsync();
    }
