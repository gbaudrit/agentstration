    private void ParametersValidated(JsonSchemaInputValidationState state)
    {
        parametersValid = state.IsValid;
        _ = FormContext; parameterErrors!.Clear();
        if (!state.IsValid) parameterErrors.Add(FormContext.Field(nameof(model.Parameters)), T("DatasetParametersInvalid"));
        FormContext.NotifyValidationStateChanged();
    }
    private void MarkDirty() { definitionTouched = true; familyErrors?.Clear(); FormContext.NotifyValidationStateChanged(); }
    private bool StorageSelectionInvalid => string.IsNullOrEmpty(model.StorageKey) && (!model.AllowDirect
        || model.LifecycleEnabled && (!string.IsNullOrWhiteSpace(model.AcquisitionTtl) || model.KeepHistory));
    private void ValidateFamily()
    {
        _ = FormContext; familyErrors!.Clear();
        if (!model.NamespaceValid) { familyErrors.Add(FormContext.Field(nameof(model.Namespace)), T("SourceNamespaceInvalid")); FormContext.NotifyValidationStateChanged(); return; }
        var issue = StepIssue("acquisition");
        var field = !parametersValid ? nameof(model.Parameters) : nameof(model.OperationKey);
        if (issue is null)
        {
            issue = StepIssue("storage");
            field = !DocumentCollectionValid ? nameof(model.DocumentCollectionUid) : StorageSelectionInvalid ? nameof(model.StorageKey)
                : !LifecycleDuration.TryParse(model.AcquisitionTtl, out _) ? nameof(model.AcquisitionTtl) : nameof(model.HistoryRetention);
        }
        if (issue is not null && !FormContext.GetValidationMessages(FormContext.Field(field)).Any()) familyErrors.Add(FormContext.Field(field), T(issue));
        FormContext.NotifyValidationStateChanged();
    }
    private bool Matches(DataSourceResource resource, Guid? uid = null) => resource.Name == Name && resource.Namespace == ResourceNamespace.Parse(Namespace)
