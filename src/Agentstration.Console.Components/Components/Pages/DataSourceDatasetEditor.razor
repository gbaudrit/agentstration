@implements IDisposable
@inject IDataSourcesClient Client
@inject IStoragesClient Storages
@inject IConnectedServiceOperationsClient Operations
@inject IConnectedServicesClient ConnectedServices
@inject NavigationManager Navigation
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<DataSourcesStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<StorageStrings> StorageLocalizer

<PageTitle>@(source?.Definition.DisplayName ?? T("CreateSource")) · Agentstration</PageTitle>
@{
    var presentations = Presentations;
    RenderFragment feedback = @<div>
        @if (error is not null) { <div class="form-alert form-alert-danger" role="alert">@error
            @if (errorCode is not null) { <code data-testid="dataset-error-code">@errorCode</code> }
            @if (compositionErrorCode is not null) { <small>@T("CompositionValidationReason") <code data-testid="dataset-composition-error-code">@compositionErrorCode</code></small> }
            @if (errorId is not null) { <small>@T("DatasetErrorReference") <code>@errorId</code></small> }
        </div> }
        @if (newerSnapshot is not null) { <div class="form-alert form-alert-warning" role="status">@T("SourceRefreshDraftConflict")</div> }
    </div>;
    RenderFragment form = @<ResourceDefinitionForm @key="model" @ref="definitionForm" EditContext="FormContext" FieldLabels="FieldLabels" Id="data-source-dataset-definition" FormName="data-source-dataset-definition"
        SectionState="@(IsNew ? null : sectionState)" Sections="presentations" SectionContent="@(IsNew ? null : DefinitionContent)" SectionRequested="ShowSection" OnValidSubmit="SubmitDefinitionAsync" OnInvalidSubmit="InvalidDefinitionAsync"
        Busy="busy" ReadOnly="@(!CanManage || !interactive)" FieldsTestId="dataset-definition-fields" data-definition-complete="@CanSave.ToString().ToLowerInvariant()" InvalidInputChanged="value => invalidInput = value" @oninput="MarkDirty" @onchange="MarkDirty">
        <ChildContent>@if (IsNew) {
            <div class="dataset-creation-options"><a class="text-button" href="/data-sources/new">@T("DatasetLegacyProfile")</a></div>
            <CreationWizard @ref="creationWizard" Steps="CreationSteps" OnStepChanging="ClearStepError" OnFinish="CreateFromReviewAsync" OnStepReady="CreationStepReady"
                Busy="busy" Disabled="@(!CanManage || !interactive)" FinishLabel="@T("WizardCreate")" FinishTestId="data-source-save" TestId="data-source-creation-wizard" />
        }</ChildContent>
    </ResourceDefinitionForm>;
    if (IsNew)
    {
        <UnsavedNavigationGuard IsDirty="HasDraft" HasUnsavedChanges="@(() => HasDraft)" />
        <PageHeader Title="@T("CreateSource")" Description="@T("DatasetHelp")" TestId="data-source-dataset-editor"><Actions><a class="button-secondary" href="/data-sources">@T("Back")</a></Actions></PageHeader>
        @feedback
        @if (loading) { <LoadingState Message="@T("Loading")" /> } else { @form }
    }
    else
    {
        <ConsoleResourceDetailsTemplate Resource="source" RequestedAddress="@ResourceAddress.Create(ResourceNamespace.Parse(Namespace), DataSourceResourceKinds.DataSource, Name!)"
            Name="@(source?.Definition.DisplayName ?? Name!)" ResourceType="@T("DatasetDataSource")" Domain="data" IconName="database" Description="@source?.Definition.Description"
            ResourceIdentity="@($"{loadedKey}|{source?.Uid}")" SectionState="sectionState" SectionPresentations="presentations" DefinitionSections="DefinitionSections" AdditionalSections="BusinessSections"
            LoadState="loadState" OnRetry="LoadInitialAsync" OnRefresh="RefreshAsync" Feedback="feedback" HasDraft="HasDraft"
            DefinitionReadOnlyReason="@(CanManage ? null : ResourceReadOnlyReason.InsufficientPermissions)" Busy="@(busy || resourceRefreshing)"
            Yaml="@ResourceYaml" YamlReadOnly="true" YamlTitle="@T("DataSourceYaml")" YamlDescription="@T("DatasetYamlHelp")" YamlInputTestId="dataset-yaml"
            Enabled="@(source is null ? null : model.Enabled)" EnabledChanged="SetEnabledAsync" EnabledDisabled="@(!CanManage || busy || resourceRefreshing)" EnabledTestId="dataset-enabled"
            SectionTestIdPrefix="dataset" TestId="data-source-dataset-editor">
            <PrimaryActions>@if (source is not null) { <button class="button-primary" type="button" data-testid="data-source-start-acquisition" disabled="@(busy || resourceRefreshing || !interactive || readiness?.CanAcquire != true)" @onclick="StartAsync"><UiIcon Name="play-circle" />@T("StartAcquisition")</button> }</PrimaryActions>
            <Actions><a class="button-secondary" href="/data-sources">@T("Back")</a></Actions>
            <OverviewMetrics><MetricCard Label="@T("Generation")" Value="@source?.Generation.ToString()" /><MetricCard Label="@T("State")" Value="@(readiness is null ? "—" : T(readiness.Ready ? "Ready" : "NotReady"))" Status="@(readiness is null ? UiStatus.Neutral : readiness.Ready ? UiStatus.Success : UiStatus.Warning)" /></OverviewMetrics>
            <OverviewConfiguration><CollectionView TItem="DatasetSetting" Items="SavedSettings" IdentityLabel="@T("Name")" InformationLabels="@(new[] { T("SourceSettingValue") })"><Identity Context="entry"><strong class="configuration-key">@entry.Label</strong></Identity><Information Context="entry"><CollectionValue Label="@T("SourceSettingValue")"><span class="configuration-value">@entry.Value</span></CollectionValue></Information></CollectionView></OverviewConfiguration>
            <OverviewContent>@OverviewContent</OverviewContent>
            <DefinitionContent Context="path">@form</DefinitionContent>
            <AdditionalContent Context="path">@if (path == "acquisitions") { @AcquisitionsContent } else if (path == "content") { @ContentView } else if (source is not null) { <FormSection Title="@T(path == "tools" ? "Tools" : "Queries")"><DataSourceQueries @key="source.Uid" Source="source" ShowTools="@(path == "tools")" Acquisitions="history" /></FormSection> }</AdditionalContent>
            <DraftActions><button class="text-button" type="button" disabled="@(busy || resourceRefreshing)" @onclick="CancelDefinitionAsync">@T("SourceDiscard")</button><button class="button-primary" type="submit" form="data-source-dataset-definition" data-testid="data-source-save" disabled="@(busy || resourceRefreshing)">@T("Save")</button></DraftActions>
        </ConsoleResourceDetailsTemplate>
    }
}

@code {
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Namespace { get; set; }
    [Parameter] public string? ScopeRef { get; set; }

    private readonly CancellationTokenSource cancellation = new();
    private DataSourceResource? source;
    private DataSourceReadiness? readiness;
    private ResourceScopeRef? scope;
    private string? etag, error, preview, errorCode, errorId, compositionErrorCode;
    private string savedServiceKey = "";
    private bool loading = true, busy, parametersValid = true, previewTruncated;
    private bool interactive;
    private DatasetTab activeTab => sectionState.CurrentPath.StartsWith("definition/", StringComparison.Ordinal) ? DatasetTab.Definition
        : Enum.TryParse<DatasetTab>(sectionState.CurrentPath, true, out var tab) ? tab : DatasetTab.Overview;

    private ConnectedServiceOperationResource? savedOperation;
    private string contentAcquisitionKey = "";
    private enum DatasetTab { Overview, Definition, Acquisitions, Content, Queries, Tools, Access, Yaml }
    private IEnumerable<DataSourceAcquisitionResource> OrderedHistory => history.OrderByDescending(item => item.CreatedAt);
    private static IReadOnlyDictionary<string, object> AcquisitionAttributes(DataSourceAcquisitionResource item) => new Dictionary<string, object> { ["data-state"] = item.State.ToString() };
    private IReadOnlyList<DataSourceAcquisitionResource> VisibleHistory => (activeTab == DatasetTab.Overview ? OrderedHistory.Take(3) : OrderedHistory).ToArray();
    private IEnumerable<DataSourceAcquisitionResource> ContentAcquisitions => OrderedHistory.Where(item => item.Content is not null && item.ContentRetiredAt is null);
    private DataSourceAcquisitionResource? SelectedContentAcquisition => ContentAcquisitions.FirstOrDefault(item => item.Uid.ToString() == contentAcquisitionKey);
    private DataSourceAcquisitionResource? LatestAcquisition => OrderedHistory.FirstOrDefault();
    private ConnectedServiceResource? SavedService => connectedServices.FirstOrDefault(item => item.Uid == savedOperation?.Definition.Service.ServiceUid
        && item.ScopeRef == savedOperation.Definition.Service.Service.ScopeRef && item.Address == savedOperation.Definition.Service.Service.Address);
    private string SavedOperationLabel => savedOperation is { } operation && source?.Definition.Dataset?.Acquisition.Operation is { } pin
        && operation.Generation == pin.Generation && operation.Definition.DefinitionDigest == pin.DefinitionDigest
        ? operation.Definition.DisplayName : source?.Definition.Dataset?.Acquisition.Operation.Operation.ToString() ?? "—";
    private string SavedStorageLabel => source?.Definition.Dataset is { Storage: null } ? T("DirectInput") : storages.FirstOrDefault(item => source?.Definition.Dataset?.Storage is { } pin
        && item.Uid == pin.StorageUid && item.ScopeRef == pin.Storage.ScopeRef && item.Address == pin.Storage.Address
        && item.Generation == pin.Generation && item.ObservedState?.BindingDigest == pin.BindingDigest)?.Definition.DisplayName
        ?? source?.Definition.Dataset?.Storage?.Storage.ToString() ?? "—";
    private string ResourceYaml => source is null ? "" : ResourceManifestSerializer.ToYaml(new RawSource(source.ApiVersion, source.Kind, source.Metadata, source.ScopeRef, source.Definition));
    private sealed record RawSource(string ApiVersion, string Kind, ResourceMetadata Metadata, ResourceScopeRef? ScopeRef, DataSourceProperties Definition);
    private void SelectTab(DatasetTab tab) => ShowSection(tab == DatasetTab.Definition ? "definition/identity" : tab.ToString().ToLowerInvariant());
    private void ShowSection(string path) => Navigation.NavigateTo(Navigation.Uri.Split('#')[0] + "#" + path);
    private static UiStatus AcquisitionTone(DataSourceAcquisitionState state) => state switch
    { DataSourceAcquisitionState.Succeeded => UiStatus.Success, DataSourceAcquisitionState.Failed or DataSourceAcquisitionState.Cancelled or DataSourceAcquisitionState.TimedOut => UiStatus.Warning, _ => UiStatus.Info };
    private Task CancelDefinitionAsync()
    {
        if (source is not null && !busy && !resourceRefreshing) ApplySnapshot(newerSnapshot ?? new(source, etag!));
        return Task.CompletedTask;
    }
    private async Task ChangeContentAcquisitionAsync(ChangeEventArgs args)
    {
        var item = ContentAcquisitions.FirstOrDefault(item => item.Uid.ToString() == args.Value?.ToString());
        if (item is null) CloseContent(); else await ReadAsync(item);
    }
    private void CloseContent() { preview = null; contentAcquisitionKey = ""; }
    private IReadOnlyList<StorageResource> storages = [];
    private IReadOnlyList<StorageTypeResource> storageTypes = [];
    private StorageResource? SelectedStorage => storages.FirstOrDefault(s => StorageKey(s) == model.StorageKey);
    private bool RequiresDocumentCollection => SelectedStorage?.Definition.Type is { } type && storageTypes
        .FirstOrDefault(t => t.Uid == type.TypeUid)?.Definition.Versions.FirstOrDefault(v => v.Version == type.Version)
        is { Documents: not null } version && (!version.Capabilities.List || !version.Capabilities.Read || !version.Capabilities.Write);
    private static bool CompatibleDocumentCollection(StorageDocumentCollection c) => c.Enabled && c.Policy.Get && c.Policy.Query && c.Policy.Publish;
    private bool DocumentCollectionValid => SelectedStorage is null && source?.Definition.Dataset?.DocumentCollectionUid is { } savedCollection
        && model.DocumentCollectionUid == savedCollection || (model.DocumentCollectionUid == Guid.Empty ? !RequiresDocumentCollection
        : SelectedStorage?.Definition.Collections.Any(c => c.Uid == model.DocumentCollectionUid && CompatibleDocumentCollection(c)) == true);
    private IReadOnlyList<ConnectedServiceOperationResource> operations = [];
    private IReadOnlyList<ConnectedServiceResource> connectedServices = [];
    private IReadOnlyList<ConnectedServiceOperationTypeResource> operationTypes = [];
    private IReadOnlyList<DataSourceAcquisitionResource> history = [];
    private bool IsNew => string.IsNullOrWhiteSpace(Name);
    private bool CanManage => Services.GetService<ConsoleContextState>()?.HasPermission(AuthorizationPermissions.ResourcesWrite) == true
        && (IsNew || source is { Governance.IsManaged: false } && scope is { } owner && ResourceOwnershipContext.CanManage(owner, Services));
    private ConnectedServiceResource? SelectedService => connectedServices.FirstOrDefault(item => item.Uid.ToString() == model.ServiceKey);
    private IEnumerable<ConnectedServiceOperationResource> ServiceOperations => operations.Where(item => SelectedService is { } service
        && item.Definition.Service.ServiceUid == service.Uid && item.Definition.Service.Service.ScopeRef == service.ScopeRef
        && item.Definition.Service.Service.Address == service.Address);
    private ConnectedServiceOperationResource? SelectedOperation => ServiceOperations.FirstOrDefault(item => OperationKey(item) == model.OperationKey);
    private bool HasSavedOperationPin => source?.Definition.Dataset?.Acquisition.Operation is { } saved
        && model.OperationKey == $"{saved.OperationUid}:{saved.Generation}:{saved.DefinitionDigest}" && model.ServiceKey == savedServiceKey;
    private bool HasOperationSelection => SelectedOperation is not null || HasSavedOperationPin;
    private ConnectedServiceOperationTypeVersionDescriptor? SelectedType
    {
        get
        {
            if (SelectedOperation is not { } operation) return null;
            var reference = operation.Definition.Type;
            return operationTypes.FirstOrDefault(type => type.Uid == reference.TypeUid && type.Definition.Enabled
                && type.ScopeRef == reference.Type.ScopeRef && type.Name == reference.Type.Name
                && type.Namespace == (reference.Type.Namespace ?? operation.Namespace))?.Definition.Versions.FirstOrDefault(version =>
                    version.Version == reference.Version && version.SchemaDigest == reference.SchemaDigest);
        }
    }
    private JsonElement? DefinitionSchema(string property) => SelectedOperation is { } operation
        && operation.Definition.Definition.ValueKind == JsonValueKind.Object
        && operation.Definition.Definition.TryGetProperty(property, out var schema) && schema.ValueKind == JsonValueKind.Object ? schema : null;
    private JsonElement? InputSchema => SelectedType?.Acquisition is { } adapter ? DefinitionSchema(adapter.InputSchemaProperty)
        : HasSavedOperationPin ? readiness?.Dataset?.InputSchema : null;
    private string? AcquisitionIssue => SelectedType is not { } type ? "DatasetOperationTypeUnavailable"
        : type.Acquisition is not { } adapter ? "DatasetOperationAdapterUnavailable"
        : type.Interaction != ConnectedServiceOperationInteraction.RequestResponse
            || SelectedOperation!.Definition.Definition.ValueKind != JsonValueKind.Object
            || !SelectedOperation.Definition.Definition.TryGetProperty(adapter.ReadOnlyProperty, out var readOnly)
            || readOnly.ValueKind != JsonValueKind.True ? "DatasetOperationNotReadOnly"
        : InputSchema is null || DefinitionSchema(adapter.OutputSchemaProperty) is null ? "DatasetOperationSchemaMissing" : null;
    private bool NoConfiguration => InputSchema is { ValueKind: JsonValueKind.Object } schema && schema.TryGetProperty("additionalProperties", out var additional) && additional.ValueKind == JsonValueKind.False
        && (!schema.TryGetProperty("properties", out var properties) || properties.EnumerateObject().Any() == false)
        && (!schema.TryGetProperty("required", out var required) || required.GetArrayLength() == 0);
    private string FailureMessage(string code)
    {
        var key = StorageErrorKey.ForCode(code);
        return key is "Error.BackendConnectionRefused" or "Error.BackendTimeout" or "Error.BackendUnavailable"
            ? StorageLocalizer[key].Value : T("DatasetExecutionFailed");
    }
    private string T(string key) => Localizer[key];
    private static string StorageKey(StorageResource item) => $"{item.Uid}:{item.Generation}:{item.ObservedState?.BindingDigest}";
    private static string OperationKey(ConnectedServiceOperationResource item) => $"{item.Uid}:{item.Generation}:{item.Definition.DefinitionDigest}";

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) { interactive = true; StateHasChanged(); }
    }
    protected override Task OnParametersSetAsync()
    {
        var key = $"{Name}|{Namespace}|{ScopeRef}|{new Uri(Navigation.Uri).Query}";
        if (key == loadedKey) return Task.CompletedTask;
        loadedKey = key;
        return LoadInitialAsync();
    }
    private void ApplySnapshot(ResourceSnapshot<DataSourceResource> snapshot)
    {
        source = snapshot.Value; etag = snapshot.ETag; scope = source.ScopeRef; newerSnapshot = null;
        var pin = source.Definition.Dataset!.Acquisition.Operation;
        savedOperation = operations.Concat(savedOperation is null ? [] : new[] { savedOperation }).FirstOrDefault(item => item.Uid == pin.OperationUid
            && item.ScopeRef == pin.Operation.ScopeRef && item.Address == pin.Operation.Address);
        savedServiceKey = savedOperation?.Definition.Service.ServiceUid.ToString() ?? "";
        model = DataSourceDatasetEditorModel.From(source, savedServiceKey);
        baseline = Fingerprint; definitionTouched = invalidInput = false;
    }
    private async Task LoadInitialAsync()
    {
        var version = ++loadVersion; ClearPrivateState(); loading = true; busy = resourceRefreshing = false;
        sectionState.Reset(loadedKey!); loadState = new(ResourceLoadStatus.Loading);
        try
        {
            scope = string.IsNullOrWhiteSpace(ScopeRef) ? ResourceOwnershipContext.TryGetCurrent(Services) : ResourceScopeRef.Parse(ScopeRef);
            if (!IsNew)
            {
                var snapshot = await Client.GetAsync(ResourceNamespace.Parse(Namespace), Name!, scope!.Value, cancellation.Token);
                if (disposed || version != loadVersion) return;
                if (!Matches(snapshot.Value)) { ClearPrivateState(); loadState = new(ResourceLoadStatus.NotFound); return; }
                var catalog = await Operations.GetAsync(cancellation.Token);
                if (disposed || version != loadVersion) return;
                savedOperation = catalog.FirstOrDefault(item => item.Uid == snapshot.Value.Definition.Dataset!.Acquisition.Operation.OperationUid
                    && item.ScopeRef == snapshot.Value.Definition.Dataset.Acquisition.Operation.Operation.ScopeRef && item.Address == snapshot.Value.Definition.Dataset.Acquisition.Operation.Operation.Address);
                ApplySnapshot(snapshot);
            }
            await RefreshCoreAsync();
            if (disposed || version != loadVersion) return;
            if (IsNew) { model.Scope = scope; baseline = Fingerprint; }
            loadState = new(ResourceLoadStatus.Ready) { HasContent = source is not null };
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        { if (version == loadVersion && !disposed) { ClearPrivateState(); loadState = Failure(exception); } }
        finally { if (version == loadVersion) loading = false; }
    }
    private async Task RefreshCoreAsync()
    {
        var version = loadVersion; var current = source; var owner = scope; var selection = model.ServiceKey;
        var services = await ConnectedServices.GetConnectedServicesAsync(cancellation.Token);
        var types = await Operations.GetTypesAsync(cancellation.Token);
        var service = services.FirstOrDefault(item => item.Uid.ToString() == selection);
        var choices = service is null ? [] : await Operations.GetForServiceAsync(service, cancellation.Token);
        var stores = owner is null ? [] : await Storages.GetStoragesAsync(owner.Value, cancellation.Token);
        var storeTypes = owner is null ? [] : await Storages.GetTypesAsync(owner.Value, cancellation.Token);
        var state = current is null ? null : await Client.GetReadinessAsync(current.Namespace, current.Name, current.ScopeRef!.Value, cancellation.Token);
        var records = current is null ? [] : await Client.GetAcquisitionsAsync(current.Namespace, current.Name, current.ScopeRef!.Value, cancellation.Token);
        if (version != loadVersion || disposed || selection != model.ServiceKey) return;
        connectedServices = services; operationTypes = types; operations = choices; storages = stores; storageTypes = storeTypes; readiness = state; history = records;
    }
    private async Task RefreshAsync()
    {
        if (loading || busy || resourceRefreshing) return;
        if (source is not { } current) { await RunAsync(RefreshCoreAsync); return; }
        var version = ++loadVersion; resourceRefreshing = true; loadState = new(ResourceLoadStatus.Refreshing) { HasContent = true };
        try
        {
            var snapshot = await Client.GetAsync(current.Namespace, current.Name, current.ScopeRef!.Value, cancellation.Token);
            if (disposed || version != loadVersion) return;
            if (!Matches(snapshot.Value, current.Uid)) { ClearPrivateState(); loadState = new(ResourceLoadStatus.NotFound); return; }
            if (HasDraft) { if (snapshot.ETag != etag) newerSnapshot = snapshot; } else ApplySnapshot(snapshot);
            await RefreshCoreAsync();
            if (version == loadVersion && !disposed) loadState = new(ResourceLoadStatus.Ready) { HasContent = true };
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            if (version != loadVersion || disposed) return;
            var failure = Failure(exception);
            if (failure.Status is ResourceLoadStatus.NotFound or ResourceLoadStatus.Forbidden) ClearPrivateState();
            loadState = failure with { HasContent = source is not null };
        }
        finally { if (version == loadVersion) resourceRefreshing = false; }
    }
    private async Task ChangeScopeAsync(ResourceScopeRef? value) { if (!IsNew) return; scope = model.Scope = value; model.StorageKey = ""; model.DocumentCollectionUid = Guid.Empty; model.ServiceKey = ""; ResetOperation(); await RefreshAsync(); }
    private async Task ChangeServiceAsync(ChangeEventArgs value) { model.ServiceKey = value.Value?.ToString() ?? ""; ResetOperation(); await RefreshAsync(); }
    private void ResetOperation() { model.OperationKey = ""; model.Parameters = JsonSerializer.SerializeToElement(new { }); parametersValid = true; preview = null; }
    private void ChangeOperation(ChangeEventArgs value) { model.OperationKey = value.Value?.ToString() ?? ""; model.Parameters = JsonSerializer.SerializeToElement(new { }); parametersValid = true; }
    private bool LifecycleValid => model.LifecycleValid;
    private DataSourceAcquisitionPolicy? LifecycleSelection() => model.LifecycleSelection();
    private RenderFragment IdentityContent => @<ResourceIdentityEditor ResourceKind="@DataSourceResourceKinds.DataSource"
        @bind-DisplayName="model.DisplayName" @bind-TechnicalName="model.Name" @bind-Namespace="model.Namespace" NamespaceEditable="IsNew" NamespaceUpdateOnInput="false"
        ScopeRef="model.Scope" ScopeRefChanged="ChangeScopeAsync" @bind-Description="model.Description" @bind-Labels="model.Tags" LabelsReadOnly="true"
        IsNew="IsNew" ReadOnly="@(!CanManage)" DisplayNameTestId="data-source-display-name" TechnicalNameTestId="data-source-name" NamespaceTestId="dataset-namespace">
        <AdditionalPanels>@if (IsNew) { <FormSection Title="@T("Enabled")"><label class="checkbox-field resource-enabled-toggle"><FormCheckbox @bind-Value="model.Enabled" role="switch" /><span>@T("Enabled")</span></label></FormSection> }</AdditionalPanels>
    </ResourceIdentityEditor>;

    private RenderFragment AcquisitionContent => @<div class="dataset-step-fields">
<section class="panel form-section"><h2>@T("DatasetSavedAcquisition")</h2><div class="form-grid">
                <FormField Label="@T("DatasetService")" Class="form-field-wide" Help="@T("DatasetServiceHelp")" Required="@(!HasSavedOperationPin)"><ClearableSelect TValue="string" Value="@model.ServiceKey" ValueExpression="@(() => model.ServiceKey)" ValueChanged="value => ChangeServiceAsync(new ChangeEventArgs { Value = value })" data-testid="dataset-service" required="@(!HasSavedOperationPin)">
                    <option value="">@T("Select")</option>
                    @foreach (var service in connectedServices) { <option value="@service.Uid.ToString()">@service.Definition.DisplayName · @service.ScopeRef · @service.Namespace/@service.Name</option> }
                    @if (!string.IsNullOrEmpty(model.ServiceKey) && SelectedService is null) { <option value="@model.ServiceKey">@T("DatasetPinnedUnavailable")</option> }
                </ClearableSelect></FormField>
                @if (SelectedService is { } selectedService)
                {
                    <p class="form-field-wide"><a class="text-button" href="@ServiceDiscoveryUrl(selectedService)" data-testid="dataset-service-discovery-link">@T("DatasetManageOperations")</a></p>
                }
                <FormField Label="@T("DatasetOperation")" Class="form-field-wide" Help="@T("DatasetOperationHelp")" Required="true"><ChildContent><ClearableSelect TValue="string" Value="@model.OperationKey" ValueExpression="@(() => model.OperationKey)" ValueChanged="value => ChangeOperation(new ChangeEventArgs { Value = value })" data-testid="dataset-operation" required Disabled="@(SelectedService is null && !HasSavedOperationPin)">
                    <option value="">@T("Select")</option>
                    @foreach (var operation in ServiceOperations) { <option value="@OperationKey(operation)">@operation.Definition.DisplayName · @operation.Generation · @T(operation.Enabled ? "Enabled" : "Disabled")</option> }
                    @if (HasSavedOperationPin && ServiceOperations.All(value => OperationKey(value) != model.OperationKey)) { <option value="@model.OperationKey">@source!.Definition.Dataset!.Acquisition.Operation.Operation · @T("DatasetPinnedUnavailable")</option> }
                </ClearableSelect></ChildContent><Validation><ValidationMessage For="@(() => model.OperationKey)" /></Validation></FormField>
                @if (SelectedService is not null && !ServiceOperations.Any() && !HasSavedOperationPin) { <p class="form-field-wide" role="status">@T("DatasetNoServiceOperations")</p> }
                @if (SelectedOperation is not null && AcquisitionIssue is { } issue)
                { <p class="form-field-wide form-alert" role="status" data-testid="dataset-operation-ineligible">@T(issue)</p> }
                <div class="form-field-wide" data-testid="dataset-parameters"><span>@T("Parameters")</span>
                    @if (string.IsNullOrEmpty(model.OperationKey)) { <p>@T("DatasetSelectOperationFirst")</p> }
                    else if (AcquisitionIssue is not null && SelectedOperation is not null) { <p>@T("DatasetParametersUnavailable")</p> }
                    else if (NoConfiguration) { <p>@T("DatasetNoConfiguration")</p> }
                    else { <JsonSchemaInputEditor Schema="InputSchema" Value="model.Parameters" ValueChanged="value => model.Parameters = value" ValidationChanged="ParametersValidated" Disabled="@(busy || !CanManage)" AllowAnyRoot="true" /> }
                    <small>@T("DatasetParametersHelp")</small>
                </div>
                    </div></section>
    </div>;

    private RenderFragment StorageContent => @<div class="dataset-step-fields">@StorageDestinationContent @StoragePolicyContent</div>;
    private RenderFragment StorageDestinationContent => @<div class="dataset-step-fields">
<section class="panel form-section"><h2>@T("DatasetDestination")</h2><div class="form-grid">
                <label class="checkbox-field resource-enabled-toggle form-field-wide"><FormCheckbox @bind-Value="model.AllowDirect" role="switch" data-testid="dataset-allow-direct" /><span>@T("DirectPermission")</span><small>@T("DirectPermissionHelp")</small></label>
                <FormField aria-invalid="@(StorageSelectionInvalid ? "true" : null)" Label="@T("DatasetStorage")" Class="form-field-wide" Help="@T("DatasetStorageHelp")" Required="@(!model.AllowDirect)"><ClearableSelect TValue="string" @bind-Value="model.StorageKey" @bind-Value:after="() => model.DocumentCollectionUid = Guid.Empty" data-testid="dataset-storage" required="@(!model.AllowDirect)">
                    <option value="">@T(model.AllowDirect ? "DirectInput" : "Select")</option>
                    @foreach (var storage in storages) { <option value="@StorageKey(storage)">@storage.Definition.DisplayName · @storage.ScopeRef · @storage.Namespace/@storage.Name · @storage.Generation</option> }
                    @if (source?.Definition.Dataset is { } saved && storages.All(value => StorageKey(value) != model.StorageKey)) { <option value="@model.StorageKey">@saved.Storage?.Storage · @T("DatasetPinnedUnavailable")</option> }
                </ClearableSelect></FormField>
                @if (!RequiresDocumentCollection && model.DocumentCollectionUid == Guid.Empty)
                {
                    <FormField Label="@T("DatasetPrefix")" Class="form-field-wide" Help="@T("DatasetPrefixHelp")"><ClearableText UpdateOnInput="false" @bind-Value="model.Prefix" maxlength="256" data-testid="dataset-prefix" /></FormField>
                }
                    @if (SelectedStorage is { } documentStorage && (RequiresDocumentCollection || documentStorage.Definition.Collections.Count > 0))
                    {
                        <FormField aria-invalid="@(!DocumentCollectionValid ? "true" : null)" Label="@T("DatasetDocumentCollection")" Class="form-field-wide" Help="@T("DatasetDocumentHelp")" Required="@RequiresDocumentCollection"><ClearableSelect AllowClear="false" TValue="Guid" @bind-Value="model.DocumentCollectionUid" data-testid="dataset-document-collection"><option value="@Guid.Empty">@T(RequiresDocumentCollection ? "DatasetDocumentSelect" : "DatasetContentStorage")</option>@foreach (var collection in documentStorage.Definition.Collections.Where(CompatibleDocumentCollection)) { <option value="@collection.Uid">@collection.DisplayName · @collection.Name</option> }</ClearableSelect></FormField>
