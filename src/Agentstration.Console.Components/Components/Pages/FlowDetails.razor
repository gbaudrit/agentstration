@page "/flows/{FlowId}"
@page "/namespaces/{FlowNamespace}/flows/{FlowId}"
@using Agentstration.Resources
@implements IDisposable
@inject IFlowApiClient Client
@inject NavigationManager Navigation
@inject ConsoleContextState ContextState
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<ResourceIdentityFieldsStrings> IdentityLocalizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@inject Microsoft.Extensions.Localization.IStringLocalizer<FlowsStrings> FlowLabels
@inject Microsoft.Extensions.Localization.IStringLocalizer<FlowDetailsStrings> Localizer

<PageTitle>@(flow?.DisplayName ?? flow?.Name ?? T("Flow")) · Agentstration</PageTitle>
@{
    var presentations = SectionPresentations;
    var renderIdentity = CurrentRenderIdentity;
}
<div data-testid="flow-observability-flow-details">
    <ConsoleResourceDetailsTemplate Resource="SavedIdentity" RequestedAddress="@ResourceAddress.Create(RequestedNamespace, FlowResourceKinds.Flow, FlowId)"
        Name="@(flow?.DisplayName ?? flow?.Name ?? FlowId)" Description="@flow?.Description" ResourceType="@T("Flow")" Domain="flow" IconName="workflow"
        Version="@PublishedVersion" VersionDescription="@T("PublishedVersion")"
        CollectionHref="@ResourceOwnershipContext.PreserveNavigation("/flows", Services)" CollectionLabel="@T("ListFlows")"
        StatusText="@(flow is null ? null : StatusLabel)" Status="@(HasPublishedVersion ? UiStatus.Success : UiStatus.Neutral)"
        Enabled="flow?.Enabled" EnabledChanged="ToggleEnabledAsync" EnabledDisabled="@(!IsEditable || Busy)" EnabledTestId="flow-enabled"
        ResourceIdentity="@($"{loadedKey}|{flow?.Uid}")" SectionState="sectionState" SectionPresentations="presentations" SelectionChanged="SelectSectionAsync"
        AdditionalSections="AdditionalSections" NavigationLabel="@T("DetailsAriaLabel")" SectionTestIdPrefix="flow"
        LoadState="loadState" OnRetry="RefreshAsync" OnRefresh="RefreshAsync" Busy="Busy" HasDraft="HasDefinitionDraft" HasAdditionalDraft="HasRunDraft"
        DefinitionReadOnlyReason="ReadOnlyReason" AccessVersion="PublishedVersion"
        Yaml="@FlowYaml" YamlReadOnly="true" YamlTitle="@Shared["ResourceManifest"]" YamlDescription="@T("ResourceManifestHelp")" YamlLabel="@Shared["ResourceManifest"]">
        <Metadata>@if (flow is not null) { <ResourceMetadataBadge Value="@FlowLabels[$"Kind.{flow.Definition.Kind}"]" /> }</Metadata>
        <PrimaryActions>
            @if (flow is not null && !IsOrchestration && IsEditable) { <a class="button-primary flow-header-designer" href="@EditorUrl" data-enhance-nav="false"><UiIcon Name="workflow" />@T("OpenFlowDesigner")</a> }
            @if (versions.Count > 0) { <button type="button" class="button-primary" data-testid="flow-run-open" disabled="@(!CanExecute || Busy)" @onclick="OpenRun">@T("RunFlow")</button> }
        </PrimaryActions>
        <Feedback>
            @if (error is not null && !showRun) { <p class="error-panel" role="alert">@error</p> }
            @if (HasNewerSnapshot) { <div class="form-alert form-alert-warning" role="status" data-testid="flow-refresh-conflict">@T("RefreshDraftConflict")</div> }
            @if (definitionError is not null) { <p class="error-panel" role="alert">@definitionError</p> }
            @if (definitionSaved && !DefinitionDirty) { <p class="flow-definition-success" role="status">@T("DefinitionSaved")</p> }
        </Feedback>
        <DraftActions>
            <button type="button" class="button-secondary" disabled="@Busy" @onclick="DiscardDefinitionAsync">@Shared["Discard"]</button>
            <button class="button-primary" type="submit" form="@(IsOrchestration ? orchestrationEditor?.FormId : "flow-definition-form")" disabled="@(Busy || (IsOrchestration ? orchestrationEditor?.CanSubmit != true : !CanEditDefinition))">@T("SaveDefinition")</button>
        </DraftActions>
        <OverviewMetrics>
            @if (flow is not null)
            {
                <MetricCard Label="@T("Status")" Value="@StatusLabel" Detail="@T("ImmutableVersions")" Status="@(HasPublishedVersion ? UiStatus.Success : UiStatus.Neutral)" />
                <MetricCard Label="@(IsOrchestration ? T("Participants") : T("Steps"))" Value="@TopologyNodeCount.ToString(System.Globalization.CultureInfo.InvariantCulture)" Detail="@(IsOrchestration ? StrategyLabel(Orchestration!.Strategy) : Topology.Layout)" Status="UiStatus.Neutral" />
                <MetricCard Label="@T("RecentRuns")" Value="@(runsKnown ? runs.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) : "—")" Detail="@(runsKnown ? SucceededRunCount(runs.Count(value => value.Status == FlowRunStatus.Succeeded)) : T("HistoryUnavailable"))" Status="UiStatus.Neutral" />
            }
        </OverviewMetrics>
        <OverviewConfiguration>
            <CollectionView TItem="SavedSetting" Items="SavedConfiguration" IdentityLabel="@Shared["Configuration"]" InformationLabels="@(new[] { Shared["Saved"].Value })">
                <Identity Context="setting"><strong class="configuration-key">@setting.Label</strong></Identity>
                <Information Context="setting"><CollectionValue Label="@Shared["Saved"]"><span class="configuration-value">@setting.Value</span></CollectionValue></Information>
            </CollectionView>
        </OverviewConfiguration>
        <OverviewContent>
            @if (flow is not null)
            {
                <FormSection Title="@T("ExecutionPreview")" Class="flow-overview-preview" Collapsible>
                    <Actions>@if (IsOrchestration) { <StatusBadge Text="@StrategyLabel(Orchestration!.Strategy)" Status="UiStatus.Info" /> }</Actions>
                    <ChildContent><FlowTopologyViewer Graph="PreviewTopology" Title="@T("FlowTopology")" InitiallyFit="true" /></ChildContent>
                </FormSection>
            }
        </OverviewContent>
        <DefinitionContent Context="path">
            @if (flow is not null && IsOrchestration)
            {
                <FlowOrchestrationEditor @ref="orchestrationEditor" FlowId="@flow.Id" FlowNamespace="@flow.Namespace.Value" ScopeRef="flow.ScopeRef"
                    Embedded="true" InitialSnapshot="snapshot" ExternalActions="true" ExternalBusy="Busy" DraftChanged="value => OrchestrationDraftChanged(renderIdentity, value)"
                    SavingChanged="value => OrchestrationSavingChanged(renderIdentity, value)" Saved="value => OrchestrationSavedAsync(renderIdentity, value)" SectionState="sectionState" SectionPresentations="presentations" SectionRequested="ShowSectionAsync" />
            }
            else if (definitionLoading) { <LoadingState Message="@T("Loading")" /> }
            else if (definitionContext is not null)
            {
                <div class="flow-definition-sheet flow-definition-form">
                    <ResourceDefinitionForm @key="definitionContext" @ref="definitionForm" EditContext="definitionContext" FieldLabels="FieldLabels"
                        OnValidSubmit="SaveDefinitionAsync" InvalidInputChanged="value => definitionInvalid = value" Id="flow-definition-form" FormName="flow-definition"
                        ReadOnly="@(!CanEditDefinition)" Busy="Busy" Sections="presentations" SectionState="sectionState" SectionContent="DefinitionSectionContent"
                        SectionRequested="ShowSectionAsync" data-testid="flow-definition-form" />
                </div>
            }
        </DefinitionContent>
        <AdditionalContent Context="path">
            @if (path == "runs")
            {
                <FormActions><a class="button-secondary" href="@ResourceOwnershipContext.PreserveNavigation("/flow-runs", Services)">@T("AllFlowRuns")</a></FormActions>
                @if (!runsKnown) { <ErrorState Title="@Shared["Unavailable"]" Message="@T("HistoryUnavailable")" /> }
                else if (runs.Count == 0) { <EmptyState Title="@T("NoRunsTitle")" Message="@T("NoRunsMessage")" /> }
                else { <RunGrid Runs="runs" /> }
            }
            else if (path == "deployments")
            {
                @if (!versionsKnown) { <ErrorState Title="@Shared["Unavailable"]" Message="@T("HistoryUnavailable")" /> }
                else
                {
                    <CollectionView TItem="FlowVersionResponse" Items="versions" InformationLabels="@(new string[] { T("Version"), T("Published") })" IdentityLabel="@T("Deployment")" StateLabel="@T("Status")">
                        <Identity Context="version"><code>local</code></Identity>
                        <State Context="version"><StatusBadge Text="@(version.Version == flow?.ActiveVersion ? T("Active") : T("Published"))" Status="@(version.Version == flow?.ActiveVersion ? UiStatus.Success : UiStatus.Info)" /></State>
                        <Information Context="version"><CollectionValue Label="@T("Version")">@version.Version</CollectionValue><CollectionValue Label="@T("Published")">@version.PublishedAt.LocalDateTime.ToString("g")</CollectionValue></Information>
                    </CollectionView>
                }
            }
        </AdditionalContent>
    </ConsoleResourceDetailsTemplate>
</div>

<div class="flow-run-modal-host">
<ModalFrame IsOpen="showRun" TitleId="run-flow-title" OnClose="() => showRun = false" Class="run-dialog">
    <section data-testid="flow-run-dialog"><h2 id="run-flow-title">@T("RunFlow")</h2><FormField Label="@T("PublishedVersion")"><ClearableSelect TValue="string" Value="runVersion" ValueChanged="ChangeRunVersion" AllowClear="false">@foreach (var version in versions) { <option value="@version.Version">@version.Version</option> }</ClearableSelect></FormField><div class="flow-run-input"><h3>@T("FlowInput")</h3><p class="muted">@T("FlowInputHelp")</p><JsonSchemaInputEditor Schema="SelectedRunVersion?.Graph?.InputSchema" Value="runInput" ValueChanged="value => runInput = value" ValidationChanged="UpdateRunInputValidation" Disabled="submitting" /></div>@if (error is not null) { <p class="error-panel" role="alert">@error</p> }<FormActions Class="dialog-actions"><button class="button-secondary" type="button" @onclick="() => showRun = false">@T("Cancel")</button><button class="button-primary" type="button" disabled="@(submitting || !runInputValid || !CanExecute || SelectedRunVersion is null)" data-testid="flow-run-submit" @onclick="SubmitRunAsync">@(submitting ? T("Starting") : T("RunFlow"))</button></FormActions></section>
</ModalFrame>
</div>

@code {
    private RenderFragment IdentityFields => @<ResourceIdentityEditor
        ResourceKind="@FlowResourceKinds.Flow" DisplayName="@definitionModel.DisplayName" DisplayNameChanged="value => definitionModel.DisplayName = value" DisplayNameExpression="@(() => definitionModel.DisplayName)"
        TechnicalName="@definitionModel.Name" TechnicalNameChanged="value => definitionModel.Name = value" TechnicalNameExpression="@(() => definitionModel.Name)"
        Namespace="@definitionModel.Namespace" NamespaceExpression="@(() => definitionModel.Namespace)" ScopeRef="flow?.ScopeRef"
        @bind-Description="definitionModel.Description" @bind-Labels="definitionModel.Tags" ReadOnly="@(!CanEditDefinition)" NamePolicy="ResourceNamePolicy.Flow"
        TestId="flow-identity-editor" DisplayNameTestId="flow-definition-display-name" TechnicalNameTestId="flow-definition-name" NamespaceTestId="flow-definition-namespace" DescriptionTestId="flow-definition-description" />;
    private RenderFragment ConfigurationFields => @<FormSection Title="@Shared["Configuration"]"><p>@T(CanEditDefinition ? "DefinitionDraftHelp" : "DefinitionPublishedHelp")</p></FormSection>;
    private RenderFragment<string> DefinitionSectionContent => path => path == "definition/identity" ? IdentityFields : ConfigurationFields;
    private RenderFragment? DesignerAction => flow is null || !IsEditable || IsOrchestration ? null : @<a class="button-primary" href="@EditorUrl" data-enhance-nav="false">@T(sectionState.Is("yaml") ? "OpenYamlEditor" : "OpenFlowDesigner")</a>;
    private RenderFragment? DiscardAction => !HasDefinitionDraft ? null : @<button type="button" class="button-secondary" disabled="@Busy" @onclick="DiscardDefinitionAsync">@Shared["Discard"]</button>;
    private IReadOnlyDictionary<string, ResourceSectionPresentation> SectionPresentations
    {
        get
        {
            var values = IsOrchestration
                ? new Dictionary<string, ResourceSectionPresentation>(FlowOrchestrationEditor.CreateSectionPresentations(!IsEditable), StringComparer.Ordinal)
                : new Dictionary<string, ResourceSectionPresentation>(StringComparer.Ordinal)
                {
                    ["definition/identity"] = new() { HasRequiredFields = true, Fields = [nameof(definitionModel.Name), nameof(definitionModel.Namespace), nameof(definitionModel.DisplayName), nameof(definitionModel.Description), nameof(definitionModel.Tags)], ReadOnly = !CanEditDefinition, ReadOnlyActions = DiscardAction },
                    ["definition/configuration"] = new() { Actions = DesignerAction, ReadOnlyActions = DesignerAction ?? DiscardAction }
                };
            if (IsOrchestration && HasDefinitionDraft)
            {
                foreach (var path in new[] { "definition/identity", "definition/configuration" })
                    values[path] = values[path] with { ReadOnlyActions = DiscardAction };
            }
            values["yaml"] = new() { ReadOnly = true, ReadOnlyActions = DesignerAction ?? DiscardAction };
            return values;
        }
    }
    private IReadOnlyDictionary<string, string> FieldLabels => new Dictionary<string, string>(StringComparer.Ordinal)
    {
        [nameof(definitionModel.Name)] = IdentityLocalizer["TechnicalName"], [nameof(definitionModel.Namespace)] = Shared["Namespace"],
        [nameof(definitionModel.DisplayName)] = T("DisplayName"), [nameof(definitionModel.Description)] = Shared["Description"], [nameof(definitionModel.Tags)] = Shared["Labels"]
    };
}
