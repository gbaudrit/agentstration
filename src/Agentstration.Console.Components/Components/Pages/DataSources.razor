@inject IServiceProvider Services
@page "/data-sources"
@implements IDisposable
@inject IDataSourcesClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<DataSourcesStrings> Localizer

<PageTitle>@T("DataSources") · Agentstration</PageTitle>
<PageHeader Title="@T("DataSources")" Description="@T("DataSourcesHelp")" TestId="resource-data-sources">
    <Actions><a class="button-primary" href="/data-sources/new">@T("Create")</a><a class="button-secondary" href="/data-source-profiles">@T("Profiles")</a><button class="button-secondary" type="button" @onclick="LoadAsync">@T("Refresh")</button></Actions>
</PageHeader>
@if (loading) { <LoadingState Message="@T("Loading")" /> }
else if (error is not null) { <ErrorState Message="@error" /> }
else if (items.Count == 0) { <EmptyState Title="@T("DataSources")" Message="@T("EmptySources")"><a class="button-primary" href="/data-sources/new">@T("Create")</a></EmptyState> }
else
{
    <CollectionView TItem="DataSourceResource" Items="items" InformationLabels="@(new string[] { T("Profile") })" IdentityLabel="@T("Name")" StateLabel="@T("State")">
        <Identity Context="item">
<CollectionIdentity DisplayName="@item.Definition.DisplayName" Namespace="@item.Namespace.Value" Name="@item.Name" Href="@Url(item)" IconName="database"><Badges><ManagedResourceBadge IsManaged="@item.Governance.IsManaged" /></Badges></CollectionIdentity></Identity>
        <Scope Context="item">
<ResourceScopeBadge ScopeRef="item.ScopeRef" ShowName /></Scope>
        <State Context="item">
<StatusBadge Text="@T(item.Definition.Enabled ? "Enabled" : "Disabled")" Status="@(item.Definition.Enabled ? UiStatus.Success : UiStatus.Warning)" /></State>
        <Information Context="item">
            <CollectionValue Label="@T("Profile")"><code>@item.Definition.Profile.Name</code></CollectionValue>
        </Information>
        <Actions Context="item">
<CollectionActions ResourceName="@($"{item.Definition.DisplayName} ({item.Namespace}/{item.Name}, {item.ScopeRef})")"><a class="text-button" href="@Url(item)">@T("Open")</a></CollectionActions></Actions>
    </CollectionView>
}

@code {
    private readonly CancellationTokenSource cancellation = new();
    private IReadOnlyList<DataSourceResource> items = [];
    private bool loading = true;
    private string? error;
    private string T(string key) => Localizer[key];
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync() { loading = true; error = null; try { items = await Client.GetAsync(cancellation.Token); } catch (Exception exception) { error = exception.Message; } finally { loading = false; } }
    private string Url(DataSourceResource item) => ResourceOwnershipContext.Resource(Services, "/data-sources", item.Name, item.Namespace, item.ScopeRef);
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
