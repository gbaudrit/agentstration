@page "/data-sources"
@implements IDisposable
@inject IServiceProvider Services
@inject IDataSourcesClient Client
@inject ConsoleContextState Context
@inject Microsoft.Extensions.Localization.IStringLocalizer<DataSourcesStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared

<PageTitle>@T("DataSources") · Agentstration</PageTitle>
<ResourceCollectionTemplate TItem="DataSourceResource" Title="@T("DataSources")" Description="@T("DataSourcesHelp")" TestId="resource-data-sources"
                            IdentityColumn="IdentityColumn" Columns="Columns" AdditionalFilters="ExtraFilters" Items="PageItems" ContextKey="@contextKey"
                            Query="query" QueryChanged="ChangeQueryAsync" Pagination="Pagination" LoadState="loadState" Disabled="@(!interactive)"
                            SearchEnabled SearchLabel="@Shared["Search"]" SearchPlaceholder="@Shared["Search"]"
                            EmptyTitle="@T("DataSources")" EmptyMessage="@T("EmptySources")" PrimaryActions="CreateAction" EmptyActions="CreateAction"
                            OnRefresh="LoadAsync" OnRetry="RetryAsync">
    <Actions><a class="button-secondary" href="@Navigate("/data-source-profiles")">@T("Profiles")</a></Actions>
</ResourceCollectionTemplate>

@code {
    private string T(string key) => Localizer[key].Value;
    private RenderFragment? CreateAction => Context.HasPermission(AuthorizationPermissions.ResourcesWrite)
        ? @<PermissionGate Permission="@AuthorizationPermissions.ResourcesWrite"><a class="button-primary" href="@Navigate("/data-sources/new?composition=dataset")">@T("Create")</a></PermissionGate> : null;
    private CollectionColumn<DataSourceResource> IdentityColumn => new("identity", T("Name"), item => @<CollectionIdentity DisplayName="@item.Definition.DisplayName" Namespace="@item.Namespace.Value" Name="@item.Name" Href="@Url(item)" IconName="database">
        <IconBadges><ResourceScopeBadge ScopeRef="item.ScopeRef" ShowName IconOnly /><StatusBadge Text="@T(item.Definition.Enabled ? "Enabled" : "Disabled")" Status="@(item.Definition.Enabled ? UiStatus.Success : UiStatus.Warning)" IconOnly /><ManagedResourceBadge IsManaged="@item.Governance.IsManaged" IsReadOnly="@(!ResourceOwnershipContext.CanManage(item.ScopeRef, Services))" IconOnly /></IconBadges>
    </CollectionIdentity>)
    {
        Filters = [new("enabled", T("State"), CollectionFilterKind.Choice) { Options = [new("true", T("Enabled")), new("false", T("Disabled"))] }]
    };
    private IReadOnlyList<CollectionColumn<DataSourceResource>> Columns =>
    [
        new("binding", T("DatasetStorageOrProfile"), item => @<code>@BindingText(item)</code>)
        {
            Filters = [new("binding", T("DatasetStorageOrProfile"), CollectionFilterKind.Text) { Advanced = true }]
        }
    ];
    private IReadOnlyList<CollectionFilter> ExtraFilters =>
    [
        new("namespace", T("Namespace"), CollectionFilterKind.Choice)
        {
            Options = (items ?? []).Select(item => item.Namespace.Value).Distinct(StringComparer.Ordinal).Order().Select(value => new CollectionFilterOption(value, value)).ToArray()
        },
        new("scope", Shared["Scope"], CollectionFilterKind.Choice)
        {
            Options = (items ?? []).Select(item => item.ScopeRef?.Value).OfType<string>().Distinct(StringComparer.Ordinal).Order().Select(value => new CollectionFilterOption(value, Context.Current?.Contexts.FirstOrDefault(context => context.ScopeRef == value)?.DisplayName ?? value)).ToArray()
        }
    ];
    private string BindingText(DataSourceResource item) => item.Definition.Dataset is { Storage: null } ? T("DirectInput") : item.Definition.Dataset?.Storage?.Storage.Name ?? item.Definition.Profile?.Name ?? "—";
    private string Navigate(string path) => ResourceOwnershipContext.PreserveNavigation(path, Services);
    private string Url(DataSourceResource item) => ResourceOwnershipContext.Resource(Services, "/data-sources", item.Name, item.Namespace, item.ScopeRef);
}
