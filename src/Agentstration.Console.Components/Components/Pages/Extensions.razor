@page "/extensions"
@implements IDisposable
@inject IExtensionsClient Client
@inject IModelProfilesClient ProfilesClient
@inject NotificationState Notifications
@inject IServiceProvider Services
@inject IJSRuntime JavaScript
@inject Microsoft.Extensions.Localization.IStringLocalizer<ExtensionStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@inject Microsoft.Extensions.Localization.IStringLocalizer<ResourceIdentityFieldsStrings> IdentityLocalizer

@if (editing) { <UnsavedNavigationGuard IsDirty="HasRegistrationDraft" HasUnsavedChanges="@(() => HasRegistrationDraft)" ViewQueryParameters="@(new[] { "tab" })" /> }

<PageTitle>@T("Extensions") · Agentstration</PageTitle>
<div class="extensions-list" data-testid="distribution-extensions" data-interactive="@(interactive ? "true" : "false")">
    <ResourceCollectionTemplate TItem="ExtensionInventoryItemResponse" Title="@T("Extensions")" Description="@T("UnifiedInventory.Description")" TestId="extensions-catalog" ContextKey="@catalogContextKey" RowTestId="extension-inventory-row"
                                Items="@(inventory ?? [])" IdentityColumn="InventoryIdentity" Columns="InventoryColumns" LoadState="catalogLoadState" Disabled="@(!interactive)" OnRefresh="LoadAsync" OnRetry="LoadAsync"
                                Metrics="@(inventory is null ? null : SummaryMetrics)" Details="EnrollmentDetails" IsExpanded="IsEnrollmentExpanded"
                                ItemActions="InventoryActions" EmptyTitle="@T("NoExtensionsDiscovered")" EmptyMessage="@T("NoExtensionsDiscoveredMessage")">
        <PrimaryActions>@if (CanRegister) { <button class="button-primary" @onclick="StartCreate" disabled="@(loading || editing)">@T("RegisterEndpoint")</button> }</PrimaryActions>
        <Actions>@if (CanAdministerEnrollments && enrollmentSettings is not null) { <button class="button-secondary" type="button" data-testid="extension-enrollment-settings" @onclick="OpenEnrollmentSettings" disabled="@(loading || pairingBusy)"><UiIcon Name="settings" /> @T("EnrollmentModes")</button> }</Actions>
        <EmptyActions>@if (CanRegister) { <button class="button-primary" @onclick="StartCreate" disabled="@(loading || editing)">@T("RegisterEndpoint")</button> }</EmptyActions>
        <Feedback>
            @if (catalogLoadState.Status == ResourceLoadStatus.Forbidden && CanRegister) { <FormActions><button type="button" class="button-primary" @onclick="StartCreate" disabled="@(loading || editing)">@T("RegisterEndpoint")</button></FormActions> }
            @if (error is not null && !editing && !showEnrollmentSettings) { <ErrorState Message="@error.Message" ErrorId="@error.ErrorId" /> }
            @if (activePairingCode is not null)
            {
                <div class="inline-warning" role="status"><strong>@T("PairingCode")</strong> <code>@activePairingCode</code>@if (activePairingExpiry is { } expiry) { <span> · @T("CodeExpiresIn", SecondsRemaining(expiry))</span> }@if (clipboardFallback) { <p>@T("ClipboardFallback")</p><button class="button-secondary" @onclick="CopyCodeAsync">@T("Copy")</button><button class="button-secondary" @onclick="OpenExtension">@T("OpenExtension")</button> }</div>
            }
        </Feedback>
    </ResourceCollectionTemplate>

    <ResourceCollectionPreview @ref="preview" ResourceKind="@ExtensionKinds.ExtensionRegistration" ContextKey="@catalogContextKey" Enabled="CanPreview" OnClosed="PreviewClosed">
        <ChildContent Context="address"><ExtensionResourcePreview Address="address" OverviewHref="@PreviewUrl(address, "overview")" DefinitionHref="@PreviewUrl(address, "definition/configuration")"
            CanManageEnrollment="@(PreviewEnrollment(address) is not null)" OnManageEnrollment="() => OpenPreviewEnrollment(address)" /></ChildContent>
    </ResourceCollectionPreview>
    <ResourceCollectionPreview @ref="enrollmentPreview" ResourceKind="@ExtensionKinds.AepEnrollmentRequest" ContextKey="@catalogContextKey" Enabled="CanPreview">
        <ChildContent Context="address"><AepEnrollmentResourcePreview Address="address" OverviewHref="" DefinitionHref="" /></ChildContent>
    </ResourceCollectionPreview>


    @if (editing)
    {
        <ModalFrame IsOpen TitleId="extension-register-title" OnClose="CancelEdit" Busy="saving" Class="extension-settings-dialog">
            <h2 id="extension-register-title">@T("RegisterEndpoint")</h2>
            <div class="resource-editor-view" data-testid="extension-registration-creation">
                @if (registrationError is not null) { <div class="form-alert form-alert-danger" role="alert">@registrationError</div> }
                <ResourceDefinitionForm @key="form" @ref="registrationDefinitionForm" EditContext="RegistrationContext" FieldLabels="RegistrationFieldLabels" Id="extension-registration-create-form" FormName="extension-registration-create"
                    Sections="RegistrationPresentations" OnValidSubmit="SubmitRegistrationAsync" OnInvalidSubmit="InvalidRegistrationAsync" InvalidInputChanged="value => registrationInvalidInput = value" Busy="saving" ReadOnly="@(!CanRegister)" data-testid="extension-registration-create-form">
                    <p class="required-fields-note"><span aria-hidden="true">*</span> @Shared["RequiredFields"]</p>
                    <CreationWizard @ref="registrationWizard" Steps="RegistrationSteps" OnFinish="FinishRegistrationAsync" OnStepReady="RegistrationStepReady" Busy="saving" Disabled="@(!CanRegister)"
                        FinishLabel="@(creating ? T("CreateRegistration") : T("SaveChanges"))" FinishTestId="extension-create-registration" TestId="extension-registration-wizard" />
                </ResourceDefinitionForm>
                <FormActions Busy="saving"><button class="button-secondary" type="button" @onclick="CancelEdit" disabled="@saving">@T("Cancel")</button></FormActions>
            </div>
        </ModalFrame>
    }
    @if (showEnrollmentSettings && CanAdministerEnrollments && enrollmentSettings is not null)
    {
        <ModalFrame IsOpen TitleId="extension-settings-title" OnClose="CloseEnrollmentSettings" Busy="savingEnrollmentSettings" Class="extension-policy-dialog">
            <div class="extension-policy-header">
                <h2 id="extension-settings-title">@T("EnrollmentModes")</h2>
                <button type="button" class="icon-button" aria-label="@T("CloseEnrollmentModes")" title="@T("CloseEnrollmentModes")" @onclick="CloseEnrollmentSettings" disabled="@savingEnrollmentSettings"><UiIcon Name="x" /></button>
            </div>
            @if (error is not null) { <ErrorState Message="@error.Message" ErrorId="@error.ErrorId" /> }
            <div class="extension-enrollment-modes">
                <div class="extension-enrollment-mode">
                    <label class="resource-enabled-toggle extension-enrollment-mode-heading">
                        <span>@T("PairingCodeMode")</span>
                        <FormCheckbox role="switch" aria-describedby="pairing-code-mode-help" @bind-Value="pairingCodeEnabled" disabled="@(!enrollmentSettings.PairingCodeConfigurable || savingEnrollmentSettings)" />
                    </label>
                    <p id="pairing-code-mode-help">@T("PairingCodeMode.Help")@if (!enrollmentSettings.PairingCodeConfigurable) { <span class="extension-mode-lock">@T("ModeDisabledByConfiguration")</span> }</p>
                </div>
                <div class="extension-enrollment-mode">
                    <label class="resource-enabled-toggle extension-enrollment-mode-heading">
                        <span>@T("SharedKeyFileMode")</span>
                        <FormCheckbox role="switch" aria-describedby="shared-key-mode-help" @bind-Value="sharedKeyFileEnabled" disabled="@(!enrollmentSettings.SharedKeyFileConfigurable || savingEnrollmentSettings)" />
                    </label>
                    <p id="shared-key-mode-help">@T("SharedKeyFileMode.Help")@if (!enrollmentSettings.SharedKeyFileConfigurable) { <span class="extension-mode-lock">@T("ModeDisabledByConfiguration")</span> }</p>
                </div>
            </div>
            <FormActions Busy="savingEnrollmentSettings">
                <button class="button-secondary" type="button" @onclick="CloseEnrollmentSettings" disabled="@savingEnrollmentSettings">@Shared["Cancel"]</button>
                <button class="button-primary" type="button" @onclick="SaveEnrollmentSettingsAsync" disabled="@savingEnrollmentSettings">@(savingEnrollmentSettings ? T("Saving") : T("SaveChanges"))</button>
            </FormActions>
        </ModalFrame>
    }
    <ConfirmationDialog IsOpen="@(pendingUnenrollment is not null)" Title="@T("UnenrollExtension")" Message="@T("UnenrollExtensionMessage")" ConfirmLabel="@T("ConfirmUnenrollExtension")" OnConfirm="UnenrollAsync" OnCancel="CancelUnenrollment" />
</div>

@code {
    private RenderFragment RegistrationIdentity => @<FormSection Title="@Shared["Identity"]"><FormGrid>
        <ResourceIdentityFields DisplayName="@form.DisplayName" DisplayNameChanged="value => form.DisplayName = value" DisplayNameExpression="@(() => form.DisplayName)"
            TechnicalName="@form.Name" TechnicalNameChanged="value => form.Name = value" TechnicalNameExpression="@(() => form.Name)" IsNew="creating"
            DisplayNameTestId="extension-registration-display-name" TechnicalNameTestId="extension-registration-name" />
        <FormField Label="@T("Namespace")" Required><ChildContent><ClearableText UpdateOnInput="false" @bind-Value="form.Namespace" Disabled="@(!creating)" data-testid="extension-registration-namespace" /></ChildContent><Validation><ValidationMessage For="() => form.Namespace" /></Validation></FormField>
        <ResourceScopeFormField ResourceKind="@ExtensionKinds.ExtensionRegistration" RequiredKind="@ResourceScopeKind.Tenant" Value="form.ScopeRef" ValueChanged="RegistrationScopeChanged" Disabled="@(!creating || !CanRegister || saving)"><Validation><ValidationMessage For="() => form.ScopeRef" /></Validation></ResourceScopeFormField>
    </FormGrid></FormSection>;
    private RenderFragment RegistrationConnection => @<FormSection Title="@T("Connection")"><FormGrid>
        <FormField Label="@T("AepEndpoint")" Required><ChildContent><ClearableText @bind-Value="form.Endpoint" placeholder="https://extension.example/aep/" data-testid="extension-registration-endpoint" /></ChildContent><Validation><ValidationMessage For="() => form.Endpoint" /></Validation></FormField>
        <FormField Label="@T("ExpectedExtensionId")"><HelpContent>@T("ExpectedExtensionId.Help")</HelpContent><ChildContent><ClearableText @bind-Value="form.ExpectedExtensionId" data-testid="extension-registration-expected-id" /></ChildContent></FormField>
        <label class="resource-enabled-toggle"><FormCheckbox role="switch" @bind-Value="form.Enabled" data-testid="extension-registration-enabled" /><span>@T("EnabledForDiscovery")</span></label>
    </FormGrid></FormSection>;
    private RenderFragment RegistrationAuthentication => @<FormSection Title="@T("AuthenticationMode")"><FormGrid>
        <FormField Label="@T("AuthenticationMode")"><ChildContent><ClearableSelect @bind-Value="form.AuthenticationMode" data-testid="extension-registration-authentication"><option value="@AepTransportAuthenticationMode.None">@T("Authentication.None")</option><option value="@AepTransportAuthenticationMode.StaticBearer">@T("Authentication.StaticBearer")</option></ClearableSelect></ChildContent></FormField>
        <div class="resource-editor-view form-span-2" hidden="@(form.AuthenticationMode != AepTransportAuthenticationMode.StaticBearer)">
            <FormField Label="@T("CredentialName")" Required><ChildContent><ClearableText @bind-Value="form.CredentialName" data-testid="extension-registration-credential-name" /></ChildContent><Validation><ValidationMessage For="() => form.CredentialName" /></Validation></FormField>
            <FormField Label="@T("CredentialNamespace")"><ChildContent><ClearableText @bind-Value="form.CredentialNamespace" data-testid="extension-registration-credential-namespace" /></ChildContent><Validation><ValidationMessage For="() => form.CredentialNamespace" /></Validation></FormField>
            <FormField Label="@T("CredentialScopeRef")"><HelpContent>@T("CredentialScopeRef.Help")</HelpContent><ChildContent><ClearableText @bind-Value="form.CredentialScopeRef" data-testid="extension-registration-credential-scope" /></ChildContent><Validation><ValidationMessage For="() => form.CredentialScopeRef" /></Validation></FormField>
        </div>
    </FormGrid></FormSection>;
    private RenderFragment RegistrationReview => @<FormSection Title="@Shared["Verification"]"><dl class="resource-details">
        <dt>@T("DisplayName")</dt><dd>@form.DisplayName</dd><dt>@T("Name")</dt><dd><code>@form.Namespace/@form.Name</code></dd><dt>@Shared["Scope"]</dt><dd><ResourceScopeBadge ScopeRef="form.ScopeRef" /></dd>
        <dt>@T("AepEndpoint")</dt><dd class="resource-text">@form.Endpoint</dd><dt>@T("ExpectedExtensionId")</dt><dd>@(form.ExpectedExtensionId ?? "—")</dd>
        <dt>@T("AuthenticationMode")</dt><dd>@T($"Authentication.{form.AuthenticationMode}")</dd>
        @if (form.AuthenticationMode == AepTransportAuthenticationMode.StaticBearer) { <dt>@T("CredentialName")</dt><dd><code>@form.CredentialScopeRef · @form.CredentialNamespace/@form.CredentialName</code></dd> }
        <dt>@T("EnabledForDiscovery")</dt><dd>@T(form.Enabled ? "Enabled" : "Disabled")</dd>
    </dl></FormSection>;

    private RenderFragment SummaryMetrics => @<text>
        <MetricCard Label="@T("LoadedExtensions")" Value="@(inventory?.Count.ToString() ?? "—")" Detail="@T("AvailableExtensions", AvailableExtensionCount)" HelpText="@T("InventorySnapshot.Help")" Status="@(AvailableExtensionCount > 0 ? UiStatus.Success : UiStatus.Neutral)" />
        @if (CanAdministerEnrollments) { <MetricCard Label="@T("Tab.Enrollments")" Value="@(enrollments is null ? "—" : ActiveEnrollmentCount.ToString())" Detail="@T("ActiveEnrollments", ActiveEnrollmentCount)" Status="@(ActiveEnrollmentCount > 0 ? UiStatus.Warning : UiStatus.Success)" /> }
        <MetricCard Label="@T("Connections")" Value="@(registrations?.Count.ToString() ?? "—")" Detail="@T("EnabledEndpoints", EnabledRegistrationCount)" Status="@(EnabledRegistrationCount > 0 ? UiStatus.Info : UiStatus.Neutral)" />
        @if (CanAdministerEnrollments) { <MetricCard Label="@T("EnrollmentModes")" Value="@(enrollmentSettings is null ? "—" : $"{EnabledEnrollmentModeCount}/2")" Detail="@T("EnabledEnrollmentModes", EnabledEnrollmentModeCount)" Status="@(EnabledEnrollmentModeCount > 0 ? UiStatus.Info : UiStatus.Warning)" /> }
    </text>;
    private RenderFragment<ExtensionInventoryItemResponse> InventoryActions => item => @<CollectionActions ResourceName="@($"{item.DisplayName} ({item.RegistrationNamespace}/{item.RegistrationName ?? item.ExtensionId}, {item.RegistrationScopeRef})")">
        <a href="@(DetailUrl(item) + "#overview")"><UiIcon Name="arrow-up-right" /><span>@Shared["OpenItem"]</span></a>
        @if (CanEditItem(item)) { <a href="@(DetailUrl(item) + "#definition/configuration")"><UiIcon Name="pencil" /><span>@Shared["EditDefinition"]</span></a> }
        @if (item.RegistrationName is not null && item.RegistrationScopeRef is not null) { <button type="button" data-testid="extension-preview" disabled="@(!CanPreview || loading || pairingBusy)" @onclick="() => OpenPreview(item)"><UiIcon Name="eye" /><span>@Shared["Preview"]</span></button> }
        @if (item.RegistrationName is null && EnrollmentFor(item) is { } inspectable) { <button type="button" data-testid="extension-enrollment-preview" disabled="@(!CanPreview || loading || pairingBusy)" @onclick="() => OpenEnrollmentPreview(inspectable)"><UiIcon Name="eye" />@Shared["Preview"]</button> }
        @if (EnrollmentFor(item) is { } enrollment) { <button type="button" data-testid="extension-enrollment-open" aria-expanded="@IsEnrollmentExpanded(item).ToString().ToLowerInvariant()" aria-controls="@EnrollmentPanelId(enrollment)" disabled="@(loading || pairingBusy)" @onclick="() => ToggleEnrollment(item)"><UiIcon Name="key" /><span>@T(IsEnrollmentExpanded(item) ? "CloseEnrollment" : "ManageEnrollment")</span></button> }
        @if (item.Extension?.Contributions.Any(value => value.Kind == "source-provider") == true) { @SourceActions(item) }
    </CollectionActions>;
    private RenderFragment SourceActions(ExtensionInventoryItemResponse item) => @<text>
                        <div class="inventory-contribution-actions">
                            @foreach (var provider in SourceProviders(item))
                            {
                                <a class="text-button" href="@SourceProviderUrl(provider)">@T("OpenSourceProvider", provider.Name)</a>
                            }
                            @if (item.RegistrationName is not null && item.RegistrationScopeRef is not null)
                            {
                                @foreach (var contribution in item.Extension!.Contributions.Where(value => value.Kind == "source-provider" && !SourceProviders(item).Any(provider => provider.ContributionId.Equals(value.Id, StringComparison.OrdinalIgnoreCase))))
                                {
                                    <a class="text-button" href="@ConfigureSourceProviderUrl(item, contribution)">@T("ConfigureSourceProvider", contribution.Id)</a>
                                }
                            }
                        </div>
    </text>;
    private CollectionColumn<ExtensionInventoryItemResponse> InventoryIdentity => new("identity", T("Extension"), item => @<text><CollectionIdentity DisplayName="@item.DisplayName" Namespace="@(item.RegistrationName is null ? null : item.RegistrationNamespace)" Name="@(item.RegistrationName ?? item.ExtensionId)" Href="@DetailUrl(item)" IconName="puzzle"><Versions><CollectionVersion Label="@T("Version")" Value="@(item.Version)" /></Versions><IconBadges><ResourceScopeBadge ScopeRef="item.RegistrationScopeRef" IconOnly /><StatusBadge Text="@StatusLabel(item.AvailabilityStatus)" Status="@ModelManagementUi.Status(item.AvailabilityStatus)" IconOnly /><ManagedResourceBadge IsReadOnly="@(!ResourceOwnershipContext.CanManage(item.RegistrationScopeRef, Services))" IconOnly /></IconBadges></CollectionIdentity></text>);

    private IReadOnlyList<CollectionColumn<ExtensionInventoryItemResponse>> InventoryColumns =>
    [
        new("connection", T("Connection"), item => @<text><a class="text-button extension-endpoint" href="@item.Endpoint.AbsoluteUri" target="_blank" rel="noopener noreferrer">@item.Endpoint</a><small>@SourceLabel(item.RegistrationSource) · @T("ConnectionCount", item.Connections.Count)</small></text>),
        new("enrollment", T("Enrollment"), item => @<div class="enrollment-cell">
            @if (item.EnrollmentStatus is { } state) { <StatusBadge Text="@EnrollmentStatusLabel(state)" Status="@EnrollmentStatus(state)" /> } else { <span>—</span> }
            @if (EnrollmentFor(item) is { } enrollment)
            {
                <button type="button" class="button-secondary enrollment-shortcut" data-testid="extension-enrollment-shortcut" title="@T(IsEnrollmentExpanded(item) ? "CloseEnrollment" : "ManageEnrollment")"
                    aria-label="@T(IsEnrollmentExpanded(item) ? "CloseEnrollment" : "ManageEnrollment")" aria-expanded="@IsEnrollmentExpanded(item).ToString().ToLowerInvariant()"
                    aria-controls="@EnrollmentPanelId(enrollment)" disabled="@(loading || pairingBusy)" @onclick="() => ToggleEnrollment(item)">
                    <UiIcon Name="key" /><span>@T(IsEnrollmentExpanded(item) ? "CloseEnrollmentAction" : "ManageEnrollmentAction")</span>
                </button>
            }
        </div>),
        new("contributions", T("Contributions"), item => @<text>@if (item.Extension?.Contributions.Count is > 0) { <a class="text-button extension-contributions-link" href="@ContributionsUrl(item)" title="@ContributionSummary(item)">@T(item.Extension.Contributions.Count == 1 ? "ContributionCount.One" : "ContributionCount.Many", item.Extension.Contributions.Count)</a> } else { <span>—</span> }</text>)
    ];
    private RenderFragment<ExtensionInventoryItemResponse> EnrollmentDetails => item => @<text>@if (EnrollmentFor(item) is { } enrollment) {
        var requiresScope = enrollment.Definition.TargetScopeRef is null || enrollment.Definition.State == AepEnrollmentState.Unpaired;
        <div @ref="enrollmentPanel" class="enrollment-details" id="@EnrollmentPanelId(enrollment)" tabindex="-1" role="region" aria-labelledby="@(EnrollmentPanelId(enrollment) + "-title")" data-testid="enrollment-card">
            <div class="enrollment-details-heading"><h3 id="@(EnrollmentPanelId(enrollment) + "-title")">@T("Enrollment")</h3><StatusBadge Text="@EnrollmentStatusLabel(enrollment.Definition.State)" Status="@EnrollmentStatus(enrollment.Definition.State)" /><small>@T("AnnouncedAgo", EnrollmentAge(enrollment))</small>@if (enrollment.Definition.CodeExpiresAt is { } expires && enrollment.Definition.State == AepEnrollmentState.CodeIssued) { <small>@T("CodeExpiresIn", SecondsRemaining(expires))</small> }</div>
            <FormGrid Class="enrollment-fields">
                <div class="enrollment-scope">@if (requiresScope) { <ResourceScopeFormField ResourceKind="@ExtensionKinds.ExtensionRegistration" Value="@EnrollmentScope(enrollment)" ValueChanged="scope => SetEnrollmentScope(enrollment, scope)" /> } else { <ResourceScopeReadOnlyField ScopeRef="enrollment.Definition.TargetScopeRef" /> }</div>
                @if (enrollment.Definition.PairingUri is { } pairingUri) { <FormField Label="@T("PairingOriginLabel")"><div class="enrollment-origin-field"><ClearableText Value="@pairingUri.GetLeftPart(UriPartial.Authority)" ReadOnly AllowClear="false" /><a class="icon-button" href="@pairingUri.AbsoluteUri" target="_blank" rel="noopener noreferrer" aria-label="@T("OpenExtension")" title="@pairingUri.AbsoluteUri"><UiIcon Name="external-link" /></a></div></FormField> }
            </FormGrid>
            <FormActions Class="enrollment-action-layout" Busy="pairingBusy">
        @if (enrollment.Definition.EnrollmentMode == AepEnrollmentMode.PairingCode && CanRotate(enrollment.Definition.State))
        {
            <div class="enrollment-actions"><CollectionActions ResourceName="@enrollment.Definition.ExtensionName"><Primary><button class="button-secondary" @onclick="() => CancelEnrollmentAsync(enrollment)" disabled="@pairingBusy">@T("CancelEnrollmentRequest")</button><button class="button-secondary" @onclick="() => RejectAsync(enrollment)" disabled="@pairingBusy">@T("Reject")</button><button class="button-primary" @onclick="() => EnrollAsync(enrollment)" disabled="@pairingBusy">@T("EnrollExtension")</button></Primary></CollectionActions></div>
        }
        else if (enrollment.Definition.EnrollmentMode == AepEnrollmentMode.SharedKeyFile
            && (requiresScope || enrollment.Definition.State == AepEnrollmentState.Unpaired))
        {
            <div class="enrollment-actions"><CollectionActions ResourceName="@enrollment.Definition.ExtensionName"><Primary><button class="button-primary" @onclick="() => AssignSharedKeyAsync(enrollment)" disabled="@pairingBusy">@T("EnrollExtension")</button>@if (requiresScope) { <button class="button-secondary" @onclick="() => RejectAsync(enrollment)" disabled="@pairingBusy">@T("Reject")</button> }</Primary></CollectionActions></div>
        }
        else if (enrollment.Definition.EnrollmentMode == AepEnrollmentMode.PairingCode && enrollment.Definition.State == AepEnrollmentState.Available)
        {
            <div class="enrollment-actions enrollment-management-actions"><CollectionActions ResourceName="@enrollment.Definition.ExtensionName"><Primary><button class="button-secondary" @onclick="() => RotateCredentialAsync(enrollment)" disabled="@pairingBusy">@T("RotateCredential")</button><button class="button-danger" @onclick="() => RequestUnenrollment(enrollment)" disabled="@pairingBusy">@T("ConfirmUnenrollExtension")</button></Primary><Secondary><button class="button-danger" @onclick="() => RevokeCredentialAsync(enrollment)" disabled="@pairingBusy">@T("RevokeCredential")</button></Secondary></CollectionActions></div>
        }
        else if (CanUnenroll(enrollment.Definition.State))
        {
            <div class="enrollment-actions enrollment-management-actions"><CollectionActions ResourceName="@enrollment.Definition.ExtensionName"><Primary><button class="button-danger" @onclick="() => RequestUnenrollment(enrollment)" disabled="@pairingBusy">@T("ConfirmUnenrollExtension")</button></Primary></CollectionActions></div>
        }

            </FormActions>
        </div>
    }</text>;
}
