@page "/startup/progress"
@layout Agentstration.Web.Components.Bootstrap.BootstrapStartupLayout
@using Agentstration.Bootstrap.Contracts
@using Agentstration.Web.Components.Bootstrap
@implements IAsyncDisposable
@inject IBootstrapStartupApiClient Client
@inject NavigationManager Navigation
@inject TimeProvider Clock
@inject Microsoft.Extensions.Localization.IStringLocalizer<BootstrapStartupStrings> Localizer

<div class="bootstrap-startup-page">
<PageTitle>@Localizer["Title"]</PageTitle>
<PageHeader Title="@Localizer["Title"]" Eyebrow="@Localizer["Startup"]" Description="@Localizer["Description"]">
    <Status>@if (snapshot is not null) { <StatusBadge Text="@Localizer[snapshot.State == "failed" ? "Failed" : "Running"]" Status="@(snapshot.State == "failed" ? UiStatus.Danger : UiStatus.Info)" /> }</Status>
</PageHeader>

@if (denied)
{
    <ErrorState Title="@Localizer["AccessUnavailable"]" Message="@Localizer["AccessUnavailableDescription"]" />
}
else if (snapshot is null)
{
    <LoadingState Message="@(disconnected ? Localizer["ConnectionLostDescription"] : Localizer["Checking"])" />
}
else
{
    @if (disconnected) { <p class="startup-progress-notice" role="status">@Localizer["ConnectionLostDescription"]</p> }
    <StepProgress @key="snapshot.AttemptId" AutoCollapseCompletedGroups="true" Steps="@Steps" ActiveStepId="@ActiveNavigationId" @bind-SelectedStepId="selected" @bind-FollowActiveStep="following" TestId="bootstrap-startup-progress">
        <HeaderContent>
            <div class="startup-progress-summary" role="status">
                <div class="startup-progress-summary-heading">
                    <span class="startup-progress-summary-icon" aria-hidden="true"><UiIcon Name="@(snapshot.State == "failed" ? "alert-triangle" : "cloud-upload")" /></span>
                    <div><strong>@Localizer[snapshot.State == "failed" ? "Failed" : "Running"]</strong><p>@Localizer["CurrentStage", Localizer["Stage_" + snapshot.ActiveStepId].Value]</p></div>
                </div>
                <div class="startup-progress-completion">
                    <span>@Localizer["StepCount", CompletedSteps, snapshot.Steps.Count]</span>
                    <progress value="@CompletedSteps" max="@snapshot.Steps.Count" aria-label="@Localizer["StepCount", CompletedSteps, snapshot.Steps.Count]"></progress>
                </div>
            </div>
        </HeaderContent>
    </StepProgress>
    @if (snapshot.State == "failed") { <p class="startup-progress-notice" role="alert">@Localizer["Recovery"]</p> }
}

</div>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "ReturnUrl")] public string? ReturnUrl { get; set; }
    private readonly CancellationTokenSource stopping = new();
    private BootstrapStartupSnapshot? snapshot;
    private string? selected;
    private bool following = true, denied, disconnected;
    private Task? polling;

    private int CompletedSteps => snapshot?.Steps.Count(step => step.State is "succeeded" or "skipped") ?? 0;
    private string? ActiveNavigationId => (snapshot?.Families.FirstOrDefault(family => family.StepId == snapshot.ActiveStepId
        && (snapshot.Activity?.GroupId is { } groupId ? family.GroupId == groupId : family.Kind == snapshot.Activity?.ResourceKind))
        ?? snapshot?.Families.FirstOrDefault(family => family.StepId == snapshot.ActiveStepId && family.State is "running" or "waiting")) is { } active
        ? FamilyId(active) : snapshot?.ActiveStepId;
    private static string FamilyId(BootstrapStartupFamily family) => family.StepId + ":" + family.Kind + (family.GroupId is null ? string.Empty : ":" + family.GroupId);
    private string FamilyLabel(string kind)
    {
        var label = Localizer["Family_" + kind];
        return label.ResourceNotFound ? kind : label.Value;
    }
    private static ProgressStepStatus StepStatus(string state) => state switch
    {
        "succeeded" => ProgressStepStatus.Succeeded,
        "running" => ProgressStepStatus.Running,
        "waiting" => ProgressStepStatus.Waiting,
        "failed" => ProgressStepStatus.Failed,
        "skipped" => ProgressStepStatus.Skipped,
        "blocked" => ProgressStepStatus.Interrupted,
        _ => ProgressStepStatus.Pending
    };
    private IReadOnlyList<ProgressStep> Steps
    {
        get
        {
            var items = new List<ProgressStep>();
            foreach (var step in snapshot!.Steps)
            {
                items.Add(new(step.Id, Localizer["Stage_" + step.Id], StepStatus(step.State), Panel(step.Id, null, null)));
                var families = snapshot.Families.Where(family => family.StepId == step.Id).ToArray();
                var counts = families.GroupBy(family => family.Kind).ToDictionary(group => group.Key, group => group.Count());
                var seen = new Dictionary<string, int>(StringComparer.Ordinal);
                foreach (var family in families)
                {
                    var ordinal = seen.GetValueOrDefault(family.Kind) + 1;
                    seen[family.Kind] = ordinal;
                    var title = counts[family.Kind] > 1 ? Localizer["FamilyOccurrence", FamilyLabel(family.Kind), ordinal].Value : FamilyLabel(family.Kind);
                    items.Add(new(FamilyId(family), title, StepStatus(family.State), Panel(step.Id, family.Kind, family.GroupId, title))
                    {
                        ParentId = step.Id,
                        Summary = Localizer["ResourceCount", family.Processed, family.Total] + (counts[family.Kind] > 1 && family.Profile is not null ? " · " + family.Profile : string.Empty)
                    });
                }
            }
            return items;
        }
    }
    private RenderFragment Panel(string step, string? kind, string? groupId, string? title = null) => builder =>
    {
        builder.OpenComponent<BootstrapStartupStepPanel>(0);
        builder.AddAttribute(1, nameof(BootstrapStartupStepPanel.Snapshot), snapshot);
        builder.AddAttribute(2, nameof(BootstrapStartupStepPanel.StepId), step);
        builder.AddAttribute(3, nameof(BootstrapStartupStepPanel.Kind), kind);
        builder.AddAttribute(4, nameof(BootstrapStartupStepPanel.GroupId), groupId);
        builder.AddAttribute(5, nameof(BootstrapStartupStepPanel.GroupTitle), title);
        builder.CloseComponent();
    };

    protected override Task OnInitializedAsync() => LoadAsync();
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) polling = PollAsync();
        return Task.CompletedTask;
    }
    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2), Clock);
        try { while (await timer.WaitForNextTickAsync(stopping.Token)) await InvokeAsync(LoadAsync); }
        catch (OperationCanceledException) when (stopping.IsCancellationRequested) { }
    }
    private async Task LoadAsync()
    {
        try
        {
            var current = await Client.GetAsync(stopping.Token);
            if (snapshot is not null && snapshot.AttemptId != current.AttemptId) { selected = null; following = true; }
            snapshot = current; disconnected = denied = false;
            if (current.Ready)
            {
                var destination = BootstrapStartupNavigation.LocalReturnUrl(ReturnUrl);
                Navigation.NavigateTo(destination == "/" ? Navigation.BaseUri : destination.TrimStart('/'), replace: true);
            }
        }
        catch (AgentstrationApiException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Forbidden) { snapshot = null; denied = true; }
        catch (AgentstrationApiException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        { Navigation.NavigateTo("login?ReturnUrl=" + Uri.EscapeDataString(BootstrapStartupNavigation.ProgressUrl(ReturnUrl)), forceLoad: true); }
        catch (OperationCanceledException) when (stopping.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or AgentstrationApiException or InvalidOperationException or OperationCanceledException) { disconnected = true; }
        if (!stopping.IsCancellationRequested) StateHasChanged();
    }
    public async ValueTask DisposeAsync()
    {
        stopping.Cancel();
        if (polling is not null) await polling;
        stopping.Dispose();
    }
}
