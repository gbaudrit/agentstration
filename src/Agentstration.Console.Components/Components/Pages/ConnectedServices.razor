@page "/connected-services"
@implements IDisposable
@inject IConnectedServicesClient Client
@inject IServiceProvider Services
@inject ConsoleContextState Context
@inject Microsoft.Extensions.Localization.IStringLocalizer<ConnectedServiceStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared

<PageTitle>@T("ConnectedServices") · Agentstration</PageTitle>
<ResourceCollectionTemplate TItem="ConnectedServiceResource" Title="@T("ConnectedServices")" Description="@T("List.Description")"
                            TestId="connected-services" RowTestId="connected-service-row" ContextKey="@contextKey" IconName="puzzle"
                            IdentityColumn="IdentityColumn" Columns="Columns" AdditionalFilters="ExtraFilters" Items="PageItems"
                            Query="query" QueryChanged="ChangeQueryAsync" Pagination="Pagination" LoadState="loadState"
                            SearchEnabled SearchLabel="@Shared["Search"]" SearchPlaceholder="@T("Search")"
                            EmptyTitle="@T("Empty")" EmptyMessage="@T("Empty.Message")" EmptyActions="CreateAction" PrimaryActions="CreateAction"
                            OnRefresh="LoadAsync" OnRetry="RetryAsync" />

@code {
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    private RenderFragment? CreateAction => Context.HasPermission(AuthorizationPermissions.ResourcesWrite)
        ? @<PermissionGate Permission="@AuthorizationPermissions.ResourcesWrite"><a class="button-primary" href="@ResourceOwnershipContext.PreserveNavigation("/connected-services/new", Services)" data-testid="connected-service-create">@T("Create")</a></PermissionGate> : null;
    private CollectionColumn<ConnectedServiceResource> IdentityColumn => new("identity", T("Name"), item => @<CollectionIdentity DisplayName="@item.Definition.DisplayName" Namespace="@item.Namespace.Value" Name="@item.Name" Href="@DetailsUrl(item)" IconName="puzzle" Domain="tools" data-testid="connected-service-name-link">
        <IconBadges><ResourceScopeBadge ScopeRef="item.ScopeRef" IconOnly /><StatusBadge Text="@StatusLabel(Availability(item))" Status="@StatusColor(Availability(item))" IconOnly /><ManagedResourceBadge IsManaged="@item.Governance.IsManaged" IsReadOnly="@(!ResourceOwnershipContext.CanManage(item.ScopeRef, Services))" IconOnly /></IconBadges>
    </CollectionIdentity>)
    {
        Filters = [new("availability", T("StatusFilter"), CollectionFilterKind.Choice)
        {
            Placeholder = T("AllStatuses"),
            Options = Enum.GetValues<ConnectedServiceAvailability>().Select(status => new CollectionFilterOption(status.ToString(), StatusLabel(status))).ToArray()
        }]
    };
    private IReadOnlyList<CollectionColumn<ConnectedServiceResource>> Columns =>
    [
        new("type", T("Type"), item => @<span><strong>@item.Definition.Type.Type.Name</strong><br /><small>@item.Definition.Type.Version</small></span>)
        {
            Filters = [new("type", T("TypeFilter"), CollectionFilterKind.Choice)
            {
                Placeholder = T("AllTypes"),
                Options = (items ?? []).Select(item => item.Definition.Type.Type.Name).Distinct(StringComparer.Ordinal).Order().Select(value => new CollectionFilterOption(value, value)).ToArray()
            }]
        }
    ];
    private IReadOnlyList<CollectionFilter> ExtraFilters =>
    [
        new("namespace", Shared["Namespace"], CollectionFilterKind.Choice)
        {
            Options = (items ?? []).Select(item => item.Namespace.Value).Distinct(StringComparer.Ordinal).Order().Select(value => new CollectionFilterOption(value, value)).ToArray()
        }
    ];
    private string DetailsUrl(ConnectedServiceResource resource) => ResourceOwnershipContext.Resource(Services, "/connected-services", resource.Name, resource.Namespace, resource.ScopeRef);
    private string StatusLabel(ConnectedServiceAvailability status) => T($"Availability.{status}");
    private static ConnectedServiceAvailability Availability(ConnectedServiceResource item) => item.ObservedState?.Availability ?? (item.Definition.Enabled ? ConnectedServiceAvailability.Stale : ConnectedServiceAvailability.Disabled);
    private static UiStatus StatusColor(ConnectedServiceAvailability status) => status switch { ConnectedServiceAvailability.Ready => UiStatus.Success, ConnectedServiceAvailability.Stale => UiStatus.Warning, ConnectedServiceAvailability.Unavailable => UiStatus.Danger, _ => UiStatus.Neutral };
}
