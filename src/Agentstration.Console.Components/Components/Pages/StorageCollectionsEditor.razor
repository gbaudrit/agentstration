@inject Microsoft.Extensions.Localization.IStringLocalizer<StorageStrings> Localizer
<section class="panel form-section" data-testid="storage-collections">
    <div class="panel-header"><h2>@T("Documents.Collections")</h2></div>
    <p>@T("Documents.CollectionsHelp")</p>
    @for (var index = 0; index < rows.Count; index++)
    {
        var row = index;
        var collection = rows[row];
        <fieldset @key="(rowKeys[row], collection.Uid)" class="form-grid" disabled="@ReadOnly">
            <ResourceIdentityFields DisplayName="@collection.DisplayName" DisplayNameChanged="value => SetAsync(row, rows[row] with { DisplayName = value })"
                TechnicalName="@collection.Name" TechnicalNameChanged="value => SetAsync(row, rows[row] with { Name = value })"
                Policy="ResourceNamePolicy.Parameter" IsNew="@(collection.Uid == Guid.Empty)"
                DisplayNameTestId="@($"collection-{row}-display-name")" TechnicalNameTestId="@($"collection-{row}-name")" />
            @if (!IdentityValid(collection)) { <p class="field-validation-error form-span-2" role="alert">@T("Documents.IdentityRequired")</p> }
            <label><span>@T("Uid")</span><code>@(collection.Uid == Guid.Empty ? T("Documents.NewUid") : collection.Uid.ToString())</code></label>
            <label><span>@T("Enabled")</span><input type="checkbox" checked="@collection.Enabled" @onchange="e => SetAsync(row, collection with { Enabled = Checked(e) })" /></label>
            <label><span>@T("Documents.Get")</span><input type="checkbox" checked="@collection.Policy.Get" @onchange="e => SetAsync(row, collection with { Policy = collection.Policy with { Get = Checked(e) } })" /></label>
            <label><span>@T("Documents.Put")</span><input type="checkbox" checked="@collection.Policy.Put" @onchange="e => SetAsync(row, collection with { Policy = collection.Policy with { Put = Checked(e) } })" /></label>
            <label><span>@T("Documents.Delete")</span><input type="checkbox" checked="@collection.Policy.Delete" @onchange="e => SetAsync(row, collection with { Policy = collection.Policy with { Delete = Checked(e) } })" /></label>
            <label><span>@T("Documents.Query")</span><input type="checkbox" checked="@collection.Policy.Query" @onchange="e => SetAsync(row, collection with { Policy = collection.Policy with { Query = Checked(e) } })" /></label>
            <label><span>@T("Documents.Publish")</span><input type="checkbox" checked="@collection.Policy.Publish" @onchange="e => SetAsync(row, collection with { Policy = collection.Policy with { Publish = Checked(e) } })" /></label>
            <label><span>@T("Documents.PageSize")</span><input type="number" min="1" max="100" value="@collection.Policy.MaximumPageSize" @onchange="e => PageAsync(row, e)" /></label>
            <label class="form-span-2"><span>@T("Documents.Profiles")</span><input value="@string.Join(',', collection.Policy.QueryProfiles ?? [])" @onchange="e => SetAsync(row, collection with { Policy = collection.Policy with { QueryProfiles = Text(e).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) } })" /><small>@string.Join(", ", Capabilities.QueryProfiles.Select(p => p.Id + "/" + p.Version + " (" + p.Encoding + ")"))</small></label>
            @if (collection.SchemaBinding?.Reference is not null)
            {
                <div class="form-span-2">
                    <ReusableSchemaBindingEditor Title="@T("Documents.Schema")" TestId="@($"collection-{row}-schema")"
                        Binding="@collection.SchemaBinding" ReadOnly="@ReadOnly" ValueChanged="value => BindingAsync(row, value)" />
                    @if (collection.SchemaSnapshot is { } snapshot)
                    {
                        <details><summary>@T("Documents.Schema")</summary><pre>@JsonSerializer.Serialize(snapshot, new JsonSerializerOptions { WriteIndented = true })</pre></details>
                    }
                    @if (!ReadOnly) { <button type="button" class="button-secondary" @onclick="() => InlineAsync(row)">@T("Documents.UseInlineSchema")</button> }
                </div>
            }
            else
            {
            <label class="form-span-2"><span>@T("Documents.Schema")</span><textarea class="form-code-editor" rows="8" @onchange="e => SchemaAsync(row, e)">@(drafts.GetValueOrDefault(row) ?? collection.Schema.GetRawText())</textarea></label>
            @if (invalid.Contains(row)) { <p role="alert">@T("Documents.InvalidJson")</p> }
                @if (!ReadOnly) { <button type="button" class="button-secondary" @onclick="() => SharedAsync(row)">@T("Documents.UseSharedSchema")</button> }
            }
            @if (!ReadOnly) { <button type="button" class="button-danger" @onclick="() => RemoveAsync(row)">@T("Documents.Remove")</button> }
        </fieldset>
    }
    @if (!ReadOnly) { <button type="button" class="button-secondary" disabled="@(rows.Count >= 32)" @onclick="AddAsync" data-testid="storage-collection-add">@T("Documents.Add")</button> }
</section>
@code {
    [Parameter, EditorRequired] public IReadOnlyList<StorageDocumentCollection> Value { get; set; } = [];
    [Parameter, EditorRequired] public StorageDocumentCapabilities Capabilities { get; set; } = null!;
    [Parameter] public EventCallback<IReadOnlyList<StorageDocumentCollection>> ValueChanged { get; set; }
    [Parameter] public EventCallback<bool> ValidationChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    private IReadOnlyList<StorageDocumentCollection> rows = [];
    private readonly List<object> rowKeys = [];
    private bool? lastValid;
    private readonly Dictionary<int, string> drafts = [];
    private readonly HashSet<int> invalid = [];
    private string T(string key) => Localizer[key];
    private static string Text(ChangeEventArgs e) => e.Value?.ToString() ?? "";
    private static bool Checked(ChangeEventArgs e) => e.Value is true;
    protected override async Task OnParametersSetAsync()
    {
        rows = Value;
        SynchronizeKeys();
        await NotifyValidationAsync();
    }
    private void SynchronizeKeys()
    {
        while (rowKeys.Count < rows.Count) rowKeys.Add(new());
        if (rowKeys.Count > rows.Count) rowKeys.RemoveRange(rows.Count, rowKeys.Count - rows.Count);
    }
    private static bool IdentityValid(StorageDocumentCollection collection) =>
        !string.IsNullOrWhiteSpace(collection.DisplayName) && collection.DisplayName.Length <= 200
        && collection.Name is { Length: >= 1 and <= 128 } && char.IsAsciiLetterOrDigit(collection.Name[0])
        && collection.Name.All(c => char.IsAsciiLetterLower(c) || char.IsAsciiDigit(c) || c is '.' or '-');
    private Task NotifyValidationAsync()
    {
        var valid = invalid.Count == 0 && rows.All(IdentityValid);
        if (lastValid == valid) return Task.CompletedTask;
        lastValid = valid;
        return ValidationChanged.InvokeAsync(valid);
    }
    private async Task UpdateRowsAsync(IReadOnlyList<StorageDocumentCollection> updated)
    {
        rows = updated;
        SynchronizeKeys();
        await ValueChanged.InvokeAsync(updated);
        await NotifyValidationAsync();
    }
    private Task SetAsync(int row, StorageDocumentCollection value) => UpdateRowsAsync(rows.Select((c, i) => i == row ? value : c).ToArray());
    private Task AddAsync() => UpdateRowsAsync([.. rows, new() { Name = "", DisplayName = "", Policy = new(Query: Capabilities.Query, QueryProfiles: Capabilities.QueryProfiles.Select(p => p.Id).ToArray()) }]);
    private async Task RemoveAsync(int row)
    {
        rowKeys.RemoveAt(row); drafts.Clear(); invalid.Clear();
        await UpdateRowsAsync(rows.Where((_, i) => i != row).ToArray());
    }
    private async Task PageAsync(int row, ChangeEventArgs e)
    {
        if (int.TryParse(Text(e), out var size)) await SetAsync(row, rows[row] with { Policy = rows[row].Policy with { MaximumPageSize = size } });
    }
    private async Task SharedAsync(int row)
    {
        invalid.Add(row);
        await SetAsync(row, rows[row] with { SchemaBinding = new() { Reference = new() { Name = "", Version = "" } }, SchemaSnapshot = null });
        await NotifyValidationAsync();
    }
    private async Task InlineAsync(int row)
    {
        invalid.Remove(row); drafts.Remove(row);
        await SetAsync(row, rows[row] with { SchemaBinding = null, SchemaSnapshot = null });
        await NotifyValidationAsync();
    }
    private async Task BindingAsync(int row, SchemaBindingEditorValue value)
    {
        if (value.Binding is null || value.EffectiveContent is null) invalid.Add(row); else invalid.Remove(row);
        await SetAsync(row, rows[row] with { SchemaBinding = value.Binding,
            Schema = value.EffectiveContent ?? rows[row].Schema, SchemaSnapshot = null });
        await NotifyValidationAsync();
    }
    private async Task SchemaAsync(int row, ChangeEventArgs e)
    {
        drafts[row] = Text(e);
        try
        {
            using var json = JsonDocument.Parse(drafts[row]);
            if (json.RootElement.ValueKind != JsonValueKind.Object) throw new JsonException();
            invalid.Remove(row);
            await SetAsync(row, rows[row] with { Schema = json.RootElement.Clone(), SchemaBinding = null, SchemaSnapshot = null });
        }
        catch (JsonException) { invalid.Add(row); }
        await NotifyValidationAsync();
    }
}
