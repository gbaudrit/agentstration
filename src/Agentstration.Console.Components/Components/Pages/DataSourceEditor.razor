@page "/data-sources/new"
@page "/data-sources/{Name}"
@implements IDisposable
@inject IDataSourcesClient Client
@inject IDataSourceProfilesClient Profiles
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<DataSourcesStrings> Localizer

<PageTitle>@(source?.Definition.DisplayName ?? T(IsNew ? "CreateSource" : "DataSources")) · Agentstration</PageTitle>
<PageHeader Title="@(source?.Definition.DisplayName ?? T("CreateSource"))" Description="@T("DataSourcesHelp")" TestId="data-source-editor">
    <Actions>@if (!IsNew) { <button class="button-danger" type="button" @onclick="() => confirmDelete = true">@T("Delete")</button> }<a class="button-secondary" href="/data-sources">@T("Back")</a></Actions>
</PageHeader>
@if (loading) { <LoadingState Message="@T("Loading")" /> }
else
{
    @if (error is not null) { <div class="form-alert form-alert-danger" role="alert">@error</div> }
    @if (!IsNew) { <ResourceTabs Label="@T("DataSources")">@foreach (var value in Enum.GetValues<Tab>()) { <button type="button" role="tab" class="@(tab == value ? "active" : null)" @onclick="() => SelectTab(value)">@T(value.ToString())</button> }</ResourceTabs> }
    @if (tab == Tab.Overview && !IsNew)
    {
        <section class="metric-grid"><MetricCard Label="@T("State")" Value="@T(readiness?.Ready == true ? "Ready" : "NotReady")" Detail="@T(source!.Definition.Enabled ? "Enabled" : "Disabled")" Status="@(readiness?.Ready == true ? UiStatus.Success : UiStatus.Warning)" /><MetricCard Label="@T("Profile")" Value="@(readiness?.Profile?.Definition.DisplayName ?? source!.Definition.Profile.Name)" Detail="@(readiness?.Profile?.Version ?? "—")" Status="@UiStatus.Info" /></section>
        @if (readiness?.Issues.Count > 0) { <section class="panel form-section">@foreach (var issue in readiness.Issues) { <p>@issue</p> }</section> }
    }
    else if (tab == Tab.Definition || IsNew)
    {
        <EditForm Model="this" OnValidSubmit="SaveAsync" class="panel form-section"><div class="form-grid">
            <ResourceIdentityFields @bind-DisplayName="displayName" @bind-TechnicalName="technicalName" IsNew="@IsNew" />
            <label><span>@T("Namespace")</span><input @bind="sourceNamespace" disabled="@(!IsNew)" /></label>
            @if (IsNew) { <ResourceScopeFormField ResourceKind="@DataSourceResourceKinds.DataSource" @bind-Value="selectedScope" /> } else { <label><span>@T("Scope")</span><ResourceScopeBadge ScopeRef="selectedScope" /></label> }
            <label class="form-field-wide"><span>@T("Description")</span><textarea @bind="description" maxlength="2000"></textarea></label>
            <label class="form-field-wide"><span>@T("Profile")</span><select @bind="profileKey" required><option value="">@T("Select")</option>@foreach (var item in profiles) { <option value="@ProfileKey(item)">@item.Definition.DisplayName · @item.ActiveVersion · @item.ScopeRef</option> }</select></label>
            <label class="form-field-wide"><span>@T("Configuration")</span><textarea class="form-code-editor runner-json" rows="14" @bind="configurationJson"></textarea></label>
            <label class="profile-choice form-span-2"><input type="checkbox" @bind="enabled" /><span class="profile-choice-icon"><UiIcon Name="check" /></span><span><strong>@T("Enabled")</strong></span></label>
        </div><div class="form-actions"><button class="button-primary" type="submit" disabled="@busy">@(busy ? T("Saving") : T("Save"))</button></div></EditForm>
    }
    else if (tab == Tab.Acquisitions)
    {
        <section class="panel form-section"><label class="profile-yaml-field"><span>@T("Parameters")</span><textarea class="form-code-editor runner-json" rows="8" @bind="parametersJson"></textarea></label><div class="form-actions"><button class="button-primary" type="button" disabled="@busy" @onclick="StartAsync">@T("StartAcquisition")</button></div>
        @if (acquisitions.Count == 0) { <p class="muted">@T("NoAcquisitions")</p> } else { <DataGrid TItem="DataSourceAcquisitionResource" Items="acquisitions"><Header><tr><th>@T("Created")</th><th>@T("State")</th><th>@T("FlowRun")</th><th>@T("Version")</th></tr></Header><Row Context="item"><tr><td>@item.CreatedAt.ToLocalTime().ToString("g")</td><td>@item.State</td><td><a href="/flow-runs/@Uri.EscapeDataString(item.FlowRunId)"><code>@item.FlowRunId</code></a></td><td><code>@item.Composition.Profile.Version</code></td></tr></Row></DataGrid> }</section>
    }
    else if (tab == Tab.Yaml)
    {
        <section class="panel form-section"><label class="profile-yaml-field"><span>@T("Manifest")</span><textarea class="form-code-editor runner-json" rows="30" @bind="rawYaml"></textarea></label><div class="form-actions"><button class="button-primary" type="button" disabled="@busy" @onclick="SaveYamlAsync">@T("ApplyYaml")</button></div></section>
    }
}
<ConfirmationDialog IsOpen="@confirmDelete" Title="@T("Delete")" Message="@T("DeleteConfirm")" ConfirmLabel="@T("Delete")" OnConfirm="DeleteAsync" OnCancel="() => confirmDelete = false" />

@code {
    [Parameter] public string? Name { get; set; }
    [SupplyParameterFromQuery(Name = "namespace")] public string? Namespace { get; set; }
    [SupplyParameterFromQuery(Name = "scopeRef")] public string? ScopeRef { get; set; }
    private readonly CancellationTokenSource cancellation = new();
    private IReadOnlyList<DataSourceProfileResource> profiles = [];
    private IReadOnlyList<DataSourceAcquisitionResource> acquisitions = [];
    private DataSourceResource? source;
    private DataSourceReadiness? readiness;
    private ResourceScopeRef? selectedScope;
    private string? etag, error;
    private string technicalName = string.Empty, displayName = string.Empty, sourceNamespace = "default", description = string.Empty, profileKey = string.Empty, configurationJson = "{}", parametersJson = "{}", rawYaml = string.Empty;
    private bool enabled = true, loading = true, busy, confirmDelete;
    private Tab tab = Tab.Definition;
    private bool IsNew => string.IsNullOrWhiteSpace(Name);
    private string T(string key) => Localizer[key];
    protected override Task OnParametersSetAsync() => LoadAsync();
    private async Task LoadAsync() { loading = true; error = null; try { profiles = (await Profiles.GetAsync(cancellation.Token)).Where(value => value.ActiveVersion is not null && value.Definition.Enabled).ToArray(); if (!IsNew) { selectedScope = ResourceScopeRef.Parse(ScopeRef!); var snapshot = await Client.GetAsync(ResourceNamespace.Parse(Namespace), Name!, selectedScope.Value, cancellation.Token); source = snapshot.Value; etag = snapshot.ETag; readiness = await Client.GetReadinessAsync(source.Namespace, source.Name, selectedScope.Value, cancellation.Token); acquisitions = await Client.GetAcquisitionsAsync(source.Namespace, source.Name, selectedScope.Value, cancellation.Token); LoadForm(); tab = Tab.Overview; } } catch (Exception exception) { error = exception.Message; } finally { loading = false; } }
    private void LoadForm() { technicalName = source!.Name; displayName = source.Definition.DisplayName; sourceNamespace = source.Namespace.Value; description = source.Definition.Description ?? string.Empty; enabled = source.Definition.Enabled; configurationJson = JsonSerializer.Serialize(source.Definition.Configuration, new JsonSerializerOptions { WriteIndented = true }); var profile = profiles.FirstOrDefault(value => value.Name == source.Definition.Profile.Name && (source.Definition.Profile.Namespace ?? source.Namespace) == value.Namespace && (source.Definition.Profile.ScopeRef is null || source.Definition.Profile.ScopeRef == value.ScopeRef)); profileKey = profile is null ? string.Empty : ProfileKey(profile); rawYaml = ResourceManifestSerializer.ToYaml(new RawSource { ApiVersion = source.ApiVersion, Kind = source.Kind, Metadata = source.Metadata, ScopeRef = source.ScopeRef, Definition = source.Definition, MigratedFrom = source.MigratedFrom }); }
    private DataSourceProperties Definition() { using var config = JsonDocument.Parse(configurationJson); var profile = ParseProfile(profileKey); return new() { DisplayName = displayName.Trim(), Description = string.IsNullOrWhiteSpace(description) ? null : description.Trim(), Enabled = enabled, Profile = new(profile.Name, profile.Scope, profile.Namespace), Configuration = config.RootElement.Clone() }; }
    private async Task SaveAsync() { busy = true; error = null; try { if (IsNew) { if (selectedScope is null) throw new InvalidOperationException(T("Scope")); var saved = await Client.CreateAsync(new(technicalName.Trim(), Definition(), sourceNamespace.Trim(), selectedScope), cancellation.Token); Navigation.NavigateTo(Url(saved.Value)); } else { var saved = await Client.UpdateAsync(source!.Namespace, source.Name, selectedScope!.Value, new(Definition()), etag!, cancellation.Token); source = saved.Value; etag = saved.ETag; readiness = await Client.GetReadinessAsync(source.Namespace, source.Name, selectedScope.Value, cancellation.Token); LoadForm(); } } catch (Exception exception) { error = exception.Message; } finally { busy = false; } }
    private async Task StartAsync() { busy = true; error = null; try { using var parameters = JsonDocument.Parse(parametersJson); await Client.StartAcquisitionAsync(source!.Namespace, source.Name, selectedScope!.Value, new() { Parameters = parameters.RootElement.Clone(), DataSourceScopeRef = selectedScope }, cancellation.Token); acquisitions = await Client.GetAcquisitionsAsync(source.Namespace, source.Name, selectedScope.Value, cancellation.Token); } catch (Exception exception) { error = exception.Message; } finally { busy = false; } }
    private async Task SaveYamlAsync() { try { var raw = ResourceManifestSerializer.FromYaml<RawSource>(rawYaml); if (raw.Metadata.Name != source!.Name || raw.Metadata.Namespace != source.Namespace || raw.ScopeRef != source.ScopeRef) throw new ArgumentException(T("IdentityImmutable")); var saved = await Client.UpdateAsync(source.Namespace, source.Name, selectedScope!.Value, new(raw.Definition), etag!, cancellation.Token); source = saved.Value; etag = saved.ETag; LoadForm(); } catch (Exception exception) { error = exception.Message; } }
    private async Task DeleteAsync() { confirmDelete = false; await Client.DeleteAsync(source!.Namespace, source.Name, selectedScope!.Value, etag!, cancellation.Token); Navigation.NavigateTo("/data-sources"); }
    private void SelectTab(Tab value) { tab = value; if (value == Tab.Yaml && source is not null) LoadForm(); }
    private static string ProfileKey(DataSourceProfileResource item) => $"{item.ScopeRef!.Value.Value}|{item.Namespace.Value}|{item.Name}";
    private static (ResourceScopeRef Scope, ResourceNamespace Namespace, string Name) ParseProfile(string key) { var parts = key.Split('|', 3); return (ResourceScopeRef.Parse(parts[0]), ResourceNamespace.Parse(parts[1]), parts[2]); }
    private static string Url(DataSourceResource item) => $"/data-sources/{Uri.EscapeDataString(item.Name)}?namespace={Uri.EscapeDataString(item.Namespace.Value)}&scopeRef={Uri.EscapeDataString(item.ScopeRef!.Value.Value)}";
    private sealed record RawSource { public required string ApiVersion { get; init; } public required string Kind { get; init; } public required ResourceMetadata Metadata { get; init; } public ResourceScopeRef? ScopeRef { get; init; } public required DataSourceProperties Definition { get; init; } public DataSourceMigrationInput? MigratedFrom { get; init; } }
    private enum Tab { Overview, Definition, Acquisitions, Yaml }
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
