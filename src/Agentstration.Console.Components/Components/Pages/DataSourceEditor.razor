    private static (ResourceScopeRef Scope, ResourceNamespace Namespace, string Name) ParseProfile(string key) { var parts = key.Split('|', 3); return (ResourceScopeRef.Parse(parts[0]), ResourceNamespace.Parse(parts[1]), parts[2]); }
    private static string Url(DataSourceResource item) => $"/data-sources/{Uri.EscapeDataString(item.Name)}?namespace={Uri.EscapeDataString(item.Namespace.Value)}&scopeRef={Uri.EscapeDataString(item.ScopeRef!.Value.Value)}";
    private string AcquisitionStateLabel(DataSourceAcquisitionState state) => T($"AcquisitionState.{state}");
    private static UiStatus AcquisitionTone(DataSourceAcquisitionState? state) => state switch { DataSourceAcquisitionState.Succeeded => UiStatus.Success, DataSourceAcquisitionState.Failed or DataSourceAcquisitionState.Cancelled or DataSourceAcquisitionState.TimedOut => UiStatus.Warning, null => UiStatus.Neutral, _ => UiStatus.Info };
    private static JsonElement EmptyObject() => JsonSerializer.SerializeToElement(new { });
    private sealed record RawSource { public required string ApiVersion { get; init; } public required string Kind { get; init; } public required ResourceMetadata Metadata { get; init; } public ResourceScopeRef? ScopeRef { get; init; } public required DataSourceProperties Definition { get; init; } }
    private enum Tab { Overview, Definition, Discovery, Acquisitions, Access, Yaml }
    private static bool IsActive(DataSourceDiscoveryState state) => state is DataSourceDiscoveryState.Pending
        or DataSourceDiscoveryState.Running or DataSourceDiscoveryState.WaitingForInput or DataSourceDiscoveryState.WaitingForChild;
    private static UiStatus DiscoveryTone(DataSourceDiscoveryState state) => state switch
    {
        DataSourceDiscoveryState.Succeeded => UiStatus.Success,
        DataSourceDiscoveryState.Failed or DataSourceDiscoveryState.TimedOut => UiStatus.Danger,
        DataSourceDiscoveryState.Cancelled => UiStatus.Warning,
        _ => UiStatus.Info
    };
    public async ValueTask DisposeAsync()
    {
        if (disposed) return;
        disposed = true;
        await cancellation.CancelAsync();
        await polling;
        cancellation.Dispose();
    }
