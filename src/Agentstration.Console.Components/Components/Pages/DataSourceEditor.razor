    <Actions Context="choice"><CollectionActions ResourceName="@choice.DisplayName"><Primary><button class="button-secondary" type="button" disabled="@(!CanApplyChoice(choice))" data-testid="@(MatchingTarget(choice) is { Stale: true } ? "data-source-reconcile-target" : null)" title="@ChoiceActionHelp(choice)" @onclick="() => ApplyChoiceAsync(choice)">@T(ChoiceActionLabel(choice))</button></Primary></CollectionActions></Actions></CollectionView> }
