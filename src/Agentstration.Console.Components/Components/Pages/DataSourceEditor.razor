@page "/data-sources/new"
@page "/data-sources/{Name}"
@implements IAsyncDisposable
@inject IDataSourcesClient Client
@inject IDataSourceProfilesClient Profiles
@inject NavigationManager Navigation
@inject TimeProvider Clock
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<DataSourcesStrings> Localizer

@if (DatasetMode)
{
    <DataSourceDatasetEditor Name="@Name" Namespace="@Namespace" ScopeRef="@ScopeRef" />
}
else
{
    <PageTitle>@(source?.Definition.DisplayName ?? T("CreateSource")) · Agentstration</PageTitle>
    var presentations = Presentations;
    RenderFragment feedback = @<div>
        @if (error is not null) { <div class="form-alert form-alert-danger" role="alert">@error</div> }
        @if (operationsError is not null) { <div class="form-alert form-alert-danger" role="alert" data-testid="data-source-operations-error">@operationsError</div> }
        @if (newerSnapshot is not null) { <div class="form-alert form-alert-warning" role="status">@T("SourceRefreshDraftConflict")</div> }
    </div>;
    RenderFragment form = @<ResourceDefinitionForm @key="model" @ref="definitionForm" EditContext="FormContext" Id="data-source-definition" FormName="data-source-definition"
        FieldLabels="FieldLabels" Sections="presentations" SectionState="@(IsNew ? null : sectionState)" SectionContent="@(IsNew ? null : DefinitionContent)" SectionRequested="ShowSection"
        OnValidSubmit="SaveAsync" InvalidInputChanged="value => invalidInput = value" Busy="busy" ReadOnly="@(!CanManage)"
        @oninput="MarkDirty" @onchange="MarkDirty">
        <ChildContent>@if (IsNew) { <CreationWizard @ref="creationWizard" Steps="CreationSteps" OnFinish="FinishCreationAsync" OnStepReady="CreationStepReady" Busy="busy" FinishLabel="@T("WizardCreate")" FinishTestId="data-source-save" /> }</ChildContent>
    </ResourceDefinitionForm>;
    @if (IsNew)
    {
        <UnsavedNavigationGuard IsDirty="HasDraft" HasUnsavedChanges="@(() => HasDraft)" />
        <PageHeader CollectionHref="/data-sources" CollectionLabel="@T("DataSources")" Title="@T("CreateSource")" Description="@T("DataSourcesHelp")" TestId="data-source-editor"></PageHeader>
        @feedback
        @if (loading) { <LoadingState Message="@T("Loading")" /> } else { @form }
    }
    else
    {
        <ConsoleResourceDetailsTemplate CollectionHref="/data-sources" CollectionLabel="@T("DataSources")" Resource="source" RequestedAddress="@ResourceAddress.Create(ResourceNamespace.Parse(Namespace), DataSourceResourceKinds.DataSource, Name!)"
            Name="@(source?.Definition.DisplayName ?? Name!)" ResourceType="@T("DatasetDataSource")" Domain="data" IconName="database" Description="@source?.Definition.Description"
            ResourceIdentity="@($"{loadedKey}|{source?.Uid}")" SectionState="sectionState" SectionPresentations="presentations" AdditionalSections="BusinessSections"
            LoadState="loadState" OnRetry="RetryAsync" OnRefresh="RefreshResourceAsync" Feedback="feedback" HasDraft="HasDraft" HasAdditionalDraft="@(businessTouched || toolAcquisition is not null)"
            DefinitionReadOnlyReason="@(CanManage ? null : ResourceReadOnlyReason.InsufficientPermissions)" Busy="@(busy || resourceRefreshing)"
            @bind-Yaml="rawYaml" YamlReadOnly="@(!CanManage || FormDirty)" YamlTitle="@T("DataSourceYaml")" YamlDescription="@T("DataSourceYamlHelp")"
            Enabled="@(source is null ? null : model.Enabled)" EnabledChanged="SetEnabledAsync" EnabledDisabled="@(!CanManage || busy || resourceRefreshing)" EnabledTestId="data-source-enabled-option"
            SectionTestIdPrefix="data-source" TestId="data-source-editor">
            <Actions>@if (CanManage) { <button class="button-danger" type="button" disabled="@(busy || resourceRefreshing)" @onclick="() => confirmDelete = true">@T("Delete")</button> }</Actions>
            <OverviewMetrics>
                <MetricCard Label="@T("State")" Value="@(readiness is null ? "—" : T(readiness.Ready ? "Ready" : "NotReady"))" Status="@(readiness is null ? UiStatus.Neutral : readiness.Ready ? UiStatus.Success : UiStatus.Warning)" />
                <MetricCard Label="@T("Profile")" Value="@(readiness?.Profile?.Definition.DisplayName ?? source?.Definition.Profile?.Name)" Detail="@(readiness?.Profile?.Version ?? "—")" Url="@ProfileUrl" />
                <MetricCard Label="@T("Generation")" Value="@source?.Generation.ToString()" />
                <MetricCard Label="@T("LastAcquisition")" Value="@(LatestAcquisition is null ? "—" : AcquisitionStateLabel(LatestAcquisition.State))" Detail="@(LatestAcquisition?.CreatedAt.ToLocalTime().ToString("g"))" Status="@AcquisitionTone(LatestAcquisition?.State)" Url="@(source is null ? null : AcquisitionsUrl)" />
            </OverviewMetrics>
            <OverviewSummary Context="identity">@if (source is not null) { <DataSourceResourceSummary Resource="source" Identity="identity"><AdditionalContent>
                @if (LatestAcquisition is { Progress: { } progress } latest)
                { <FlowOperationProgressSummary StepName="@progress.StepName" State="@progress.State" Attempt="progress.Attempt" StartedAt="progress.StartedAt" UpdatedAt="progress.UpdatedAt" CompletedAt="progress.CompletedAt" ErrorCode="@progress.ErrorCode" RunUrl="@FlowRunUrl(latest.FlowRunId, latest.ScopeRef, latest.LogicalScopeRef)" /> }
                @if (readiness?.Issues.Count > 0) { <FormSection Title="@T("State")">@foreach (var issue in readiness.Issues) { <p>@issue</p> }</FormSection> }
                @if (AcquisitionFlow is { } flow) { <FormSection Title="@T("AcquisitionFlow")" Description="@T("AcquisitionFlowHelp")" TestId="data-source-flow-composition"><a class="data-source-flow-card" href="@AcquisitionFlowUrl" data-testid="data-source-acquisition-flow-link"><UiIcon Name="workflow" /><strong>@flow.Name</strong><code>@AcquisitionFlowIdentity</code></a></FormSection> }
            </AdditionalContent></DataSourceResourceSummary> }</OverviewSummary>

            <DefinitionContent Context="path">@form</DefinitionContent>
            <AdditionalContent Context="path">@if (path == "acquisitions") { @AcquisitionsContent } else if (path == "discovery") { @DiscoveryContent }</AdditionalContent>
            <DraftActions><button class="text-button" type="button" disabled="@(busy || resourceRefreshing)" @onclick="Discard">@T("SourceDiscard")</button>
                @if (sectionState.Is("yaml")) { <button class="button-primary" type="button" disabled="@(busy || resourceRefreshing || FormDirty)" @onclick="SaveYamlAsync">@T("SaveYaml")</button> }
                else { <button class="button-primary" type="submit" form="data-source-definition" data-testid="data-source-save" disabled="@(busy || resourceRefreshing || !configurationValid)">@T("Save")</button> }
            </DraftActions>
        </ConsoleResourceDetailsTemplate>
    }
    <ConfirmationDialog IsOpen="confirmDelete" Title="@T("Delete")" Message="@T("DeleteConfirm")" ConfirmLabel="@T("Delete")" OnConfirm="DeleteAsync" OnCancel="() => confirmDelete = false" />
}

@code {
    [Parameter] public string? Name { get; set; }
    [SupplyParameterFromQuery(Name = "composition")] public string? Composition { get; set; }
    private bool DatasetMode => Composition == "dataset" || source?.Definition.Dataset is not null;
    [SupplyParameterFromQuery(Name = "namespace")] public string? Namespace { get; set; }
    [SupplyParameterFromQuery(Name = "scopeRef")] public string? ScopeRef { get; set; }

    private readonly CancellationTokenSource cancellation = new();
    private IReadOnlyList<DataSourceProfileResource> profiles = [];
    private IReadOnlyList<DataSourceAcquisitionResource> acquisitions = [];
    private IReadOnlyList<DataSourceDiscoveryResource> discoveries = [];
    private IReadOnlyList<DataSourceAcquisitionTargetView> targets = [];
    private IReadOnlyDictionary<string, JsonElement> profileSchemas = new Dictionary<string, JsonElement>();
    private readonly Dictionary<string, string> promotionNames = new(StringComparer.Ordinal);
    private DataSourceResource? source;
    private DataSourceReadiness? readiness;
    private ResourceScopeRef? selectedScope;
    private string? etag, error, operationsError;
    private Task polling = Task.CompletedTask;
    private long operationVersion;
    private bool refreshing, disposed;
    private DataSourceEditorModel model = new();
    private string rawYaml = string.Empty, selectedTarget = string.Empty;
    private JsonElement parameters = EmptyObject();
    private bool loading = true, busy, confirmDelete, configurationValid = true, parametersValid = true;

    private bool discoveryHistorySelected;
    private Guid? previewAcquisition;
    private DataSourceAcquisitionResource? toolAcquisition;
    private IReadOnlyList<ToolDefinitionResource> acquisitionTools = [];
    private string AcquisitionToolUrl(ToolDefinitionResource tool) =>
        $"/tools/{Uri.EscapeDataString(AgentstrationToolProvider.ToolResourceName(tool.Name))}?namespace={Uri.EscapeDataString(tool.Namespace.Value)}&scopeRef={Uri.EscapeDataString(tool.ScopeRef!.Value.Value)}&context={Uri.EscapeDataString(CurrentConsoleScope.Value)}#execution";
    private ConsoleContextSnapshot? ConsoleContext => Services.GetService<ConsoleContextState>()?.Current;
    private bool CanCreateAcquisitionTool(DataSourceAcquisitionResource item) =>
        item.State == DataSourceAcquisitionState.Succeeded
        && item.Manifest?.Artifacts.Any(artifact => artifact.Disposition == DataSourceArtifactDisposition.Publishable) == true
        && ConsoleContext is { } context
        && context.WorkspaceId == item.WorkspaceId
        && context.Permissions.Contains(AuthorizationPermissions.ResourcesWrite);
    private bool IsNew => string.IsNullOrWhiteSpace(Name);
    private bool CanManage => (ConsoleContext is null || ConsoleContext.Permissions.Contains(AuthorizationPermissions.ResourcesWrite))
        && (IsNew || source is { Governance.IsManaged: false } && selectedScope is { } owner && ResourceOwnershipContext.CanManage(owner, Services));
    private DataSourceAcquisitionResource? LatestAcquisition => acquisitions.OrderByDescending(value => value.CreatedAt).FirstOrDefault();
    private DataSourceDiscoveryResource? LatestDiscovery => discoveries.OrderByDescending(value => value.CreatedAt).FirstOrDefault();
    private string? ProfileUrl => readiness?.Profile is not { } profile ? null
        : ResourceOwnershipContext.Resource(Services, "/data-source-profiles", profile.Name, profile.Namespace, profile.ScopeRef);
    private string AcquisitionsUrl => $"{Url(source!)}#acquisitions";
    private ResolvedDataSourceFlowBinding? AcquisitionFlow => readiness?.Acquisition;
    private ResourceNamespace AcquisitionFlowNamespace => AcquisitionFlow?.Namespace ?? source!.Namespace;
    private string AcquisitionFlowIdentity => $"{AcquisitionFlowNamespace} · {AcquisitionFlow?.Version ?? "—"}";
    private string? AcquisitionFlowUrl => AcquisitionFlow is null ? null : ResourceOwnershipContext.Resource(Services, "/flows", AcquisitionFlow.Name, AcquisitionFlowNamespace, AcquisitionFlow.ScopeRef ?? readiness?.Profile?.ScopeRef ?? selectedScope);
    private JsonElement? ConfigurationSchema => readiness?.Profile is { } resolved && ProfileKey(resolved) == model.ProfileKey
        ? resolved.Definition.ConfigurationSchema
        : profileSchemas.TryGetValue(model.ProfileKey, out var schema) ? schema : null;
    private JsonElement? AcquisitionParametersSchema => JsonSchemaInputSchema.ObjectProperty(
        readiness?.Acquisition?.InputSchema, "parameters");
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private bool HasActiveDiscovery => discoveries.Any(item => IsActive(item.State));
    private bool HasActiveOperation => HasActiveDiscovery || acquisitions.Any(item => item.State is
        DataSourceAcquisitionState.Pending or DataSourceAcquisitionState.Running or DataSourceAcquisitionState.WaitingForInput or DataSourceAcquisitionState.WaitingForChild);
    private string? DiscoveryFlowUrl
    {
        get
        {
            if (readiness?.Discovery is not { } flow) return null;
            var path = flow.Namespace.IsDefault ? $"/flows/{Uri.EscapeDataString(flow.Name)}"
                : $"/namespaces/{Uri.EscapeDataString(flow.Namespace.Value)}/flows/{Uri.EscapeDataString(flow.Name)}";
            var scope = flow.ScopeRef ?? readiness.Profile?.ScopeRef ?? selectedScope;
            return $"{path}?scopeRef={Uri.EscapeDataString(scope!.Value.Value)}&context={Uri.EscapeDataString(CurrentConsoleScope.Value)}";
        }
    }
    private ResourceScopeRef CurrentConsoleScope => ResourceOwnershipContext.TryGetCurrent(Services) ?? selectedScope!.Value;
    private string FlowRunUrl(string runId, ResourceScopeRef? executionScope, ResourceScopeRef? logicalScope) =>
        $"/flow-runs/{Uri.EscapeDataString(runId)}?scopeRef={Uri.EscapeDataString((executionScope ?? CurrentConsoleScope).Value)}&context={Uri.EscapeDataString((logicalScope ?? CurrentConsoleScope).Value)}";
    protected override void OnInitialized() => polling = PollOperationsAsync();
    private async Task PollOperationsAsync()
    {
        var token = cancellation.Token;
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2), Clock);
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                if (token.IsCancellationRequested) break;
                await InvokeAsync(async () =>
                {
                    if (disposed || loading || busy || !HasActiveOperation) return;
                    await RefreshOperationsAsync();
                    if (!disposed) StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
    }
    private async Task RefreshOperationsAsync()
    {
        if (refreshing || source is null || selectedScope is null || disposed) return;
        refreshing = true;
        var version = operationVersion;
        var resource = source;
        var ownerScope = selectedScope.Value;
        var hasDiscovery = readiness?.Discovery is not null;
        try
        {
            var refreshedAcquisitions = await Client.GetAcquisitionsAsync(resource.Namespace, resource.Name, ownerScope, cancellation.Token);
            IReadOnlyList<DataSourceDiscoveryResource> refreshedDiscoveries = [];
            IReadOnlyList<DataSourceAcquisitionTargetView> refreshedTargets = [];
            if (hasDiscovery)
            {
                refreshedDiscoveries = await Client.GetDiscoveriesAsync(resource.Namespace, resource.Name, ownerScope, cancellation.Token);
                // Synchronize discovery before evaluating target staleness.
                refreshedTargets = await Client.GetAcquisitionTargetsAsync(resource.Namespace, resource.Name, ownerScope, cancellation.Token);
            }
            if (disposed || version != operationVersion) return;
            acquisitions = refreshedAcquisitions.OrderByDescending(item => item.CreatedAt).ToArray();
            discoveries = refreshedDiscoveries.OrderByDescending(item => item.CreatedAt).ToArray();
            targets = refreshedTargets;
            operationsError = null;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception) when (exception is AgentstrationApiException or HttpRequestException or OperationCanceledException or JsonException)
        {
            if (!disposed && version == operationVersion)
            {
                if (Failure(exception).Status is ResourceLoadStatus.Forbidden or ResourceLoadStatus.NotFound) { ClearPrivateState(); loadState = Failure(exception); }
                else operationsError = T("OperationalRefreshFailed");
            }
        }
        finally { refreshing = false; }
    }
    private string? returnAfterCommand;
    private void AcquisitionToolCreated(string destination) { toolAcquisition = null; returnAfterCommand = destination; }
    protected override void OnAfterRender(bool firstRender)
    {
        if (returnAfterCommand is { } destination) { returnAfterCommand = null; Navigation.NavigateTo(destination); }
    }
    private DataSourceEditorModel? observedModel;
    private EditContext? formContext;
    private ValidationMessageStore? configurationErrors, identityErrors;
    private EditContext FormContext
    {
        get
        {
            if (!ReferenceEquals(observedModel, model)) { observedModel = model; formContext = new(model); configurationErrors = new(formContext); identityErrors = new(formContext); }
            return formContext!;
        }
    }
    private readonly ResourceSectionState sectionState = new();
    private ResourceDefinitionForm? definitionForm;
    private CreationWizard? creationWizard;
    private ResourceLoadState loadState = new(ResourceLoadStatus.Loading);
    private ResourceSnapshot<DataSourceResource>? newerSnapshot;
    private string? loadedKey;
    private string baseline = "", yamlBaseline = "";
    private string? yamlEtag;
    private long loadVersion;
    private bool invalidInput, definitionTouched, resourceRefreshing, businessTouched, creationValidationFocus;
    private bool FormDirty => definitionTouched || invalidInput || JsonSerializer.Serialize(model) != baseline;
    private bool YamlDirty => rawYaml != yamlBaseline;
    private bool HasDraft => !loading && (IsNew || source is not null) && (FormDirty || YamlDirty);
    private string ContextKey => new Uri(Navigation.Uri).GetComponents(UriComponents.Query, UriFormat.UriEscaped);
    private IReadOnlyDictionary<string, string> FieldLabels => new Dictionary<string, string>
    {
        [nameof(model.Name)] = T("Name"), [nameof(model.DisplayName)] = T("DisplayName"),
        [nameof(model.Scope)] = T("Scope"), [nameof(model.Namespace)] = T("Namespace"), [nameof(model.ProfileKey)] = T("Profile"),
        [nameof(model.Description)] = T("Description"), [nameof(model.Configuration)] = T("Configuration")
    };
    private IReadOnlyDictionary<string, ResourceSectionPresentation> Presentations => new Dictionary<string, ResourceSectionPresentation>
    {
        ["definition/identity"] = new() { ReadOnly = !CanManage, HasRequiredFields = true,
            Fields = [nameof(model.Name), nameof(model.DisplayName), nameof(model.Namespace), nameof(model.Description), nameof(model.Tags), nameof(model.Scope)] },
        ["definition/configuration"] = new() { ReadOnly = !CanManage, HasRequiredFields = true,
            Fields = [nameof(model.ProfileKey), nameof(model.Configuration), nameof(model.Enabled)] },
        ["yaml"] = new() { ReadOnly = !CanManage }
    };
    private IReadOnlyList<ResourceNavigationItem> BusinessSections =>
    [new("discovery", T("Discovery"), "search"), new("acquisitions", T("Acquisitions"), "download")];
    private IReadOnlyList<CreationWizardStep> CreationSteps =>
    [new("identity", T("DatasetIdentity"), IdentityContent) { IsComplete = model.IdentityComplete },
     new("configuration", T("Configuration"), ConfigurationContent) { IsComplete = !string.IsNullOrWhiteSpace(model.ProfileKey) && configurationValid }];
    private void ShowSection(string path) => Navigation.NavigateTo(Navigation.Uri.Split('#')[0] + "#" + path);
    private void ConfigurationValidated(JsonSchemaInputValidationState state)
    {
        configurationValid = state.IsValid;
        _ = FormContext; configurationErrors!.Clear();
        if (!state.IsValid) configurationErrors.Add(FormContext.Field(nameof(model.Configuration)), T("WizardFormInvalid"));
        FormContext.NotifyValidationStateChanged();
    }
    private void MarkDirty() { definitionTouched = true; identityErrors?.Clear(); FormContext.NotifyValidationStateChanged(); }
    private void CreationStepReady(string _)
    {
        if (!creationValidationFocus) return;
        creationValidationFocus = false; definitionForm?.RequestValidationFocus();
    }
    private async Task FinishCreationAsync(CreationWizardFinish finish)
    {
        _ = FormContext; identityErrors!.Clear();
        if (!model.NamespaceValid) identityErrors.Add(FormContext.Field(nameof(model.Namespace)), T("SourceNamespaceInvalid"));
        FormContext.NotifyValidationStateChanged();
        if (!FormContext.Validate()) { finish.ReturnToStepId = ResourceDefinitionForm.FirstInvalidSection(FormContext, Presentations) == "definition/identity" ? "identity" : "configuration"; creationValidationFocus = true; return; }
        if (!configurationValid) { finish.ReturnToStepId = "configuration"; creationValidationFocus = true; return; }
        await SaveAsync();
    }
    protected override Task OnParametersSetAsync()
    {
        var key = $"{Name}|{Namespace}|{ScopeRef}|{Composition}|{ContextKey}";
        if (key == loadedKey) return Task.CompletedTask;
        loadedKey = key;
        return LoadAsync();
    }
    private void ClearPrivateState()
    {
        source = null; newerSnapshot = null; readiness = null; etag = null; profiles = []; profileSchemas = new Dictionary<string, JsonElement>();
        acquisitions = []; discoveries = []; targets = []; promotionNames.Clear(); acquisitionTools = []; toolAcquisition = null;
        parameters = EmptyObject(); selectedTarget = ""; rawYaml = yamlBaseline = baseline = "";
        model = new(); invalidInput = definitionTouched = businessTouched = false; confirmDelete = false; error = operationsError = null;
    }
    private async Task LoadAsync()
    {
        var version = ++loadVersion; operationVersion++; ClearPrivateState(); loading = true; busy = resourceRefreshing = false;
        loadState = new(ResourceLoadStatus.Loading); sectionState.Reset(loadedKey!);
        try
        {
            if (DatasetMode) return;
            if (Services.GetService<ConsoleContextState>() is { } context)
            {
                await context.EnsureLoadedAsync(cancellation.Token);
                if (disposed || version != loadVersion) return;
                if (context.Current is null) throw new InvalidOperationException(context.Error);
            }
            selectedScope = string.IsNullOrWhiteSpace(ScopeRef)
                ? ResourceOwnershipContext.TryGetCurrent(Services) ?? (ConsoleContext is { } current ? ResourceScopeRef.Parse(current.SelectedScopeRef) : null)
                : ResourceScopeRef.Parse(ScopeRef);
            if (!IsNew)
            {
                var snapshot = await Client.GetAsync(ResourceNamespace.Parse(Namespace), Name!, selectedScope!.Value, cancellation.Token);
                if (disposed || version != loadVersion) return;
                if (!Matches(snapshot.Value)) { ClearPrivateState(); loadState = new(ResourceLoadStatus.NotFound); return; }
                Adopt(snapshot);
                if (DatasetMode) return;
            }
            await LoadProfilesAsync();
            if (disposed || version != loadVersion) return;
            if (IsNew) { model.Scope = selectedScope; baseline = JsonSerializer.Serialize(model); }
            else await LoadOperationsAsync(version);
            if (disposed || version != loadVersion) return;
            loadState = new(ResourceLoadStatus.Ready) { HasContent = source is not null };
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception) { if (version == loadVersion && !disposed) { ClearPrivateState(); loadState = Failure(exception); if (IsNew) error = exception.Message; } }
        finally { if (version == loadVersion) loading = false; }
    }
    private bool Matches(DataSourceResource resource, Guid? uid = null) => resource.Name == Name && resource.Namespace == ResourceNamespace.Parse(Namespace)
        && resource.ScopeRef == selectedScope && (uid is null || resource.Uid == uid);
    private static ResourceLoadState Failure(Exception exception) => new(exception is AgentstrationApiException api ? api.StatusCode switch
    {
        System.Net.HttpStatusCode.Forbidden or System.Net.HttpStatusCode.Unauthorized => ResourceLoadStatus.Forbidden,
        System.Net.HttpStatusCode.NotFound => ResourceLoadStatus.NotFound, _ => ResourceLoadStatus.Failed
    } : ResourceLoadStatus.Failed);
    private void Adopt(ResourceSnapshot<DataSourceResource> snapshot, bool preserveYaml = false)
    {
        source = snapshot.Value; etag = snapshot.ETag; selectedScope = source.ScopeRef; newerSnapshot = null;
        model = DataSourceEditorModel.From(source); baseline = JsonSerializer.Serialize(model); definitionTouched = invalidInput = false;
        var yaml = ResourceManifestSerializer.ToYaml(new RawSource { ApiVersion = source.ApiVersion, Kind = source.Kind, Metadata = source.Metadata, ScopeRef = source.ScopeRef, Definition = source.Definition });
        if (!preserveYaml) { rawYaml = yamlBaseline = yaml; yamlEtag = snapshot.ETag; }
    }
    private void Discard()
    {
        if (busy || resourceRefreshing || source is null) return;
        Adopt(newerSnapshot ?? new(source, etag!)); error = null;
    }
    private Task RetryAsync() => source is null ? LoadAsync() : RefreshResourceAsync();
    private async Task RefreshResourceAsync()
    {
        if (source is not { } current || busy || resourceRefreshing || loading) return;
        var version = ++loadVersion; operationVersion++; resourceRefreshing = true; loadState = new(ResourceLoadStatus.Refreshing) { HasContent = true };
        try
        {
            var snapshot = await Client.GetAsync(current.Namespace, current.Name, current.ScopeRef!.Value, cancellation.Token);
            if (disposed || version != loadVersion) return;
            if (!Matches(snapshot.Value, current.Uid)) { ClearPrivateState(); loadState = new(ResourceLoadStatus.NotFound); return; }
            if (HasDraft) { if (snapshot.ETag != etag) newerSnapshot = snapshot; }
            else Adopt(snapshot);
            await LoadOperationsAsync(version);
            if (version == loadVersion) loadState = new(ResourceLoadStatus.Ready) { HasContent = true };
        }
        catch (Exception exception) when (exception is not OperationCanceledException || !cancellation.IsCancellationRequested)
        {
            if (disposed || version != loadVersion) return;
            var failure = Failure(exception);
            if (failure.Status is ResourceLoadStatus.Forbidden or ResourceLoadStatus.NotFound) ClearPrivateState();
            loadState = failure with { HasContent = source is not null };
        }
        finally { if (version == loadVersion) resourceRefreshing = false; }
    }
    private async Task LoadOperationsAsync(long version)
    {
        if (source is not { } current) return;
        try
        {
            var state = await Client.GetReadinessAsync(current.Namespace, current.Name, current.ScopeRef!.Value, cancellation.Token);
            var history = await Client.GetAcquisitionsAsync(current.Namespace, current.Name, current.ScopeRef.Value, cancellation.Token);
            var discovery = state.Discovery is null ? [] : await Client.GetDiscoveriesAsync(current.Namespace, current.Name, current.ScopeRef.Value, cancellation.Token);
            var choices = state.Discovery is null ? [] : await Client.GetAcquisitionTargetsAsync(current.Namespace, current.Name, current.ScopeRef.Value, cancellation.Token);
            IReadOnlyList<ToolDefinitionResource> tools = [];
            if (history.Count > 0 && Services.GetService<IToolDefinitionsClient>() is { } definitions)
                tools = (await definitions.GetAsync(cancellation.Token)).Where(value => value.Definition is AcquisitionToolDefinitionProperties).ToArray();
            if (disposed || version != loadVersion) return;
            readiness = state; acquisitions = history.OrderByDescending(item => item.CreatedAt).ToArray(); discoveries = discovery; targets = choices; acquisitionTools = tools; operationsError = null;
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            if (version != loadVersion || disposed) return;
            if (Failure(exception).Status is ResourceLoadStatus.Forbidden or ResourceLoadStatus.NotFound) throw;
            operationsError = T("OperationalLoadFailed");
        }
    }
    private async Task LoadProfilesAsync()
    {
        var version = loadVersion;
        var catalog = (await Profiles.GetAsync(cancellation.Token)).Where(value => value.ActiveVersion is not null && value.Definition.Enabled).ToArray();
        var schemas = await Task.WhenAll(catalog.Select(async item =>
        {
            var revisions = await Profiles.GetRevisionsAsync(item.Namespace, item.Name, item.ScopeRef!.Value, cancellation.Token);
            return new KeyValuePair<string, JsonElement>(ProfileKey(item), revisions.Single(value => value.Version == item.ActiveVersion).Definition.ConfigurationSchema.Clone());
        }));
        if (version != loadVersion || disposed) return;
        profiles = catalog; profileSchemas = schemas.ToDictionary(item => item.Key, item => item.Value, StringComparer.Ordinal);
    }
    private async Task SaveAsync()
    {
        if (!CanManage || busy || resourceRefreshing || !configurationValid) return;
        var version = loadVersion; busy = true; error = null;
        try
        {
            var definition = model.Properties(source);
            if (IsNew)
            {
                var saved = await Client.CreateAsync(new(model.Name.Trim(), definition, ResourceNamespace.Parse(model.Namespace).Value, model.Scope), cancellation.Token);
                if (version != loadVersion || disposed) return;
                definitionTouched = invalidInput = false; baseline = JsonSerializer.Serialize(model); Navigation.NavigateTo(Url(saved.Value));
            }
            else
            {
                var saved = await Client.UpdateAsync(source!.Namespace, source.Name, selectedScope!.Value, new(definition), etag!, cancellation.Token);
                if (version != loadVersion || disposed) return;
                Adopt(saved, preserveYaml: YamlDirty); await LoadOperationsAsync(version);
            }
        }
        catch (Exception exception) { if (version == loadVersion && !disposed) error = exception.Message; }
        finally { if (version == loadVersion) busy = false; }
    }
    private Task SetEnabledAsync(bool value)
    {
        if (!CanManage || busy || resourceRefreshing) return Task.CompletedTask;
        model.Enabled = value; sectionState.Visit("definition/identity");
        return Task.CompletedTask;
    }
    private async Task StartAsync()
    {
        if (!parametersValid || readiness?.CanAcquire != true || busy || resourceRefreshing || source is null) return;
        var version = ++operationVersion;
        busy = true;
        error = null;
        operationsError = null;
        try
        {
            var started = await Client.StartAcquisitionAsync(source!.Namespace, source.Name, selectedScope!.Value,
                new() { Parameters = parameters.Clone(), DataSourceScopeRef = selectedScope,
                    TargetName = string.IsNullOrWhiteSpace(selectedTarget) ? null : selectedTarget }, cancellation.Token);
            if (disposed || version != operationVersion) return;
            acquisitions = acquisitions.Where(item => item.Uid != started.Value.Uid).Prepend(started.Value)
                .OrderByDescending(item => item.CreatedAt).ToArray();
            await RefreshOperationsAsync();
        }
        catch (Exception exception) { if (!disposed && version == operationVersion) error = exception.Message; }
        finally { if (version == operationVersion) busy = false; }
    }
    private async Task StartDiscoveryAsync()
    {
        if (busy || resourceRefreshing || source is null) return;
        busy = true;
        error = null;
        operationsError = null;
        var version = ++operationVersion;
        try
        {
            var started = await Client.StartDiscoveryAsync(source!.Namespace, source.Name, selectedScope!.Value,
                new() { DataSourceScopeRef = selectedScope }, cancellation.Token);
            if (disposed || version != operationVersion) return;
            discoveries = discoveries.Where(item => item.Uid != started.Value.Uid).Prepend(started.Value)
                .OrderByDescending(item => item.CreatedAt).ToArray();
            await RefreshOperationsAsync();
        }
        catch (Exception exception) { if (!disposed && version == operationVersion) error = exception.Message; }
        finally { if (version == operationVersion) busy = false; }
    }
    private bool PromotionNameInUse(DataSourceDiscoveryChoice choice) =>
        targets.Any(item => string.Equals(item.Target.Name, PromotionName(choice), StringComparison.OrdinalIgnoreCase));
    private bool ChoiceAlreadyPromoted(DataSourceDiscoveryChoice choice) =>
        targets.Any(item => item.Target.DiscoveryUid == LatestDiscovery?.Uid && item.Target.ChoiceId == choice.Id);
    private DataSourceAcquisitionTargetView? MatchingTarget(DataSourceDiscoveryChoice choice) =>
        targets.FirstOrDefault(item => item.Target.ChoiceId == choice.Id
            && string.Equals(item.Target.Name, PromotionName(choice), StringComparison.OrdinalIgnoreCase));
    private string ChoiceActionLabel(DataSourceDiscoveryChoice choice) =>
        MatchingTarget(choice) is { Stale: true } ? "ReconcileTarget"
        : ChoiceAlreadyPromoted(choice) ? "TargetPromoted"
        : PromotionNameInUse(choice) ? "TargetNameUsed" : "Promote";
    private string? ChoiceActionHelp(DataSourceDiscoveryChoice choice) =>
        MatchingTarget(choice) is { Stale: true } item ? T(CanReconcile(item) ? "ReconcileHelp" : "ReconcileUnavailable")
        : PromotionNameInUse(choice) && !ChoiceAlreadyPromoted(choice) ? T("TargetNameInUse") : null;
    private bool CanApplyChoice(DataSourceDiscoveryChoice choice) =>
        MatchingTarget(choice) is { Stale: true } item
            ? !busy && !HasActiveDiscovery && choice.Eligible && CanReconcile(item)
            : CanPromote(choice);
    private Task ApplyChoiceAsync(DataSourceDiscoveryChoice choice) =>
        MatchingTarget(choice) is { Stale: true } item ? ReconcileTargetAsync(item) : PromoteAsync(choice);
    private bool CanPromote(DataSourceDiscoveryChoice choice) =>
        !busy && !HasActiveDiscovery && choice.Eligible && LatestDiscovery?.State == DataSourceDiscoveryState.Succeeded
        && !string.IsNullOrWhiteSpace(PromotionName(choice)) && !PromotionNameInUse(choice)
        && !ChoiceAlreadyPromoted(choice);
    private bool CanReconcile(DataSourceAcquisitionTargetView item) =>
        item.Stale && !string.IsNullOrWhiteSpace(item.Target.ETag)
        && LatestDiscovery is { State: DataSourceDiscoveryState.Succeeded, Manifest: { } manifest } discovery
        && discovery.Uid != item.Target.DiscoveryUid
        && manifest.Choices.Any(choice => choice.Id == item.Target.ChoiceId && choice.Eligible);
    private async Task PromoteAsync(DataSourceDiscoveryChoice choice)
    {
        if (!CanPromote(choice)) return;
        var version = ++operationVersion;
        busy = true;
        error = null;
        try
        {
            await Client.PromoteTargetAsync(source!.Namespace, LatestDiscovery!.Name,
                new(PromotionName(choice), choice.Id, choice.DisplayName, choice.Description), cancellation.Token);
            if (disposed || version != operationVersion) return;
            var result = await Client.GetAcquisitionTargetsAsync(source.Namespace, source.Name, selectedScope!.Value, cancellation.Token);
            if (!disposed && version == operationVersion) targets = result;
        }
        catch (AgentstrationApiException exception) when (exception.IsConcurrencyConflict) { if (!disposed && version == operationVersion) error = T("TargetNameInUse"); }
        catch (Exception exception) { if (!disposed && version == operationVersion) error = exception.Message; }
        finally { if (version == operationVersion) busy = false; }
    }
    private async Task ReconcileTargetAsync(DataSourceAcquisitionTargetView item)
    {
        if (busy || HasActiveDiscovery || !CanReconcile(item)) return;
        var version = ++operationVersion;
        busy = true;
        error = null;
        try
        {
            await Client.ReconcileTargetAsync(item.Target.Namespace, item.Target.Name,
                new(LatestDiscovery!.Name, item.Target.ChoiceId), item.Target.ETag!, cancellation.Token);
            if (disposed || version != operationVersion) return;
            var result = await Client.GetAcquisitionTargetsAsync(source!.Namespace, source.Name, selectedScope!.Value, cancellation.Token);
            if (!disposed && version == operationVersion) targets = result;
        }
        catch (AgentstrationApiException exception) when (exception.IsConcurrencyConflict) { if (!disposed && version == operationVersion) error = T("TargetConcurrencyConflict"); }
        catch (Exception exception) { if (!disposed && version == operationVersion) error = exception.Message; }
        finally { if (version == operationVersion) busy = false; }
    }
    private string PromotionName(DataSourceDiscoveryChoice choice)
    {
        if (promotionNames.TryGetValue(choice.Id, out var value)) return value;
        var existing = targets.Where(item => item.Target.ChoiceId == choice.Id).Take(2).ToArray();
        value = existing.Length == 1 ? existing[0].Target.Name
            : string.Concat(choice.Id.ToLowerInvariant().Select(character => char.IsLetterOrDigit(character) || character is '.' or '-' or '_' ? character : '-')).Trim('-');
        if (value.Length > 128) value = value[..128];
        promotionNames[choice.Id] = value;
        return value;
    }
    private async Task SaveYamlAsync()
    {
        if (!CanManage || busy || resourceRefreshing || FormDirty) return;
        var version = loadVersion; busy = true; error = null;
        try
        {
            var raw = ResourceManifestSerializer.FromYaml<RawSource>(rawYaml);
            if (raw.Metadata.Name != source!.Name || raw.Metadata.Namespace != source.Namespace || raw.ScopeRef != source.ScopeRef || raw.Kind != source.Kind || raw.ApiVersion != source.ApiVersion)
                throw new ArgumentException(T("IdentityImmutable"));
            var saved = await Client.UpdateAsync(source.Namespace, source.Name, selectedScope!.Value, new(raw.Definition), yamlEtag!, cancellation.Token);
            if (version == loadVersion && !disposed) { Adopt(saved); await LoadOperationsAsync(version); }
        }
        catch (Exception exception) { if (version == loadVersion && !disposed) error = exception.Message; }
        finally { if (version == loadVersion) busy = false; }
    }
    private async Task DeleteAsync()
    {
        if (!CanManage || source is null || busy || resourceRefreshing) return;
        var version = loadVersion; confirmDelete = false; busy = true;
        try { await Client.DeleteAsync(source.Namespace, source.Name, selectedScope!.Value, etag!, cancellation.Token); if (version == loadVersion && !disposed) { ClearPrivateState(); loadState = new(ResourceLoadStatus.NotFound); returnAfterCommand = "/data-sources"; } }
        catch (Exception exception) { if (version == loadVersion && !disposed) error = exception.Message; }
        finally { if (version == loadVersion) busy = false; }
    }
    private void ToggleAcquisitionPreview(Guid uid) => previewAcquisition = previewAcquisition == uid ? null : uid;

    private static string ProfileKey(DataSourceProfileResource item) => $"{item.ScopeRef!.Value.Value}|{item.Namespace.Value}|{item.Name}";
    private static string ProfileKey(ResolvedDataSourceProfile item) => $"{item.ScopeRef.Value}|{item.Namespace.Value}|{item.Name}";
    private static (ResourceScopeRef Scope, ResourceNamespace Namespace, string Name) ParseProfile(string key) { var parts = key.Split('|', 3); return (ResourceScopeRef.Parse(parts[0]), ResourceNamespace.Parse(parts[1]), parts[2]); }
    private string Url(DataSourceResource item) => $"/data-sources/{Uri.EscapeDataString(item.Name)}?namespace={Uri.EscapeDataString(item.Namespace.Value)}&scopeRef={Uri.EscapeDataString(item.ScopeRef!.Value.Value)}&context={Uri.EscapeDataString(CurrentConsoleScope.Value)}";
    private string AcquisitionStateLabel(DataSourceAcquisitionState state) => T($"AcquisitionState.{state}");
    private static UiStatus AcquisitionTone(DataSourceAcquisitionState? state) => state switch { DataSourceAcquisitionState.Succeeded => UiStatus.Success, DataSourceAcquisitionState.Failed or DataSourceAcquisitionState.Cancelled or DataSourceAcquisitionState.TimedOut => UiStatus.Warning, null => UiStatus.Neutral, _ => UiStatus.Info };
    private static JsonElement EmptyObject() => JsonSerializer.SerializeToElement(new { });
    private sealed record RawSource { public required string ApiVersion { get; init; } public required string Kind { get; init; } public required ResourceMetadata Metadata { get; init; } public ResourceScopeRef? ScopeRef { get; init; } public required DataSourceProperties Definition { get; init; } }
    private static bool IsActive(DataSourceDiscoveryState state) => state is DataSourceDiscoveryState.Pending
        or DataSourceDiscoveryState.Running or DataSourceDiscoveryState.WaitingForInput or DataSourceDiscoveryState.WaitingForChild;
    private static UiStatus DiscoveryTone(DataSourceDiscoveryState state) => state switch
    {
        DataSourceDiscoveryState.Succeeded => UiStatus.Success,
        DataSourceDiscoveryState.Failed or DataSourceDiscoveryState.TimedOut => UiStatus.Danger,
        DataSourceDiscoveryState.Cancelled => UiStatus.Warning,
        _ => UiStatus.Info
    };
    public async ValueTask DisposeAsync()
    {
        if (disposed) return;
        disposed = true; loadVersion++; operationVersion++;
        await cancellation.CancelAsync();
        await polling;
        cancellation.Dispose();
    }

    private RenderFragment IdentityContent => @<ResourceIdentityEditor ResourceKind="@DataSourceResourceKinds.DataSource"
        @bind-DisplayName="model.DisplayName" @bind-TechnicalName="model.Name" @bind-Namespace="model.Namespace" NamespaceEditable="IsNew"
        @bind-ScopeRef="model.Scope" @bind-Description="model.Description" @bind-Labels="model.Tags" LabelsReadOnly="true" IsNew="IsNew" ReadOnly="@(!CanManage)"
        DisplayNameTestId="data-source-display-name" TechnicalNameTestId="data-source-name" />;
    private RenderFragment ConfigurationContent => @<FormSection Title="@T("Configuration")"><FormGrid>
        @if (IsNew) { <label class="checkbox-field resource-enabled-toggle"><FormCheckbox @bind-Value="model.Enabled" role="switch" /><span>@T("Enabled")</span></label> }
        <FormField Label="@T("Profile")" Required="true"><ChildContent><ClearableSelect TValue="string" @bind-Value="model.ProfileKey" data-testid="data-source-profile"><option value="">@T("Select")</option>@foreach (var item in profiles) { <option value="@ProfileKey(item)">@item.Definition.DisplayName · @item.ActiveVersion · @item.ScopeRef</option> }@if (source?.Definition.Profile is not null && profiles.All(item => ProfileKey(item) != model.ProfileKey)) { <option value="@model.ProfileKey">@source.Definition.Profile.Name</option> }</ClearableSelect></ChildContent><Validation><ValidationMessage For="@(() => model.ProfileKey)" /></Validation></FormField>
        <div class="form-field-wide schema-backed-input" data-testid="data-source-configuration"><span>@T("Configuration")</span><JsonSchemaInputEditor Schema="ConfigurationSchema" Value="model.Configuration" ValueChanged="value => model.Configuration = value" ValidationChanged="ConfigurationValidated" Disabled="busy" /></div>
    </FormGrid></FormSection>;
