    private RenderFragment AcquisitionsContent => @<div class="resource-editor-view">        <section class="panel form-section data-source-acquisitions" data-testid="data-source-acquisitions"><div class="panel-header"><div><p class="eyebrow">@T("Acquisitions")</p><h2>@T("AcquisitionHistory")</h2><p>@T("AcquisitionHelp")</p></div><button class="button-primary" type="button" data-testid="data-source-start-acquisition" disabled="@(busy || !parametersValid || readiness?.CanAcquire != true || readiness?.Discovery is not null && string.IsNullOrWhiteSpace(selectedTarget))" @onclick="StartAsync">@T("StartAcquisition")</button></div>
        @if (readiness?.Discovery is not null) { <FormField Label="@T("AcquisitionTarget")" Class="form-span-2"><ClearableSelect TValue="string" @bind-Value="selectedTarget" data-testid="data-source-acquisition-target"><option value="">@T("SelectTarget")</option>@foreach (var item in targets.Where(value => value.Target.Enabled)) { <option value="@item.Target.Name" disabled="@item.Stale">@item.Target.DisplayName @(item.Stale ? $"· {T("Stale")}" : string.Empty)</option> }</ClearableSelect></FormField> }
        <div class="data-source-parameters" data-testid="data-source-acquisition-parameters" @oninput="() => businessTouched = true" @onchange="() => businessTouched = true"><span>@T("Parameters")</span><JsonSchemaInputEditor Schema="AcquisitionParametersSchema" Value="parameters" ValueChanged="value => parameters = value" ValidationChanged="state => parametersValid = state.IsValid" Disabled="busy" /><small>@T("ParametersHelp")</small></div>
        @if (acquisitions.Count == 0 && operationsError is null)
        {
            <p class="muted">@T("NoAcquisitions")</p>
        }
        else
        {
            <CollectionView TItem="DataSourceAcquisitionResource" Items="acquisitions" RowTestId="data-source-acquisition-row" ItemAttributes="@((item) => new Dictionary<string, object> { ["data-state"] = item.State.ToString() })" InformationLabels="@(new[] { T("Created"), T("FlowRun"), T("Version"), T("AcquiredArtifacts") })" IsExpanded="@(item => previewAcquisition == item.Uid && item.State == DataSourceAcquisitionState.Succeeded && item.Manifest is { Artifacts.Count: > 0 })">
                <Identity Context="item"><CollectionIdentity DisplayName="@item.Name" Namespace="@item.Namespace.Value" Name="@item.Name" Href="@FlowRunUrl(item.FlowRunId, item.ScopeRef, item.LogicalScopeRef)" IconName="database" ><IconBadges><StatusBadge Text="@AcquisitionStateLabel(item.State)" Status="@AcquisitionTone(item.State)" IconOnly /></IconBadges></CollectionIdentity></Identity>
                <Scope Context="item"><ResourceScopeBadge ScopeRef="@(item.LogicalScopeRef ?? item.ScopeRef)" /></Scope>
                <Information Context="item">
                    <CollectionValue Label="@T("Created")">@item.CreatedAt.ToLocalTime().ToString("g")</CollectionValue>
                    <CollectionValue Label="@T("FlowRun")"><code>@item.FlowRunId</code>
                    @if (item.Progress is { } progress) { <FlowOperationProgressSummary StepName="@progress.StepName" State="@progress.State" Attempt="progress.Attempt" StartedAt="progress.StartedAt" UpdatedAt="progress.UpdatedAt" CompletedAt="progress.CompletedAt" ErrorCode="@progress.ErrorCode" /> }
                    </CollectionValue>
                    <CollectionValue Label="@T("Version")"><code>@(item.Composition?.Profile.Version ?? item.Dataset?.OperationType.Version)</code></CollectionValue>
                    <CollectionValue Label="@T("AcquiredArtifacts")">@(item.State == DataSourceAcquisitionState.Succeeded ? item.Manifest?.Artifacts.Count.ToString() ?? "—" : "—")</CollectionValue>
                </Information>
                <Actions Context="item"><CollectionActions ResourceName="@item.Name"><a class="text-button data-source-flow-run" href="@FlowRunUrl(item.FlowRunId, item.ScopeRef, item.LogicalScopeRef)" title="@item.FlowRunId">@T("FlowRun")</a>
                            @if (item.State == DataSourceAcquisitionState.Succeeded && item.Manifest is { Artifacts.Count: > 0 })
                            {
                                <div class="data-source-acquisition-actions">
                                    <button class="button-secondary" type="button" aria-expanded="@(previewAcquisition == item.Uid ? "true" : "false")" data-testid="data-source-acquisition-preview" @onclick="() => ToggleAcquisitionPreview(item.Uid)">
                                        @T(previewAcquisition == item.Uid ? "HideAcquiredArtifacts" : "ViewAcquiredArtifacts")
                                    </button>
                                    @if (CanCreateAcquisitionTool(item))
                                    {
                                        <button class="button-secondary" type="button" aria-haspopup="dialog" data-testid="data-source-create-tool" @onclick="() => toolAcquisition = item">
                                            @T("CreateAcquisitionTool")
                                        </button>
