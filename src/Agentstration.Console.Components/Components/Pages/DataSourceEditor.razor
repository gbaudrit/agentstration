@page "/data-sources/new"
@page "/data-sources/{Name}"
@implements IAsyncDisposable
@inject IDataSourcesClient Client
@inject IDataSourceProfilesClient Profiles
@inject NavigationManager Navigation
@inject TimeProvider Clock
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<DataSourcesStrings> Localizer

<PageTitle>@(source?.Definition.DisplayName ?? T(IsNew ? "CreateSource" : "DataSources")) · Agentstration</PageTitle>
<PageHeader Title="@(source?.Definition.DisplayName ?? T("CreateSource"))" Description="@T("DataSourcesHelp")" TestId="data-source-editor">
    <Actions>@if (!IsNew && CanManage) { <button class="button-danger" type="button" @onclick="() => confirmDelete = true">@T("Delete")</button> }<a class="button-secondary" href="/data-sources">@T("Back")</a></Actions>
</PageHeader>
@if (loading) { <LoadingState Message="@T("Loading")" /> }
else
{
    @if (error is not null) { <div class="form-alert form-alert-danger" role="alert">@error</div> }
    @if (operationsError is not null && (tab is Tab.Discovery or Tab.Acquisitions)) { <div class="form-alert form-alert-danger" role="alert" data-testid="data-source-operations-error">@operationsError</div> }
    @if (!IsNew && selectedScope is not null) { <InheritedResourceNotice OwnerScopeRef="selectedScope.Value" /> }
    @if (!IsNew) { <ResourceTabs Label="@T("DataSources")">@foreach (var value in Enum.GetValues<Tab>().Where(value => CanManage || value is not Tab.Access)) { <button type="button" role="tab" class="@(tab == value ? "active" : null)" @onclick="() => SelectTab(value)">@T(value.ToString())</button> }</ResourceTabs> }
    @if (tab == Tab.Overview && !IsNew)
    {
        <section class="metric-grid"><MetricCard Label="@T("State")" Value="@T(readiness?.Ready == true ? "Ready" : "NotReady")" Detail="@T(source!.Definition.Enabled ? "Enabled" : "Disabled")" Status="@(readiness?.Ready == true ? UiStatus.Success : UiStatus.Warning)" /><MetricCard Label="@T("Profile")" Value="@(readiness?.Profile?.Definition.DisplayName ?? source!.Definition.Profile.Name)" Detail="@(readiness?.Profile?.Version ?? "—")" Status="@UiStatus.Info" Url="@ProfileUrl" /><MetricCard Label="@T("Generation")" Value="@source.Generation.ToString()" Detail="@($"{source.Namespace}/{source.Name}")" Status="@UiStatus.Info" /><MetricCard Label="@T("LastAcquisition")" Value="@(LatestAcquisition is null ? T("None") : AcquisitionStateLabel(LatestAcquisition.State))" Detail="@(LatestAcquisition is null ? T("AcquisitionCount", acquisitions.Count) : $"{T("AcquisitionCount", acquisitions.Count)} · {LatestAcquisition.CreatedAt.ToLocalTime():g}")" Status="@AcquisitionTone(LatestAcquisition?.State)" Url="@AcquisitionsUrl" /></section>
        @if (readiness?.Issues.Count > 0) { <section class="panel form-section">@foreach (var issue in readiness.Issues) { <p>@issue</p> }</section> }
        @if (AcquisitionFlow is { } acquisitionFlow)
        {
            <section class="panel form-section data-source-flow-composition" data-testid="data-source-flow-composition">
                <div class="panel-header"><div><p class="eyebrow">@T("FlowBindings")</p><h2>@T("AcquisitionFlow")</h2><p>@T("AcquisitionFlowHelp")</p></div></div>
                <a class="data-source-flow-card" href="@AcquisitionFlowUrl" data-testid="data-source-acquisition-flow-link"><span class="data-source-composition-icon"><UiIcon Name="workflow" /></span><span><small>@T("AcquisitionFlow")</small><strong>@acquisitionFlow.Name</strong><code>@AcquisitionFlowIdentity</code></span><UiIcon Name="arrow-right" /></a>
            </section>
        }
    }
    else if (tab == Tab.Definition || IsNew)
    {
        <EditForm Model="this" OnValidSubmit="SaveAsync" class="panel form-section"><fieldset class="resource-definition-fields" disabled="@(!CanManage)"><FormGrid>
            <ResourceIdentityFields @bind-DisplayName="displayName" @bind-TechnicalName="technicalName" IsNew="@IsNew" DisplayNameTestId="data-source-display-name" TechnicalNameTestId="data-source-name" />
            <FormField Label="@T("Namespace")"><ClearableText @bind-Value="sourceNamespace" Disabled="@(!IsNew)" /></FormField>
            @if (IsNew) { <ResourceScopeFormField ResourceKind="@DataSourceResourceKinds.DataSource" @bind-Value="selectedScope" /> } else { <label><span>@T("Scope")</span><ResourceScopeBadge ScopeRef="selectedScope" /></label> }
            <FormField Label="@T("Description")" Optional="true" Class="form-span-2"><ClearableText Multiline="true" @bind-Value="description" maxlength="2000"></ClearableText></FormField>
            <label class="data-source-choice form-span-2" data-testid="data-source-enabled-option"><FormCheckbox @bind-Value="enabled" /><span class="data-source-choice-icon"><UiIcon Name="check" /></span><span><strong>@T("Enabled")</strong><small>@T("EnabledHelp")</small></span></label>
            <FormField Label="@T("Profile")" Class="form-span-2" Required="true"><ClearableSelect TValue="string" Value="@profileKey" ValueExpression="@(() => profileKey)" ValueChanged="value => ChangeProfile(new ChangeEventArgs { Value = value })" required data-testid="data-source-profile"><option value="">@T("Select")</option>@foreach (var item in profiles) { <option value="@ProfileKey(item)">@item.Definition.DisplayName · @item.ActiveVersion · @item.ScopeRef</option> }@if (readiness?.Profile is { } resolvedProfile && profiles.All(item => ProfileKey(item) != ProfileKey(resolvedProfile))) { <option value="@ProfileKey(resolvedProfile)">@resolvedProfile.Definition.DisplayName · @resolvedProfile.Version · @resolvedProfile.ScopeRef</option> }</ClearableSelect></FormField>
            <div class="form-field-wide schema-backed-input" data-testid="data-source-configuration"><span>@T("Configuration")</span><JsonSchemaInputEditor Schema="ConfigurationSchema" Value="configuration" ValueChanged="value => configuration = value" ValidationChanged="state => configurationValid = state.IsValid" Disabled="busy" /></div>
        </FormGrid>@if (CanManage) { <FormActions><button class="button-primary" type="submit" data-testid="data-source-save" disabled="@(busy || !configurationValid)">@(busy ? T("Saving") : T("Save"))</button></FormActions> }</fieldset></EditForm>
    }
    else if (tab == Tab.Acquisitions)
    {
        <section class="panel form-section data-source-acquisitions" data-testid="data-source-acquisitions"><div class="panel-header"><div><p class="eyebrow">@T("Acquisitions")</p><h2>@T("AcquisitionHistory")</h2><p>@T("AcquisitionHelp")</p></div><button class="button-primary" type="button" data-testid="data-source-start-acquisition" disabled="@(busy || !parametersValid || readiness?.Ready != true || readiness?.Discovery is not null && string.IsNullOrWhiteSpace(selectedTarget))" @onclick="StartAsync">@T("StartAcquisition")</button></div>
        @if (readiness?.Discovery is not null) { <FormField Label="@T("AcquisitionTarget")" Class="form-span-2"><ClearableSelect TValue="string" @bind-Value="selectedTarget" data-testid="data-source-acquisition-target"><option value="">@T("SelectTarget")</option>@foreach (var item in targets.Where(value => value.Target.Enabled)) { <option value="@item.Target.Name" disabled="@item.Stale">@item.Target.DisplayName @(item.Stale ? $"· {T("Stale")}" : string.Empty)</option> }</ClearableSelect></FormField> }
        <div class="data-source-parameters" data-testid="data-source-acquisition-parameters"><span>@T("Parameters")</span><JsonSchemaInputEditor Schema="AcquisitionParametersSchema" Value="parameters" ValueChanged="value => parameters = value" ValidationChanged="state => parametersValid = state.IsValid" Disabled="busy" /><small>@T("ParametersHelp")</small></div>
        @if (acquisitions.Count == 0)
        {
            <p class="muted">@T("NoAcquisitions")</p>
        }
        else
        {
            <DataGrid TItem="DataSourceAcquisitionResource" Items="acquisitions">
                <Header><tr><th>@T("Created")</th><th>@T("State")</th><th>@T("FlowRun")</th><th>@T("Version")</th><th>@T("AcquiredArtifacts")</th></tr></Header>
                <Row Context="item">
                    <tr data-testid="data-source-acquisition-row" data-state="@item.State">
                        <td data-label="@T("Created")">@item.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td data-label="@T("State")"><StatusBadge Text="@AcquisitionStateLabel(item.State)" Status="@AcquisitionTone(item.State)" /></td>
                        <td data-label="@T("FlowRun")"><a class="text-button data-source-flow-run" href="@FlowRunUrl(item.FlowRunId, item.ScopeRef, item.LogicalScopeRef)" title="@item.FlowRunId"><code>@item.FlowRunId</code></a></td>
                        <td data-label="@T("Version")"><code>@item.Composition.Profile.Version</code></td>
                        <td data-label="@T("AcquiredArtifacts")">
                            @if (item.Manifest is { Artifacts.Count: > 0 })
                            {
                                <div class="data-source-acquisition-actions">
                                    <button class="button-secondary" type="button" aria-expanded="@(previewAcquisition == item.Uid ? "true" : "false")" data-testid="data-source-acquisition-preview" @onclick="() => ToggleAcquisitionPreview(item.Uid)">
                                        @T(previewAcquisition == item.Uid ? "HideAcquiredArtifacts" : "ViewAcquiredArtifacts")
                                    </button>
                                    @if (CanCreateAcquisitionTool(item))
                                    {
                                        <button class="button-secondary" type="button" aria-haspopup="dialog" data-testid="data-source-create-tool" @onclick="() => toolAcquisition = item">
                                            @T("CreateAcquisitionTool")
                                        </button>
                                    }
                                    @foreach (var linkedTool in acquisitionTools.Where(value => value.Definition.Acquisition is { } binding
                                        && binding.TemplateId == item.Name && binding.TemplateNamespace == item.Namespace))
                                    {
                                        <a class="button-secondary" href="@AcquisitionToolUrl(linkedTool)" data-testid="data-source-linked-tool">@linkedTool.Definition.DisplayName</a>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="muted">—</span>
                            }
                        </td>
                    </tr>
                    @if (previewAcquisition == item.Uid && item.Manifest is { Artifacts.Count: > 0 } manifest)
                    {
                        <tr class="data-source-acquisition-preview-row"><td colspan="5">
                            <DataSourceAcquisitionArtifacts @key="item.Uid" Artifacts="manifest.Artifacts" ContextScope="CurrentConsoleScope" />
                        </td></tr>
                    }
                </Row>
            </DataGrid>
        }
        </section>
        @if (toolAcquisition is { } template)
        {
            <DataSourceAcquisitionToolEditor @key="template.Uid" Acquisition="template"
                SourceDisplayName="@source!.Definition.DisplayName" WorkspaceDisplayName="@ConsoleContext?.WorkspaceDisplayName"
                ContextScope="CurrentConsoleScope" OnCancel="() => toolAcquisition = null" />
        }
    }
    else if (tab == Tab.Discovery)
    {
        <section class="panel form-section data-source-discovery" data-testid="data-source-discovery">
        <div class="panel-header"><div><p class="eyebrow">@T("Discovery")</p><h2>@T("DiscoveryTargets")</h2><p>@T("DiscoveryHelp")</p></div><FormActions>
            <button class="button-secondary" type="button" disabled="@(busy || refreshing)" data-testid="data-source-refresh-discovery" @onclick="RefreshOperationsAsync">@T("Refresh")</button>
            <button class="button-primary" type="button" data-testid="data-source-start-discovery" disabled="@(busy || HasActiveDiscovery || readiness?.Discovery is null)" @onclick="StartDiscoveryAsync">@T("StartDiscovery")</button>
        </FormActions></div>
        @if (readiness?.Discovery is { } discoveryFlow)
        {
            <a class="data-source-flow-card" href="@DiscoveryFlowUrl" data-testid="data-source-discovery-flow-link"><span class="data-source-composition-icon"><UiIcon Name="workflow" /></span><span><small>@T("DiscoveryFlowTitle")</small><strong>@discoveryFlow.Name</strong><code>@discoveryFlow.ScopeRef · @discoveryFlow.Namespace/@discoveryFlow.Version</code></span><UiIcon Name="arrow-right" /></a>
        }
        <p class="muted">@T("DiscoveryLiveUpdates")</p>
        <nav class="section-tabs" role="tablist" aria-label="@T("Discovery")">
            <button id="discovery-results-tab" type="button" role="tab" aria-selected="@(!discoveryHistorySelected ? "true" : "false")" aria-controls="discovery-panel" class="@(!discoveryHistorySelected ? "active" : null)" data-testid="data-source-discovery-results-tab" @onclick="() => discoveryHistorySelected = false">@T("DiscoveryResultsTab")</button>
            <button id="discovery-history-tab" type="button" role="tab" aria-selected="@(discoveryHistorySelected ? "true" : "false")" aria-controls="discovery-panel" class="@(discoveryHistorySelected ? "active" : null)" data-testid="data-source-discovery-history-tab" @onclick="() => discoveryHistorySelected = true">@T("DiscoveryHistoryTab")</button>
        </nav>
        <div id="discovery-panel" role="tabpanel" aria-labelledby="@(discoveryHistorySelected ? "discovery-history-tab" : "discovery-results-tab")" tabindex="0">
        @if (discoveryHistorySelected)
        {
        <section class="data-source-discovery-history" data-testid="data-source-discovery-history" aria-live="polite">
            <h3>@T("DiscoveryHistory")</h3>
            @if (discoveries.Count > 0)
            {
                <DataGrid TItem="DataSourceDiscoveryResource" Items="discoveries"><Header><tr><th>@T("Created")</th><th>@T("State")</th><th>@T("FlowRun")</th><th>@T("Version")</th></tr></Header>
                    <Row Context="item"><tr data-testid="data-source-discovery-row" data-state="@item.State"><td data-label="@T("Created")">@item.CreatedAt.ToLocalTime().ToString("g")</td><td data-label="@T("State")"><StatusBadge Text="@T($"AcquisitionState.{item.State}")" Status="@DiscoveryTone(item.State)" /></td><td data-label="@T("FlowRun")"><a class="text-button data-source-flow-run" href="@FlowRunUrl(item.FlowRunId, item.ScopeRef, item.LogicalScopeRef)" title="@item.FlowRunId"><code>@item.FlowRunId</code></a></td><td data-label="@T("Version")"><code>@item.Composition.Profile.Version</code></td></tr></Row>
                </DataGrid>
            }
            else { <p class="muted">@T("NoDiscovery")</p> }
        </section>
        }
        else
        {
        @if (LatestDiscovery?.Manifest is not { } manifest) { <p class="muted">@T("NoDiscovery")</p> } else { <DataGrid TItem="DataSourceDiscoveryChoice" Items="manifest.Choices"><Header><tr><th>@T("Choice")</th><th>@T("Parent")</th><th>@T("State")</th><th>@T("TargetName")</th></tr></Header><Row Context="choice"><tr data-testid="data-source-discovery-choice"><td><strong>@choice.DisplayName</strong><br/><code>@choice.Id</code></td><td>@(choice.ParentId ?? "—")</td><td>@(choice.Eligible ? T("Eligible") : T("Ineligible"))</td><td><ClearableText Value="@PromotionName(choice)" aria-label="@T("TargetName")" ValueChanged="changed => promotionNames[choice.Id] = (new ChangeEventArgs { Value = changed }).Value?.ToString() ?? string.Empty" /><button class="button-secondary" type="button" disabled="@(!CanApplyChoice(choice))" data-testid="@(MatchingTarget(choice) is { Stale: true } ? "data-source-reconcile-target" : null)" title="@ChoiceActionHelp(choice)" @onclick="() => ApplyChoiceAsync(choice)">@T(ChoiceActionLabel(choice))</button></td></tr></Row></DataGrid> }
        @if (targets.Count > 0)
        {
            <h3>@T("AcquisitionTargets")</h3>
            @if (targets.Any(item => item.Stale)) { <p class="muted">@T("ReconcileHelp")</p> }
            <DataGrid TItem="DataSourceAcquisitionTargetView" Items="targets"><Header><tr><th>@T("Name")</th><th>@T("Choice")</th><th>@T("State")</th></tr></Header>
                <Row Context="item"><tr data-testid="data-source-acquisition-target-row"><td>@item.Target.DisplayName<br/><code>@item.Target.Name</code></td><td>@item.Target.ChoiceDisplayName</td><td title="@(item.Stale && !CanReconcile(item) ? T("ReconcileUnavailable") : null)"><StatusBadge Text="@(item.Stale ? T("Stale") : T("Current"))" Status="@(item.Stale ? UiStatus.Warning : UiStatus.Success)" /></td></tr></Row>
            </DataGrid>
        }
        }
        </div>
        </section>
    }
    else if (tab == Tab.Access && CanManage)
    {
        <ResourceAccessPanel OwnerScopeRef="selectedScope!.Value" Namespace="source!.Namespace" Kind="@DataSourceResourceKinds.DataSource" Name="@source.Name" Generation="source.Generation" Governance="source.Governance" />
    }
    else if (tab == Tab.Yaml)
    {
        <FormSection Title="@T("DataSourceYaml")" Eyebrow="@T("RawResource")" Description="@T("DataSourceYamlHelp")" TestId="data-source-yaml-editor"><ChildContent>
            <FormField Label="@T("ResourceManifest")" Class="data-source-yaml-field"><ChildContent><ClearableText Multiline="true" class="form-code-editor runner-json" rows="28" aria-label="@T("ResourceManifest")" @bind-Value="rawYaml" ReadOnly="@(!CanManage)"></ClearableText></ChildContent></FormField>
            @if (CanManage) { <FormActions><button class="button-primary" type="button" disabled="@busy" @onclick="SaveYamlAsync">@(busy ? T("Saving") : T("SaveYaml"))</button></FormActions> }
        </ChildContent></FormSection>
    }
}
<ConfirmationDialog IsOpen="@confirmDelete" Title="@T("Delete")" Message="@T("DeleteConfirm")" ConfirmLabel="@T("Delete")" OnConfirm="DeleteAsync" OnCancel="() => confirmDelete = false" />

@code {
    [Parameter] public string? Name { get; set; }
    [SupplyParameterFromQuery(Name = "namespace")] public string? Namespace { get; set; }
    [SupplyParameterFromQuery(Name = "scopeRef")] public string? ScopeRef { get; set; }
    [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }
    private readonly CancellationTokenSource cancellation = new();
    private IReadOnlyList<DataSourceProfileResource> profiles = [];
    private IReadOnlyList<DataSourceAcquisitionResource> acquisitions = [];
    private IReadOnlyList<DataSourceDiscoveryResource> discoveries = [];
    private IReadOnlyList<DataSourceAcquisitionTargetView> targets = [];
    private IReadOnlyDictionary<string, JsonElement> profileSchemas = new Dictionary<string, JsonElement>();
    private readonly Dictionary<string, string> promotionNames = new(StringComparer.Ordinal);
    private DataSourceResource? source;
    private DataSourceReadiness? readiness;
    private ResourceScopeRef? selectedScope;
    private string? etag, error, operationsError;
    private Task polling = Task.CompletedTask;
    private long operationVersion;
    private bool refreshing, disposed;
    private string technicalName = string.Empty, displayName = string.Empty, sourceNamespace = "default", description = string.Empty, profileKey = string.Empty, rawYaml = string.Empty, selectedTarget = string.Empty;
    private JsonElement configuration = EmptyObject(), parameters = EmptyObject();
    private bool enabled = true, loading = true, busy, confirmDelete, configurationValid = true, parametersValid = true;
    private Tab tab = Tab.Definition;
    private bool discoveryHistorySelected;
    private Guid? previewAcquisition;
    private DataSourceAcquisitionResource? toolAcquisition;
    private IReadOnlyList<ToolDefinitionResource> acquisitionTools = [];
    private string AcquisitionToolUrl(ToolDefinitionResource tool) =>
        $"/tools/{Uri.EscapeDataString(AgentstrationToolProvider.ToolResourceName(tool.Name))}?namespace={Uri.EscapeDataString(tool.Namespace.Value)}&scopeRef={Uri.EscapeDataString(tool.ScopeRef!.Value.Value)}&context={Uri.EscapeDataString(CurrentConsoleScope.Value)}&view=execution";
    private ConsoleContextSnapshot? ConsoleContext => Services.GetService<ConsoleContextState>()?.Current;
    private bool CanCreateAcquisitionTool(DataSourceAcquisitionResource item) =>
        item.State == DataSourceAcquisitionState.Succeeded
        && item.Manifest?.Artifacts.Any(artifact => artifact.Disposition == DataSourceArtifactDisposition.Publishable) == true
        && ConsoleContext is { } context
        && context.WorkspaceId == item.WorkspaceId
        && context.Permissions.Contains(AuthorizationPermissions.ResourcesWrite);
    private bool IsNew => string.IsNullOrWhiteSpace(Name);
    private bool CanManage => IsNew || selectedScope is not null && ResourceOwnershipContext.CanManage(selectedScope.Value, Services);
    private DataSourceAcquisitionResource? LatestAcquisition => acquisitions.OrderByDescending(value => value.CreatedAt).FirstOrDefault();
    private DataSourceDiscoveryResource? LatestDiscovery => discoveries.OrderByDescending(value => value.CreatedAt).FirstOrDefault();
    private string? ProfileUrl => readiness?.Profile is not { } profile ? null
        : $"/data-source-profiles/{Uri.EscapeDataString(profile.Name)}?namespace={Uri.EscapeDataString(profile.Namespace.Value)}&scopeRef={Uri.EscapeDataString(profile.ScopeRef.Value)}";
    private string AcquisitionsUrl => $"{Url(source!)}&view=acquisitions";
    private ResolvedDataSourceFlowBinding? AcquisitionFlow => readiness?.Acquisition;
    private ResourceNamespace AcquisitionFlowNamespace => AcquisitionFlow?.Namespace ?? source!.Namespace;
    private string AcquisitionFlowIdentity => $"{AcquisitionFlowNamespace} · {AcquisitionFlow?.Version ?? "—"}";
    private string? AcquisitionFlowUrl => AcquisitionFlow is null ? null : AcquisitionFlowNamespace.IsDefault
        ? $"/flows/{Uri.EscapeDataString(AcquisitionFlow.Name)}"
        : $"/namespaces/{Uri.EscapeDataString(AcquisitionFlowNamespace.Value)}/flows/{Uri.EscapeDataString(AcquisitionFlow.Name)}";
    private JsonElement? ConfigurationSchema => readiness?.Profile is { } resolved && ProfileKey(resolved) == profileKey
        ? resolved.Definition.ConfigurationSchema
        : profileSchemas.TryGetValue(profileKey, out var schema) ? schema : null;
    private JsonElement? AcquisitionParametersSchema => JsonSchemaInputSchema.ObjectProperty(
        readiness?.Acquisition?.InputSchema, "parameters");
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private bool HasActiveDiscovery => discoveries.Any(item => IsActive(item.State));
    private bool HasActiveOperation => HasActiveDiscovery || acquisitions.Any(item => item.State is
        DataSourceAcquisitionState.Pending or DataSourceAcquisitionState.Running or DataSourceAcquisitionState.WaitingForInput or DataSourceAcquisitionState.WaitingForChild);
    private string? DiscoveryFlowUrl
    {
        get
        {
            if (readiness?.Discovery is not { } flow) return null;
            var path = flow.Namespace.IsDefault ? $"/flows/{Uri.EscapeDataString(flow.Name)}"
                : $"/namespaces/{Uri.EscapeDataString(flow.Namespace.Value)}/flows/{Uri.EscapeDataString(flow.Name)}";
            var scope = flow.ScopeRef ?? readiness.Profile?.ScopeRef ?? selectedScope;
            return $"{path}?scopeRef={Uri.EscapeDataString(scope!.Value.Value)}&context={Uri.EscapeDataString(CurrentConsoleScope.Value)}";
        }
    }
    private ResourceScopeRef CurrentConsoleScope => ResourceOwnershipContext.TryGetCurrent(Services) ?? selectedScope!.Value;
    private string FlowRunUrl(string runId, ResourceScopeRef? executionScope, ResourceScopeRef? logicalScope) =>
        $"/flow-runs/{Uri.EscapeDataString(runId)}?scopeRef={Uri.EscapeDataString((executionScope ?? CurrentConsoleScope).Value)}&context={Uri.EscapeDataString((logicalScope ?? CurrentConsoleScope).Value)}";
    protected override void OnInitialized() => polling = PollOperationsAsync();
    private async Task PollOperationsAsync()
    {
        var token = cancellation.Token;
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2), Clock);
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                if (token.IsCancellationRequested) break;
                await InvokeAsync(async () =>
                {
                    if (disposed || loading || busy || !HasActiveOperation) return;
                    await RefreshOperationsAsync();
                    if (!disposed) StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
    }
    private async Task RefreshOperationsAsync()
    {
        if (refreshing || source is null || selectedScope is null || disposed) return;
        refreshing = true;
        var version = operationVersion;
        var resource = source;
        var ownerScope = selectedScope.Value;
        var hasDiscovery = readiness?.Discovery is not null;
        try
        {
            var refreshedAcquisitions = await Client.GetAcquisitionsAsync(resource.Namespace, resource.Name, ownerScope, cancellation.Token);
            IReadOnlyList<DataSourceDiscoveryResource> refreshedDiscoveries = [];
            IReadOnlyList<DataSourceAcquisitionTargetView> refreshedTargets = [];
            if (hasDiscovery)
            {
                refreshedDiscoveries = await Client.GetDiscoveriesAsync(resource.Namespace, resource.Name, ownerScope, cancellation.Token);
                // Synchronize discovery before evaluating target staleness.
                refreshedTargets = await Client.GetAcquisitionTargetsAsync(resource.Namespace, resource.Name, ownerScope, cancellation.Token);
            }
            if (disposed || version != operationVersion) return;
            acquisitions = refreshedAcquisitions.OrderByDescending(item => item.CreatedAt).ToArray();
            discoveries = refreshedDiscoveries.OrderByDescending(item => item.CreatedAt).ToArray();
            targets = refreshedTargets;
            operationsError = null;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception) when (exception is AgentstrationApiException or HttpRequestException or OperationCanceledException or JsonException)
        {
            if (!disposed && version == operationVersion) operationsError = T("OperationalRefreshFailed");
        }
        finally { refreshing = false; }
    }
    protected override Task OnParametersSetAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        operationVersion++;
        previewAcquisition = null;
        loading = true;
        error = null;
        operationsError = null;
        readiness = null;
        acquisitions = [];
        discoveries = [];
        targets = [];
        promotionNames.Clear();
        toolAcquisition = null;
        acquisitionTools = [];
        try
        {
            await LoadProfilesAsync();
            if (!IsNew)
            {
                selectedScope = ResourceScopeRef.Parse(ScopeRef!);
                var snapshot = await Client.GetAsync(ResourceNamespace.Parse(Namespace), Name!, selectedScope.Value, cancellation.Token);
                source = snapshot.Value;
                etag = snapshot.ETag;
                LoadForm();
                tab = View?.ToLowerInvariant() switch
                {
                    "definition" => Tab.Definition, "discovery" => Tab.Discovery,
                    "acquisitions" => Tab.Acquisitions, "access" => Tab.Access,
                    "yaml" => Tab.Yaml, _ => Tab.Overview
                };
                try
                {
                    readiness = await Client.GetReadinessAsync(source.Namespace, source.Name, selectedScope.Value, cancellation.Token);
                    acquisitions = (await Client.GetAcquisitionsAsync(source.Namespace, source.Name, selectedScope.Value, cancellation.Token))
                        .OrderByDescending(value => value.CreatedAt).ToArray();
                    if (acquisitions.Count > 0 && Services.GetService<IToolDefinitionsClient>() is { } definitions)
                        acquisitionTools = (await definitions.GetAsync(cancellation.Token))
                            .Where(value => value.Definition.Acquisition is not null).ToArray();
                    if (readiness.Discovery is not null)
                    {
                        discoveries = (await Client.GetDiscoveriesAsync(source.Namespace, source.Name, selectedScope.Value, cancellation.Token))
                            .OrderByDescending(value => value.CreatedAt).ToArray();
                        targets = await Client.GetAcquisitionTargetsAsync(source.Namespace, source.Name, selectedScope.Value, cancellation.Token);
                    }
                }
                catch (Exception exception) when (exception is not OperationCanceledException)
                {
                    error = T("OperationalLoadFailed");
                }
            }
        }
        catch (Exception exception) { error = exception.Message; }
        finally { loading = false; }
    }
    private async Task LoadProfilesAsync() { profiles = (await Profiles.GetAsync(cancellation.Token)).Where(value => value.ActiveVersion is not null && value.Definition.Enabled).ToArray(); var active = await Task.WhenAll(profiles.Select(async item => { var revisions = await Profiles.GetRevisionsAsync(item.Namespace, item.Name, item.ScopeRef!.Value, cancellation.Token); var revision = revisions.Single(value => string.Equals(value.Version, item.ActiveVersion, StringComparison.Ordinal)); return new KeyValuePair<string, JsonElement>(ProfileKey(item), revision.Definition.ConfigurationSchema.Clone()); })); profileSchemas = active.ToDictionary(item => item.Key, item => item.Value, StringComparer.Ordinal); }
    private void LoadForm() { technicalName = source!.Name; displayName = source.Definition.DisplayName; sourceNamespace = source.Namespace.Value; description = source.Definition.Description ?? string.Empty; enabled = source.Definition.Enabled; configuration = source.Definition.Configuration.Clone(); var profile = profiles.FirstOrDefault(value => value.Name == source.Definition.Profile.Name && (source.Definition.Profile.Namespace ?? source.Namespace) == value.Namespace && (source.Definition.Profile.ScopeRef is null || source.Definition.Profile.ScopeRef == value.ScopeRef)); profileKey = profile is not null ? ProfileKey(profile) : source.Definition.Profile.ScopeRef is { } profileScope ? $"{profileScope.Value}|{(source.Definition.Profile.Namespace ?? source.Namespace).Value}|{source.Definition.Profile.Name}" : string.Empty; rawYaml = ResourceManifestSerializer.ToYaml(new RawSource { ApiVersion = source.ApiVersion, Kind = source.Kind, Metadata = source.Metadata, ScopeRef = source.ScopeRef, Definition = source.Definition }); }
    private DataSourceProperties Definition() { var profile = ParseProfile(profileKey); return new() { DisplayName = displayName.Trim(), Description = string.IsNullOrWhiteSpace(description) ? null : description.Trim(), Enabled = enabled, Profile = new(profile.Name, profile.Scope, profile.Namespace), Configuration = configuration.Clone() }; }
    private async Task SaveAsync() { busy = true; error = null; try { if (IsNew) { if (selectedScope is null) throw new InvalidOperationException(T("Scope")); var saved = await Client.CreateAsync(new(technicalName.Trim(), Definition(), sourceNamespace.Trim(), selectedScope), cancellation.Token); Navigation.NavigateTo(Url(saved.Value)); } else { var saved = await Client.UpdateAsync(source!.Namespace, source.Name, selectedScope!.Value, new(Definition()), etag!, cancellation.Token); source = saved.Value; etag = saved.ETag; LoadForm(); readiness = await Client.GetReadinessAsync(source.Namespace, source.Name, selectedScope.Value, cancellation.Token); } } catch (Exception exception) { error = exception.Message; } finally { busy = false; } }
    private async Task StartAsync()
    {
        if (!parametersValid) return;
        operationVersion++;
        busy = true;
        error = null;
        operationsError = null;
        try
        {
            var started = await Client.StartAcquisitionAsync(source!.Namespace, source.Name, selectedScope!.Value,
                new() { Parameters = parameters.Clone(), DataSourceScopeRef = selectedScope,
                    TargetName = string.IsNullOrWhiteSpace(selectedTarget) ? null : selectedTarget }, cancellation.Token);
            acquisitions = acquisitions.Where(item => item.Uid != started.Value.Uid).Prepend(started.Value)
                .OrderByDescending(item => item.CreatedAt).ToArray();
            await RefreshOperationsAsync();
        }
        catch (Exception exception) { error = exception.Message; }
        finally { busy = false; }
    }
    private async Task StartDiscoveryAsync()
    {
        busy = true;
        error = null;
        operationsError = null;
        operationVersion++;
        try
        {
            var started = await Client.StartDiscoveryAsync(source!.Namespace, source.Name, selectedScope!.Value,
                new() { DataSourceScopeRef = selectedScope }, cancellation.Token);
            discoveries = discoveries.Where(item => item.Uid != started.Value.Uid).Prepend(started.Value)
                .OrderByDescending(item => item.CreatedAt).ToArray();
            await RefreshOperationsAsync();
        }
        catch (Exception exception) { error = exception.Message; }
        finally { busy = false; }
    }
    private bool PromotionNameInUse(DataSourceDiscoveryChoice choice) =>
        targets.Any(item => string.Equals(item.Target.Name, PromotionName(choice), StringComparison.OrdinalIgnoreCase));
    private bool ChoiceAlreadyPromoted(DataSourceDiscoveryChoice choice) =>
        targets.Any(item => item.Target.DiscoveryUid == LatestDiscovery?.Uid && item.Target.ChoiceId == choice.Id);
    private DataSourceAcquisitionTargetView? MatchingTarget(DataSourceDiscoveryChoice choice) =>
        targets.FirstOrDefault(item => item.Target.ChoiceId == choice.Id
            && string.Equals(item.Target.Name, PromotionName(choice), StringComparison.OrdinalIgnoreCase));
    private string ChoiceActionLabel(DataSourceDiscoveryChoice choice) =>
        MatchingTarget(choice) is { Stale: true } ? "ReconcileTarget"
        : ChoiceAlreadyPromoted(choice) ? "TargetPromoted"
        : PromotionNameInUse(choice) ? "TargetNameUsed" : "Promote";
    private string? ChoiceActionHelp(DataSourceDiscoveryChoice choice) =>
        MatchingTarget(choice) is { Stale: true } item ? T(CanReconcile(item) ? "ReconcileHelp" : "ReconcileUnavailable")
        : PromotionNameInUse(choice) && !ChoiceAlreadyPromoted(choice) ? T("TargetNameInUse") : null;
    private bool CanApplyChoice(DataSourceDiscoveryChoice choice) =>
        MatchingTarget(choice) is { Stale: true } item
            ? !busy && !HasActiveDiscovery && choice.Eligible && CanReconcile(item)
            : CanPromote(choice);
    private Task ApplyChoiceAsync(DataSourceDiscoveryChoice choice) =>
        MatchingTarget(choice) is { Stale: true } item ? ReconcileTargetAsync(item) : PromoteAsync(choice);
    private bool CanPromote(DataSourceDiscoveryChoice choice) =>
        !busy && !HasActiveDiscovery && choice.Eligible && LatestDiscovery?.State == DataSourceDiscoveryState.Succeeded
        && !string.IsNullOrWhiteSpace(PromotionName(choice)) && !PromotionNameInUse(choice)
        && !ChoiceAlreadyPromoted(choice);
    private bool CanReconcile(DataSourceAcquisitionTargetView item) =>
        item.Stale && !string.IsNullOrWhiteSpace(item.Target.ETag)
        && LatestDiscovery is { State: DataSourceDiscoveryState.Succeeded, Manifest: { } manifest } discovery
        && discovery.Uid != item.Target.DiscoveryUid
        && manifest.Choices.Any(choice => choice.Id == item.Target.ChoiceId && choice.Eligible);
    private async Task PromoteAsync(DataSourceDiscoveryChoice choice)
    {
        if (!CanPromote(choice)) return;
        operationVersion++;
        busy = true;
        error = null;
        try
        {
            await Client.PromoteTargetAsync(source!.Namespace, LatestDiscovery!.Name,
                new(PromotionName(choice), choice.Id, choice.DisplayName, choice.Description), cancellation.Token);
            targets = await Client.GetAcquisitionTargetsAsync(source.Namespace, source.Name, selectedScope!.Value, cancellation.Token);
        }
        catch (AgentstrationApiException exception) when (exception.IsConcurrencyConflict) { error = T("TargetNameInUse"); }
        catch (Exception exception) { error = exception.Message; }
        finally { busy = false; }
    }
    private async Task ReconcileTargetAsync(DataSourceAcquisitionTargetView item)
    {
        if (busy || HasActiveDiscovery || !CanReconcile(item)) return;
        operationVersion++;
        busy = true;
        error = null;
        try
        {
            await Client.ReconcileTargetAsync(item.Target.Namespace, item.Target.Name,
                new(LatestDiscovery!.Name, item.Target.ChoiceId), item.Target.ETag!, cancellation.Token);
            targets = await Client.GetAcquisitionTargetsAsync(source!.Namespace, source.Name, selectedScope!.Value, cancellation.Token);
        }
        catch (AgentstrationApiException exception) when (exception.IsConcurrencyConflict) { error = T("TargetConcurrencyConflict"); }
        catch (Exception exception) { error = exception.Message; }
        finally { busy = false; }
    }
    private string PromotionName(DataSourceDiscoveryChoice choice)
    {
        if (promotionNames.TryGetValue(choice.Id, out var value)) return value;
        var existing = targets.Where(item => item.Target.ChoiceId == choice.Id).Take(2).ToArray();
        value = existing.Length == 1 ? existing[0].Target.Name
            : string.Concat(choice.Id.ToLowerInvariant().Select(character => char.IsLetterOrDigit(character) || character is '.' or '-' or '_' ? character : '-')).Trim('-');
        if (value.Length > 128) value = value[..128];
        promotionNames[choice.Id] = value;
        return value;
    }
    private async Task SaveYamlAsync() { busy = true; error = null; try { var raw = ResourceManifestSerializer.FromYaml<RawSource>(rawYaml); if (raw.Metadata.Name != source!.Name || raw.Metadata.Namespace != source.Namespace || raw.ScopeRef != source.ScopeRef) throw new ArgumentException(T("IdentityImmutable")); var saved = await Client.UpdateAsync(source.Namespace, source.Name, selectedScope!.Value, new(raw.Definition), etag!, cancellation.Token); source = saved.Value; etag = saved.ETag; LoadForm(); readiness = await Client.GetReadinessAsync(source.Namespace, source.Name, selectedScope.Value, cancellation.Token); } catch (Exception exception) { error = exception.Message; } finally { busy = false; } }
    private async Task DeleteAsync() { confirmDelete = false; await Client.DeleteAsync(source!.Namespace, source.Name, selectedScope!.Value, etag!, cancellation.Token); Navigation.NavigateTo("/data-sources"); }
