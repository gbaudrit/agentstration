@implements IDisposable
@inject IKnowledgeSourcesClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<KnowledgeSourcesStrings> Localizer
<section class="panel form-section" data-testid="knowledge-retrieval-verification">
    <div class="panel-header"><div><h2>@T("NativeAccessTitle")</h2><p>@T("NativeAccessHelp")</p></div></div>
    <fieldset class="resource-definition-fields" disabled="@(!interactive || busy)" data-testid="knowledge-native-access-fields" data-interactive="@(interactive ? "true" : "false")">
    <div class="form-grid">
        <label><span>@T("Operation")</span><select @bind="operation" @bind:after="Reset" data-testid="knowledge-retrieval-operation"><option value="read">@T("Operation.Read")</option><option value="search_regex">@T("Operation.SearchRegex")</option><option value="get_status">@T("Operation.GetStatus")</option></select></label>
        <label><span>@T("SnapshotOptional")</span><select @bind="snapshotId" @bind:after="Reset" data-testid="knowledge-retrieval-snapshot"><option value="">@T("NativeAutomaticSnapshot")</option>@foreach (var view in Snapshots) { <option value="@view.Snapshot.Name">@view.Snapshot.Name</option> }</select></label>
        @if (operation == "search_regex")
        {
            <label><span>@T("NativePattern")</span><input @bind="pattern" @bind:event="oninput" @bind:after="Reset" maxlength="512" data-testid="knowledge-retrieval-text" /><small>@T("NativePatternHelp")</small></label>
            <label><span>@T("NativeMatchLimit")</span><input type="number" min="1" max="100" @bind="limit" /></label>
        }
        @if (operation == "read") { <label><span>@T("NativeChunkSize")</span><input type="number" min="1" max="32768" @bind="maxCharacters" data-testid="knowledge-read-size" /></label> }
    </div>
    <div class="form-actions"><button class="button-primary" type="button" disabled="@(!interactive || busy || operation == "search_regex" && string.IsNullOrEmpty(pattern))" data-testid="knowledge-retrieval-run" @onclick="RunAsync">@T(result?.State == "preparing" ? "NativeRetryPreparation" : "RunVerification")</button>
        @if (result?.NextCursor is not null) { <button class="button-secondary" type="button" disabled="@busy" data-testid="knowledge-read-next" @onclick="NextAsync">@T("NativeNextPage")</button> }
    </div>
    </fieldset>
    @if (error) { <p class="form-alert form-alert-danger" role="alert">@T("NativeError")</p> }
    @if (result is not null)
    {
        <section role="status" data-testid="knowledge-retrieval-result">
            <p>@T($"NativeState.{result.State}") @if (result.SnapshotId is not null) { <code>@result.SnapshotId</code> }</p>
            @if (result.State == "preparing") { <p>@T("NativePreparingHelp")</p> }
            @if (result.ErrorCode is not null) { <code>@result.ErrorCode</code> }
            @foreach (var chunk in result.Chunks)
            {
                <article><p><code>@chunk.DocumentId</code> · @T("NativeRange", chunk.Range.Start, chunk.Range.End)</p><pre>@chunk.Content</pre></article>
            }
            @foreach (var match in result.Matches)
            {
                <article><p><code>@match.DocumentId</code> · @T("NativeRange", match.MatchRange.Start, match.MatchRange.End)</p><pre>@match.Excerpt</pre><button class="button-secondary" type="button" disabled="@busy" data-testid="knowledge-read-match" @onclick="() => ReadMatchAsync(match)">@T("NativeReadMatch")</button></article>
            }
            @if (result.EndOfSelection) { <p>@T("NativeEnd")</p> }
            @if (result.CursorExpiresAt is { } expires && result.NextCursor is not null) { <small>@T("NativeCursorExpiry", expires.ToLocalTime().ToString("g"))</small> }
        </section>
    }
    @if (status is not null)
    {
        <section data-testid="knowledge-content-status" role="status">
            <p>@T($"NativeState.{status.State}") · @status.CheckedAt.ToLocalTime().ToString("g")</p>
            <dl><dt>@T("ActiveSnapshot")</dt><dd><code>@(status.ActiveSnapshotId ?? T("None"))</code></dd><dt>@T("NativeLatestPublished")</dt><dd><code>@(status.LatestPublishedSnapshotId ?? T("None"))</code></dd></dl>
            @if (status.ComparedSnapshotId is not null) { <p><code>@status.ComparedSnapshotId</code> · @T("NativeComparison", T(status.IsActive == true ? "Yes" : "No"), T(status.IsLatestPublished == true ? "Yes" : "No"))</p> }
            <p>@T("NativeEvidenceHelp")</p>
            @foreach (var input in status.Inputs) { <p><strong>@input.BindingName</strong> · @input.AcquiredAt?.ToLocalTime().ToString("g") · @T(input.Fresh ? "NativeFresh" : "NativeStale")</p> }
            @foreach (var document in status.Documents) { <p><code>@document.DocumentId</code> · @document.MediaType · @T("NativeDocumentBytes", document.Bytes)</p> }
            @if (status.ErrorCode is not null) { <code>@status.ErrorCode</code> }
        </section>
    }
</section>
@code {
    [Parameter, EditorRequired] public string SourceName { get; set; } = string.Empty;
    [Parameter] public ResourceNamespace SourceNamespace { get; set; } = ResourceNamespace.Default;
    [Parameter] public IReadOnlyList<KnowledgeSnapshotView> Snapshots { get; set; } = [];
    private readonly CancellationTokenSource cancellation = new();
    private string operation = "read", snapshotId = string.Empty, pattern = string.Empty;
    private int maxCharacters = 4000, limit = 20;
    private bool busy, error, interactive;
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { interactive = true; StateHasChanged(); }
        return Task.CompletedTask;
    }
    private KnowledgeAccessResult? result;
    private KnowledgeAccessStatus? status;
    private string? selectedDocument;
    private KnowledgeCharacterRange? selectedRange;
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private void Reset() { result = null; status = null; selectedDocument = null; selectedRange = null; error = false; }
    private string? SelectedSnapshot => string.IsNullOrWhiteSpace(snapshotId) ? null : snapshotId;
    private Task RunAsync() => ExecuteAsync(async () =>
    {
        if (operation == "get_status")
        {
            status = await Client.GetContentStatusAsync(SourceNamespace, SourceName, new(SelectedSnapshot), cancellation.Token);
            result = null;
        }
        else if (operation == "read")
            result = await Client.ReadContentAsync(SourceNamespace, SourceName, new() { SnapshotId = SelectedSnapshot,
                PreparationId = result?.PreparationId, DocumentId = selectedDocument, Range = selectedRange, MaxCharacters = maxCharacters }, cancellation.Token);
        else result = await Client.SearchRegexAsync(SourceNamespace, SourceName, new() { Pattern = pattern,
            SnapshotId = SelectedSnapshot, PreparationId = result?.PreparationId, Limit = limit }, cancellation.Token);
    });
    private Task NextAsync() => ExecuteAsync(async () => result = operation == "read"
        ? await Client.ReadContentAsync(SourceNamespace, SourceName, new() { Cursor = result!.NextCursor, MaxCharacters = maxCharacters }, cancellation.Token)
        : await Client.SearchRegexAsync(SourceNamespace, SourceName, new() { Cursor = result!.NextCursor, Limit = limit }, cancellation.Token));
    private Task ReadMatchAsync(KnowledgeRegexMatch match)
    {
        snapshotId = result!.SnapshotId!; selectedDocument = match.DocumentId; selectedRange = match.ReadRange; operation = "read";
        result = null;
        return RunAsync();
    }
    private async Task ExecuteAsync(Func<Task> action)
    {
        if (busy) return;
        busy = true; error = false;
        try { await action(); }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception) { error = true; }
        finally { busy = false; }
    }
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); GC.SuppressFinalize(this); }
}
