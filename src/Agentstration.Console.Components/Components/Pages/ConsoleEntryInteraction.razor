@page "/entry-interactions/{WorkspaceId:guid}/{EntryNamespace}/{EntryName}"
@implements IDisposable
@inject IEntryAdministrationApiClient Entries
@inject IConsoleEntryInteractionApiClient Interactions
@inject IWorkOperationsRealtimeClient Realtime
@inject ConsoleContextState ContextState
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<ConsoleEntryInteractionStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@inject Microsoft.Extensions.Localization.IStringLocalizer<ConsoleConversationsStrings> ConversationLabels

<PageTitle>@(entry?.DisplayName ?? T("EntryInteraction")) · Agentstration</PageTitle>
<UnsavedNavigationGuard IsDirty="HasDraft" HasUnsavedChanges="@(() => HasDraft)" />
<ResourceDetailsTemplate Name="@(entry?.DisplayName ?? T("EntryInteraction"))" TechnicalName="@entry?.Name" Namespace="@entry?.Namespace.Value"
    ResourceType="@T("ConsoleEntry")" IconName="entry" Domain="entry" Description="@(entry?.Description ?? T("Description"))" CollectionHref="/conversations" CollectionLabel="@ConversationLabels["Title"]"
    ResourceIdentity="@(loadedKey ?? EntryName)" Sections="Sections" DefaultSection="interaction" SelectionChanged="SelectSection"
    LoadState="loadState" OnRetry="RefreshAsync" OnRefresh="RefreshAsync" Busy="@(busy || loading)" SectionTestIdPrefix="console-entry" HasDraft="HasDraft">
    <Actions>
        @if (CanCancel) { <button class="button-danger" type="button" disabled="@(busy || loading)" @onclick="CancelAsync" data-testid="console-entry-cancel">@T("Cancel")</button> }
        @if (interaction is not null) { <button class="button-secondary" type="button" disabled="@(busy || loading)" @onclick="NewRequestAsync" data-testid="console-entry-new-request">@T("NewRequest")</button> }
    </Actions>
    <Feedback>
        @if (interaction is null && !string.IsNullOrWhiteSpace(error)) { <div class="form-alert form-alert-danger" role="alert" data-testid="console-entry-error">@error</div> }
        @if (entry is not null && !canInvoke) { <EmptyState Title="@T("DisabledTitle")" Message="@AvailabilityMessage" /> }
        @if (newerEntry is not null || newerInteraction is not null) { <div class="form-alert form-alert-warning" role="status">@T("NewerSnapshot")<button type="button" class="button-secondary" disabled="@(busy || loading)" @onclick="DiscardDrafts">@Shared["Discard"]</button></div> }
    </Feedback>
    <Content>
        @if (entry is not null)
        {
            <div hidden="@(section != "overview")">
                <section class="metric-grid"><MetricCard Label="@T("EntryRevision")" Value="@entry.Version.ToString(System.Globalization.CultureInfo.InvariantCulture)" />@if (interaction is not null) { <MetricCard Label="@T("LoadedMessages")" Value="@(messagesKnown ? messages.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) : "—")" /> }</section>
                <ResourceIdentitySummary DisplayName="@entry.DisplayName" TechnicalName="@entry.Name" Namespace="@entry.Namespace.Value" Description="@entry.Description"><AdditionalDetails><dt>@T("ExecutionScope")</dt><dd><ResourceScopeBadge ScopeRef="@ResourceScopeRef.Workspace(WorkspaceId)" DisplayName="@ExecutionWorkspaceName" /></dd><dt>@T("EntryRevision")</dt><dd>@entry.Version</dd></AdditionalDetails></ResourceIdentitySummary>
                <FormSection Title="@Shared["Configuration"]" Class="resource-configuration-summary"><CollectionView TItem="Setting" Items="SavedSettings" IdentityLabel="@Shared["Configuration"]" InformationLabels="@(new[] { Shared["Saved"].Value })"><Identity Context="row"><strong class="configuration-key">@row.Name</strong></Identity><Information Context="row"><CollectionValue Label="@Shared["Saved"]"><span class="configuration-value">@row.Value</span></CollectionValue></Information></CollectionView></FormSection>
            </div>
            <div hidden="@(section != "interaction")" class="console-entry-interaction" data-testid="console-entry-interaction" data-entry-name="@EntryName" data-entry-namespace="@EntryNamespace">
                @if (interaction is null)
                {
                    var identity = loadedKey;
                    <Agentstration.Workplace.Components.PrimaryEntryContainer Busy="@(busy || loading)">
                        <Agentstration.Workplace.Components.EntryRenderer @key="initialEditorVersion" Definition="@ToDefinition(entry)" Role="DashboardItemRole.Primary" InitialValues="initialValues" OnSubmit="SubmitAsync" Disabled="@(!CanSubmit)" Busy="@(busy || loading)" DraftChanged="value => RequestDraftChanged(identity, value)" />
                    </Agentstration.Workplace.Components.PrimaryEntryContainer>
                }
                else
                {
                    var identity = loadedKey;
                    @if (activeTask?.Error is { } taskError) { <section class="console-entry-terminal-error" role="alert"><strong>@taskError.Code</strong><span>@taskError.Message</span></section> }
                    <Agentstration.Workplace.Components.InteractionView @key="conversationEditorVersion" @ref="interactionView" Messages="messages" Action="currentAction" PendingAction="pendingAction" ActionTimestamp="interaction.LastActivityAt"
                        Presentation="entry.Presentation" Status="interaction.Status" Task="activeTask" Activities="activities" Results="results" Artifacts="artifacts" Busy="@(busy || loading)" Error="@error" PendingSubmitDisabled="@(!CanSubmit)" SubmitDisabledReason="@(!canInvoke ? AvailabilityMessage : newerEntry is not null || newerInteraction is not null ? T("NewerSnapshot") : null)"
                        OnPendingAction="RespondAsync" TrySendMessage="ContinueAsync" OnNewRequest="NewRequestAsync" DraftChanged="value => ConversationDraftChanged(identity, value)" ResponseAcknowledgement="responseAcknowledgement"
                        ArtifactContentUrl="ArtifactUrl" TaskDetailsUrl="TaskUrl" />
                }
            </div>
        }
    </Content>
    <DraftActions><button type="button" class="button-secondary" disabled="@(busy || loading)" @onclick="DiscardDrafts">@Shared["Discard"]</button></DraftActions>
</ResourceDetailsTemplate>
