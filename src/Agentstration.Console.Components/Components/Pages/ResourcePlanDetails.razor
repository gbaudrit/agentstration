@page "/resource-plans/{Id:guid}"
@rendermode InteractiveServer
@implements IDisposable
@inject IResourcePlansApiClient Client
@inject IIdentityAdministrationApiClient IdentityClient
@inject IModelProfilesClient ModelProfilesClient
@inject IRuntimeProfilesClient RuntimeProfilesClient
@inject IToolsClient ToolsClient
@inject ConsoleContextState ContextState
@inject Microsoft.Extensions.Localization.IStringLocalizer<ResourcePlansStrings> Localizer

<PageTitle>@(plan?.Value.Title ?? T("Title")) · Agentstration</PageTitle>
<PageHeader Title="@(plan?.Value.Title ?? T("Title"))" Description="@(plan?.Value.Goal ?? T("DetailDescription"))">
    <Actions><a class="button-secondary" href="/resource-plans">@T("BackToPlans")</a><button class="button-secondary" type="button" @onclick="LoadAsync" disabled="@busy">@T("Refresh")</button></Actions>
</PageHeader>

@if (!string.IsNullOrWhiteSpace(error)) { <div class="form-alert form-alert-danger" role="alert">@error</div> }
@if (busy && plan is null) { <LoadingState Message="@T("Loading")" /> }
else if (plan is null) { <EmptyState Title="@T("NotFound")" Message="@T("NotFoundDescription")" /> }
else
{
    <ol class="resource-plan-review-path" aria-label="@T("ReviewPath")">
        <li class="@(BindingsComplete && !bindingSaveFailed ? "is-done" : null)"><span>1</span><div><strong>@T("StepProfiles")</strong><small>@T("StepProfilesHint")</small></div></li>
        <li class="@(materialization is not null || showRecordedChanges && selected is not null ? "is-done" : null)"><span>2</span><div><strong>@T("StepPreview")</strong><small>@T("StepPreviewHint")</small></div></li>
        <li class="@(showRecordedChanges && selected is not null ? "is-done" : null)"><span>3</span><div><strong>@T("StepChangeSet")</strong><small>@T("StepChangeSetHint")</small></div></li>
        <li class="@(showRecordedChanges && latestValidation is not null ? "is-done" : null)"><span>4</span><div><strong>@T("StepValidation")</strong><small>@T("StepValidationHint")</small></div></li>
        <li class="@(application?.Value.Status == ResourceChangeSetApplicationStatus.Applied ? "is-done" : null)"><span>5</span><div><strong>@T("StepApplication")</strong><small>@T("StepApplicationHint")</small></div></li>
    </ol>
    <nav class="resource-plan-tabs" role="tablist" aria-label="@T("ReviewViews")">
        @foreach (var view in Views)
        {
            <button type="button" role="tab" id="tab-@view" aria-controls="panel-@view" aria-selected="@(activeView == view)" class="@(activeView == view ? "active" : null)" @onclick="() => activeView = view">@T($"View.{view}")</button>
        }
    </nav>

    <section class="panel resource-plan-view @(activeView == "Overview" ? "resource-plan-overview" : null)" role="tabpanel" id="panel-@activeView" aria-labelledby="tab-@activeView">
        @if (activeView != "Overview" && showRecordedChanges && selected is not null && ResourcePlanReviewProjection.IsStale(plan.Value, selected.Value))
        {
            <div class="resource-plan-stale-notice"><StatusBadge Text="@T("StaleChangeSet")" Status="UiStatus.Warning" /></div>
        }
        @if (activeView == "Overview")
        {
            <header class="resource-plan-intent">
                <h2>@T("FunctionalIntent")</h2>
                <p class="resource-plan-goal">@plan.Value.Goal</p>
                @if (!string.IsNullOrWhiteSpace(plan.Value.Description)) { <p class="resource-plan-description">@plan.Value.Description</p> }
                <div class="resource-plan-overview-meta" aria-label="@T("PlanIdentity")">
                    <StatusBadge Text="@T($"Status.{plan.Value.Status}")" Status="@Tone(plan.Value.Status)" />
                    <span>@T("Revision", plan.Value.Revision)</span>
                    <span>@T("Workspace") <code>@plan.Value.Scope.WorkspaceId.Value.ToString("D")</code></span>
                    <span>@T("Updated") <time datetime="@plan.Value.UpdatedAt.ToString("O")">@plan.Value.UpdatedAt.ToLocalTime().ToString("g")</time></span>
                    @if (selected is not null && ResourcePlanReviewProjection.IsStale(plan.Value, selected.Value))
                    {
                        <StatusBadge Text="@T("StaleChangeSet")" Status="UiStatus.Warning" />
                    }
                </div>
            </header>
            @if (functional is not null)
            {
                <div class="resource-plan-overview-main">
                    <article class="resource-plan-solution">
                        <h3>@T("Solution")</h3>
                        <p>@functional.Solution.Summary</p>
                        @if (functional.Solution.Outcomes.Count > 0)
                        {
                            <ul class="resource-plan-outcomes">@foreach (var outcome in functional.Solution.Outcomes) { <li>@outcome</li> }</ul>
                        }
                    </article>
                    <div class="resource-plan-overview-details">
                        <article class="resource-plan-detail-card">
                            <h3>@T("Roles") <span class="resource-plan-count">@functional.Roles.Count</span></h3>
                            @if (functional.Roles.Count == 0) { <p class="resource-plan-empty">@T("NothingPlanned")</p> }
                            else { <ol>@foreach (var role in functional.Roles) { <li><strong>@role.DisplayName</strong><span>@role.Purpose</span></li> }</ol> }
                        </article>
                        <article class="resource-plan-detail-card">
                            <h3>@T("Workflows") <span class="resource-plan-count">@functional.Workflows.Count</span></h3>
                            @if (functional.Workflows.Count == 0) { <p class="resource-plan-empty">@T("NothingPlanned")</p> }
                            else { <ol>@foreach (var workflow in functional.Workflows) { <li><strong>@workflow.DisplayName</strong><span>@workflow.Objective</span></li> }</ol> }
                        </article>
                    </div>
                </div>
                <div class="resource-plan-overview-secondary">
                    <article class="resource-plan-secondary-card">
                        <h3>@T("Integrations") <span class="resource-plan-count">@functional.Integrations.Count</span></h3>
                        @if (functional.Integrations.Count == 0) { <p class="resource-plan-empty">@T("NothingPlanned")</p> }
                        else { <ul>@foreach (var integration in functional.Integrations) { <li><strong>@integration.DisplayName</strong><span>@integration.Purpose</span></li> }</ul> }
                    </article>
                    <article class="resource-plan-secondary-card">
                        <h3>@T("Experiences") <span class="resource-plan-count">@functional.Experiences.Count</span></h3>
                        @if (functional.Experiences.Count == 0) { <p class="resource-plan-empty">@T("NothingPlanned")</p> }
                        else { <ul>@foreach (var experience in functional.Experiences) { <li><strong>@experience.DisplayName</strong><span>@experience.Purpose</span></li> }</ul> }
                    </article>
                    @if (functional.Retirements is { Count: > 0 } retirements)
                    {
                        <article class="resource-plan-secondary-card">
                            <h3>@T("Retirements") <span class="resource-plan-count">@retirements.Count</span></h3>
                            <ul>@foreach (var retirement in retirements) { <li><strong>@T($"Retirement.{retirement.Element}") · @retirement.LogicalId</strong><span>@retirement.Reason</span></li> }</ul>
                        </article>
                    }
                </div>
                    @if (functional.Roles.Count > 0 || functional.Integrations.Count > 0 || functional.Retirements?.Count > 0)
                    {
                        <section class="resource-plan-bindings" aria-label="@T("BindingsTitle")">
                        <div class="resource-plan-section-heading"><div><p class="eyebrow">@T("ConcreteProposal")</p><h2>@T("BindingsTitle")</h2><p>@T("BindingsIntro")</p></div></div>
                        @if (functional.Roles.Count > 0 && (modelProfiles.Count == 0 || runtimeProfiles.Count == 0))
                        {
                            <p class="resource-plan-binding-empty">
                                @if (modelProfiles.Count == 0) { <a href="/modelprofiles">@T("CreateModelProfile")</a> }
                                @if (runtimeProfiles.Count == 0) { <a href="/runtimeprofiles">@T("CreateRuntimeProfile")</a> }
                            </p>
                        }
                        <div class="resource-plan-binding-list">
                            @foreach (var role in functional.Roles)
                            {
                                <article class="resource-plan-binding-card">
                                    <div><strong>@role.DisplayName</strong><small>@role.LogicalId</small></div>
                                    <label><span>@T("ModelProfile")</span><select aria-label="@($"{role.DisplayName} · {T("ModelProfile")}")" value="@SelectedModelIndex(role.LogicalId)" @onchange="args => SelectModelAsync(role.LogicalId, args)" disabled="@(busy || !CanReview)">
                                        <option value="">@T("SelectProfile")</option>
                                        @for (var index = 0; index < modelProfiles.Count; index++)
                                        {
                                            var profile = modelProfiles[index];
                                            <option value="@index" disabled="@IsInvalidModel(profile)">@profile.Properties.DisplayName · @profile.Namespace/@profile.Name</option>
                                        }
                                    </select></label>
                                    <label><span>@T("RuntimeProfile")</span><select aria-label="@($"{role.DisplayName} · {T("RuntimeProfile")}")" value="@SelectedRuntimeIndex(role.LogicalId)" @onchange="args => SelectRuntimeAsync(role.LogicalId, args)" disabled="@(busy || !CanReview)">
                                        <option value="">@T("SelectProfile")</option>
                                        @for (var index = 0; index < runtimeProfiles.Count; index++)
                                        {
                                            var profile = runtimeProfiles[index];
                                            <option value="@index">@profile.Properties.DisplayName · @profile.Namespace/@profile.Name</option>
                                        }
                                    </select></label>
                                </article>
                            }
                        </div>
                        @if (functional.Integrations.Count > 0)
                        {
                            <h3>@T("ToolBindingsTitle")</h3>
                            <p>@T("ToolBindingsIntro")</p>
                            @if (tools.Count == 0) { <p class="resource-plan-binding-empty"><a href="/tools">@T("ManageTools")</a></p> }
                            <div class="resource-plan-binding-list">
                                @foreach (var integration in functional.Integrations)
                                {
                                    <article class="resource-plan-binding-card">
                                        <div><strong>@integration.DisplayName</strong><small>@integration.Purpose</small></div>
                                        <label><span>@T("ToolBinding")</span><select aria-label="@($"{integration.DisplayName} · {T("ToolBinding")}")" value="@SelectedToolIndex(integration.LogicalId)" @onchange="args => SelectToolAsync(integration.LogicalId, args)" disabled="@(busy || !CanReview)">
                                            <option value="">@T("SelectTool")</option>
                                            @for (var index = 0; index < tools.Count; index++)
                                            {
                                                var tool = tools[index];
                                                <option value="@index" disabled="@(!UsableTool(tool))">@tool.Definition.DisplayName · @tool.Metadata.Namespace/@tool.Metadata.Name</option>
                                            }
                                        </select></label>
                                    </article>
                                }
                            </div>
                        }
                        <footer class="resource-plan-binding-footer">
                            <div class="resource-plan-binding-progress" role="status"><strong>@(functional.Roles.Count + functional.Integrations.Count == 0 ? T("NoBindingsRequired") : T("BindingsProgress", CompleteBindings + CompleteToolBindings, functional.Roles.Count + functional.Integrations.Count))</strong><span>@T(bindingSaving ? "BindingsSaving" : bindingSaveFailed ? bindingsConflict ? "BindingsConflict" : "BindingsSaveFailed" : bindingsOutdated ? "BindingsOutdated" : bindingDraft is null ? "BindingsNotSavedYet" : "BindingsSavedAutomatically")</span>@if (bindingSaveFailed) { <button class="button-secondary" type="button" @onclick="RetryBindingsAsync" disabled="@busy">@T(bindingsConflict ? "ReloadBindings" : "RetrySaveBindings")</button> }</div>
                            <div class="resource-plan-binding-actions">
                                <button class="button-secondary" type="button" @onclick="MaterializeAsync" disabled="@(!CanReview || busy || bindingSaveFailed || !CanMaterialize || !BindingsComplete)">@T("Rematerialize")</button>
                                <button class="button-primary" type="button" @onclick="ShowChanges" disabled="@(busy || bindingSaveFailed || !CanMaterialize || !BindingsComplete)">@T("ReviewChangesAction")</button>
                            </div>
                        </footer>
                        </section>
                }
            }
            <p class="resource-plan-boundary"><span aria-hidden="true">ⓘ</span>@T("FunctionalBoundary")</p>
        }
        else if (activeView == "Changes")
        {
            <div class="resource-plan-section-heading"><div><p class="eyebrow">@T("ConcreteProposal")</p><h2>@T("Changes")</h2><p>@T("ChangesIntro")</p></div></div>
            @if (changeSets.Count > 0 || materialization is not null || bindingsDirty)
            {
                <div class="resource-plan-change-set-picker"><label for="change-set-select">@T("ChangeSet")</label><select id="change-set-select" value="@ReviewSelectionValue" @onchange="SelectChangeSetAsync">
                    @if (materialization is not null) { <option value="preview">@T("CurrentPreview")</option> }
                    @if (bindingsDirty && materialization is null) { <option value="pending">@T("PendingPreview")</option> }
                    @foreach (var item in changeSets) { <option value="@item.Value.Id.Value.ToString("D")">@T("SavedChangeSetOption", item.Value.PlanRevision, item.Value.CreatedAt.ToLocalTime().ToString("g"))</option> }
                </select></div>
            }
            @if (DisplayedChanges is { } displayedChanges)
            {
                @if (!showRecordedChanges && materialization is not null)
                {
                    <div class="resource-plan-review-notice" role="status">
                        <div><strong>@T("CurrentPreview")</strong><span>@T("Proposals", materialization.Proposals.Count)</span><p>@T(materialization.CanCreateChangeSet ? "CurrentPreviewDescription" : "CurrentPreviewBlockedDescription")</p><details><summary>@T("TechnicalDetails")</summary><code>@materialization.Digest</code></details></div>
                        <button class="button-primary" type="button" @onclick="CreateChangeSetAsync" disabled="@(!CanReview || busy || bindingSaveFailed || !materialization.CanCreateChangeSet)">@T("CreateChangeSet")</button>
                    </div>
                    @foreach (var diagnostic in materialization.Diagnostics)
                    {
                        <p class="resource-plan-issue"><strong>@DiagnosticLabel(diagnostic)</strong> · @diagnostic.Path</p>
                    }
                }
                else if (selected is not null)
                {
                    <div class="resource-plan-review-notice resource-plan-recorded-notice"><div><strong>@T("RecordedChangeSet")</strong><span>@T("ChangeSetRevision", selected.Value.PlanRevision)</span><span>@T("CreatedAt", selected.Value.CreatedAt.ToLocalTime().ToString("g"))</span><details><summary>@T("TechnicalDetails")</summary><code>@selected.Value.Digest</code></details></div>@if (application is null) { <button class="button-primary" type="button" @onclick="ValidateAsync" disabled="@(!CanReview || busy || ResourcePlanReviewProjection.IsStale(plan.Value, selected.Value))">@T("Revalidate")</button> }</div>
                }
                    <div class="resource-plan-change-summary" aria-label="@T("ChangeSummary")">
                        @foreach (var operation in Enum.GetValues<ResourceChangeOperation>())
                        {
                            var count = displayedChanges.Count(value => value.Operation == operation);
                            <div><strong>@count</strong><span>@OperationCountLabel(operation, count)</span></div>
                        }
                    </div>
                    @if (DisplayedBindings is { Count: > 0 } reviewedBindings)
                    {
                        <div class="resource-plan-reviewed-bindings">
                            <h3>@T("ReviewedBindings")</h3>
                            @foreach (var binding in reviewedBindings.OrderBy(value => value.LogicalId, StringComparer.Ordinal).ThenBy(value => value.Field, StringComparer.Ordinal))
                            {
                                <p><strong>@binding.LogicalId</strong><span>@T(binding.Field switch { "modelProfile" => "ModelProfile", "runtimeProfile" => "RuntimeProfile", "tool" => "ToolBinding", _ => "BindingsTitle" })</span><code>@(binding.Reference.Namespace ?? ResourceNamespace.Default)/@binding.Reference.Name</code></p>
                            }
                        </div>
                    }
                    @foreach (var change in displayedChanges.OrderBy(value => value.Order))
                    {
                        var reviewFields = ResourcePlanReviewProjection.ReviewFields(change);
                        <article class="resource-plan-change">
                            <header><div class="resource-plan-change-identity"><span class="resource-plan-change-number">@(change.Order + 1)</span><div><p class="resource-plan-change-kind">@ResourceKindLabel(change.Proposed.Kind)</p><h3>@ResourcePlanReviewProjection.DisplayName(change)</h3><small>@change.Proposed.Metadata.Namespace/@change.Proposed.Metadata.Name</small></div></div><StatusBadge Text="@T($"Operation.{change.Operation}")" Status="@OperationTone(change.Operation)" /></header>
                            @if (ResourcePlanReviewProjection.Description(change) is { Length: > 0 } description) { <p class="resource-plan-change-description">@description</p> }
                            @if (change.DependsOn.Count > 0) { <p class="resource-plan-change-dependencies"><strong>@T("DependsOn")</strong> @string.Join(", ", change.DependsOn)</p> }
                            @if (change.Operation == ResourceChangeOperation.NoOp) { <p class="resource-plan-change-empty">@T("NoDifferences")</p> }
                            else
                            {
                                <div class="resource-plan-change-highlights">
                                    @foreach (var difference in ResourcePlanReviewProjection.HighlightFields(change))
                                    {
                                        <div><span>@FieldLabel(difference.Path)</span><strong>@DisplayValue(difference.Path, difference.Proposed)</strong></div>
                                    }
                                </div>
                                <details class="resource-plan-change-diff"><summary>@(reviewFields.Count == 1 ? T("ShowField") : T("ShowFields", reviewFields.Count))</summary>
                                    <div class="resource-plan-table-scroll"><table><thead><tr><th>@T("Field")</th><th>@T("Current")</th><th>@T("Proposed")</th></tr></thead><tbody>
                                    @foreach (var difference in reviewFields)
                                    {
                                        <tr><th scope="row"><strong>@FieldLabel(difference.Path)</strong><code>@difference.Path</code></th><td><span class="resource-plan-diff-value">@DisplayValue(difference.Path, difference.Current)</span></td><td><span class="resource-plan-diff-value">@DisplayValue(difference.Path, difference.Proposed)</span></td></tr>
                                    }
                                    </tbody></table></div>
                                </details>
                            }
                        </article>
                    }
                }
            else if (bindingsDirty) { <div class="resource-plan-review-notice" role="status">@T("PendingPreviewDescription")</div> }
            else { <p>@T("NoChangeSets")</p> }
        }
        else if (activeView == "Graph")
        {
            <h2>@T("Graph")</h2>
            @if (DisplayedChanges is not { } graphChanges) { <p>@T(bindingsDirty ? "PendingPreviewDescription" : "NoChangeSets")</p> }
            else
            {
                var graph = ResourcePlanReviewProjection.Graph(graphChanges);
                <div class="resource-plan-graph-layout @(SelectedGraphChange is not null ? "has-selection" : null)">
                    <div class="resource-plan-graph-canvas">
                        <FlowTopologyViewer Graph="@GraphTopology(graph)" SelectedKey="selectedGraphKey" SelectedKeyChanged="SelectGraphNode" InitiallyFit="true" ShowStateLegend="false" />
                        <p class="resource-plan-graph-hint">@T("GraphHint")</p>
                    </div>
                    @if (SelectedGraphChange is { } change)
                    {
                        <aside class="resource-plan-graph-details" aria-live="polite">
                            <header><h3>@change.LogicalId</h3><button type="button" @onclick="() => selectedGraphKey = null" aria-label="@T("CloseNodeDetails")">×</button></header>
                            <dl>
                                <dt>@T("ResourceKind")</dt><dd>@change.Proposed.Kind</dd>
                                <dt>@T("Operation")</dt><dd><StatusBadge Text="@T($"Operation.{change.Operation}")" Status="@OperationTone(change.Operation)" /></dd>
                                <dt>@T("ResourceName")</dt><dd><code>@change.Proposed.Metadata.Name</code></dd>
                                <dt>@T("DependsOn")</dt><dd>@(change.DependsOn.Count == 0 ? T("NoDependencies") : string.Join(", ", change.DependsOn))</dd>
                            </dl>
                        </aside>
                    }
                </div>
                <ol class="sr-only">@foreach (var graphChange in graphChanges.OrderBy(value => value.Order)) { <li>@graphChange.LogicalId · @graphChange.Proposed.Kind @if (graphChange.DependsOn.Count > 0) { <span>@T("DependsOn") @string.Join(", ", graphChange.DependsOn)</span> }</li> }</ol>
            }
        }
        else if (activeView == "Validation")
        {
            <div class="resource-plan-section-heading"><div><p class="eyebrow">@T("ReviewResult")</p><h2>@T("Validation")</h2><p>@T("ValidationIntro")</p></div>@if (showRecordedChanges && selected is not null && application is null) { <button class="button-secondary" type="button" @onclick="ValidateAsync" disabled="@(!CanReview || busy || ResourcePlanReviewProjection.IsStale(plan.Value, selected.Value))">@T("Revalidate")</button> }</div>
            @if (!showRecordedChanges) { <p>@T("PreviewRequiresChangeSet")</p> }
            else if (selected is null) { <p>@T("NoChangeSets")</p> }
            else if (latestValidation is null) { <p>@T("NotValidated")</p> }
            else
            {
                <div class="resource-plan-validation-summary @(latestValidation.Readiness == ResourceChangeSetReadiness.Ready ? "is-ready" : "is-blocked")" role="status">
                    <span class="resource-plan-validation-symbol" aria-hidden="true">@(latestValidation.Readiness == ResourceChangeSetReadiness.Ready ? "✓" : "!")</span>
                    <div><p class="resource-plan-validation-kicker">@T("ValidationState")</p><h3>@(latestValidation.Readiness == ResourceChangeSetReadiness.Ready ? T("ValidationReadyTitle") : latestValidation.Issues.Count == 1 ? T("ValidationIssueSingular") : T("ValidationIssuePlural", latestValidation.Issues.Count))</h3><p>@(latestValidation.Readiness == ResourceChangeSetReadiness.Ready ? T("ValidationReadyDescription") : T("ValidationBlockedDescription"))</p>
                        <div class="resource-plan-validation-meta"><StatusBadge Text="@T($"Readiness.{latestValidation.Readiness}")" Status="@(latestValidation.Readiness == ResourceChangeSetReadiness.Ready ? UiStatus.Success : UiStatus.Danger)" /><span>@T("ValidatedAt") <time datetime="@latestValidation.ValidatedAt.ToString("O")">@latestValidation.ValidatedAt.ToLocalTime().ToString("g")</time></span>@if (ResourcePlanReviewProjection.IsStale(plan.Value, selected.Value, latestValidation)) { <StatusBadge Text="@T("StaleValidation")" Status="UiStatus.Warning" /> }</div>
                    </div>
                </div>
                @if (latestValidation.Issues.Count == 0) { <p class="resource-plan-validation-empty">@T("NoIssues")</p> }
                else
                {
                    <ol class="resource-plan-issues">
                    @foreach (var issue in latestValidation.Issues)
                    {
                        var affected = ResourcePlanReviewProjection.ChangeForIssue(selected.Value, issue);
                        <li class="@(issue.Severity == ResourceChangeSetValidationSeverity.Warning ? "is-warning" : "is-error")"><span class="resource-plan-issue-symbol" aria-hidden="true">!</span><div class="resource-plan-issue-content"><p class="resource-plan-issue-category">@T($"Severity.{issue.Severity}")@if (affected is not null) { <span> · @ResourceKindLabel(affected.Proposed.Kind)</span> }</p><h3>@IssueTitle(issue.Code)</h3>
                            @if (affected is not null) { <p class="resource-plan-issue-resource">@ResourcePlanReviewProjection.DisplayName(affected) <code>@affected.LogicalId</code></p> }
                            <p>@IssueDescription(issue.Code, affected)</p>
                            @if (issue.Code == "resource_change_model_profile_invalid") { <p class="resource-plan-issue-action">@T("Issue.ModelProfile.Action")</p> }
                            <details class="resource-plan-issue-technical"><summary>@T("TechnicalDetails")</summary><code>@issue.Code</code><code>@issue.Path</code><p>@issue.Message</p></details>
                        </div></li>
                    }
                    </ol>
            }
                @if (latestValidation.Readiness == ResourceChangeSetReadiness.Ready && !ResourcePlanReviewProjection.IsStale(plan.Value, selected.Value, latestValidation))
                {
                    <div class="resource-plan-validation-next"><div><strong>@T("ValidationNextTitle")</strong><p>@T("ValidationNextDescription")</p></div><button class="button-secondary" type="button" @onclick="ShowApplication">@T("OpenApplication")</button></div>
                }
            }
        }
        else if (activeView == "Application")
        {
            <div class="resource-plan-section-heading"><div><p class="eyebrow">@T("ApplicationKicker")</p><h2>@T("View.Application")</h2><p>@T("ApplicationIntro")</p></div></div>
            @if (application is not null)
            {
                <div class="resource-plan-application-summary @(application.Value.Status == ResourceChangeSetApplicationStatus.Applied ? "is-applied" : application.Value.Status == ResourceChangeSetApplicationStatus.Applying ? "is-applying" : "is-failed")" role="status">
                    <span class="resource-plan-application-symbol" aria-hidden="true">@(application.Value.Status == ResourceChangeSetApplicationStatus.Applied ? "✓" : application.Value.Status == ResourceChangeSetApplicationStatus.Applying ? "…" : "!")</span>
                    <div><p class="resource-plan-validation-kicker">@T("ApplicationResult")</p><h3>@T($"ApplicationSummary.{application.Value.Status}")</h3><p>@T($"ApplicationDescription.{application.Value.Status}")</p>
                        <div class="resource-plan-validation-meta"><StatusBadge Text="@T($"Application.{application.Value.Status}")" Status="@(application.Value.Status == ResourceChangeSetApplicationStatus.Applied ? UiStatus.Success : application.Value.Status == ResourceChangeSetApplicationStatus.Applying ? UiStatus.Warning : UiStatus.Danger)" /><span>@T("ApplicationAttempts", application.Value.Attempts)</span>@if (application.Value.CompletedAt is { } completedAt) { <span>@T("ApplicationCompletedAt") <time datetime="@completedAt.ToString("O")">@completedAt.ToLocalTime().ToString("g")</time></span> }</div>
                    </div>
                </div>
                <div class="resource-plan-application-counts" aria-label="@T("ApplicationProgress")"><div><strong>@application.Value.Operations.Count(value => value.Outcome is ResourceChangeApplicationOutcome.Applied or ResourceChangeApplicationOutcome.AlreadyApplied)</strong><span>@T("ApplicationAppliedCount")</span></div><div><strong>@application.Value.Operations.Count(value => value.Outcome == ResourceChangeApplicationOutcome.Skipped)</strong><span>@T("ApplicationSkippedCount")</span></div><div><strong>@application.Value.Operations.Count(value => value.Outcome == ResourceChangeApplicationOutcome.Failed)</strong><span>@T("ApplicationFailedCount")</span></div></div>
                <section class="resource-plan-application-operations" aria-label="@T("ApplicationOperations")">
