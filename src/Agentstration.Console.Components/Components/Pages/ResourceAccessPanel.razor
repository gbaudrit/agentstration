@implements IDisposable
@inject IResourceAccessPolicyClient Policies
@inject IResourceScopeInventoryClient Scopes
@inject Microsoft.Extensions.Localization.IStringLocalizer<ResourceAccessPanelStrings> Localizer

<section class="resource-access-panel" data-testid="resource-access-panel">
    @if (loading)
    {
        <LoadingState Message="@T("Loading")" />
    }
    else if (loadError)
    {
        <ErrorState Title="@T("UnableToLoad")" Message="@T("UnableToLoadMessage")">
            <button class="button-secondary" type="button" @onclick="LoadAsync">@T("Retry")</button>
        </ErrorState>
    }
    else if (identity is null)
    {
        <EmptyState Title="@T("IdentityUnavailable")" Message="@T("IdentityUnavailableMessage")" />
    }
    else
    {
        <article class="panel access-identity">
            <div class="panel-header">
                <div><p class="eyebrow">@T("Ownership")</p><h2>@T("ResourceIdentity")</h2><p>@T("ResourceIdentityHelp")</p></div>
                <ResourceScopeBadge ScopeRef="OwnerScopeRef" />
            </div>
            <dl class="resource-details access-identity-grid">
                <dt>@T("Scope")</dt><dd><code>@OwnerScopeRef.Value</code></dd>
                <dt>@T("Namespace")</dt><dd><code>@Namespace.Value</code></dd>
                <dt>@T("Uid")</dt><dd><code>@identity.Uid</code></dd>
                @if (Generation is not null) { <dt>@T("Generation")</dt><dd>@Generation</dd> }
                @if (!string.IsNullOrWhiteSpace(Version)) { <dt>@T("Version")</dt><dd><code>@Version</code></dd> }
            </dl>
        </article>

        <article class="panel access-governance">
            <div class="panel-header"><div><p class="eyebrow">@T("Governance")</p><h2>@GovernanceTitle</h2><p>@GovernanceHelp</p></div><StatusBadge Text="@GovernanceBadge" Status="@(Governance.IsManaged ? UiStatus.Info : UiStatus.Neutral)" /></div>
            <dl class="resource-details access-governance-grid">
                <dt>@T("Origin")</dt><dd>@OriginLabel</dd>
                @if (!string.IsNullOrWhiteSpace(Governance.Origin.Reference)) { <dt>@T("OriginReference")</dt><dd><code>@Governance.Origin.Reference</code></dd> }
                @if (!string.IsNullOrWhiteSpace(Governance.Origin.Version)) { <dt>@T("SuppliedVersion")</dt><dd><code>@Governance.Origin.Version</code></dd> }
                @if (Governance.ManagedBy is { } manager) { <dt>@T("ManagedBy")</dt><dd><code>@manager.Reference</code></dd> }
            </dl>
        </article>

        <article class="panel access-grants">
            <div class="panel-header">
                <div><p class="eyebrow">@T("Visibility")</p><h2>@T("DescendantAccess")</h2><p>@T("DefaultDenyHelp")</p></div>
            </div>
            @if (grants.Count == 0)
            {
                <EmptyState Title="@T("NoGrants")" Message="@T("NoGrantsMessage")" />
            }
            else
            {
                <div class="access-grant-list">
                    @foreach (var grant in grants)
                    {
                        <div class="access-grant" data-testid="resource-access-grant">
                            <div class="access-target"><ResourceScopeBadge ScopeRef="grant.TargetScopeRef" /><strong>@TargetName(grant.TargetScopeRef)</strong><code>@grant.TargetScopeRef.Value</code></div>
                            <div class="access-actions" aria-label="@T("AllowedActions")">
                                <label><input type="checkbox" checked="@grant.Discover" disabled="@(!canManage)" @onchange="args => SetAction(grant, ResourceAccessAction.Discover, (bool)(args.Value ?? false))" />@T("Discover")</label>
                                <label><input type="checkbox" checked="@grant.Use" disabled="@(!canManage)" @onchange="args => SetAction(grant, ResourceAccessAction.Use, (bool)(args.Value ?? false))" />@T("Use")</label>
                                <label><input type="checkbox" checked="@grant.IncludeDescendants" disabled="@(!canManage || grant.TargetScopeRef.Kind == ResourceScopeKind.Workspace)" @onchange="args => SetPropagation(grant, (bool)(args.Value ?? false))" />@T("IncludeDescendants")</label>
                            </div>
                            @if (canManage) { <button class="button-secondary" type="button" data-testid="resource-access-remove" @onclick="() => Remove(grant)">@T("Remove")</button> }
                        </div>
                    }
                </div>
            }

            @if (canManage && AvailableTargets.Count > 0)
            {
                <div class="access-add">
                    <label><span>@T("TargetScope")</span><select data-testid="resource-access-target" @bind="selectedTarget"><option value="">@T("SelectTarget")</option>@foreach (var target in AvailableTargets) { <option value="@target.ScopeRef.Value">@TargetLabel(target)</option> }</select></label>
                    <button class="button-secondary" type="button" data-testid="resource-access-add" disabled="@string.IsNullOrWhiteSpace(selectedTarget)" @onclick="Add">@T("Add")</button>
                </div>
            }
            else if (!canManage)
            {
                <p class="access-readonly" role="note">@T("ReadOnlyPolicy")</p>
            }

            @if (invalidGrant) { <p class="error-panel" role="alert">@T("GrantActionsRequired")</p> }
            @if (saveError) { <p class="error-panel" role="alert">@T("SaveFailed")</p> }
            @if (saved) { <p class="access-success" role="status">@T("Saved")</p> }
            @if (canManage)
            {
                <div class="form-actions"><button class="button-primary" type="button" data-testid="resource-access-save" disabled="@(saving || invalidGrant || !dirty)" @onclick="SaveAsync">@(saving ? T("Saving") : T("Save"))</button></div>
            }
        </article>
    }
</section>

@code {
    [Parameter, EditorRequired] public ResourceScopeRef OwnerScopeRef { get; set; }
    [Parameter, EditorRequired] public ResourceNamespace Namespace { get; set; }
    [Parameter, EditorRequired] public string Kind { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter] public long? Generation { get; set; }
    [Parameter] public string? Version { get; set; }
    [Parameter] public ResourceGovernance Governance { get; set; } = ResourceGovernance.User;

    private readonly CancellationTokenSource cancellation = new();
    private readonly List<GrantModel> grants = [];
    private ResourceAccessIdentity? identity;
    private ResourceScopeInventoryResponse? inventory;
    private IReadOnlyList<ResourceScopeTargetResponse> targets = [];
    private string? etag;
    private string? loadedKey;
    private string selectedTarget = string.Empty;
    private bool loading = true, loadError, canManage, dirty, saving, saveError, saved;
    private bool invalidGrant => grants.Any(value => !value.Discover && !value.Use);
    private IReadOnlyList<ResourceScopeTargetResponse> AvailableTargets => targets
        .Where(value => IsDescendant(value.ScopeRef, OwnerScopeRef)
            && grants.All(grant => grant.TargetScopeRef != value.ScopeRef))
        .OrderBy(value => ScopeRank(value.Kind)).ThenBy(value => value.DisplayName, StringComparer.CurrentCultureIgnoreCase).ToArray();

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{OwnerScopeRef.Value}|{Namespace.Value}|{Kind}|{Name}|{Generation}|{Version}";
        if (string.Equals(key, loadedKey, StringComparison.Ordinal)) return;
        loadedKey = key;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true; loadError = saveError = saved = false; dirty = false; grants.Clear();
        try
        {
            inventory = await Scopes.GetAsync(cancellation.Token);
            targets = await Scopes.GetTargetsAsync(Kind, cancellation.Token);
            canManage = targets.Any(value => value.ScopeRef == OwnerScopeRef && value.CanWrite);
            var resource = inventory.Scopes.SingleOrDefault(value => value.ScopeRef == OwnerScopeRef)?.Resources
                .SingleOrDefault(value => value.Namespace == Namespace
                    && string.Equals(value.Kind, Kind, StringComparison.Ordinal)
                    && string.Equals(value.Name, Name, StringComparison.Ordinal));
            if (resource is null) { identity = null; return; }
            identity = new(resource.Uid, OwnerScopeRef, Namespace, Kind, Generation, Version);
            var snapshot = await Policies.GetAsync(resource.Uid, cancellation.Token);
            etag = snapshot?.ETag;
            grants.AddRange(snapshot?.Policy.Grants.Select(GrantModel.From) ?? []);
        }
        catch (AgentstrationApiException) { loadError = true; identity = null; }
        finally { loading = false; }
    }

    private void Add()
    {
        if (!ResourceScopeRef.TryParse(selectedTarget, out var scopeRef) || !IsDescendant(scopeRef, OwnerScopeRef)) return;
        grants.Add(new(scopeRef, true, true, false)); selectedTarget = string.Empty; MarkDirty();
    }
    private void Remove(GrantModel grant) { grants.Remove(grant); MarkDirty(); }
    private void SetAction(GrantModel grant, ResourceAccessAction action, bool enabled)
    {
        if (action == ResourceAccessAction.Discover) grant.Discover = enabled; else grant.Use = enabled;
        MarkDirty();
    }
    private void SetPropagation(GrantModel grant, bool enabled) { grant.IncludeDescendants = enabled; MarkDirty(); }
    private void MarkDirty() { dirty = true; saved = saveError = false; }

    private async Task SaveAsync()
    {
        if (!canManage || identity is null || invalidGrant) return;
        saving = true; saveError = saved = false;
        try
        {
            var policy = new ResourceAccessPolicy(identity, grants.Select(value => value.ToGrant()).ToArray());
            var snapshot = await Policies.PutAsync(policy, etag, cancellation.Token);
            etag = snapshot.ETag; dirty = false; saved = true;
        }
        catch (AgentstrationApiException) { saveError = true; }
        finally { saving = false; }
    }

    private bool IsDescendant(ResourceScopeRef candidate, ResourceScopeRef owner)
    {
        if (candidate == owner || inventory is null) return false;
        var current = inventory.Scopes.SingleOrDefault(value => value.ScopeRef == candidate);
        while (current?.ParentScopeRef is { } parent)
        {
            if (parent == owner) return true;
            current = inventory.Scopes.SingleOrDefault(value => value.ScopeRef == parent);
        }
        return false;
    }

    private string TargetName(ResourceScopeRef scopeRef) => targets.SingleOrDefault(value => value.ScopeRef == scopeRef)?.DisplayName ?? scopeRef.Value;
    private string TargetLabel(ResourceScopeTargetResponse target) => $"{T($"ScopeKind.{target.Kind}")} · {target.DisplayName}";
    private string OriginLabel => T($"Origin.{Governance.Origin.Kind}");
    private string GovernanceTitle => Governance.IsManaged ? T("ManagedResource") : T("EditableResource");
    private string GovernanceHelp => Governance.IsManaged ? T("ManagedResourceHelp") : T("EditableResourceHelp");
    private string GovernanceBadge => Governance.IsManaged ? T("Managed") : T("Local");
    private static int ScopeRank(ResourceScopeKind kind) => kind switch { ResourceScopeKind.Instance => 0, ResourceScopeKind.Tenant => 1, _ => 2 };
    private string T(string key) => Localizer[key].Value;
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }

    private sealed class GrantModel(ResourceScopeRef targetScopeRef, bool discover, bool use, bool includeDescendants)
    {
        public ResourceScopeRef TargetScopeRef { get; } = targetScopeRef;
        public bool Discover { get; set; } = discover;
        public bool Use { get; set; } = use;
        public bool IncludeDescendants { get; set; } = includeDescendants;
        public ResourceAccessGrant ToGrant() => new(TargetScopeRef,
            new[] { (Discover, ResourceAccessAction.Discover), (Use, ResourceAccessAction.Use) }
                .Where(value => value.Item1).Select(value => value.Item2).ToArray(), IncludeDescendants);
        public static GrantModel From(ResourceAccessGrant grant) => new(grant.TargetScopeRef,
            grant.Actions.Contains(ResourceAccessAction.Discover), grant.Actions.Contains(ResourceAccessAction.Use), grant.IncludeDescendants);
    }
}
