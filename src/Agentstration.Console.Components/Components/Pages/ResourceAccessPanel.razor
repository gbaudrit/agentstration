@implements IDisposable
@inject IResourceAccessPolicyClient Policies
@inject IResourceScopeInventoryClient Scopes
@inject Microsoft.Extensions.Localization.IStringLocalizer<ResourceAccessPanelStrings> Localizer

<section class="resource-access-panel" data-testid="resource-access-panel"
         data-resource-uid="@identity?.Uid" data-resource-generation="@Generation"
         data-resource-version="@Version" data-resource-managed="@Governance.IsManaged.ToString().ToLowerInvariant()"
         data-resource-origin="@Governance.Origin.Kind" data-resource-origin-version="@Governance.Origin.Version">
    @if (loading)
    {
        <LoadingState Message="@T("Loading")" />
    }
    else if (loadError)
    {
        <ErrorState Title="@T("UnableToLoad")" Message="@T("UnableToLoadMessage")">
            <button class="button-secondary" type="button" @onclick="LoadAsync">@T("Retry")</button>
        </ErrorState>
    }
    else if (identity is null)
    {
        <EmptyState Title="@T("IdentityUnavailable")" Message="@T("IdentityUnavailableMessage")" />
    }
    else
    {
        <section class="panel access-context">
            <div><span class="muted">@T("Scope")</span><ResourceScopeBadge ScopeRef="OwnerScopeRef" /><StatusBadge Text="@GovernanceBadge" Status="@(Governance.IsManaged ? UiStatus.Info : UiStatus.Neutral)" /></div>
            <p>@T("DefaultDenyHelp")</p>
            @if (Governance.IsManaged) { <p>@T("ManagedResourceHelp")</p> }
        </section>
        <article class="panel access-grants">
            <div class="panel-header">
                <div><h2>@T("Permissions")</h2><p>@T("PermissionHelp")</p></div>
            </div>
            @if (grants.Count == 0)
            {
                <p class="access-empty">@T("NoGrantsMessage")</p>
            }
            else
            {
                <div class="access-grant-heading" aria-hidden="true"><span>@T("TargetScope")</span><span>@T("AllowedActions")</span><span></span></div>
                <div class="access-grant-list" role="list">
                    @foreach (var grant in grants)
                    {
                        <div class="access-grant" role="listitem" data-testid="resource-access-grant" data-scope-ref="@grant.TargetScopeRef.Value">
                            <div class="access-target"><ResourceScopeBadge ScopeRef="grant.TargetScopeRef" DisplayName="@TargetName(grant.TargetScopeRef)" /><code>@grant.TargetScopeRef.Value</code></div>
                            <div class="access-actions" aria-label="@T("AllowedActions")">
                                <label><FormCheckbox Value="@grant.Discover" disabled="@(!canManage || saving)" ValueChanged="changed => SetAction(grant, ResourceAccessAction.Discover, (bool)((new ChangeEventArgs { Value = changed }).Value ?? false))" />@T("Discover")</label>
                                <label><FormCheckbox Value="@grant.Use" disabled="@(!canManage || saving)" ValueChanged="changed => SetAction(grant, ResourceAccessAction.Use, (bool)((new ChangeEventArgs { Value = changed }).Value ?? false))" />@T("Use")</label>
                                <label><FormCheckbox Value="@grant.IncludeDescendants" disabled="@(!canManage || saving || grant.TargetScopeRef.Kind == ResourceScopeKind.Workspace)" ValueChanged="changed => SetPropagation(grant, (bool)((new ChangeEventArgs { Value = changed }).Value ?? false))" />@T("IncludeDescendants")</label>
                            </div>
                            @if (canManage) { <CollectionActions ResourceName="@TargetName(grant.TargetScopeRef)"><button class="button-secondary" type="button" disabled="@saving" data-testid="resource-access-remove" @onclick="() => Remove(grant)">@T("Remove")</button></CollectionActions> }
                        </div>
                    }
                </div>
            }

            @if (canManage && AvailableTargets.Count > 0)
            {
                <button class="button-secondary" type="button" disabled="@saving" @onclick="ToggleAddition" aria-expanded="@adding.ToString().ToLowerInvariant()" aria-controls="@addId" data-testid="resource-access-open-add">@(adding ? T("CloseAdd") : T("Add"))</button>
                <div class="access-add" id="@addId" hidden="@(!adding)">
                    <FormField Label="@T("SearchTargets")"><ClearableText Value="@targetSearch" ValueChanged="value => { targetSearch = value; SelectTarget(string.Empty); }" Type="search" Disabled="@saving" data-testid="resource-access-search" /></FormField>
                    <FormField Label="@T("TargetScope")"><ClearableSelect TValue="string" Disabled="@saving" Value="@selectedTarget" ValueChanged="SelectTarget" ValueExpression="@(() => selectedTarget)" data-testid="resource-access-target"><option value="">@T("SelectTarget")</option>@foreach (var target in FilteredTargets.Take(50)) { <option value="@target.ScopeRef.Value">@TargetLabel(target)</option> }</ClearableSelect></FormField>
                    <small>@T("TargetResults", Math.Min(50, FilteredTargets.Count), FilteredTargets.Count)</small>
                    <div class="access-actions">
                        <label><FormCheckbox @bind-Value="addDiscover" disabled="@saving" />@T("Discover")</label>
                        <label><FormCheckbox @bind-Value="addUse" disabled="@saving" />@T("Use")</label>
                        <label><FormCheckbox @bind-Value="addDescendants" disabled="@(saving || ResourceScopeRef.TryParse(selectedTarget, out var targetScope) && targetScope.Kind == ResourceScopeKind.Workspace)" />@T("IncludeDescendants")</label>
                    </div>
                    <small>@T("PendingGrantHelp")</small>
                    <button class="button-secondary" type="button" data-testid="resource-access-add" disabled="@(saving || string.IsNullOrWhiteSpace(selectedTarget) || (!addDiscover && !addUse))" @onclick="Add">@T("AddToList")</button>
                </div>
            }
            else if (!canManage)
            {
                <p class="access-readonly" role="note">@T("ReadOnlyPolicy")</p>
            }

            @if (invalidTarget) { <p class="error-panel" role="alert" data-testid="resource-access-invalid-target">@T("InvalidTarget")</p> }
            @if (invalidGrant) { <p class="error-panel" role="alert">@T("GrantActionsRequired")</p> }
            @if (saveError) { <p class="error-panel" role="alert">@T("SaveFailed")</p> }
            @if (saved) { <p class="access-success" role="status" data-testid="resource-access-saved">@T("Saved")</p> }
            @if (canManage)
            {
                <FormActions><button class="text-button" type="button" @onclick="Discard" disabled="@(saving || (!dirty && !adding))" data-testid="resource-access-discard">@T("Discard")</button><button class="button-primary" type="button" data-testid="resource-access-save" disabled="@(saving || invalidGrant || (!dirty && !HasPendingGrant))" @onclick="SaveAsync">@(saving ? T("Saving") : T("Save"))</button></FormActions>
            }
        </article>
        <details class="panel access-details"><summary>@T("ResourceDetails")</summary>
        <article class="access-identity">
            <div class="panel-header">
                <div><h2>@T("ResourceIdentity")</h2><p>@T("ResourceIdentityHelp")</p></div>
                <ResourceScopeBadge ScopeRef="OwnerScopeRef" />
            </div>
            <dl class="resource-details access-identity-grid">
                <dt>@T("Scope")</dt><dd><code>@OwnerScopeRef.Value</code></dd>
                <dt>@T("Namespace")</dt><dd><code>@Namespace.Value</code></dd>
                <dt>@T("Uid")</dt><dd><code>@identity.Uid</code></dd>
                @if (Generation is not null) { <dt>@T("Generation")</dt><dd>@Generation</dd> }
                @if (!string.IsNullOrWhiteSpace(Version)) { <dt>@T("Version")</dt><dd><code>@Version</code></dd> }
            </dl>
        </article>

        <article class="access-governance">
            <div class="panel-header"><div><h2>@GovernanceTitle</h2><p>@GovernanceHelp</p></div><StatusBadge Text="@GovernanceBadge" Status="@(Governance.IsManaged ? UiStatus.Info : UiStatus.Neutral)" /></div>
            <dl class="resource-details access-governance-grid">
                <dt>@T("Origin")</dt><dd>@OriginLabel</dd>
                @if (!string.IsNullOrWhiteSpace(Governance.Origin.Reference)) { <dt>@T("OriginReference")</dt><dd><code>@Governance.Origin.Reference</code></dd> }
                @if (!string.IsNullOrWhiteSpace(Governance.Origin.Version)) { <dt>@T("SuppliedVersion")</dt><dd><code>@Governance.Origin.Version</code></dd> }
                @if (Governance.ManagedBy is { } manager) { <dt>@T("ManagedBy")</dt><dd><code>@manager.Reference</code></dd> }
            </dl>
        </article>

        </details>
    }
</section>

@code {
    [Parameter, EditorRequired] public ResourceScopeRef OwnerScopeRef { get; set; }
    [Parameter, EditorRequired] public ResourceNamespace Namespace { get; set; }
    [Parameter, EditorRequired] public string Kind { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter] public long? Generation { get; set; }
    [Parameter] public string? Version { get; set; }
    [Parameter] public ResourceGovernance Governance { get; set; } = ResourceGovernance.User;

    private readonly CancellationTokenSource cancellation = new();
    private readonly List<GrantModel> grants = [];
    private ResourceAccessIdentity? identity;
    private ResourceScopeInventoryResponse? inventory;
    private IReadOnlyList<ResourceScopeTargetResponse> targets = [];
    private string? etag;
    private string? loadedKey;
    private readonly string addId = $"access-add-{Guid.NewGuid():N}";
    private ResourceAccessGrant[] savedGrants = [];
    private string targetSearch = string.Empty;
    private bool adding, addDiscover = true, addUse = true, addDescendants;
    private string selectedTarget = string.Empty;
    private IReadOnlyList<ResourceScopeTargetResponse> FilteredTargets => AvailableTargets.Where(target => $"{target.DisplayName} {target.ScopeRef.Value}".Contains(targetSearch, StringComparison.CurrentCultureIgnoreCase)).ToArray();
    private bool loading = true, loadError, canManage, dirty, saving, saveError, saved, invalidTarget;
    private bool HasPendingGrant => adding && !string.IsNullOrWhiteSpace(selectedTarget);
    private bool invalidGrant => grants.Any(value => !value.Discover && !value.Use)
        || HasPendingGrant && !addDiscover && !addUse;
    private IReadOnlyList<ResourceScopeTargetResponse> AvailableTargets => targets
        .Where(value => IsDescendant(value.ScopeRef, OwnerScopeRef)
            && grants.All(grant => grant.TargetScopeRef != value.ScopeRef))
        .OrderBy(value => ScopeRank(value.Kind)).ThenBy(value => value.DisplayName, StringComparer.CurrentCultureIgnoreCase).ToArray();

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{OwnerScopeRef.Value}|{Namespace.Value}|{Kind}|{Name}|{Generation}|{Version}";
        if (string.Equals(key, loadedKey, StringComparison.Ordinal)) return;
        loadedKey = key;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true; loadError = saveError = saved = invalidTarget = false; dirty = false; grants.Clear(); ResetAddition();
        try
        {
            inventory = await Scopes.GetAsync(cancellation.Token);
            var ownershipTargets = await Scopes.GetTargetsAsync(Kind, cancellation.Token);
            canManage = ownershipTargets.Any(value => value.ScopeRef == OwnerScopeRef && value.CanWrite);
            targets = inventory.Scopes.Select(scope => new ResourceScopeTargetResponse(
                scope.ScopeRef,
                scope.Kind,
                scope.DisplayName,
                ownershipTargets.SingleOrDefault(value => value.ScopeRef == scope.ScopeRef)?.CanWrite ?? false))
                .ToArray();
            var resource = inventory.Scopes.SingleOrDefault(value => value.ScopeRef == OwnerScopeRef)?.Resources
                .SingleOrDefault(value => value.Namespace == Namespace
                    && string.Equals(value.Kind, Kind, StringComparison.Ordinal)
                    && string.Equals(value.Name, Name, StringComparison.Ordinal));
            if (resource is null) { identity = null; return; }
            identity = new(resource.Uid, OwnerScopeRef, Namespace, Kind, Generation, Version);
            var snapshot = await Policies.GetAsync(resource.Uid, cancellation.Token);
            etag = snapshot?.ETag;
            grants.AddRange(snapshot?.Policy.Grants.Select(GrantModel.From) ?? []);
            savedGrants = grants.Select(grant => grant.ToGrant()).ToArray();
        }
        catch (AgentstrationApiException) { loadError = true; identity = null; }
        finally { loading = false; }
    }

    private void ToggleAddition()
    {
        if (!canManage || saving) return;
        if (adding) ResetAddition(); else adding = true;
        invalidTarget = false;
    }
    private void SelectTarget(string value)
    {
        selectedTarget = value;
        saved = saveError = invalidTarget = false;
    }
    private void ResetAddition()
    {
        selectedTarget = targetSearch = string.Empty; adding = false; addDiscover = addUse = true; addDescendants = false;
    }
    private void Add() => TryAddPendingGrant();
    private bool TryAddPendingGrant()
    {
        if (!canManage || saving) return false;
        if (!ResourceScopeRef.TryParse(selectedTarget, out var scopeRef) || !IsDescendant(scopeRef, OwnerScopeRef)
            || AvailableTargets.All(target => target.ScopeRef != scopeRef))
        {
            invalidTarget = true;
            saved = false;
            return false;
        }
        if (!addDiscover && !addUse) return false;
        invalidTarget = false;
        grants.Add(new(scopeRef, addDiscover, addUse, addDescendants && scopeRef.Kind != ResourceScopeKind.Workspace));
        ResetAddition(); MarkDirty();
        return true;
    }
    private void Discard()
    {
        if (saving) return;
        grants.Clear(); grants.AddRange(savedGrants.Select(GrantModel.From));
        ResetAddition();
        dirty = saveError = saved = invalidTarget = false;
    }
    private void Remove(GrantModel grant) { grants.Remove(grant); MarkDirty(); }
    private void SetAction(GrantModel grant, ResourceAccessAction action, bool enabled)
    {
        if (action == ResourceAccessAction.Discover) grant.Discover = enabled; else grant.Use = enabled;
        MarkDirty();
    }
    private void SetPropagation(GrantModel grant, bool enabled) { grant.IncludeDescendants = enabled; MarkDirty(); }
    private void MarkDirty() { dirty = true; saved = saveError = invalidTarget = false; }

    private async Task SaveAsync()
    {
        if (!canManage || saving || identity is null || invalidGrant) return;
        if (HasPendingGrant && !TryAddPendingGrant()) return;
        saving = true; saveError = saved = false;
        try
        {
            var policy = new ResourceAccessPolicy(identity, grants.Select(value => value.ToGrant()).ToArray());
            var snapshot = await Policies.PutAsync(policy, etag, cancellation.Token);
            etag = snapshot.ETag; savedGrants = snapshot.Policy.Grants.ToArray(); dirty = false; saved = true;
        }
        catch (AgentstrationApiException) { saveError = true; }
        finally { saving = false; }
    }

    private bool IsDescendant(ResourceScopeRef candidate, ResourceScopeRef owner)
    {
        if (candidate == owner || inventory is null) return false;
        var current = inventory.Scopes.SingleOrDefault(value => value.ScopeRef == candidate);
        while (current?.ParentScopeRef is { } parent)
        {
            if (parent == owner) return true;
            current = inventory.Scopes.SingleOrDefault(value => value.ScopeRef == parent);
        }
        return false;
    }

    private string TargetName(ResourceScopeRef scopeRef) => targets.SingleOrDefault(value => value.ScopeRef == scopeRef)?.DisplayName ?? scopeRef.Value;
    private string TargetLabel(ResourceScopeTargetResponse target) => $"{T($"ScopeKind.{target.Kind}")} · {target.DisplayName} · {target.ScopeRef.Value}";
    private string OriginLabel => T($"Origin.{Governance.Origin.Kind}");
    private string GovernanceTitle => Governance.IsManaged ? T("ManagedResource") : T("EditableResource");
    private string GovernanceHelp => Governance.IsManaged ? T("ManagedResourceHelp") : T("EditableResourceHelp");
    private string GovernanceBadge => Governance.IsManaged ? T("Managed") : T("Local");
    private static int ScopeRank(ResourceScopeKind kind) => kind switch { ResourceScopeKind.Instance => 0, ResourceScopeKind.Tenant => 1, _ => 2 };
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }

    private sealed class GrantModel(ResourceScopeRef targetScopeRef, bool discover, bool use, bool includeDescendants)
    {
        public ResourceScopeRef TargetScopeRef { get; } = targetScopeRef;
        public bool Discover { get; set; } = discover;
        public bool Use { get; set; } = use;
        public bool IncludeDescendants { get; set; } = includeDescendants;
        public ResourceAccessGrant ToGrant() => new(TargetScopeRef,
            new[] { (Discover, ResourceAccessAction.Discover), (Use, ResourceAccessAction.Use) }
                .Where(value => value.Item1).Select(value => value.Item2).ToArray(), IncludeDescendants);
        public static GrantModel From(ResourceAccessGrant grant) => new(grant.TargetScopeRef,
            grant.Actions.Contains(ResourceAccessAction.Discover), grant.Actions.Contains(ResourceAccessAction.Use), grant.IncludeDescendants);
    }
}
