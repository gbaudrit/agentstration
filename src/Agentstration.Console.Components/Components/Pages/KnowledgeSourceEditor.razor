@page "/knowledge-sources/new"
@page "/knowledge-sources/{Name}/edit"
@implements IDisposable
@inject IKnowledgeSourcesClient Client
@inject IKnowledgeSourceProfilesClient Profiles
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<KnowledgeSourcesStrings> Localizer

<PageTitle>@T(IsNew ? "CreateSource" : "EditSource") · Agentstration</PageTitle>
<PageHeader Title="@T(IsNew ? "CreateSource" : "EditSource")" Description="@T("EditorDescription")" TestId="knowledge-source-editor">
    <Actions><a class="button-secondary" href="@(IsNew ? "/knowledge-sources" : DetailsUrl)">@T("Cancel")</a></Actions>
</PageHeader>

@if (loading) { <LoadingState Message="@T("LoadingDetails")" /> }
else
{
    @if (message is not null) { <div class="form-alert form-alert-danger" role="alert">@message</div> }
    <EditForm Model="this" OnValidSubmit="SaveAsync" class="panel form-section">
        <div class="form-grid">
            <ResourceIdentityFields @bind-DisplayName="displayName" @bind-TechnicalName="technicalName" IsNew="@IsNew" DisplayNameTestId="knowledge-source-display-name" TechnicalNameTestId="knowledge-source-name" />
            @if (IsNew)
            {
                <label><span>@T("Namespace")</span><input @bind="sourceNamespace" maxlength="128" /></label>
            }
            <label class="form-field-wide"><span>@T("SourceDescription")</span><textarea @bind="description" maxlength="2000"></textarea></label>
            <label><span>@T("Profile")</span><select @bind="profileKey" required data-testid="knowledge-source-profile"><option value="">@T("SelectProfile")</option>@foreach (var profile in profiles) { <option value="@Key(profile.Namespace, profile.Name)">@ProfileOptionLabel(profile)</option> }</select></label>
            <label class="form-field-wide"><span>@T("SourceConfiguration")</span><textarea class="runner-json" rows="8" @bind="acquisitionConfigurationJson" data-testid="knowledge-source-configuration"></textarea><small>@T("SourceConfigurationHelp")</small></label>
            <label class="knowledge-choice form-field-wide" data-testid="knowledge-source-editor-enabled-option"><input type="checkbox" @bind="enabled" /><span class="knowledge-choice-icon"><UiIcon Name="check" /></span><span><strong>@T("Enabled")</strong><small>@T("EnabledHelp")</small></span></label>
        </div>
        <div class="form-actions"><button class="button-primary" type="submit" disabled="@busy">@(busy ? T("Saving") : T("Save"))</button></div>
    </EditForm>
}

@code {
    [Parameter] public string? Name { get; set; }
    [SupplyParameterFromQuery(Name = "namespace")] public string? Namespace { get; set; }
    private readonly CancellationTokenSource cancellation = new();
    private IReadOnlyList<KnowledgeSourceProfileResource> profiles = [];
    private string technicalName = string.Empty, sourceNamespace = "default", displayName = string.Empty,
        description = string.Empty, profileKey = string.Empty, acquisitionConfigurationJson = "{}";
    private KnowledgeFlowTarget? legacyIngestionFlow, legacyRetrievalFlow;
    private string? etag, message;
    private bool enabled, busy, loading = true;
    private static readonly System.Text.Json.JsonSerializerOptions IndentedJson = new() { WriteIndented = true };
    private bool IsNew => string.IsNullOrWhiteSpace(Name);
    private ResourceNamespace ExistingNamespace => ResourceNamespace.Parse(Namespace);
    private string DetailsUrl => ExistingNamespace.IsDefault ? $"/knowledge-sources/{Uri.EscapeDataString(Name!)}" : $"/knowledge-sources/{Uri.EscapeDataString(Name!)}?namespace={Uri.EscapeDataString(ExistingNamespace.Value)}";
    private string T(string key, params object[] arguments) => Localizer[key, arguments];

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        message = null;
        try
        {
            var profilesTask = Profiles.GetAsync(cancellation.Token);
            profiles = await profilesTask;
            if (!IsNew)
            {
                var snapshot = await Client.GetAsync(ExistingNamespace, Name!, cancellation.Token);
                etag = snapshot.ETag;
                technicalName = snapshot.Value.Name;
                displayName = snapshot.Value.Definition.DisplayName;
                description = snapshot.Value.Definition.Description ?? string.Empty;
                enabled = snapshot.Value.Definition.Enabled;
                acquisitionConfigurationJson = System.Text.Json.JsonSerializer.Serialize(
                    snapshot.Value.Definition.AcquisitionConfiguration, IndentedJson);
                legacyIngestionFlow = snapshot.Value.Definition.IngestionFlow;
                legacyRetrievalFlow = snapshot.Value.Definition.RetrievalFlow;
                profileKey = ReferenceKey(snapshot.Value.Definition.Profile, snapshot.Value.Namespace);
            }
        }
        catch (Exception exception) { message = exception.Message; }
        finally { loading = false; }
    }

    private async Task SaveAsync()
    {
        if (busy) return;
        busy = true;
        message = null;
        try
        {
            using var configuration = System.Text.Json.JsonDocument.Parse(acquisitionConfigurationJson);
            if (configuration.RootElement.ValueKind != System.Text.Json.JsonValueKind.Object)
            {
                message = T("SourceConfigurationObjectRequired");
                return;
            }
            var properties = new KnowledgeSourceProperties
            {
                DisplayName = displayName.Trim(),
                Description = string.IsNullOrWhiteSpace(description) ? null : description.Trim(),
                Enabled = enabled,
                AcquisitionConfiguration = configuration.RootElement.Clone(),
                Profile = Reference(profileKey),
                IngestionFlow = string.IsNullOrWhiteSpace(profileKey) && !IsNew ? legacyIngestionFlow : null,
                RetrievalFlow = string.IsNullOrWhiteSpace(profileKey) && !IsNew ? legacyRetrievalFlow : null
            };
            var saved = IsNew
                ? await Client.CreateAsync(new CreateKnowledgeSourceRequest(technicalName.Trim(), properties, sourceNamespace.Trim()), cancellation.Token)
                : await Client.UpdateAsync(ExistingNamespace, Name!, new PutKnowledgeSourceRequest(properties), etag!, cancellation.Token);
            var ns = saved.Value.Namespace;
            Navigation.NavigateTo(ns.IsDefault ? $"/knowledge-sources/{Uri.EscapeDataString(saved.Value.Name)}" : $"/knowledge-sources/{Uri.EscapeDataString(saved.Value.Name)}?namespace={Uri.EscapeDataString(ns.Value)}");
        }
        catch (System.Text.Json.JsonException exception)
        {
            message = T("InvalidSourceConfigurationJson", exception.LineNumber ?? 0, exception.BytePositionInLine ?? 0);
        }
        catch (Exception exception) { message = exception.Message; }
        finally { busy = false; }
    }

    private static string Key(ResourceNamespace ns, string name) => $"{ns.Value}|{name}";
    private string ProfileOptionLabel(KnowledgeSourceProfileResource value) => $"{value.Definition.DisplayName} ({value.ActiveVersion ?? T("Draft")})";
    private static string ReferenceKey(ResourceReference? reference, ResourceNamespace owner) => reference is null ? string.Empty : Key(reference.Namespace ?? owner, reference.Name);
    private static ResourceReference? Reference(string key)
    {
        var parts = key.Split('|', 2);
        return parts.Length != 2 ? null : new ResourceReference(parts[1], null, ResourceNamespace.Parse(parts[0]));
    }
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
