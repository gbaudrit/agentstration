@page "/knowledge-sources/new"
@page "/knowledge-sources/{Name}/edit"
@implements IDisposable
@inject IKnowledgeSourcesClient Client
@inject IDataSourcesClient DataSources
@inject IFlowApiClient Flows
@inject IServiceProvider Services
@using Agentstration.Storage.Contracts
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<KnowledgeSourcesStrings> Localizer

<PageTitle>@T(IsNew ? "CreateSource" : "EditSource") · Agentstration</PageTitle>
@{ var presentations = SectionPresentations ?? OwnPresentations; }
@if (IsNew || Embedded)
{
    @if (!Embedded) { <PageHeader CollectionHref="/knowledge-sources" CollectionLabel="@T("Title")" ScopeRef="ownerScope" Title="@T("CreateSource")" Description="@T("ProjectionEditorDescription")" TestId="knowledge-source-editor"></PageHeader><UnsavedNavigationGuard IsDirty="HasDraft" HasUnsavedChanges="@(() => HasDraft)" /> }
    @if (loading) { <LoadingState Message="@T("LoadingDetails")" /> } else { @EditorForm(presentations) }
}
else
{
    <ConsoleResourceDetailsTemplate CollectionHref="/knowledge-sources" CollectionLabel="@T("Title")" Resource="savedSource" RequestedAddress="@ResourceAddress.Create(ExistingNamespace, KnowledgeResourceKinds.KnowledgeSource, Name!)"
        ResourceIdentity="@($"{loadedKey}|{savedSource?.Uid}")" Name="@(savedSource?.Definition.DisplayName ?? Name!)" ResourceType="@T("KnowledgeSource")" Domain="knowledge" IconName="database"
        Description="@savedSource?.Definition.Description" SectionState="ownSections" SectionPresentations="presentations" LoadState="loadState" OnRefresh="RefreshAsync" OnRetry="RefreshAsync"
        HasDraft="HasDraft" Busy="busy" DefinitionReadOnlyReason="@(CanEdit ? null : ResourceReadOnlyReason.InsufficientPermissions)" Yaml="@SavedYaml"
        Enabled="model.Enabled" EnabledChanged="SetEnabled" EnabledDisabled="@(!CanEdit || busy)" TestId="knowledge-source-editor" SectionTestIdPrefix="knowledge-source-editor">
        <Actions><a class="button-secondary" href="@DetailsUrl">@T("Back")</a></Actions>
        <OverviewConfiguration><CollectionView TItem="KeyValuePair<string,string>" Items="SavedSettings" IdentityLabel="@T("SettingName")" InformationLabels="@(new[] { T("SettingValue") })"><Identity Context="row">@row.Key</Identity><Information Context="row"><CollectionValue Label="@T("SettingValue")"><span class="configuration-value">@row.Value</span></CollectionValue></Information></CollectionView></OverviewConfiguration>
        <DefinitionContent Context="path">@EditorForm(presentations)</DefinitionContent>
        <DraftActions><button class="text-button" type="button" @onclick="DiscardAsync">@T("DiscardDraft")</button><button class="button-primary" type="submit" form="knowledge-source-definition">@T("Save")</button></DraftActions>
    </ConsoleResourceDetailsTemplate>
}
<ConfirmationDialog IsOpen="confirmRebind" Title="@T("RebindDependencies")" Message="@T("RebindDependenciesHelp")" ConfirmLabel="@T("ConfirmRebindDependencies")" CancelLabel="@T("Cancel")" OnConfirm="ConfirmRebindAsync" OnCancel="() => confirmRebind = false" TestId="knowledge-rebind-confirmation" />

@code {
    [Parameter] public string? Name { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "namespace")] public string? Namespace { get; set; }
    [Parameter] public bool Embedded { get; set; }
    [Parameter] public EventCallback<KnowledgeSourceResource> Saved { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "scopeRef")] public string? ScopeRef { get; set; }
    [Parameter] public ResourceSnapshot<KnowledgeSourceResource>? Snapshot { get; set; }
    [Parameter] public ResourceSectionState? SectionState { get; set; }
    [Parameter] public IReadOnlyDictionary<string, ResourceSectionPresentation>? SectionPresentations { get; set; }
    [Parameter] public EventCallback<string> SectionRequested { get; set; }
    [Parameter] public EventCallback<bool> DraftChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback<Exception> ResourceUnavailable { get; set; }
    [Parameter] public int DiscardRevision { get; set; }
    private int observedDiscard;
    private KnowledgeSourceEditorModel model = new();
    private KnowledgeSourceResource? savedSource;
    private readonly ResourceSectionState ownSections = new();
    private ResourceDefinitionForm? form;
    private CreationWizard? wizard;
    private EditContext? formContext;
    private ValidationMessageStore? specialErrors;
    private string? loadedKey, observedEtag, destination;
    private string baseline = "";
    private bool touched, invalidInput, disposed, validationFocus;
    private long loadRevision;
    private ResourceSnapshot<KnowledgeSourceResource>? newerSnapshot, parameterSnapshot;
    private ResourceLoadStatus? unavailableStatus;
    private ResourceLoadState loadState => loading ? new(ResourceLoadStatus.Loading) : savedSource is not null ? new(ResourceLoadStatus.Ready) { HasContent = true } : new(unavailableStatus ?? ResourceLoadStatus.Failed) { Message = unavailableStatus is null ? message : null };
    private IKnowledgeSourcesClient ScopedClient => Client.WithOwner(Snapshot?.Value.ScopeRef ?? (ResourceScopeRef.TryParse(ScopeRef, out var owner) ? owner : savedSource?.ScopeRef));
    private bool CanEdit => !ReadOnly && (IsNew || savedSource is { ScopeRef: not null, Governance.IsManaged: false } && ResourceOwnershipContext.CanManage(savedSource.ScopeRef, Services));
    public bool HasDraft => !loading && (touched || invalidInput || DraftSignature != baseline);
    private string DraftSignature => JsonSerializer.Serialize(new { model, bindings });
    private EditContext FormContext { get { if (formContext is null) { formContext = new(model); specialErrors = new(formContext); formContext.OnFieldChanged += (_, _) => { specialErrors.Clear(); formContext.NotifyValidationStateChanged(); }; } return formContext; } }
    public static IReadOnlyDictionary<string, ResourceSectionPresentation> DefinitionPresentations(bool readOnly) => new Dictionary<string, ResourceSectionPresentation>
    {
        ["definition/identity"] = new() { ReadOnly = readOnly, HasRequiredFields = true, Fields = [nameof(KnowledgeSourceEditorModel.Name), nameof(KnowledgeSourceEditorModel.DisplayName), nameof(KnowledgeSourceEditorModel.Namespace), nameof(KnowledgeSourceEditorModel.Description), nameof(KnowledgeSourceEditorModel.Tags)] },
        ["definition/configuration"] = new() { ReadOnly = readOnly, Fields = [nameof(KnowledgeSourceEditorModel.Enabled), nameof(KnowledgeSourceEditorModel.OutputStorageKey), nameof(KnowledgeSourceEditorModel.OutputPrefix), nameof(KnowledgeSourceEditorModel.OutputCollectionUid), nameof(KnowledgeSourceEditorModel.ProjectionFlowKey), nameof(KnowledgeSourceEditorModel.RetrievalFlowKey), nameof(KnowledgeSourceEditorModel.AutomaticParameters), nameof(KnowledgeSourceEditorModel.LifecycleEnabled), nameof(KnowledgeSourceEditorModel.ProjectionTtl), nameof(KnowledgeSourceEditorModel.KeepHistory), nameof(KnowledgeSourceEditorModel.HistoryRetention), nameof(KnowledgeSourceEditorModel.AllowExpiredFallback), nameof(KnowledgeSourceEditorModel.Orchestration), nameof(KnowledgeSourceEditorModel.CompositionPoints), nameof(KnowledgeSourceEditorModel.Bindings)] }
    };
    private IReadOnlyDictionary<string, ResourceSectionPresentation> OwnPresentations => DefinitionPresentations(!CanEdit);
    private IReadOnlyDictionary<string,string> FieldLabels => new Dictionary<string,string> { [nameof(model.Name)] = T("SettingName"), [nameof(model.DisplayName)] = T("DisplayName"), [nameof(model.Namespace)] = T("Namespace"), [nameof(model.ProjectionFlowKey)] = T("ProjectionFlow"), [nameof(model.LifecycleEnabled)] = T("LifecycleTitle"), [nameof(model.Description)] = T("SourceDescription") };
    private bool ConfigurationValid => (!model.Enabled || automaticParametersValid) && LifecycleValid && OutputCollectionValid && bindings.All(value => value.ConfigurationValid && !value.TargetsLoadFailed && FallbackValid(value));
    private IReadOnlyList<CreationWizardStep> CreationSteps => [
        new("identity", T("Identity"), IdentityContent) { IsComplete = !string.IsNullOrWhiteSpace(model.Name) && !string.IsNullOrWhiteSpace(model.DisplayName) && model.NamespaceValid },
        new("configuration", T("Configuration"), ConfigurationContent) { IsComplete = ConfigurationValid }];
    private async Task MarkDirty() { specialErrors?.Clear(); touched = true; await DraftChanged.InvokeAsync(true); }
    private async Task InvalidChanged(bool value) { invalidInput = value; if (value) await DraftChanged.InvokeAsync(true); }
    private async Task SetEnabled(bool value) { model.Enabled = value; await MarkDirty(); }
    private Task ShowSection(string path) { if (SectionRequested.HasDelegate) return SectionRequested.InvokeAsync(path); Navigation.NavigateTo(Navigation.Uri.Split('#')[0] + "#" + path); StateHasChanged(); return Task.CompletedTask; }
    private void ValidateSpecialized()
    {
        _ = FormContext; specialErrors!.Clear();
        if (!model.NamespaceValid) specialErrors.Add(FormContext.Field(nameof(model.Namespace)), T("NamespaceInvalid"));
        if (!ConfigurationValid) specialErrors.Add(FormContext.Field(nameof(model.LifecycleEnabled)), T(!LifecycleValid ? "LifecycleInvalid" : !OutputCollectionValid ? "OutputStorageInvalid" : "FallbackInvalid"));
        if (model.Enabled && string.IsNullOrEmpty(model.ProjectionFlowKey)) specialErrors.Add(FormContext.Field(nameof(model.ProjectionFlowKey)), T("SelectProjectionFlow"));
        FormContext.NotifyValidationStateChanged();
    }
    private async Task FinishCreationAsync(CreationWizardFinish finish)
    {
        ValidateSpecialized();
        if (!FormContext.Validate()) { finish.ReturnToStepId = ResourceDefinitionForm.FirstInvalidSection(FormContext, OwnPresentations) == "definition/identity" ? "identity" : "configuration"; validationFocus = true; return; }
        await SaveAsync();
    }
    private void StepReady(string _) { if (validationFocus) { validationFocus = false; form?.RequestValidationFocus(); } }
    private async Task RequestRebindAsync() { rebindRequested = true; await RequestSaveAsync(); }
    private KnowledgeFlowTarget? OriginalFlow(string key, KnowledgeFlowTarget? original) => original is not null && key == TargetKey(original, savedSource!.Namespace) ? original : FlowTarget(key);
    private async Task ObserveSnapshotAsync()
    {
        if (observedDiscard != DiscardRevision) { observedDiscard = DiscardRevision; await DiscardAsync(); return; }
        if (ReferenceEquals(parameterSnapshot, Snapshot)) return;
        parameterSnapshot = Snapshot;
        if (Snapshot is not { } snapshot || snapshot.ETag == observedEtag) return;
        if (savedSource is not null && (snapshot.Value.Uid != savedSource.Uid || snapshot.Value.ScopeRef != savedSource.ScopeRef)) { loadedKey = null; await OnParametersSetAsync(); return; }
        if (HasDraft) { newerSnapshot = snapshot; return; }
        loadedKey = null; await OnParametersSetAsync();
    }
    public async Task ApplyDefinitionAsync(KnowledgeSourceProperties properties, string originalEtag)
    {
        if (!CanEdit || HasDraft || savedSource is null) return;
        Snapshot = new(savedSource with { Definition = properties }, originalEtag);
        loadedKey = null; await OnParametersSetAsync();
        touched = true; await DraftChanged.InvokeAsync(true); await InvokeAsync(StateHasChanged);
    }
    public async Task DiscardAsync() { loadedKey = null; touched = invalidInput = false; newerSnapshot = null; await OnParametersSetAsync(); await DraftChanged.InvokeAsync(false); await InvokeAsync(StateHasChanged); }
    private async Task RefreshAsync()
    {
        if (loading || busy || IsNew) return;
        var revision = loadRevision;
        try
        {
            var snapshot = await ScopedClient.GetAsync(ExistingNamespace, Name!, cancellation.Token);
            if (revision != loadRevision || disposed) return;
            if (savedSource is not null && snapshot.Value.Uid != savedSource.Uid) { ClearPrivate(); message = T("IdentityChanged"); return; }
            if (HasDraft) { if (snapshot.ETag != observedEtag) newerSnapshot = snapshot; return; }
            Snapshot = snapshot; loadedKey = null; await OnParametersSetAsync();
        }
        catch (AgentstrationApiException exception) when (exception.StatusCode is System.Net.HttpStatusCode.Forbidden or System.Net.HttpStatusCode.NotFound) { ClearPrivate(); unavailableStatus = exception.StatusCode == System.Net.HttpStatusCode.NotFound ? ResourceLoadStatus.NotFound : ResourceLoadStatus.Forbidden; message = T("LoadingDetails"); }
        catch (Exception exception) { message = exception.Message; }
    }
    private void ClearPrivate() { loadRevision++; savedSource = null; newerSnapshot = null; model = new(); formContext = null; bindings.Clear(); acquisitionTargets.Clear(); touched = invalidInput = false; baseline = DraftSignature; }
    private string SavedYaml => savedSource is null ? "" : ResourceManifestSerializer.ToYaml(savedSource);
    private IReadOnlyList<KeyValuePair<string,string>> SavedSettings => savedSource is null ? [] : [new(T("ProjectionFlow"), savedSource.Definition.ProjectionFlow?.Name ?? "—"), new(T("NativeLegacyRetrieval"), savedSource.Definition.RetrievalFlow?.Name ?? "—"), new(T("ProjectionInputs"), savedSource.Definition.DataSources.Count.ToString())];
    private readonly CancellationTokenSource cancellation = new();
    private IReadOnlyList<DataSourceResource> dataSources = [];
    private IReadOnlyList<StorageResource> storages = [];
    private IReadOnlyList<StorageTypeResource> storageTypes = [];
    private KnowledgeOutputStorage? savedOutput;
    private static string StorageKey(StorageResource value) => $"{value.Uid}:{value.Generation}:{StorageDigests.Binding(value.Definition)}";
    private StorageResource? SelectedOutputStorage => storages.FirstOrDefault(s => StorageKey(s) == model.OutputStorageKey);
    private bool RequiresOutputCollection => SelectedOutputStorage?.Definition.Type is { } type && storageTypes
        .FirstOrDefault(t => t.Uid == type.TypeUid)?.Definition.Versions
        .FirstOrDefault(v => v.Version == type.Version) is { Documents: not null, Capabilities.Write: false };
    private static bool CompatibleOutputCollection(StorageDocumentCollection c) => c.Enabled && c.Policy.Get && c.Policy.Query && c.Policy.Publish;
    private bool OutputCollectionValid => SelectedOutputStorage is null && savedOutput is not null
        && model.OutputCollectionUid == savedOutput.DocumentCollectionUid.GetValueOrDefault() || (model.OutputCollectionUid == Guid.Empty ? !RequiresOutputCollection
        : SelectedOutputStorage?.Definition.Collections.Any(c => c.Uid == model.OutputCollectionUid && CompatibleOutputCollection(c)) == true);
    private KnowledgeOutputStorage? OutputSelection()
    {
        if (string.IsNullOrEmpty(model.OutputStorageKey)) return null;
        if (savedOutput is not null && model.OutputStorageKey == $"{savedOutput.Storage.StorageUid}:{savedOutput.Storage.Generation}:{savedOutput.Storage.BindingDigest}")
            return savedOutput with { Rule = savedOutput.Rule with { Prefix = model.OutputPrefix }, DocumentCollectionUid = model.OutputCollectionUid == Guid.Empty ? null : model.OutputCollectionUid };
        var selected = storages.Single(value => StorageKey(value) == model.OutputStorageKey);
        return new(new(new(selected.ScopeRef!.Value, selected.Namespace, selected.Kind, selected.Name), selected.Uid,
            selected.Generation, StorageDigests.Binding(selected.Definition)), new(Write: true, Prefix: model.OutputPrefix)) { DocumentCollectionUid = model.OutputCollectionUid == Guid.Empty ? null : model.OutputCollectionUid };
    }
    private readonly Dictionary<string, IReadOnlyList<DataSourceAcquisitionTargetView>> acquisitionTargets = new(StringComparer.Ordinal);
    private IReadOnlyList<FlowOption> projectionFlows = [], retrievalFlows = [], transformationFlows = [];
    private List<KnowledgeSourceBindingModel> bindings => model.Bindings;
    private ResourceScopeRef? ownerScope;
    private string? etag, message;
    private bool automaticParametersValid = true;
    private static readonly FlowCallReference TransformationSequence = new("content-transformation-sequence-builtin", FlowCallVersionStrategy.Exact, "1.0.0", ScopeRef: ResourceScopeRef.Instance);
    private JsonElement? AutomaticParametersSchema => JsonSchemaInputSchema.ObjectProperty(projectionFlows.FirstOrDefault(value => value.Key == model.ProjectionFlowKey)?.InputSchema, "parameters");
    private bool busy, interactive, rebindDependencies, rebindRequested, confirmRebind, loading = true;
    private bool HasNativeDatasetInput => bindings.Any(binding => dataSources.Any(source => source.Definition.Dataset is not null && DataSourceKey(source) == binding.DataSourceKey));
    private bool IsNew => string.IsNullOrWhiteSpace(Name);
    private ResourceNamespace ExistingNamespace => ResourceNamespace.Parse(Namespace);
    private string DetailsUrl => ResourceOwnershipContext.Resource(Services, "/knowledge-sources", Name!, ExistingNamespace, ownerScope);
    private string T(string key, params object[] arguments) => Localizer[key, arguments];

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (destination is { } url) { destination = null; Navigation.NavigateTo(url); }
        if (firstRender) { interactive = true; StateHasChanged(); }
        return Task.CompletedTask;
    }

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Name}|{Namespace}|{ScopeRef}|{Navigation.Uri.Split('#')[0]}";
        if (loadedKey == key) { await ObserveSnapshotAsync(); return; }
        loadedKey = key; unavailableStatus = null; var revision = ++loadRevision;
        model = new(); formContext = null; invalidInput = touched = false; savedSource = null; bindings.Clear(); acquisitionTargets.Clear();
        loading = true;
        message = null;
        try
        {
            var dataSourcesTask = DataSources.GetAsync(cancellation.Token);
            var flowsTask = LoadFlowsAsync(revision);
            await Task.WhenAll(dataSourcesTask, flowsTask);
            if (revision != loadRevision || disposed) return;
            dataSources = await dataSourcesTask;
            if (Services.GetService(typeof(IStoragesClient)) is IStoragesClient storageClient
                && ResourceOwnershipContext.TryGetCurrent(Services) is { } owner)
            {
                var storagesTask = storageClient.GetStoragesAsync(owner, cancellation.Token);
                var typesTask = storageClient.GetTypesAsync(owner, cancellation.Token);
                await Task.WhenAll(storagesTask, typesTask);
                if (revision != loadRevision || disposed) return;
                storages = await storagesTask; storageTypes = await typesTask;
            }
            if (!IsNew)
            {
                var snapshot = Snapshot ?? await ScopedClient.GetAsync(ExistingNamespace, Name!, cancellation.Token);
                if (revision != loadRevision || disposed) return;
                savedSource = snapshot.Value; observedEtag = snapshot.ETag; parameterSnapshot = Snapshot;
                ownerScope = snapshot.Value.ScopeRef;
                etag = snapshot.ETag;
                model.Name = snapshot.Value.Name; model.Namespace = snapshot.Value.Namespace.Value; model.Tags = string.Join(Environment.NewLine, snapshot.Value.Metadata.Tags.Select(pair => $"{pair.Key}={pair.Value}"));
                model.DisplayName = snapshot.Value.Definition.DisplayName;
                model.Description = snapshot.Value.Definition.Description ?? string.Empty;
                model.Enabled = snapshot.Value.Definition.Enabled;
                model.LifecycleEnabled = snapshot.Value.Definition.Lifecycle is not null;
                model.ProjectionTtl = LifecycleDuration.Format(snapshot.Value.Definition.Lifecycle?.TimeToLive);
                model.KeepHistory = snapshot.Value.Definition.Lifecycle?.KeepHistory == true;
                model.HistoryRetention = LifecycleDuration.Format(snapshot.Value.Definition.Lifecycle?.HistoryRetention);
                model.AllowExpiredFallback = snapshot.Value.Definition.Lifecycle?.AllowExpiredOnRefreshFailure == true;
                model.Orchestration = snapshot.Value.Definition.Orchestration;
                model.CompositionPoints = snapshot.Value.Definition.Compositions.ToDictionary(pair => pair.Key, pair => pair.Value, StringComparer.Ordinal);
                if (snapshot.Value.Definition.Transformations.Count > 0) model.CompositionPoints = new Dictionary<string, IReadOnlyList<FlowCompositionCall>>(model.CompositionPoints) { ["postAggregate"] = snapshot.Value.Definition.Transformations };
                model.AutomaticParameters = snapshot.Value.Definition.ProjectionParameters.Clone();
                savedOutput = snapshot.Value.Definition.Output;
                model.OutputCollectionUid = savedOutput?.DocumentCollectionUid ?? Guid.Empty;
                model.OutputStorageKey = savedOutput is null ? string.Empty : $"{savedOutput.Storage.StorageUid}:{savedOutput.Storage.Generation}:{savedOutput.Storage.BindingDigest}";
                model.OutputPrefix = savedOutput?.Rule.Prefix ?? string.Empty;
                model.ProjectionFlowKey = TargetKey(snapshot.Value.Definition.ProjectionFlow, snapshot.Value.Namespace);
                model.RetrievalFlowKey = TargetKey(snapshot.Value.Definition.RetrievalFlow, snapshot.Value.Namespace);
                bindings.Clear();
                bindings.AddRange(snapshot.Value.Definition.DataSources.Select(value => KnowledgeSourceBindingModel.From(
                    value, snapshot.Value.Namespace, TargetKey(value.TransformationFlow, snapshot.Value.Namespace))));
                foreach (var binding in bindings) await LoadTargetsAsync(binding);
            }
            else
            {
                model.ProjectionFlowKey = projectionFlows.FirstOrDefault(value => value.Name == "knowledge-projection-builtin")?.Key ?? string.Empty;
                model.RetrievalFlowKey = string.Empty;
                ownerScope = ResourceOwnershipContext.TryGetCurrent(Services);
                AddBinding();
            }
        }
        catch (Exception exception) { if (revision == loadRevision) { ClearPrivate(); loading = false; message = exception.Message; } }
        finally { if (revision == loadRevision && !disposed) { loading = false; baseline = DraftSignature; } }
    }

    private Task RequestSaveAsync()
    {
        if (!CanEdit) return Task.CompletedTask;
        if (!rebindRequested) return SaveAsync();
        rebindRequested = false;
        if (!busy && interactive && (!model.Enabled || automaticParametersValid)
            && LifecycleValid && !bindings.Any(value => !value.ConfigurationValid || value.TargetsLoadFailed || !FallbackValid(value))) confirmRebind = true;
        return Task.CompletedTask;
    }

    private async Task ConfirmRebindAsync()
    {
        confirmRebind = false;
        rebindDependencies = true;
        try { await SaveAsync(); }
        finally { rebindDependencies = false; }
    }

    private bool LifecycleValid => model.LifecycleValid;
    private bool HasInputLifecycle(KnowledgeSourceBindingModel binding) => dataSources.Any(source => DataSourceKey(source) == binding.DataSourceKey && source.Definition.Dataset?.Lifecycle is not null);
    private bool IsDirectBinding(KnowledgeSourceBindingModel binding) => dataSources.Any(source => DataSourceKey(source) == binding.DataSourceKey && source.Definition.Dataset is { Storage: null });
    private static bool FallbackValid(KnowledgeSourceBindingModel binding) => !binding.AllowStaleOnRefreshFailure
        || LifecycleDuration.TryParse(binding.MaximumFallbackAgeText, out var maximum) && maximum is not null;
    private async Task SaveAsync()
    {
        ValidateSpecialized();
        if (!FormContext.Validate()) { await form!.RevealValidationAsync(); return; }
        if (!CanEdit || busy || !interactive || !LifecycleValid || !OutputCollectionValid || (model.Enabled && !automaticParametersValid) || bindings.Any(value => !value.ConfigurationValid || value.TargetsLoadFailed || !FallbackValid(value))) return;
        var revision = loadRevision;
        busy = true;
        message = null;
        try
        {
            var properties = new KnowledgeSourceProperties
            {
                DisplayName = model.DisplayName.Trim(),
                Description = string.IsNullOrWhiteSpace(model.Description) ? null : model.Description.Trim(),
                Enabled = model.Enabled,
                DataSources = bindings.Select(ToBinding).ToArray(),
                ProjectionFlow = OriginalFlow(model.ProjectionFlowKey, savedSource?.Definition.ProjectionFlow),
                ProjectionParameters = model.AutomaticParameters.Clone(),
                RetrievalFlow = OriginalFlow(model.RetrievalFlowKey, savedSource?.Definition.RetrievalFlow),
                Lifecycle = model.LifecycleSelection(), Orchestration = model.Orchestration, Compositions = model.CompositionPoints,
                Output = OutputSelection()
            };
            var saved = IsNew
                ? await ScopedClient.CreateAsync(new CreateKnowledgeSourceRequest(model.Name.Trim(), properties, model.Namespace.Trim()), cancellation.Token)
                : await ScopedClient.UpdateAsync(ExistingNamespace, Name!, new PutKnowledgeSourceRequest(properties, rebindDependencies), etag!, cancellation.Token);
            if (disposed || revision != loadRevision) return;
            savedSource = saved.Value; etag = observedEtag = saved.ETag; baseline = DraftSignature; touched = invalidInput = false; newerSnapshot = null;
            await DraftChanged.InvokeAsync(false);
            if (Embedded)
            {
                etag = saved.ETag;
                rebindDependencies = false;
                await Saved.InvokeAsync(saved.Value);
            }
            else
            {
                destination = ResourceOwnershipContext.Resource(Services, "/knowledge-sources", saved.Value.Name, saved.Value.Namespace, saved.Value.ScopeRef!.Value);
            }
        }
        catch (Exception) when (disposed || revision != loadRevision) { }
        catch (AgentstrationApiException exception) when (exception.StatusCode is System.Net.HttpStatusCode.Forbidden or System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.NotFound)
        { ClearPrivate(); unavailableStatus = exception.StatusCode == System.Net.HttpStatusCode.NotFound ? ResourceLoadStatus.NotFound : ResourceLoadStatus.Forbidden; message = T("LoadingDetails"); await ResourceUnavailable.InvokeAsync(exception); }
        catch (AgentstrationApiException exception) when (exception.ProblemType?.EndsWith("/knowledge_source_fallback_invalid", StringComparison.Ordinal) == true)
        { message = T("FallbackInvalid"); }
        catch (AgentstrationApiException exception) when (exception.ProblemType?.EndsWith("/knowledge_source_lifecycle_invalid", StringComparison.Ordinal) == true)
        { message = T("LifecycleInvalid"); }
        catch (AgentstrationApiException exception) when (exception.ProblemType?.Contains("/storage_", StringComparison.Ordinal) == true
            || exception.ProblemType?.Contains("/knowledge_output_", StringComparison.Ordinal) == true)
        { message = T("OutputStorageInvalid"); }
        catch (AgentstrationApiException exception) when (exception.ProblemType == "https://agentstration.dev/problems/knowledge_projection_dataset_input_unsupported")
        {
            message = T("NativeDatasetProjectionUnavailable");
        }
        catch (ArgumentException exception) when (exception.Message == "MaximumAgeFormat") { message = T("MaximumAgeFormat"); }
        catch (System.Text.Json.JsonException exception)
        {
            message = T("InvalidSourceConfigurationJson", exception.LineNumber ?? 0, exception.BytePositionInLine ?? 0);
        }
        catch (Exception exception) { message = exception.Message; }
        finally { busy = false; }
    }

    private async Task LoadFlowsAsync(long revision)
    {
        var summaries = await Flows.GetFlowsAsync(cancellation.Token);
        var details = await Task.WhenAll(summaries.Select(value => Flows.GetFlowAsync(value.Namespace, value.Id, value.ScopeRef, cancellation.Token)));
        var active = details.Where(value => value.Enabled && value.ActiveVersion is not null && value.ScopeRef is not null).ToArray();
        var versions = await Task.WhenAll(active.Select(async value => new
        {
            Flow = value,
            Version = await Flows.GetFlowVersionAsync(value.Namespace, value.Id, value.ActiveVersion!, value.ScopeRef, cancellation.Token)
        }));
        var options = versions.Select(value => new FlowOption(value.Flow.ScopeRef!.Value, value.Flow.Namespace, value.Flow.Id,
            value.Flow.DisplayName ?? value.Flow.Name, value.Version.Version,
            value.Version.Metadata.GetValueOrDefault("flow.contract"), value.Version.Graph?.InputSchema?.Clone())).ToArray();
        if (revision != loadRevision || disposed) return;
        projectionFlows = options.Where(value => value.Contract == KnowledgeFlowContracts.Projection).ToArray();
        retrievalFlows = options.Where(value => value.Contract == KnowledgeFlowContracts.Retrieval).ToArray();
        transformationFlows = options.Where(value => value.Contract == KnowledgeFlowContracts.ArtifactTransformation).ToArray();
    }
    private string? InheritedDescription(KnowledgeSourceBindingModel binding) => dataSources.FirstOrDefault(source => DataSourceKey(source) == binding.DataSourceKey)?.Definition.Description;
    private void AddBinding() => bindings.Add(new() { Name = $"input-{bindings.Count + 1}" });
    private void RemoveBinding(KnowledgeSourceBindingModel binding) => bindings.Remove(binding);
    private KnowledgeDataSourceBinding ToBinding(KnowledgeSourceBindingModel value)
    {
        if (!value.ConfigurationValid || value.Configuration.ValueKind != System.Text.Json.JsonValueKind.Object)
            throw new ArgumentException(T("JsonObjectRequired"));
        var dataSource = value.Original is { } original && value.DataSourceKey == value.OriginalKey ? original.DataSource : DataSourceReference(value.DataSourceKey);
        return new() { Name = value.Name.Trim(), DataSource = dataSource,
            AcquisitionTarget = value.Original is { } originalBinding && value.DataSourceKey == value.OriginalKey && value.AcquisitionTargetName == originalBinding.AcquisitionTarget?.Name ? originalBinding.AcquisitionTarget : string.IsNullOrWhiteSpace(value.AcquisitionTargetName) ? null
                : new(value.AcquisitionTargetName, TargetOptions(value).Single(target => target.Target.Name == value.AcquisitionTargetName).Target.ScopeRef, dataSource.Namespace),
            Transformations = value.Transformations,
            Description = value.Description, TransformationFlow = OriginalFlow(value.TransformationFlowKey, value.Original?.TransformationFlow), Configuration = value.Configuration.Clone(), Required = value.Required,
            MaximumAge = KnowledgeSourceEditorModel.ParseMaximumAge(value.MaximumAgeText), RefreshIfNecessary = value.RefreshIfNecessary,
            AllowStaleOnRefreshFailure = value.AllowStaleOnRefreshFailure, MaximumFallbackAge = value.AllowStaleOnRefreshFailure ? KnowledgeSourceEditorModel.ParseMaximumAge(value.MaximumFallbackAgeText) : null };
    }
    private static string DataSourceKey(DataSourceResource value) => $"{value.ScopeRef!.Value.Value}|{value.Namespace.Value}|{value.Name}";
    private static string DataSourceLabel(DataSourceResource value) => $"{value.Definition.DisplayName} · {value.ScopeRef}";
    private ResourceReference DataSourceReference(string key)
    {
        var parts = key.Split('|', 3);
        if (parts.Length != 3) throw new ArgumentException(T("DataSourceSelectionRequired"));
        return new(parts[2], ResourceScopeRef.Parse(parts[0]), ResourceNamespace.Parse(parts[1]));
    }
    private async Task ChangeDataSourceAsync(KnowledgeSourceBindingModel binding, ChangeEventArgs args)
    { message = null; binding.DataSourceKey = args.Value?.ToString() ?? string.Empty; binding.AcquisitionTargetName = string.Empty; if (IsDirectBinding(binding)) { binding.AllowStaleOnRefreshFailure = false; binding.MaximumFallbackAgeText = string.Empty; } await LoadTargetsAsync(binding); }
    private async Task LoadTargetsAsync(KnowledgeSourceBindingModel binding)
    {
        binding.TargetsLoadFailed = false;
        if (string.IsNullOrWhiteSpace(binding.DataSourceKey) || acquisitionTargets.ContainsKey(binding.DataSourceKey)) return;
        var parts = binding.DataSourceKey.Split('|', 3);
        var revision = loadRevision; var key = binding.DataSourceKey;
        try
        {
            var targets = await DataSources.GetAcquisitionTargetsAsync(
                ResourceNamespace.Parse(parts[1]), parts[2], ResourceScopeRef.Parse(parts[0]), cancellation.Token);
            if (revision == loadRevision && !disposed && binding.DataSourceKey == key) acquisitionTargets[key] = targets;
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            if (revision != loadRevision || disposed || binding.DataSourceKey != key) return;
            binding.TargetsLoadFailed = true;
            message = T("AcquisitionTargetsLoadFailed");
        }
    }
    private IReadOnlyList<DataSourceAcquisitionTargetView> TargetOptions(KnowledgeSourceBindingModel binding) =>
        acquisitionTargets.GetValueOrDefault(binding.DataSourceKey, []);
    private static string FlowKey(FlowOption value) => value.Key;
    private static string FlowLabel(FlowOption value) => $"{value.DisplayName} · {value.ScopeRef} · {value.Namespace}/{value.Name}:{value.Version}";
    private static KnowledgeFlowTarget? FlowTarget(string key)
    {
        var parts = key.Split('|', 4);
        return parts.Length != 4 ? null : new() { ScopeRef = ResourceScopeRef.Parse(parts[0]), Namespace = ResourceNamespace.Parse(parts[1]), Name = parts[2], UseActiveVersion = false, Version = parts[3] };
    }
    private string TargetKey(KnowledgeFlowTarget? target, ResourceNamespace owner)
    {
        if (target is null) return string.Empty;
        var @namespace = target.Namespace ?? owner;
        var version = target.Version ?? "active";
        var exactScope = target.ScopeRef ?? AllFlowOptions()
            .Where(value => value.Namespace == @namespace && value.Name == target.Name && value.Version == version)
            .Select(value => (ResourceScopeRef?)value.ScopeRef)
            .SingleOrDefault();
        return exactScope is null ? string.Empty : $"{exactScope.Value.Value}|{@namespace.Value}|{target.Name}|{version}";
    }
    private JsonElement? TransformationConfigurationSchema(KnowledgeSourceBindingModel value) => JsonSchemaInputSchema.ObjectProperty(
        transformationFlows.FirstOrDefault(flow => flow.Key == value.TransformationFlowKey)?.InputSchema, "configuration");
    private IEnumerable<FlowOption> AllFlowOptions() => projectionFlows.Concat(retrievalFlows).Concat(transformationFlows).Distinct();
    private sealed record FlowOption(ResourceScopeRef ScopeRef, ResourceNamespace Namespace, string Name, string DisplayName,
        string Version, string? Contract, JsonElement? InputSchema)
    {
        public string Key => $"{ScopeRef.Value}|{Namespace.Value}|{Name}|{Version}";
    }
    public void Dispose() { disposed = true; loadRevision++; cancellation.Cancel(); cancellation.Dispose(); }

    private RenderFragment EditorForm(IReadOnlyDictionary<string, ResourceSectionPresentation> presentations) => @<div>
        @if (message is not null) { <div class="form-alert form-alert-danger" role="alert">@message</div> }
        @if (newerSnapshot is not null) { <div class="form-alert form-alert-warning" role="status">@T("RefreshDraftConflict")</div> }
        <ResourceDefinitionForm @ref="form" EditContext="FormContext" Id="knowledge-source-definition" FormName="knowledge-source-editor" FieldLabels="FieldLabels"
            FieldsTestId="knowledge-source-definition-fields" Busy="busy" Disabled="@(!interactive)" ReadOnly="@(!CanEdit)"
            Sections="presentations" SectionState="@(IsNew ? null : SectionState ?? ownSections)" SectionContent="@(IsNew || Embedded && SectionState is null ? null : DefinitionContent)" SectionRequested="ShowSection"
            OnValidSubmit="RequestSaveAsync" InvalidInputChanged="InvalidChanged" @oninput="MarkDirty" @onchange="MarkDirty">
            <ChildContent>@if (!IsNew && Embedded && SectionState is null) { @IdentityContent @ConfigurationContent } @if (IsNew) { <CreationWizard @ref="wizard" Steps="CreationSteps" CanFinish="ConfigurationValid" Disabled="@(!interactive)" Busy="busy" OnFinish="FinishCreationAsync" OnStepReady="StepReady" FinishLabel="@T("Save")" FinishTestId="knowledge-source-save" /> }</ChildContent>
        </ResourceDefinitionForm>
    </div>;
    private RenderFragment IdentityContent => @<ResourceIdentityEditor ResourceKind="@KnowledgeResourceKinds.KnowledgeSource" IsNew="IsNew" NamespaceEditable="IsNew" ReadOnly="@(!CanEdit)"
        @bind-DisplayName="model.DisplayName" @bind-TechnicalName="model.Name" @bind-Namespace="model.Namespace" @bind-Description="model.Description" @bind-Labels="model.Tags" LabelsReadOnly="true"
        ScopeRef="ownerScope" DisplayNameTestId="knowledge-source-display-name" TechnicalNameTestId="knowledge-source-name" NamespaceTestId="knowledge-source-namespace">
        <ScopeContent><ResourceScopeBadge ScopeRef="ownerScope" /></ScopeContent>
    </ResourceIdentityEditor>;
    private RenderFragment ConfigurationContent => @<FormSection Title="@T("Configuration")"><FormGrid>
        @if (IsNew || Embedded && SectionState is null) { <label class="resource-enabled-toggle" data-testid="knowledge-source-editor-enabled-option"><FormCheckbox role="switch" @bind-Value="model.Enabled" /><span>@T("Enabled")</span></label> }
            @if (HasNativeDatasetInput && savedOutput is null && string.IsNullOrEmpty(model.OutputStorageKey)) { <p class="form-alert form-alert-info form-span-2" role="status">@T("NativeDatasetDraftHelp")</p> }
            <FormField Label="@T("OutputStorage")" Help="@T("OutputStorageHelp")" Class="form-span-2"><ClearableSelect TValue="string" Value="@model.OutputStorageKey" ValueExpression="@(() => model.OutputStorageKey)" ValueChanged="value => { model.OutputStorageKey = value; model.OutputCollectionUid = Guid.Empty; }" data-testid="knowledge-output-storage">
                <option value="">@T("ArtifactOutputDefault")</option>
                @foreach (var storage in storages) { <option value="@StorageKey(storage)">@storage.Definition.DisplayName · @storage.ScopeRef</option> }
                @if (savedOutput is not null && !storages.Any(value => StorageKey(value) == model.OutputStorageKey)) { <option value="@model.OutputStorageKey">@T("PinnedOutputStorage")</option> }
            </ClearableSelect></FormField>
            @if (SelectedOutputStorage is { } structuredStorage && (RequiresOutputCollection || structuredStorage.Definition.Collections.Count > 0))
            {
                <FormField Label="@T("StructuredOutputCollection")" Help="@T("StructuredOutputHelp")" Class="form-span-2"><ClearableSelect TValue="Guid" AllowClear="false" @bind-Value="model.OutputCollectionUid" data-testid="knowledge-output-collection"><option value="@Guid.Empty">@T(RequiresOutputCollection ? "StructuredOutputSelect" : "StructuredOutputNone")</option>@foreach (var collection in structuredStorage.Definition.Collections.Where(CompatibleOutputCollection)) { <option value="@collection.Uid">@collection.DisplayName · @collection.Name</option> }</ClearableSelect></FormField>
                @if (!OutputCollectionValid)
                {
                    <p class="form-alert form-alert-warning form-span-2" role="alert" data-testid="knowledge-output-collection-required">@T("StructuredOutputRequired") <a href="@(StorageLinks.Details(structuredStorage) + "#definition/configuration")">@T("ConfigureOutputStorage")</a></p>
                }
            }
            @if (!RequiresOutputCollection && model.OutputCollectionUid == Guid.Empty)
            {
                <FormField Label="@T("OutputPrefix")" Help="@T("OutputPrefixHelp")" Class="form-span-2"><ClearableText UpdateOnInput="false" @bind-Value="model.OutputPrefix" data-testid="knowledge-output-prefix" /></FormField>
            }
            <FormField Label="@T("ProjectionFlow")" Required="true"><ClearableSelect TValue="string" @bind-Value="model.ProjectionFlowKey" required data-testid="knowledge-source-projection-flow"><option value="">@T("SelectProjectionFlow")</option>@foreach (var flow in projectionFlows) { <option value="@FlowKey(flow)">@FlowLabel(flow)</option> }</ClearableSelect></FormField>
            <FormField Label="@T("NativeLegacyRetrieval")" Help="@T("NativeLegacyRetrievalHelp")"><ClearableSelect TValue="string" @bind-Value="model.RetrievalFlowKey" data-testid="knowledge-source-retrieval-flow"><option value="">@T("NativeNoRetrieval")</option>@foreach (var flow in retrievalFlows) { <option value="@FlowKey(flow)">@FlowLabel(flow)</option> }</ClearableSelect></FormField>
            <div class="form-span-2" data-testid="knowledge-automatic-parameters"><span>@T("NativeAutomaticParameters")</span><JsonSchemaInputEditor Schema="AutomaticParametersSchema" Value="model.AutomaticParameters" ValueChanged="value => model.AutomaticParameters = value" ValidationChanged="state => automaticParametersValid = state.IsValid" Disabled="busy" /><small>@T("NativeAutomaticParametersHelp")</small></div>
            <div class="form-span-2"><SourceLifecycleEditor Title="@T("LifecycleTitle")" @bind-Enabled="model.LifecycleEnabled" @bind-TimeToLiveText="model.ProjectionTtl" @bind-KeepHistory="model.KeepHistory" @bind-HistoryRetentionText="model.HistoryRetention" />
                @if (model.LifecycleEnabled) { <label class="resource-enabled-toggle"><FormCheckbox role="switch" @bind-Value="model.AllowExpiredFallback" data-testid="knowledge-expired-fallback" /><span>@T("AllowExpiredFallback")</span></label> }
            </div>
            <div class="form-span-2"><SourceFlowCompositionEditor Boundary="projection" StandardPoint="postAggregate" @bind-Orchestration="model.Orchestration" @bind-Value="model.CompositionPoints" ReadOnly="busy" /></div>
            <section class="form-span-2 panel form-section" data-testid="knowledge-source-data-source-bindings">
                <div class="panel-header"><div><p class="eyebrow">@T("ProjectionInputs")</p><h2>@T("DataSourceBindings")</h2><p>@T("DataSourceBindingsHelp")</p></div><button class="button-secondary" type="button" @onclick="AddBinding">@T("AddDataSource")</button></div>
                @if (bindings.Count == 0) { <p class="muted">@T("NoDataSourceBindings")</p> }
                @foreach (var binding in bindings)
                {
                    <div class="form-grid knowledge-binding-card" data-testid="knowledge-source-binding">
                        <FormField Label="@T("BindingName")"><ClearableText UpdateOnInput="false" @bind-Value="binding.Name" maxlength="128" /></FormField>
                        <FormField Label="@T("ContributionDescription")" Help="@T("ContributionDescriptionHelp")"><ClearableText Multiline @bind-Value="binding.Description" placeholder="@InheritedDescription(binding)" maxlength="2000" rows="2" /></FormField>
                        <FormField Label="@T("DataSource")" Required="true"><ClearableSelect TValue="string" Value="@binding.DataSourceKey" ValueExpression="@(() => binding.DataSourceKey)" ValueChanged="value => ChangeDataSourceAsync(binding, new ChangeEventArgs { Value = value })" required data-testid="knowledge-source-binding-data-source"><option value="">@T("SelectDataSource")</option>@foreach (var dataSource in dataSources) { <option value="@DataSourceKey(dataSource)">@DataSourceLabel(dataSource)</option> }</ClearableSelect></FormField>
                        @if (TargetOptions(binding).Count > 0) { <FormField Label="@T("AcquisitionTarget")" Required="true"><ClearableSelect TValue="string" @bind-Value="binding.AcquisitionTargetName" required data-testid="knowledge-source-binding-acquisition-target"><option value="">@T("SelectAcquisitionTarget")</option>@foreach (var target in TargetOptions(binding).Where(value => value.Target.Enabled && !value.Stale)) { <option value="@target.Target.Name">@target.Target.DisplayName · @target.Target.ChoiceDisplayName</option> }</ClearableSelect></FormField> }
                        <FormField Label="@T("TransformationFlowOptional")"><ClearableSelect TValue="string" @bind-Value="binding.TransformationFlowKey" data-testid="knowledge-source-binding-transformation-flow"><option value="">@T("IdentityTransformation")</option>@foreach (var flow in transformationFlows) { <option value="@FlowKey(flow)">@FlowLabel(flow)</option> }</ClearableSelect></FormField>
                        <div class="form-span-2"><FlowSequenceEditor Title="@T("BindingTransformations")" @bind-Value="binding.Transformations" TemplateFlow="TransformationSequence" ReadOnly="@(busy || !string.IsNullOrEmpty(binding.TransformationFlowKey))" /></div>
                        <label class="resource-enabled-toggle"><FormCheckbox role="switch" @bind-Value="binding.Required" /><span class="knowledge-choice-icon"><UiIcon Name="check" /></span><span><strong>@T("RequiredInput")</strong><small>@T("RequiredInputHelp")</small></span></label>
                        <label class="resource-enabled-toggle"><FormCheckbox role="switch" @bind-Value="binding.AllowStaleOnRefreshFailure" disabled="@IsDirectBinding(binding)" data-testid="knowledge-binding-fallback" /><span>@T("AllowInputFallback")</span></label>
                        @if (binding.AllowStaleOnRefreshFailure) { <FormField Label="@T("InputFallbackAge")" Help="@T("InputFallbackAgeHelp")"><ClearableText UpdateOnInput="false" @bind-Value="binding.MaximumFallbackAgeText" placeholder="hh:mm:ss" data-testid="knowledge-binding-fallback-age" /></FormField> }
                        @if (!FallbackValid(binding)) { <p class="form-alert form-alert-danger" role="alert">@T("FallbackInvalid")</p> }
                        @if (HasInputLifecycle(binding)) { <p class="form-span-2">@T("DataSourceOwnsFreshness")</p> }
                        else
                        {
                        <label class="resource-enabled-toggle"><FormCheckbox role="switch" @bind-Value="binding.RefreshIfNecessary" data-testid="knowledge-binding-refresh" /><span>@T("RefreshIfNecessary")</span></label>
                        <FormField Label="@T("MaximumAge")" Help="@T("MaximumAgeHelp")"><ClearableText UpdateOnInput="false" type="text" inputmode="numeric" placeholder="hh:mm:ss" pattern="[0-9]+:[0-5][0-9]:[0-5][0-9]" title="@T("MaximumAgeFormat")" @bind-Value="binding.MaximumAgeText" data-testid="knowledge-source-binding-maximum-age" /></FormField>
                        }
                        <div class="form-span-2 knowledge-transformation-configuration" data-testid="knowledge-source-transformation-configuration"><span>@T("TransformationConfiguration")</span><JsonSchemaInputEditor Schema="TransformationConfigurationSchema(binding)" Value="binding.Configuration" ValueChanged="value => binding.Configuration = value" ValidationChanged="state => binding.ConfigurationValid = state.IsValid" Disabled="busy" /><small>@T("TransformationConfigurationHelp")</small></div>
                        <FormActions Class="form-span-2"><button class="text-button" type="button" @onclick="() => RemoveBinding(binding)">@T("Remove")</button></FormActions>
                    </div>
                }
            </section>
    </FormGrid>
    @if (!IsNew) { <FormActions><button class="button-secondary" type="button" disabled="@(!ConfigurationValid || !CanEdit || busy || !interactive)" data-testid="knowledge-rebind-dependencies" @onclick="RequestRebindAsync">@T("RebindDependencies")</button><button class="button-primary" type="submit" data-testid="knowledge-source-save" disabled="@(!ConfigurationValid || !CanEdit || busy || !interactive)">@T("Save")</button></FormActions> }
