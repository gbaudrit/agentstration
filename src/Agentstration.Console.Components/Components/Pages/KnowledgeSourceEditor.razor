@page "/knowledge-sources/new"
@page "/knowledge-sources/{Name}/edit"
@implements IDisposable
@inject IKnowledgeSourcesClient Client
@inject IDataSourcesClient DataSources
@inject IFlowApiClient Flows
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<KnowledgeSourcesStrings> Localizer

@if (!Embedded)
{
    <PageTitle>@T(IsNew ? "CreateSource" : "EditSource") · Agentstration</PageTitle>
    <PageHeader Title="@T(IsNew ? "CreateSource" : "EditSource")" Description="@T("ProjectionEditorDescription")" TestId="knowledge-source-editor">
        <Actions><a class="button-secondary" href="@(IsNew ? "/knowledge-sources" : DetailsUrl)">@T("Cancel")</a></Actions>
    </PageHeader>
}

@if (loading) { <LoadingState Message="@T("LoadingDetails")" /> }
else
{
    @if (message is not null) { <div class="form-alert form-alert-danger" role="alert">@message</div> }
    <EditForm Model="this" OnValidSubmit="SaveAsync" class="panel form-section">
        <div class="form-grid">
            <ResourceIdentityFields @bind-DisplayName="displayName" @bind-TechnicalName="technicalName" IsNew="@IsNew" DisplayNameTestId="knowledge-source-display-name" TechnicalNameTestId="knowledge-source-name" />
            @if (IsNew)
            {
                <label><span>@T("Namespace")</span><input @bind="sourceNamespace" maxlength="128" /></label>
            }
            <label class="form-field-wide"><span>@T("SourceDescription")</span><textarea @bind="description" maxlength="2000"></textarea></label>
            <label class="knowledge-choice form-span-2" data-testid="knowledge-source-editor-enabled-option"><input type="checkbox" @bind="enabled" /><span class="knowledge-choice-icon"><UiIcon Name="check" /></span><span><strong>@T("Enabled")</strong><small>@T("ProjectionEnabledHelp")</small></span></label>
            <label><span>@T("ProjectionFlow")</span><select @bind="projectionFlowKey" required data-testid="knowledge-source-projection-flow"><option value="">@T("SelectProjectionFlow")</option>@foreach (var flow in projectionFlows) { <option value="@FlowKey(flow)">@FlowLabel(flow)</option> }</select></label>
            <label><span>@T("RetrievalFlow")</span><select @bind="retrievalFlowKey" required data-testid="knowledge-source-retrieval-flow"><option value="">@T("SelectRetrievalFlow")</option>@foreach (var flow in retrievalFlows) { <option value="@FlowKey(flow)">@FlowLabel(flow)</option> }</select></label>
            <section class="form-span-2 panel form-section" data-testid="knowledge-source-data-source-bindings">
                <div class="panel-header"><div><p class="eyebrow">@T("ProjectionInputs")</p><h2>@T("DataSourceBindings")</h2><p>@T("DataSourceBindingsHelp")</p></div><button class="button-secondary" type="button" @onclick="AddBinding">@T("AddDataSource")</button></div>
                @if (bindings.Count == 0) { <p class="muted">@T("NoDataSourceBindings")</p> }
                @foreach (var binding in bindings)
                {
                    <div class="form-grid knowledge-binding-card" data-testid="knowledge-source-binding">
                        <label><span>@T("BindingName")</span><input @bind="binding.Name" maxlength="128" /></label>
                        <label><span>@T("DataSource")</span><select value="@binding.DataSourceKey" @onchange="args => ChangeDataSourceAsync(binding, args)" required data-testid="knowledge-source-binding-data-source"><option value="">@T("SelectDataSource")</option>@foreach (var dataSource in dataSources) { <option value="@DataSourceKey(dataSource)">@DataSourceLabel(dataSource)</option> }</select></label>
                        @if (TargetOptions(binding).Count > 0) { <label><span>@T("AcquisitionTarget")</span><select @bind="binding.AcquisitionTargetName" required data-testid="knowledge-source-binding-acquisition-target"><option value="">@T("SelectAcquisitionTarget")</option>@foreach (var target in TargetOptions(binding).Where(value => value.Target.Enabled && !value.Stale)) { <option value="@target.Target.Name">@target.Target.DisplayName · @target.Target.ChoiceDisplayName</option> }</select></label> }
                        <label><span>@T("TransformationFlowOptional")</span><select @bind="binding.TransformationFlowKey" data-testid="knowledge-source-binding-transformation-flow"><option value="">@T("IdentityTransformation")</option>@foreach (var flow in transformationFlows) { <option value="@FlowKey(flow)">@FlowLabel(flow)</option> }</select></label>
                        <label class="knowledge-choice"><input type="checkbox" @bind="binding.Required" /><span class="knowledge-choice-icon"><UiIcon Name="check" /></span><span><strong>@T("RequiredInput")</strong><small>@T("RequiredInputHelp")</small></span></label>
                        <label><span>@T("MaximumAge")</span><input type="text" inputmode="numeric" placeholder="hh:mm:ss" pattern="[0-9]+:[0-5][0-9]:[0-5][0-9]" title="@T("MaximumAgeFormat")" @bind="binding.MaximumAgeText" data-testid="knowledge-source-binding-maximum-age" /><small>@T("MaximumAgeHelp")</small></label>
                        <div class="form-span-2 knowledge-transformation-configuration" data-testid="knowledge-source-transformation-configuration"><span>@T("TransformationConfiguration")</span><JsonSchemaInputEditor Schema="TransformationConfigurationSchema(binding)" Value="binding.Configuration" ValueChanged="value => binding.Configuration = value" ValidationChanged="state => binding.ConfigurationValid = state.IsValid" Disabled="busy" /><small>@T("TransformationConfigurationHelp")</small></div>
                        <div class="form-actions form-span-2"><button class="text-button" type="button" @onclick="() => RemoveBinding(binding)">@T("Remove")</button></div>
                    </div>
                }
            </section>
        </div>
        <div class="form-actions"><button class="button-primary" type="submit" data-testid="knowledge-source-save" disabled="@(busy || bindings.Any(value => !value.ConfigurationValid))">@(busy ? T("Saving") : T("Save"))</button></div>
    </EditForm>
}

@code {
    [Parameter] public string? Name { get; set; }
    [SupplyParameterFromQuery(Name = "namespace")] public string? Namespace { get; set; }
    [Parameter] public bool Embedded { get; set; }
    [Parameter] public EventCallback<KnowledgeSourceResource> Saved { get; set; }
    private readonly CancellationTokenSource cancellation = new();
    private IReadOnlyList<DataSourceResource> dataSources = [];
    private readonly Dictionary<string, IReadOnlyList<DataSourceAcquisitionTargetView>> acquisitionTargets = new(StringComparer.Ordinal);
    private IReadOnlyList<FlowOption> projectionFlows = [], retrievalFlows = [], transformationFlows = [];
    private readonly List<BindingModel> bindings = [];
    private string technicalName = string.Empty, sourceNamespace = "default", displayName = string.Empty,
        description = string.Empty, projectionFlowKey = string.Empty, retrievalFlowKey = string.Empty;
    private string? etag, message;
    private bool enabled, busy, loading = true;
    private bool IsNew => string.IsNullOrWhiteSpace(Name);
    private ResourceNamespace ExistingNamespace => ResourceNamespace.Parse(Namespace);
    private string DetailsUrl => ExistingNamespace.IsDefault ? $"/knowledge-sources/{Uri.EscapeDataString(Name!)}" : $"/knowledge-sources/{Uri.EscapeDataString(Name!)}?namespace={Uri.EscapeDataString(ExistingNamespace.Value)}";
    private string T(string key, params object[] arguments) => Localizer[key, arguments];

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        message = null;
        try
        {
            var dataSourcesTask = DataSources.GetAsync(cancellation.Token);
            var flowsTask = LoadFlowsAsync();
            await Task.WhenAll(dataSourcesTask, flowsTask);
            dataSources = await dataSourcesTask;
            if (!IsNew)
            {
                var snapshot = await Client.GetAsync(ExistingNamespace, Name!, cancellation.Token);
                etag = snapshot.ETag;
                technicalName = snapshot.Value.Name;
                displayName = snapshot.Value.Definition.DisplayName;
                description = snapshot.Value.Definition.Description ?? string.Empty;
                enabled = snapshot.Value.Definition.Enabled;
                projectionFlowKey = TargetKey(snapshot.Value.Definition.ProjectionFlow, snapshot.Value.Namespace);
                retrievalFlowKey = TargetKey(snapshot.Value.Definition.RetrievalFlow, snapshot.Value.Namespace);
                bindings.Clear();
                bindings.AddRange(snapshot.Value.Definition.DataSources.Select(value => BindingModel.From(
                    value, snapshot.Value.Namespace, TargetKey(value.TransformationFlow, snapshot.Value.Namespace))));
                foreach (var binding in bindings) await LoadTargetsAsync(binding);
            }
            else
            {
                projectionFlowKey = projectionFlows.FirstOrDefault(value => value.Name == "knowledge-projection-builtin")?.Key ?? string.Empty;
                retrievalFlowKey = retrievalFlows.FirstOrDefault(value => value.Name == "knowledge-retrieval-builtin")?.Key ?? string.Empty;
                AddBinding();
            }
        }
        catch (Exception exception) { message = exception.Message; }
        finally { loading = false; }
    }

    private async Task SaveAsync()
    {
        if (busy) return;
        busy = true;
        message = null;
        try
        {
            var properties = new KnowledgeSourceProperties
            {
                DisplayName = displayName.Trim(),
                Description = string.IsNullOrWhiteSpace(description) ? null : description.Trim(),
                Enabled = enabled,
                DataSources = bindings.Select(ToBinding).ToArray(),
                ProjectionFlow = FlowTarget(projectionFlowKey),
                RetrievalFlow = FlowTarget(retrievalFlowKey)
            };
            var saved = IsNew
                ? await Client.CreateAsync(new CreateKnowledgeSourceRequest(technicalName.Trim(), properties, sourceNamespace.Trim()), cancellation.Token)
                : await Client.UpdateAsync(ExistingNamespace, Name!, new PutKnowledgeSourceRequest(properties), etag!, cancellation.Token);
            if (Embedded)
            {
                etag = saved.ETag;
                await Saved.InvokeAsync(saved.Value);
            }
            else
            {
                var ns = saved.Value.Namespace;
                Navigation.NavigateTo(ns.IsDefault ? $"/knowledge-sources/{Uri.EscapeDataString(saved.Value.Name)}" : $"/knowledge-sources/{Uri.EscapeDataString(saved.Value.Name)}?namespace={Uri.EscapeDataString(ns.Value)}");
            }
        }
        catch (System.Text.Json.JsonException exception)
        {
            message = T("InvalidSourceConfigurationJson", exception.LineNumber ?? 0, exception.BytePositionInLine ?? 0);
        }
        catch (Exception exception) { message = exception.Message; }
        finally { busy = false; }
    }

    private async Task LoadFlowsAsync()
    {
        var summaries = await Flows.GetFlowsAsync(cancellation.Token);
        var details = await Task.WhenAll(summaries.Select(value => Flows.GetFlowAsync(value.Namespace, value.Id, value.ScopeRef, cancellation.Token)));
        var active = details.Where(value => value.Enabled && value.ActiveVersion is not null && value.ScopeRef is not null).ToArray();
        var versions = await Task.WhenAll(active.Select(async value => new
        {
            Flow = value,
            Version = await Flows.GetFlowVersionAsync(value.Namespace, value.Id, value.ActiveVersion!, value.ScopeRef, cancellation.Token)
        }));
        var options = versions.Select(value => new FlowOption(value.Flow.ScopeRef!.Value, value.Flow.Namespace, value.Flow.Id,
            value.Flow.DisplayName ?? value.Flow.Name, value.Version.Version,
            value.Version.Metadata.GetValueOrDefault("flow.contract"), value.Version.Graph?.InputSchema?.Clone())).ToArray();
        projectionFlows = options.Where(value => value.Contract == KnowledgeFlowContracts.Projection).ToArray();
        retrievalFlows = options.Where(value => value.Contract == KnowledgeFlowContracts.Retrieval).ToArray();
        transformationFlows = options.Where(value => value.Contract == KnowledgeFlowContracts.ArtifactTransformation).ToArray();
    }
    private void AddBinding() => bindings.Add(new() { Name = $"input-{bindings.Count + 1}" });
    private void RemoveBinding(BindingModel binding) => bindings.Remove(binding);
    private KnowledgeDataSourceBinding ToBinding(BindingModel value)
    {
        if (!value.ConfigurationValid || value.Configuration.ValueKind != System.Text.Json.JsonValueKind.Object)
            throw new ArgumentException(T("JsonObjectRequired"));
        var dataSource = DataSourceReference(value.DataSourceKey);
        return new() { Name = value.Name.Trim(), DataSource = dataSource,
            AcquisitionTarget = string.IsNullOrWhiteSpace(value.AcquisitionTargetName) ? null
                : new(value.AcquisitionTargetName, TargetOptions(value).Single(target => target.Target.Name == value.AcquisitionTargetName).Target.ScopeRef, dataSource.Namespace),
            TransformationFlow = FlowTarget(value.TransformationFlowKey), Configuration = value.Configuration.Clone(), Required = value.Required,
            MaximumAge = ParseMaximumAge(value.MaximumAgeText) };
    }
    private TimeSpan? ParseMaximumAge(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        var parts = value.Split(':');
        if (parts.Length != 3
            || !long.TryParse(parts[0], System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var hours)
            || !int.TryParse(parts[1], System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var minutes)
            || !int.TryParse(parts[2], System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var seconds)
            || hours < 0 || minutes is < 0 or > 59 || seconds is < 0 or > 59
            || hours > (long)TimeSpan.MaxValue.TotalHours)
            throw new ArgumentException(T("MaximumAgeFormat"));
        try
        {
            return new TimeSpan(checked(hours * TimeSpan.TicksPerHour
                + minutes * TimeSpan.TicksPerMinute
                + seconds * TimeSpan.TicksPerSecond));
        }
        catch (OverflowException exception)
        {
            throw new ArgumentException(T("MaximumAgeFormat"), exception);
        }
    }
    private static string FormatMaximumAge(TimeSpan? value) => value is null
        ? string.Empty
        : $"{(long)value.Value.TotalHours:00}:{value.Value.Minutes:00}:{value.Value.Seconds:00}";
    private static string DataSourceKey(DataSourceResource value) => $"{value.ScopeRef!.Value.Value}|{value.Namespace.Value}|{value.Name}";
    private static string DataSourceLabel(DataSourceResource value) => $"{value.Definition.DisplayName} · {value.ScopeRef}";
    private ResourceReference DataSourceReference(string key)
    {
        var parts = key.Split('|', 3);
        if (parts.Length != 3) throw new ArgumentException(T("DataSourceSelectionRequired"));
        return new(parts[2], ResourceScopeRef.Parse(parts[0]), ResourceNamespace.Parse(parts[1]));
    }
    private async Task ChangeDataSourceAsync(BindingModel binding, ChangeEventArgs args)
    { binding.DataSourceKey = args.Value?.ToString() ?? string.Empty; binding.AcquisitionTargetName = string.Empty; await LoadTargetsAsync(binding); }
    private async Task LoadTargetsAsync(BindingModel binding)
    {
        if (string.IsNullOrWhiteSpace(binding.DataSourceKey) || acquisitionTargets.ContainsKey(binding.DataSourceKey)) return;
        var parts = binding.DataSourceKey.Split('|', 3);
        acquisitionTargets[binding.DataSourceKey] = await DataSources.GetAcquisitionTargetsAsync(
            ResourceNamespace.Parse(parts[1]), parts[2], ResourceScopeRef.Parse(parts[0]), cancellation.Token);
    }
    private IReadOnlyList<DataSourceAcquisitionTargetView> TargetOptions(BindingModel binding) =>
        acquisitionTargets.GetValueOrDefault(binding.DataSourceKey, []);
    private static string FlowKey(FlowOption value) => value.Key;
    private static string FlowLabel(FlowOption value) => $"{value.DisplayName} · {value.ScopeRef} · {value.Namespace}/{value.Name}:{value.Version}";
    private static KnowledgeFlowTarget? FlowTarget(string key)
    {
        var parts = key.Split('|', 4);
        return parts.Length != 4 ? null : new() { ScopeRef = ResourceScopeRef.Parse(parts[0]), Namespace = ResourceNamespace.Parse(parts[1]), Name = parts[2], UseActiveVersion = false, Version = parts[3] };
    }
    private string TargetKey(KnowledgeFlowTarget? target, ResourceNamespace owner)
    {
        if (target is null) return string.Empty;
        var @namespace = target.Namespace ?? owner;
        var version = target.Version ?? "active";
        var exactScope = target.ScopeRef ?? AllFlowOptions()
            .Where(value => value.Namespace == @namespace && value.Name == target.Name && value.Version == version)
            .Select(value => (ResourceScopeRef?)value.ScopeRef)
            .SingleOrDefault();
        return exactScope is null ? string.Empty : $"{exactScope.Value.Value}|{@namespace.Value}|{target.Name}|{version}";
    }
    private JsonElement? TransformationConfigurationSchema(BindingModel value) => JsonSchemaInputSchema.ObjectProperty(
        transformationFlows.FirstOrDefault(flow => flow.Key == value.TransformationFlowKey)?.InputSchema, "configuration");
    private IEnumerable<FlowOption> AllFlowOptions() => projectionFlows.Concat(retrievalFlows).Concat(transformationFlows).Distinct();
    private sealed record FlowOption(ResourceScopeRef ScopeRef, ResourceNamespace Namespace, string Name, string DisplayName,
        string Version, string? Contract, JsonElement? InputSchema)
    {
        public string Key => $"{ScopeRef.Value}|{Namespace.Value}|{Name}|{Version}";
    }
    private sealed class BindingModel
    {
        public string Name { get; set; } = string.Empty;
        public string DataSourceKey { get; set; } = string.Empty;
        public string AcquisitionTargetName { get; set; } = string.Empty;
        public string TransformationFlowKey { get; set; } = string.Empty;
        public JsonElement Configuration { get; set; } = JsonSerializer.SerializeToElement(new { });
        public bool ConfigurationValid { get; set; } = true;
        public bool Required { get; set; } = true;
        public string MaximumAgeText { get; set; } = string.Empty;
        public static BindingModel From(KnowledgeDataSourceBinding value, ResourceNamespace owner, string transformationFlowKey) => new()
        {
            Name = value.Name,
            DataSourceKey = value.DataSource.ScopeRef is null ? string.Empty
                : $"{value.DataSource.ScopeRef.Value.Value}|{(value.DataSource.Namespace ?? owner).Value}|{value.DataSource.Name}",
            AcquisitionTargetName = value.AcquisitionTarget?.Name ?? string.Empty,
            TransformationFlowKey = transformationFlowKey,
            Configuration = value.Configuration.Clone(),
            Required = value.Required,
            MaximumAgeText = FormatMaximumAge(value.MaximumAge)
        };
    }
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
