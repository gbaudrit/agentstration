@inject IServiceProvider Services
@page "/modelproviders"
@implements IDisposable
@inject IModelProvidersClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<ModelProvidersStrings> Localizer

<PageTitle>@T("Title") · Agentstration</PageTitle>
<PageHeader Title="@T("Title")" Description="@T("Description")" TestId="resource-model-providers">
    <Actions><button class="button-secondary" @onclick="LoadAsync" disabled="@loading">@T("Refresh")</button><a class="button-primary" href="/modelproviders/new">@T("CreateProvider")</a></Actions>
</PageHeader>

@if (loading && providers is null)
{
    <LoadingState Message="@T("Loading")" />
}
else if (error is not null)
{
    <ErrorState Message="@error.Message" ErrorId="@error.ErrorId"><button class="button-secondary" @onclick="LoadAsync">@T("Retry")</button></ErrorState>
}
else if (providers?.Count == 0)
{
    <EmptyState Title="@T("EmptyTitle")" Message="@T("EmptyMessage")" />
}
else
{
    <CollectionView TItem="ModelProviderResponse" Items="providers ?? []" InformationLabels="@(new string[] { T("Type"), T("Management"), T("Models") })" >
        <Identity Context="provider"><CollectionIdentity DisplayName="@provider.Properties.DisplayName" Namespace="@provider.Namespace" Name="@provider.Name" Href="@DetailsUrl(provider)" IconName="server" Domain="model" /></Identity>
        <Scope Context="provider"><ResourceScopeBadge ScopeRef="provider.ScopeRef" ShowName /></Scope>
        <State Context="provider"><StatusBadge Text="@StatusLabel(provider.Properties.Status)" Status="@ModelManagementUi.Status(provider.Properties.Status)" /></State>
        <Information Context="provider">
            <CollectionValue Label="@T("Type")">@provider.Properties.ContributionId</CollectionValue>
            <CollectionValue Label="@T("Management")">@provider.Properties.RegistrationSource</CollectionValue>
            <CollectionValue Label="@T("Models")">@ModelCount(provider.Properties.ModelCount)</CollectionValue>
        </Information>
        <Actions Context="provider"><CollectionActions ResourceName="@($"{provider.Properties.DisplayName} ({provider.Namespace}/{provider.Name}, {provider.ScopeRef})")"><a href="@DetailsUrl(provider)">@T("ViewDetails")</a></CollectionActions></Actions>
    </CollectionView>
}

@code {
    private readonly CancellationTokenSource cancellation = new();
    private IReadOnlyList<ModelProviderResponse>? providers;
    private AgentstrationApiException? error;
    private bool loading;
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string ModelCount(int count) => T(count == 1 ? "ModelCount.One" : "ModelCount.Many", count);
    private string StatusLabel(string? status) => Localizer[$"Status.{status?.ToLowerInvariant() switch { "available" => "Available", "starting" => "Starting", "unavailable" => "Unavailable", "failed" => "Failed", _ => "Unknown" }}"];
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        loading = true; error = null;
        try { providers = await Client.GetModelProvidersAsync(cancellation.Token); }
        catch (AgentstrationApiException exception) { error = exception; }
        finally { loading = false; }
    }
    private string DetailsUrl(ModelProviderResponse provider) => ResourceOwnershipContext.Resource(Services, "/modelproviders", provider.Name, ResourceNamespace.Parse(provider.Namespace), provider.ScopeRef);
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
