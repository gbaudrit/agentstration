        <OverviewConfiguration>@SavedConfiguration</OverviewConfiguration>
        <DefinitionContent Context="path">@definition</DefinitionContent>
        <AdditionalContent Context="path">@if (path == "usages") { @Usages } else if (path == "resolution") { @Resolution }</AdditionalContent>
        <DraftActions><button class="button-secondary" type="button" disabled="@Busy" @onclick="Discard">@Shared["Discard"]</button><button class="button-primary" type="submit" form="model-profile-resource-form" disabled="@(Busy || !CanManage)" data-testid="model-profile-save">@(saving ? T("Saving") : T("SaveChanges"))</button></DraftActions>
    </ConsoleResourceDetailsTemplate>
}
