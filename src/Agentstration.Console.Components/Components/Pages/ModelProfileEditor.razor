            Sections="presentations" SectionState="@(IsNew ? null : sectionState)" SectionContent="@(IsNew ? null : DefinitionSection)" SectionRequested="ShowSection"
            OnValidSubmit="SaveAsync" OnInvalidSubmit="InvalidSubmitAsync" InvalidInputChanged="value => invalidInput = value" ReadOnly="@(!CanManage)" Busy="saving"
            FieldsTestId="model-profile-definition-fields" data-testid="model-profile-form" data-interactive="@interactive.ToString().ToLowerInvariant()" data-resource-etag="@etag" @oninput="MarkDirty" @onchange="MarkDirty">
