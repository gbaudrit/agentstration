                    {
                        <li class="model-profile-usage-card" data-testid="model-profile-usage">
                            <CollectionIdentity DisplayName="@usage.DisplayName" Namespace="@usage.Namespace" Name="@usage.Name" Href="@AgentUrl(usage)" IconName="agent" Domain="agent">
                                <IconBadges><ResourceScopeBadge ScopeRef="usage.ScopeRef" DisplayName="@usage.ScopeDisplayName" IconOnly /><ManagedResourceBadge IsManaged="@usage.IsManaged" IconOnly /></IconBadges>
                            </CollectionIdentity>
                        </li>
                    }
                </ul>
            }
            <CollectionPager Page="@((usageLoading || usageError is not null ? usageDisplayPage : usagePage) + 1)" Total="usageTotal" HasMore="@(usageNextCursor is not null)" Busy="@(usageLoading || usageError is not null)" PageChanged="UsagePageChanged" />
        </section>;

    private RenderFragment Resolution => @<div class="resource-editor-view"><section class="resource-section">
            <article class="panel"><div class="panel-header"><div><p class="eyebrow">@T("Overview")</p><h2>@T("EffectiveResolution")</h2></div></div>
                @if (resolution is null) { <p>@T("ResolutionUnavailable")</p> } else { <dl class="resource-details"><dt>@T("DeclaredProfile")</dt><dd>@resolution.Profile.DisplayName <code>@resolution.Profile.Name</code></dd><dt>@T("ResolvedProvider")</dt><dd>@(resolution.Provider?.DisplayName ?? resolution.Provider?.Name ?? T("NotResolved"))</dd><dt>@T("ProviderConnection")</dt><dd>@StatusLabel(resolution.Provider?.Status)</dd><dt>@T("ResolvedModel")</dt><dd>@resolution.Model.Name</dd><dt>@T("ModelStatus")</dt><dd>@StatusLabel(resolution.Model.Status)</dd><dt>@T("ProfileStatus")</dt><dd>@StatusLabel(resolution.Status)</dd></dl>@foreach (var item in resolution.Warnings) { <p class="inline-warning">@item</p> } }
            </article>
        </section>
        <section class="panel resource-section"><div class="panel-header"><div><p class="eyebrow">@T("Compatibility")</p><h2>@T("EffectiveCapabilities")</h2></div><span>@T("CapabilitySources")</span></div>
            @if (resolution?.Capabilities is not { Count: > 0 })
            {
                <EmptyState Title="@T("CapabilitiesUnavailable")" Message="@T("CapabilitiesUnavailableMessage")" />
            }
            else
            {
                <CollectionView TItem="ModelCapabilityResponse" Items="resolution.Capabilities" InformationLabels="@(new string[] { T("Provider"), T("Model"), T("Adapter"), T("Effective"), T("Values") })" IdentityLabel="@T("Capability")">
        <Identity Context="capability">
<strong>@capability.Name</strong></Identity>
        <Information Context="capability">
            <CollectionValue Label="@T("Provider")">@SupportLabel(capability.ProviderSupport)</CollectionValue>
            <CollectionValue Label="@T("Model")">@SupportLabel(capability.ModelSupport)</CollectionValue>
            <CollectionValue Label="@T("Adapter")">@SupportLabel(capability.AdapterSupport)</CollectionValue>
            <CollectionValue Label="@T("Effective")"><strong>@SupportLabel(capability.EffectiveSupport)</strong></CollectionValue>
            <CollectionValue Label="@T("Values")">@(capability.SupportedValues.Count == 0 ? "—" : string.Join(", ", capability.SupportedValues))</CollectionValue>
        </Information>
    </CollectionView>
            }
            @if (resolution?.Incompatibilities is { Count: > 0 })
            {
                <div class="form-alert form-alert-danger" role="alert"><strong>@T("ProfileIncompatible")</strong>@foreach (var issue in resolution.Incompatibilities) { <span><code>@issue.Capability</code> — @issue.Message</span> }</div>
            }
            else if (resolution?.Capabilities is { Count: > 0 })
            {
                <p class="inline-info">@T("ProfileCompatible")</p>
            }
        </section>
        </div>;

    private string EnumLabel<TEnum>(TEnum value) where TEnum : struct, Enum => value switch
    {
        ReasoningMode mode => T("ReasoningMode." + mode),
        ReasoningEffort effort => ModelLabels["ReasoningEffort." + effort],
        ModelOutputFormat format => T("OutputFormat." + format),
        _ => value.ToString()
    };
}
