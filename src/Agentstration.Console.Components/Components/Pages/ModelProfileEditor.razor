@page "/modelprofiles/new"
@page "/modelprofiles/{Name}"
@implements IDisposable
@inject IModelProfilesClient Client
@inject IModelProvidersClient ProvidersClient
@inject IExtensionsClient ExtensionsClient
@inject NavigationManager Navigation
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@inject NotificationState Notifications
@inject Microsoft.Extensions.Localization.IStringLocalizer<ModelProfileEditorStrings> Localizer

<UnsavedNavigationGuard IsDirty="@IsDirty" HasUnsavedChanges="@(() => IsDirty)" ViewQueryParameters="@(new[] { "tab" })" />
<PageTitle>@(IsNew ? T("CreateModelProfile") : $"{Name} · {T("ModelProfile")}") · Agentstration</PageTitle>
<PageHeader Title="@(IsNew ? T("CreateModelProfile") : resource?.Definition.DisplayName ?? model?.DisplayName ?? Name)" Description="@T("Description")" TestId="resource-model-profile-editor">
    <Actions>@if (!IsNew && CanManage) { <button class="button-danger" @onclick="RequestDelete" data-testid="model-profile-delete">@T("Delete")</button> }<a class="button-secondary" href="/modelprofiles">@T("Back")</a></Actions>
</PageHeader>

@if (loading || model is null)
{
    <LoadingState Message="@T("Loading")" />
}
else
{
    @if (error is not null) { <div class="form-alert form-alert-danger" role="alert"><strong>@(error.IsConcurrencyConflict ? T("ConcurrencyConflict") : T("UnableToSave"))</strong><span>@error.Message</span>@if (error.IsConcurrencyConflict) { <button class="text-button" @onclick="LoadAsync">@T("ReloadCurrentVersion")</button> }</div> }
    @if (!string.IsNullOrWhiteSpace(warning)) { <div class="form-alert form-alert-warning" role="status">@warning</div> }
    @if (!IsNew && selectedScope is { } inheritedOwner) { <InheritedResourceNotice OwnerScopeRef="inheritedOwner" /> }
    @if (!IsNew && CanManage && (usageKnownSome || usageOverallTotal is null))
    {
        <div class="model-profile-impact-banner" role="status" data-testid="model-profile-impact-banner">
            <span class="model-profile-impact-icon" aria-hidden="true"><TablerIcon Name="alert-triangle" /></span>
            <span class="model-profile-impact-copy"><strong>@(usageOverallTotal is { } total ? T("ChangingProfileAffects", AgentCount(total)) : Shared["MayAffect"])</strong><span>@T("ImpactBannerDescription")</span></span>
            <button type="button" class="model-profile-impact-action" data-testid="model-profile-review-usages" @onclick="() => SelectTab(ModelProfileTab.Usages)">@T("ReviewUsages") <span aria-hidden="true">→</span></button>
        </div>
    }

    @if (!IsNew)
    {
        <ResourcePageTabs Items="PageTabs" Value="@PageKey" ValueChanged="SelectPage" PanelId="model-profile-page-panel" IdPrefix="model-profile-page" Label="@T("ModelProfile")" />
    }

    <div id="model-profile-page-panel" role="@(!IsNew ? "tabpanel" : null)" aria-labelledby="@(!IsNew ? "model-profile-page-" + PageKey : null)">
    @if (!IsNew && activeTab == ModelProfileTab.Overview && resource is not null)
    {
        <ResourceIdentitySummary DisplayName="@resource.Definition.DisplayName" TechnicalName="@resource.Name" Description="@resource.Definition.Description" Namespace="@resource.Namespace.Value" TestId="model-profile-overview">
            <Scope><ResourceScopeBadge ScopeRef="resource.ScopeRef" /></Scope>
        </ResourceIdentitySummary>
        <FormSection Title="@T("Model")"><dl class="resource-details">
            <dt>@T("Provider")</dt><dd><code>@resource.Definition.Provider.Namespace/@resource.Definition.Provider.Name</code></dd>
            <dt>@T("Model")</dt><dd>@resource.Definition.Model.Name</dd>
        </dl></FormSection>
    }
    @if (!IsNew && activeTab == ModelProfileTab.Yaml && resource is not null)
    {
        <FormSection Title="@Shared["Yaml"]"><pre class="runner-json" data-testid="model-profile-yaml">@ResourceManifestSerializer.ToYaml(resource)</pre></FormSection>
    }
    else if (CanManage && activeTab == ModelProfileTab.Access && resource is not null && selectedScope is { } ownerScope)
    {
        <ResourceAccessPanel OwnerScopeRef="ownerScope" Namespace="resource.Namespace" Kind="@ModelResourceKinds.ModelProfile" Name="@resource.Name" Generation="resource.Generation" Governance="resource.Governance" />
    }
    else if (activeTab is ModelProfileTab.Usages or ModelProfileTab.Overview)
    {
        <section class="panel resource-section model-profile-usages-panel" data-testid="model-profile-usages-panel">
            <div class="model-profile-usages-heading">
                <div><p class="eyebrow">@T("Impact")</p><h2>@T("AgentUsages")</h2><p>@T("AgentUsagesDescription")</p></div>
                <span class="model-profile-usage-count">@(usageTotal is { } total ? AgentCount(total) : Shared["UsedBy"])</span>
            </div>
            <ResourceToolbar Label="@Shared["SearchUsages"]"><FormField Label="@Shared["SearchUsages"]"><ClearableText Type="search" Value="@usageSearch" ValueChanged="UsageSearchChanged" data-testid="model-profile-usage-search" /></FormField></ResourceToolbar>
            @if (usageLoading) { <LoadingState Message="@T("Loading")" /> }
            else if (usageError is not null) { <div class="form-alert form-alert-danger" role="alert">@Shared["UsageError"] <code>@usageError.ErrorId</code> <button type="button" class="text-button" @onclick="() => LoadUsagePageAsync(false)">@T("ReloadCurrentVersion")</button></div> }
            else if (usages.Count == 0 && usageTotal == 0 && string.IsNullOrWhiteSpace(usageSearch))
            {
                <EmptyState Title="@T("NoUsages")" Message="@T("NoAgentReferences")" />
            }
            else if (usages.Count == 0)
            {
                <p role="status">@Shared[usageNextCursor is not null ? "ContinueSearch" : "NoMatchesPage"]</p>
            }
            else
            {
                <ul class="model-profile-usage-list" data-testid="model-profile-usages-list">
                    @foreach (var usage in usages)
                    {
                        <li class="model-profile-usage-card" data-testid="model-profile-usage">
                            <a href="@AgentUrl(usage)">
                                <span class="model-profile-usage-icon" aria-hidden="true"><TablerIcon Name="robot" /></span>
                                <span class="model-profile-usage-identity"><strong>@usage.DisplayName</strong><code>@usage.Namespace/@usage.Name</code></span>
                                <span class="model-profile-usage-scope"><ResourceScopeBadge ScopeRef="usage.ScopeRef" Compact />@if (!string.IsNullOrWhiteSpace(usage.ScopeDisplayName)) { <small>@usage.ScopeDisplayName</small> }</span>
                                <span class="model-profile-usage-arrow" aria-hidden="true">→</span>
                            </a>
                        </li>
                    }
                </ul>
            }
            <CollectionPager Page="@(usagePage + 1)" Total="usageTotal" HasMore="@(usageNextCursor is not null)" Busy="@(usageLoading || usageError is not null)" PageChanged="UsagePageChanged" />
        </section>
    }
    @if (editorVisited)
    {
    <div class="resource-editor-view" hidden="@(!IsNew && activeTab != ModelProfileTab.Definition)">
    <EditForm Model="model" OnValidSubmit="SaveAsync" FormName="model-profile-editor" class="resource-form" data-testid="model-profile-form" data-interactive="@(interactive ? "true" : "false")" data-resource-etag="@etag">
        <DataAnnotationsValidator /><FormDraftMonitor InvalidInputChanged="value => invalidInput = value" /><ValidationSummary />
        <fieldset class="model-profile-definition-fields" disabled="@(!CanManage || saving)" data-testid="model-profile-definition-fields">
        <FormSection Title="@T("ProfileResource")" Eyebrow="@T("Identity")"><Actions>@if (resolution is not null) { <StatusBadge Text="@StatusLabel(resolution.Status)" Status="@ModelManagementUi.Status(resolution.Status)" /> }</Actions><ChildContent>
            <FormGrid>
                <ResourceIdentityFields @bind-DisplayName="model.DisplayName" @bind-TechnicalName="model.Name" IsNew="@IsNew" DisplayNameTestId="model-profile-display-name" TechnicalNameTestId="model-profile-name" />
                <FormField Label="@T("Namespace")"><ChildContent><ClearableText @bind-Value="model.Namespace" disabled="@(!IsNew)" /></ChildContent><Validation><ValidationMessage For="() => model.Namespace" /></Validation></FormField>
                <ResourceScopeFormField ResourceKind="@ModelResourceKinds.ModelProfile" Value="@selectedScope" ValueChanged="ScopeChanged" Disabled="@(!IsNew)" />
                <FormField Optional="true" Label="@T("DescriptionLabel")" Class="form-span-2"><ChildContent><ClearableText Multiline @bind-Value="model.Description" rows="3" /></ChildContent><Validation><ValidationMessage For="() => model.Description" /></Validation></FormField>
            </FormGrid>
        </ChildContent></FormSection>

        <FormSection Title="@T("ProviderAndModel")" Eyebrow="@T("ModelSelection")"><ChildContent>
            <FormGrid>
                <FormField Required="true" Label="@T("Provider")"><ChildContent><ClearableSelect TValue="string" Value="@SelectedProvider" ValueChanged="value => ProviderChangedAsync(new ChangeEventArgs { Value = value })" ValueExpression="() => model.ProviderName" data-testid="model-profile-provider"><option value="">@T("SelectProvider")</option>@foreach (var provider in providers) { <option value="@ProviderKey(provider)">@provider.Properties.DisplayName — @provider.Namespace/@provider.Name</option> }</ClearableSelect></ChildContent><Validation><ValidationMessage For="() => model.ProviderName" /></Validation></FormField>
                <FormField Required="true" Label="@T("Model")"><ChildContent><ClearableSelect @bind-Value="model.ModelName" disabled="@loadingModels" data-testid="model-profile-model"><option value="">@(loadingModels ? T("LoadingModels") : T("SelectModel"))</option>@if (!string.IsNullOrWhiteSpace(model.ModelName) && models.All(item => !string.Equals(item.Name, model.ModelName, StringComparison.Ordinal))) { <option value="@model.ModelName">@model.ModelName — @T("NotCurrentlyDiscovered")</option> }@foreach (var available in models) { <option value="@available.Name" disabled="@IsUnavailable(available)">@available.DisplayName — @available.Name · @StatusLabel(available.Status)</option> }</ClearableSelect></ChildContent><Validation><ValidationMessage For="() => model.ModelName" /></Validation></FormField>
            </FormGrid>
            @if (models.Count == 0 && !loadingModels && !string.IsNullOrWhiteSpace(model.ProviderName)) { <p class="inline-warning">@T("NoModelsReported")</p> }
        </ChildContent></FormSection>

        <FormSection Title="@T("Generation")" Eyebrow="@T("Defaults")"><Actions><span>@T("Canonical")</span></Actions><ChildContent>
            <FormGrid>
                <FormField Label="@T("Temperature")" Tooltip="@T("TemperatureHelp")"><ChildContent><ClearableNumber @bind-Value="model.Temperature" step="0.1" /></ChildContent><Validation><ValidationMessage For="() => model.Temperature" /></Validation></FormField>
                <FormField Label="@T("TopP")" Tooltip="@T("TopPHelp")"><ChildContent><ClearableNumber @bind-Value="model.TopP" step="0.05" /></ChildContent><Validation><ValidationMessage For="() => model.TopP" /></Validation></FormField>
                <FormField Label="@T("TopK")" Tooltip="@T("TopKHelp")"><ChildContent><ClearableNumber @bind-Value="model.TopK" /></ChildContent><Validation><ValidationMessage For="() => model.TopK" /></Validation></FormField>
                <FormField Label="@T("MaximumOutputTokens")" Tooltip="@T("MaximumOutputTokensHelp")"><ChildContent><ClearableNumber @bind-Value="model.MaxOutputTokens" /></ChildContent><Validation><ValidationMessage For="() => model.MaxOutputTokens" /></Validation></FormField>
                <FormField Label="@T("Seed")" Tooltip="@T("SeedHelp")"><ChildContent><ClearableNumber @bind-Value="model.Seed" /></ChildContent><Validation><ValidationMessage For="() => model.Seed" /></Validation></FormField>
                <FormField Label="@T("StopSequences")" Class="form-span-2" Tooltip="@T("StopSequencesHelp")"><ChildContent><ClearableText Multiline @bind-Value="model.StopSequences" rows="3" /></ChildContent><Validation><ValidationMessage For="() => model.StopSequences" /></Validation></FormField>
            </FormGrid>
        </ChildContent></FormSection>

        <FormSection Title="@T("ReasoningAndOutput")" Eyebrow="@T("Inference")"><ChildContent>
            <FormGrid>
                <FormField Required="true" Label="@T("ReasoningMode")"><ChildContent><ClearableSelect @bind-Value="model.ReasoningMode">@foreach (var value in Enum.GetValues<ReasoningMode>()) { <option value="@value">@value</option> }</ClearableSelect></ChildContent><Validation><ValidationMessage For="() => model.ReasoningMode" /></Validation></FormField>
                <FormField Label="@T("ReasoningEffort")"><ChildContent><ClearableSelect @bind-Value="model.ReasoningEffort"><option value="">@T("ProviderDefault")</option>@foreach (var value in Enum.GetValues<ReasoningEffort>()) { <option value="@value">@value</option> }</ClearableSelect><small>@T("ReasoningEffortHelp")</small></ChildContent><Validation><ValidationMessage For="() => model.ReasoningEffort" /></Validation></FormField>
                <FormField Required="true" Label="@T("OutputFormat")"><ChildContent><ClearableSelect @bind-Value="model.OutputFormat">@foreach (var value in Enum.GetValues<ModelOutputFormat>()) { <option value="@value">@value</option> }</ClearableSelect></ChildContent><Validation><ValidationMessage For="() => model.OutputFormat" /></Validation></FormField>
                <label class="checkbox-field"><FormCheckbox @bind-Value="model.StrictOutput" /><span>@T("StrictStructuredOutput")</span></label>
                @if (model.OutputFormat == ModelOutputFormat.JsonSchema)
                {
                    <FormField Label="@T("JsonSchema")" Class="form-span-2"><ChildContent><ClearableText Multiline @bind-Value="model.JsonSchema" rows="10" class="runner-json" /><small>@T("JsonSchemaRequired")</small></ChildContent><Validation><ValidationMessage For="() => model.JsonSchema" /></Validation></FormField>
                }
            </FormGrid>
        </ChildContent></FormSection>

        <FormSection Title="@T("ProviderOptions")" Eyebrow="@T("Adapter")"><Actions><span>@(optionEditor is null ? T("Advanced") : $"{optionEditor.Contract.Id}@{optionEditor.Version.Version}")</span></Actions><ChildContent>
            @if (optionEditor is { CanGuide: true } && !rawOptions)
            {
                <FormGrid>
                    <label class="checkbox-field form-span-2"><FormCheckbox Value="@optionEditor.Enabled" ValueChanged="changed => SetProviderOptionsEnabled(new ChangeEventArgs { Value = changed })" /><span>@T("ConfigureProviderOptions")</span></label>
                    @if (optionEditor.Enabled)
                    {
                        @foreach (var field in optionEditor.Fields)
                        {
                            @if (field.Kind == ExtensionOptionFieldKind.Toggle)
                            {
                                <label class="checkbox-field"><FormCheckbox Value="@BooleanValue(field)" ValueChanged="changed => SetBooleanOption(field, new ChangeEventArgs { Value = changed })" /><span>@FieldLabel(field)</span></label>
                            }
                            else if (field.AllowedValues.Count > 0)
                            {
                                <FormField Label="@FieldLabel(field)"><ChildContent><ClearableSelect TValue="string" Value="@Convert.ToString(field.Value, System.Globalization.CultureInfo.InvariantCulture)" ValueChanged="changed => SetOption(field, (new ChangeEventArgs { Value = changed }).Value?.ToString())"><option value="">@T("ProviderDefault")</option>@foreach (var value in field.AllowedValues) { <option value="@value">@value</option> }</ClearableSelect>@FieldHelp(field)</ChildContent></FormField>
                            }
                            else if (field.Kind is ExtensionOptionFieldKind.JsonObject or ExtensionOptionFieldKind.JsonValue)
                            {
                                <FormField Label="@FieldLabel(field)" Class="form-span-2"><ChildContent><ClearableText UpdateOnInput="false" Multiline="true" rows="5" class="runner-json form-code-editor" Value="@field.Value" ValueChanged="changed => SetOption(field, (new ChangeEventArgs { Value = changed }).Value?.ToString())"></ClearableText>@FieldHelp(field)</ChildContent></FormField>
                            }
                            else
                            {
                                <FormField Label="@FieldLabel(field)"><ChildContent><ClearableText UpdateOnInput="false" Type="@(field.Kind is ExtensionOptionFieldKind.WholeNumber or ExtensionOptionFieldKind.DecimalNumber ? "number" : "text")" Value="@field.Value" min="@field.Minimum" max="@field.Maximum" step="@(field.Kind == ExtensionOptionFieldKind.WholeNumber ? "1" : "any")" ValueChanged="changed => SetOption(field, (new ChangeEventArgs { Value = changed }).Value?.ToString())" />@FieldHelp(field)</ChildContent></FormField>
                            }
                        }
                    }
                </FormGrid>
                <div class="panel-actions"><button class="button-secondary" type="button" @onclick="() => rawOptions = true">@T("EditRawJson")</button><a class="text-button" href="/extensions">@T("InspectContract")</a></div>
            }
            else
            {
                @if (optionEditor?.UnavailableReason is { } reason) { <p class="inline-warning">@reason</p> }
                <FormGrid><FormField Label="@T("ProviderSpecificJson")" Class="form-span-2"><ChildContent><ClearableText Multiline @bind-Value="model.ProviderOptionsJson" rows="8" class="runner-json form-code-editor" /><small>@T("ProviderJsonHelpPrefix") <code>optionSet</code>, <code>version</code>, <code>schemaDigest</code> @T("And") <code>values</code>.</small></ChildContent><Validation><ValidationMessage For="() => model.ProviderOptionsJson" /></Validation></FormField></FormGrid>
                @if (optionEditor?.CanGuide == true) { <div class="panel-actions"><button class="button-secondary" type="button" @onclick="UseGuidedOptions">@T("ReturnToGuidedEditor")</button></div> }
            }
        </ChildContent></FormSection>
        </fieldset>

        @if (CanManage)
        {
            <FormActions Busy="@saving"><a class="button-secondary" href="/modelprofiles">@T("Cancel")</a><button class="button-primary" type="submit" disabled="@saving" data-testid="model-profile-save">@(saving ? T("Saving") : IsNew ? T("CreateProfile") : T("SaveChanges"))</button></FormActions>
        }
    </EditForm>

    @if (!IsNew)
    {
        <section class="resource-section">
            <article class="panel"><div class="panel-header"><div><p class="eyebrow">@T("Overview")</p><h2>@T("EffectiveResolution")</h2></div><button class="button-secondary" type="button" @onclick="RefreshResolutionAsync" disabled="@diagnosing">@(diagnosing ? T("Checking") : T("RefreshDiagnosis"))</button></div>
                @if (resolution is null) { <p>@T("ResolutionUnavailable")</p> } else { <dl class="resource-details"><dt>@T("DeclaredProfile")</dt><dd>@resolution.Profile.DisplayName <code>@resolution.Profile.Name</code></dd><dt>@T("ResolvedProvider")</dt><dd>@(resolution.Provider?.DisplayName ?? resolution.Provider?.Name ?? T("NotResolved"))</dd><dt>@T("ProviderConnection")</dt><dd>@StatusLabel(resolution.Provider?.Status)</dd><dt>@T("ResolvedModel")</dt><dd>@resolution.Model.Name</dd><dt>@T("ModelStatus")</dt><dd>@StatusLabel(resolution.Model.Status)</dd><dt>@T("ProfileStatus")</dt><dd>@StatusLabel(resolution.Status)</dd></dl>@foreach (var item in resolution.Warnings) { <p class="inline-warning">@item</p> } }
            </article>
        </section>
        <section class="panel resource-section"><div class="panel-header"><div><p class="eyebrow">@T("Compatibility")</p><h2>@T("EffectiveCapabilities")</h2></div><span>@T("CapabilitySources")</span></div>
            @if (resolution?.Capabilities is not { Count: > 0 })
            {
                <EmptyState Title="@T("CapabilitiesUnavailable")" Message="@T("CapabilitiesUnavailableMessage")" />
            }
            else
            {
                <DataGrid TItem="ModelCapabilityResponse" Items="resolution.Capabilities"><Header><tr><th>@T("Capability")</th><th>@T("Provider")</th><th>@T("Model")</th><th>@T("Adapter")</th><th>@T("Effective")</th><th>@T("Values")</th></tr></Header><Row Context="capability"><tr><td><strong>@capability.Name</strong></td><td>@SupportLabel(capability.ProviderSupport)</td><td>@SupportLabel(capability.ModelSupport)</td><td>@SupportLabel(capability.AdapterSupport)</td><td><strong>@SupportLabel(capability.EffectiveSupport)</strong></td><td>@(capability.SupportedValues.Count == 0 ? "—" : string.Join(", ", capability.SupportedValues))</td></tr></Row></DataGrid>
            }
            @if (resolution?.Incompatibilities is { Count: > 0 })
            {
                <div class="form-alert form-alert-danger" role="alert"><strong>@T("ProfileIncompatible")</strong>@foreach (var issue in resolution.Incompatibilities) { <span><code>@issue.Capability</code> — @issue.Message</span> }</div>
            }
            else if (resolution?.Capabilities is { Count: > 0 })
            {
                <p class="inline-info">@T("ProfileCompatible")</p>
            }
        </section>
        <section class="panel resource-section"><div class="panel-header"><div><p class="eyebrow">@T("Definition")</p><h2>@T("DeclarativeResource")</h2></div><span>@T("ReadOnly")</span></div><pre class="runner-json">@Definition</pre></section>
    }
    </div>
    }
    </div>
}

<ConfirmationDialog IsOpen="@confirmDelete" Title="@T("DeleteDialogTitle")" Message="@T("DeleteDialogMessage", Name ?? string.Empty)" ConfirmLabel="@T("DeleteDialogConfirm")" OnConfirm="DeleteAsync" OnCancel="() => confirmDelete = false" TestId="model-profile-delete-dialog" />

@code {
    [Parameter] public string? Name { get; set; }
    [SupplyParameterFromQuery(Name = "namespace")] public string? Namespace { get; set; }
    [SupplyParameterFromQuery(Name = "scopeRef")] public string? ScopeRef { get; set; }
    [SupplyParameterFromQuery(Name = "provider")] public string? SuggestedProvider { get; set; }
    [SupplyParameterFromQuery(Name = "providerNamespace")] public string? SuggestedProviderNamespace { get; set; }
    [SupplyParameterFromQuery(Name = "model")] public string? SuggestedModel { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }
    [SupplyParameterFromQuery(Name = "context")] public string? Context { get; set; }
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string AgentCount(int count) => T(count == 1 ? "AgentCount.One" : "AgentCount.Many", count);
    private readonly CancellationTokenSource cancellation = new();
    private readonly CancellationToken lifetimeToken;
    private bool disposed;
    public ModelProfileEditor() => lifetimeToken = cancellation.Token;
    private ModelProfileEditorModel? model; private ModelProfileResource? resource; private IReadOnlyList<ModelProviderResponse> providers = []; private IReadOnlyList<AvailableModelResponse> models = []; private IReadOnlyList<ExtensionResponse> extensions = [];
    private string usageSearch = string.Empty;
    private readonly List<string?> usageCursors = [null];
    private string? usageNextCursor;
    private int usagePage, usageVersion;
    private CancellationTokenSource? pendingUsage;
    private int? usageTotal, usageOverallTotal;
    private bool usageLoading, usageKnownSome;
    private AgentstrationApiException? usageError;
    private IReadOnlyList<ModelProfileUsageResponse> usages = []; private ModelProfileResolutionResponse? resolution;
    private ExtensionOptionsEditorModel? optionEditor; private bool rawOptions;
    private AgentstrationApiException? error; private string? etag; private string? warning; private bool loading = true; private bool loadingModels; private bool saving; private bool diagnosing; private bool confirmDelete; private bool interactive;
    private ModelProfileTab activeTab;
    private bool editorVisited;
    private string? loadedKey;
    private bool invalidInput;
    private string savedFingerprint = string.Empty;
    private void ScopeChanged(ResourceScopeRef? value)
    {
        var initializing = IsNew && selectedScope is null && Fingerprint == savedFingerprint;
        selectedScope = value;
        if (initializing) savedFingerprint = Fingerprint;
    }
    private string Fingerprint => JsonSerializer.Serialize(new { model, selectedScope, OptionsEnabled = optionEditor?.Enabled, Options = optionEditor?.Fields.Select(option => new { option.Name, option.Value }) });
    private bool IsDirty => model is not null && CanManage && (Fingerprint != savedFingerprint || invalidInput);
    private string PageKey => activeTab switch { ModelProfileTab.Overview => "overview", ModelProfileTab.Access => "access", ModelProfileTab.Usages => "usages", ModelProfileTab.Yaml => "yaml", _ => "edit" };
    private IReadOnlyList<ResourcePageTab> PageTabs => new ResourcePageTab[] { new("overview", Shared["Overview"], "model-profile-overview-tab"), new("edit", Shared["Edit"], "model-profile-edit-tab") }
        .Concat(CanManage ? new[] { new ResourcePageTab("access", T("Access"), "model-profile-access-tab") } : [])
        .Concat(new[] { new ResourcePageTab("usages", T("Usages"), "model-profile-usages-tab"), new ResourcePageTab("yaml", Shared["Yaml"], "model-profile-source-tab") }).ToArray();
    private void SelectPage(string page) => SelectTab(page switch { "overview" => ModelProfileTab.Overview, "access" => ModelProfileTab.Access, "usages" => ModelProfileTab.Usages, "yaml" => ModelProfileTab.Yaml, _ => ModelProfileTab.Definition });
    private ResourceScopeRef? selectedScope;
    private bool IsNew => string.IsNullOrWhiteSpace(Name);
    private ResourceNamespace SelectedNamespace => ResourceNamespace.Parse(Namespace);
    private ResourceScopeRef? RequestedScope => string.IsNullOrWhiteSpace(ScopeRef) ? null : ResourceScopeRef.Parse(ScopeRef);
    private ResourceScopeRef? RequestedContext => string.IsNullOrWhiteSpace(Context) ? null : ResourceScopeRef.Parse(Context);
    private ResourceScopeRef? CurrentContext => RequestedContext ?? ResourceOwnershipContext.TryGetCurrent(Services);
    private bool CanManage => IsNew || selectedScope is { } ownerScope &&
        (RequestedContext is { } requestedContext ? ownerScope == requestedContext : ResourceOwnershipContext.CanManage(ownerScope, Services));
    private string SelectedProvider => model is null || string.IsNullOrWhiteSpace(model.ProviderName) ? string.Empty : $"{model.ProviderNamespace}:{model.ProviderName}";
    private string Definition
    {
        get
        {
            if (model is null) return string.Empty;
            try { return JsonSerializer.Serialize(new { apiVersion = ResourceApiVersions.CoreV1, kind = ModelResourceKinds.ModelProfile, metadata = new { name = model.Name, @namespace = model.Namespace }, definition = model.ToProperties() }, new JsonSerializerOptions(JsonSerializerDefaults.Web) { WriteIndented = true }); }
            catch (ArgumentException) { return T("DeclarativeDefinitionUnavailable"); }
        }
    }
    protected override Task OnParametersSetAsync()
    {
        activeTab = Tab?.ToLowerInvariant() switch
        {
            "access" => ModelProfileTab.Access,
            "usages" => ModelProfileTab.Usages,
            "edit" or "definition" => ModelProfileTab.Definition,
            "yaml" => ModelProfileTab.Yaml,
            _ => IsNew ? ModelProfileTab.Definition : ModelProfileTab.Overview
        };
        editorVisited |= IsNew || activeTab == ModelProfileTab.Definition;
        var key = $"{Name}|{Namespace}|{ScopeRef}|{Context}";
        if (loadedKey == key && model is not null) return Task.CompletedTask;
        loadedKey = key;
        return LoadAsync();
    }
    protected override void OnAfterRender(bool firstRender) { if (!firstRender) return; interactive = true; StateHasChanged(); }
    private async Task LoadAsync()
    {
        loading = true; error = null; warning = null; usageKnownSome = false; usageOverallTotal = null; usageSearch = string.Empty;
        try
        {
            if (IsNew)
            {
                model = new ModelProfileEditorModel
                {
                    Namespace = SelectedNamespace.Value,
                    ProviderName = SuggestedProvider ?? string.Empty,
                    ProviderNamespace = SuggestedProviderNamespace ?? SelectedNamespace.Value,
                    ModelName = SuggestedModel ?? string.Empty
                };
            }
            else
            {
                var snapshot = RequestedScope is { } requestedScope && RequestedContext is { } requestedContext
                    ? await Client.GetModelProfileAsync(SelectedNamespace, Name!, requestedScope, requestedContext, lifetimeToken)
                    : RequestedScope is { } exactScope
                    ? await Client.GetModelProfileAsync(SelectedNamespace, Name!, exactScope, lifetimeToken)
                    : await Client.GetModelProfileAsync(SelectedNamespace, Name!, lifetimeToken);
