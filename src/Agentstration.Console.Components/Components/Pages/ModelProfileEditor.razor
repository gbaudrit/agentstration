    private Task RetryAsync() => Busy ? Task.CompletedTask : LoadAsync(resource is not null);
    private Task RefreshAsync() => Busy ? Task.CompletedTask : LoadAsync(true);
    private async Task LoadAsync(bool refresh)
    {
