    private bool Matches(ModelProfileResource candidate, ModelProfileResource? previous) => candidate.Name == Name && candidate.Namespace == SelectedNamespace && candidate.ScopeRef is not null
        && (RequestedScope is null || candidate.ScopeRef == RequestedScope) && (previous is null || candidate.Uid == previous.Uid && candidate.ScopeRef == previous.ScopeRef);
    private async Task LoadDependenciesAsync(long request, ResourceScopeRef? owner)
