        IReadOnlyList<AvailableModelResponse> availableModels = []; IReadOnlyList<ResourceScopeTargetResponse> targets = [];
        ModelProfileResolutionResponse? observed = null; string? note = null; var denied = false;
        var saved = snapshot.Value;
        try
        {
            availableProviders = await ProvidersClient.GetModelProvidersAsync(saved.ScopeRef!.Value, lifetimeToken);
            if (request != loadVersion) return new(snapshot, [], [], [], [], null, null);
            availableExtensions = await ExtensionsClient.GetExtensionsAsync(lifetimeToken);
            if (request != loadVersion) return new(snapshot, [], [], [], [], null, null);
            targets = await Scopes.GetTargetsAsync(ModelResourceKinds.ModelProfile, lifetimeToken);
            if (request != loadVersion) return new(snapshot, [], [], [], [], null, null);
            availableModels = await ProvidersClient.GetProviderModelsAsync(saved.Definition.Provider.Namespace ?? saved.Namespace, saved.Definition.Provider.Name, saved.ScopeRef.Value, lifetimeToken);
        }
        catch (AgentstrationApiException exception)
        {
            note = T("ModelsCannotBeDiscovered", exception.Message);
            if (exception.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
            { availableProviders = []; availableExtensions = []; availableModels = []; targets = []; denied = true; }
