        return new(snapshot, availableProviders, availableExtensions, availableModels, targets, observed, note, denied);
    }
    private Task<ModelProfileResolutionResponse> ReadResolutionAsync(ModelProfileResource saved) => RequestedContext is { } context
        ? Client.GetModelProfileResolutionAsync(saved.Namespace, saved.Name, saved.ScopeRef!.Value, context, lifetimeToken)
        : Client.GetModelProfileResolutionAsync(saved.Namespace, saved.Name, saved.ScopeRef!.Value, lifetimeToken);
    private void Adopt(ProfileBundle bundle)
    {
