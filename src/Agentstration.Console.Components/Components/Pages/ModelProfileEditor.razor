            if (IsNew)
            {
                var targets = await Scopes.GetTargetsAsync(ModelResourceKinds.ModelProfile, lifetimeToken);
                if (request != loadVersion) return;
                scopeTargets = targets;
                var owner = targets.FirstOrDefault(target => target.CanWrite && target.ScopeRef == CurrentContext)?.ScopeRef ?? targets.FirstOrDefault(target => target.CanWrite)?.ScopeRef;
                model = new() { Namespace = SelectedNamespace.Value, ScopeRef = owner, ProviderName = SuggestedProvider ?? string.Empty, ProviderNamespace = SuggestedProviderNamespace ?? SelectedNamespace.Value, ModelName = SuggestedModel ?? string.Empty };
                await LoadDependenciesAsync(request, owner ?? RequestedContext);
