    @if (model is null || loadState.BlocksContent) { <ResourceLoadFeedback State="loadState" OnRetry="RetryAsync" /> }
    else { @Feedback @definition }
}
else
{
    <ConsoleResourceDetailsTemplate CollectionHref="@BackUrl" CollectionLabel="@CollectionLabels["Title"]" Resource="resource" Name="@(resource?.Definition.DisplayName ?? Name ?? string.Empty)" ResourceType="@T("ModelProfile")" Domain="model" IconName="adjustments"
        Description="@resource?.Definition.Description" StatusText="@(resolution is null ? null : StatusLabel(resolution.Status))" Status="@(resolution is null ? UiStatus.Neutral : ModelManagementUi.Status(resolution.Status))"
        ResourceIdentity="@(loadedKey ?? Name ?? string.Empty)" SectionState="sectionState" SectionPresentations="presentations" DefinitionSections="DefinitionSections" AdditionalSections="AdditionalSections"
        AllowAccess="OwnScope" LoadState="loadState" OnRetry="RetryAsync" OnRefresh="RefreshAsync" Busy="Busy" HasDraft="HasDraft" DefinitionReadOnlyReason="ExplicitReadOnlyReason" Yaml="@(resource is null ? string.Empty : ResourceManifestSerializer.ToYaml(resource))"
