            }
            var snapshot = RequestedScope is { } scope && RequestedContext is { } context
                ? await Client.GetModelProfileAsync(SelectedNamespace, Name!, scope, context, lifetimeToken)
                : RequestedScope is { } exact ? await Client.GetModelProfileAsync(SelectedNamespace, Name!, exact, lifetimeToken)
                : await Client.GetModelProfileAsync(SelectedNamespace, Name!, lifetimeToken);
