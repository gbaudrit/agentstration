@page "/triggers"
@rendermode InteractiveServer
@using Agentstration.Resources
@inject ITriggerApiClient Client
@inject ConsoleContextState ContextState
@inject Microsoft.Extensions.Localization.IStringLocalizer<TriggerStrings> Localizer

<PageTitle>@T("Triggers") · Agentstration</PageTitle>
<PageHeader Title="@T("Triggers")" Description="@T("List.Description")" TestId="resource-triggers">
    <Metadata><span>@T(Filtered.Count == 1 ? "TriggerCount.One" : "TriggerCount.Many", Filtered.Count)</span><span>@T("EnabledCount", EnabledCount)</span><span>@T("AttentionCount", AttentionCount)</span></Metadata>
    <Actions>@if (CanManage) { <a class="button-primary" href="/triggers/new">@T("NewTrigger")</a> }</Actions>
</PageHeader>

@if (loading)
{
    <LoadingState Message="@T("LoadingTriggers")" />
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <ErrorState Title="@T("TriggersUnavailable")" Message="@error" OnRetry="LoadAsync" />
}
else
{
    <div class="filter-bar">
        <SearchBox @bind-Value="search" Placeholder="@T("SearchPlaceholder")" />
        <select @bind="state" aria-label="@T("FilterStateAriaLabel")">
            <option value="">@T("State.All")</option><option value="enabled">@T("Enabled")</option><option value="disabled">@T("Disabled")</option><option value="attention">@T("RequiresAttention")</option>
        </select>
        <select @bind="scheduleType" aria-label="@T("FilterScheduleAriaLabel")">
            <option value="">@T("Schedule.All")</option><option value="once">@T("ScheduleType.Once")</option><option value="interval">@T("ScheduleType.Interval")</option><option value="cron">@T("ScheduleType.Cron")</option>
        </select>
    </div>

    @if (items.Count == 0)
    {
        <EmptyState Title="@T("EmptyTitle")" Message="@T("EmptyMessage")">@if (CanManage) { <a class="button-primary" href="/triggers/new">@T("CreateTrigger")</a> }</EmptyState>
    }
    else if (Filtered.Count == 0)
    {
        <EmptyState Title="@T("NoMatchesTitle")" Message="@T("NoMatchesMessage")" />
    }
    else
    {
        <CollectionView TItem="TriggerResource" Items="Filtered" InformationLabels="@(new string[] { T("Schedule"), T("Target"), T("NextOccurrence"), T("LastOutcome") })" RowTestId="trigger-row" ItemAttributes="@((trigger) => new Dictionary<string, object> { ["data-trigger-name"] = trigger.Name })" IdentityLabel="@T("Trigger")" StateLabel="@T("State")">
        <Identity Context="trigger">
<CollectionIdentity DisplayName="@trigger.Definition.DisplayName" Namespace="@trigger.Namespace.Value" Name="@trigger.Name" Href="@DetailsUrl(trigger)" IconName="trigger"><Badges><ManagedResourceBadge IsManaged="@trigger.Governance.IsManaged" /></Badges></CollectionIdentity></Identity>
        <Scope Context="trigger">
<ResourceScopeBadge ScopeRef="TriggerUi.DefinitionScope(trigger)" ShowName /></Scope>
        <State Context="trigger">
<StatusBadge Text="@(trigger.Definition.Enabled ? T("Enabled") : T("Disabled"))" Status="@(trigger.Definition.Enabled ? UiStatus.Success : UiStatus.Neutral)" /></State>
        <Information Context="trigger">
            <CollectionValue Label="@T("Schedule")">@TriggerUi.ScheduleLabel(trigger.Definition.Source.Schedule, Localizer)</CollectionValue>
            <CollectionValue Label="@T("Target")"><a class="text-button" href="@FlowUrl(trigger)">@trigger.Definition.Target.Flow?.Name</a></CollectionValue>
            <CollectionValue Label="@T("NextOccurrence")">@TriggerUi.FormatDate(trigger.Observed.NextOccurrenceAt)</CollectionValue>
            <CollectionValue Label="@T("LastOutcome")"><StatusBadge Text="@T($"Outcome.{trigger.Observed.LastOutcome}")" Status="@OutcomeStatus(trigger.Observed.LastOutcome)" />@if (trigger.Observed.LastErrorCode is { } errorCode) { <small class="table-secondary">@errorCode</small> }</CollectionValue>
        </Information>
    </CollectionView>
    }
}

@code {
    private IReadOnlyList<TriggerResource> items = [];
    private bool loading = true;
    private string? error;
    private string search = "", state = "", scheduleType = "";
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    private bool CanManage => ContextState.HasPermission(AuthorizationPermissions.ResourcesWrite);
    private int EnabledCount => items.Count(value => value.Definition.Enabled);
    private int AttentionCount => items.Count(value => value.Observed.LastOutcome == TriggerLastOutcome.Failed);
    private IReadOnlyList<TriggerResource> Filtered => items
        .Where(value => string.IsNullOrWhiteSpace(search) || value.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || value.Definition.DisplayName.Contains(search, StringComparison.OrdinalIgnoreCase) || (value.Definition.Target.Flow?.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false))
        .Where(value => state switch { "enabled" => value.Definition.Enabled, "disabled" => !value.Definition.Enabled, "attention" => value.Observed.LastOutcome == TriggerLastOutcome.Failed, _ => true })
        .Where(value => string.IsNullOrWhiteSpace(scheduleType) || string.Equals(value.Definition.Source.Schedule?.Type.ToString(), scheduleType, StringComparison.OrdinalIgnoreCase))
        .OrderBy(value => value.Observed.NextOccurrenceAt ?? DateTimeOffset.MaxValue).ThenBy(value => value.Definition.DisplayName, StringComparer.OrdinalIgnoreCase).ToArray();

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() { loading = true; error = null; try { items = await Client.ListAsync(CancellationToken.None); } catch (Exception exception) { error = exception.Message; } finally { loading = false; } }
    private static string DetailsUrl(TriggerResource value) => ConsoleResourceUrls.Resource("/triggers", value.Name, value.Namespace, TriggerUi.DefinitionScope(value));
    private static string FlowUrl(TriggerResource value) { var flow = value.Definition.Target.Flow!; return ConsoleResourceUrls.Flow(new FlowId(flow.Name, flow.Namespace ?? value.Namespace), flow.ScopeRef); }
    private static UiStatus OutcomeStatus(TriggerLastOutcome outcome) => outcome switch { TriggerLastOutcome.Submitted => UiStatus.Success, TriggerLastOutcome.Skipped => UiStatus.Warning, TriggerLastOutcome.Failed => UiStatus.Danger, _ => UiStatus.Neutral };
}
