@page "/triggers"
@rendermode InteractiveServer
@implements IDisposable
@inject IServiceProvider Services
@inject ITriggerApiClient Client
@inject ConsoleContextState Context
@inject Microsoft.Extensions.Localization.IStringLocalizer<TriggerStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared

<PageTitle>@T("Triggers") · Agentstration</PageTitle>
<ResourceCollectionTemplate TItem="TriggerResource" Title="@T("Triggers")" Description="@T("List.Description")" TestId="resource-triggers"
                            IdentityColumn="IdentityColumn" Columns="Columns" AdditionalFilters="ExtraFilters" Items="PageItems" ContextKey="@contextKey" RowTestId="trigger-row" ItemAttributes="TriggerAttributes" Metrics="Metrics"
                            Query="query" QueryChanged="ChangeQueryAsync" Pagination="Pagination" LoadState="loadState" Disabled="@(!interactive)"
                            SearchEnabled SearchLabel="@Shared["Search"]" SearchPlaceholder="@T("SearchPlaceholder")"
                            EmptyTitle="@T("EmptyTitle")" EmptyMessage="@T("EmptyMessage")" PrimaryActions="CreateAction" EmptyActions="CreateAction"
                            OnRefresh="LoadAsync" OnRetry="RetryAsync" />

@code {
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    private RenderFragment? Metrics => !loadState.BlocksContent && items is not null ? @<text>
        <MetricCard Label="@T("Triggers")" Value="@items.Count.ToString()" Status="UiStatus.Info" />
        <MetricCard Label="@T("Enabled")" Value="@items.Count(trigger => trigger.Definition.Enabled).ToString()" Status="UiStatus.Success" />
        <MetricCard Label="@T("RequiresAttention")" Value="@items.Count(trigger => trigger.Observed.LastOutcome == TriggerLastOutcome.Failed).ToString()" Status="@(items.Any(trigger => trigger.Observed.LastOutcome == TriggerLastOutcome.Failed) ? UiStatus.Warning : UiStatus.Neutral)" />
    </text> : null;
    private RenderFragment? CreateAction => Context.HasPermission(AuthorizationPermissions.ResourcesWrite)
        ? @<PermissionGate Permission="@AuthorizationPermissions.ResourcesWrite"><a class="button-primary" href="@Navigate("/triggers/new")">@T("NewTrigger")</a></PermissionGate> : null;
    private CollectionColumn<TriggerResource> IdentityColumn => new("identity", T("Trigger"), trigger => @<CollectionIdentity DisplayName="@trigger.Definition.DisplayName" Namespace="@trigger.Namespace.Value" Name="@trigger.Name" Href="@DetailsUrl(trigger)" IconName="trigger">
        <IconBadges><ResourceScopeBadge ScopeRef="TriggerUi.DefinitionScope(trigger)" ShowName IconOnly /><StatusBadge Text="@(trigger.Definition.Enabled ? T("Enabled") : T("Disabled"))" Status="@(trigger.Definition.Enabled ? UiStatus.Success : UiStatus.Neutral)" IconOnly /><ManagedResourceBadge IsManaged="@trigger.Governance.IsManaged" IsReadOnly="@(!ResourceOwnershipContext.CanManage(TriggerUi.DefinitionScope(trigger), Services))" IconOnly /></IconBadges>
    </CollectionIdentity>)
    {
        Filters = [new("enabled", T("State"), CollectionFilterKind.Choice) { Options = [new("true", T("Enabled")), new("false", T("Disabled"))] }]
    };
    private IReadOnlyList<CollectionColumn<TriggerResource>> Columns =>
    [
        new("schedule", T("Schedule"), trigger => @<span>@TriggerUi.ScheduleLabel(trigger.Definition.Source.Schedule, Localizer)</span>)
        {
            Filters = [new("schedule", T("ScheduleType"), CollectionFilterKind.Choice)
            {
                Options = Enum.GetValues<TriggerScheduleType>().Select(value => new CollectionFilterOption(value.ToString(), T($"ScheduleType.{value}"))).ToArray()
            }]
        },
        new("target", T("Target"), trigger => @<a class="text-button" href="@FlowUrl(trigger)">@trigger.Definition.Target.Flow?.Name</a>)
        {
            Filters = [new("target", T("Target"), CollectionFilterKind.Text) { Advanced = true }]
        },
        new("next", T("NextOccurrence"), trigger => @<span>@TriggerUi.FormatDate(trigger.Observed.NextOccurrenceAt)</span>),
        new("outcome", T("LastOutcome"), trigger => @<text><StatusBadge Text="@T($"Outcome.{OutcomeKey(trigger.Observed.LastOutcome)}")" Status="@OutcomeStatus(trigger.Observed.LastOutcome)" />@if (trigger.Observed.LastErrorCode is { } errorCode) { <small class="table-secondary">@errorCode</small> }</text>)
        {
            Filters = [new("outcome", T("LastOutcome"), CollectionFilterKind.Choice)
            {
                Options = Enum.GetValues<TriggerLastOutcome>().Select(value => new CollectionFilterOption(value.ToString(), T($"Outcome.{value}"))).Append(new("Unknown", T("Outcome.Unknown"))).ToArray()
            }]
        }
    ];
    private IReadOnlyList<CollectionFilter> ExtraFilters =>
    [
        new("namespace", Shared["Namespace"], CollectionFilterKind.Choice)
        {
            Options = (items ?? []).Select(trigger => trigger.Namespace.Value).Distinct(StringComparer.Ordinal).Order().Select(value => new CollectionFilterOption(value, value)).ToArray()
        },
        new("scope", T("DefinitionScope"), CollectionFilterKind.Choice)
        {
            Options = (items ?? []).Select(trigger => TriggerUi.DefinitionScope(trigger)?.Value).OfType<string>().Distinct(StringComparer.Ordinal).Order().Select(value => new CollectionFilterOption(value, Context.Current?.Contexts.FirstOrDefault(context => context.ScopeRef == value)?.DisplayName ?? value)).ToArray()
        }
    ];
    private static string ScheduleKey(TriggerSchedule? schedule) => schedule is not null && Enum.IsDefined(schedule.Type) ? schedule.Type.ToString() : "Unknown";
    private static string OutcomeKey(TriggerLastOutcome outcome) => Enum.IsDefined(outcome) ? outcome.ToString() : "Unknown";
    private static UiStatus OutcomeStatus(TriggerLastOutcome outcome) => outcome switch { TriggerLastOutcome.Submitted => UiStatus.Success, TriggerLastOutcome.Skipped => UiStatus.Warning, TriggerLastOutcome.Failed => UiStatus.Danger, _ => UiStatus.Neutral };
    private string Navigate(string path) => ResourceOwnershipContext.PreserveNavigation(path, Services);
    private string DetailsUrl(TriggerResource trigger) => ResourceOwnershipContext.Resource(Services, "/triggers", trigger.Name, trigger.Namespace, TriggerUi.DefinitionScope(trigger));
    private string FlowUrl(TriggerResource trigger) => trigger.Definition.Target.Flow is { } flow ? Navigate(ConsoleResourceUrls.Flow(new FlowId(flow.Name, flow.Namespace ?? trigger.Namespace), flow.ScopeRef)) : "#";
    private static IReadOnlyDictionary<string, object> TriggerAttributes(TriggerResource trigger) => new Dictionary<string, object> { ["data-trigger-name"] = trigger.Name };
}
