<div class="artifact-reference">
    <CollectionIdentity DisplayName="@Name" Name="@Identifier" Href="@Href" IconName="document" title="@Identifier" />
    <span class="sr-only">@IdentifierLabel</span>
</div>

@code {
    [Parameter] public string? Href { get; set; }
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Identifier { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string IdentifierLabel { get; set; } = string.Empty;
}
