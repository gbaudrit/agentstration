@page "/agents"
@implements IDisposable
@inject ConsoleContextState Context
@inject IServiceProvider Services
@inject IManagementApiClient Client
@inject NotificationState Notifications
@inject Microsoft.Extensions.Localization.IStringLocalizer<AgentsStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<DeploymentStrings> DeploymentLocalizer

<PageTitle>@T("PageTitle")</PageTitle>
<ResourceCollectionTemplate TItem="AgentSummary" Title="@T("Agents")" Description="@T("Description")" TestId="resource-agents" ContextKey="@contextKey"
                            IdentityColumn="IdentityColumn" Columns="Columns" Items="@(items ?? [])" RowTestId="agent-row" Query="query" QueryChanged="ChangeQueryAsync"
                            Pagination="Pagination" LoadState="loadState" Disabled="@(!interactive || deleting)" EmptyTitle="@T("EmptyTitle")" EmptyMessage="@T("EmptyMessage")" OnRefresh="LoadAsync" OnRetry="RetryAsync">
    <PrimaryActions>@if (CanCreate) { <a class="button-primary" href="@CreateUrl">@T("CreateAgent")</a> }</PrimaryActions>
    <EmptyActions>@if (CanCreate) { <a class="button-primary" href="@CreateUrl">@T("CreateAgent")</a> }</EmptyActions>
    <Feedback>
        @if (!deploymentWindowComplete) { <p class="help-text">@T("List.DeploymentWindowLimited")</p> }
        @if (error is not null) { <ErrorState Message="@error.Message" ErrorId="@error.ErrorId"><button class="button-secondary" @onclick="LoadAsync">@T("Retry")</button></ErrorState> }
    </Feedback>
    <ItemActions Context="item"><CollectionActions ResourceName="@($"{item.Name} ({item.Namespace}/{item.Id}, {item.ScopeRef})")">
        <a href="@EditUrl(item)">@T("Open")</a>
        @if (item.Namespace.IsDefault) { <PermissionGate Permission="@AuthorizationPermissions.RunsExecute"><a href="@RunUrl(item)">@T("Run")</a></PermissionGate> }
        @if (item.Namespace.IsDefault && !item.IsManaged && ResourceOwnershipContext.CanManage(item.ScopeRef, Services)) { <PermissionGate Permission="@AuthorizationPermissions.ResourcesWrite"><a href="@EditUrl(item)#definition/configuration">@T("EditDefinition")</a></PermissionGate><PermissionGate Permission="@AuthorizationPermissions.ResourcesDelete"><button class="danger-text" type="button" disabled="@deleting" @onclick="() => RequestDelete(item)">@T("Delete")</button></PermissionGate> }
        <button type="button" @onclick="() => selected = item">@T("QuickInspect")</button>
    </CollectionActions></ItemActions>
</ResourceCollectionTemplate>

@if (selected is not null)
{
    <aside class="quick-inspector" aria-label="@T("QuickInspector")">
        <header><div><p class="eyebrow">@T("Agents")</p><h2>@selected.Name</h2><StatusIndicator Text="@StatusLabel(selected.Status)" Status="@StatusPresentation.Tone(selected.Status)" /></div><button class="icon-button" @onclick="() => selected = null" aria-label="@T("CloseInspector")">×</button></header>
        <dl class="resource-details resource-section"><dt>@T("Namespace")</dt><dd><code>@selected.Namespace.Value</code></dd><dt>@T("Definition")</dt><dd>@ResourceName(selected.Type) · @F("Generation", selected.Version)</dd><dt>@T("ModelProfile")</dt><dd>@ResourceName(selected.ModelProfile)</dd><dt>@T("Deployment")</dt><dd>@if (selected.DeploymentUrl is not null) { <a class="text-button" href="@DeploymentUrl(selected)">@selected.DeploymentId</a><span class="resource-secondary"><StatusBadge Text="@DeploymentStatusLabel(selected.Runtime)" Status="@PlatformDashboardService.ToStatus(selected.Runtime)" /></span> } else { @DeploymentStatusLabel(selected.Runtime) }</dd><dt>@T("ResourceId")</dt><dd><code>@selected.Id</code></dd></dl>
        <div class="quick-inspector-actions">@if(selected.Namespace.IsDefault){<PermissionGate Permission="@AuthorizationPermissions.RunsExecute"><a class="button-primary" href="@RunUrl(selected)">@T("RunAgent")</a></PermissionGate>}<a class="button-secondary" href="@EditUrl(selected)">@T("OpenDetails")</a></div>
    </aside>
}

<ConfirmationDialog IsOpen="@(pendingDelete is not null)" Title="@T("DeleteAgent")" Message="@DeleteMessage" ConfirmLabel="@T("DeleteAgent")" OnConfirm="DeleteAsync" OnCancel="CancelDelete" />

@code {
    private CollectionColumn<AgentSummary> IdentityColumn => new("identity", T("Agents"), item => @<CollectionIdentity DisplayName="@item.Name" Namespace="@item.Namespace.Value" Name="@item.Id" Href="@EditUrl(item)" IconName="agent" Domain="agent"><Versions><CollectionVersion Label="@T("GenerationHeader")" Value="@item.Version" /></Versions><IconBadges><ResourceScopeBadge ShowName ScopeRef="@item.ScopeRef" Kind="ResourceScopeKind.Workspace" IconOnly /><StatusBadge Text="@StatusLabel(item.Status)" Status="@StatusPresentation.Tone(item.Status)" IconOnly /><ManagedResourceBadge IsManaged="@item.IsManaged" IsReadOnly="@(!ResourceOwnershipContext.CanManage(item.ScopeRef, Services))" IconOnly /></IconBadges></CollectionIdentity>);
    private IReadOnlyList<CollectionColumn<AgentSummary>> Columns =>
    [
        new("definition", T("Definition"), item => @<strong>@ResourceName(item.Type)</strong>),
        new("model", T("ModelProfile"), item => @<a class="text-button" href="@ModelProfileUrl(item)">@ResourceName(item.ModelProfile)</a>),
        new("deployment", T("Deployment"), item => @<text>@if (item.DeploymentUrl is not null) { <span class="agent-deployment-line"><a class="text-button" href="@DeploymentUrl(item)">@item.DeploymentId</a><StatusBadge Text="@DeploymentStatusLabel(item.Runtime)" Status="@PlatformDashboardService.ToStatus(item.Runtime)" /></span> } else { <span>@DeploymentStatusLabel(item.Runtime)</span> }</text>),
        new("updated", T("List.DeploymentUpdated"), item => @<text>@LastActivity(item.LastActivity)</text>)
    ];
}
