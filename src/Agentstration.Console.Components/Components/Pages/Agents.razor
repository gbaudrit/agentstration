@page "/agents"
@implements IDisposable
@inject ConsoleContextState Context
@inject IServiceProvider Services
@inject IManagementApiClient Client
@inject NotificationState Notifications
@inject Microsoft.Extensions.Localization.IStringLocalizer<AgentsStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<DeploymentStrings> DeploymentLocalizer

<PageTitle>@T("PageTitle")</PageTitle>
<ResourceCollectionTemplate TItem="AgentSummary" Title="@T("Agents")" Description="@T("Description")" TestId="resource-agents" ContextKey="@contextKey"
                            IdentityColumn="IdentityColumn" Columns="Columns" Items="@(items ?? [])" RowTestId="agent-row" Query="query" QueryChanged="ChangeQueryAsync"
                            Pagination="Pagination" LoadState="loadState" Disabled="@(!interactive || deleting)" EmptyTitle="@T("EmptyTitle")" EmptyMessage="@T("EmptyMessage")" OnRefresh="LoadAsync" OnRetry="RetryAsync">
    <PrimaryActions>@if (CanCreate) { <a class="button-primary" href="@CreateUrl">@T("CreateAgent")</a> }</PrimaryActions>
    <EmptyActions>@if (CanCreate) { <a class="button-primary" href="@CreateUrl">@T("CreateAgent")</a> }</EmptyActions>
    <Feedback>
        @if (!deploymentWindowComplete) { <p class="help-text">@T("List.DeploymentWindowLimited")</p> }
        @if (error is not null) { <ErrorState Message="@error.Message" ErrorId="@error.ErrorId"><button class="button-secondary" @onclick="LoadAsync">@T("Retry")</button></ErrorState> }
    </Feedback>
    <ItemActions Context="item"><CollectionActions ResourceName="@($"{item.Name} ({item.Namespace}/{item.Id}, {item.ScopeRef})")" Destructive="@DeleteAction(item)" ShowDestructiveActions="ShowDeleteAction">
        <a href="@OverviewUrl(item)"><UiIcon Name="arrow-up-right" /><span>@T("Open")</span></a>
        @if (!item.IsManaged && item.ScopeRef?.Value == Context.Current?.SelectedScopeRef && ResourceOwnershipContext.CanManage(item.ScopeRef, Services)) { <PermissionGate Permission="@AuthorizationPermissions.ResourcesWrite"><a href="@DefinitionUrl(item)"><UiIcon Name="pencil" /><span>@T("EditDefinition")</span></a></PermissionGate> }
        @if (item.Namespace.IsDefault) { <PermissionGate Permission="@AuthorizationPermissions.RunsExecute"><a href="@RunUrl(item)"><UiIcon Name="play-circle" /><span>@T("Run")</span></a></PermissionGate> }
        <button type="button" data-testid="agent-preview" disabled="@(item.ScopeRef is null)" @onclick="() => OpenPreview(item)"><UiIcon Name="eye" /><span>@T("Preview")</span></button>
    </CollectionActions></ItemActions>
</ResourceCollectionTemplate>

<ResourceCollectionPreview @ref="preview" ResourceKind="@AgentResourceKinds.Agent" ContextKey="@contextKey" Enabled="@(contextKey is not null && Context.Error is null && loadState.Status != ResourceLoadStatus.Forbidden && Context.HasPermission(AuthorizationPermissions.ResourcesRead))">
    <ChildContent Context="address"><AgentResourcePreview Address="address" OverviewHref="@PreviewUrl(address, "overview")" DefinitionHref="@PreviewUrl(address, "definition/configuration")" RunHref="@PreviewRunUrl(address)" /></ChildContent>
</ResourceCollectionPreview>

<ConfirmationDialog IsOpen="@(pendingDelete is not null)" Title="@T("DeleteAgent")" Message="@DeleteMessage" ConfirmLabel="@T("DeleteAgent")" OnConfirm="DeleteAsync" OnCancel="CancelDelete" />

@code {
    [Parameter] public bool ShowDeleteAction { get; set; } = true;
    private ResourceCollectionPreview? preview;
    private void OpenPreview(AgentSummary item) { if (item.ScopeRef is { } owner) preview?.Open(ScopedResourceAddress.Create(owner, item.Namespace, AgentResourceKinds.Agent, item.Id)); }
    private string PreviewUrl(ScopedResourceAddress address, string section) => ResourceOwnershipContext.PreserveNavigation(ConsoleResourceUrls.Agent(address.Namespace, address.Name, address.ScopeRef), Services).Split('#')[0] + "#" + section;
    private string PreviewRunUrl(ScopedResourceAddress address) => ConsoleResourceUrls.WithOwnerScope(ResourceOwnershipContext.PreserveNavigation($"/agents/{Uri.EscapeDataString(address.Name)}/run", Services), address.ScopeRef);
    private RenderFragment? DeleteAction(AgentSummary item) => !CanDelete(item) ? null : @<button class="danger-text" type="button" disabled="@deleting" @onclick="() => RequestDelete(item)"><UiIcon Name="trash" /><span>@T("Delete")</span></button>;
    private CollectionColumn<AgentSummary> IdentityColumn => new("identity", T("Agents"), item => @<CollectionIdentity DisplayName="@item.Name" Namespace="@item.Namespace.Value" Name="@item.Id" Href="@OverviewUrl(item)" IconName="agent" Domain="agent"><Versions><CollectionVersion Label="@T("GenerationHeader")" Value="@item.Version" /></Versions><IconBadges><ResourceScopeBadge ShowName ScopeRef="@item.ScopeRef" Kind="ResourceScopeKind.Workspace" IconOnly /><StatusBadge Text="@StatusLabel(item.Status)" Status="@StatusPresentation.Tone(item.Status)" IconOnly /><ManagedResourceBadge IsManaged="@item.IsManaged" IsReadOnly="@(!ResourceOwnershipContext.CanManage(item.ScopeRef, Services))" IconOnly /></IconBadges></CollectionIdentity>);
    private IReadOnlyList<CollectionColumn<AgentSummary>> Columns =>
    [
        new("definition", T("Definition"), item => @<strong>@ResourceName(item.Type)</strong>),
        new("model", T("ModelProfile"), item => @<a class="text-button" href="@ModelProfileUrl(item)">@ResourceName(item.ModelProfile)</a>),
        new("deployment", T("Deployment"), item => @<text>@if (item.DeploymentUrl is not null) { <span class="agent-deployment-line"><a class="text-button" href="@DeploymentUrl(item)">@item.DeploymentId</a><StatusBadge Text="@DeploymentStatusLabel(item.Runtime)" Status="@PlatformDashboardService.ToStatus(item.Runtime)" /></span> } else { <span>@DeploymentStatusLabel(item.Runtime)</span> }</text>),
        new("updated", T("List.DeploymentUpdated"), item => @<text>@LastActivity(item.LastActivity)</text>)
    ];
}
