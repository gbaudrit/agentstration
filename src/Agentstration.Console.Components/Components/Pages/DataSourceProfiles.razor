@page "/data-source-profiles"
@implements IDisposable
@inject IDataSourceProfilesClient Client
@inject IServiceProvider Services
@inject ConsoleContextState Context
@inject Microsoft.Extensions.Localization.IStringLocalizer<DataSourcesStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<ExtensionStrings> ExtensionLocalizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared

<PageTitle>@T("Profiles") · Agentstration</PageTitle>
<ResourceCollectionTemplate TItem="DataSourceProfileResource" Title="@T("Profiles")" Description="@T("ProfilesHelp")"
                            TestId="resource-data-source-profiles" ContextKey="@contextKey" IconName="database"
                            IdentityColumn="IdentityColumn" Columns="Columns" AdditionalFilters="ExtraFilters" Items="PageItems"
                            Query="query" QueryChanged="ChangeQueryAsync" Pagination="Pagination" LoadState="loadState"
                            SearchEnabled SearchLabel="@Shared["Search"]" SearchPlaceholder="@Shared["Search"]"
                            EmptyTitle="@T("Profiles")" EmptyMessage="@T("EmptyProfiles")" EmptyActions="CreateAction" PrimaryActions="CreateAction"
                            OnRefresh="LoadAsync" OnRetry="RetryAsync">
    <Actions><a class="button-secondary" href="@ResourceOwnershipContext.PreserveNavigation("/data-sources", Services)">@T("DataSources")</a></Actions>
    <ItemActions Context="item"><CollectionActions ResourceName="@item.Name">
        <a href="@(Url(item) + "#overview")"><UiIcon Name="arrow-up-right" />@Shared["OpenItem"]</a>
        @if (CanPreviewEdit(item)) { <a href="@(Url(item) + "#definition/configuration")"><UiIcon Name="pencil" />@Shared["EditDefinition"]</a> }
        <button type="button" disabled="@(item.ScopeRef is null)" data-testid="data-source-profile-preview" @onclick="() => OpenPreview(item)"><UiIcon Name="eye" />@Shared["Preview"]</button>
    </CollectionActions></ItemActions>
</ResourceCollectionTemplate>

<ResourceCollectionPreview @ref="preview" ResourceKind="@DataSourceResourceKinds.DataSourceProfile" ContextKey="@contextKey" Enabled="@(contextKey is not null && Context.Error is null && loadState.Status != ResourceLoadStatus.Forbidden && Context.HasPermission(AuthorizationPermissions.ResourcesRead))">
    <ChildContent Context="address"><DataSourceProfileResourcePreview Address="address" OverviewHref="@PreviewUrl(address, "overview")" DefinitionHref="@PreviewUrl(address, "definition/configuration")" /></ChildContent>
</ResourceCollectionPreview>

@code {
    private ResourceCollectionPreview? preview;
    private bool CanPreviewEdit(DataSourceProfileResource item) => !item.Governance.IsManaged && Context.HasPermission(AuthorizationPermissions.ResourcesWrite) && item.ScopeRef?.Value == Context.Current?.SelectedScopeRef && ResourceOwnershipContext.CanManage(item.ScopeRef, Services);
    private void OpenPreview(DataSourceProfileResource item) { if (item.ScopeRef is { } owner) preview?.Open(ScopedResourceAddress.Create(owner, item.Namespace, DataSourceResourceKinds.DataSourceProfile, item.Name)); }
    private string PreviewUrl(ScopedResourceAddress address, string section) => ResourceOwnershipContext.Resource(Services, "/data-source-profiles", address.Name, address.Namespace, address.ScopeRef).Split('#')[0] + "#" + section;
    private string T(string key) => Localizer[key];
    private RenderFragment? CreateAction => Context.HasPermission(AuthorizationPermissions.ResourcesWrite)
        ? @<PermissionGate Permission="@AuthorizationPermissions.ResourcesWrite"><a class="button-primary" href="@ResourceOwnershipContext.PreserveNavigation("/data-source-profiles/new", Services)">@T("Create")</a></PermissionGate> : null;
    private CollectionColumn<DataSourceProfileResource> IdentityColumn => new("identity", T("Name"), item => @<CollectionIdentity DisplayName="@item.Definition.DisplayName" Namespace="@item.Namespace.Value" Name="@item.Name" Href="@(Url(item) + "#overview")" IconName="database" Domain="data">
        <Versions><CollectionVersion Label="@T("PublishedVersion")" Value="@(item.PublishedVersion ?? item.ActiveVersion)" /></Versions>
        <IconBadges><ResourceScopeBadge ShowName ScopeRef="@item.ScopeRef" IconOnly /><ManagedResourceBadge IsManaged="@item.Governance.IsManaged" IsReadOnly="@(!ResourceOwnershipContext.CanManage(item.ScopeRef, Services))" IconOnly /></IconBadges>
    </CollectionIdentity>);
    private IReadOnlyList<CollectionColumn<DataSourceProfileResource>> Columns =>
    [
        new("extension", ExtensionLocalizer["ManagingExtension"], item => @<text>@if (Owner(item) is { } owner) {
            <a href="@owner.ExtensionUrl">@owner.Extension.DisplayName</a><br />
            <code>@owner.Installation.ExtensionId</code><span> · @owner.Installation.ExtensionVersion</span><br />
            <span>@ExtensionLocalizer["Bundle"]: @owner.Installation.BundleId · @owner.Installation.BundleVersion</span>
        } else if (item.Governance.Origin.Kind == ResourceOriginKind.Extension) {
            <span>@item.Governance.Origin.Reference · @item.Governance.Origin.Version</span>
        } else { <span>—</span> }</text>)
    ];
    private IReadOnlyList<CollectionFilter> ExtraFilters =>
    [
        new("namespace", T("Namespace"), CollectionFilterKind.Choice)
        {
            Options = (items ?? []).Select(item => item.Namespace.Value).Distinct(StringComparer.Ordinal).Order().Select(value => new CollectionFilterOption(value, value)).ToArray()
        }
    ];
    private ExtensionManagedResourceOwner? Owner(DataSourceProfileResource item) => item.ScopeRef is { } scope
        ? ExtensionManagedResourceOwner.Find(extensions, item.Governance, scope, item.Namespace, item.Kind, item.Name, item.Uid)
        : null;
    private string Url(DataSourceProfileResource item) => ResourceOwnershipContext.Resource(Services, "/data-source-profiles", item.Name, item.Namespace, item.ScopeRef);
}
