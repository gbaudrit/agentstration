@page "/secrets"
@implements IDisposable
@inject IServiceProvider Services
@inject ISecretsClient Client
@inject ConsoleContextState Context
@inject Microsoft.Extensions.Localization.IStringLocalizer<SecretStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared

<PageTitle>@T("Secrets") · Agentstration</PageTitle>
<ResourceCollectionTemplate TItem="SecretResponse" Title="@T("Secrets")" Description="@T("Secrets.Description")" TestId="resource-secrets"
                            IdentityColumn="IdentityColumn" Columns="Columns" AdditionalFilters="ExtraFilters" Items="PageItems" ContextKey="@contextKey"
                            Query="query" QueryChanged="ChangeQueryAsync" Pagination="Pagination" LoadState="loadState" Disabled="@(!interactive)"
                            SearchEnabled SearchLabel="@Shared["Search"]" SearchPlaceholder="@Shared["Search"]"
                            EmptyTitle="@T("NoSecrets")" EmptyMessage="@T("NoSecretsMessage")" PrimaryActions="CreateAction" EmptyActions="CreateAction"
                            OnRefresh="LoadAsync" OnRetry="RetryAsync">
    <Navigation><ResourceTabs Label="@T("SecretManagement")"><a class="active" href="@Navigate("/secrets")">@T("Secrets")</a><a href="@Navigate("/vaults")">@T("Vaults")</a></ResourceTabs></Navigation>
    <ItemActions Context="item"><CollectionActions ResourceName="@item.Resource.Name">
        <a href="@(ResourceUrl(item.Resource) + "#overview")"><UiIcon Name="arrow-up-right" />@Shared["OpenItem"]</a>
        @if (CanPreviewEdit(item.Resource)) { <a href="@(ResourceUrl(item.Resource) + "#definition/configuration")"><UiIcon Name="pencil" />@Shared["EditDefinition"]</a> }
        <button type="button" disabled="@(item.Resource.ScopeRef is null)" data-testid="secret-preview" @onclick="() => OpenPreview(item.Resource)"><UiIcon Name="eye" />@Shared["Preview"]</button>
    </CollectionActions></ItemActions>
</ResourceCollectionTemplate>

<ResourceCollectionPreview @ref="preview" ResourceKind="@SecretResourceKinds.Secret" ContextKey="@contextKey" Enabled="@(contextKey is not null && Context.Error is null && loadState.Status != ResourceLoadStatus.Forbidden && Context.HasPermission(AuthorizationPermissions.ResourcesRead))">
    <ChildContent Context="address"><SecretResourcePreview Address="address" OverviewHref="@PreviewUrl(address, "overview")" DefinitionHref="@PreviewUrl(address, "definition/configuration")" /></ChildContent>
</ResourceCollectionPreview>

@code {
    private ResourceCollectionPreview? preview;
    private bool CanPreviewEdit(SecretResource item) => !item.Governance.IsManaged && Context.HasPermission(AuthorizationPermissions.ResourcesWrite) && ResourceOwnershipContext.CanManage(item.ScopeRef, Services);
    private void OpenPreview(SecretResource item) { if (item.ScopeRef is { } owner) preview?.Open(ScopedResourceAddress.Create(owner, item.Namespace, SecretResourceKinds.Secret, item.Name)); }
    private string PreviewUrl(ScopedResourceAddress address, string section) => ResourceOwnershipContext.Resource(Services, "/secrets", address.Name, address.Namespace, address.ScopeRef).Split('#')[0] + "#" + section;
    private string T(string key) => Localizer[key].Value;
    private string StatusText(string status) => T($"Status.{StatusValue(status)}");
    private string TypeText(SecretType type) => type == SecretType.Opaque ? T("Type.Opaque") : T("Status.Unknown");
    private RenderFragment? CreateAction => Context.HasPermission(AuthorizationPermissions.ResourcesWrite)
        ? @<PermissionGate Permission="@AuthorizationPermissions.ResourcesWrite"><a class="button-primary" href="@Navigate("/secrets/new")">@T("CreateSecret")</a></PermissionGate> : null;
    private CollectionColumn<SecretResponse> IdentityColumn => new("identity", T("Name"), item => @<CollectionIdentity DisplayName="@item.Resource.Definition.DisplayName" Namespace="@item.Resource.Namespace.Value" Name="@item.Resource.Name" Href="@(ResourceUrl(item.Resource) + "#overview")" IconName="lock" Domain="neutral">
        <IconBadges><ResourceScopeBadge ScopeRef="item.Resource.ScopeRef" ShowName IconOnly /><StatusBadge Text="@StatusText(item.ValueStatus)" Status="@Tone(item.ValueStatus)" IconOnly /><ManagedResourceBadge IsManaged="@item.Resource.Governance.IsManaged" IsReadOnly="@(!ResourceOwnershipContext.CanManage(item.Resource.ScopeRef, Services))" IconOnly /></IconBadges>
    </CollectionIdentity>)
    {
        Filters = [new("status", T("Status"), CollectionFilterKind.Choice)
        {
            Options = new[] { "Configured", "Missing", "Unavailable", "VaultUnavailable", "Unknown" }.Select(value => new CollectionFilterOption(value, StatusText(value))).ToArray()
        }]
    };
    private IReadOnlyList<CollectionColumn<SecretResponse>> Columns =>
    [
        new("vault", T("Vault"), item => @<span>@item.Resource.Definition.Vault.Name</span>)
        {
            Filters = [new("vault", T("Vault"), CollectionFilterKind.Choice)
            {
                Options = (items ?? []).Select(item => item.Resource.Definition.Vault.Name).Distinct(StringComparer.Ordinal).Order().Select(value => new CollectionFilterOption(value, value)).ToArray()
            }]
        },
        new("type", T("Type"), item => @<span>@TypeText(item.Resource.Definition.SecretType)</span>)
        {
            Filters = [new("type", T("Type"), CollectionFilterKind.Choice) { Options = [new(nameof(SecretType.Opaque), TypeText(SecretType.Opaque))] }]
        }
    ];
    private IReadOnlyList<CollectionFilter> ExtraFilters => [new("scope", Shared["Scope"], CollectionFilterKind.Choice)
    {
        Options = (items ?? []).Select(item => item.Resource.ScopeRef?.Value).OfType<string>().Distinct(StringComparer.Ordinal).Order().Select(value => new CollectionFilterOption(value, Context.Current?.Contexts.FirstOrDefault(context => context.ScopeRef == value)?.DisplayName ?? value)).ToArray()
    }];
    private static string StatusValue(string status) => status.ToLowerInvariant() switch { "configured" => "Configured", "missing" => "Missing", "unavailable" => "Unavailable", "vaultunavailable" => "VaultUnavailable", _ => "Unknown" };
    private static UiStatus Tone(string value) => value.ToLowerInvariant() switch { "configured" => UiStatus.Success, "missing" => UiStatus.Warning, "unavailable" or "vaultunavailable" => UiStatus.Danger, _ => UiStatus.Neutral };
    private string Navigate(string path) => ResourceOwnershipContext.PreserveNavigation(path, Services);
    private string ResourceUrl(SecretResource resource) => Navigate($"/secrets/{Uri.EscapeDataString(resource.Name)}?scopeRef={Uri.EscapeDataString(resource.ScopeRef!.Value.Value)}");
}
