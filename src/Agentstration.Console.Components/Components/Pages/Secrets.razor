@inject IServiceProvider Services
@page "/secrets"
@implements IDisposable
@inject ISecretsClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<SecretStrings> Localizer

<PageTitle>@T("Secrets") · Agentstration</PageTitle>
<PageHeader Title="@T("Secrets")" Description="@T("Secrets.Description")" TestId="resource-secrets">
    <Actions><button class="button-secondary" @onclick="LoadAsync">@T("Refresh")</button><a class="button-primary" href="/secrets/new">@T("CreateSecret")</a></Actions>
</PageHeader>
<ResourceTabs Label="@T("SecretManagement")"><a class="active" href="/secrets">@T("Secrets")</a><a href="/vaults">@T("Vaults")</a></ResourceTabs>
<div class="toolbar">
    <input @bind="search" @bind:event="oninput" placeholder="@T("SearchSecrets")" aria-label="@T("SearchSecrets")" />
    <select @bind="vaultFilter" aria-label="@T("FilterByVault")"><option value="">@T("AllVaults")</option>@foreach (var vault in vaults) { <option value="@vault">@vault</option> }</select>
    <select @bind="statusFilter" aria-label="@T("FilterByStatus")"><option value="">@T("AllStatuses")</option><option value="Configured">@StatusText("Configured")</option><option value="Missing">@StatusText("Missing")</option><option value="Unavailable">@StatusText("Unavailable")</option><option value="VaultUnavailable">@StatusText("VaultUnavailable")</option></select>
</div>
@if (loading) { <LoadingState Message="@T("LoadingSecrets")" /> }
else if (error is not null) { <div class="form-alert form-alert-danger">@error.Message</div> }
else if (Filtered.Count == 0) { <EmptyState Title="@T("NoSecrets")" Message="@T("NoSecretsMessage")" /> }
else
{
    <CollectionView TItem="SecretResponse" Items="Filtered" InformationLabels="@(new string[] { T("Vault"), T("Type") })" >
        <Identity Context="item"><CollectionIdentity DisplayName="@item.Resource.Definition.DisplayName" Namespace="@item.Resource.Namespace.Value" Name="@item.Resource.Name" Href="@ResourceUrl(item.Resource)" IconName="lock" Domain="neutral" ><IconBadges><ResourceScopeBadge ScopeRef="item.Resource.ScopeRef" ShowName IconOnly /><StatusBadge Text="@StatusText(item.ValueStatus)" Status="@Tone(item.ValueStatus)" IconOnly /><ManagedResourceBadge IsManaged="@item.Resource.Governance.IsManaged" IsReadOnly="@(!ResourceOwnershipContext.CanManage(item.Resource.ScopeRef, Services))" IconOnly /></IconBadges></CollectionIdentity></Identity>
        <Information Context="item">
            <CollectionValue Label="@T("Vault")">@item.Resource.Definition.Vault.Name</CollectionValue>
            <CollectionValue Label="@T("Type")">@item.Resource.Definition.SecretType</CollectionValue>
        </Information>
        <Actions Context="item"><CollectionActions ResourceName="@($"{item.Resource.Definition.DisplayName} ({item.Resource.Namespace}/{item.Resource.Name}, {item.Resource.ScopeRef})")"><a href="@ResourceUrl(item.Resource)">@T("ManageArrow")</a></CollectionActions></Actions>
    </CollectionView>
}

@code {
    private readonly CancellationTokenSource cancellation = new();
    private IReadOnlyList<SecretResponse> items = [];
    private bool loading = true;
    private Exception? error;
    private string search = "", vaultFilter = "", statusFilter = "";
    private IReadOnlyList<string> vaults => items.Select(x => x.Resource.Definition.Vault.Name).Distinct().Order().ToArray();
    private IReadOnlyList<SecretResponse> Filtered => items.Where(x => (string.IsNullOrWhiteSpace(search) || x.Resource.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || x.Resource.Definition.DisplayName.Contains(search, StringComparison.OrdinalIgnoreCase)) && (vaultFilter.Length == 0 || x.Resource.Definition.Vault.Name == vaultFilter) && (statusFilter.Length == 0 || x.ValueStatus.Equals(statusFilter, StringComparison.OrdinalIgnoreCase))).ToArray();
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    private string StatusText(string status) => T($"Status.{(new[] { "Configured", "Missing", "Unavailable", "VaultUnavailable" }.FirstOrDefault(value => value.Equals(status, StringComparison.OrdinalIgnoreCase)) ?? "Unknown")}");
    private static string ResourceUrl(SecretResource resource) => $"/secrets/{Uri.EscapeDataString(resource.Name)}?scopeRef={Uri.EscapeDataString(resource.ScopeRef!.Value.Value)}";
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync() { loading = true; error = null; try { items = await Client.GetSecretsAsync(cancellation.Token); } catch (Exception ex) { error = ex; } finally { loading = false; } }
    private static UiStatus Tone(string value) => value.ToLowerInvariant() switch { "configured" => UiStatus.Success, "missing" => UiStatus.Warning, "unavailable" or "vaultunavailable" => UiStatus.Danger, _ => UiStatus.Neutral };
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
