@page "/tools/definitions/new"
@using Microsoft.AspNetCore.Components.Sections
@implements IDisposable
@inject IToolDefinitionsClient Definitions
@inject IFlowApiClient Flows
@inject IConsoleNavigationContext NavigationContext
@inject ConsoleContextState ContextState
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<ToolsStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared

<UnsavedNavigationGuard IsDirty="@IsDirty" HasUnsavedChanges="@(() => IsDirty)" />
<PageTitle>@T("CreationTitle") · Agentstration</PageTitle>
<PageHeader ScopeRef="identity.ScopeRef" Title="@T("CreationTitle")" Description="@T("CreationDescription")" TestId="resource-tool-definition-editor"><Actions><a class="button-secondary" href="@NavigationContext.AddToUri("/tools/definitions")">@T("Cancel")</a></Actions></PageHeader>
<div class="tool-create-shell" data-testid="tool-definition-create" data-interactive="@((interactive && contextLoaded).ToString().ToLowerInvariant())">
@if (!contextLoaded) { <LoadingState Message="@T("LoadingDefinitions")" /> }
else
{
    @if (ContextState.Current is not null && !ContextState.HasPermission("resources/write")) { <ResourceReadOnlyNotice Reason="ResourceReadOnlyReason.InsufficientPermissions" /> }
    @if (identityValidationRequested && CanManage && !IdentityComplete) { <p class="error-panel" role="alert">@T("CreationIdentityInvalid")</p> }
    @if (error is not null) { <p class="error-panel" role="alert">@error</p> }
    <EditForm Model="identity" OnSubmit="SubmitAsync" class="resource-form">
        <FormDraftMonitor InvalidInputChanged="value => invalidInput = value" />
        <p class="required-fields-note"><span aria-hidden="true">*</span> @Shared["RequiredFields"]</p>
        <fieldset class="resource-definition-fields" disabled="@(saving || !interactive || !CanManage)">
            <CreationWizard @key="scopeVersion" @ref="wizard" Steps="Steps" Busy="saving" Disabled="@(!interactive || !CanManage)" OnStepChanging="ChangingStepAsync" OnFinish="FinishAsync" FinishLabel="@T("CreationCreateDraft")" FinishTestId="tool-definition-create-draft" />
        </fieldset>
    </EditForm>
    <SectionOutlet SectionId="@relayDialogs" />
}
</div>

@code {
    private RenderFragment IdentityFields => @<div>            <section class="panel tool-create-section" data-testid="tool-definition-identity">
                <div class="panel-header tool-create-section-header"><div><p class="eyebrow">@T("CreationIdentityEyebrow")</p><h2>@T("CreationIdentityTitle")</h2><p>@T("CreationIdentityHelp")</p></div></div>
                <div class="form-grid tool-create-identity-grid">
                    <ResourceIdentityFields @bind-DisplayName="identity.DisplayName" @bind-TechnicalName="identity.Name" IsNew="true" DisplayNameHelp="@T("CreationDisplayNameHelp")" TechnicalNameHelp="@T("CreationTechnicalNameHelp")" DisplayNameTestId="tool-definition-display-name" TechnicalNameTestId="tool-definition-name" />
                    <FormField Label="@T("CreationInitialVersion")" Help="@T("CreationInitialVersionHelp")"><ClearableText UpdateOnInput="false" @bind-Value="identity.Version" data-testid="tool-definition-initial-version" /></FormField>
                    <div><ResourceScopeFormField @key="lastContextScope" ResourceKind="@ToolResourceKinds.ToolDefinition" Value="identity.ScopeRef" ValueChanged="ScopeChanged" /><small>@T("CreationScopeHelp")</small></div>
                    <FormField Label="@T("Namespace")"><ClearableText UpdateOnInput="false" @bind-Value="identity.Namespace" data-testid="tool-definition-namespace" /></FormField>
                    <FormField Label="@T("DefinitionDescription")" Class="tool-create-span-all" Help="@T("CreationDescriptionHelp")"><ClearableText UpdateOnInput="false" Multiline="true" @bind-Value="identity.Description" rows="3" data-testid="tool-definition-description" /></FormField>
                </div>
            </section>
            <section class="panel tool-create-section">
                <div class="panel-header tool-create-section-header"><div><p class="eyebrow">@T("CreationKindEyebrow")</p><h2>@T("CreationKindTitle")</h2><p>@T("CreationKindHelp")</p></div></div>
                <div class="tool-kind-grid" role="group" aria-label="@T("CreationKindTitle")">
                <InputRadioGroup @bind-Value="kind">
                    <label class="tool-kind-card @(kind == "flow" ? "is-selected" : null)" data-testid="tool-definition-kind-flow">
                        <InputRadio Value="@("flow")" /><span class="tool-kind-icon"><UiIcon Name="workflow" /></span><span class="tool-kind-copy"><strong>@T("CreationKindFlow")</strong><small>@T("CreationKindFlowHelp")</small></span><span class="tool-kind-check"><UiIcon Name="check" /></span>
                    </label>
                    <label class="tool-kind-card @(kind == "relay" ? "is-selected" : null)" data-testid="tool-definition-kind-relay">
                        <InputRadio Value="@("relay")" /><span class="tool-kind-icon"><UiIcon Name="tools" /></span><span class="tool-kind-copy"><strong>@T("CreationKindRelay")</strong><small>@T("CreationKindRelayHelp")</small></span><span class="tool-kind-check"><UiIcon Name="check" /></span>
                    </label>
                </InputRadioGroup>
                </div>
            </section>
</div>;
    private RenderFragment ConfigurationFields => @<div>
        <div hidden="@(kind != "relay")">@if (relayVisited) { <ToolRelayEditor @ref="relayEditor" DialogSectionId="@relayDialogs" CreationIdentity="identity" Source="@(SourceScopeValid ? Source : null)" SourceScopeRef="SourceScope" ShowCreationActions="false" CreationCompletenessChanged="value => relayComplete = value" DraftChanged="value => relayDirty = value" OnCreated="Created" /> }</div>
        <div hidden="@(kind != "flow")">@if (flowVisited) {
                <section class="panel tool-create-section" data-testid="tool-definition-flow-configuration">
                    <div class="panel-header tool-create-section-header"><div><p class="eyebrow">@T("CreationFlowEyebrow")</p><h2>@T("CreationFlowTitle")</h2><p>@T("CreationFlowHelp")</p></div></div>
                    <div class="tool-create-summary"><span><strong>@identity.DisplayName</strong><code>@identity.Name</code><ResourceScopeBadge ScopeRef="identity.ScopeRef" Compact /></span><span>@T("RelayVersion") <strong>@identity.Version</strong></span></div>
                    @if (loadingFlow) { <LoadingState Message="@T("LoadingFlowContract")" /> }
                    <div class="form-grid">
                        <FormField Label="@T("Flow")"><ClearableSelect TValue="string" data-testid="tool-definition-flow" @bind-Value="selectedFlow" @bind-Value:after="FlowChangedAsync" disabled="@(loadingFlow || saving)"><option value="">@T("SelectFlow")</option>@foreach (var flow in flows) { <option value="@FlowKey(flow)">@flow.Name · @flow.ScopeRef · @flow.Namespace/@flow.Id</option> }</ClearableSelect></FormField>
                        <FormField Label="@T("CreationFlowVersion")"><ClearableSelect TValue="string" data-testid="tool-definition-version" @bind-Value="selectedVersion" @bind-Value:after="LoadContractAsync" disabled="@(loadingFlow || saving || versions.Count == 0)"><option value="">@T("CreationSelectVersion")</option>@foreach (var version in versions) { <option value="@version.Version">@version.Version</option> }</ClearableSelect></FormField>
                    </div>
                    @if (contractLoaded)
                    {
                        <p class="inline-info">@T("ContractsProvidedByFlow", selectedVersion)</p>
                        <ContractDirectionTabs Label="@T("Contracts")" InputLabel="@T("InputContract")" OutputLabel="@T("OutputContract")" TestId="tool-definition-contract">
                            <InputContent><ReusableSchemaBindingEditor Title="@T("InputSchema")" TestId="tool-definition-input-schema" LegacySchema="inputSchema" ReadOnly="true" ShowSourceControls="false" HelpText="@T("FlowContractReadOnlyHelp")" /></InputContent>
                            <OutputContent><ReusableSchemaBindingEditor Title="@T("OutputSchema")" TestId="tool-definition-output-schema" LegacySchema="outputSchema" ReadOnly="true" ShowSourceControls="false" HelpText="@T("FlowContractReadOnlyHelp")" /></OutputContent>
                        </ContractDirectionTabs>
                    }
                </section>
        }</div>
    </div>;
    private RenderFragment Review => @<FormSection Title="@Shared["Verification"]"><ChildContent>
        <dl class="resource-details"><dt>@Shared["Identity"]</dt><dd>@identity.DisplayName<br /><code>@identity.Namespace/@identity.Name</code></dd><dt>@Shared["Scope"]</dt><dd><ResourceScopeBadge ScopeRef="identity.ScopeRef" /></dd><dt>@T("RelayVersion")</dt><dd>@identity.Version</dd><dt>@T("CreationKindTitle")</dt><dd>@T(kind == "relay" ? "CreationKindRelay" : "CreationKindFlow")</dd></dl>
        @if (kind == "relay" && relayEditor is not null) { @relayEditor.CreationReview }
        else if (SelectedFlow is { } flow) { <dl class="resource-details"><dt>@T("Flow")</dt><dd><ResourceScopeBadge ScopeRef="flow.ScopeRef" /> <code>@flow.Namespace/@flow.Id</code></dd><dt>@T("CreationFlowVersion")</dt><dd>@selectedVersion</dd></dl> }
        <p>@T("CreationDraftHelp")</p>
    </ChildContent></FormSection>;

    [SupplyParameterFromQuery(Name = "toolKind")] public string? ToolKind { get; set; }
    [SupplyParameterFromQuery(Name = "source")] public string? Source { get; set; }
    [SupplyParameterFromQuery(Name = "sourceScopeRef")] public string? SourceScopeValue { get; set; }
    [SupplyParameterFromQuery(Name = "context")] public string? Context { get; set; }
    private readonly CancellationTokenSource cancellation = new();
    private ToolDefinitionCreationIdentity identity = new();
    private IReadOnlyList<FlowSummary> flows = [];
    private IReadOnlyList<FlowVersionResponse> versions = [];
    private string initialKind = "flow", kind = "flow", selectedFlow = "", selectedVersion = "";
    private int contractRequest, scopeVersion;
    private readonly object relayDialogs = new();
    private CreationWizard? wizard;
    private ToolRelayEditor? relayEditor;
    private bool relayComplete, relayDirty, invalidInput, created, identityValidationRequested;
    private bool interactive, contextLoaded, relayVisited, flowVisited, loadingFlow, saving, contractLoaded;
    private string? error;
    private JsonElement? inputSchema, outputSchema;
    private ResourceScopeRef? lastContextScope;
    private bool contextScopeInitialized;
    private bool IsDirty => contextLoaded && !created && (kind != initialKind || identity.ScopeRef != lastContextScope || invalidInput || relayDirty || !string.IsNullOrEmpty(identity.DisplayName) || !string.IsNullOrEmpty(identity.Name) || !string.IsNullOrEmpty(identity.Description) || identity.Namespace != "default" || identity.Version != "1.0.0" || !string.IsNullOrEmpty(selectedFlow));
    private bool SourceScopeValid { get { try { if (!string.IsNullOrWhiteSpace(SourceScopeValue)) _ = ResourceScopeRef.Parse(SourceScopeValue); return true; } catch (ArgumentException) { return false; } } }
    private ResourceScopeRef? SourceScope => SourceScopeValid && !string.IsNullOrWhiteSpace(SourceScopeValue) ? ResourceScopeRef.Parse(SourceScopeValue) : null;
    private bool IdentityComplete => identity.IsComplete && CanManage && NamespaceValid;
    private bool NamespaceValid { get { try { _ = ResourceNamespace.Parse(identity.Namespace); return true; } catch (ArgumentException) { return false; } } }
    private IReadOnlyList<CreationWizardStep> Steps => [
        new("identity", Shared["Identity"], IdentityFields) { IsComplete = IdentityComplete },
        new("configuration", T("CreationConfigure"), ConfigurationFields) { IsComplete = kind == "relay" ? relayComplete : contractLoaded && !loadingFlow },
        new("review", Shared["Verification"], Review) { IsComplete = IdentityComplete && (kind == "relay" ? relayComplete : contractLoaded && !loadingFlow) }
    ];
    private Task SubmitAsync() => wizard is null ? Task.CompletedTask : wizard.CurrentStepId == "review" ? wizard.FinishAsync() : wizard.ContinueAsync();
    private async Task ChangingStepAsync(CreationWizardStepChange change)
    {
        if (change.To == "configuration") await PrepareConfigurationAsync();
    }
    private async Task FinishAsync(CreationWizardFinish finish)
    {
        if (!interactive || saving || !CanManage) return;
        if (!ValidateIdentity()) { finish.ReturnToStepId = "identity"; return; }
        if (kind == "relay")
        {
            if (!relayComplete || relayEditor is null) { await PrepareConfigurationAsync(); finish.ReturnToStepId = "configuration"; return; }
            saving = true;
            try { await relayEditor.CreateDraftAsync(); }
            finally { saving = false; }
            if (!created) finish.ReturnToStepId = "configuration";
        }
        else if (!contractLoaded || loadingFlow || SelectedFlow is null) { await PrepareConfigurationAsync(); finish.ReturnToStepId = "configuration"; }
        else { await CreateFlowAsync(); if (!created) finish.ReturnToStepId = "configuration"; }
    }
    private bool CanManage => identity.ScopeRef is not null && ContextState.HasPermission("resources/write");
    private string T(string key, params object[] arguments) => Localizer[key, arguments];

    protected override async Task OnInitializedAsync()
    {
        kind = ToolKind == "relay" || !string.IsNullOrWhiteSpace(Source) ? "relay" : "flow";
        initialKind = kind;
        ContextState.Changed += ContextChanged;
        await ContextState.EnsureLoadedAsync(cancellation.Token);
        RefreshContext();
        if (identity.ScopeRef is null) error = ContextState.Error ?? T("CreationScopeRequired");
        contextLoaded = true;
    }

    protected override void OnParametersSet()
    {
        if (contextLoaded) RefreshContext();
    }

    private void ContextChanged() => _ = InvokeAsync(() =>
    {
        RefreshContext();
        StateHasChanged();
    });

    private void RefreshContext()
    {
        NavigationContext.SetSelectedScopeRef(ContextState.Current?.SelectedScopeRef);
        var scope = ContextState.Current is null ? null : ResourceOwnershipContext.TryGetCurrent(NavigationContext);
        if (contextScopeInitialized && scope == lastContextScope) return;
        lastContextScope = scope;
        contextScopeInitialized = true;
        ScopeChanged(scope);
    }

    private void ScopeChanged(ResourceScopeRef? scope)
    {
        if (scope == identity.ScopeRef) return;
        identity.ScopeRef = scope;
        // Sources and contracts loaded in one workspace must not be reused in another.
        scopeVersion++; relayEditor = null; relayComplete = relayDirty = false;
        relayVisited = flowVisited = contractLoaded = loadingFlow = false;
        flows = []; versions = []; selectedFlow = selectedVersion = "";
        inputSchema = outputSchema = null;
        contractRequest++;
        error = identity.ScopeRef is not null ? null : ContextState.Error ?? T("CreationScopeRequired");
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        interactive = true;
        StateHasChanged();
    }

    private bool ValidateIdentity()
    {
        if (!CanManage) { error = T("CreationScopeRequired"); return false; }
        identityValidationRequested = true;
        if (!IdentityComplete) return false;
        error = null;
        return true;
    }

    private async Task PrepareConfigurationAsync()
    {
        if (!interactive || !CanManage) return;
        if (kind == "relay") { relayVisited = true; return; }
        if (flowVisited) return;
        flowVisited = true; var request = ++contractRequest; loadingFlow = true;
        try
        {
            var available = await Flows.GetFlowsAsync(identity.ScopeRef!.Value, cancellation.Token);
            if (request == contractRequest) flows = available;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception) { if (request == contractRequest) error = exception.Message; }
        finally { if (request == contractRequest) loadingFlow = false; }
    }

    private FlowSummary? SelectedFlow => flows.SingleOrDefault(flow => FlowKey(flow) == selectedFlow);
    private static string FlowKey(FlowSummary flow) => $"{flow.ScopeRef}|{flow.Namespace}|{flow.Id}";

    private async Task FlowChangedAsync()
    {
        var request = ++contractRequest;
        contractLoaded = false; versions = []; selectedVersion = ""; error = null;
        if (SelectedFlow is not { } flow) return;
        loadingFlow = true;
        try
        {
            var available = await Flows.GetFlowVersionsAsync(flow.Namespace, flow.Id, flow.ScopeRef, identity.ScopeRef!.Value, cancellation.Token);
            if (request != contractRequest) return;
            versions = available;
            selectedVersion = available.FirstOrDefault(value => value.Version == flow.ActiveVersion)?.Version ?? available.FirstOrDefault()?.Version ?? "";
            if (versions.Count == 0) { error = T("CreationNoPublishedVersions"); return; }
            await LoadContractAsync();
        }
        catch (Exception exception) { if (request == contractRequest) error = exception.Message; }
        finally { if (request == contractRequest || contractLoaded) loadingFlow = false; }
    }

    private async Task LoadContractAsync()
    {
        var request = ++contractRequest;
        contractLoaded = false; error = null;
        if (SelectedFlow is not { } flow || string.IsNullOrWhiteSpace(selectedVersion)) { loadingFlow = false; return; }
        loadingFlow = true;
        try
        {
            var published = await Flows.GetFlowVersionAsync(flow.Namespace, flow.Id, selectedVersion, flow.ScopeRef, identity.ScopeRef!.Value, cancellation.Token);
            if (request != contractRequest) return;
            var ambiguous = false;
            var output = published.Graph?.ResolveSingleSuccessOutputSchema(out ambiguous);
            if (ambiguous) { error = T("FlowOutputContractAmbiguous"); return; }
            inputSchema = published.Graph?.ResolveInputSchema()?.Clone() ?? JsonSerializer.SerializeToElement(new { });
            outputSchema = output?.Clone();
            contractLoaded = true;
        }
        catch (Exception exception) { if (request == contractRequest) error = exception.Message; }
        finally { if (request == contractRequest) loadingFlow = false; }
    }

    private async Task CreateFlowAsync()
    {
        if (!interactive || saving || !CanManage || loadingFlow || !contractLoaded || !ValidateIdentity() || SelectedFlow is not { } flow) return;
        saving = true;
        try
        {
            var created = await Definitions.CreateAsync(new(identity.Name, new FlowToolDefinitionProperties
            {
                DisplayName = identity.DisplayName, Description = identity.Description, Version = identity.Version,
                Publish = false, InputSchema = inputSchema!.Value, OutputSchema = outputSchema,
                Flow = new() { Name = flow.Id, Namespace = flow.Namespace, ScopeRef = flow.ScopeRef, Version = selectedVersion, UseActiveVersion = false }
            }, identity.Namespace, identity.ScopeRef), cancellation.Token);
            Created(created.Value);
        }
        catch (Exception exception) { error = exception.Message; }
        finally { saving = false; }
    }

    private void Created(ToolDefinitionResource definition)
    {
        if (definition.ScopeRef != identity.ScopeRef) return;
        created = true; invalidInput = relayDirty = false;
        Navigation.NavigateTo(ConsoleResourceUrls.Resource("/tools/definitions", definition.Name, definition.Namespace, definition.ScopeRef, ResourceOwnershipContext.TryGetCurrent(NavigationContext)));
    }
    public void Dispose() { contractRequest++; ContextState.Changed -= ContextChanged; cancellation.Cancel(); cancellation.Dispose(); }
}
