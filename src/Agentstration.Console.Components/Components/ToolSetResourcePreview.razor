@namespace Agentstration.Web.Components
@implements IDisposable
@inject IToolSetsClient Client
@inject ConsoleContextState Context
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@inject Microsoft.Extensions.Localization.IStringLocalizer<Pages.ToolSetsStrings> Localizer

<div aria-busy="@((loadState.Status == ResourceLoadStatus.Loading).ToString().ToLowerInvariant())" data-testid="tool-set-preview-body">
    @if (resource is null) { <ResourceLoadFeedback State="loadState" OnRetry="LoadAsync" RetryTestId="tool-set-preview-retry" /> }
    else
    {
        <ToolSetResourceSummary Resource="resource" ReadOnly="@(resource.ScopeRef?.Value != Context.Current?.SelectedScopeRef)" ConfigurationInitiallyCollapsed="false" ShowConfigurationViewSwitch="false">
            <QuickActions>
                <a class="button-secondary" href="@OverviewHref" data-testid="tool-set-preview-open"><UiIcon Name="arrow-up-right" />@Shared["OpenItem"]</a>
                @if (CanEdit) { <a class="button-secondary" href="@DefinitionHref" data-testid="tool-set-preview-edit"><UiIcon Name="pencil" />@Shared["EditDefinition"]</a> }
                <a class="button-secondary" href="@(OverviewHref.Split('#')[0] + "#versions")" data-testid="tool-set-preview-versions"><UiIcon Name="history" />@Localizer["PublishedVersions"]</a>

            </QuickActions>
        </ToolSetResourceSummary>
    }
</div>

@code {
    [Parameter, EditorRequired] public ScopedResourceAddress Address { get; set; }
    [Parameter, EditorRequired] public string OverviewHref { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string DefinitionHref { get; set; } = string.Empty;
    private ToolSetResource? resource;
    private ResourceLoadState loadState = new(ResourceLoadStatus.Loading);
    private CancellationTokenSource? pending;
    private string? requestedKey;
    private long revision;
    private bool disposed;
    private string SelectionKey => $"{Context.Current?.UserId:D}|{Context.Current?.SelectedScopeRef}|{(Address.ScopeRef == default ? string.Empty : Address.ScopeRef.Value)}|{Address.Namespace}|{Address.Kind}|{Address.Name}";
    private bool CanEdit => false; // The existing Tool Set definition is an inspection form.
    protected override void OnInitialized() => Context.Changed += ContextChanged;
    private void ContextChanged() => _ = InvokeAsync(async () => { if (disposed) return; await LoadAsync(); if (!disposed) StateHasChanged(); });
    protected override Task OnParametersSetAsync() => requestedKey == SelectionKey ? Task.CompletedTask : LoadAsync();
    private async Task LoadAsync()
    {
        if (disposed) return;
        var target = Address;
        var key = requestedKey = SelectionKey;
        var requestRevision = ++revision;
        pending?.Cancel(); pending?.Dispose(); pending = new();
        var token = pending.Token;
        resource = null; loadState = new(ResourceLoadStatus.Loading);
        if (Context.Error is not null || !Context.HasPermission(AuthorizationPermissions.ResourcesRead)) { loadState = new(ResourceLoadStatus.Forbidden); return; }
        if (target.Kind != ToolResourceKinds.ToolSet || target.ScopeRef == default) { loadState = new(ResourceLoadStatus.Failed); return; }
        try
        {
            var snapshot = await Client.GetToolSetAsync(target.ScopeRef, target.Namespace, target.Name, token);
            if (!IsCurrent(requestRevision, key)) return;
            if (snapshot.Value.Kind != target.Kind || snapshot.Value.ScopeRef != target.ScopeRef || snapshot.Value.Namespace != target.Namespace || snapshot.Value.Name != target.Name)
            { loadState = new(ResourceLoadStatus.Forbidden); return; }
            resource = snapshot.Value; loadState = new(ResourceLoadStatus.Ready) { HasContent = true };
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception error) when (error is HttpRequestException or AgentstrationApiException or OperationCanceledException)
        {
            if (!IsCurrent(requestRevision, key)) return;
            var status = error is AgentstrationApiException api ? api.StatusCode : (error as HttpRequestException)?.StatusCode;
            loadState = new(status switch
            {
                System.Net.HttpStatusCode.NotFound => ResourceLoadStatus.NotFound,
                System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden => ResourceLoadStatus.Forbidden,
                _ => ResourceLoadStatus.Failed
            }) { ErrorId = (error as AgentstrationApiException)?.ErrorId };
        }
    }
    private bool IsCurrent(long requestRevision, string key) => !disposed && revision == requestRevision && key == SelectionKey
        && Context.Error is null && Context.HasPermission(AuthorizationPermissions.ResourcesRead);
    public void Dispose()
    {
        if (disposed) return;
        disposed = true; revision++; Context.Changed -= ContextChanged; pending?.Cancel(); pending?.Dispose(); GC.SuppressFinalize(this);
    }
}
