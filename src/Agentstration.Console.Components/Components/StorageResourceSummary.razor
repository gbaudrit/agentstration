@namespace Agentstration.Web.Components
@using Agentstration.Web.Components.Pages
@inject Microsoft.Extensions.Localization.IStringLocalizer<StorageStrings> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@inject IServiceProvider Services

<ResourceSummary TestId="storage-summary">
    @if (QuickActions is not null) { <ResourceQuickActions Title="@Shared["QuickActions"]">@QuickActions</ResourceQuickActions> }
    @if (Identity is not null) { @Identity }
    else
    {
        <ResourceIdentitySummary DisplayName="@Resource.Definition.DisplayName" TechnicalName="@Resource.Name" Namespace="@Resource.Namespace.Value"
            ResourceUid="Resource.Uid" Description="@Resource.Definition.Description" Labels="Resource.Metadata.Tags" CopyFacts Collapsible="true" InitiallyCollapsed="false" TestId="storage-identity-summary">
            <Scope><ResourceScopeBadge ScopeRef="Resource.ScopeRef" /></Scope>
            <Badges><ManagedResourceBadge IsManaged="Resource.Governance.IsManaged" IsReadOnly="ReadOnly" /></Badges>
            <AdditionalContent>@if (Resource.ScopeRef is { } owner) { <ExtensionManagedResourcePanel Governance="Resource.Governance" ScopeRef="owner" Namespace="Resource.Namespace" Kind="@Resource.Kind" Name="@Resource.Name" Uid="Resource.Uid" Embedded /> }</AdditionalContent>
        </ResourceIdentitySummary>
    }
    <FormSection Title="@Shared["Configuration"]" Class="resource-configuration-summary" Collapsible InitiallyCollapsed="ConfigurationInitiallyCollapsed" TestId="storage-configuration-summary">
        @ConfigurationSummary
    </FormSection>
    @ConnectionSummary
</ResourceSummary>

@code {
    [Parameter, EditorRequired] public StorageResource Resource { get; set; } = null!;
    [Parameter] public string? TypeDisplayName { get; set; }
    [Parameter] public RenderFragment? Identity { get; set; }
    [Parameter] public RenderFragment? QuickActions { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool ConfigurationInitiallyCollapsed { get; set; } = true;
    [Parameter] public bool ShowConfigurationViewSwitch { get; set; } = true;
    private string T(string key) => Localizer[key];
    private static readonly JsonSerializerOptions SavedJson = new() { WriteIndented = true };
    private sealed record ConfigurationRow(string Name, string Value, string? Href = null);
    private IReadOnlyList<ConfigurationRow> ConfigurationRows => Resource is not { } saved ? [] : [
        new(T("SavedType"), $"{TypeDisplayName ?? saved.Definition.Type.Type.Name} · {saved.Definition.Type.Type.Namespace ?? saved.Namespace}/{saved.Definition.Type.Type.Name}", saved.Definition.Type.Type.ScopeRef is { } typeOwner ? ResourceOwnershipContext.Resource(Services, "/storage-types", saved.Definition.Type.Type.Name, saved.Definition.Type.Type.Namespace ?? saved.Namespace, typeOwner) : null),
        new(T("Version"), saved.Definition.Type.Version),
        new(T("Enabled"), T(saved.Definition.Enabled ? "Value.Yes" : "Value.No")),
        new(T("Configuration"), JsonSerializer.Serialize(saved.Definition.Configuration, SavedJson)),
        new(T("Envelope"), JsonSerializer.Serialize(saved.Definition.Envelope, SavedJson)),
        new(T("Documents.Collections"), JsonSerializer.Serialize(saved.Definition.Collections, SavedJson)),
        new(T("DescendantUsePolicy"), JsonSerializer.Serialize(saved.Definition.UsePolicy, SavedJson))];
    private RenderFragment ConfigurationSummary => @<CollectionView TItem="ConfigurationRow" Items="ConfigurationRows" IdentityLabel="@Shared["Configuration"]" InformationLabels="@(new[] { T("Type.Value") })" ShowViewSwitch="ShowConfigurationViewSwitch">
        <Identity Context="row"><strong class="configuration-key">@row.Name</strong></Identity>
        <Information Context="row"><CollectionValue Label="@T("Type.Value")"><span class="configuration-value">@if (row.Href is { } href) { <a href="@href">@row.Value</a> } else { @row.Value }</span></CollectionValue></Information>
    </CollectionView>;
    private RenderFragment ConnectionSummary => @<FormSection Title="@T("ConnectedService")">
        @if (Resource is { } saved)
        {
            @if (saved.Definition.ConnectedService is { } service)
            {
                <CollectionIdentity DisplayName="@service.Service.Address.Name" Name="@service.Service.Address.Name" Namespace="@service.Service.Address.Namespace.Value" Href="@ServiceUrl(service)" IconName="plug"><IconBadges><ResourceScopeBadge ScopeRef="service.Service.ScopeRef" IconOnly /></IconBadges></CollectionIdentity>
                <p>@T("Generation") · @service.Generation</p>
                @if (saved.Definition.ConnectedServiceType is { } serviceType) { <p>@T("ServiceType") · <code>@serviceType.Type.Namespace/@serviceType.Type.Name</code> · @T("Version") @serviceType.Version</p> }
            }
            else { <p>@T("LocalStorage")</p> }
            <h3>@T("Mappings")</h3>
            @if (saved.Definition.Bindings.Count == 0) { <p>@T("NoMappings")</p> }
            else
            {
                <CollectionView TItem="StorageExportBinding" Items="saved.Definition.Bindings" IdentityLabel="@T("Requirement")" InformationLabels="@(new[] { T("Export"), T("ValueType"), T("Protection") })" RowTestId="storage-mapping" ShowViewSwitch="ShowConfigurationViewSwitch">
                    <Identity Context="binding"><strong class="configuration-key">@binding.RequirementId</strong></Identity>
                    <Information Context="binding"><CollectionValue Label="@T("Export")"><CopyableValue Value="@binding.Export.Id" /></CollectionValue><CollectionValue Label="@T("ValueType")">@T($"ValueType.{binding.Export.Type}")</CollectionValue><CollectionValue Label="@T("Protection")">@T($"Protection.{binding.Export.Protection}")</CollectionValue></Information>
                </CollectionView>
            }
        }
    </FormSection>;
    private string ServiceUrl(ConnectedServiceRevisionReference service) => ResourceOwnershipContext.Resource(Services, "/connected-services", service.Service.Address.Name, service.Service.Address.Namespace, service.Service.ScopeRef);

}
