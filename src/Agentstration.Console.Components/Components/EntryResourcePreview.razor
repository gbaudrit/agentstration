@namespace Agentstration.Web.Components
@using Agentstration.Work
@using Agentstration.Work.Contracts
@implements IDisposable
@inject IEntryAdministrationApiClient Client
@inject ConsoleContextState Context
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@inject Microsoft.Extensions.Localization.IStringLocalizer<Pages.WorkplaceStrings> Localizer

<div aria-busy="@((loadState.Status == ResourceLoadStatus.Loading).ToString().ToLowerInvariant())" data-testid="entry-preview-body">
    @if (resource is null) { <ResourceLoadFeedback State="loadState" OnRetry="LoadAsync" RetryTestId="entry-preview-retry" /> }
    else
    {
        <EntryResourceSummary Resource="resource" Published="published" ManagedByPack="ManagedByPack" PresentationScopeRef="@PresentationScope" ReadOnly="@(!CanEdit)" ConfigurationInitiallyCollapsed="false" ShowConfigurationViewSwitch="false">
            <QuickActions>
                <a class="button-secondary" href="@OverviewHref" data-testid="entry-preview-open"><UiIcon Name="arrow-up-right" />@Shared["OpenItem"]</a>
                @if (CanEdit) { <a class="button-secondary" href="@DefinitionHref" data-testid="entry-preview-edit"><UiIcon Name="pencil" />@Shared["EditDefinition"]</a> }

            </QuickActions>
        </EntryResourceSummary>
    }
</div>

@code {
    [Parameter, EditorRequired] public ScopedResourceAddress Address { get; set; }
    [Parameter, EditorRequired] public string OverviewHref { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string DefinitionHref { get; set; } = string.Empty;
    private EntryDraft? resource;
    private EntryResource? published;
    [Parameter] public bool? ManagedByPack { get; set; }
    private ResourceLoadState loadState = new(ResourceLoadStatus.Loading);
    private CancellationTokenSource? pending;
    private string? requestedKey;
    private long revision;
    private bool disposed;
    private string SelectionKey => $"{Context.Current?.UserId:D}|{Context.Current?.SelectedScopeRef}|{(Address.ScopeRef == default ? string.Empty : Address.ScopeRef.Value)}|{Address.Namespace}|{Address.Kind}|{Address.Name}";
    private ResourceScopeRef? PresentationScope => Context.Current is { } context && resource?.WorkspaceId.Value == context.WorkspaceId
        ? ResourceScopeRef.Parse(context.SelectedScopeRef) : resource is null ? null : ResourceScopeRef.Workspace(resource.WorkspaceId.Value);
    private bool CanEdit => resource is not null && ManagedByPack == false && Context.HasPermission(AuthorizationPermissions.ResourcesWrite)
        && resource.WorkspaceId.Value == Context.Current?.WorkspaceId;
    protected override void OnInitialized() => Context.Changed += ContextChanged;
    private void ContextChanged() => _ = InvokeAsync(async () => { if (disposed) return; await LoadAsync(); if (!disposed) StateHasChanged(); });
    protected override Task OnParametersSetAsync() => requestedKey == SelectionKey ? Task.CompletedTask : LoadAsync();
    private async Task LoadAsync()
    {
        if (disposed) return;
        var target = Address;
        var key = requestedKey = SelectionKey;
        var requestRevision = ++revision;
        pending?.Cancel(); pending?.Dispose(); pending = new();
        var token = pending.Token;
        resource = null; published = null; loadState = new(ResourceLoadStatus.Loading);
        if (Context.Error is not null || !Context.HasPermission(AuthorizationPermissions.ResourcesRead)) { loadState = new(ResourceLoadStatus.Forbidden); return; }
        if (target.Kind != EntryResourceKinds.Entry || target.ScopeRef == default) { loadState = new(ResourceLoadStatus.Failed); return; }
        try
        {
            var snapshot = await Client.GetEntrySummaryAsync(target, token);
            if (!IsCurrent(requestRevision, key)) return;
            if (snapshot.Value.WorkspaceId.Value == Guid.Empty || snapshot.Value.Type != WorkResourceTypes.Entries || ResourceScopeRef.Workspace(snapshot.Value.WorkspaceId.Value) != target.ScopeRef || snapshot.Value.Id.Namespace != target.Namespace || snapshot.Value.Id.Value != target.Name || snapshot.Value.Name != target.Name || snapshot.Published is { } known && (known.WorkspaceId != snapshot.Value.WorkspaceId || known.Id != snapshot.Value.Id || known.Name != target.Name))
            { loadState = new(ResourceLoadStatus.Forbidden); return; }
            resource = snapshot.Value; published = snapshot.Published; loadState = new(ResourceLoadStatus.Ready) { HasContent = true };
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception error) when (error is HttpRequestException or AgentstrationApiException or OperationCanceledException)
        {
            if (!IsCurrent(requestRevision, key)) return;
            var status = error is AgentstrationApiException api ? api.StatusCode : (error as HttpRequestException)?.StatusCode;
            loadState = new(status switch
            {
                System.Net.HttpStatusCode.NotFound => ResourceLoadStatus.NotFound,
                System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden => ResourceLoadStatus.Forbidden,
                _ => ResourceLoadStatus.Failed
            }) { ErrorId = (error as AgentstrationApiException)?.ErrorId };
        }
    }
    private bool IsCurrent(long requestRevision, string key) => !disposed && revision == requestRevision && key == SelectionKey
        && Context.Error is null && Context.HasPermission(AuthorizationPermissions.ResourcesRead);
    public void Dispose()
    {
        if (disposed) return;
        disposed = true; revision++; Context.Changed -= ContextChanged; pending?.Cancel(); pending?.Dispose(); GC.SuppressFinalize(this);
    }
}
