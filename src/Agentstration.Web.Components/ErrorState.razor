@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
<section class="state-panel error-panel" role="alert"><span class="state-icon" aria-hidden="true">!</span><h2>@(Title ?? Shared["ResourceLoadFailed"])</h2><p>@Message</p>@if (!string.IsNullOrWhiteSpace(ErrorId)) { <small>@Shared["ErrorId"]: <code>@ErrorId</code></small> }@ChildContent</section>
@code { [Parameter] public string? Title { get; set; } [Parameter, EditorRequired] public string Message { get; set; } = string.Empty; [Parameter] public string? ErrorId { get; set; } [Parameter] public RenderFragment? ChildContent { get; set; } }

