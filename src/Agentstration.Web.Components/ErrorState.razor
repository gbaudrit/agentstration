<section class="state-panel error-panel" role="alert"><span class="state-icon" aria-hidden="true">!</span><h2>@Title</h2><p>@Message</p>@if (!string.IsNullOrWhiteSpace(ErrorId)) { <small>Error ID: <code>@ErrorId</code></small> }@ChildContent</section>
@code { [Parameter] public string Title { get; set; } = "Unable to load data"; [Parameter, EditorRequired] public string Message { get; set; } = string.Empty; [Parameter] public string? ErrorId { get; set; } [Parameter] public RenderFragment? ChildContent { get; set; } }

