@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@if (IsManaged) { <span class="managed-resource-badge @(IconOnly ? "managed-icon-only" : null)">@if (IconOnly) { <ValueDisclosure Value="@Shared["ManagedReadOnly"]" IconName="lock" /> } else { <UiIcon Name="lock" /> @Shared["ManagedReadOnly"] }</span> }
@code {
    [Parameter] public bool IsManaged { get; set; }
    [Parameter] public bool IconOnly { get; set; }
}
