<section class="state-panel empty-state" role="status"><span class="state-icon" aria-hidden="true"><UiIcon Name="@IconName" /></span><h2>@Title</h2>@if (!string.IsNullOrWhiteSpace(Message)) { <p>@Message</p> }@if (ChildContent is not null) { <div class="empty-state-actions">@ChildContent</div> }</section>
@code { [Parameter] public string Title { get; set; } = "Nothing here yet"; [Parameter] public string Message { get; set; } = "New activity will appear here."; [Parameter] public string IconName { get; set; } = "layers"; [Parameter] public RenderFragment? ChildContent { get; set; } }

