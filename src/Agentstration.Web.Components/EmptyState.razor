<section class="state-panel" role="status"><span class="state-icon" aria-hidden="true">◇</span><h2>@Title</h2>@if (!string.IsNullOrWhiteSpace(Message)) { <p>@Message</p> }@ChildContent</section>
@code { [Parameter] public string Title { get; set; } = "Nothing here yet"; [Parameter] public string Message { get; set; } = "New activity will appear here."; [Parameter] public RenderFragment? ChildContent { get; set; } }

