@implements IDisposable
@inject NavigationManager NavigationManager
<div class="resource-details-template" data-testid="@TestId">
    <ResourceHeader Name="@Name" ResourceType="@ResourceType" Domain="@Domain" Icon="@Icon" IconName="@IconName"
                    ImageSource="@ImageSource" DarkImageSource="@DarkImageSource" IconContent="@IconContent"
                    Description="@Description" TechnicalName="@TechnicalName" Namespace="@Namespace" ScopeRef="ScopeRef"
                    StatusText="@StatusText" Status="Status" Metadata="@Metadata"
                    Enabled="Enabled" EnabledChanged="EnabledChanged" EnabledDisabled="EnabledDisabled" EnabledTestId="@EnabledTestId"
                    PrimaryActions="@PrimaryActions" Actions="@Actions" MoreActions="@MoreActions" NavigationActions="@(Sections.Count > 0 ? HeaderNavigation() : null)" />
    @if (Feedback is not null) { <div class="resource-details-feedback">@Feedback</div> }
    <div class="resource-details-body @(Sections.Count == 0 ? null : "resource-details-with-navigation")">
        <div class="resource-details-main">
            @if (State is not null)
            {
                <div class="resource-details-state">@State</div>
            }
            else
            {
                <div class="resource-details-content">@Content</div>
                @if (HasDraft && DraftActions is not null)
                {
                    <UnsavedChangesBar IsVisible="true" Actions="@DraftActions" />
                }
            }
        </div>
        @if (Sections.Count > 0)
        {
            <div class="resource-details-navigation">
                <ResourceNavigation @key="NavigationIdentity" @ref="navigation" Items="Sections" DefaultPath="@DefaultSection" Label="@NavigationLabel"
                                    SelectionChanged="SelectionChanged" ExternalTriggerId="@triggerId" DrawerOpenChanged="value => drawerOpen = value" TestId="@NavigationTestId" ExpandGroupsInitially="ExpandNavigationGroups" />
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ResourceType { get; set; } = string.Empty;
    [Parameter] public string Domain { get; set; } = "neutral";
    [Parameter] public string Icon { get; set; } = "◇";
    [Parameter] public string? IconName { get; set; }
    [Parameter] public string? ImageSource { get; set; }
    [Parameter] public string? DarkImageSource { get; set; }
    [Parameter] public RenderFragment? IconContent { get; set; }
    [Parameter] public string? TechnicalName { get; set; }
    [Parameter] public string? Namespace { get; set; }
    [Parameter] public Agentstration.Resources.ResourceScopeRef? ScopeRef { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? StatusText { get; set; }
    [Parameter] public UiStatus Status { get; set; }
    [Parameter] public bool? Enabled { get; set; }
    [Parameter] public EventCallback<bool> EnabledChanged { get; set; }
    [Parameter] public bool EnabledDisabled { get; set; }
    [Parameter] public string? EnabledTestId { get; set; }
    [Parameter] public RenderFragment? Metadata { get; set; }
    [Parameter] public RenderFragment? PrimaryActions { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? MoreActions { get; set; }
    [Parameter] public IReadOnlyList<ResourceNavigationItem> Sections { get; set; } = [];
    [Parameter] public string? ResourceIdentity { get; set; }
    [Parameter] public string? DefaultSection { get; set; }
    [Parameter] public string? NavigationLabel { get; set; }
    [Parameter] public string? NavigationTestId { get; set; }
    [Parameter] public EventCallback<string?> SelectionChanged { get; set; }
    [Parameter] public bool ExpandNavigationGroups { get; set; } = true;
    [Parameter] public RenderFragment? Feedback { get; set; }
    [Parameter] public RenderFragment? State { get; set; }
    [Parameter, EditorRequired] public RenderFragment? Content { get; set; }
    [Parameter] public bool HasDraft { get; set; }
    [Parameter] public RenderFragment? DraftActions { get; set; }
    [Parameter] public string? TestId { get; set; }
    private readonly string triggerId = $"resource-sections-{Guid.NewGuid():N}";
    private ResourceNavigation? navigation;
    private bool drawerOpen;
    private string NavigationIdentity => $"{ResourceIdentity}|{ResourceNavigation.BaseUri(NavigationManager.Uri)}";
    private RenderFragment HeaderNavigation() => @<ResourceNavigationTrigger Id="@triggerId" IsOpen="drawerOpen" OnOpen="OpenNavigationAsync" />;
    private Task OpenNavigationAsync() => navigation?.OpenDrawerAsync() ?? Task.CompletedTask;
    protected override void OnInitialized() => NavigationManager.LocationChanged += LocationChanged;
    private void LocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => NavigationManager.LocationChanged -= LocationChanged;
    protected override void OnParametersSet()
    {
        if (Sections.Count > 0 && string.IsNullOrWhiteSpace(ResourceIdentity))
            throw new ArgumentException("Resource navigation requires an exact resource/context identity.", nameof(ResourceIdentity));
    }
}
