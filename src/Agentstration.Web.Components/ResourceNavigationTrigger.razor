@inject Microsoft.Extensions.Localization.IStringLocalizer<ResourceNavigationStrings> Localizer
<button id="@Id" type="button" class="button-secondary resource-navigation-trigger" aria-haspopup="dialog" aria-expanded="@IsOpen.ToString().ToLowerInvariant()" @onclick="OnOpen"><TablerIcon Name="menu-2" /> @Localizer["Sections"]</button>
@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnOpen { get; set; }
}
