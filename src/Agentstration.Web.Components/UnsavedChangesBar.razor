@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Localizer
@if (IsVisible)
{
    <div class="unsaved-changes-bar" role="status" aria-live="polite">
        <div><strong>@(Title ?? Localizer["UnsavedTitle"])</strong><span>@(Message ?? Localizer["UnsavedMessage"])</span></div>
        <div class="unsaved-changes-actions">@Actions</div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
