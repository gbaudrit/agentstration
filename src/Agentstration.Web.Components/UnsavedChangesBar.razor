@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Localizer
@if (IsVisible)
{
    <div class="unsaved-changes-bar">
        <div><strong role="status">@(Title ?? Localizer["UnsavedTitle"])</strong>@if (!string.IsNullOrWhiteSpace(Message)) { <span>@Message</span> }</div>
        <div class="unsaved-changes-actions">@Actions</div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
