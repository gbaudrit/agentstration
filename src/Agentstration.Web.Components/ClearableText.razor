@using Microsoft.AspNetCore.Components.Forms
@inherits InputBase<string?>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Localizer

<span class="clearable-field @(Multiline ? "clearable-multiline" : null)">
    @if (Multiline)
    {
        <textarea @attributes="AdditionalAttributes" id="@ControlId" aria-describedby="@DescriptionId" aria-required="@(Field?.Required == true ? "true" : null)" class="@CssClass" value="@DisplayedValue" @oninput="Input" @onchange="Change" readonly="@ReadOnly" disabled="@Disabled" @ref="control"></textarea>
    }
    else
    {
        <input @attributes="AdditionalAttributes" id="@ControlId" aria-describedby="@DescriptionId" aria-required="@(Field?.Required == true ? "true" : null)" type="@Type" class="@CssClass" value="@DisplayedValue" @oninput="Input" @onchange="Change" readonly="@ReadOnly" disabled="@Disabled" @ref="control" />
    }
    @if (CanClear)
    {
        <FieldClearButton Label="@(Field?.Label is { } label ? Localizer["ClearField", label] : Localizer["ClearValue"])" OnClear="ClearAsync" />
    }
</span>

@code {
    [Parameter] public bool Multiline { get; set; }
    [Parameter] public bool AllowClear { get; set; } = true;
    [Parameter] public bool UpdateOnInput { get; set; } = true;
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [CascadingParameter] private FormFieldPresentation? Field { get; set; }
    private readonly string generatedId = $"input-{Guid.NewGuid():N}";
    private ElementReference control;
    private string? pendingValue;
    private string? lastValue;
    private bool hasPendingValue;
    private string? DisplayedValue => hasPendingValue ? pendingValue : CurrentValueAsString;
    private string ControlId => AdditionalAttributes?.GetValueOrDefault("id")?.ToString() ?? Field?.Id ?? generatedId;
    private string? DescriptionId => AdditionalAttributes?.GetValueOrDefault("aria-describedby")?.ToString() ?? Field?.DescriptionId;
    private bool CanClear => AllowClear && !ReadOnly && !Disabled && !string.IsNullOrEmpty(DisplayedValue);
    public ClearableText() { ValueExpression = () => Value; }
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (!string.Equals(lastValue, Value, StringComparison.Ordinal)) hasPendingValue = false;
        lastValue = Value;
    }
    private void Input(ChangeEventArgs args)
    {
        if (UpdateOnInput) Change(args);
        else { pendingValue = args.Value?.ToString() ?? string.Empty; hasPendingValue = true; }
    }
    private void Change(ChangeEventArgs args)
    {
        hasPendingValue = false;
        CurrentValueAsString = args.Value?.ToString() ?? string.Empty;
        lastValue = Value;
    }
    public ValueTask FocusAsync() => control.FocusAsync();
    public ElementReference Element => control;
    private async Task ClearAsync()
    {
        if (!CanClear) return;
        hasPendingValue = false;
        CurrentValueAsString = string.Empty;
        lastValue = Value;
        await control.FocusAsync();
    }
    protected override bool TryParseValueFromString(string? value, out string? result, [System.Diagnostics.CodeAnalysis.NotNullWhen(false)] out string? validationErrorMessage)
    {
        result = value;
        validationErrorMessage = null;
        return true;
    }
}
