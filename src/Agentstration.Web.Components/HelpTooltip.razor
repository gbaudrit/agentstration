<span class="metric-help @(OpenToLeft ? "metric-help-left" : null)" tabindex="0" aria-label="@Text">?<span class="metric-tooltip" role="tooltip">@Text</span></span>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;
    [Parameter] public bool OpenToLeft { get; set; }
}
