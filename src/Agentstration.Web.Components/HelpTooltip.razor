<span class="metric-help @(OpenToRight ? "metric-help-right" : null)" tabindex="0" aria-label="@Text">?<span class="metric-tooltip" role="tooltip">@Text</span></span>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;
    [Parameter] public bool OpenToRight { get; set; }
}
