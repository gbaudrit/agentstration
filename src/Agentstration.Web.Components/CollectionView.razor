@typeparam TItem
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
<div class="resource-collection @(Compact ? "collection-compact" : null)" @ref="root">
    <div class="@(Toolbar is null ? null : "collection-toolbar")">
    @Toolbar
    <div class="collection-view-switch" role="group" aria-label="@Shared["CollectionView"]">
        <button type="button" class="button-secondary" aria-pressed="@((!cards).ToString().ToLowerInvariant())" @onclick="() => SelectView(false)"><UiIcon Name="table" /> @Shared["TableView"]</button>
        <button type="button" class="button-secondary" aria-pressed="@(cards.ToString().ToLowerInvariant())" @onclick="() => SelectView(true)"><UiIcon Name="list" /> @Shared["CardView"]</button>
    </div>
    </div>
    @if (cards)
    {
        <CascadingValue Name="CollectionCard" Value="true" IsFixed>
            <ul class="collection-cards">
                @foreach (var item in Items)
                {
                    <li data-testid="@RowTestId" @attributes="Attributes(item, true)">
                        @Identity(item)
                        <dl>
                            @if (Scope is not null) { <CollectionValue Label="@(ScopeLabel ?? Shared["Scope"])">@Scope(item)</CollectionValue> }
                            @if (State is not null) { <CollectionValue Label="@(StateLabel ?? Shared["CollectionState"])">@State(item)</CollectionValue> }
                            @Information(item)
                        </dl>
                        @if (Actions is not null) { <div class="collection-actions">@Actions(item)</div> }
                        @if (Details is not null && IsExpanded?.Invoke(item) == true) { <div class="collection-expanded">@Details(item)</div> }
                    </li>
                }
            </ul>
        </CascadingValue>
    }
    else
    {
        <DataGrid TItem="TItem" Items="Items">
            <Header><tr><th scope="col">@(IdentityLabel ?? Shared["CollectionResource"])</th>@if (Scope is not null) { <th scope="col">@(ScopeLabel ?? Shared["Scope"])</th> }@if (State is not null) { <th scope="col">@(StateLabel ?? Shared["CollectionState"])</th> }@if (InformationHeader is not null) { @InformationHeader } else { @foreach (var heading in InformationLabels) { <th scope="col">@heading</th> } }@if (Actions is not null) { <th scope="col">@Shared["CollectionActions"]</th> }</tr></Header>
            <Row Context="item"><tr data-testid="@RowTestId" @attributes="Attributes(item, false)">
                <td class="collection-identity-cell">@Identity(item)</td>
                @if (Scope is not null) { <td>@Scope(item)</td> }
                @if (State is not null) { <td>@State(item)</td> }
                @Information(item)
                @if (Actions is not null) { <td class="collection-actions">@Actions(item)</td> }
            </tr>
            @if (Details is not null && IsExpanded?.Invoke(item) == true)
            {
                <tr class="collection-expanded"><td colspan="@(1 + (Scope is null ? 0 : 1) + (State is null ? 0 : 1) + InformationLabels.Length + (Actions is null ? 0 : 1))">@Details(item)</td></tr>
            }
            </Row>
        </DataGrid>
    }
</div>
@code {
    [Parameter, EditorRequired] public IReadOnlyList<TItem> Items { get; set; } = [];
    [Parameter, EditorRequired] public RenderFragment<TItem> Identity { get; set; } = null!;
    [Parameter] public string? IdentityLabel { get; set; }
    [Parameter] public string? ScopeLabel { get; set; }
    [Parameter] public string? StateLabel { get; set; }
    [Parameter] public string? RowTestId { get; set; }
    [Parameter] public Func<TItem, IReadOnlyDictionary<string, object>>? ItemAttributes { get; set; }
    [Parameter] public Func<TItem, bool>? IsExpanded { get; set; }
    [Parameter] public RenderFragment<TItem>? Details { get; set; }
    [Parameter] public RenderFragment<TItem>? Scope { get; set; }
    [Parameter] public RenderFragment<TItem>? State { get; set; }
    [Parameter, EditorRequired] public string[] InformationLabels { get; set; } = [];
    [Parameter, EditorRequired] public RenderFragment<TItem> Information { get; set; } = null!;
    [Parameter] public RenderFragment<TItem>? Actions { get; set; }
    [Parameter] public RenderFragment? InformationHeader { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public RenderFragment? Toolbar { get; set; }
    private ElementReference root;
    private bool cards;
    private bool selectedView;
    private IJSObjectReference? module;
    private DotNetObjectReference<CollectionView<TItem>>? reference;
    private IReadOnlyDictionary<string, object> Attributes(TItem item, bool card)
    {
        var values = ItemAttributes?.Invoke(item) is { } source ? new Dictionary<string, object>(source) : [];
        if (card) values["class"] = values.TryGetValue("class", out var value) ? $"collection-card {value}" : "collection-card";
        return values;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Agentstration.Web.Components/collection-ui.js");
        reference = DotNetObjectReference.Create(this);
        await module.InvokeVoidAsync("observeCollection", root, reference);
    }
    private void SelectView(bool value) { selectedView = true; cards = value; }
    [JSInvokable] public Task SetNarrow(bool narrow)
    {
        if (!selectedView) { cards = narrow; return InvokeAsync(StateHasChanged); }
        return Task.CompletedTask;
    }
    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try { await module.InvokeVoidAsync("releaseCollection", root); await module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        reference?.Dispose();
    }
}
