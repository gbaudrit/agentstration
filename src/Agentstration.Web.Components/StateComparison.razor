@inject Microsoft.Extensions.Localization.IStringLocalizer<StateComparisonStrings> Localizer

<section class="state-comparison @(IsSynchronized ? "is-synchronized" : "has-drift")" aria-label="@T("DesiredAndActiveStateComparison")">
    @if (IsSynchronized)
    {
        <div class="state-match"><span aria-hidden="true">✓</span><div><strong>@T("DesiredStateMatchesActiveGeneration")</strong><small>@Summary</small></div></div>
    }
    else
    {
        <header><strong>@T("DesiredStateDiffersFromActiveDeployment")</strong><span>@Summary</span></header>
    }
    <div class="state-comparison-grid">
        <article><p class="eyebrow">@T("DesiredState")</p><strong>@T("Generation", DesiredGeneration)</strong><span>@DesiredStatus</span></article>
        <article><p class="eyebrow">@T("ActiveDeployment")</p><strong>@ActiveGenerationLabel</strong><span>@ActiveStatus</span>@if (!string.IsNullOrWhiteSpace(RuntimeLabel)) { <code>@RuntimeLabel</code> }</article>
    </div>
    @if (Actions is not null) { <div class="state-comparison-actions">@Actions</div> }
</section>

@code {
    [Parameter] public long DesiredGeneration { get; set; }
    [Parameter] public long? ActiveGeneration { get; set; }
    [Parameter] public string DesiredStatus { get; set; } = string.Empty;
    [Parameter] public string ActiveStatus { get; set; } = string.Empty;
    [Parameter] public string? RuntimeLabel { get; set; }
    [Parameter] public string Summary { get; set; } = string.Empty;
    [Parameter] public bool IsSynchronized { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string ActiveGenerationLabel => ActiveGeneration is null ? T("NoActiveGeneration") : T("Generation", ActiveGeneration);
}
