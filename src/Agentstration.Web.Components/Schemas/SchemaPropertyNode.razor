@using System.Text.Json.Nodes
@inject Microsoft.Extensions.Localization.IStringLocalizer<SchemaDocumentEditorStrings> Localizer

<section class="schema-property-inspector" data-testid="schema-property-row">
    <header class="schema-inspector-header">
        <div><span class="eyebrow">@Localizer["SelectedProperty"]</span><h4>@Name</h4></div>
        <div class="schema-order-actions" aria-label="@Localizer["PropertyOrder"]">
            <button type="button" class="button-secondary button-compact" disabled="@(Disabled || !CanMoveUp)" data-testid="schema-property-move-up" @onclick="() => MoveAsync(-1)">↑ @Localizer["MoveUp"]</button>
            <button type="button" class="button-secondary button-compact" disabled="@(Disabled || !CanMoveDown)" data-testid="schema-property-move-down" @onclick="() => MoveAsync(1)">↓ @Localizer["MoveDown"]</button>
        </div>
    </header>
    <div class="schema-property-grid">
        <FormField Label="@Localizer["PropertyName"]"><ChildContent><ClearableText UpdateOnInput="false" Value="@Name" Disabled="@Disabled" data-testid="schema-property-name" ValueChanged="changed => RenameAsync(new ChangeEventArgs { Value = changed })" /></ChildContent></FormField>
        <FormField Label="@Localizer["Type"]"><ChildContent><ClearableSelect TValue="string" Value="@Convert.ToString(Text(Schema, "type", "string"), System.Globalization.CultureInfo.InvariantCulture)" disabled="@Disabled" data-testid="schema-property-type" ValueChanged="changed => ChangeTypeAsync(new ChangeEventArgs { Value = changed })">@foreach (var type in Types) { <option value="@type">@type</option> }</ClearableSelect></ChildContent></FormField>
        <label class="schema-required"><FormCheckbox Value="@IsRequired(ParentSchema, Name)" disabled="@Disabled" ValueChanged="changed => ChangeRequiredAsync(new ChangeEventArgs { Value = changed })" /> <span>@Localizer["Required"]</span></label>
        <FormField Label="@Localizer["Description"]" Class="schema-property-wide"><ChildContent><ClearableText UpdateOnInput="false" Value="@(Text(Schema, "description"))" Disabled="@Disabled" ValueChanged="@(changed => SetTextAsync("description", (new ChangeEventArgs { Value = changed }).Value?.ToString()))" /></ChildContent></FormField>
        <FormField Label="@Localizer["Default"]"><ChildContent><ClearableText UpdateOnInput="false" Value="@(Raw(Schema, "default"))" Disabled="@Disabled" ValueChanged="@(changed => SetJsonAsync("default", (new ChangeEventArgs { Value = changed }).Value?.ToString()))" /></ChildContent></FormField>
        <FormField Label="@Localizer["Enum"]"><ChildContent><ClearableText Multiline="true" rows="3" Disabled="@Disabled" Value="@EnumText(Schema)" ValueChanged="changed => SetEnumAsync(new ChangeEventArgs { Value = changed })"></ClearableText></ChildContent></FormField>
        @if (Text(Schema, "type") is "integer" or "number")
        {
            <FormField Label="@Localizer["Minimum"]"><ChildContent><ClearableText UpdateOnInput="false" Type="number" Value="@(Raw(Schema, "minimum"))" Disabled="@Disabled" ValueChanged="@(changed => SetNumberAsync("minimum", (new ChangeEventArgs { Value = changed }).Value?.ToString()))" /></ChildContent></FormField>
            <FormField Label="@Localizer["Maximum"]"><ChildContent><ClearableText UpdateOnInput="false" Type="number" Value="@(Raw(Schema, "maximum"))" Disabled="@Disabled" ValueChanged="@(changed => SetNumberAsync("maximum", (new ChangeEventArgs { Value = changed }).Value?.ToString()))" /></ChildContent></FormField>
        }
        @if (Text(Schema, "type") == "string")
        {
            <FormField Label="@Localizer["MinimumLength"]"><ChildContent><ClearableText UpdateOnInput="false" Type="number" min="0" Value="@(Raw(Schema, "minLength"))" Disabled="@Disabled" ValueChanged="@(changed => SetIntegerAsync("minLength", (new ChangeEventArgs { Value = changed }).Value?.ToString()))" /></ChildContent></FormField>
            <FormField Label="@Localizer["MaximumLength"]"><ChildContent><ClearableText UpdateOnInput="false" Type="number" min="0" Value="@(Raw(Schema, "maxLength"))" Disabled="@Disabled" ValueChanged="@(changed => SetIntegerAsync("maxLength", (new ChangeEventArgs { Value = changed }).Value?.ToString()))" /></ChildContent></FormField>
        }
    </div>
    @if (Text(Schema, "type") == "object")
    {
        <div class="schema-object-options">
            <label class="schema-additional-properties"><FormCheckbox Value="@AdditionalProperties" disabled="@Disabled" ValueChanged="changed => ChangeAdditionalPropertiesAsync(new ChangeEventArgs { Value = changed })" /> <span>@Localizer["AdditionalProperties"]</span></label>
            <button type="button" class="button-secondary" disabled="@Disabled" data-testid="schema-add-child-property" @onclick="AddChildAsync">@Localizer["AddChildProperty"]</button>
        </div>
    }
    <footer class="schema-inspector-footer"><button type="button" class="text-button text-danger" disabled="@Disabled" @onclick="RemoveAsync">@Localizer["Remove"]</button></footer>
</section>

@code {
    [Parameter, EditorRequired] public JsonObject ParentSchema { get; set; } = null!;
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter, EditorRequired] public JsonObject Schema { get; set; } = null!;
    [Parameter] public int Depth { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback<string> Error { get; set; }
    [Parameter] public EventCallback<SchemaPropertySelection?> SelectionChanged { get; set; }

    private static readonly string[] Types = ["string", "integer", "number", "boolean", "object", "array"];
    private bool AdditionalProperties => Schema["additionalProperties"]?.GetValue<bool>() ?? true;
    private int PropertyIndex => EnsureProperties(ParentSchema).IndexOf(Name);
    private bool CanMoveUp => PropertyIndex > 0;
    private bool CanMoveDown => PropertyIndex >= 0 && PropertyIndex < EnsureProperties(ParentSchema).Count - 1;

    private async Task RenameAsync(ChangeEventArgs args)
    {
        var nextName = args.Value?.ToString()?.Trim();
        if (string.IsNullOrWhiteSpace(nextName)) { await Error.InvokeAsync(Localizer["PropertyNameRequired"]); return; }
        if (string.Equals(nextName, Name, StringComparison.Ordinal)) return;
        var properties = EnsureProperties(ParentSchema);
        if (properties.ContainsKey(nextName)) { await Error.InvokeAsync(Localizer["PropertyNameAlreadyExists", nextName]); return; }
        var index = properties.IndexOf(Name);
        var required = IsRequired(ParentSchema, Name);
        properties.Remove(Name);
        properties.Insert(index, nextName, Schema);
        SetRequired(ParentSchema, Name, false);
        SetRequired(ParentSchema, nextName, required);
        await SelectionChanged.InvokeAsync(new(ParentSchema, nextName, Schema, Depth));
        await NotifyChangedAsync();
    }

    private async Task MoveAsync(int offset)
    {
        var properties = EnsureProperties(ParentSchema);
        var current = properties.IndexOf(Name);
        var target = current + offset;
        if (current < 0 || target < 0 || target >= properties.Count) return;
        properties.RemoveAt(current);
        properties.Insert(target, Name, Schema);
        await NotifyChangedAsync();
    }

    private async Task ChangeTypeAsync(ChangeEventArgs args)
    {
        var type = args.Value?.ToString();
        if (!Types.Contains(type, StringComparer.Ordinal)) return;
        Schema["type"] = type;
        if (type == "object") Schema["properties"] ??= new JsonObject();
        if (type == "array") Schema["items"] ??= new JsonObject { ["type"] = "string" };
        await NotifyChangedAsync();
    }

    private async Task ChangeRequiredAsync(ChangeEventArgs args) { SetRequired(ParentSchema, Name, args.Value is true); await NotifyChangedAsync(); }
    private async Task ChangeAdditionalPropertiesAsync(ChangeEventArgs args) { Schema["additionalProperties"] = args.Value is true; await NotifyChangedAsync(); }
    private async Task AddChildAsync()
    {
        var properties = EnsureProperties(Schema);
        var index = 1;
        while (properties.ContainsKey($"field{index}")) index++;
        var name = $"field{index}";
        var child = new JsonObject { ["type"] = "string" };
        properties[name] = child;
        await SelectionChanged.InvokeAsync(new(Schema, name, child, Depth + 1));
        await NotifyChangedAsync();
    }
    private async Task RemoveAsync()
    {
        EnsureProperties(ParentSchema).Remove(Name);
        SetRequired(ParentSchema, Name, false);
        await SelectionChanged.InvokeAsync(null);
        await NotifyChangedAsync();
    }
    private async Task SetTextAsync(string keyword, string? value) { if (string.IsNullOrWhiteSpace(value)) Schema.Remove(keyword); else Schema[keyword] = value; await NotifyChangedAsync(); }
    private async Task SetJsonAsync(string keyword, string? value)
    {
        try { if (string.IsNullOrWhiteSpace(value)) Schema.Remove(keyword); else Schema[keyword] = JsonNode.Parse(value); await NotifyChangedAsync(); }
        catch (JsonException exception) { await Error.InvokeAsync(Localizer["InvalidJson", exception.Message]); }
    }
    private async Task SetEnumAsync(ChangeEventArgs args)
    {
        var values = (args.Value?.ToString() ?? string.Empty).Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (values.Length == 0) Schema.Remove("enum"); else Schema["enum"] = new JsonArray(values.Select(item => (JsonNode?)JsonValue.Create(item)).ToArray());
        await NotifyChangedAsync();
    }
    private Task SetNumberAsync(string keyword, string? value) => SetNumericAsync(keyword, value, false);
    private Task SetIntegerAsync(string keyword, string? value) => SetNumericAsync(keyword, value, true);
    private async Task SetNumericAsync(string keyword, string? value, bool integer)
    {
        if (string.IsNullOrWhiteSpace(value)) Schema.Remove(keyword);
        else if (integer && int.TryParse(value, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var whole)) Schema[keyword] = whole;
        else if (!integer && decimal.TryParse(value, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var number)) Schema[keyword] = number;
        else return;
        await NotifyChangedAsync();
    }

    private async Task NotifyChangedAsync() { await Error.InvokeAsync(string.Empty); await Changed.InvokeAsync(); }
    private static JsonObject EnsureProperties(JsonObject schema) { if (schema["properties"] is JsonObject properties) return properties; properties = []; schema["type"] ??= "object"; schema["properties"] = properties; return properties; }
    private static bool IsRequired(JsonObject parent, string name) => parent["required"] is JsonArray required && required.Any(item => string.Equals(item?.GetValue<string>(), name, StringComparison.Ordinal));
    private static void SetRequired(JsonObject parent, string name, bool required)
    {
        var values = parent["required"] as JsonArray ?? [];
        var existing = values.FirstOrDefault(item => string.Equals(item?.GetValue<string>(), name, StringComparison.Ordinal));
        if (required && existing is null) values.Add(name);
        if (!required && existing is not null) values.Remove(existing);
        if (values.Count == 0) parent.Remove("required"); else parent["required"] = values;
    }
    private static string? Text(JsonObject schema, string name, string? fallback = null) => schema[name] is JsonValue value && value.TryGetValue<string>(out var text) ? text : fallback;
    private static string Raw(JsonObject schema, string name) => schema[name]?.ToJsonString() ?? string.Empty;
    private static string EnumText(JsonObject schema) => schema["enum"] is JsonArray values ? string.Join(Environment.NewLine, values.Select(value => value?.GetValue<string>())) : string.Empty;
}
