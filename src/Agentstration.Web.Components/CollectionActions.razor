@implements IAsyncDisposable
@inject IJSRuntime JS
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
<div class="collection-action-group" role="group" aria-label="@Shared["ActionsFor", ResourceName]" @onclick:stopPropagation="true">
    @if (Primary is not null) { <div class="collection-primary-actions">@Primary</div> }
    @if (SecondaryContent is not null)
    {
        <details class="collection-actions-menu" @ref="root">
            <summary class="button-secondary" aria-label="@Shared["ActionsFor", ResourceName]">@Shared["CollectionActions"] <UiIcon Name="chevron-down" /></summary>
            <div class="collection-actions-panel" popover="manual">@SecondaryContent</div>
        </details>
    }
</div>
@code {
    [Parameter, EditorRequired] public string ResourceName { get; set; } = string.Empty;
    [Parameter] public RenderFragment? Primary { get; set; }
    [Parameter] public RenderFragment? Secondary { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private RenderFragment? SecondaryContent => Secondary ?? ChildContent;
    private ElementReference root;
    private IJSObjectReference? module;
    private ElementReference? attachedRoot;
    private Task pendingInterop = Task.CompletedTask;
    private Task? disposal;
    private bool disposed;
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed) return Task.CompletedTask;
        return pendingInterop = UpdateAfterAsync(pendingInterop);
    }

    private async Task UpdateAfterAsync(Task previous)
    {
        try
        {
            // Renders can overlap at an interop await. Retain the module until
            // all queued updates finish, including during component disposal.
            await previous;
            if (disposed) return;
            if (SecondaryContent is null)
            {
                if (module is not null && attachedRoot is { } removed)
                {
                    await module.InvokeVoidAsync("releaseActions", removed);
                    attachedRoot = null;
                }
                return;
            }
            if (attachedRoot?.Id == root.Id) return;
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Agentstration.Web.Components/collection-ui.js");
            if (disposed) return;
            if (attachedRoot is { } replaced)
            {
                await module.InvokeVoidAsync("releaseActions", replaced);
                attachedRoot = null;
            }
            if (disposed) return;
            var target = root;
            await module.InvokeVoidAsync("attachActions", target);
            attachedRoot = target;
        }
        catch (JSDisconnectedException) when (disposed) { }
    }

    public ValueTask DisposeAsync()
    {
        disposed = true;
        return new(disposal ??= ReleaseAfterUpdatesAsync());
    }

    private async Task ReleaseAfterUpdatesAsync()
    {
        try
        {
            await pendingInterop;
            if (module is null) return;
            if (attachedRoot is { } attached) await module.InvokeVoidAsync("releaseActions", attached);
            await module.DisposeAsync();
            module = null;
            attachedRoot = null;
        }
        catch (JSDisconnectedException) { }
    }
}
