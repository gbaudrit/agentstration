@implements IAsyncDisposable
@inject IJSRuntime JS
<span class="value-disclosure" @ref="root" @onclick:stopPropagation="true">
    <button type="button" class="disclosure-trigger @(IconName is null && Marker is null ? null : "disclosure-icon")" title="@Value" aria-label="@(IconName is null && Marker is null ? null : Value)" aria-expanded="false" aria-controls="@panelId">@if (Marker is not null) { <span class="scope-letter" aria-hidden="true">@Marker</span> } else if (IconName is { } icon) { <UiIcon Name="@icon" /> } else { @Value }</button>
    <span id="@panelId" class="full-value-panel" popover="manual" role="tooltip">@Value</span>
</span>
@code {
    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;
    [Parameter] public string? IconName { get; set; }
    [Parameter] public string? Marker { get; set; }
    private readonly string panelId = $"full-value-{Guid.NewGuid():N}";
    private ElementReference root;
    private IJSObjectReference? module;
    private Task pendingInterop = Task.CompletedTask;
    private Task? disposal;
    private bool disposed;
    protected override Task OnAfterRenderAsync(bool firstRender)
        => firstRender ? pendingInterop = AttachAsync() : Task.CompletedTask;
    private async Task AttachAsync()
    {
        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Agentstration.Web.Components/collection-ui.js");
            if (!disposed) await module.InvokeVoidAsync("attachDisclosure", root);
        }
        catch (JSDisconnectedException) when (disposed) { }
        catch (OperationCanceledException) when (disposed) { }
    }
    public ValueTask DisposeAsync()
    {
        disposed = true;
        return new(disposal ??= ReleaseAsync());
    }
    private async Task ReleaseAsync()
    {
        try
        {
            await pendingInterop;
            if (module is null) return;
            await module.InvokeVoidAsync("releaseDisclosure", root);
            await module.DisposeAsync();
            module = null;
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) { }
    }
}
