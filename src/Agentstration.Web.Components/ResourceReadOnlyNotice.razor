@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared

<aside class="resource-readonly-notice" role="status" data-testid="@TestId">
    <UiIcon Name="lock" />
    <div><strong>@Shared["ReadOnlyDefinition"]</strong><span>@(Message ?? Shared[$"ReadOnlyReason.{Reason}"])</span></div>
    @if (Actions is not null) { <div class="resource-readonly-actions">@Actions</div> }
</aside>

@code {
    [Parameter] public ResourceReadOnlyReason Reason { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public string? TestId { get; set; }
}
