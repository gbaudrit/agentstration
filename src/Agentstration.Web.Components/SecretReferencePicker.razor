@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Localizer
<div class="secret-reference-picker">
    <FormField Label="@EffectiveLabel" Required="@Required">
        <ChildContent>
            <ClearableSelect TValue="string" Value="@Value" disabled="@Disabled" ValueChanged="changed => ChangedAsync(new ChangeEventArgs { Value = changed })">
                @if (!Required) { <option value="">@Localizer["NoSecret"]</option> }
                @foreach (var item in Items.OrderBy(value => value.DisplayName, StringComparer.OrdinalIgnoreCase))
                {
                    <option value="@item.Id">@item.DisplayName — @item.Name (@item.Status)</option>
                }
            </ClearableSelect>
        </ChildContent>
        <HelpContent>@if (Selected is { } selected) { @Localizer["SecretCoordinates", selected.Vault, selected.Namespace, selected.Name] }</HelpContent>
    </FormField>
    @if (Selected?.Status.Equals("Missing", StringComparison.OrdinalIgnoreCase) == true)
    {
        <p class="inline-warning">@Localizer["SecretMissingValue"]</p>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<SecretPickerItem> Items { get; set; } = [];
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private string EffectiveLabel => Label ?? Localizer["Credential"];
    private SecretPickerItem? Selected => Items.FirstOrDefault(value => value.Id == Value);
    private Task ChangedAsync(ChangeEventArgs args) => ValueChanged.InvokeAsync(string.IsNullOrWhiteSpace(args.Value?.ToString()) ? null : args.Value!.ToString());
}
