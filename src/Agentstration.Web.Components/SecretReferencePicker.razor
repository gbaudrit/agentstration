<div class="secret-reference-picker">
    <label>
        <span>@Label</span>
        <select value="@Value" @onchange="ChangedAsync" disabled="@Disabled" aria-label="@Label">
            @if (!Required) { <option value="">No secret</option> }
            @foreach (var item in Items.OrderBy(value => value.DisplayName, StringComparer.OrdinalIgnoreCase))
            {
                <option value="@item.Id">@item.DisplayName — @item.Name (@item.Status)</option>
            }
        </select>
        @if (Selected is { } selected) { <small>Vault: @selected.Vault · @selected.Namespace/@selected.Name</small> }
    </label>
    @if (Selected?.Status.Equals("Missing", StringComparison.OrdinalIgnoreCase) == true)
    {
        <p class="inline-warning">The selected Secret has no configured value.</p>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<SecretPickerItem> Items { get; set; } = [];
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "Credential";
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private SecretPickerItem? Selected => Items.FirstOrDefault(value => value.Id == Value);
    private Task ChangedAsync(ChangeEventArgs args) => ValueChanged.InvokeAsync(string.IsNullOrWhiteSpace(args.Value?.ToString()) ? null : args.Value!.ToString());
}
