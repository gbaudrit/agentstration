@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Localizer
<div @attributes="AdditionalAttributes" class="form-field @Class">
    <div class="form-field-heading"><label for="@ControlId">@if (LabelContent is not null) { @LabelContent } else { @Label }@if (Required) { <span aria-hidden="true" class="field-required"> *</span> } else if (Optional) { <span class="field-requirement"> @Localizer["Optional"]</span> }</label>@if (!string.IsNullOrWhiteSpace(Tooltip)) { <HelpTooltip Text="@Tooltip" OpenToLeft="@TooltipOpenToLeft" /> }</div>
    <CascadingValue Value="Presentation" IsFixed="false">@ChildContent</CascadingValue>
    @if (HelpContent is not null) { <div class="form-field-help" id="@(ControlId + "-help")">@HelpContent</div> }
    else if (!string.IsNullOrWhiteSpace(Help)) { <small id="@(ControlId + "-help")">@Help</small> }
    @if (Validation is not null) { <div id="@(ControlId + "-messages")" class="form-field-messages" aria-live="polite">@Validation</div> }
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? Help { get; set; }
    [Parameter] public string? Tooltip { get; set; }
    [Parameter] public bool TooltipOpenToLeft { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Optional { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? LabelContent { get; set; }
    [Parameter] public RenderFragment? HelpContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    [Parameter] public RenderFragment? Validation { get; set; }
    private readonly string generatedId = $"field-{Guid.NewGuid():N}";
    private string ControlId => Id ?? generatedId;
    private FormFieldPresentation Presentation => new(ControlId,
        string.Join(" ", new[] { string.IsNullOrWhiteSpace(Help) && HelpContent is null ? null : ControlId + "-help", Validation is null ? null : ControlId + "-messages" }.Where(value => value is not null)), Label, Required);
}
