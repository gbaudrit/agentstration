<header class="page-header" data-testid="@TestId">
    <div class="page-header-copy">
        @if (Breadcrumb is not null) { <div class="page-header-breadcrumb">@Breadcrumb</div> }
        @if (!string.IsNullOrWhiteSpace(Eyebrow)) { <p class="eyebrow">@Eyebrow</p> }
        <div class="page-title-row"><h1>@Title</h1>@if (ScopeRef is not null) { <ResourceScopeBadge ScopeRef="ScopeRef" Compact /> }@if (Status is not null) { @Status }</div>
        @if (!string.IsNullOrWhiteSpace(Description)) { <p>@Description</p> }
        @if (Metadata is not null) { <div class="page-header-metadata">@Metadata</div> }
    </div>
    @if (Enabled is not null || Actions is not null || HasCollectionLink) { <div class="page-actions">@if (Enabled is { } enabled) { <ResourceActivationToggle Enabled="enabled" EnabledChanged="EnabledChanged" Disabled="EnabledDisabled" TestId="@EnabledTestId" /> }@Actions<ResourceCollectionLink Href="@CollectionHref" Label="@CollectionLabel" /></div> }
</header>

@code {
    [Parameter] public bool? Enabled { get; set; }
    [Parameter] public EventCallback<bool> EnabledChanged { get; set; }
    [Parameter] public bool EnabledDisabled { get; set; }
    [Parameter] public string? EnabledTestId { get; set; }
    [Parameter] public Agentstration.Resources.ResourceScopeRef? ScopeRef { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? Breadcrumb { get; set; }
    [Parameter] public RenderFragment? Status { get; set; }
    [Parameter] public RenderFragment? Metadata { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public string? TestId { get; set; }
    [Parameter] public string? CollectionHref { get; set; }
    [Parameter] public string? CollectionLabel { get; set; }
    private bool HasCollectionLink => !string.IsNullOrWhiteSpace(CollectionHref) && !string.IsNullOrWhiteSpace(CollectionLabel);
}
