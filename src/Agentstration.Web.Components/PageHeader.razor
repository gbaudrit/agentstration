<header class="page-header">
    <div><p class="eyebrow">@Eyebrow</p><h1>@Title</h1>@if (!string.IsNullOrWhiteSpace(Description)) { <p>@Description</p> }</div>
    @if (Actions is not null) { <div class="page-actions">@Actions</div> }
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string Eyebrow { get; set; } = "Agentstration";
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}

