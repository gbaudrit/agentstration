<header class="page-header">
    <div class="page-header-copy">
        @if (Breadcrumb is not null) { <div class="page-header-breadcrumb">@Breadcrumb</div> }
        @if (!string.IsNullOrWhiteSpace(Eyebrow)) { <p class="eyebrow">@Eyebrow</p> }
        <div class="page-title-row"><h1>@Title</h1>@if (Status is not null) { @Status }</div>
        @if (!string.IsNullOrWhiteSpace(Description)) { <p>@Description</p> }
        @if (Metadata is not null) { <div class="page-header-metadata">@Metadata</div> }
    </div>
    @if (Actions is not null) { <div class="page-actions">@Actions</div> }
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string Eyebrow { get; set; } = "Agentstration";
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? Breadcrumb { get; set; }
    [Parameter] public RenderFragment? Status { get; set; }
    [Parameter] public RenderFragment? Metadata { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
