@using System.Text.Json
@using System.Text.Json.Nodes
@using System.Text
@inject Microsoft.Extensions.Localization.IStringLocalizer<JsonSchemaInputStrings> Localizer

<section class="schema-input-editor" data-testid="schema-input-editor">
    <div class="schema-input-toolbar" role="group" aria-label="@Localizer["EditorMode"]">
        @if (analysis.CanRender) { <button type="button" data-testid="schema-form-mode" class="@(rawMode ? "button-secondary" : "button-primary")" disabled="@Disabled" @onclick="ShowForm">@Localizer["FormMode"]</button> }
        <button type="button" data-testid="schema-raw-mode" class="@(rawMode || !analysis.CanRender ? "button-primary" : "button-secondary")" disabled="@Disabled" @onclick="ShowRaw">@Localizer["RawMode"]</button>
    </div>
    @if (!analysis.CanRender)
    {
        <p class="inline-warning" role="status">@Localizer[$"Fallback.{(AllowAnyRoot && analysis.FallbackReason == "MissingSchema" ? "MissingValueSchema" : AllowAnyRoot && analysis.FallbackReason == "FreeFormSchema" ? "FreeFormValueSchema" : analysis.FallbackReason ?? "UnsupportedSchema")}"]</p>
    }
    @if (rawMode || !analysis.CanRender)
    {
        <label><span>@Localizer["JsonValue"]</span><textarea class="form-code-editor runner-json" rows="11" value="@rawText" readonly="@ReadOnly" disabled="@Disabled" aria-invalid="@(!state.IsValid)" @oninput="ChangeRawAsync"></textarea></label>
        @foreach (var issue in state.Issues) { <span class="field-validation-error" role="alert">@IssueText(issue)</span> }
    }
    else if (analysis.Root is not null)
    {
        <JsonSchemaField Schema="@(analysis.Root with { Title = analysis.Root.Title ?? (AllowAnyRoot ? Localizer["JsonValue"].Value : null) })" Value="document" ValueChanged="ChangeDocumentAsync" Disabled="@(Disabled || ReadOnly)" LockedPaths="lockedPaths" Issues="state.Issues" PreservePresence="AllowAnyRoot" IsPresent="valuePresent" ValueRemoved="RemoveDocumentAsync" />
    }
</section>

@code {
    [Parameter] public JsonElement? Schema { get; set; }
    [Parameter] public JsonElement Value { get; set; } = JsonSerializer.SerializeToElement(new { });
    [Parameter] public EventCallback<JsonElement> ValueChanged { get; set; }
    [Parameter] public EventCallback<JsonSchemaInputValidationState> ValidationChanged { get; set; }
    [Parameter] public IReadOnlyDictionary<string, JsonElement>? LockedValues { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool AllowAnyRoot { get; set; }
    [Parameter] public bool Required { get; set; } = true;
    private JsonSchemaInputAnalysis analysis = new(null, "MissingSchema");
    private JsonNode? document = new JsonObject();
    private bool valuePresent = true;
    private string rawText = "{}", schemaKey = string.Empty, valueKey = string.Empty, lockedValuesKey = string.Empty;
    private IReadOnlySet<string> lockedPaths = new HashSet<string>(StringComparer.Ordinal);
    private bool rawMode;
    private bool initialized;
    private bool canInitializeRawTemplate;
    private JsonSchemaInputValidationState state = new(true, JsonSerializer.SerializeToElement(new { }), [], false);

    protected override async Task OnParametersSetAsync()
    {
        var schemaJson = Schema is { ValueKind: not JsonValueKind.Undefined } schema ? schema.GetRawText() : string.Empty;
        var nextSchemaKey = $"{AllowAnyRoot}|{Required}|{Schema?.ValueKind}|{schemaJson}";
        var nextValueKey = Value.ValueKind == JsonValueKind.Undefined ? AllowAnyRoot ? "<absent>" : "{}" : Value.GetRawText();
        var nextLockedValuesKey = LockedValues is null
            ? string.Empty
            : string.Join('|', LockedValues.OrderBy(item => item.Key, StringComparer.Ordinal).Select(item => $"{item.Key}:{item.Value.GetRawText()}"));
        if (nextSchemaKey == schemaKey && nextValueKey == valueKey && nextLockedValuesKey == lockedValuesKey) return;
        schemaKey = nextSchemaKey;
        lockedValuesKey = nextLockedValuesKey;
        lockedPaths = LockedValues?.Keys.Select(name => $"$.{name}").ToHashSet(StringComparer.Ordinal)
            ?? new HashSet<string>(StringComparer.Ordinal);
        var previousCanRender = analysis.CanRender;
        analysis = JsonSchemaInputModel.Analyze(Schema, AllowAnyRoot, Required);
        valuePresent = nextValueKey != "<absent>";
        if (!TryDocument(nextValueKey, out var nextDocument)) nextDocument = AllowAnyRoot ? null : new JsonObject();
        document = nextDocument;
        var firstParameters = !initialized;
        var initializeEmpty = !AllowAnyRoot && firstParameters && document is JsonObject { Count: 0 };
        if (initializeEmpty && analysis.Root is not null) document = JsonSchemaInputModel.ApplyDefaults((JsonObject)document!, analysis.Root);
        ApplyLockedValues(document);
        if (firstParameters) canInitializeRawTemplate = initializeEmpty;
        rawText = DocumentText(indented: true, editable: true);
        valueKey = DocumentText();
        if (!analysis.CanRender) rawMode = true;
        else if (!previousCanRender) rawMode = false;
        initialized = true;
        await PublishAsync(initializeEmpty);
    }

    private async Task ChangeDocumentAsync(JsonNode? value)
    {
        if (Disabled || ReadOnly) return;
        canInitializeRawTemplate = false;
        document = AllowAnyRoot ? value?.DeepClone() : value as JsonObject ?? new JsonObject();
        valuePresent = true;
        ApplyLockedValues(document);
        rawText = DocumentText(indented: true, editable: true);
        valueKey = DocumentText();
        await PublishAsync(true);
    }
    private async Task RemoveDocumentAsync()
    {
        if (!AllowAnyRoot || Disabled || ReadOnly) return;
        canInitializeRawTemplate = false;
        document = null; valuePresent = false; rawText = string.Empty; valueKey = "<absent>";
        await PublishAsync(true);
    }
    private async Task ChangeRawAsync(ChangeEventArgs args)
    {
        if (Disabled || ReadOnly) return;
        rawText = args.Value?.ToString() ?? string.Empty;
        if (AllowAnyRoot && string.IsNullOrWhiteSpace(rawText)) { await RemoveDocumentAsync(); return; }
        if (TryDocument(rawText, out var parsed)) { document = parsed; valuePresent = true; ApplyLockedValues(document); rawText = DocumentText(indented: true, editable: true); valueKey = DocumentText(); await PublishAsync(true); return; }
        state = new(false, null, [new("$", "InvalidJson")], !analysis.CanRender, analysis.FallbackReason);
        await ValidationChanged.InvokeAsync(state);
    }
    private async Task ShowRaw()
    {
        if (Disabled) return;
        if (!ReadOnly && canInitializeRawTemplate && analysis.Root is not null)
        {
            var template = JsonSchemaInputModel.CreateTemplate(analysis.Root);
            foreach (var property in (JsonObject)document!) template[property.Key] = property.Value?.DeepClone();
            document = template;
            ApplyLockedValues(document);
            canInitializeRawTemplate = false;
            valueKey = DocumentText();
            await PublishAsync(true);
        }
        rawText = DocumentText(indented: true, editable: true);
        rawMode = true;
    }
    private void ShowForm() { if (!Disabled && (AllowAnyRoot && !valuePresent || TryDocument(rawText, out _))) rawMode = false; }
    private async Task PublishAsync(bool notifyValue)
    {
        JsonElement? value = valuePresent ? JsonSerializer.SerializeToElement(document) : null;
        IReadOnlyList<JsonSchemaInputIssue> issues = value is null ? Required ? [new("$", "Required")] : [] : analysis.Root is null
            ? Encoding.UTF8.GetByteCount(value.Value.GetRawText()) > JsonSchemaInputModel.MaximumValueBytes ? [new("$", "ValueTooLarge", JsonSchemaInputModel.MaximumValueBytes.ToString(System.Globalization.CultureInfo.InvariantCulture))] : []
            : JsonSchemaInputModel.Validate(value.Value, analysis.Root);
        state = new(issues.Count == 0, value, issues, !analysis.CanRender, analysis.FallbackReason);
        if (notifyValue) await ValueChanged.InvokeAsync(value ?? default);
        await ValidationChanged.InvokeAsync(state);
    }
    private string IssueText(JsonSchemaInputIssue issue)
    {
        var message = issue is { Code: "MinimumLength", Constraint: "1" }
            ? Localizer["Validation.MinimumLength.One"]
            : Localizer[$"Validation.{(AllowAnyRoot && issue.Code == "InvalidJson" ? "InvalidJsonValue" : issue.Code)}", issue.Constraint ?? string.Empty];
        return $"{issue.Path}: {message}";
    }
    private void ApplyLockedValues(JsonNode? value)
    {
        if (LockedValues is null || value is not JsonObject target) return;
        foreach (var item in LockedValues)
            target[item.Key] = JsonNode.Parse(item.Value.GetRawText());
    }
    private JsonNode? EditableDocument(JsonNode? source)
    {
        var editable = source?.DeepClone();
        if (LockedValues is not null && editable is JsonObject map)
            foreach (var name in LockedValues.Keys) map.Remove(name);
        return editable;
    }
    private string DocumentText(bool indented = false, bool editable = false) => !valuePresent ? indented ? string.Empty : "<absent>"
        : (editable ? EditableDocument(document) : document)?.ToJsonString(new JsonSerializerOptions { WriteIndented = indented }) ?? "null";
    private bool TryDocument(string json, out JsonNode? value)
    {
        try
        {
            value = JsonNode.Parse(json);
            return AllowAnyRoot || value is JsonObject;
        }
        catch (JsonException) { value = null; return false; }
    }
}
