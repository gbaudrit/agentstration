<label class="search-box"><span class="sr-only">@Label</span><span aria-hidden="true">⌕</span><input type="search" value="@Value" @oninput="OnInput" placeholder="@Placeholder" aria-label="@Label" /></label>
@code { [Parameter] public string Label { get; set; } = "Search"; [Parameter] public string Placeholder { get; set; } = "Search"; [Parameter] public string Value { get; set; } = string.Empty; [Parameter] public EventCallback<string> ValueChanged { get; set; } private Task OnInput(ChangeEventArgs args) => ValueChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty); }

