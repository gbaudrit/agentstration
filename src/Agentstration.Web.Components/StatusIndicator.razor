<span class="status-indicator status-@Status.ToString().ToLowerInvariant()" role="status" aria-label="@Text">
    <span class="status-dot" aria-hidden="true"></span>
    <span>@Text</span>
</span>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;
    [Parameter] public UiStatus Status { get; set; }
}
