<div class="health-indicator" role="status" aria-label="@($"{Label}: {StatusText}")">
    <span><strong>@Label</strong><small><StatusBadge Text="@StatusText" Status="@Status" /></small></span>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string StatusText { get; set; } = string.Empty;
    [Parameter] public UiStatus Status { get; set; }
}

