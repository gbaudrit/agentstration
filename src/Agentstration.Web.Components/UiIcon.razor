        case "sparkle":
            <path d="M12 3c.7 4.8 2.2 6.3 7 7-4.8.7-6.3 2.2-7 7-.7-4.8-2.2-6.3-7-7 4.8-.7 6.3-2.2 7-7Z"/><path d="M19 15c.3 2.1.9 2.7 3 3-2.1.3-2.7.9-3 3-.3-2.1-.9-2.7-3-3 2.1-.3 2.7-.9 3-3Z"/>
            break;
        case "offline":
            <path d="m3 3 18 18M5.2 10.2A10.8 10.8 0 0 1 12 8c2.6 0 5 .9 6.8 2.3M8.5 13.5A5.8 5.8 0 0 1 12 12c1.3 0 2.5.4 3.5 1.1M12 18h.01"/>
