        case "send":
            <path d="m21 3-7.4 18-3.4-7.2L3 10.4 21 3Z"/><path d="m10.2 13.8 4.5-4.5"/>
            break;
        case "document":
            <path d="M6 2.8h8l4 4V21H6Z"/><path d="M14 2.8V7h4M9 12h6M9 16h6"/>
