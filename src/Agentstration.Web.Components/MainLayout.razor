@inherits LayoutComponentBase
@implements IAsyncDisposable
@using Agentstration.Web.Components.Localization
@inject NavigationState Navigation
@inject UserPreferencesState Preferences
@inject NotificationState Notifications
@inject PlatformStatusState PlatformStatus
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject IResourceSearchProvider ResourceSearch
@inject ConsoleContextState ContextState
@inject Microsoft.Extensions.Localization.IStringLocalizer<MainLayoutStrings> Localizer

<div class="app-shell @(Navigation.IsSidebarCollapsed ? "sidebar-collapsed" : null) @(Preferences.IsDarkTheme ? "theme-dark" : "theme-light")">
    <aside class="sidebar" aria-label="@T("MainNavigation")">
        <a class="brand-lockup" href="/" aria-label="@T("ControlPlaneHome")">
            <span class="brand-mark brand-mark-compact" aria-hidden="true"><img src="_content/Agentstration.Web.Components/images/agentstration-mark.png" alt="" width="38" height="38" /></span>
            <img class="brand-lockup-logo" src="_content/Agentstration.Web.Components/images/agentstration-lockup.png" alt="" width="204" height="38" />
        </a>
        <nav class="side-nav">
            @foreach (var group in NavigationGroups)
            {
                <section class="navigation-group" aria-label="@T(group.LabelKey)">
                    @if (!string.IsNullOrWhiteSpace(group.LabelKey)) { <h2>@T(group.LabelKey)</h2> }
                    @foreach (var item in group.Items)
                    {
                        <NavLink href="@item.Url" Match="@(item.Url is "/" or "/settings" ? NavLinkMatch.All : NavLinkMatch.Prefix)" aria-label="@T(item.LabelKey)" title="@T(item.LabelKey)" class="@($"domain-{item.Domain}")">
                            <span class="nav-icon" aria-hidden="true"><UiIcon Name="@item.Icon" /></span><span class="nav-label">@T(item.LabelKey)</span>
                        </NavLink>
                    }
                </section>
            }
        </nav>
        <a class="sidebar-footer" href="/" aria-label="@T("OpenPlatformHealth")">
            <HealthIndicator Label="@T("Platform")" StatusText="@PlatformStatus.Label" Status="@PlatformStatus.Status" />
            @if (PlatformStatus.Status is UiStatus.Warning or UiStatus.Danger) { <small>@T("RequiresAttention")</small> }
        </a>
    </aside>

    <div class="workspace">
        <header class="topbar">
            <div class="topbar-start">
                <button class="icon-button" @onclick="Navigation.ToggleSidebar" aria-label="@T("ToggleNavigation")" aria-expanded="@(!Navigation.IsSidebarCollapsed)">☰</button>
                <nav class="breadcrumb" aria-label="@T("CurrentOrganizationWorkspace")"><a href="/settings/organization">@(ContextState.Current?.TenantDisplayName ?? T("OrganizationFallback"))</a><span>/</span><strong>@CurrentSection</strong></nav>
            </div>
            <button class="command-palette-trigger" type="button" @onclick="OpenCommandPalette" aria-keyshortcuts="Control+K" aria-haspopup="dialog" aria-expanded="@commandPaletteOpen" title="@T("OpenCommandPalette")">
                <span aria-hidden="true">⌕</span><span>@T("SearchPagesCommands")</span><kbd>Ctrl K</kbd>
            </button>
            <div class="topbar-actions">
                @if (ContextState.Current is { } context)
                {
                    @if (context.Workspaces.Count > 1)
                    {
                        <label class="context-switcher">
                            <span class="sr-only">@T("Workspace")</span>
                            <select value="@context.WorkspaceId" @onchange="SelectWorkspaceAsync" disabled="@switchingWorkspace" aria-label="@T("CurrentWorkspace")">
                                @foreach (var workspace in context.Workspaces) { <option value="@workspace.Id">@WorkspaceLabel(context, workspace)</option> }
                            </select>
                        </label>
                    }
                    else
                    {
                        <span class="context-workspace-static" title="@T("OnlyOneWorkspace")">@context.WorkspaceDisplayName</span>
                    }
                }
                <EnvironmentSwitcher />
                <button class="icon-button" @onclick="ToggleThemeAsync" disabled="@Preferences.IsSaving" aria-label="@T("ToggleColorTheme")" title="@(Preferences.Error ?? F("ThemeValue", Preferences.Theme))"><UiIcon Name="@(Preferences.IsDarkTheme ? "theme-light" : "theme-dark")" /></button>
                <button class="icon-button notification-button" @onclick="Notifications.TogglePanel" aria-label="@T("Notifications")"><span aria-hidden="true">♢</span>@if (Notifications.UnreadCount > 0) { <span class="notification-count">@Notifications.UnreadCount</span> }</button>
                <a class="icon-button" href="/account/security" aria-label="@T("AccountSecurity")" title="@T("AccountSecurity")"><UiIcon Name="shield-check" /></a>
                <a class="icon-button" href="/logout" aria-label="@T("SignOut")" title="@T("SignOut")"><UiIcon Name="log-out" /></a>
            </div>
        </header>
        <main class="content" id="main-content">@Body</main>
    </div>

    @if (Notifications.IsPanelOpen)
    {
        <aside class="notification-panel" aria-label="@T("Notifications")">
            <header><div><p class="eyebrow">@T("Activity")</p><h2>@T("Notifications")</h2></div><button class="icon-button" @onclick="Notifications.TogglePanel" aria-label="@T("CloseNotifications")">×</button></header>
            @if (Notifications.Items.Count == 0) { <EmptyState Title="@T("AllQuiet")" Message="@T("OperationalNotices")" /> }
            else { <button class="text-button" @onclick="Notifications.MarkAllRead">@T("MarkAllRead")</button>@foreach (var item in Notifications.Items) { <article class="notification-item"><StatusIndicator Text="@item.Title" Status="@item.Status" /><p>@item.Message</p><time datetime="@item.Timestamp.ToString("O")">@item.Timestamp.LocalDateTime.ToString("g")</time></article> } }
        </aside>
    }

    @if (commandPaletteOpen)
    {
        <div class="command-palette-backdrop" @onclick="CloseCommandPalette">
            <section class="command-palette" role="dialog" aria-modal="true" aria-label="@T("CommandPalette")" @onclick:stopPropagation="true">
                <header>
                    <span aria-hidden="true">⌕</span>
                    <input @ref="commandInput" value="@commandQuery" @oninput="UpdateCommandQuery" @onkeydown="HandleCommandKeyDown" placeholder="@T("SearchPagesCommands")" aria-label="@T("SearchPagesCommandsAria")" autocomplete="off" />
                    <button class="command-palette-close" type="button" @onclick="CloseCommandPalette" aria-label="@T("CloseCommandPalette")">Esc</button>
                </header>
                <div class="command-results" role="listbox" aria-label="@T("MatchingDestinations")" aria-busy="@searchingResources">
                    @if (searchingResources)
                    {
                        <p class="command-searching"><span class="command-search-spinner" aria-hidden="true"></span>@T("SearchingResources")</p>
                    }
                    @if (DisplayedCommands.Count == 0 && !searchingResources)
                    {
                        <p class="command-empty">@T("NoMatch")</p>
                    }
                    else
                    {
                        @for (var index = 0; index < DisplayedCommands.Count; index++)
                        {
                            var command = DisplayedCommands[index];
                            var commandIndex = index;
                            <button type="button" class="command-result @(selectedCommandIndex == commandIndex ? "selected" : null)" role="option" aria-selected="@(selectedCommandIndex == commandIndex)" @onmouseenter="() => selectedCommandIndex = commandIndex" @onclick="() => ExecuteCommand(command)">
                                <span class="command-icon" aria-hidden="true">@command.Icon</span><span><strong>@command.Label</strong><small>@command.Category@if (!string.IsNullOrWhiteSpace(command.Detail)) { <span> · @command.Detail</span> }</small></span><kbd>↵</kbd>
                            </button>
                        }
                    }
                </div>
                <footer><span><kbd>↑</kbd><kbd>↓</kbd> @T("Navigate")</span><span><kbd>↵</kbd> @T("Open")</span><span><kbd>Esc</kbd> @T("Close")</span></footer>
            </section>
        </div>
    }
</div>
