@using Agentstration.Resources
@using Microsoft.AspNetCore.Components.Routing
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

<ResourcePreviewPanel IsOpen="@(Enabled && address is not null)" OnClose="Close" OnClosed="OnClosed">
    @if (Enabled && address is { } selected) { @ChildContent(selected) }
</ResourcePreviewPanel>

@code {
    [Parameter, EditorRequired] public string ResourceKind { get; set; } = string.Empty;
    [Parameter, EditorRequired] public RenderFragment<ScopedResourceAddress> ChildContent { get; set; } = null!;
    [Parameter] public string? ContextKey { get; set; }
    [Parameter] public bool Enabled { get; set; } = true;
    [Parameter] public EventCallback OnClosed { get; set; }
    private ScopedResourceAddress? address;
    private string? previousContext;
    private bool contextEstablished;
    private string collectionPath = string.Empty;
    private string? observedNavigation;
    private IJSObjectReference? module;
    private IJSObjectReference? browserObserver;
    private DotNetObjectReference<ResourceCollectionPreview>? reference;
    private bool disposed;

    protected override void OnInitialized()
    {
        collectionPath = Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath;
        Navigation.LocationChanged += LocationChanged;
    }

    protected override void OnParametersSet()
    {
        // Initial authentication may replace a loading key before previews are enabled.
        // Preserve the incoming exact address until the first authorized context exists.
        var contextChanged = contextEstablished && previousContext != ContextKey;
        previousContext = ContextKey;
        contextEstablished |= Enabled && ContextKey is not null;
        if (contextChanged)
        {
            Close();
            return;
        }
        if (observedNavigation != Navigation.Uri)
        {
            observedNavigation = Navigation.Uri;
            Restore(Navigation.Uri);
        }
    }

    public void Open(ScopedResourceAddress target)
    {
        if (!Enabled || disposed) return;
        if (target.Kind != ResourceKind || target.ScopeRef == default)
            throw new ArgumentException("A collection preview requires an exact address of its resource kind.", nameof(target));
        var fragment = string.Join('/', "preview", Uri.EscapeDataString(target.Kind), Uri.EscapeDataString(target.ScopeRef.Value),
            Uri.EscapeDataString(target.Namespace.Value), Uri.EscapeDataString(target.Name));
        Navigation.NavigateTo(Navigation.Uri.Split('#')[0] + "#" + fragment);
        // Server navigation updates the browser asynchronously. Show the selection
        // immediately, independently of the later LocationChanged notification.
        address = target;
        StateHasChanged();
    }

    public void Close()
    {
        var wasOpen = address is not null;
        address = null;
        if (!disposed && IsCollectionLocation() && (wasOpen || Navigation.ToAbsoluteUri(Navigation.Uri).Fragment.StartsWith("#preview/", StringComparison.Ordinal)))
            Navigation.NavigateTo(Navigation.Uri.Split('#')[0], replace: true);
        if (!disposed) StateHasChanged();
    }

    private bool IsCollectionLocation() => string.Equals(Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath, collectionPath, StringComparison.OrdinalIgnoreCase);
    private void Restore(string location)
    {
        address = null;
        if (!Uri.TryCreate(location, UriKind.Absolute, out var target)
            || target.GetLeftPart(UriPartial.Authority) != Navigation.ToAbsoluteUri(Navigation.BaseUri).GetLeftPart(UriPartial.Authority)
            || !string.Equals(target.AbsolutePath, collectionPath, StringComparison.OrdinalIgnoreCase)) return;
        var fragment = target.Fragment;
        if (fragment.Length > 2048 || !fragment.StartsWith("#preview/", StringComparison.Ordinal)) return;
        var segments = fragment[1..].Split('/');
        if (segments.Length != 5 || segments.Any(string.IsNullOrWhiteSpace)) return;
        try
        {
            var kind = Uri.UnescapeDataString(segments[1]);
            if (kind != ResourceKind) return;
            address = ScopedResourceAddress.Create(ResourceScopeRef.Parse(Uri.UnescapeDataString(segments[2])),
                ResourceNamespace.Parse(Uri.UnescapeDataString(segments[3])), kind, Uri.UnescapeDataString(segments[4]));
        }
        catch (Exception error) when (error is ArgumentException or FormatException) { }
    }

    private void LocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (disposed) return;
        _ = InvokeAsync(() => { if (!disposed) { observedNavigation = args.Location; Restore(args.Location); StateHasChanged(); } });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Agentstration.Web.Components/preview-location.js");
        if (disposed) { await module.DisposeAsync(); module = null; return; }
        reference = DotNetObjectReference.Create(this);
        var observer = await module.InvokeAsync<IJSObjectReference>("observePreviewLocation", reference);
        if (disposed) { await observer.InvokeVoidAsync("dispose"); await observer.DisposeAsync(); return; }
        browserObserver = observer;
    }

    [JSInvokable]
    public Task NavigatePreviewLocation(string location) => InvokeAsync(() =>
    {
        if (disposed || !Uri.TryCreate(location, UriKind.Absolute, out var target)
            || target.GetLeftPart(UriPartial.Authority) != Navigation.ToAbsoluteUri(Navigation.BaseUri).GetLeftPart(UriPartial.Authority)
            || !string.Equals(target.AbsolutePath, collectionPath, StringComparison.OrdinalIgnoreCase)
            || target.Query != Navigation.ToAbsoluteUri(Navigation.Uri).Query
            || target.Fragment.Length > 2048 || !target.Fragment.StartsWith("#preview/", StringComparison.Ordinal)) return;
        // Do not mount content until native navigation accepts the destination.
        Navigation.NavigateTo(location, new NavigationOptions { HistoryEntryState = Navigation.HistoryEntryState });
    });

    // Native fragment navigation can raise hashchange without notifying Blazor's
    // NavigationManager. Observe it without adding history entries or bypassing guards.
    [JSInvokable]
    public Task RestoreBrowserLocation(string location) => InvokeAsync(() =>
    {
        if (disposed) return;
        Restore(location);
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        Navigation.LocationChanged -= LocationChanged;
        try
        {
            if (browserObserver is not null) { await browserObserver.InvokeVoidAsync("dispose"); await browserObserver.DisposeAsync(); }
            if (module is not null) await module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) { }
        finally { reference?.Dispose(); }
        GC.SuppressFinalize(this);
    }
}
