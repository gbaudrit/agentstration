@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedFormStrings> Shared
@if (Items.Count == 0) { <EmptyState Title="@EmptyTitle" Message="@EmptyMessage" /> }
else { <ol class="event-list">@foreach (var item in Items) { <li><span class="event-marker level-@item.Level.ToLowerInvariant()" aria-hidden="true"></span>@if (item.Url is not null) { <a class="event-list-resource" href="@item.Url"><div class="event-heading"><strong>@item.Summary</strong><StatusBadge Text="@LevelLabel(item.Level)" Status="@LevelTone(item.Level)" /><time datetime="@item.Timestamp.ToString("O")">@item.Timestamp.LocalDateTime.ToString("HH:mm:ss")</time></div><p>@item.Source · @item.Type</p>@if (!string.IsNullOrWhiteSpace(item.CorrelationId)) { <code>@item.CorrelationId</code> }</a> } else { <div><div class="event-heading"><strong>@item.Summary</strong><StatusBadge Text="@LevelLabel(item.Level)" Status="@LevelTone(item.Level)" /><time datetime="@item.Timestamp.ToString("O")">@item.Timestamp.LocalDateTime.ToString("HH:mm:ss")</time></div><p>@item.Source · @item.Type</p>@if (!string.IsNullOrWhiteSpace(item.CorrelationId)) { <code>@item.CorrelationId</code> }</div> }@if (item.Url is not null) { <CollectionActions ResourceName="@($"{item.Summary} ({item.Timestamp:O})")"><a href="@item.Url">@Shared["OpenItem"]</a></CollectionActions> }</li> }</ol> }
@code {
    private string LevelLabel(string value) => Shared[$"EventLevel.{value.ToLowerInvariant() switch { "trace" => "Trace", "debug" => "Debug", "information" or "info" => "Information", "warning" => "Warning", "error" => "Error", "critical" => "Critical", _ => "Unknown" }}"];
    private static UiStatus LevelTone(string value) => value.ToLowerInvariant() switch { "warning" => UiStatus.Warning, "error" or "critical" => UiStatus.Danger, "information" or "info" => UiStatus.Info, _ => UiStatus.Neutral };

    [Parameter, EditorRequired] public IReadOnlyList<EventListItem> Items { get; set; } = [];
    [Parameter, EditorRequired] public string EmptyTitle { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string EmptyMessage { get; set; } = string.Empty;
}

