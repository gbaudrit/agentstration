<header class="resource-header resource-domain-@Domain" data-testid="@TestId">
    <div class="resource-header-identity">
        <ResourceIcon Source="@ImageSource" DarkSource="@DarkImageSource" IconName="@IconName" Fallback="@Icon" Domain="@Domain" ChildContent="@IconContent" />
        <div class="resource-header-copy">
            <div class="resource-title-row">
                <span class="eyebrow resource-type">@ResourceType</span>
                <h1>@Name</h1>
                @if (!string.IsNullOrWhiteSpace(StatusText)) { <StatusIndicator Text="@StatusText" Status="@Status" /> }
            </div>
            @if (!string.IsNullOrWhiteSpace(Description)) { <p class="resource-description" title="@Description" tabindex="0">@Description</p> }
            @if (Metadata is not null || !string.IsNullOrWhiteSpace(TechnicalName))
            {
                <div class="resource-metadata">@Metadata
                    @if (!string.IsNullOrWhiteSpace(TechnicalName)) { <span class="resource-header-technical" title="@TechnicalName"><CopyableValue Value="@TechnicalName" /></span> }
                </div>
            }
        </div>
    </div>
    @if (Actions is not null || PrimaryActions is not null || MoreActions is not null) { <div class="page-actions"><ResourceActionBar Primary="@PrimaryActions" MoreActions="@MoreActions">@Actions</ResourceActionBar></div> }
</header>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ResourceType { get; set; } = string.Empty;
    [Parameter] public string Domain { get; set; } = "neutral";
    [Parameter] public string Icon { get; set; } = "◇";
    [Parameter] public string? ImageSource { get; set; }
    [Parameter] public string? DarkImageSource { get; set; }
    [Parameter] public RenderFragment? IconContent { get; set; }
    [Parameter] public RenderFragment? PrimaryActions { get; set; }
    [Parameter] public RenderFragment? MoreActions { get; set; }
    [Parameter] public string? IconName { get; set; }
    [Parameter] public string? TechnicalName { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? StatusText { get; set; }
    [Parameter] public UiStatus Status { get; set; }
    [Parameter] public RenderFragment? Metadata { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public string? TestId { get; set; }
}
