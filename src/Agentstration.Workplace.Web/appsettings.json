{
  "Observability": {
    "Http": {
      "Enabled": false,
      "LogMetadata": true,
      "CaptureRequestBody": false,
      "CaptureResponseBody": false,
      "MaximumBodyBytes": 16384,
      "ExcludedPaths": [
        "/health",
        "/_blazor",
        "/hubs"
      ]
    }
  },
  "Agentstration": {
    "Localization": { "DefaultCulture": "en-US", "SupportedCultures": [ "en-US", "fr-FR" ] },
    "ApiBaseUrl": "http://localhost:5100/",
    "WorkplaceHubUrl": "http://localhost:5100/hubs/workplace"
  },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*"
}
