@page "/"
@page "/w/{WorkspaceName}"
@page "/w/{WorkspaceName}/d/{DashboardName}"
@attribute [StreamRendering]
@implements IDisposable
@inject IWorkplaceApiClient Api
@inject WorkplaceRealtimeClient Realtime
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IHostEnvironment HostEnvironment
@inject WorkplaceContextState WorkplaceContext
@inject Microsoft.Extensions.Localization.IStringLocalizer<WorkplacePageStrings> Localizer

<PageTitle>Workplace · Agentstration</PageTitle>

@if (loading) { <LoadingState /> }
else if (loadError is not null) { <ServiceUnavailableState Message="@loadError" /> }
else
{
    <div class="workplace-heading">
        <div><p class="eyebrow">@T("Workspace")</p><h1>@(workspace?.DisplayName ?? "Workplace")</h1></div>
        <RealtimeStatus Connected="RealtimeConnected" />
    </div>
    <nav class="dashboard-navigation" aria-label="@T("Dashboards")">
        <div class="dashboard-links">
            @foreach (var item in dashboards)
            {
                <NavLink href="@DashboardUrl(item.Name)" Match="NavLinkMatch.All"><UiIcon Name="layout-grid" /> <span>@item.DisplayName</span></NavLink>
            }
        </div>
        <label class="dashboard-select"><span>@T("Dashboard")</span><select value="@dashboard?.Name" @onchange="DashboardChanged">@foreach (var item in dashboards) { <option value="@item.Name">@item.DisplayName</option> }</select></label>
    </nav>
    <section class="mobile-welcome" aria-label="@T("Welcome")"><small>@T("WelcomeBack")</small><h1>@T("HelloUser", UserDisplayName)</h1><span>@T("WhatWouldYouLike")</span></section>
    <div class="workplace-shell">
        <div class="workplace-primary">
            @if (interaction is null)
            {
                @if (primary is not null)
                {
                    <PrimaryEntryContainer Busy="busy"><EntryRenderer Definition="@ToDefinition(primary)" Role="DashboardItemRole.Primary" OnSubmit="values => SubmitAsync(primary, values)" Disabled="busy" Busy="busy" /></PrimaryEntryContainer>
                }
                <section class="mobile-dashboards" aria-label="@T("Dashboards")">
                    <div class="section-heading"><h2>@T("YourSpaces")</h2></div>
                    <div class="mobile-dashboard-cards">
                        @foreach (var item in dashboards)
                        {
                            <NavLink class="@(string.Equals(item.Name, dashboard?.Name, StringComparison.Ordinal) ? "is-selected" : null)" href="@DashboardUrl(item.Name)" Match="NavLinkMatch.All" aria-current="@(string.Equals(item.Name, dashboard?.Name, StringComparison.Ordinal) ? "page" : null)">
                                <span class="mobile-dashboard-art" aria-hidden="true">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl)) { <img src="@item.ImageUrl" alt="" /> }
                                    else { <UiIcon Name="@DashboardIcon(item)" /> }
                                </span>
                                <span>@item.DisplayName</span>
                            </NavLink>
                        }
                    </div>
                </section>
                @if (featuredEntries.Count > 0)
                {
                    <section class="featured-entries"><div class="section-heading"><div><p class="eyebrow">@T("Featured")</p><h2>@T("FeaturedTools")</h2></div></div><div class="standard-entry-grid">@foreach(var entry in featuredEntries){<StandardEntryContainer><EntryRenderer Definition="@ToDefinition(entry)" Role="DashboardItemRole.Featured" OnSubmit="values => SubmitAsync(entry, values)" Disabled="busy" Busy="busy" /></StandardEntryContainer>}</div></section>
                }
                @if (standardEntries.Count > 0)
                {
                    <button class="mobile-tools-toggle" type="button" aria-expanded="@showMoreEntries" @onclick="() => showMoreEntries = !showMoreEntries"><UiIcon Name="plus" /> @(showMoreEntries ? T("HideOtherTools") : T("MoreWaysToStart"))</button>
                    <section class="standard-entries @(showMoreEntries ? "mobile-open" : null)"><div class="section-heading"><div><p class="eyebrow">@T("Shortcuts")</p><h2>@T("OtherWaysToStart")</h2></div></div><div class="standard-entry-grid">@foreach(var entry in standardEntries){<StandardEntryContainer><EntryRenderer Definition="@ToDefinition(entry)" Role="DashboardItemRole.Standard" OnSubmit="values => SubmitAsync(entry, values)" Disabled="busy" Busy="busy" /></StandardEntryContainer>}</div></section>
                }
            }
            else
            {
                <InteractionView Messages="messages" Action="currentAction" PendingAction="pendingAction" ActionTimestamp="interaction.LastActivityAt" Presentation="@(activeEntry?.Presentation ?? new EntryPresentation())" Status="interaction.Status" Task="activeTask" Activities="activities" Results="results" Artifacts="artifacts" Busy="busy" DiagnosticsEnabled="HostEnvironment.IsDevelopment()" RealtimeConnected="RealtimeConnected" Error="@interactionError" OnPendingAction="RespondAsync" OnMessage="ContinueAsync" OnNewRequest="NewRequest" ArtifactContentUrl="ArtifactUrl" TaskDetailsUrl="TaskUrl" />
            }
            @if (interaction is null && primary is null && featuredEntries.Count == 0 && standardEntries.Count == 0) { <EmptyState Title="@T("EmptyDashboard")" Message="@T("EmptyDashboardHelp")" /> }
            <section class="home-section recent-work @(tasks.Count == 0 ? "is-empty" : null)">
                <div class="section-heading"><div><p class="eyebrow">@T("Work")</p><h2>@T("RecentTasks")</h2></div><a href="@($"/w/{Uri.EscapeDataString(CurrentWorkspaceName)}/tasks")">@T("ViewAll")</a></div>
                @if (tasks.Count == 0) { <div class="compact-empty"><EmptyState Title="@T("NoTasksYet")" Message="@T("NoTasksYetHelp")" /></div> }
                else { <div class="task-cards">@foreach (var item in tasks.Take(4)) { <a class="task-card-link" href="@($"/w/{Uri.EscapeDataString(CurrentWorkspaceName)}/tasks/{item.Id}")"><TaskStatusBadge Value="item.Status" /><strong>@item.Title</strong><small>@T("Updated") @item.UpdatedAt.LocalDateTime.ToString("g")</small></a> }</div> }
            </section>
            @if (recentInteractions.Count > 0)
            {
                <section class="home-section recent-conversations"><div class="section-heading"><div><p class="eyebrow">@T("History")</p><h2>@T("RecentConversations")</h2></div></div><div class="conversation-cards">@foreach(var item in recentInteractions.Where(value => value.Id != interaction?.Id).Take(5)){<a href="@InteractionUrl(item.Id)"><span>@ConversationTitle(item)</span><small>@ConversationStatus(item.Status) · @item.LastActivityAt.LocalDateTime.ToString("g")</small></a>}</div></section>
            }
        </div>
        <aside class="attention-rail">
            <section class="attention-summary"><div><strong>@tasks.Count(value => value.Status == WorkTaskStatus.ActionRequired)</strong><span>@T("NeedYourInput")</span></div><div><strong>@unread</strong><span>@T("UnreadUpdates")</span></div></section>
            <NotificationCenter Notifications="notifications.Take(5).ToArray()" OnMarkRead="MarkReadAsync" OnMarkAllRead="MarkAllReadAsync" />
        </aside>
    </div>
}
