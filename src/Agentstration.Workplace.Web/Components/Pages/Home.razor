@page "/"
@page "/w/{WorkspaceName}"
@page "/w/{WorkspaceName}/d/{DashboardName}"
@page "/w/{WorkspaceName}/d/{DashboardName}/conversations/{ConversationId:guid}"
@attribute [StreamRendering]
@implements IDisposable
@inject IWorkplaceApiClient Api
@inject WorkplaceRealtimeClient Realtime
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IHostEnvironment HostEnvironment
@inject WorkplaceContextState WorkplaceContext
@inject Microsoft.Extensions.Localization.IStringLocalizer<WorkplacePageStrings> Localizer

<PageTitle>Workplace · Agentstration</PageTitle>

@if (loading) { <LoadingState /> }
else if (loadError is not null) { <ServiceUnavailableState Message="@loadError" /> }
else
{
    @if (interaction is null)
    {
        <div class="workplace-heading">
            <div><p class="eyebrow">@T("Workspace")</p><h1>@(workspace?.DisplayName ?? "Workplace")</h1></div>
            <RealtimeStatus Connected="RealtimeConnected" />
        </div>
        <nav class="dashboard-navigation" aria-label="@T("Dashboards")">
            <div class="dashboard-links">
                @foreach (var item in dashboards)
                {
                    <NavLink href="@DashboardUrl(item.Name)" Match="NavLinkMatch.All"><UiIcon Name="layout-grid" /> <span>@item.DisplayName</span></NavLink>
                }
            </div>
            <label class="dashboard-select"><span>@T("Dashboard")</span><select value="@dashboard?.Name" @onchange="DashboardChanged">@foreach (var item in dashboards) { <option value="@item.Name">@item.DisplayName</option> }</select></label>
        </nav>
        <section class="mobile-welcome" aria-label="@T("Welcome")"><small>@T("WelcomeBack")</small><h1>@T("HelloUser", UserDisplayName)</h1><span>@T("WhatWouldYouLike")</span></section>
        <section class="attention-summary" aria-label="@T("Workspace")">
            <a href="@($"/w/{Uri.EscapeDataString(CurrentWorkspaceName)}/tasks")"><strong>@tasks.Count</strong><span>@T("Activity")</span></a>
            <a href="@($"/w/{Uri.EscapeDataString(CurrentWorkspaceName)}/tasks")"><strong>@tasks.Count(value => value.Status == WorkTaskStatus.ActionRequired)</strong><span>@T("NeedYourInput")</span></a>
            <a href="@($"/w/{Uri.EscapeDataString(CurrentWorkspaceName)}/notifications")"><strong>@unread</strong><span>@T("UnreadUpdates")</span></a>
        </section>
    }
    <div class="workplace-shell">
        <div class="workplace-primary">
            @if (interaction is null)
            {
                @if (SelectedHomeEntry is { } selectedEntry)
                {
                    <PrimaryEntryContainer @key="selectedEntry" Busy="busy"><EntryRenderer Definition="@ToDefinition(selectedEntry)" Role="@EntryRole(selectedEntry)" OnSubmit="values => SubmitAsync(selectedEntry, values)" Disabled="busy" Busy="busy" /></PrimaryEntryContainer>
                }
                <section class="mobile-dashboards" aria-label="@T("Dashboards")">
                    <div class="section-heading"><h2>@T("YourSpaces")</h2></div>
                    <div class="mobile-dashboard-cards">
                        @foreach (var item in dashboards)
                        {
                            <NavLink class="@(string.Equals(item.Name, dashboard?.Name, StringComparison.Ordinal) ? "is-selected" : null)" href="@DashboardUrl(item.Name)" Match="NavLinkMatch.All" aria-current="@(string.Equals(item.Name, dashboard?.Name, StringComparison.Ordinal) ? "page" : null)">
                                <span class="mobile-dashboard-art" aria-hidden="true">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl)) { <img src="@item.ImageUrl" alt="" /> }
                                    else { <UiIcon Name="@DashboardIcon(item)" /> }
                                </span>
                                <span>@item.DisplayName</span>
                            </NavLink>
                        }
                    </div>
                </section>
                @if (AlternativeEntries.Any())
                {
                    <section class="mobile-entry-picker" aria-labelledby="mobile-entry-picker-heading">
                        <div class="section-heading"><h2 id="mobile-entry-picker-heading">@T("OtherWaysToStart")</h2></div>
                        <div class="mobile-entry-options">
                            @foreach (var entry in AlternativeEntries)
                            {
                                <button type="button" @onclick="() => SelectHomeEntry(entry)" disabled="@busy">
                                    <span class="mobile-entry-icon" aria-hidden="true"><UiIcon Name="@(entry.Presentation.Icon ?? "sparkle")" /></span>
                                    <span class="mobile-entry-copy"><strong>@entry.DisplayName</strong>@if (!string.IsNullOrWhiteSpace(entry.Description)) { <small>@entry.Description</small> }</span>
                                    <span class="mobile-entry-arrow" aria-hidden="true">→</span>
                                </button>
                            }
                        </div>
                    </section>
                }
                @if (VisibleFeaturedEntries.Any())
                {
                    <section class="featured-entries"><div class="section-heading"><div><p class="eyebrow">@T("Featured")</p><h2>@T("FeaturedTools")</h2></div></div><div class="standard-entry-grid">@foreach(var entry in VisibleFeaturedEntries){<StandardEntryContainer><EntryRenderer Definition="@ToDefinition(entry)" Role="DashboardItemRole.Featured" OnSubmit="values => SubmitAsync(entry, values)" Disabled="busy" Busy="busy" /></StandardEntryContainer>}</div></section>
                }
                @if (VisibleStandardEntries.Any())
                {
                    <section class="standard-entries"><div class="section-heading"><div><p class="eyebrow">@T("Shortcuts")</p><h2>@T("OtherWaysToStart")</h2></div></div><div class="standard-entry-grid">@foreach(var entry in VisibleStandardEntries){<StandardEntryContainer><EntryRenderer Definition="@ToDefinition(entry)" Role="DashboardItemRole.Standard" OnSubmit="values => SubmitAsync(entry, values)" Disabled="busy" Busy="busy" /></StandardEntryContainer>}</div></section>
                }
            }
            else
            {
                <InteractionView Messages="messages" Action="currentAction" PendingAction="pendingAction" ActionTimestamp="interaction.LastActivityAt" Presentation="@(activeEntry?.Presentation ?? new EntryPresentation())" Status="interaction.Status" Task="activeTask" Activities="activities" Results="results" Artifacts="artifacts" Busy="busy" DiagnosticsEnabled="HostEnvironment.IsDevelopment()" RealtimeConnected="RealtimeConnected" Error="@interactionError" OnPendingAction="RespondAsync" OnMessage="ContinueAsync" OnNewRequest="NewRequest" ArtifactContentUrl="ArtifactUrl" TaskDetailsUrl="TaskUrl" />
            }
            @if (interaction is null && primary is null && featuredEntries.Count == 0 && standardEntries.Count == 0) { <EmptyState Title="@T("EmptyDashboard")" Message="@T("EmptyDashboardHelp")" /> }
        </div>
    </div>
}
