<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Agentstration</title>
    <link rel="icon" type="image/png" href="~/_content/Agentstration.Web.Components/images/agentstration-mark.png" />
    <link rel="stylesheet" href="~/_content/Agentstration.Web.Components/agentstration.css" />
    <link rel="stylesheet" href="~/_content/Agentstration.Web.Components/design-tokens.css" />
    <link rel="stylesheet" href="~/Agentstration.Web.styles.css" />
    <link rel="stylesheet" href="~/auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/Agentstration.Web.Components/account-form-theme.css" />
</head>
<body class="auth-page native-form-page" data-authenticated="@((User.Identity?.IsAuthenticated == true).ToString().ToLowerInvariant())">
    <main class="auth-shell">
        <section class="auth-card">
            <a class="auth-brand" href="/" aria-label="@Auth["AgentstrationHome"]">
                <img src="~/_content/Agentstration.Web.Components/images/agentstration-lockup-light.png" data-theme-light-src="@Url.Content("~/_content/Agentstration.Web.Components/images/agentstration-lockup-light.png")" data-theme-dark-src="@Url.Content("~/_content/Agentstration.Web.Components/images/agentstration-lockup-dark.png")" alt="" />
            </a>
            @RenderBody()
        </section>
    </main>
    <script type="module" src="~/_content/Agentstration.Web.Components/native-form-controls.js"></script>
</body>
</html>
