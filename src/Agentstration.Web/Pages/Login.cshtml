@page "/login"
@model LoginModel
@{
    ViewData["Title"] = Auth["SignIn"];
}

<header class="auth-heading">
    <p class="eyebrow">@Auth["WelcomeBack"]</p>
    <h1>@Auth["SignIn"]</h1>
    <p>@Auth["SignInDescription"]</p>
</header>

@if (Model.LocalLoginAvailable)
{
    <form method="post" class="auth-form">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <label asp-for="Input.UserName">@Auth["Username"]</label>
        <input asp-for="Input.UserName" autocomplete="username" autofocus />
        <span asp-validation-for="Input.UserName" class="field-error"></span>
        <label asp-for="Input.Password">@Auth["Password"]</label>
        <input asp-for="Input.Password" autocomplete="current-password" />
        <span asp-validation-for="Input.Password" class="field-error"></span>
        <label class="check-field"><input asp-for="Input.RememberMe" /> <span>@Auth["KeepSignedIn"]</span></label>
        <button type="submit" class="primary-action">@Auth["SignIn"]</button>
    </form>
}

@if (Model.ExternalLoginAvailable)
{
    @if (Model.LocalLoginAvailable) { <div class="auth-divider"><span>@Auth["Or"]</span></div> }
    <a class="secondary-action" href="@Model.ExternalLoginUrl">@Auth["ContinueIdentityProvider"]</a>
}
