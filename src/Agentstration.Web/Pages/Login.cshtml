@page "/login"
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<header class="auth-heading">
    <p class="eyebrow">Welcome back</p>
    <h1>Sign in</h1>
    <p>Authenticate to access this Agentstration instance.</p>
</header>

@if (Model.LocalLoginAvailable)
{
    <form method="post" class="auth-form">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <label asp-for="Input.UserName"></label>
        <input asp-for="Input.UserName" autocomplete="username" autofocus />
        <span asp-validation-for="Input.UserName" class="field-error"></span>
        <label asp-for="Input.Password"></label>
        <input asp-for="Input.Password" autocomplete="current-password" />
        <span asp-validation-for="Input.Password" class="field-error"></span>
        <label class="check-field"><input asp-for="Input.RememberMe" /> <span>Keep me signed in</span></label>
        <button type="submit" class="primary-action">Sign in</button>
    </form>
}

@if (Model.ExternalLoginAvailable)
{
    @if (Model.LocalLoginAvailable) { <div class="auth-divider"><span>or</span></div> }
    <a class="secondary-action" href="@Model.ExternalLoginUrl">Continue with your identity provider</a>
}
