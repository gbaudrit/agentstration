@page "/account/pat"
@model Agentstration.Web.Pages.Account.PatModel
@{
    ViewData["Title"] = "Personal access tokens";
}

<header class="auth-heading">
    <p class="eyebrow">Account</p>
    <h1>Personal access tokens</h1>
    <p>Create scoped credentials for scripts and command-line clients. A token never grants more access than your live Workspace membership.</p>
</header>

@if (Model.CreatedToken is not null)
{
    <section class="token-secret" role="status">
        <strong>Copy this token now</strong>
        <p>It will not be shown again.</p>
        <code>@Model.CreatedToken</code>
    </section>
}

<section class="security-section">
    <h2>Create a token</h2>
    <form method="post" asp-page-handler="Create" class="auth-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <label asp-for="Input.Name"></label>
        <input asp-for="Input.Name" autocomplete="off" placeholder="CLI on my laptop" />
        <span asp-validation-for="Input.Name" class="field-error"></span>

        <label asp-for="Input.WorkspaceId">Workspace</label>
        <select asp-for="Input.WorkspaceId">
            @foreach (var workspace in Model.Workspaces)
            {
                <option value="@workspace.Id">@workspace.DisplayName</option>
            }
        </select>

        <label asp-for="Input.ExpiresInDays"></label>
        <select asp-for="Input.ExpiresInDays">
            <option value="30">30 days</option>
            <option value="90">90 days</option>
            <option value="180">180 days</option>
            <option value="365">365 days</option>
        </select>

        <fieldset class="permission-grid">
            <legend>Permissions</legend>
            @foreach (var permission in Model.SupportedPermissions.Order(StringComparer.Ordinal))
            {
                <label>
                    <input type="checkbox" name="Input.Permissions" value="@permission" checked="@Model.Input.Permissions.Contains(permission, StringComparer.Ordinal)" />
                    <span>@permission</span>
                </label>
            }
        </fieldset>
        <span asp-validation-for="Input.Permissions" class="field-error"></span>
        <button type="submit" class="primary-action">Create token</button>
    </form>
</section>

<section class="security-section security-section-separated">
    <div class="section-heading-row">
        <div>
            <h2>Existing tokens</h2>
            <p>Revocation takes effect on the next request.</p>
        </div>
        @if (Model.Tokens.Any(token => Model.Status(token) == "Active"))
        {
            <form method="post" asp-page-handler="RevokeAll">
                <button type="submit" class="danger-action">Revoke all</button>
            </form>
        }
    </div>

    @if (Model.Tokens.Count == 0)
    {
        <p class="account-unavailable">No personal access token has been created.</p>
    }
    else
    {
        <div class="token-list">
            @foreach (var token in Model.Tokens)
            {
                var status = Model.Status(token);
                <article class="token-row">
                    <div>
                        <strong>@token.Name</strong>
                        <code>@token.TokenPrefix…</code>
                        <small>@status · expires @token.ExpiresAt.ToLocalTime().ToString("g") · last used @(token.LastUsedAt?.ToLocalTime().ToString("g") ?? "never")</small>
                    </div>
                    @if (status == "Active")
                    {
                        <form method="post" asp-page-handler="Revoke">
                            <input type="hidden" name="tokenId" value="@token.Id" />
                            <button type="submit" class="danger-action">Revoke</button>
                        </form>
                    }
                </article>
            }
        </div>
    }
</section>

<a href="/account/security" class="auth-back-link">← Account security</a>
