@page "/account/security"
@model Agentstration.Web.Pages.Account.SecurityModel
@{
    ViewData["Title"] = Auth["AccountSecurity"];
}

<header class="auth-heading">
    <p class="eyebrow">@Auth["Account"]</p>
    <h1>@Auth["Security"]</h1>
    @if (Model.Account is not null)
    {
        <p>@Auth["SignedInAs"] <strong>@Model.Account.UserName</strong>@if (!string.IsNullOrWhiteSpace(Model.Account.Email)) { <span> · @Model.Account.Email</span> }</p>
    }
</header>

@if (Model.StatusMessage is not null)
{
    <p class="status-message" role="status">@Model.StatusMessage</p>
}

@if (Model.Account is null)
{
    <p class="account-unavailable">@Auth["ExternalAccountSecurity"]</p>
    <a href="/account/pat" class="secondary-action">@Auth["ManageTokens"]</a>
    <a href="/" class="secondary-action">@Auth["ReturnToConsole"]</a>
}
else
{
    <section class="security-section">
        <h2>@Auth["ChangePassword"]</h2>
        <p>@Auth["ChangePasswordDescription"]</p>
        <form method="post" asp-page-handler="ChangePassword" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <label asp-for="Input.CurrentPassword">@Auth["CurrentPassword"]</label>
            <input asp-for="Input.CurrentPassword" autocomplete="current-password" />
            <span asp-validation-for="Input.CurrentPassword" class="field-error"></span>
            <label asp-for="Input.NewPassword">@Auth["NewPassword"]</label>
            <input asp-for="Input.NewPassword" autocomplete="new-password" />
            <span asp-validation-for="Input.NewPassword" class="field-error"></span>
            <p class="password-guidance">@Auth["PasswordGuidance"]</p>
            <label asp-for="Input.ConfirmPassword">@Auth["ConfirmNewPassword"]</label>
            <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
            <button type="submit" class="primary-action">@Auth["ChangePassword"]</button>
        </form>
    </section>

    <section class="security-section security-section-separated">
        <h2>@Auth["ActiveSessions"]</h2>
        <p>@Auth["ActiveSessionsDescription"]</p>
        <form method="post" asp-page-handler="SignOutOtherSessions">
            <button type="submit" class="secondary-action">@Auth["SignOutOtherSessions"]</button>
        </form>
    </section>

    <section class="security-section security-section-separated">
        <h2>@Auth["PersonalAccessTokens"]</h2>
        <p>@Auth["TokenSectionDescription"]</p>
        <a href="/account/pat" class="secondary-action">@Auth["ManageTokens"]</a>
    </section>

    <a href="/" class="auth-back-link">← @Auth["ReturnToConsole"]</a>
}
