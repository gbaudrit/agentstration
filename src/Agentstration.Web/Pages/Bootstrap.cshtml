@page "/bootstrap"
@model BootstrapModel
@{
    ViewData["Title"] = Auth["InitializeInstance"];
}

<header class="auth-heading" data-testid="console-admin-bootstrap">
    <p class="eyebrow">@Auth["FirstTimeSetup"]</p>
    <h1>@Auth["InitializeAgentstration"]</h1>
    <p>@Auth["InitializeTopologyDescription"]</p>
</header>

<form method="post" class="auth-form">
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    <label asp-for="Input.TenantDisplayName">@Auth["TenantDisplayName"]</label>
    <input asp-for="Input.TenantDisplayName" autocomplete="organization" autofocus data-resource-display-name data-technical-name-target="Input_TenantName" data-maximum-length="64" clear-label="@Auth["TenantDisplayName"]" validation-id="Input_TenantDisplayName-error" />
    <span id="Input_TenantDisplayName-error" asp-validation-for="Input.TenantDisplayName" class="field-error"></span>
    <label asp-for="Input.TenantName">@Auth["TenantTechnicalName"]</label>
    <input asp-for="Input.TenantName" autocomplete="off" data-resource-technical-name clear-label="@Auth["TenantTechnicalName"]" validation-id="Input_TenantName-error" />
    <span id="Input_TenantName-error" asp-validation-for="Input.TenantName" class="field-error"></span>
    <small>@Auth["TechnicalNameHelp"]</small>
    <label asp-for="Input.WorkspaceDisplayName">@Auth["WorkspaceDisplayName"]</label>
    <input asp-for="Input.WorkspaceDisplayName" autocomplete="off" data-resource-display-name data-technical-name-target="Input_WorkspaceName" data-maximum-length="64" clear-label="@Auth["WorkspaceDisplayName"]" validation-id="Input_WorkspaceDisplayName-error" />
    <span id="Input_WorkspaceDisplayName-error" asp-validation-for="Input.WorkspaceDisplayName" class="field-error"></span>
    <label asp-for="Input.WorkspaceName">@Auth["WorkspaceTechnicalName"]</label>
    <input asp-for="Input.WorkspaceName" autocomplete="off" data-resource-technical-name clear-label="@Auth["WorkspaceTechnicalName"]" validation-id="Input_WorkspaceName-error" />
    <span id="Input_WorkspaceName-error" asp-validation-for="Input.WorkspaceName" class="field-error"></span>
    <small>@Auth["TechnicalNameHelp"]</small>
    <label asp-for="Input.DisplayName">@Auth["DisplayName"]</label>
    <input asp-for="Input.DisplayName" autocomplete="name" clear-label="@Auth["DisplayName"]" validation-id="Input_DisplayName-error" />
    <span id="Input_DisplayName-error" asp-validation-for="Input.DisplayName" class="field-error"></span>
    <label asp-for="Input.UserName">@Auth["Username"]</label>
    <input asp-for="Input.UserName" autocomplete="username" clear-label="@Auth["Username"]" validation-id="Input_UserName-error" />
    <span id="Input_UserName-error" asp-validation-for="Input.UserName" class="field-error"></span>
    <label asp-for="Input.Email">@Auth["EmailOptional"]</label>
    <input asp-for="Input.Email" autocomplete="email" clear-label="@Auth["EmailOptional"]" validation-id="Input_Email-error" />
    <span id="Input_Email-error" asp-validation-for="Input.Email" class="field-error"></span>
    <label asp-for="Input.Password">@Auth["Password"]</label>
    <input asp-for="Input.Password" autocomplete="new-password" clear-label="@Auth["Password"]" validation-id="Input_Password-error" />
    <span id="Input_Password-error" asp-validation-for="Input.Password" class="field-error"></span>
    <p class="password-guidance">@Auth["PasswordGuidance"]</p>
    <label asp-for="Input.ConfirmPassword">@Auth["ConfirmPassword"]</label>
    <input asp-for="Input.ConfirmPassword" autocomplete="new-password" clear-label="@Auth["ConfirmPassword"]" validation-id="Input_ConfirmPassword-error" />
    <span id="Input_ConfirmPassword-error" asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
    <button type="submit" class="primary-action">@Auth["CreateAdministrator"]</button>
</form>

<script src="~/resource-name-fields.js" asp-append-version="true"></script>
