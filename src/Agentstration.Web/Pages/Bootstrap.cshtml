@page "/bootstrap"
@model BootstrapModel
@{
    ViewData["Title"] = Auth["InitializeInstance"];
}

<header class="auth-heading">
    <p class="eyebrow">@Auth["FirstTimeSetup"]</p>
    <h1>@Auth["InitializeAgentstration"]</h1>
    <p>@Auth["InitializeTopologyDescription"]</p>
</header>

<form method="post" class="auth-form">
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    <label asp-for="Input.TenantName">@Auth["TenantName"]</label>
    <input asp-for="Input.TenantName" autocomplete="off" />
    <span asp-validation-for="Input.TenantName" class="field-error"></span>
    <label asp-for="Input.TenantDisplayName">@Auth["TenantDisplayName"]</label>
    <input asp-for="Input.TenantDisplayName" autocomplete="organization" />
    <span asp-validation-for="Input.TenantDisplayName" class="field-error"></span>
    <label asp-for="Input.WorkspaceName">@Auth["WorkspaceName"]</label>
    <input asp-for="Input.WorkspaceName" autocomplete="off" />
    <span asp-validation-for="Input.WorkspaceName" class="field-error"></span>
    <label asp-for="Input.WorkspaceDisplayName">@Auth["WorkspaceDisplayName"]</label>
    <input asp-for="Input.WorkspaceDisplayName" autocomplete="off" />
    <span asp-validation-for="Input.WorkspaceDisplayName" class="field-error"></span>
    <label asp-for="Input.DisplayName">@Auth["DisplayName"]</label>
    <input asp-for="Input.DisplayName" autocomplete="name" autofocus />
    <span asp-validation-for="Input.DisplayName" class="field-error"></span>
    <label asp-for="Input.UserName">@Auth["Username"]</label>
    <input asp-for="Input.UserName" autocomplete="username" />
    <span asp-validation-for="Input.UserName" class="field-error"></span>
    <label asp-for="Input.Email">@Auth["EmailOptional"]</label>
    <input asp-for="Input.Email" autocomplete="email" />
    <span asp-validation-for="Input.Email" class="field-error"></span>
    <label asp-for="Input.Password">@Auth["Password"]</label>
    <input asp-for="Input.Password" autocomplete="new-password" />
    <span asp-validation-for="Input.Password" class="field-error"></span>
    <p class="password-guidance">@Auth["PasswordGuidance"]</p>
    <label asp-for="Input.ConfirmPassword">@Auth["ConfirmPassword"]</label>
    <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
    <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
    <button type="submit" class="primary-action">@Auth["CreateAdministrator"]</button>
</form>
