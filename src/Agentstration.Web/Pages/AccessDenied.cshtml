@page "/access-denied"
@model AccessDeniedModel
@{
    ViewData["Title"] = Auth["AccessDenied"];
}

<header class="auth-heading">
    <p class="eyebrow">@Auth["Authorization"]</p>
    <h1>@Auth["AccessDenied"]</h1>
    <p>@Auth["AccessDeniedDescription"]</p>
</header>

<div class="auth-actions">
    <a href="/" class="primary-action">@Auth["ReturnToConsole"]</a>
    <a href="/logout" class="secondary-action">@Auth["UseAnotherAccount"]</a>
</div>
