@page "/access-denied"
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}

<header class="auth-heading">
    <p class="eyebrow">Authorization</p>
    <h1>Access denied</h1>
    <p>Your identity is valid, but it does not have permission to access this resource.</p>
</header>

<div class="auth-actions">
    <a href="/" class="primary-action">Return to the console</a>
    <a href="/logout" class="secondary-action">Use another account</a>
</div>
