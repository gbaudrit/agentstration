@page "/settings/resource-scopes"
@implements IDisposable
@inject IResourceScopeInventoryClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<ResourceScopesStrings> Localizer

<PageTitle>@T("PageTitle")</PageTitle>
<PageHeader Title="@T("Title")" Description="@T("Description")">
    <Actions><button class="button-secondary" @onclick="LoadAsync" disabled="@loading">@T("Refresh")</button></Actions>
</PageHeader>

@if (error is not null)
{
    <ErrorState Title="@T("UnableToLoad")" Message="@error.Message" ErrorId="@error.ErrorId">
        <button class="button-secondary" @onclick="LoadAsync">@T("Retry")</button>
    </ErrorState>
}
else if (inventory is null)
{
    <LoadingState Message="@T("Loading")" />
}
else
{
    <section class="metric-grid" aria-label="@T("Metrics")">
        <MetricCard Label="@T("Scopes")" Value="@inventory.Scopes.Count.ToString()" Status="UiStatus.Info" />
        <MetricCard Label="@T("Resources")" Value="@inventory.Scopes.Sum(scope => scope.Resources.Count).ToString()" Status="UiStatus.Success" />
        <MetricCard Label="@T("SelectedScopeResources")" Value="@(Selected?.Resources.Count.ToString() ?? "0")" />
    </section>

    <section class="scope-explorer">
        <aside class="panel scope-tree" aria-label="@T("Hierarchy")">
            <div class="panel-header"><div><p class="eyebrow">@T("Hierarchy")</p><h2>@T("OwnershipScopes")</h2></div></div>
            @foreach (var instance in inventory.Scopes.Where(scope => scope.Kind == ResourceScopeKind.Instance))
            {
                <ResourceScopeTreeNode Scope="instance" Depth="0" Selected="@(selectedScopeRef == instance.ScopeRef)" OnSelected="Select" />
                @foreach (var tenant in Children(instance.ScopeRef))
                {
                    <ResourceScopeTreeNode Scope="tenant" Depth="1" Selected="@(selectedScopeRef == tenant.ScopeRef)" OnSelected="Select" />
                    @foreach (var workspace in Children(tenant.ScopeRef))
                    {
                        <ResourceScopeTreeNode Scope="workspace" Depth="2" Selected="@(selectedScopeRef == workspace.ScopeRef)" OnSelected="Select" />
                    }
                }
            }
        </aside>

        <article class="panel scope-detail">
            @if (Selected is { } selected)
            {
                <div class="panel-header">
                    <div><p class="eyebrow">@KindLabel(selected.Kind)</p><h2>@ScopeDisplayName(selected)</h2></div>
                    <div class="scope-detail-badges"><ResourceScopeBadge ScopeRef="selected.ScopeRef" />@if (selected.IsCurrent) { <StatusBadge Text="@T("Current")" Status="UiStatus.Info" /> }</div>
                </div>
                <code class="scope-reference">@selected.ScopeRef.Value</code>
                <p class="scope-visibility">@VisibilityDescription(selected.Kind)</p>

                <div class="scope-filters">
                    <label><span>@T("Search")</span><input value="@search" @oninput="SearchChanged" placeholder="@T("SearchPlaceholder")" /></label>
                    <label><span>@T("Kind")</span><select value="@kind" @onchange="KindChanged"><option value="">@T("AllKinds")</option>@foreach (var value in Kinds) { <option value="@value">@value</option> }</select></label>
                </div>

                @if (FilteredResources.Count == 0)
                {
                    <EmptyState Title="@T("NoResources")" Message="@T("NoResourcesMessage")" />
                }
                else
                {
                    <DataGrid TItem="ResourceScopeInventoryItemResponse" Items="FilteredResources">
                        <Header><tr><th>@T("Resource")</th><th>@T("Kind")</th><th>@T("Namespace")</th><th>@T("Updated")</th></tr></Header>
                        <Row Context="resource"><tr><td><strong>@resource.Name</strong><br /><small>@resource.Uid</small></td><td><span class="pack-kind">@resource.Kind</span></td><td><code>@resource.Namespace.Value</code></td><td><time datetime="@resource.UpdatedAt.ToString("O")">@resource.UpdatedAt.ToLocalTime().ToString("g")</time></td></tr></Row>
                    </DataGrid>
                }
            }
        </article>
    </section>
}

@code {
    private readonly CancellationTokenSource cancellation = new();
    private ResourceScopeInventoryResponse? inventory;
    private ResourceScopeRef? selectedScopeRef;
    private AgentstrationApiException? error;
    private bool loading;
    private string search = string.Empty;
    private string kind = string.Empty;
    private ResourceScopeInventoryNodeResponse? Selected => inventory?.Scopes.SingleOrDefault(scope => scope.ScopeRef == selectedScopeRef);
    private IReadOnlyList<string> Kinds => Selected?.Resources.Select(resource => resource.Kind).Distinct(StringComparer.Ordinal).Order(StringComparer.CurrentCultureIgnoreCase).ToArray() ?? [];
    private IReadOnlyList<ResourceScopeInventoryItemResponse> FilteredResources => Selected?.Resources.Where(resource =>
        (string.IsNullOrWhiteSpace(kind) || string.Equals(resource.Kind, kind, StringComparison.Ordinal))
        && (string.IsNullOrWhiteSpace(search)
            || resource.Name.Contains(search, StringComparison.CurrentCultureIgnoreCase)
            || resource.Kind.Contains(search, StringComparison.CurrentCultureIgnoreCase)
            || resource.Namespace.Value.Contains(search, StringComparison.CurrentCultureIgnoreCase))).ToArray() ?? [];

    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            inventory = await Client.GetAsync(cancellation.Token);
            selectedScopeRef = inventory.Scopes.FirstOrDefault(scope => scope.IsCurrent)?.ScopeRef
                ?? inventory.Scopes.FirstOrDefault()?.ScopeRef;
        }
        catch (AgentstrationApiException exception) { error = exception; }
        finally { loading = false; }
    }
    private IEnumerable<ResourceScopeInventoryNodeResponse> Children(ResourceScopeRef parent) => inventory is null
        ? []
        : inventory.Scopes.Where(scope => scope.ParentScopeRef == parent).OrderBy(scope => scope.DisplayName, StringComparer.CurrentCultureIgnoreCase);
    private void Select(ResourceScopeRef scopeRef) { selectedScopeRef = scopeRef; search = kind = string.Empty; }
    private void SearchChanged(ChangeEventArgs args) => search = args.Value?.ToString() ?? string.Empty;
    private void KindChanged(ChangeEventArgs args) => kind = args.Value?.ToString() ?? string.Empty;
    private string ScopeDisplayName(ResourceScopeInventoryNodeResponse scope) => scope.Kind == ResourceScopeKind.Instance ? T("InstanceName") : scope.DisplayName;
    private string KindLabel(ResourceScopeKind value) => T($"ScopeKind.{value}");
    private string VisibilityDescription(ResourceScopeKind value) => T($"Visibility.{value}");
    private string T(string key) => Localizer[key].Value;
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }

}
