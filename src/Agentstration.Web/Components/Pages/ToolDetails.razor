@page "/tools/{ResourceGroup}/{Name}"
@inject IToolsClient Client

@if (tool is null) { <LoadingState Message="Loading tool…" /> }
else { <PageTitle>@tool.Properties.DisplayName · Agentstration</PageTitle><ResourceHeader ResourceType="Tool" Domain="tool" Icon="⌁" Name="@tool.Properties.DisplayName" Description="@tool.Properties.Description" StatusText="@(tool.Properties.Discovery?.Available == true ? "Available" : "Unavailable")" Status="@(tool.Properties.Discovery?.Available == true ? UiStatus.Success : UiStatus.Warning)"><Actions><button class="button-primary" @onclick="ToggleAsync">@(tool.Properties.Enabled ? "Disable" : "Enable")</button></Actions></ResourceHeader>
<section class="panel"><div class="panel-header"><h2>Governance and source</h2></div><dl class="resource-details"><dt>Provider</dt><dd><code>@tool.Properties.Provider?.ResourceId</code></dd><dt>External name</dt><dd><code>@tool.Properties.ExternalId</code></dd><dt>Enabled</dt><dd>@tool.Properties.Enabled</dd><dt>Available</dt><dd>@tool.Properties.Discovery?.Available</dd><dt>First seen</dt><dd>@tool.Properties.Discovery?.FirstSeenAt.ToString("g")</dd><dt>Last seen</dt><dd>@tool.Properties.Discovery?.LastSeenAt.ToString("g")</dd></dl></section>
<section class="panel"><div class="panel-header"><h2>Input schema</h2></div><pre>@Pretty(tool.Properties.Schema?.Input)</pre></section> }
@code { [Parameter] public string ResourceGroup {get;set;}="default"; [Parameter] public string Name {get;set;}=""; private ToolResource? tool; private string? etag; protected override async Task OnParametersSetAsync(){var value=await Client.GetToolAsync(ResourceGroup,Name,default);tool=value.Value;etag=value.ETag;} private async Task ToggleAsync(){var value=await Client.SetEnabledAsync(ResourceGroup,Name,!tool!.Properties.Enabled,etag,default);tool=value.Value;etag=value.ETag;} private static string Pretty(JsonElement? value)=>value is null?"—":JsonSerializer.Serialize(value.Value,new JsonSerializerOptions{WriteIndented=true}); }
