@page "/tools/{Name}"
@inject IToolsClient Client

@if (tool is null) { <LoadingState Message="Loading tool…" /> }
else { <PageTitle>@tool.Definition.DisplayName · Agentstration</PageTitle><ResourceHeader ResourceType="Tool" Domain="tool" Icon="⌁" Name="@tool.Definition.DisplayName" Description="@tool.Definition.Description" StatusText="@(tool.Definition.Discovery?.Available == true ? "Available" : "Unavailable")" Status="@(tool.Definition.Discovery?.Available == true ? UiStatus.Success : UiStatus.Warning)"><Actions><button class="button-primary" @onclick="ToggleAsync">@(tool.Definition.Enabled ? "Disable" : "Enable")</button></Actions></ResourceHeader>
<section class="panel"><div class="panel-header"><h2>Governance and source</h2></div><dl class="resource-details"><dt>Provider</dt><dd><code>@tool.Definition.Provider?.ResourceId</code></dd><dt>External name</dt><dd><code>@tool.Definition.ExternalId</code></dd><dt>Enabled</dt><dd>@tool.Definition.Enabled</dd><dt>Requires approval</dt><dd>@tool.Definition.RequiresApproval</dd><dt>Available</dt><dd>@tool.Definition.Discovery?.Available</dd><dt>First seen</dt><dd>@tool.Definition.Discovery?.FirstSeenAt.ToString("g")</dd><dt>Last seen</dt><dd>@tool.Definition.Discovery?.LastSeenAt.ToString("g")</dd></dl></section>
<section class="panel"><div class="panel-header"><h2>Input schema</h2></div><pre>@Pretty(tool.Definition.Schema?.Input)</pre></section> }
@code { [Parameter] public string Name {get;set;}=""; private ToolResource? tool; private string? etag; protected override async Task OnParametersSetAsync(){var value=await Client.GetToolAsync(Name,default);tool=value.Value;etag=value.ETag;} private async Task ToggleAsync(){var value=await Client.SetEnabledAsync(Name,!tool!.Definition.Enabled,etag,default);tool=value.Value;etag=value.ETag;} private static string Pretty(JsonElement? value)=>value is null?"—":JsonSerializer.Serialize(value.Value,new JsonSerializerOptions{WriteIndented=true}); }
