@page "/tools/providers"
@inject IToolsClient Client

<PageTitle>Tool providers · Agentstration</PageTitle>
<PageHeader Title="Tool providers" Description="Configure AEP extensions and generic MCP servers that expose tools."><Actions><a class="button-secondary" href="/tools">Catalog</a><a class="button-primary" href="/tools/providers/new">Add provider</a></Actions></PageHeader>
<ResourceTabs Label="Tool sections"><a href="/tools">Catalog</a><a class="active" href="/tools/providers">Providers</a></ResourceTabs>
@if (loading) { <LoadingState Message="Loading Tool Providers…" /> }
else if (providers.Count == 0) { <EmptyState Title="No Tool Providers" Message="Add an MCP or AEP provider to discover tools." /> }
else { <DataGrid TItem="ToolProviderResource" Items="providers"><Header><tr><th>Name</th><th>Type</th><th>Status</th><th>Tools</th><th>Enabled</th><th></th></tr></Header><Row Context="provider"><tr><td><strong>@provider.Definition.DisplayName</strong><br/><code>@provider.Name</code></td><td>@provider.Definition.ProviderType</td><td><StatusBadge Text="@provider.Definition.Discovery.Status" Status="@Tone(provider.Definition.Discovery.Status)" /></td><td>@provider.Definition.Discovery.ToolCount</td><td>@(provider.Definition.Enabled ? "Yes" : "No")</td><td><a class="text-button" href="@($"/tools/providers/{Uri.EscapeDataString(provider.Name)}")">Manage →</a></td></tr></Row></DataGrid> }
@code { private IReadOnlyList<ToolProviderResource> providers = []; private bool loading = true; protected override async Task OnInitializedAsync() { providers = await Client.GetProvidersAsync(default); loading = false; } private static UiStatus Tone(string status) => status == "connected" ? UiStatus.Success : status == "error" ? UiStatus.Danger : UiStatus.Neutral; }
