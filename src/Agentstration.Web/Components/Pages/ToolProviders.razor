@page "/tools/providers"
@inject IToolsClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<ToolProvidersStrings> Localizer

<PageTitle>@T("Title") · Agentstration</PageTitle>
<PageHeader Title="@T("Title")" Description="@T("Description")"><Actions><a class="button-secondary" href="/tools">@T("Catalog")</a><a class="button-primary" href="/tools/providers/new">@T("AddProvider")</a></Actions></PageHeader>
<ResourceTabs Label="@T("SectionsLabel")"><a href="/tools">@T("Catalog")</a><a class="active" href="/tools/providers">@T("Providers")</a></ResourceTabs>
@if (loading) { <LoadingState Message="@T("Loading")" /> }
else if (providers.Count == 0) { <EmptyState Title="@T("EmptyTitle")" Message="@T("EmptyMessage")" /> }
else { <DataGrid TItem="ToolProviderResource" Items="providers"><Header><tr><th>@T("Name")</th><th>@T("Type")</th><th>@T("Status")</th><th>@T("Tools")</th><th>@T("Enabled")</th><th></th></tr></Header><Row Context="provider"><tr><td><strong>@provider.Definition.DisplayName</strong><br/><code>@provider.Name</code></td><td>@provider.Definition.ProviderType</td><td><StatusBadge Text="@StatusLabel(provider.Definition.Discovery.Status)" Status="@Tone(provider.Definition.Discovery.Status)" /></td><td>@provider.Definition.Discovery.ToolCount</td><td>@BooleanLabel(provider.Definition.Enabled)</td><td><a class="text-button" href="@($"/tools/providers/{Uri.EscapeDataString(provider.Name)}")">@T("Manage")</a></td></tr></Row></DataGrid> }
@code { private IReadOnlyList<ToolProviderResource> providers = []; private bool loading = true; private string T(string key, params object[] arguments) => Localizer[key, arguments]; private string BooleanLabel(bool value) => T(value ? "Yes" : "No"); private string StatusLabel(string status) { var value = Localizer[$"Status.{status}"]; return value.ResourceNotFound ? status : value.Value; } protected override async Task OnInitializedAsync() { providers = await Client.GetProvidersAsync(default); loading = false; } private static UiStatus Tone(string status) => status == "connected" ? UiStatus.Success : status == "error" ? UiStatus.Danger : UiStatus.Neutral; }
