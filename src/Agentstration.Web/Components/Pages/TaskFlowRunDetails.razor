@page "/tasks/{TaskId:guid}/flowruns/{RunId}"
@implements IDisposable
@inject IWorkApiClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<TaskFlowRunDetailsStrings> Localizer

<PageTitle>@(run is null ? T("Title") : run.Id) · Agentstration</PageTitle>
@if (unavailable)
{
    <WorkApiUnavailableState OnRetry="LoadAsync" />
}
else if (notFound)
{
    <ErrorState Title="@T("NotFoundTitle")" Message="@T("NotFoundMessage")" />
}
else if (run is null)
{
    <LoadingState />
}
else
{
    <PageHeader Title="@T("Title")" Description="@run.Id">
        <Actions><button class="button-secondary" @onclick="LoadAsync">@T("Refresh")</button><a class="button-secondary" href="/tasks/@TaskId">@T("BackToTask")</a></Actions>
    </PageHeader>
    <section class="run-summary">
        <div><span class="field-label">@T("Status")</span><StatusBadge Text="@Label("Status", run.Status)" Status="@PlatformDashboardService.ToStatus(run.Status.ToString())" /></div>
        <div><span class="field-label">@T("FlowVersion")</span><strong>@run.FlowId.Value · @run.FlowVersion</strong></div>
        <div><span class="field-label">@T("DefinitionState")</span><strong>@Label("DefinitionState", run.DefinitionState)</strong></div>
        <div><span class="field-label">@T("TriggerStartedBy")</span><strong>@Label("Trigger", run.Trigger) · @(run.StartedBy ?? "—")</strong></div>
        <div><span class="field-label">@T("CorrelationId")</span><code>@run.CorrelationId</code></div>
        <div><span class="field-label">@T("Duration")</span><strong>@Duration(run.StartedAt, run.CompletedAt)</strong></div>
    </section>
    @if (run.Error is not null)
    {
        <article class="panel run-error"><strong>@run.Error.Code</strong><p>@run.Error.Message</p><code>@run.Error.Details</code></article>
    }
    <section class="designer-layout run-layout @(inspectorVisible ? null : "inspector-collapsed")">
        <div>
            <FlowTopologyViewer Graph="Topology" SelectedKey="selected?.StepName" SelectedKeyChanged="SelectStep"
                                ShowInspectorControl="true" InspectorVisible="inspectorVisible" InspectorVisibleChanged="SetInspectorVisible" />
            <article class="panel io-panel"><div class="panel-header"><h2>@T("RunInputOutput")</h2></div><div class="io-grid"><div><span class="field-label">@T("Input")</span><pre>@Pretty(run.Input)</pre></div><div><span class="field-label">@T("Output")</span><pre>@Pretty(run.Output)</pre></div></div></article>
        </div>
        @if (inspectorVisible)
        {
        <article class="panel inspector step-inspector">
            <div class="panel-header"><h2>@T("StepDiagnostic")</h2></div>
            @if (selected is null) { <p class="muted">@T("SelectStep")</p> }
            else
            {
                <dl class="details-list"><dt>@T("Status")</dt><dd>@Label("Status", selected.Status)</dd><dt>@T("Type")</dt><dd>@selected.StepType</dd><dt>@T("Duration")</dt><dd>@Duration(selected.StartedAt, selected.CompletedAt)</dd><dt>@T("Attempt")</dt><dd>@selected.Attempt</dd><dt>@T("Transition")</dt><dd>@(selected.SelectedTransition ?? "—")</dd><dt>@T("Agent")</dt><dd>@(selected.AgentResourceId ?? "—")</dd><dt>@T("Provider")</dt><dd>@(selected.Provider ?? "—")</dd><dt>@T("Tokens")</dt><dd>@(selected.Usage is null ? "—" : $"{selected.Usage.InputTokens ?? 0} {T("In")} / {selected.Usage.OutputTokens ?? 0} {T("Out")}")</dd></dl>
                <span class="field-label">@T("DeclaredInput")</span><pre>@Pretty(selected.DeclaredInput)</pre><span class="field-label">@T("ResolvedInput")</span><pre>@Pretty(selected.ResolvedInput)</pre><span class="field-label">@T("Output")</span><pre>@Pretty(selected.Output)</pre><span class="field-label">@T("Logs")</span><pre>@string.Join(Environment.NewLine, selected.Logs)</pre>
            }
        </article>
        }
    </section>
}

@code {
    [Parameter] public Guid TaskId { get; set; }
    [Parameter] public string RunId { get; set; } = string.Empty;
    private readonly CancellationTokenSource lifetime = new();
    private FlowRun? run;
    private FlowStepRun? selected;
    private bool unavailable, notFound;
    private bool inspectorVisible = true;
    private FlowTopologyGraph Topology => run is null ? new([], [], "horizontal", T("FlowTopology")) : FlowTopologyProjector.Project(run);
    protected override async Task OnParametersSetAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        unavailable = false; notFound = false;
        try { run = await Client.GetTaskFlowRunAsync(TaskId, RunId, lifetime.Token); selected = run.Steps.FirstOrDefault(value => value.StepName == selected?.StepName) ?? run.Steps.FirstOrDefault(); }
        catch (AgentstrationApiException exception) when (exception.StatusCode == System.Net.HttpStatusCode.NotFound) { notFound = true; run = null; }
        catch (Exception exception) when (exception is AgentstrationApiException or HttpRequestException or Polly.Timeout.TimeoutRejectedException) { unavailable = true; run = null; }
    }
    private void SelectStep(string name) => selected = run?.Steps.FirstOrDefault(value => value.StepName == name);
    private void SetInspectorVisible(bool value) => inspectorVisible = value;
    private string T(string key) => Localizer[key];
    private string Label(string prefix, object value) { var raw = value.ToString() ?? string.Empty; var localized = Localizer[$"{prefix}.{raw}"]; return localized.ResourceNotFound ? raw : localized.Value; }
    private static string Pretty(JsonElement value) => JsonSerializer.Serialize(value, new JsonSerializerOptions { WriteIndented = true });
    private static string Pretty(JsonElement? value) => value is null ? "—" : Pretty(value.Value);
    private static string Duration(DateTimeOffset? start, DateTimeOffset? end) { if (start is null) return "—"; var value = (end ?? DateTimeOffset.UtcNow) - start.Value; return value.TotalSeconds >= 1 ? $"{value.TotalSeconds:0.##} s" : $"{value.TotalMilliseconds:0} ms"; }
    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); }
}
