@page "/extensions"
@implements IDisposable
@inject IExtensionsClient Client
@inject IModelProfilesClient ProfilesClient
@inject NotificationState Notifications
@inject IServiceProvider Services
@inject IJSRuntime JavaScript
@inject Microsoft.Extensions.Localization.IStringLocalizer<ExtensionStrings> Localizer

<PageTitle>@T("Extensions") · Agentstration</PageTitle>
<PageHeader Title="@T("Extensions")" Description="@T("Extensions.Description")">
    <Actions>
        @if (activeTab == ExtensionTab.Catalog)
        {
            <button class="button-primary" @onclick="StartCreate" disabled="@loading">@T("RegisterEndpoint")</button>
        }
    </Actions>
</PageHeader>

<ResourceTabs Label="@T("ExtensionTabs")">
    <button id="extensions-tab-summary" type="button" role="tab" aria-selected="@(activeTab == ExtensionTab.Summary ? "true" : "false")" aria-controls="extensions-panel-summary" class="@(activeTab == ExtensionTab.Summary ? "active" : null)" data-testid="extensions-tab-summary" @onclick="() => activeTab = ExtensionTab.Summary">@T("Tab.Summary")</button>
    <button id="extensions-tab-catalog" type="button" role="tab" aria-selected="@(activeTab == ExtensionTab.Catalog ? "true" : "false")" aria-controls="extensions-panel-catalog" class="@(activeTab == ExtensionTab.Catalog ? "active" : null)" data-testid="extensions-tab-catalog" @onclick="() => activeTab = ExtensionTab.Catalog">@T("Tab.Extensions")</button>
    @if (CanAdministerEnrollments)
    {
        <button id="extensions-tab-enrollments" type="button" role="tab" aria-selected="@(activeTab == ExtensionTab.Enrollments ? "true" : "false")" aria-controls="extensions-panel-enrollments" class="@(activeTab == ExtensionTab.Enrollments ? "active" : null)" data-testid="extensions-tab-enrollments" @onclick="() => activeTab = ExtensionTab.Enrollments">@T("Tab.Enrollments")</button>
    }
</ResourceTabs>

@if (error is not null)
{
    <ErrorState Message="@error.Message" ErrorId="@error.ErrorId"><button class="button-secondary" @onclick="LoadAsync">@T("Retry")</button></ErrorState>
}

@if (activeTab == ExtensionTab.Summary)
{
    <div id="extensions-panel-summary" role="tabpanel" aria-labelledby="extensions-tab-summary">
        <section class="metric-grid" aria-label="@T("SummaryMetrics")">
            <MetricCard Label="@T("Tab.Extensions")" Value="@(inventory?.Count.ToString() ?? "—")" Detail="@T("AvailableExtensions", AvailableExtensionCount)" Status="@(AvailableExtensionCount > 0 ? UiStatus.Success : UiStatus.Neutral)" Url="/extensions?tab=catalog" />
            @if (CanAdministerEnrollments)
            {
                <MetricCard Label="@T("Tab.Enrollments")" Value="@(enrollments?.Count.ToString() ?? "—")" Detail="@T("ActiveEnrollments", ActiveEnrollmentCount)" Status="@(ActiveEnrollmentCount > 0 ? UiStatus.Warning : UiStatus.Success)" Url="/extensions?tab=enrollments" />
            }
            <MetricCard Label="@T("Connections")" Value="@(registrations?.Count.ToString() ?? "—")" Detail="@T("EnabledEndpoints", EnabledRegistrationCount)" Status="@(EnabledRegistrationCount > 0 ? UiStatus.Info : UiStatus.Neutral)" Url="/extensions?tab=catalog" />
            @if (CanAdministerEnrollments)
            {
                <MetricCard Label="@T("EnrollmentModes")" Value="@(enrollmentSettings is null ? "—" : $"{EnabledEnrollmentModeCount}/2")" Detail="@T("EnabledEnrollmentModes", EnabledEnrollmentModeCount)" Status="@(EnabledEnrollmentModeCount > 0 ? UiStatus.Info : UiStatus.Warning)" Url="/extensions?tab=enrollments" />
            }
        </section>
        <section class="panel resource-section">
            <div class="panel-header"><div><p class="eyebrow">@T("Summary")</p><h2>@T("OperationalOverview")</h2><p>@T("OperationalOverview.Description")</p></div></div>
            <dl class="resource-details">
                <dt>@T("ExtensionCatalog")</dt><dd><StatusBadge Text="@T("AvailableExtensions", AvailableExtensionCount)" Status="@(AvailableExtensionCount > 0 ? UiStatus.Success : UiStatus.Neutral)" /></dd>
                @if (CanAdministerEnrollments)
                {
                    <dt>@T("EnrollmentQueue")</dt><dd><StatusBadge Text="@T("ActiveEnrollments", ActiveEnrollmentCount)" Status="@(ActiveEnrollmentCount > 0 ? UiStatus.Warning : UiStatus.Success)" /></dd>
                    <dt>@T("PairingCodeMode")</dt><dd>@T(pairingCodeEnabled ? "Enabled" : "Disabled")</dd>
                    <dt>@T("SharedKeyFileMode")</dt><dd>@T(sharedKeyFileEnabled ? "Enabled" : "Disabled")</dd>
                }
                <dt>@T("Connections")</dt><dd>@T("EnabledEndpoints", EnabledRegistrationCount)</dd>
            </dl>
        </section>
    </div>
}

@if (activeTab == ExtensionTab.Enrollments && CanAdministerEnrollments)
{
    <div id="extensions-panel-enrollments" role="tabpanel" aria-labelledby="extensions-tab-enrollments">
    <section class="panel resource-section">
        <div class="panel-header">
            <div><p class="eyebrow">@T("EnrollmentPolicy")</p><h2>@T("EnrollmentModes")</h2><p>@T("EnrollmentModes.Description")</p></div>
        </div>
        @if (enrollmentSettings is not null)
        {
            <div class="form-grid">
                <label class="checkbox-field">
                    <input type="checkbox" @bind="pairingCodeEnabled" disabled="@(!enrollmentSettings.PairingCodeConfigurable || savingEnrollmentSettings)" />
                    @T("PairingCodeMode")
                    <small>@(enrollmentSettings.PairingCodeConfigurable ? T("PairingCodeMode.Help") : T("ModeDisabledByConfiguration"))</small>
                </label>
                <label class="checkbox-field">
                    <input type="checkbox" @bind="sharedKeyFileEnabled" disabled="@(!enrollmentSettings.SharedKeyFileConfigurable || savingEnrollmentSettings)" />
                    @T("SharedKeyFileMode")
                    <small>@(enrollmentSettings.SharedKeyFileConfigurable ? T("SharedKeyFileMode.Help") : T("ModeDisabledByConfiguration"))</small>
                </label>
            </div>
            <div class="panel-actions">
                <button class="button-primary" @onclick="SaveEnrollmentSettingsAsync" disabled="@savingEnrollmentSettings">@(savingEnrollmentSettings ? T("Saving") : T("SaveEnrollmentModes"))</button>
            </div>
        }
    </section>

    <section class="panel resource-section">
        <div class="panel-header">
            <div><p class="eyebrow">@T("EnrollmentInbox")</p><h2>@T("PendingEnrollments")</h2><p>@T("PendingEnrollments.Description")</p></div>
            <span>@T("EnrollmentCount", enrollments?.Count ?? 0)</span>
        </div>
        @if (enrollments?.Count > 0)
        {
            <div class="enrollment-list">
                @foreach (var enrollment in enrollments)
                {
                    var requiresScope = enrollment.Definition.TargetScopeRef is null;
                    <article class="enrollment-card" data-testid="enrollment-card">
                        <div class="enrollment-card-summary">
                            <div class="enrollment-identity">
                                <div><a class="text-button" href="@EnrollmentDetailUrl(enrollment)">@enrollment.Definition.ExtensionName</a> <span class="enrollment-version">@enrollment.Definition.ExtensionVersion</span></div>
                                <code>@enrollment.Definition.ExtensionId</code>
                                <small>@T("AnnouncedAgo", EnrollmentAge(enrollment))</small>
                            </div>
                            <div class="enrollment-status"><StatusBadge Text="@EnrollmentStatusLabel(enrollment.Definition.State)" Status="@EnrollmentStatus(enrollment.Definition.State)" />
                                @if (enrollment.Definition.TargetScopeRef is { } enrollmentScope)
                                { <ResourceScopeBadge ScopeRef="enrollmentScope" Compact /> }
                                @if (enrollment.Definition.CodeExpiresAt is { } expires && enrollment.Definition.State == AepEnrollmentState.CodeIssued)
                                { <small>@T("CodeExpiresIn", SecondsRemaining(expires))</small> }
                            </div>
                        </div>
                        <div class="enrollment-endpoint">
                            <span class="enrollment-label">@T("Endpoint")</span>
                            <a href="@enrollment.Definition.Endpoint.AbsoluteUri" target="_blank" rel="noopener noreferrer">@enrollment.Definition.Endpoint</a>
                            @if (enrollment.Definition.PairingUri is { } pairingUri)
                            { <small>@T("PairingOriginLabel") <a href="@pairingUri.AbsoluteUri" target="_blank" rel="noopener noreferrer">@pairingUri.GetLeftPart(UriPartial.Authority)</a></small> }
                        </div>
                        <div class="enrollment-action-layout">
                            @if (requiresScope)
                            {
                                <div class="enrollment-scope"><ResourceScopeFormField ResourceKind="@ResourceKinds.ExtensionRegistration" Value="@EnrollmentScope(enrollment)" ValueChanged="scope => SetEnrollmentScope(enrollment, scope)" /></div>
                            }
                            @if (enrollment.Definition.EnrollmentMode == AepEnrollmentMode.PairingCode && CanRotate(enrollment.Definition.State))
                            {
                                <div class="enrollment-actions"><button class="button-primary" @onclick="() => CopyAndOpenAsync(enrollment)" disabled="@pairingBusy">@T("EnrollExtension")</button><button class="button-secondary" @onclick="() => RejectAsync(enrollment)" disabled="@pairingBusy">@T("Reject")</button><button class="button-secondary" @onclick="() => CancelEnrollmentAsync(enrollment)" disabled="@pairingBusy">@T("Cancel")</button></div>
                            }
                            else if (enrollment.Definition.EnrollmentMode == AepEnrollmentMode.SharedKeyFile && requiresScope)
                            {
                                <div class="enrollment-actions"><button class="button-primary" @onclick="() => AssignSharedKeyAsync(enrollment)" disabled="@pairingBusy">@T("EnrollExtension")</button><button class="button-secondary" @onclick="() => RejectAsync(enrollment)" disabled="@pairingBusy">@T("Reject")</button></div>
                            }
                            else if (enrollment.Definition.EnrollmentMode == AepEnrollmentMode.PairingCode && enrollment.Definition.State == AepEnrollmentState.Available)
                            {
                                <div class="enrollment-actions enrollment-management-actions"><button class="button-secondary" @onclick="() => RotateCredentialAsync(enrollment)" disabled="@pairingBusy">@T("RotateCredential")</button><button class="button-danger" @onclick="() => RevokeCredentialAsync(enrollment)" disabled="@pairingBusy">@T("RevokeCredential")</button></div>
                            }
                        </div>
                    </article>
                }
            </div>
        }
        else if (!loading)
        {
            <p>@T("NoPendingEnrollments")</p>
        }
        @if (activePairingCode is not null)
        {
            <div class="inline-warning" role="status">
                <strong>@T("PairingCode")</strong> <code>@activePairingCode</code>
                @if (activePairingExpiry is { } expiry) { <span> · @T("CodeExpiresIn", SecondsRemaining(expiry))</span> }
                @if (clipboardFallback)
                {
                    <p>@T("ClipboardFallback")</p>
                    <button class="button-secondary" @onclick="CopyCodeAsync">@T("Copy")</button>
                    <button class="button-secondary" @onclick="OpenExtension">@T("OpenExtension")</button>
                }
            </div>
        }
    </section>
    </div>
}

@if (activeTab == ExtensionTab.Catalog && editing)
{
<section class="panel resource-section">
    <div class="panel-header">
        <div><p class="eyebrow">@T("Connection")</p><h2>@T("RegisterEndpoint")</h2><p>@T("RegisteredEndpoints.Description")</p></div>
    </div>
    <EditForm Model="form" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="form-grid">
            <label>@T("Name")<InputText @bind-Value="form.Name" /></label>
            <label>@T("Namespace")<InputText @bind-Value="form.Namespace" /></label>
            <label>@T("DisplayName")<InputText @bind-Value="form.DisplayName" /></label>
            <ResourceScopeFormField ResourceKind="@ResourceKinds.ExtensionRegistration" RequiredKind="@ResourceScopeKind.Tenant" @bind-Value="selectedScope" />
            <label>@T("AepEndpoint")<InputText @bind-Value="form.Endpoint" placeholder="https://extension.example/aep/" /></label>
            <label>@T("ExpectedExtensionId")<InputText @bind-Value="form.ExpectedExtensionId" /><small>@T("ExpectedExtensionId.Help")</small></label>
            <label>@T("AuthenticationMode")<InputSelect @bind-Value="form.AuthenticationMode"><option value="@AepTransportAuthenticationMode.None">@T("Authentication.None")</option><option value="@AepTransportAuthenticationMode.StaticBearer">@T("Authentication.StaticBearer")</option></InputSelect></label>
            @if (form.AuthenticationMode == AepTransportAuthenticationMode.StaticBearer)
            {
                <label>@T("CredentialName")<InputText @bind-Value="form.CredentialName" /></label>
                <label>@T("CredentialNamespace")<InputText @bind-Value="form.CredentialNamespace" /></label>
                <label>@T("CredentialScopeRef")<InputText @bind-Value="form.CredentialScopeRef" /><small>@T("CredentialScopeRef.Help")</small></label>
            }
            <label class="checkbox-field"><InputCheckbox @bind-Value="form.Enabled" /> @T("EnabledForDiscovery")</label>
        </div>
        <div class="panel-actions">
            <button class="button-primary" type="submit" disabled="@saving">@T("CreateRegistration")</button>
            <button class="button-secondary" type="button" @onclick="CancelEdit" disabled="@saving">@T("Cancel")</button>
        </div>
    </EditForm>
</section>
}

@if (activeTab == ExtensionTab.Catalog)
{
<div id="extensions-panel-catalog" role="tabpanel" aria-labelledby="extensions-tab-catalog">
    <section class="panel resource-section">
        <div class="panel-header">
            <div><p class="eyebrow">@T("ExtensionInventory")</p><h2>@T("Tab.Extensions")</h2><p>@T("ExtensionInventory.Description")</p></div>
            <span>@T("ExtensionCount", FilteredInventory.Count)</span>
        </div>
        <ResourceToolbar Label="@T("InventoryFilters")">
            <SearchBox @bind-Value="search" Placeholder="@T("SearchExtensions")" />
            <select aria-label="@T("Availability")" @bind="availabilityFilter"><option value="">@T("AllAvailability")</option>@foreach (var status in AvailabilityFilters) { <option value="@status">@StatusLabel(status)</option> }</select>
            <select aria-label="@T("Enrollment")" @bind="enrollmentFilter"><option value="">@T("AllEnrollments")</option>@foreach (var status in EnrollmentFilters) { <option value="@status">@EnrollmentStatusLabel(status)</option> }</select>
            <select aria-label="@T("Origin")" @bind="sourceFilter"><option value="">@T("AllOrigins")</option>@foreach (var source in SourceFilters) { <option value="@source">@SourceLabel(source)</option> }</select>
        </ResourceToolbar>
    @if (loading && inventory is null)
    {
        <LoadingState Message="@T("DiscoveringExtensions")" />
    }
    else if (FilteredInventory.Count == 0)
    {
        <EmptyState Title="@T("NoExtensionsDiscovered")" Message="@T("NoExtensionsDiscoveredMessage")" />
    }
    else
    {
        <DataGrid TItem="ExtensionInventoryItemResponse" Items="FilteredInventory">
            <Header><tr><th>@T("Extension")</th><th>@T("Connection")</th><th>@T("Enrollment")</th><th>@T("Availability")</th><th>@T("Contributions")</th></tr></Header>
            <Row Context="item"><tr>
                <td><a class="text-button" href="@DetailUrl(item)">@item.DisplayName</a> <small>@(item.Version ?? "—")</small><br /><code>@item.ExtensionId</code></td>
                <td><a href="@item.Endpoint.AbsoluteUri" target="_blank" rel="noopener noreferrer">@item.Endpoint</a><br /><small>@SourceLabel(item.RegistrationSource) · @T("ConnectionCount", item.Connections.Count)@if (item.RegistrationName is not null) { <text> · @item.RegistrationNamespace/@item.RegistrationName</text> }</small></td>
                <td><div class="enrollment-cell">@if (item.EnrollmentStatus is { } enrollmentState) { <StatusBadge Text="@EnrollmentStatusLabel(enrollmentState)" Status="@EnrollmentStatus(enrollmentState)" /> @if (CanAdministerEnrollments && CanRotate(enrollmentState) && IsPairingCode(item)) { <button class="text-button" @onclick="() => EnrollAsync(item)" disabled="@pairingBusy">@T("Enroll")</button> } } else { <span>—</span> }</div></td>
                <td><StatusBadge Text="@StatusLabel(item.AvailabilityStatus)" Status="@ModelManagementUi.Status(item.AvailabilityStatus)" /></td>
                <td>@ContributionSummary(item)</td>
            </tr></Row>
        </DataGrid>
    }
    </section>
    @if (activePairingCode is not null)
    {
        <div class="inline-warning" role="status"><strong>@T("PairingCode")</strong> <code>@activePairingCode</code>@if (activePairingExpiry is { } expiry) { <span> · @T("CodeExpiresIn", SecondsRemaining(expiry))</span> }@if (clipboardFallback) { <p>@T("ClipboardFallback")</p><button class="button-secondary" @onclick="CopyCodeAsync">@T("Copy")</button><button class="button-secondary" @onclick="OpenExtension">@T("OpenExtension")</button> }</div>
    }
</div>
}
