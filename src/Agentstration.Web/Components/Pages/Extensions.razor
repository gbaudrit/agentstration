@page "/extensions"
@implements IDisposable
@inject IExtensionsClient Client
@inject IModelProfilesClient ProfilesClient
@inject NotificationState Notifications
@inject ConsoleContextState ContextState
@inject IJSRuntime JavaScript
@inject Microsoft.Extensions.Localization.IStringLocalizer<ExtensionStrings> Localizer

<PageTitle>@T("Extensions") · Agentstration</PageTitle>
<PageHeader Title="@T("Extensions")" Description="@T("Extensions.Description")">
    <Actions>
        <button class="button-secondary" @onclick="DiscoverAsync" disabled="@(loading || discovering)">@(discovering ? T("Discovering") : T("DiscoverExtensions"))</button>
        <button class="button-primary" @onclick="StartCreate" disabled="@loading">@T("RegisterEndpoint")</button>
    </Actions>
</PageHeader>

@if (!string.IsNullOrWhiteSpace(discoveryMessage))
{
    <p class="inline-info">@discoveryMessage</p>
}

@if (CanAdministerEnrollments)
{
    <section class="panel resource-section">
        <div class="panel-header">
            <div><p class="eyebrow">@T("EnrollmentInbox")</p><h2>@T("PendingEnrollments")</h2><p>@T("PendingEnrollments.Description")</p></div>
            <span>@T("EnrollmentCount", enrollments?.Count ?? 0)</span>
        </div>
        @if (enrollments?.Count > 0)
        {
            <DataGrid TItem="AepEnrollmentRequestResource" Items="enrollments">
                <Header><tr><th>@T("Extension")</th><th>@T("Endpoint")</th><th>@T("Status")</th><th>@T("Actions")</th></tr></Header>
                <Row Context="enrollment"><tr>
                    <td><strong>@enrollment.Definition.ExtensionName</strong> @enrollment.Definition.ExtensionVersion<br /><code>@enrollment.Definition.ExtensionId</code><br /><small>@T("AnnouncedAgo", EnrollmentAge(enrollment))</small></td>
                    <td><code>@enrollment.Definition.Endpoint</code><br /><small>@T("PairingOrigin", enrollment.Definition.PairingUri.GetLeftPart(UriPartial.Authority))</small></td>
                    <td><StatusBadge Text="@enrollment.Definition.State.ToString()" Status="@EnrollmentStatus(enrollment.Definition.State)" />
                        @if (enrollment.Definition.CodeExpiresAt is { } expires && enrollment.Definition.State == AepEnrollmentState.CodeIssued)
                        { <br /><small>@T("CodeExpiresIn", SecondsRemaining(expires))</small> }
                    </td>
                    <td>
                        @if (CanRotate(enrollment.Definition.State))
                        {
                            <button class="button-primary" @onclick="() => CopyAndOpenAsync(enrollment)" disabled="@pairingBusy">@T("CopyCodeAndOpen")</button>
                            <button class="button-secondary" @onclick="() => RejectAsync(enrollment)" disabled="@pairingBusy">@T("Reject")</button>
                            <button class="button-secondary" @onclick="() => CancelEnrollmentAsync(enrollment)" disabled="@pairingBusy">@T("Cancel")</button>
                        }
                    </td>
                </tr></Row>
            </DataGrid>
        }
        else if (!loading)
        {
            <p>@T("NoPendingEnrollments")</p>
        }
        @if (activePairingCode is not null)
        {
            <div class="inline-warning" role="status">
                <strong>@T("PairingCode")</strong> <code>@activePairingCode</code>
                @if (activePairingExpiry is { } expiry) { <span> · @T("CodeExpiresIn", SecondsRemaining(expiry))</span> }
                @if (clipboardFallback)
                {
                    <p>@T("ClipboardFallback")</p>
                    <button class="button-secondary" @onclick="CopyCodeAsync">@T("Copy")</button>
                    <button class="button-secondary" @onclick="OpenExtension">@T("OpenExtension")</button>
                }
            </div>
        }
    </section>
}

<section class="panel resource-section">
    <div class="panel-header">
        <div><p class="eyebrow">@T("DiscoverySources")</p><h2>@T("RegisteredEndpoints")</h2><p>@T("RegisteredEndpoints.Description")</p></div>
        <span>@T("RegistrationCount", registrations?.Count ?? 0)</span>
    </div>

    @if (editing)
    {
        <EditForm Model="form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="form-grid">
                <label>@T("Name")<InputText @bind-Value="form.Name" disabled="@(!creating)" /></label>
                <label>@T("Namespace")<InputText @bind-Value="form.Namespace" disabled="@(!creating)" /></label>
                <label>@T("DisplayName")<InputText @bind-Value="form.DisplayName" /></label>
                <ResourceScopeFormField ResourceKind="@ResourceKinds.ExtensionRegistration" RequiredKind="@ResourceScopeKind.Tenant" @bind-Value="selectedScope" Disabled="@(!creating)" />
                <label>@T("AepEndpoint")<InputText @bind-Value="form.Endpoint" placeholder="https://extension.example/aep/" /></label>
                <label>@T("ExpectedExtensionId")<InputText @bind-Value="form.ExpectedExtensionId" /><small>@T("ExpectedExtensionId.Help")</small></label>
                <label>@T("AuthenticationMode")<InputSelect @bind-Value="form.AuthenticationMode"><option value="@AepTransportAuthenticationMode.None">@T("Authentication.None")</option><option value="@AepTransportAuthenticationMode.StaticBearer">@T("Authentication.StaticBearer")</option></InputSelect></label>
                @if (form.AuthenticationMode == AepTransportAuthenticationMode.StaticBearer)
                {
                    <label>@T("CredentialName")<InputText @bind-Value="form.CredentialName" /></label>
                    <label>@T("CredentialNamespace")<InputText @bind-Value="form.CredentialNamespace" /></label>
                    <label>@T("CredentialScopeRef")<InputText @bind-Value="form.CredentialScopeRef" /><small>@T("CredentialScopeRef.Help")</small></label>
                }
                <label class="checkbox-field"><InputCheckbox @bind-Value="form.Enabled" /> @T("EnabledForDiscovery")</label>
            </div>
            <div class="panel-actions">
                <button class="button-primary" type="submit" disabled="@saving">@(creating ? T("CreateRegistration") : T("SaveChanges"))</button>
                <button class="button-secondary" type="button" @onclick="CancelEdit" disabled="@saving">@T("Cancel")</button>
            </div>
        </EditForm>
    }
    else if (registrations?.Count > 0)
    {
        <DataGrid TItem="ExtensionRegistrationResource" Items="registrations">
            <Header><tr><th>@T("Registration")</th><th>@T("Endpoint")</th><th>@T("Discovery")</th><th>@T("Actions")</th></tr></Header>
            <Row Context="registration"><tr>
                <td><span class="resource-name-with-scope"><strong>@registration.Definition.DisplayName</strong><ResourceScopeBadge ScopeRef="@registration.ScopeRef" Compact /></span><code>@registration.Namespace/@registration.Name</code></td>
                <td><code>@registration.Definition.Endpoint</code></td>
                <td><StatusBadge Text="@(registration.Definition.Enabled ? T("Enabled") : T("Disabled"))" Status="@ModelManagementUi.Status(registration.Definition.Enabled ? "available" : "disabled")" /></td>
                <td>
                    @if (registration.Definition.Source == ExtensionRegistrationSource.Manual)
                    {
                        <button class="button-secondary" @onclick="() => EditAsync(registration)">@T("Edit")</button>
                        <button class="button-secondary" @onclick="() => ToggleAsync(registration)">@(registration.Definition.Enabled ? T("Disable") : T("Enable"))</button>
                        <button class="button-danger" @onclick="() => RequestDelete(registration)">@T("Delete")</button>
                    }
                    else
                    {
                        <span>@T("ManagedBy", registration.Definition.Source)</span>
                    }
                </td>
            </tr></Row>
        </DataGrid>
    }
    else if (!loading)
    {
        <p>@T("NoRegisteredEndpoint")</p>
    }
</section>

<ConfirmationDialog IsOpen="@(pendingDelete is not null)" Title="@T("DeleteExtensionRegistration")" Message="@DeleteMessage" ConfirmLabel="@T("DeleteRegistration")" OnConfirm="DeleteAsync" OnCancel="CancelDelete" />

@if (migrationPreview is not null)
{
    <section class="panel resource-section">
        <div class="panel-header">
            <div><p class="eyebrow">@T("ExplicitMigrationPreview")</p><h2>@migrationPreview.Value.ProfileNamespace/@migrationPreview.Value.ProfileName</h2><p>@T("NoProfileChanged")</p></div>
            <span>@migrationPreview.Value.Source.Version → @migrationPreview.Value.Target.Version</span>
        </div>
        <div class="details-grid">
            <article><h3>@T("CurrentOptions")</h3><pre class="runner-json">@FormatOptions(migrationPreview.Value.Source)</pre></article>
            <article><h3>@T("ProposedOptions")</h3><pre class="runner-json">@FormatOptions(migrationPreview.Value.Target)</pre></article>
        </div>
        <div class="panel-actions">
            <button class="button-primary" @onclick="ApplyMigrationAsync" disabled="@migrating">@(migrating ? T("Applying") : T("ApplyMigration"))</button>
            <button class="button-secondary" @onclick="CancelMigration" disabled="@migrating">@T("Cancel")</button>
        </div>
    </section>
}

@if (loading && extensions is null)
{
    <LoadingState Message="@T("DiscoveringExtensions")" />
}
else if (error is not null)
{
    <ErrorState Message="@error.Message" ErrorId="@error.ErrorId"><button class="button-secondary" @onclick="LoadAsync">@T("Retry")</button></ErrorState>
}
else if (extensions?.Count == 0)
{
    <EmptyState Title="@T("NoExtensionsDiscovered")" Message="@T("NoExtensionsDiscoveredMessage")" />
}
else
{
    @foreach (var extension in extensions ?? [])
    {
        <section class="panel resource-section">
            <div class="panel-header">
                <div>
                    <p class="eyebrow">@T("AepExtension") · <code>@extension.RegistrationNamespace/@extension.RegistrationName</code> · @extension.DiscoverySource</p>
                    <h2>@(extension.Extension?.Name ?? extension.RegistrationName)</h2>
                    <p>@(extension.Extension?.Description ?? extension.Details ?? T("ExtensionIdentityUnavailable"))</p>
                </div>
                <StatusBadge Text="@StatusLabel(extension.Status)" Status="@ModelManagementUi.Status(extension.Status)" />
            </div>
            <dl class="resource-details">
                <dt>@T("ExtensionId")</dt><dd><code>@(extension.Extension?.Id ?? "—")</code></dd>
                <dt>@T("ObservedVersion")</dt><dd>@(extension.Extension?.Version ?? "—")</dd>
                <dt>@T("AepEndpoint")</dt><dd><code>@extension.Endpoint</code></dd>
                <dt>@T("Registration")</dt><dd><code>@extension.RegistrationNamespace/@extension.RegistrationName</code></dd>
                <dt>@T("ModelProviders")</dt><dd>@(extension.Providers.Count == 0 ? "—" : string.Join(", ", extension.Providers.Select(value => $"{value.Namespace}/{value.Name} → {value.ContributionId}")))</dd>
                <dt>@T("Contributions")</dt><dd>@(extension.Contributions.Count == 0 ? "—" : string.Join(", ", extension.Contributions.Select(value => $"{value.Kind}:{value.Id}")))</dd>
            </dl>

            @if (extension.Contributions.Any(value => value.Kind == "model-provider"))
            {
                <div class="panel-actions">
                    @foreach (var provider in extension.Providers)
                    {
                        <a class="button-secondary" href="@ProviderUrl(provider)">@T("OpenProvider", provider.Name)</a>
                    }
                    @foreach (var contribution in extension.Contributions.Where(value => value.Kind == "model-provider" && !extension.Providers.Any(provider => provider.ContributionId == value.Id)))
                    {
                        <a class="button-primary" href="@ConfigureProviderUrl(extension, contribution)">@T("ConfigureProvider", contribution.Id)</a>
                    }
                </div>
            }

            <div class="panel-header"><div><h3>@T("OptionContracts")</h3><p>@T("OptionContracts.Description")</p></div><span>@T("SetCount", extension.OptionSets.Count)</span></div>
            @if (extension.OptionSets.Count == 0)
            {
                <p class="inline-warning">@(extension.Status == "available" ? T("NoVersionedOptionContract") : T("ContractsUnavailable"))</p>
            }
            else
            {
                <DataGrid TItem="ExtensionOptionSetResponse" Items="extension.OptionSets">
                    <Header><tr><th>@T("OptionSet")</th><th>@T("Target")</th><th>@T("Preferred")</th><th>@T("SupportedVersions")</th></tr></Header>
                    <Row Context="optionSet"><tr>
                        <td><code>@optionSet.Id</code></td>
                        <td>@optionSet.ContributionKind · <code>@optionSet.ContributionId</code> · @optionSet.Scope</td>
                        <td>@optionSet.PreferredVersion</td>
                        <td>@foreach (var version in optionSet.Versions) { <div><strong>@version.Version</strong>@(version.Deprecated ? T("DeprecatedSuffix") : null)<br /><code>@version.SchemaDigest</code><details><summary>@T("JsonSchema")</summary><pre class="runner-json">@FormatSchema(version.Schema)</pre></details></div> }</td>
                    </tr></Row>
                </DataGrid>
            }

            <div class="panel-header"><div><h3>@T("PersistedUsage")</h3><p>@T("PersistedUsage.Description")</p></div><span>@T("ProfileCount", extension.Usages.Count)</span></div>
            @if (extension.Usages.Count > 0)
            {
                <DataGrid TItem="ExtensionOptionUsageResponse" Items="extension.Usages">
                    <Header><tr><th>@T("ModelProfile")</th><th>@T("Contract")</th><th>@T("Status")</th><th>@T("Diagnostics")</th></tr></Header>
                    <Row Context="usage"><tr>
                        <td><a href="@ProfileUrl(usage)">@usage.ProfileName</a><br /><small>@usage.ProfileNamespace</small></td>
                        <td>@if (string.IsNullOrWhiteSpace(usage.OptionSet)) { <span>@T("LegacyUnversionedOptions")</span> } else { <code>@usage.OptionSet@@@usage.Version</code><br /><small>@ShortDigest(usage.SchemaDigest)</small> }</td>
                        <td><StatusBadge Text="@StatusLabel(usage.Status)" Status="@ModelManagementUi.Status(usage.Status)" />
                            @if (MigrationTarget(extension, usage) is { } targetVersion)
                            {
                                <br /><button class="button-secondary" @onclick="() => PreviewMigrationAsync(usage, targetVersion)" disabled="@migrating">@T("MigrateTo", targetVersion)</button>
                            }
                        </td>
                        <td>@(usage.Issues.Count == 0 ? T("Compatible") : string.Join(" ", usage.Issues))</td>
                    </tr></Row>
                </DataGrid>
            }
            else
            {
                <p>@T("NoPersistedUsage")</p>
            }
        </section>
    }
}
