@page "/extensions"
@implements IDisposable
@inject IExtensionsClient Client

<PageTitle>Extensions · Agentstration</PageTitle>
<PageHeader Title="Extensions" Description="Inspect AEP extensions, their immutable option contracts, and compatibility with persisted Model Profiles.">
    <Actions><button class="button-secondary" @onclick="LoadAsync" disabled="@loading">Refresh discovery</button></Actions>
</PageHeader>

@if (loading && extensions is null)
{
    <LoadingState Message="Discovering extensions…" />
}
else if (error is not null)
{
    <ErrorState Message="@error.Message" ErrorId="@error.ErrorId"><button class="button-secondary" @onclick="LoadAsync">Retry</button></ErrorState>
}
else if (extensions?.Count == 0)
{
    <EmptyState Title="No extensions" Message="Create an AEP-backed Model Provider to observe its extension here." />
}
else
{
    @foreach (var extension in extensions ?? [])
    {
        <section class="panel resource-section">
            <div class="panel-header">
                <div>
                    <p class="eyebrow">AEP extension · <code>@extension.ProviderNamespace/@extension.ProviderName</code></p>
                    <h2>@(extension.Extension?.Name ?? extension.ProviderName)</h2>
                    <p>@(extension.Extension?.Description ?? extension.Details ?? "Extension identity is not currently available.")</p>
                </div>
                <StatusBadge Text="@ModelManagementUi.Label(extension.Status)" Status="@ModelManagementUi.Status(extension.Status)" />
            </div>
            <dl class="resource-details">
                <dt>Extension ID</dt><dd><code>@(extension.Extension?.Id ?? "—")</code></dd>
                <dt>Observed version</dt><dd>@(extension.Extension?.Version ?? "—")</dd>
                <dt>AEP endpoint</dt><dd><code>@extension.Endpoint</code></dd>
                <dt>Contributions</dt><dd>@(extension.Contributions.Count == 0 ? "—" : string.Join(", ", extension.Contributions))</dd>
            </dl>

            <div class="panel-header"><div><h3>Option contracts</h3><p>Every version and schema digest is immutable.</p></div><span>@extension.OptionSets.Count set(s)</span></div>
            @if (extension.OptionSets.Count == 0)
            {
                <p class="inline-warning">@(extension.Status == "available" ? "This extension does not publish a versioned option contract." : "Contracts are unavailable because the extension could not be inspected.")</p>
            }
            else
            {
                <DataGrid TItem="ExtensionOptionSetResponse" Items="extension.OptionSets">
                    <Header><tr><th>Option set</th><th>Target</th><th>Preferred</th><th>Supported versions</th></tr></Header>
                    <Row Context="optionSet"><tr>
                        <td><code>@optionSet.Id</code></td>
                        <td>@optionSet.ContributionKind · <code>@optionSet.ContributionId</code> · @optionSet.Scope</td>
                        <td>@optionSet.PreferredVersion</td>
                        <td>@foreach (var version in optionSet.Versions) { <div><strong>@version.Version</strong>@(version.Deprecated ? " · deprecated" : null)<br /><code>@version.SchemaDigest</code><details><summary>JSON Schema</summary><pre class="runner-json">@FormatSchema(version.Schema)</pre></details></div> }</td>
                    </tr></Row>
                </DataGrid>
            }

            <div class="panel-header"><div><h3>Persisted usage</h3><p>Profiles remain pinned to the exact contract version they were authored against.</p></div><span>@extension.Usages.Count profile(s)</span></div>
            @if (extension.Usages.Count > 0)
            {
                <DataGrid TItem="ExtensionOptionUsageResponse" Items="extension.Usages">
                    <Header><tr><th>Model Profile</th><th>Contract</th><th>Status</th><th>Diagnostics</th></tr></Header>
                    <Row Context="usage"><tr>
                        <td><a href="@ProfileUrl(usage)">@usage.ProfileName</a><br /><small>@usage.ProfileNamespace</small></td>
                        <td>@if (string.IsNullOrWhiteSpace(usage.OptionSet)) { <span>Legacy unversioned options</span> } else { <code>@usage.OptionSet@@@usage.Version</code><br /><small>@ShortDigest(usage.SchemaDigest)</small> }</td>
                        <td><StatusBadge Text="@ModelManagementUi.Label(usage.Status)" Status="@ModelManagementUi.Status(usage.Status)" /></td>
                        <td>@(usage.Issues.Count == 0 ? "Compatible" : string.Join(" ", usage.Issues))</td>
                    </tr></Row>
                </DataGrid>
            }
            else
            {
                <p>No persisted Model Profile uses native options from this extension.</p>
            }
        </section>
    }
}

@code {
    private readonly CancellationTokenSource cancellation = new();
    private IReadOnlyList<ExtensionResponse>? extensions;
    private AgentstrationApiException? error;
    private bool loading;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try { extensions = await Client.GetExtensionsAsync(cancellation.Token); }
        catch (AgentstrationApiException exception) { error = exception; }
        finally { loading = false; }
    }

    private static string ShortDigest(string value) => value.Length <= 24 ? value : $"{value[..18]}…{value[^6..]}";
    private static string FormatSchema(System.Text.Json.JsonElement schema) =>
        System.Text.Json.JsonSerializer.Serialize(schema, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
    private static string ProfileUrl(ExtensionOptionUsageResponse usage) =>
        $"/modelprofiles/{Uri.EscapeDataString(usage.ProfileName)}?namespace={Uri.EscapeDataString(usage.ProfileNamespace)}";

    public void Dispose()
    {
        cancellation.Cancel();
        cancellation.Dispose();
    }
}
