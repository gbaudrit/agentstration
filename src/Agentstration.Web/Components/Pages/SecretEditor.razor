@page "/secrets/new"
@page "/secrets/{Name}"
@implements IDisposable
@inject ISecretsClient Client
@inject NavigationManager Navigation

<PageTitle>@(IsNew?"Create Secret":$"{Name} · Secret") · Agentstration</PageTitle>
<PageHeader Title="@(IsNew?"Create Secret":model.DisplayName)" Description="Declare Secret metadata and manage its write-only value."><Actions>@if(!IsNew){<button class="button-danger" @onclick="RequestDelete">Delete</button>}<a class="button-secondary" href="/secrets">Back</a></Actions></PageHeader>
<ResourceTabs Label="Secret management"><a class="active" href="/secrets">Secrets</a><a href="/vaults">Vaults</a></ResourceTabs>
@if(error is not null){<div class="form-alert form-alert-danger" role="alert">@error.Message</div>}@if(usages.Count>0){<div class="form-alert form-alert-warning">This Secret is referenced by @usages.Count resource(s).</div>}
<EditForm Model="model" OnValidSubmit="SaveAsync" FormName="secret-editor" class="resource-form"><DataAnnotationsValidator/><ValidationSummary/>
<section class="panel form-section"><div class="panel-header"><div><p class="eyebrow">Identity</p><h2>Secret resource</h2></div>@if(valueStatus is not null){<StatusBadge Text="@valueStatus" Status="@Tone(valueStatus)"/>}</div><div class="form-grid"><label><span>Display name</span><InputText Value="@model.DisplayName" ValueChanged="DisplayNameChanged" ValueExpression="@(()=>model.DisplayName)"/></label><label><span>Name</span><InputText Value="@model.Name" ValueChanged="NameChanged" ValueExpression="@(()=>model.Name)" disabled="@(!IsNew)"/><small>Agentstration resource identifier.</small></label><label class="form-span-2"><span>Description</span><InputTextArea @bind-Value="model.Description"/></label><label><span>Vault</span><InputSelect @bind-Value="model.VaultName"><option value="">Select a Vault</option>@foreach(var vault in vaults){<option value="@vault.Resource.Name">@vault.Resource.Definition.DisplayName</option>}</InputSelect></label><label><span>Vault key</span><InputText Value="@model.Key" ValueChanged="KeyChanged" ValueExpression="@(()=>model.Key)"/><small>Storage identifier in the Vault, not the Secret value.</small></label><label><span>Secret type</span><input value="opaque" disabled/></label></div></section>
<div class="form-actions"><a class="button-secondary" href="/secrets">Cancel</a><button class="button-primary" disabled="@busy">@(busy?"Saving…":"Save metadata")</button></div></EditForm>
@if(!IsNew){<section class="panel resource-section"><div class="panel-header"><div><p class="eyebrow">Write only</p><h2>Secret value</h2></div><StatusBadge Text="@(valueStatus??"Unknown")" Status="@Tone(valueStatus??"")"/></div><p>The existing value can never be revealed by Agentstration.</p>@if(!editingValue){<div class="form-actions"><button class="button-primary" @onclick="()=>editingValue=true">@(valueConfigured?"Replace value":"Set value")</button>@if(valueConfigured){<button class="button-danger" @onclick="()=>confirmDeleteValue=true">Delete value</button>}</div>}else{<div @key="valueEditorKey" class="form-grid"><label class="form-span-2"><span>New value</span><input type="password" @bind="secretValue" autocomplete="new-password" spellcheck="false"/></label><div class="form-actions"><button class="button-secondary" @onclick="CancelValue">Cancel</button><button class="button-primary" @onclick="SetValueAsync" disabled="@(busy||string.IsNullOrEmpty(secretValue))">Save value</button></div></div>}</section>
@if(usages.Count>0){<section class="panel resource-section"><div class="panel-header"><h2>Usages</h2><span>@usages.Count</span></div><ul class="resource-links">@foreach(var usage in usages){<li><a href="@usage.Url"><strong>@usage.DisplayName</strong><code>@usage.Name</code></a></li>}</ul></section>}}
<ConfirmationDialog IsOpen="@confirmDelete" Title="Delete Secret" Message="@($"Delete Secret '{Name}' and its stored value?")" ConfirmLabel="Delete Secret" OnConfirm="DeleteAsync" OnCancel="()=>confirmDelete=false"/><ConfirmationDialog IsOpen="@confirmDeleteValue" Title="Delete Secret value" Message="The Secret metadata will remain but its value will become Missing." ConfirmLabel="Delete value" OnConfirm="DeleteValueAsync" OnCancel="()=>confirmDeleteValue=false"/>
@code { [Parameter]public string? Name{get;set;}private readonly CancellationTokenSource cancellation=new();private SecretEditorModel model=new();private IReadOnlyList<VaultResponse> vaults=[];private IReadOnlyList<SecretUsageResponse> usages=[];private string? etag,valueStatus,secretValue;private bool valueConfigured,editingValue,busy,confirmDelete,confirmDeleteValue,nameEdited,keyEdited;private int valueEditorKey;private Exception? error;private bool IsNew=>string.IsNullOrWhiteSpace(Name);protected override async Task OnParametersSetAsync(){error=null;try{vaults=await Client.GetVaultsAsync(cancellation.Token);if(IsNew)return;var snapshot=await Client.GetSecretAsync(Name!,cancellation.Token);model=SecretEditorModel.From(snapshot.Value.Resource);nameEdited=keyEdited=true;etag=snapshot.ETag;valueStatus=snapshot.Value.ValueStatus;valueConfigured=snapshot.Value.ValueConfigured;usages=(await Client.GetSecretUsagesAsync(Name!,cancellation.Token)).Value;}catch(Exception ex){error=ex;}}private void DisplayNameChanged(string value){model.DisplayName=value;if(!IsNew)return;var identifier=SecretEditorModel.IdentifierFromDisplayName(value);if(!nameEdited)model.Name=identifier;if(!keyEdited)model.Key=model.Name;}private void NameChanged(string value){model.Name=value;nameEdited=true;if(IsNew&&!keyEdited)model.Key=value;}private void KeyChanged(string value){model.Key=value;keyEdited=true;}private async Task SaveAsync(){busy=true;error=null;try{var snapshot=IsNew?await Client.CreateSecretAsync(new(model.Name,model.Properties()),cancellation.Token):await Client.UpdateSecretAsync(model.Name,new(model.Properties()),etag!,cancellation.Token);if(IsNew)Navigation.NavigateTo($"/secrets/{Uri.EscapeDataString(snapshot.Value.Name)}");else etag=snapshot.ETag;}catch(Exception ex){error=ex;}finally{busy=false;}}private async Task SetValueAsync(){if(string.IsNullOrEmpty(secretValue))return;busy=true;error=null;try{await Client.SetSecretValueAsync(model.Name,secretValue,cancellation.Token);valueConfigured=true;valueStatus="Configured";CancelValue();}catch(Exception ex){error=ex;}finally{secretValue=null;valueEditorKey++;busy=false;}}private void CancelValue(){secretValue=null;editingValue=false;valueEditorKey++;}private async Task DeleteValueAsync(){confirmDeleteValue=false;try{await Client.DeleteSecretValueAsync(model.Name,cancellation.Token);valueConfigured=false;valueStatus="Missing";CancelValue();}catch(Exception ex){error=ex;}}private void RequestDelete(){if(usages.Count>0)error=new AgentstrationApiException($"This Secret is used by {usages.Count} resource(s).",Guid.NewGuid().ToString("N"));else confirmDelete=true;}private async Task DeleteAsync(){confirmDelete=false;try{await Client.DeleteSecretAsync(model.Name,etag!,cancellation.Token);Navigation.NavigateTo("/secrets");}catch(Exception ex){error=ex;}}private static UiStatus Tone(string value)=>value.Equals("Configured",StringComparison.OrdinalIgnoreCase)?UiStatus.Success:value.Equals("Missing",StringComparison.OrdinalIgnoreCase)?UiStatus.Warning:UiStatus.Danger;public void Dispose(){secretValue=null;cancellation.Cancel();cancellation.Dispose();}}
