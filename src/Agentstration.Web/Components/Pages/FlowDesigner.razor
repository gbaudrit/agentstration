@page "/flows/{FlowId}/designer"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IFlowApiClient Client
@inject IManagementApiClient Management
@inject FlowEditorStore Editor
@inject NavigationManager Navigation
@inject IJSRuntime JS
<PageTitle>@(Editor.State.Draft?.DisplayName ?? "Flow Designer") · Agentstration</PageTitle>
@if(Editor.State.Draft is null){<LoadingState/>}else{
<header class="designer-toolbar"><div><p class="eyebrow"><a href="/flows">Flows</a> / @FlowId / Draft</p><h1>@Editor.State.Draft.DisplayName</h1><span class="save-state @Editor.State.SaveState.ToString().ToLowerInvariant()">@SaveText</span><span class="draft-revision">Revision @Editor.State.Draft.Revision</span></div><div class="designer-modes">@foreach(var mode in Enum.GetValues<FlowEditorMode>()){<button class="@(Editor.State.Mode==mode?"active":null)" @onclick="()=>Editor.SetMode(mode)">@mode</button>}</div><div class="designer-actions"><button class="button-secondary" disabled="@(!Editor.CanUndo)" @onclick="Undo">Undo</button><button class="button-secondary" disabled="@(!Editor.CanRedo)" @onclick="Redo">Redo</button><button class="button-secondary" @onclick="ValidateAsync">Validate</button><button class="button-secondary" @onclick="OpenRun">Run draft</button><button class="button-primary" disabled="@saving" @onclick="SaveAsync">Save</button><label class="publish-version">Version<input aria-label="Publish version" @bind="publishVersion" /></label><button class="button-primary" @onclick="PublishAsync">Publish</button></div></header>
<section class="flow-editor-shell @(Editor.State.Mode.ToString().ToLowerInvariant())">
@if(Editor.State.Mode is FlowEditorMode.Designer or FlowEditorMode.Split){
<aside class="step-palette"><h2>Steps</h2><h3>Inputs</h3><button @onclick="AddInputAsync">＋ Input</button><h3>Execution</h3><button @onclick="AddAgentAsync">＋ Agent</button><button @onclick="AddRouterAsync">＋ Router</button><h3>Logic</h3><button @onclick="AddConditionAsync">＋ Condition</button><button @onclick="AddTransformAsync">＋ Transform</button><h3>Completion</h3><button @onclick="AddOutputAsync">＋ Output</button><button @onclick="AddFailureAsync">＋ Failure</button><hr/><button @onclick="LayoutHorizontalAsync">Horizontal layout</button><button @onclick="LayoutVerticalAsync">Vertical layout</button><button @onclick="CenterAsync">Center</button></aside>
<div class="flow-canvas-wrap"><div id="flow-designer-canvas" class="flow-canvas"><svg class="flow-links">@foreach(var link in Editor.State.Diagram.Links){var from=Node(link.From);var to=Node(link.To);if(from is not null&&to is not null){<line x1="@(from.Position.X+145)" y1="@(from.Position.Y+42)" x2="@to.Position.X" y2="@(to.Position.Y+42)"/>}}</svg>@foreach(var node in Editor.State.Diagram.Nodes){<article data-flow-node data-name="@node.Name" class="designer-node @(Editor.State.Selection.StepName==node.Name?"selected":null)" style="left:@(node.Position.X)px;top:@(node.Position.Y)px" @onclick="()=>Editor.SelectStep(node.Name)"><span aria-hidden="true">@NodeIcon(node.Type)</span><strong>@node.DisplayName</strong><small>@node.Type</small>@if(node.Resource is not null){<code>@Short(node.Resource)</code>}<span class="drag-hint">Drag</span></article>}</div></div>
<aside class="flow-inspector"><h2>Inspector</h2>@if(SelectedStep is null){<p class="muted">Select a step, or configure a transition below.</p>}else{<label>Display name<input value="@(SelectedStep.DisplayName??SelectedStep.Name)" @onchange="UpdateDisplayNameAsync"/></label><label>Technical name<input value="@SelectedStep.Name" readonly/></label><label>Type<input value="@SelectedStep.Type()" readonly/></label>@if(SelectedStep is AgentFlowStepDefinition agent){<label>Agent<select value="@agent.Agent.ResourceId" @onchange="UpdateAgentAsync"><option value="${steps.route-request.output.selectedAgent}">Router output</option>@foreach(var item in agents){<option value="@item.Id">@item.Name</option>}</select></label><label>Input mapping<textarea rows="5" value="@(agent.InputMapping?.GetRawText()??"{}")" @onchange="UpdateAgentMappingAsync"></textarea></label>}else if(SelectedStep is RouterFlowStepDefinition router){<section class="router-editor"><div class="router-group-picker"><label>Resource group<input @bind="routerResourceGroup" placeholder="default"/></label><button class="button-secondary" disabled="@loadingRouterAgents" @onclick="LoadRouterAgentsAsync">Load agents</button><button class="button-secondary" disabled="@loadingRouterAgents" @onclick="AddAllRouterAgentsAsync">Add all</button></div><p class="muted router-agent-count">@routerAgents.Count agent(s) available in <code>@routerResourceGroup</code>. Added agents are stored as explicit immutable references.</p><div class="route-cards">@for(var index=0;index<router.Candidates.Count;index++){var routeIndex=index;var candidate=router.Candidates[index];<article class="route-card"><header><span class="route-key-badge">@candidate.Route</span><button type="button" aria-label="Remove route @candidate.Route" @onclick="()=>RemoveRouterCandidateAsync(routeIndex)">×</button></header><label>Route key<input value="@candidate.Route" @onchange="e=>UpdateRouterRouteAsync(routeIndex,e)"/></label><label>Agent<select value="@candidate.Agent.ResourceId" @onchange="e=>UpdateRouterAgentAsync(routeIndex,e)"><option value="@candidate.Agent.ResourceId">@AgentLabel(candidate.Agent.ResourceId)</option>@foreach(var item in routerAgents.Where(item=>item.Id!=candidate.Agent.ResourceId)){<option value="@item.Id">@item.Name</option>}</select></label><label>Description<input value="@candidate.Description" @onchange="e=>UpdateRouterDescriptionAsync(routeIndex,e)"/></label><label>Examples <span class="field-hint">comma-separated</span><input value="@string.Join(", ",candidate.Examples??[])" @onchange="e=>UpdateRouterExamplesAsync(routeIndex,e)"/></label></article>}</div><button class="button-secondary add-route" @onclick="AddRouterCandidateAsync">＋ Add route</button><label>Fallback agent<select value="@router.Fallback?.ResourceId" @onchange="UpdateFallbackAsync"><option value="">None</option>@if(router.Fallback is not null){<option value="@router.Fallback.ResourceId">@AgentLabel(router.Fallback.ResourceId)</option>}@foreach(var item in routerAgents.Where(item=>item.Id!=router.Fallback?.ResourceId)){<option value="@item.Id">@item.Name</option>}</select></label></section>}else if(SelectedStep is ConditionFlowStepDefinition condition){<label>Left value<input value="@condition.Left" @onchange="UpdateConditionLeftAsync"/></label><label>Operator<select value="@condition.Operator" @onchange="UpdateConditionOperatorAsync">@foreach(var op in ConditionOperators){<option>@op</option>}</select></label><label>Right value<input value="@condition.Right" @onchange="UpdateConditionRightAsync"/></label>}else if(SelectedStep is TransformFlowStepDefinition transform){<label>Mapping JSON<textarea rows="7" value="@(transform.Mapping?.GetRawText()??"{}")" @onchange="UpdateTransformAsync"></textarea></label>}else if(SelectedStep is OutputFlowStepDefinition output){<label>Output mapping<textarea rows="7" value="@(output.OutputMapping?.GetRawText()??"{}")" @onchange="UpdateOutputAsync"></textarea></label>}else if(SelectedStep is FailureFlowStepDefinition failure){<label>Error code<input value="@failure.Code" @onchange="UpdateFailureCodeAsync"/></label><label>Message<textarea rows="4" value="@failure.Message" @onchange="UpdateFailureMessageAsync"></textarea></label>}<button class="button-danger" disabled="@(SelectedStep.Name==Editor.State.Draft.Definition.EntryStep)" @onclick="RemoveSelectedAsync">Delete step</button>}<hr/><h3>Add transition</h3><label>From<select @bind="transitionFrom">@foreach(var node in Editor.State.Diagram.Nodes){<option value="@node.Name">@node.Name</option>}</select></label><label>Event<input @bind="transitionEvent"/></label><label>To<select @bind="transitionTo">@foreach(var node in Editor.State.Diagram.Nodes){<option value="@node.Name">@node.Name</option>}</select></label><button class="button-secondary" @onclick="AddTransitionAsync">Add transition</button><ul class="transition-list">@foreach(var transition in Editor.State.Draft.Definition.Transitions){<li><button @onclick="()=>Editor.SelectTransition(transition.Id)">@transition.FromStep —@transition.Event→ @transition.ToStep</button><button aria-label="Remove transition" @onclick="()=>RemoveTransitionAsync(transition.Id)">×</button></li>}</ul></aside>
}
@if(Editor.State.Mode is FlowEditorMode.Definition or FlowEditorMode.Split){<section class="source-editor"><header><h2>YAML definition</h2><button class="button-secondary" @onclick="ApplySourceAsync">Apply valid YAML</button></header><textarea @bind="sourceText" @bind:event="oninput" spellcheck="false"></textarea>@if(Editor.State.SourceError is not null){<p class="error-panel">@Editor.State.SourceError</p>}<p class="muted">Invalid source is preserved; the canvas continues to show the last valid definition.</p></section>}
</section>
<section class="validation-dock"><header><strong>Validation</strong><span>@Editor.State.Issues.Count issue(s)</span></header>@if(Editor.State.Issues.Count==0){<p class="muted">Validate the Draft to check structure, reachability, expressions and resources.</p>}else{<ul>@foreach(var issue in Editor.State.Issues){<li class="@issue.Severity.ToString().ToLowerInvariant()"><button @onclick="()=>SelectIssue(issue)"><strong>@issue.Severity</strong> @issue.Message <code>@issue.Code</code></button></li>}</ul>}</section>
@if(showRun){<div class="dialog-backdrop"><section class="dialog run-dialog"><h2>Run Draft revision @Editor.State.Draft.Revision</h2><label>Input JSON<textarea rows="10" @bind="runInput"></textarea></label>@if(error is not null){<p class="error-panel">@error</p>}<div class="dialog-actions"><button class="button-secondary" @onclick="()=>showRun=false">Cancel</button><button class="button-primary" @onclick="RunDraftAsync">Run draft</button></div></section></div>}
}
@code{
    [Parameter]public string FlowId{get;set;}=string.Empty;private const string CanvasId="flow-designer-canvas";private readonly CancellationTokenSource cancellation=new();private IReadOnlyList<AgentSummary> agents=[];private IReadOnlyList<AgentSummary> routerAgents=[];private IJSObjectReference? module;private DotNetObjectReference<FlowDesigner>? reference;private string sourceText="",transitionFrom="",transitionTo="",transitionEvent="completed",routerResourceGroup="default",runInput="{\n  \"prompt\": \"How can I optimize this SQL query?\"\n}";private bool saving,showRun,loadingRouterAgents;private string publishVersion="1.0.0";private string? error;private CancellationTokenSource? autosave;
    private static readonly string[] ConditionOperators=["equals","not equals","contains","starts with","ends with","greater than","greater than or equal","less than","less than or equal","is empty","is not empty"];
    private FlowStepDefinition? SelectedStep=>Editor.State.Draft?.Definition.Steps.FirstOrDefault(step=>step.Name==Editor.State.Selection.StepName);private string SaveText=>Editor.State.SaveState switch{FlowSaveState.Saving=>"Saving…",FlowSaveState.UnsavedChanges=>"Unsaved changes",FlowSaveState.SaveFailed=>"Save failed",_=>"Saved"};
    protected override async Task OnParametersSetAsync(){var draftTask=Client.GetDraftAsync(FlowId,cancellation.Token);var sourceTask=Client.GetDraftSourceAsync(FlowId,"yaml",cancellation.Token);var agentsTask=Management.GetAgentsAsync(cancellation.Token);await Task.WhenAll(draftTask,sourceTask,agentsTask);sourceText=(await sourceTask).Source;Editor.Load(await draftTask,sourceText);agents=await agentsTask;routerAgents=agents;routerResourceGroup=Editor.State.Draft!.ResourceGroup;transitionFrom=Editor.State.Draft.Definition.EntryStep;transitionTo=Editor.State.Draft.Definition.Steps.Skip(1).FirstOrDefault()?.Name??transitionFrom;Editor.StateChanged+=EditorChanged;}
    protected override async Task OnAfterRenderAsync(bool firstRender){module??=await JS.InvokeAsync<IJSObjectReference>("import","./flowDesigner.js?v=2");reference??=DotNetObjectReference.Create(this);await module.InvokeVoidAsync("attach",CanvasId,reference);}
    [JSInvokable]public async Task CommitMove(string name,double x,double y){await DispatchAsync(new MoveStepCommand(name,new(x,y)));}
    private async Task DispatchAsync(IFlowEditorCommand command){await Editor.DispatchAsync(command,cancellation.Token);ScheduleAutosave();}
    private void EditorChanged(object? sender,EventArgs args)=>InvokeAsync(StateHasChanged);
    private void ScheduleAutosave(){autosave?.Cancel();autosave?.Dispose();autosave=CancellationTokenSource.CreateLinkedTokenSource(cancellation.Token);_ = AutosaveAsync(autosave.Token);}
    private async Task AutosaveAsync(CancellationToken token){try{await Task.Delay(TimeSpan.FromSeconds(1.5),token);await SaveAsync();}catch(OperationCanceledException){}}
    private async Task SaveAsync(){if(Editor.State.Draft is null||Editor.State.ETag is null||!Editor.State.IsDirty)return;try{saving=true;Editor.MarkSaving();var draft=Editor.State.Draft;var saved=await Client.SaveDraftAsync(FlowId,new UpdateFlowDraftRequest(draft.DisplayName,draft.Description,draft.ResourceGroup,draft.Location,draft.Tags,draft.Definition),Editor.State.ETag,cancellation.Token);var source=await Client.GetDraftSourceAsync(FlowId,"yaml",cancellation.Token);sourceText=source.Source;Editor.MarkSaved(saved,source.Source);}catch(Exception exception){error=exception.Message;Editor.MarkSaveFailed();}finally{saving=false;}}
    private async Task ValidateAsync(){var result=await Client.ValidateDraftAsync(FlowId,cancellation.Token);Editor.SetIssues(result.Issues);}
    private async Task PublishAsync(){await SaveAsync();try{var published=await Client.PublishDraftAsync(FlowId,new PublishFlowDraftRequest(publishVersion),cancellation.Token);publishVersion=NextVersion(published.Version);await ValidateAsync();}catch(Exception exception){error=exception.Message;}}
    private void OpenRun(){showRun=true;error=null;}
    private async Task RunDraftAsync(){try{await SaveAsync();using var document=JsonDocument.Parse(runInput);var run=await Client.CreateDraftRunAsync(FlowId,new CreateFlowRunRequest(document.RootElement.Clone(),Trigger:FlowRunTrigger.Manual,StartedBy:"local-user"),cancellation.Token);Navigation.NavigateTo($"/flowruns/{run.Id}");}catch(Exception exception){error=exception.Message;}}
    private async Task ApplySourceAsync(){try{var saved=await Client.ReplaceDraftSourceAsync(FlowId,new ReplaceFlowSourceRequest(sourceText),Editor.State.ETag!,cancellation.Token);var source=await Client.GetDraftSourceAsync(FlowId,"yaml",cancellation.Token);sourceText=source.Source;Editor.MarkSaved(saved,source.Source);}catch(Exception exception){Editor.SetSource(sourceText,exception.Message);}}
    private async Task AddStepAsync(string type){var index=Editor.State.Draft!.Definition.Steps.Count;var name=Unique(type);FlowStepDefinition step=type switch{"input"=>new InputFlowStepDefinition{Name=name,DisplayName="Input"},"agent"=>new AgentFlowStepDefinition{Name=name,DisplayName="Agent",Agent=new(agents.FirstOrDefault()?.Id??"/resourceGroups/default/providers/Agentstration.Agents/agents/unconfigured")},"router"=>new RouterFlowStepDefinition{Name=name,DisplayName="Router"},"condition"=>new ConditionFlowStepDefinition{Name=name,DisplayName="Condition",Left="${input.prompt}",Right=""},"transform"=>new TransformFlowStepDefinition{Name=name,DisplayName="Transform",Mapping=JsonSerializer.SerializeToElement(new{})},"output"=>new OutputFlowStepDefinition{Name=name,DisplayName="Output",OutputMapping=JsonSerializer.SerializeToElement("${input}")},_=>new FailureFlowStepDefinition{Name=name,DisplayName="Failure"}};await DispatchAsync(new AddStepCommand(step,new(40+index*180,250)));Editor.SelectStep(name);}
    private Task AddInputAsync()=>AddStepAsync("input");private Task AddAgentAsync()=>AddStepAsync("agent");private Task AddRouterAsync()=>AddStepAsync("router");private Task AddConditionAsync()=>AddStepAsync("condition");private Task AddTransformAsync()=>AddStepAsync("transform");private Task AddOutputAsync()=>AddStepAsync("output");private Task AddFailureAsync()=>AddStepAsync("failure");
    private async Task AddTransitionAsync(){if(string.IsNullOrWhiteSpace(transitionFrom)||string.IsNullOrWhiteSpace(transitionTo))return;await DispatchAsync(new AddTransitionCommand(new($"{transitionFrom}-{transitionEvent}-{transitionTo}",transitionFrom,transitionEvent,transitionTo)));}
    private Task RemoveTransitionAsync(string id)=>DispatchAsync(new RemoveTransitionCommand(id));private async Task RemoveSelectedAsync(){if(SelectedStep is not null){await DispatchAsync(new RemoveStepCommand(SelectedStep.Name));Editor.SelectStep(null);}}
    private Task LayoutHorizontalAsync()=>DispatchAsync(new ApplyAutoLayoutCommand(false));private Task LayoutVerticalAsync()=>DispatchAsync(new ApplyAutoLayoutCommand(true));private async Task CenterAsync(){if(module is not null)await module.InvokeVoidAsync("center",CanvasId);}
    private void Undo(){Editor.Undo();ScheduleAutosave();}private void Redo(){Editor.Redo();ScheduleAutosave();}private void SelectIssue(FlowValidationIssue issue){if(issue.StepId is not null)Editor.SelectStep(issue.StepId);}
    private Task UpdateDisplayNameAsync(ChangeEventArgs e)=>UpdateSelectedAsync(SelectedStep! with{DisplayName=e.Value?.ToString()});
    private Task UpdateAgentAsync(ChangeEventArgs e)=>UpdateSelectedAsync(((AgentFlowStepDefinition)SelectedStep!) with{Agent=new(e.Value?.ToString()??string.Empty)});
    private Task UpdateAgentMappingAsync(ChangeEventArgs e)=>UpdateSelectedAsync(((AgentFlowStepDefinition)SelectedStep!) with{InputMapping=ParseJson(e.Value?.ToString())});
    private async Task LoadRouterAgentsAsync(){try{loadingRouterAgents=true;error=null;routerAgents=await Management.GetAgentsAsync(string.IsNullOrWhiteSpace(routerResourceGroup)?"default":routerResourceGroup.Trim(),cancellation.Token);}catch(Exception exception){error=exception.Message;}finally{loadingRouterAgents=false;}}
    private async Task AddAllRouterAgentsAsync(){await LoadRouterAgentsAsync();if(SelectedStep is not RouterFlowStepDefinition router||routerAgents.Count==0)return;var candidates=router.Candidates.ToList();foreach(var item in routerAgents.Where(item=>candidates.All(candidate=>candidate.Agent.ResourceId!=item.Id))){var route=UniqueRoute(RouteKey(item.Name),candidates);candidates.Add(new FlowRouterCandidate(route,new(item.Id),$"Agent {item.Name} from resource group {routerResourceGroup}."));}await UpdateSelectedAsync(router with{Candidates=candidates});}
    private Task AddRouterCandidateAsync(){var router=(RouterFlowStepDefinition)SelectedStep!;var resource=routerAgents.FirstOrDefault()?.Id??agents.FirstOrDefault()?.Id??"/resourceGroups/default/providers/Agentstration.Agents/agents/unconfigured";var candidates=router.Candidates.ToList();candidates.Add(new FlowRouterCandidate(UniqueRoute("route",candidates),new(resource)));return UpdateSelectedAsync(router with{Candidates=candidates});}
    private Task RemoveRouterCandidateAsync(int index)=>UpdateRouterCandidatesAsync(index,null);
    private Task UpdateRouterRouteAsync(int index,ChangeEventArgs e)=>UpdateRouterCandidateAsync(index,candidate=>candidate with{Route=e.Value?.ToString()?.Trim()??string.Empty});
    private Task UpdateRouterAgentAsync(int index,ChangeEventArgs e)=>UpdateRouterCandidateAsync(index,candidate=>candidate with{Agent=new(e.Value?.ToString()??string.Empty)});
    private Task UpdateRouterDescriptionAsync(int index,ChangeEventArgs e)=>UpdateRouterCandidateAsync(index,candidate=>candidate with{Description=NullIfEmpty(e.Value?.ToString())});
    private Task UpdateRouterExamplesAsync(int index,ChangeEventArgs e)=>UpdateRouterCandidateAsync(index,candidate=>candidate with{Examples=(e.Value?.ToString()??string.Empty).Split(',',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries)});
    private Task UpdateRouterCandidateAsync(int index,Func<FlowRouterCandidate,FlowRouterCandidate> update){var router=(RouterFlowStepDefinition)SelectedStep!;if(index<0||index>=router.Candidates.Count)return Task.CompletedTask;var candidates=router.Candidates.ToArray();candidates[index]=update(candidates[index]);return UpdateSelectedAsync(router with{Candidates=candidates});}
    private Task UpdateRouterCandidatesAsync(int index,FlowRouterCandidate? replacement){var router=(RouterFlowStepDefinition)SelectedStep!;var candidates=router.Candidates.Where((_,candidateIndex)=>candidateIndex!=index).ToList();if(replacement is not null)candidates.Insert(Math.Min(index,candidates.Count),replacement);return UpdateSelectedAsync(router with{Candidates=candidates});}
    private Task UpdateFallbackAsync(ChangeEventArgs e){var value=e.Value?.ToString();return UpdateSelectedAsync(((RouterFlowStepDefinition)SelectedStep!) with{Fallback=string.IsNullOrWhiteSpace(value)?null:new(value)});}
    private Task UpdateConditionLeftAsync(ChangeEventArgs e)=>UpdateSelectedAsync(((ConditionFlowStepDefinition)SelectedStep!) with{Left=e.Value?.ToString()});private Task UpdateConditionOperatorAsync(ChangeEventArgs e)=>UpdateSelectedAsync(((ConditionFlowStepDefinition)SelectedStep!) with{Operator=e.Value?.ToString()??"equals"});private Task UpdateConditionRightAsync(ChangeEventArgs e)=>UpdateSelectedAsync(((ConditionFlowStepDefinition)SelectedStep!) with{Right=e.Value?.ToString()});
    private Task UpdateTransformAsync(ChangeEventArgs e)=>UpdateSelectedAsync(((TransformFlowStepDefinition)SelectedStep!) with{Mapping=ParseJson(e.Value?.ToString())});private Task UpdateOutputAsync(ChangeEventArgs e)=>UpdateSelectedAsync(((OutputFlowStepDefinition)SelectedStep!) with{OutputMapping=ParseJson(e.Value?.ToString())});private Task UpdateFailureCodeAsync(ChangeEventArgs e)=>UpdateSelectedAsync(((FailureFlowStepDefinition)SelectedStep!) with{Code=e.Value?.ToString()??"FLOW_FAILED"});private Task UpdateFailureMessageAsync(ChangeEventArgs e)=>UpdateSelectedAsync(((FailureFlowStepDefinition)SelectedStep!) with{Message=e.Value?.ToString()??"Flow execution failed."});
    private Task UpdateSelectedAsync(FlowStepDefinition step)=>DispatchAsync(new UpdateStepCommand(step));private static JsonElement ParseJson(string? value)=>JsonDocument.Parse(string.IsNullOrWhiteSpace(value)?"{}":value).RootElement.Clone();
    private string Unique(string prefix){var index=1;var name=prefix;while(Editor.State.Draft!.Definition.Steps.Any(step=>step.Name==name))name=$"{prefix}-{++index}";return name;}private static string UniqueRoute(string prefix,IReadOnlyCollection<FlowRouterCandidate> candidates){var route=prefix;var index=1;while(candidates.Any(candidate=>candidate.Route.Equals(route,StringComparison.Ordinal)))route=$"{prefix}-{++index}";return route;}private static string RouteKey(string value){var normalized=new string(value.Trim().ToLowerInvariant().Select(character=>char.IsLetterOrDigit(character)?character:'-').ToArray()).Trim('-');return string.IsNullOrWhiteSpace(normalized)?"route":normalized;}private string AgentLabel(string resourceId)=>routerAgents.Concat(agents).FirstOrDefault(item=>item.Id==resourceId)?.Name??Short(resourceId);private static string? NullIfEmpty(string? value)=>string.IsNullOrWhiteSpace(value)?null:value.Trim();private FlowDesignerNode? Node(string name)=>Editor.State.Diagram.Nodes.FirstOrDefault(node=>node.Name==name);private static string NodeIcon(string type)=>type switch{"agent"=>"◎","router"=>"◇","condition"=>"?","transform"=>"ƒ","output"=>"□","failure"=>"!",_=>"●"};private static string Short(string value){var index=value.LastIndexOf('/');return index>=0?value[(index+1)..]:value;}private static string NextVersion(string version){var parts=version.Split('.');return parts.Length==3&&int.TryParse(parts[2],out var patch)?$"{parts[0]}.{parts[1]}.{patch+1}":"1.0.0";}
    public async ValueTask DisposeAsync(){Editor.StateChanged-=EditorChanged;autosave?.Cancel();autosave?.Dispose();cancellation.Cancel();reference?.Dispose();if(module is not null)await module.DisposeAsync();cancellation.Dispose();}
}
