@page "/tool-governance/{Owner}/{RunId}"
@implements IDisposable
@inject IToolGovernanceAuditClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<ToolGovernanceAuditStrings> Localizer

<PageTitle>@T("Title") · Agentstration</PageTitle>
<PageHeader Title="@T("Title")" Description="@T("Description")">
    <Actions><a class="button-secondary" href="@BackUrl">@T("BackToRun")</a></Actions>
</PageHeader>

<section class="panel governance-context">
    <div><span>@T("Owner")</span><strong>@OwnerLabel</strong></div>
    <div><span>@T("Run")</span><code>@RunId</code></div>
    <div><span>@T("Arguments")</span><strong>@T("OptInRetention")</strong></div>
</section>

<section class="panel governance-filters">
    <div class="panel-header"><div><p class="eyebrow">@T("AuditFilters")</p><h2>@T("PhysicalAttempts")</h2></div></div>
    <div class="filter-grid">
        <label><span>@T("LogicalToolCall")</span><input @bind="toolCallId" placeholder="ToolCallId" /></label>
        <label><span>@T("PhysicalInvocation")</span><input @bind="invocationId" placeholder="InvocationId" /></label>
        <label><span>@T("Tool")</span><input @bind="toolId" placeholder="@T("ToolResourceId")" /></label>
        <label><span>@T("Hook")</span><input @bind="hookId" placeholder="@T("HookOrResourceId")" /></label>
        <label><span>@T("ResourceGeneration")</span><input @bind="resourceGeneration" inputmode="numeric" placeholder="@T("AnyGeneration")" /></label>
        <label><span>@T("Decision")</span><select @bind="decision"><option value="">@T("AllDecisions")</option>@foreach (var value in Enum.GetValues<ToolExecutionHookEvaluationKind>()) { <option value="@value">@DecisionLabel(value)</option> }</select></label>
    </div>
    <div class="button-row"><button class="button-primary" @onclick="ApplyAsync" disabled="@loading">@T("ApplyFilters")</button><button class="button-secondary" @onclick="ClearAsync" disabled="@loading">@T("Clear")</button></div>
    @if (!string.IsNullOrWhiteSpace(error)) { <div class="form-alert form-alert-danger" role="alert">@error</div> }
</section>

@if (loading && records.Count == 0)
{
    <LoadingState Message="@T("LoadingAudit")" />
}
else if (records.Count == 0)
{
    <EmptyState Title="@T("EmptyTitle")" Message="@T("EmptyMessage")" />
}
else
{
    <section class="governance-records" aria-label="@T("DecisionsAriaLabel")">
        @foreach (var record in records)
        {
            <article class="panel governance-record" id="invocation-@record.InvocationId">
                <header>
                    <div><p class="eyebrow">@T("Sequence", record.Sequence) · @record.Timestamp.LocalDateTime.ToString("G")</p><h2>@record.ToolName</h2></div>
                    <StatusBadge Text="@DecisionLabel(OverallDecision(record))" Status="@DecisionTone(OverallDecision(record))" />
                </header>
                <dl class="governance-identities">
                    <dt>@T("LogicalCall")</dt><dd><code>@record.ToolCallId</code></dd>
                    <dt>@T("PhysicalInvocation")</dt><dd><code>@record.InvocationId</code></dd>
                    <dt>@T("ToolResource")</dt><dd><code>@record.ToolId</code></dd>
                    <dt>@T("Provider")</dt><dd><code>@(record.ProviderId ?? "—")</code></dd>
                    <dt>@T("Agent")</dt><dd><code>@(record.AgentId ?? "—")</code></dd>
                    <dt>@T("Correlation")</dt><dd><code>@(record.CorrelationId ?? "—")</code></dd>
                </dl>
                <section class="governance-invocation" aria-label="@T("InvocationArgumentsAriaLabel")">
                    <h3>@T("InvocationArguments")</h3>
                    @if (record.Arguments is null)
                    {
                        <p class="muted">@T("ArgumentsNotRetained")</p>
                    }
                    else
                    {
                        <pre>@record.Arguments</pre>
                    }
                </section>
                @if (record.Evaluations.Count == 0)
                {
                    <p class="muted">@T("NoHookMatched")</p>
                }
                else
                {
                    <DataGrid TItem="ToolExecutionHookEvaluation" Items="record.Evaluations">
                        <Header><tr><th>@T("Order")</th><th>@T("Hook")</th><th>@T("Source")</th><th>@T("ResourceGeneration")</th><th>@T("Decision")</th><th>@T("Code")</th></tr></Header>
                        <Row Context="evaluation"><tr><td>@evaluation.Hook.Order</td><td><code>@evaluation.Hook.Id</code>@if (evaluation.Hook.ResourceId is not null) { <small>@evaluation.Hook.ResourceId</small> }</td><td>@SourceLabel(evaluation.Hook.Source)</td><td>@(evaluation.Hook.ResourceGeneration?.ToString() ?? "—")</td><td><StatusBadge Text="@DecisionLabel(evaluation.Decision)" Status="@DecisionTone(evaluation.Decision)" /></td><td><code>@(evaluation.Code ?? "—")</code></td></tr></Row>
                    </DataGrid>
                }
            </article>
        }
    </section>
    @if (nextSequence is not null)
    {
        <div class="load-more"><button class="button-secondary" @onclick="LoadMoreAsync" disabled="@loading">@(loading ? T("LoadingMore") : T("LoadMore"))</button></div>
    }
}

@code {
    [Parameter] public string Owner { get; set; } = string.Empty;
    [Parameter] public string RunId { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "toolCallId")] public string? RequestedToolCallId { get; set; }
    [SupplyParameterFromQuery(Name = "invocationId")] public string? RequestedInvocationId { get; set; }
    [SupplyParameterFromQuery(Name = "toolId")] public string? RequestedToolId { get; set; }
    [SupplyParameterFromQuery(Name = "hookId")] public string? RequestedHookId { get; set; }
    [SupplyParameterFromQuery(Name = "resourceGeneration")] public long? RequestedResourceGeneration { get; set; }
    [SupplyParameterFromQuery(Name = "decision")] public string? RequestedDecision { get; set; }

    private readonly CancellationTokenSource cancellation = new();
    private readonly List<ToolGovernanceAuditRecord> records = [];
    private ToolExecutionOwnerKind ownerKind;
    private long? nextSequence;
    private string? toolCallId;
    private string? invocationId;
    private string? toolId;
    private string? hookId;
    private string resourceGeneration = string.Empty;
    private string decision = string.Empty;
    private string? error;
    private bool loading;
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string DecisionLabel(ToolExecutionHookEvaluationKind value) => Localizer[$"Decision.{value}"];
    private string SourceLabel(ToolExecutionHookSource value) => Localizer[$"Source.{value}"];
    private string OwnerLabel => ownerKind == ToolExecutionOwnerKind.FlowRun ? T("FlowRun") : T("RuntimeRun");
    private string BackUrl => ownerKind == ToolExecutionOwnerKind.FlowRun
        ? $"/flow-runs/{Uri.EscapeDataString(RunId)}"
        : $"/runs/{Uri.EscapeDataString(RunId)}";

    protected override async Task OnParametersSetAsync()
    {
        ownerKind = Owner.ToLowerInvariant() switch
        {
            "runtime" or "runtimerun" => ToolExecutionOwnerKind.RuntimeRun,
            "flow" or "flowrun" => ToolExecutionOwnerKind.FlowRun,
            _ => ToolExecutionOwnerKind.Unspecified
        };
        toolCallId = RequestedToolCallId;
        invocationId = RequestedInvocationId;
        toolId = RequestedToolId;
        hookId = RequestedHookId;
        resourceGeneration = RequestedResourceGeneration?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
        decision = Enum.TryParse<ToolExecutionHookEvaluationKind>(RequestedDecision, ignoreCase: true, out var requestedDecision)
            ? requestedDecision.ToString()
            : string.Empty;
        await LoadAsync(append: false);
    }

    private Task ApplyAsync() => LoadAsync(append: false);

    private async Task ClearAsync()
    {
        toolCallId = invocationId = toolId = hookId = null;
        resourceGeneration = decision = string.Empty;
        await LoadAsync(append: false);
    }

    private Task LoadMoreAsync() => LoadAsync(append: true);

    private async Task LoadAsync(bool append)
    {
        error = null;
        if (ownerKind == ToolExecutionOwnerKind.Unspecified)
        {
            records.Clear();
            error = T("UnknownOwner");
            return;
        }
        long? generation = null;
        if (!string.IsNullOrWhiteSpace(resourceGeneration)
            && (!long.TryParse(resourceGeneration, out var parsed) || parsed <= 0))
        {
            error = T("InvalidGeneration");
            return;
        }
        else if (!string.IsNullOrWhiteSpace(resourceGeneration)) generation = long.Parse(resourceGeneration, System.Globalization.CultureInfo.InvariantCulture);

        loading = true;
        try
        {
            var page = await Client.GetAsync(
                ownerKind,
                RunId,
                append ? nextSequence ?? 0 : 0,
                50,
                new ToolGovernanceAuditFilters
                {
                    ToolCallId = NullIfWhiteSpace(toolCallId),
                    InvocationId = NullIfWhiteSpace(invocationId),
                    ToolId = NullIfWhiteSpace(toolId),
                    HookId = NullIfWhiteSpace(hookId),
                    ResourceGeneration = generation,
                    Decision = Enum.TryParse<ToolExecutionHookEvaluationKind>(decision, ignoreCase: true, out var parsedDecision) ? parsedDecision : null
                },
                cancellation.Token);
            if (!append) records.Clear();
            records.AddRange(page.Items);
            nextSequence = page.NextSequence;
        }
        catch (Exception exception) when (exception is AgentstrationApiException or ArgumentException)
        {
            if (!append) records.Clear();
            error = exception.Message;
        }
        finally { loading = false; }
    }

    private static ToolExecutionHookEvaluationKind OverallDecision(ToolGovernanceAuditRecord record) =>
        record.Evaluations.Any(value => value.Decision == ToolExecutionHookEvaluationKind.Denied)
            ? ToolExecutionHookEvaluationKind.Denied
            : record.Evaluations.Any(value => value.Decision == ToolExecutionHookEvaluationKind.Failed)
                ? ToolExecutionHookEvaluationKind.Failed
                : ToolExecutionHookEvaluationKind.Allowed;

    private static UiStatus DecisionTone(ToolExecutionHookEvaluationKind decisionKind) => decisionKind switch
    {
        ToolExecutionHookEvaluationKind.Allowed => UiStatus.Success,
        ToolExecutionHookEvaluationKind.Denied => UiStatus.Warning,
        _ => UiStatus.Danger
    };

    private static string? NullIfWhiteSpace(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;

    public void Dispose()
    {
        cancellation.Cancel();
        cancellation.Dispose();
    }
}
