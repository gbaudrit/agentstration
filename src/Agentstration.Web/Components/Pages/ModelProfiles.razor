@page "/modelprofiles"
@implements IDisposable
@inject IModelProfilesClient Client
@inject IModelProvidersClient ProvidersClient
@inject NotificationState Notifications
@inject Microsoft.Extensions.Localization.IStringLocalizer<ModelProfilesStrings> Localizer

<PageTitle>@T("Title") · Agentstration</PageTitle>
<PageHeader Title="@T("Title")" Description="@T("Description")">
    <Actions><a class="button-primary" href="/modelprofiles/new">@T("CreateModelProfile")</a></Actions>
</PageHeader>

<FilterBar>
    <SearchBox Value="search" ValueChanged="SearchChanged" Placeholder="@T("SearchPlaceholder")" />
    <select @bind="providerFilter" aria-label="@T("FilterByProvider")"><option value="">@T("AllProviders")</option>@foreach (var provider in providers) { <option value="@provider.Name">@provider.Properties.DisplayName</option> }</select>
    <select @bind="statusFilter" aria-label="@T("FilterByStatus")"><option value="">@T("AllStatuses")</option><option value="ready">@T("Status.Ready")</option><option value="providerUnavailable">@T("Status.ProviderUnavailable")</option><option value="modelUnavailable">@T("Status.ModelUnavailable")</option><option value="invalidConfiguration">@T("Status.InvalidConfiguration")</option><option value="unknown">@T("Status.Unknown")</option></select>
    <button class="button-secondary" @onclick="LoadAsync" disabled="@loading">@T("ApplyFilters")</button>
</FilterBar>

@if (error is not null)
{
    <ErrorState Message="@error.Message" ErrorId="@error.ErrorId"><button class="button-secondary" @onclick="LoadAsync">@T("Retry")</button></ErrorState>
}
else if (loading && profiles is null)
{
    <LoadingState Message="@T("Loading")" />
}
else if (profiles?.Count == 0)
{
    <EmptyState Title="@T("EmptyTitle")" Message="@T("EmptyMessage")"><a class="button-primary" href="/modelprofiles/new">@T("CreateModelProfile")</a></EmptyState>
}
else
{
    <DataGrid TItem="ModelProfileSummaryResponse" Items="profiles ?? []">
        <Header><tr><th>@T("Profile")</th><th>@T("Namespace")</th><th>@T("Provider")</th><th>@T("Model")</th><th>@T("Usage")</th><th>@T("Status")</th><th>@T("Actions")</th></tr></Header>
        <Row Context="profile"><tr>
            <td><strong>@profile.Properties.DisplayName</strong><br /><code>@profile.Name</code></td>
            <td><code>@profile.Namespace</code></td>
            <td>@(profile.Properties.Provider.DisplayName ?? profile.Properties.Provider.Name)</td><td><code>@profile.Properties.Model.Name</code></td>
            <td>@AgentCount(profile.Properties.UsageCount)</td><td><StatusBadge Text="@StatusLabel(profile.Properties.Status)" Status="@ModelManagementUi.Status(profile.Properties.Status)" /></td>
            <td><div class="table-actions"><a class="text-button" href="@DetailsUrl(profile)">@T("Open")</a><button class="text-button danger-text" @onclick="() => RequestDeleteAsync(profile)">@T("Delete")</button></div></td>
        </tr></Row>
    </DataGrid>
}

@if (deleteConflictUsages.Count > 0)
{
    <section class="panel resource-section"><div class="panel-header"><h2>@T("DeleteConflictTitle")</h2></div><p>@T("DeleteConflictMessage", AgentCount(deleteConflictUsages.Count))</p><ul>@foreach (var usage in deleteConflictUsages) { <li><a href="@AgentUrl(usage)">@usage.DisplayName <code>@usage.Name</code></a></li> }</ul></section>
}

<ConfirmationDialog IsOpen="@(pendingDelete is not null)" Title="@T("DeleteDialogTitle")" Message="@DeleteMessage" ConfirmLabel="@T("DeleteDialogConfirm")" OnConfirm="DeleteAsync" OnCancel="CancelDelete" />

@code {
    private readonly CancellationTokenSource cancellation = new();
    private IReadOnlyList<ModelProfileSummaryResponse>? profiles; private IReadOnlyList<ModelProviderResponse> providers = [];
    private IReadOnlyList<ModelProfileUsageResponse> deleteConflictUsages = [];
    private ModelProfileSummaryResponse? pendingDelete; private AgentstrationApiException? error;
    private string search = string.Empty; private string providerFilter = string.Empty; private string statusFilter = string.Empty; private bool loading;
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string DeleteMessage => pendingDelete is null ? string.Empty : T("DeleteMessage", pendingDelete.Name);
    private string AgentCount(int count) => T(count == 1 ? "AgentCount.One" : "AgentCount.Many", count);
    private string StatusLabel(string status) => Localizer[$"Status.{status switch { "ready" => "Ready", "providerUnavailable" => "ProviderUnavailable", "modelUnavailable" => "ModelUnavailable", "invalidConfiguration" => "InvalidConfiguration", _ => "Unknown" }}"];
    protected override async Task OnInitializedAsync() { try { providers = await ProvidersClient.GetModelProvidersAsync(cancellation.Token); } catch (AgentstrationApiException) { } await LoadAsync(); }
    private async Task SearchChanged(string value) { search = value; await LoadAsync(); }
    private async Task LoadAsync()
    {
        loading = true; error = null;
        try { profiles = await Client.GetModelProfilesAsync(search, providerFilter, statusFilter, cancellation.Token); }
        catch (AgentstrationApiException exception) { error = exception; }
        finally { loading = false; }
    }
    private async Task RequestDeleteAsync(ModelProfileSummaryResponse profile)
    {
        deleteConflictUsages = [];
        try
        {
            var usages = await Client.GetModelProfileUsagesAsync(ResourceNamespace.Parse(profile.Namespace), profile.Name, cancellation.Token);
            if (usages.Count > 0) { deleteConflictUsages = usages.Value; return; }
            pendingDelete = profile;
        }
        catch (AgentstrationApiException exception) { error = exception; }
    }
    private void CancelDelete() => pendingDelete = null;
    private async Task DeleteAsync()
    {
        if (pendingDelete is null) return;
        var selected = pendingDelete; pendingDelete = null;
        try
        {
            var @namespace = ResourceNamespace.Parse(selected.Namespace);
            var snapshot = await Client.GetModelProfileAsync(@namespace, selected.Name, cancellation.Token);
            await Client.DeleteModelProfileAsync(@namespace, selected.Name, snapshot.ETag, cancellation.Token);
            Notifications.Add(new NotificationItem(Guid.NewGuid(), T("DeletedNotification"), selected.Name, DateTimeOffset.Now, UiStatus.Success));
            await LoadAsync();
        }
        catch (AgentstrationApiException exception)
        {
            error = exception;
            if (exception.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                try { deleteConflictUsages = (await Client.GetModelProfileUsagesAsync(ResourceNamespace.Parse(selected.Namespace), selected.Name, cancellation.Token)).Value; } catch (AgentstrationApiException) { }
            }
        }
    }
    private static string DetailsUrl(ModelProfileSummaryResponse profile) => $"/modelprofiles/{Uri.EscapeDataString(profile.Name)}?namespace={Uri.EscapeDataString(profile.Namespace)}";
    private static string AgentUrl(ModelProfileUsageResponse usage) => $"/agents/{Uri.EscapeDataString(usage.Name)}";
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
