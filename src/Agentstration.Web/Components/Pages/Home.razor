@page "/"
@implements IDisposable
@inject PlatformDashboardService Dashboard
@inject PlatformStatusState PlatformState
@inject Microsoft.Extensions.Localization.IStringLocalizer<HomeStrings> Localizer
<PageTitle>@T("PageTitle")</PageTitle>
<PageHeader Title="@T("PlatformOverview")" Eyebrow="@T("OperationsCenter")">
    <Status>
        @if (snapshot is not null)
        {
            <StatusBadge Text="@T($"Status.{snapshot.Status}")" Status="@PlatformDashboardService.ToStatus(snapshot.Status)" />
        }
    </Status>
</PageHeader>
@if (error is not null) { <ErrorState Message="@error" ErrorId="@errorId" /> }
else if (load is not null)
{
    <section class="overview-metric-grid" aria-label="@T("PlatformMetrics")">
        <DashboardMetricCard Label="@T("DefinedAgents")" Load="@load.DefinedAgents" Url="/agents" />
        <DashboardMetricCard Label="@T("ReadyDeployments")" Load="@load.ReadyDeployments" Url="/deployments" />
        <DashboardMetricCard Label="@T("AgentRuns")" Load="@load.RuntimeRuns" Url="/agent-runs" />
        <DashboardMetricCard Label="@T("FlowRuns")" Load="@load.FlowRuns" Url="/flow-runs" />
        <DashboardMetricCard Label="@T("TasksRunning")" Load="@load.RunningTasks" Url="/tasks" />
        <DashboardMetricCard Label="@T("NeedsAttention")" Load="@load.NeedsAttention" Url="#needs-attention" />
        <DashboardMetricCard Label="@T("EnabledTriggers")" Load="@load.EnabledTriggers" Url="/triggers" />
        <DashboardMetricCard Label="@T("ModelProviders")" Load="@load.ModelProviders" Url="/modelproviders" />
    </section>
    <section class="dashboard-grid">
        <LatestRunEvents />
        <article class="panel" id="needs-attention"><div class="panel-header"><h2>@T("NeedsAttention")</h2><a href="/deployments">@T("Deployments") →</a></div>@if (snapshot is null) { <LoadingState Message="@T("LoadingAttention")" /> } else if (snapshot.AttentionItems.Count == 0) { <EmptyState Title="@T("NoIssues")" Message="" /> } else { <div class="health-list">@foreach (var component in snapshot.AttentionItems) { if (component.Url is not null) { <a class="attention-item" href="@component.Url"><HealthIndicator Label="@component.Name" StatusText="@component.Detail" Status="@component.Severity" /></a> } else { <HealthIndicator Label="@component.Name" StatusText="@component.Detail" Status="@component.Severity" /> } }</div> }</article>
    </section>
    <section class="panel dashboard-sources">
        <div class="panel-header"><h2>@T("DashboardDataSources")</h2></div>
        @if (snapshot is null) { <LoadingState Message="@T("LoadingDataSources")" /> }
        else { <div class="dashboard-source-grid">@foreach (var source in snapshot.Sources) { <a class="dashboard-source-item" href="@source.Url"><HealthIndicator Label="@source.Name" StatusText="@source.Detail" Status="@source.Severity" /><span class="dashboard-source-arrow" aria-hidden="true">→</span></a> }</div> }
    </section>
}
@code {
    private readonly CancellationTokenSource cancellation = new();
    private PlatformDashboardLoad? load;
    private PlatformSnapshot? snapshot;
    private bool disposed;
    private string? error;
    private string? errorId;

    protected override void OnInitialized() => load = Dashboard.Start(cancellation.Token);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || load is null)
            return;

        try
        {
            var refreshed = await load.Snapshot;
            if (disposed)
                return;

            snapshot = refreshed;
            SetPlatformStatus(refreshed);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        catch (AgentstrationApiException exception)
        {
            error = exception.Message;
            errorId = exception.ErrorId;
            PlatformState.Set(UiStatus.Danger, T("Unavailable"));
            if (!disposed)
                await InvokeAsync(StateHasChanged);
        }
    }

    private void SetPlatformStatus(PlatformSnapshot value) =>
        PlatformState.Set(PlatformDashboardService.ToStatus(value.Status), T($"Status.{value.Status}"));

    private string T(string key) => Localizer[key];

    public void Dispose()
    {
        disposed = true;
        cancellation.Cancel();
        cancellation.Dispose();
    }
}

