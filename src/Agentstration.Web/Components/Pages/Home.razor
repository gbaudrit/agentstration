@page "/"
@implements IDisposable
@inject PlatformDashboardService Dashboard
@inject PlatformStatusState PlatformState
<PageTitle>Overview · Agentstration</PageTitle>
<PageHeader Title="Platform overview" Eyebrow="Operations center">
    <Status>
        @if (snapshot is not null)
        {
            <StatusBadge Text="@snapshot.Status" Status="@PlatformDashboardService.ToStatus(snapshot.Status)" />
        }
    </Status>
</PageHeader>
@if (error is not null) { <ErrorState Message="@error" ErrorId="@errorId" /> }
else if (load is not null)
{
    <section class="overview-metric-grid" aria-label="Platform metrics">
        <DashboardMetricCard Label="Defined agents" Load="@load.DefinedAgents" Url="/agents" />
        <DashboardMetricCard Label="Ready deployments" Load="@load.ReadyDeployments" Url="/deployments" />
        <DashboardMetricCard Label="Agents Run" Load="@load.RuntimeRuns" Url="/agent-runs" />
        <DashboardMetricCard Label="Flow Run" Load="@load.FlowRuns" Url="/flow-runs" />
        <DashboardMetricCard Label="Tasks running" Load="@load.RunningTasks" Url="/tasks" />
        <DashboardMetricCard Label="Needs attention" Load="@load.NeedsAttention" Url="#needs-attention" />
        <DashboardMetricCard Label="Enabled triggers" Load="@load.EnabledTriggers" Url="/triggers" />
        <DashboardMetricCard Label="Model providers" Load="@load.ModelProviders" Url="/modelproviders" />
    </section>
    <section class="dashboard-grid">
        <LatestRunEvents />
        <article class="panel" id="needs-attention"><div class="panel-header"><h2>Needs attention</h2><a href="/deployments">Deployments →</a></div>@if (snapshot is null) { <LoadingState Message="Loading attention…" /> } else if (snapshot.AttentionItems.Count == 0) { <EmptyState Title="No issues" Message="" /> } else { <div class="health-list">@foreach (var component in snapshot.AttentionItems) { if (component.Url is not null) { <a class="attention-item" href="@component.Url"><HealthIndicator Label="@component.Name" StatusText="@component.Detail" Status="@component.Severity" /></a> } else { <HealthIndicator Label="@component.Name" StatusText="@component.Detail" Status="@component.Severity" /> } }</div> }</article>
    </section>
    <section class="panel dashboard-sources">
        <div class="panel-header"><h2>Dashboard data sources</h2></div>
        @if (snapshot is null) { <LoadingState Message="Loading data sources…" /> }
        else { <div class="dashboard-source-grid">@foreach (var source in snapshot.Sources) { <a class="dashboard-source-item" href="@source.Url"><HealthIndicator Label="@source.Name" StatusText="@source.Detail" Status="@source.Severity" /><span class="dashboard-source-arrow" aria-hidden="true">→</span></a> }</div> }
    </section>
}
@code {
    private readonly CancellationTokenSource cancellation = new();
    private PlatformDashboardLoad? load;
    private PlatformSnapshot? snapshot;
    private bool disposed;
    private string? error;
    private string? errorId;

    protected override void OnInitialized() => load = Dashboard.Start(cancellation.Token);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || load is null)
            return;

        try
        {
            var refreshed = await load.Snapshot;
            if (disposed)
                return;

            snapshot = refreshed;
            SetPlatformStatus(refreshed);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        catch (AgentstrationApiException exception)
        {
            error = exception.Message;
            errorId = exception.ErrorId;
            PlatformState.Set(UiStatus.Danger, "Unavailable");
            if (!disposed)
                await InvokeAsync(StateHasChanged);
        }
    }

    private void SetPlatformStatus(PlatformSnapshot value) =>
        PlatformState.Set(PlatformDashboardService.ToStatus(value.Status), value.Status);

    public void Dispose()
    {
        disposed = true;
        cancellation.Cancel();
        cancellation.Dispose();
    }
}

