@page "/tasks/{TaskId:guid}"
@implements IDisposable
@inject IWorkApiClient Client
@inject IWorkOperationsRealtimeClient Realtime
@inject Microsoft.Extensions.Options.IOptions<AgentstrationWebOptions> Options

<PageTitle>Task · Agentstration</PageTitle>
@if (notFound)
{
    <EmptyState Title="Task no longer exists" Message="Work API did not return this Task."><a class="button-secondary" href="/tasks">Back to Tasks</a></EmptyState>
}
else if (unavailable)
{
    <WorkApiUnavailableState OnRetry="LoadAsync" />
}
else if (detail is null)
{
    <LoadingState />
}
else
{
    var task=detail.Task;
    <PageHeader Title="@task.Title" Description="@($"Operational WorkTask · {ShortId(task.Id)}")">
        <Actions><RealtimeStatus State="Realtime.State" />@if(task.Status==WorkTaskStatus.Running){<button class="button-secondary" @onclick="PauseAsync">Pause</button>}@if(task.Status==WorkTaskStatus.Paused){<button class="button-primary" @onclick="ResumeAsync">Resume</button>}@if(task.Status is WorkTaskStatus.Pending or WorkTaskStatus.Running or WorkTaskStatus.ActionRequired or WorkTaskStatus.Paused){<button class="button-danger" @onclick="()=>confirmCancel=true">Cancel</button>}<a class="button-secondary" href="/tasks">Back</a></Actions>
    </PageHeader>
    @if(confirmCancel){<section class="panel task-error"><h2>Cancel this Task?</h2><p>The command will be sent to Work API. Existing results and artifacts remain available.</p><button class="button-danger" @onclick="CancelAsync">Confirm cancellation</button><button class="button-secondary" @onclick="()=>confirmCancel=false">Keep Task</button></section>}
    @if(task.Error is not null){<section class="panel task-error"><h2>@task.Error.Title</h2><p><strong>@task.Error.Code</strong> · @task.Error.Message</p><time datetime="@task.Error.OccurredAt.ToString("O")">@task.Error.OccurredAt.ToLocalTime().ToString("F")</time></section>}
    <div class="task-detail-grid">
        <div class="task-detail-stack">
            <section class="panel"><div class="panel-header"><h2>Overview</h2><TaskStatusBadge Status="task.Status" /></div><dl class="resource-details"><dt>Original request</dt><dd>@OriginalRequest</dd><dt>Origin Entry</dt><dd><code>@ResourceName(task.EntryId)</code></dd><dt>Workspace</dt><dd>@ResourceName(task.WorkspaceId)</dd><dt>Interaction</dt><dd><code>@ShortId(task.InteractionId)</code></dd><dt>Current activity</dt><dd>@(task.CurrentActivity??"—")</dd><dt>Created</dt><dd><time title="@task.CreatedAt.ToLocalTime().ToString("F")">@task.CreatedAt.ToLocalTime().ToString("g")</time></dd><dt>Updated</dt><dd><time title="@task.UpdatedAt.ToLocalTime().ToString("F")">@task.UpdatedAt.ToLocalTime().ToString("g")</time></dd><dt>Duration</dt><dd>@Duration(task)</dd></dl>@if(WorkplaceTaskUrl is not null){<a class="text-button" href="@WorkplaceTaskUrl" target="_blank">Open task in Workplace →</a>}</section>
            <section class="panel"><div class="panel-header"><h2>Execution</h2><span>@detail.FlowRuns.Count run(s)</span></div>@if(detail.FlowRuns.Count==0){<p>FlowRun unavailable.</p>}else{<ol class="operations-list">@foreach(var run in detail.FlowRuns){<li class="@(run.ParentFlowRunId is null?null:"flow-run-child")"><div class="panel-header"><strong><a href="/tasks/@TaskId/flowruns/@Uri.EscapeDataString(run.Id)">@ShortId(run.Id)</a></strong><StatusBadge Text="@run.Status" Status="@PlatformDashboardService.ToStatus(run.Status)" /></div><p>@run.Trigger · <code>@run.FlowId</code></p><small>@run.ResultCount result(s) · @run.ArtifactCount artifact(s) · @RunDuration(run)</small>@if(run.ParentFlowRunId is not null){<small class="table-secondary">Parent @ShortId(run.ParentFlowRunId)</small>}</li>}</ol>}</section>
            <section class="panel"><div class="panel-header"><h2>Results</h2><span>@detail.Results.Count</span></div>@if(detail.Results.Count==0){<p>Results unavailable.</p>}else{<ol class="operations-list">@foreach(var result in detail.Results.OrderByDescending(value=>value.Sequence)){<li><div class="panel-header"><strong>@result.Title @(result.Sequence==detail.Results.Max(value=>value.Sequence)?"· Latest":null)</strong><span>Version @result.Sequence</span></div><small>@result.Kind · @result.CreatedAt.ToLocalTime().ToString("g") · FlowRun @ShortId(result.FlowRunId)</small><pre class="result-preview">@FormatContent(result.Content)</pre></li>}</ol>}</section>
            <section class="panel"><div class="panel-header"><h2>Artifacts</h2><span>@detail.Artifacts.Count</span></div>@if(detail.Artifacts.Count==0){<p>Artifact unavailable.</p>}else{<ul class="operations-list">@foreach(var artifact in detail.Artifacts.OrderByDescending(value=>value.Sequence)){<li><strong>@artifact.Name</strong><p>@artifact.ContentType · @FormatSize(artifact.Length) · Version @artifact.Sequence</p><small>FlowRun @ShortId(artifact.FlowRunId) · @artifact.CreatedAt.ToLocalTime().ToString("g")</small><a class="text-button" href="@ArtifactUrl(artifact)" download>Download</a></li>}</ul>}</section>
        </div>
        <aside class="task-detail-stack">
            <section class="panel"><div class="panel-header"><h2>Pending actions</h2><span>@detail.PendingActions.Count(value=>value.Status==PendingActionStatus.Pending)</span></div>@if(detail.PendingActions.Count==0){<p>No pending action.</p>}else{<ul class="operations-list">@foreach(var action in detail.PendingActions){<li><div class="panel-header"><strong>@action.Title</strong><StatusBadge Text="@action.Status.ToString()" Status="@PlatformDashboardService.ToStatus(action.Status.ToString())" /></div><p>@action.Kind @if(!string.IsNullOrWhiteSpace(action.Description)){<span>· @action.Description</span>}</p><small>Created @action.CreatedAt.ToLocalTime().ToString("g")</small></li>}</ul>}@if(WorkplaceInteractionUrl is not null){<a class="text-button" href="@WorkplaceInteractionUrl" target="_blank">Open interaction in Workplace →</a>}</section>
            <section class="panel"><div class="panel-header"><h2>Interaction</h2><span>Read only</span></div><details><summary>@detail.Messages.Count message(s)</summary><ol class="operations-list">@foreach(var message in detail.Messages){<li><strong>@message.Role</strong><p>@message.Content</p><small>@message.CreatedAt.ToLocalTime().ToString("g")</small></li>}</ol></details></section>
            <section class="panel"><div class="panel-header"><h2>Activity</h2><span>@detail.Activities.Count</span></div>@if(detail.Activities.Count==0){<p>No functional activity.</p>}else{<ol class="operations-list">@foreach(var activity in detail.Activities.OrderByDescending(value=>value.CreatedAt)){<li><strong>@activity.Title</strong><p>@activity.Type @if(!string.IsNullOrWhiteSpace(activity.Description)){<span>· @activity.Description</span>}</p><time title="@activity.CreatedAt.ToLocalTime().ToString("F")">@activity.CreatedAt.ToLocalTime().ToString("g")</time></li>}</ol>}</section>
        </aside>
    </div>
}

@code {
    [Parameter] public Guid TaskId { get; set; }
    private readonly CancellationTokenSource lifetime=new();private WorkTaskOperationsDetailResponse? detail;private bool unavailable,notFound,confirmCancel,realtimeStarted;
    protected override async Task OnParametersSetAsync()=>await LoadAsync();
    private async Task LoadAsync(){unavailable=false;notFound=false;try{detail=await Client.GetTaskAsync(TaskId,lifetime.Token);if(!realtimeStarted){realtimeStarted=true;Realtime.Updated+=OnRealtime;Realtime.StateChanged+=OnStateChanged;await Realtime.StartAsync([detail.Task.WorkspaceId],lifetime.Token);}}catch(AgentstrationApiException exception) when(exception.StatusCode==System.Net.HttpStatusCode.NotFound){notFound=true;detail=null;}catch(Exception exception) when(exception is AgentstrationApiException or HttpRequestException or Polly.Timeout.TimeoutRejectedException){unavailable=true;detail=null;}}
    private Task OnRealtime(WorkOperationsRealtimeUpdate update)=>update.RequiresResynchronization||update.TaskId==TaskId?InvokeAsync(LoadAsync):Task.CompletedTask;private void OnStateChanged()=>InvokeAsync(StateHasChanged);
    private async Task PauseAsync(){await Client.PauseTaskAsync(TaskId,lifetime.Token);await LoadAsync();}private async Task ResumeAsync(){await Client.ResumeTaskAsync(TaskId,lifetime.Token);await LoadAsync();}private async Task CancelAsync(){confirmCancel=false;await Client.CancelTaskAsync(TaskId,lifetime.Token);await LoadAsync();}
    private string OriginalRequest=>detail?.Interaction.InputValues.TryGetValue("request",out var request)==true?(request.ValueKind==System.Text.Json.JsonValueKind.String?request.GetString()??"—":request.ToString()):"—";
    private string? WorkplaceTaskUrl=>WorkplaceUrl($"tasks/{TaskId}");private string? WorkplaceInteractionUrl=>detail is null?null:WorkplaceUrl($"?interaction={detail.Task.InteractionId}");
    private string? WorkplaceUrl(string relative)=>string.IsNullOrWhiteSpace(Options.Value.WorkplaceBaseUrl)?null:new Uri(new Uri(Options.Value.WorkplaceBaseUrl.EndsWith('/')?Options.Value.WorkplaceBaseUrl:$"{Options.Value.WorkplaceBaseUrl}/"),relative).ToString();
    private string ArtifactUrl(WorkTaskArtifactResponse value)=>new Uri(new Uri(Options.Value.WorkApi.BaseAddress),value.DownloadUrl.TrimStart('/')).ToString();
    private static string ResourceName(string value)=>value[(value.LastIndexOf('/')+1)..];private static string ShortId(Guid value)=>value.ToString("N")[..8];private static string ShortId(string? value)=>string.IsNullOrWhiteSpace(value)?"—":value.Length<=12?value:value[..12];
    private static string FormatContent(System.Text.Json.JsonElement value)=>value.ValueKind==System.Text.Json.JsonValueKind.String?value.GetString()??"":System.Text.Json.JsonSerializer.Serialize(value,new System.Text.Json.JsonSerializerOptions{WriteIndented=true});
    private static string FormatSize(long bytes)=>bytes<1024?$"{bytes} B":bytes<1024*1024?$"{bytes/1024d:F1} KB":$"{bytes/1024d/1024d:F1} MB";
    private static string Duration(WorkTaskOperationsSummary task){var end=task.CompletedAt??DateTimeOffset.UtcNow;var start=task.StartedAt??task.CreatedAt;return end<start?"—":$"{end-start:g}";}private static string RunDuration(WorkTaskFlowRunResponse run)=>run.StartedAt is null?"Not started":$"{(run.CompletedAt??DateTimeOffset.UtcNow)-run.StartedAt.Value:g}";
    public void Dispose(){Realtime.Updated-=OnRealtime;Realtime.StateChanged-=OnStateChanged;lifetime.Cancel();lifetime.Dispose();}
}
