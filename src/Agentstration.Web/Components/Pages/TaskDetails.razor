@page "/tasks/{TaskId:guid}"
@implements IDisposable
@inject IWorkApiClient Client
@inject IWorkOperationsRealtimeClient Realtime
@inject Microsoft.Extensions.Options.IOptions<AgentstrationWebOptions> Options
@inject ConsoleContextState ContextState
@inject Microsoft.Extensions.Localization.IStringLocalizer<TaskDetailsStrings> Localizer

<PageTitle>@T("PageTitle")</PageTitle>
@if (notFound)
{
    <EmptyState Title="@T("NotFoundTitle")" Message="@T("NotFoundMessage")"><a class="button-secondary" href="/tasks">@T("BackToTasks")</a></EmptyState>
}
else if (unavailable)
{
    <WorkApiUnavailableState OnRetry="LoadAsync" />
}
else if (detail is null)
{
    <LoadingState />
}
else
{
    var task=detail.Task;
    <PageHeader Title="@task.Title" Description="@F("OperationalWorkTask", ShortId(task.Id))">
        <Actions><RealtimeStatus State="Realtime.State" />@if(task.Status==WorkTaskStatus.Running){<button class="button-secondary" @onclick="PauseAsync">@T("Pause")</button>}@if(task.Status==WorkTaskStatus.Paused){<button class="button-primary" @onclick="ResumeAsync">@T("Resume")</button>}@if(task.Status is WorkTaskStatus.Pending or WorkTaskStatus.Running or WorkTaskStatus.ActionRequired or WorkTaskStatus.Paused){<button class="button-danger" @onclick="()=>confirmCancel=true">@T("Cancel")</button>}<a class="button-secondary" href="/tasks">@T("Back")</a></Actions>
    </PageHeader>
    @if(confirmCancel){<section class="panel task-error"><h2>@T("CancelTitle")</h2><p>@T("CancelMessage")</p><button class="button-danger" @onclick="CancelAsync">@T("ConfirmCancellation")</button><button class="button-secondary" @onclick="()=>confirmCancel=false">@T("KeepTask")</button></section>}
    @if(task.Error is not null){<section class="panel task-error"><h2>@task.Error.Title</h2><p><strong>@task.Error.Code</strong> · @task.Error.Message</p><time datetime="@task.Error.OccurredAt.ToString("O")">@task.Error.OccurredAt.ToLocalTime().ToString("F")</time></section>}
    <div class="task-detail-grid">
        <div class="task-detail-stack">
            <section class="panel"><div class="panel-header"><h2>@T("Overview")</h2><TaskStatusBadge Status="task.Status" /></div><dl class="resource-details"><dt>@T("OriginalRequest")</dt><dd>@OriginalRequest</dd><dt>@T("Origin")</dt><dd><code>@(task.EntryId is null ? T("Trigger") : ResourceName(task.EntryId))</code></dd><dt>@T("Workspace")</dt><dd>@ResourceName(task.WorkspaceId)</dd><dt>@T("Interaction")</dt><dd><code>@ShortId(task.InteractionId)</code></dd><dt>@T("CurrentActivity")</dt><dd>@(task.CurrentActivity??"—")</dd><dt>@T("Created")</dt><dd><time title="@task.CreatedAt.ToLocalTime().ToString("F")">@task.CreatedAt.ToLocalTime().ToString("g")</time></dd><dt>@T("Updated")</dt><dd><time title="@task.UpdatedAt.ToLocalTime().ToString("F")">@task.UpdatedAt.ToLocalTime().ToString("g")</time></dd><dt>@T("Duration")</dt><dd>@Duration(task)</dd></dl>@if(WorkplaceTaskUrl is not null){<a class="text-button" href="@WorkplaceTaskUrl" target="_blank">@T("OpenTaskInWorkplace") →</a>}</section>
            <section class="panel"><div class="panel-header"><h2>@T("Execution")</h2><span>@F("RunCount", detail.FlowRuns.Count)</span></div>@if(detail.FlowRuns.Count==0){<p>@T("FlowRunUnavailable")</p>}else{<ol class="operations-list">@foreach(var run in detail.FlowRuns){<li class="@(run.ParentFlowRunId is null?null:"flow-run-child")"><div class="panel-header"><strong><a href="/tasks/@TaskId/flowruns/@Uri.EscapeDataString(run.Id)">@ShortId(run.Id)</a></strong><StatusBadge Text="@Label("RunStatus", run.Status)" Status="@PlatformDashboardService.ToStatus(run.Status)" /></div><p>@Label("TriggerType", run.Trigger) · <code>@run.FlowId</code></p><small>@F("ResultCount", run.ResultCount) · @F("ArtifactCount", run.ArtifactCount) · @RunDuration(run)</small>@if(run.ParentFlowRunId is not null){<small class="table-secondary">@T("Parent") @ShortId(run.ParentFlowRunId)</small>}</li>}</ol>}</section>
            <section class="panel"><div class="panel-header"><h2>@T("Results")</h2><span>@detail.Results.Count</span></div>@if(detail.Results.Count==0){<p>@T("ResultsUnavailable")</p>}else{<ol class="operations-list">@foreach(var result in detail.Results.OrderByDescending(value=>value.Sequence)){<li><div class="panel-header"><strong>@result.Title @(result.Sequence==detail.Results.Max(value=>value.Sequence)?T("LatestSuffix"):null)</strong><span>@T("Version") @result.Sequence</span></div><small>@result.Kind · @result.CreatedAt.ToLocalTime().ToString("g") · FlowRun @ShortId(result.FlowRunId)</small><pre class="result-preview">@FormatContent(result.Content)</pre></li>}</ol>}</section>
            <section class="panel"><div class="panel-header"><h2>@T("Artifacts")</h2><span>@detail.Artifacts.Count</span></div>@if(detail.Artifacts.Count==0){<p>@T("ArtifactUnavailable")</p>}else{<ul class="operations-list">@foreach(var artifact in detail.Artifacts.OrderByDescending(value=>value.Sequence)){<li><strong>@artifact.Name</strong><p>@artifact.ContentType · @FormatSize(artifact.Length) · @T("Version") @artifact.Sequence</p><small>FlowRun @ShortId(artifact.FlowRunId) · @artifact.CreatedAt.ToLocalTime().ToString("g")</small><a class="text-button" href="@ArtifactUrl(artifact)" download>@T("Download")</a></li>}</ul>}</section>
        </div>
        <aside class="task-detail-stack">
            <section class="panel"><div class="panel-header"><h2>@T("PendingActions")</h2><span>@detail.PendingActions.Count(value=>value.Status==PendingActionStatus.Pending)</span></div>
                @if(!string.IsNullOrWhiteSpace(pendingActionError)){<p class="form-alert form-alert-danger" role="alert">@pendingActionError</p>}
                @if(detail.PendingActions.Count==0){<p>@T("NoPendingAction")</p>}else{@foreach(var action in detail.PendingActions){if(CanExecute && action.Status==PendingActionStatus.Pending && TaskPendingActionUi.ToAction(action) is { } workplaceAction){<Agentstration.Workplace.Components.PendingActionPanel Action="workplaceAction" Busy="@(respondingActionId==action.Id)" OnSubmit="RespondPendingActionAsync" />}else{<article class="task-resolved-action"><div class="panel-header"><strong>@action.Title</strong><StatusBadge Text="@Label("ActionStatus", action.Status)" Status="@PlatformDashboardService.ToStatus(action.Status.ToString())" /></div><p>@action.Kind @if(!string.IsNullOrWhiteSpace(action.Description)){<span>· @action.Description</span>}</p><small>@T("Created") @action.CreatedAt.ToLocalTime().ToString("g")</small>@if(action.Status==PendingActionStatus.Pending && !CanExecute){<p class="table-secondary">@T("ExecutePermissionRequired")</p>}</article>}}}
                @if(WorkplaceInteractionUrl is not null){<a class="text-button" href="@WorkplaceInteractionUrl" target="_blank">@T("OpenInteractionInWorkplace") →</a>}
            </section>
            <section class="panel"><div class="panel-header"><h2>@T("Interaction")</h2><span>@T("ReadOnly")</span></div><details><summary>@F("MessageCount", detail.Messages.Count)</summary><ol class="operations-list">@foreach(var message in detail.Messages){<li><strong>@Label("Role", message.Role)</strong><p>@message.Content</p><small>@message.CreatedAt.ToLocalTime().ToString("g")</small></li>}</ol></details></section>
            <section class="panel"><div class="panel-header"><h2>@T("Activity")</h2><span>@detail.Activities.Count</span></div>@if(detail.Activities.Count==0){<p>@T("NoFunctionalActivity")</p>}else{<ol class="operations-list">@foreach(var activity in detail.Activities.OrderByDescending(value=>value.CreatedAt)){<li><strong>@activity.Title</strong><p>@activity.Type @if(!string.IsNullOrWhiteSpace(activity.Description)){<span>· @activity.Description</span>}</p><time title="@activity.CreatedAt.ToLocalTime().ToString("F")">@activity.CreatedAt.ToLocalTime().ToString("g")</time></li>}</ol>}</section>
        </aside>
    </div>
}

@code {
    [Parameter] public Guid TaskId { get; set; }
    private readonly CancellationTokenSource lifetime=new();private WorkTaskOperationsDetailResponse? detail;private bool unavailable,notFound,confirmCancel,realtimeStarted;private Guid? respondingActionId;private string? pendingActionError;
    protected override async Task OnParametersSetAsync()=>await LoadAsync();
    private async Task LoadAsync(){unavailable=false;notFound=false;try{detail=await Client.GetTaskAsync(TaskId,lifetime.Token);if(!realtimeStarted){realtimeStarted=true;Realtime.Updated+=OnRealtime;Realtime.StateChanged+=OnStateChanged;await Realtime.StartAsync([detail.Task.WorkspaceId],lifetime.Token);}}catch(AgentstrationApiException exception) when(exception.StatusCode==System.Net.HttpStatusCode.NotFound){notFound=true;detail=null;}catch(Exception exception) when(exception is AgentstrationApiException or HttpRequestException or Polly.Timeout.TimeoutRejectedException){unavailable=true;detail=null;}}
    private Task OnRealtime(WorkOperationsRealtimeUpdate update)=>update.RequiresResynchronization||update.TaskId==TaskId?InvokeAsync(LoadAsync):Task.CompletedTask;private void OnStateChanged()=>InvokeAsync(StateHasChanged);
    private async Task PauseAsync(){await Client.PauseTaskAsync(TaskId,lifetime.Token);await LoadAsync();}private async Task ResumeAsync(){await Client.ResumeTaskAsync(TaskId,lifetime.Token);await LoadAsync();}private async Task CancelAsync(){confirmCancel=false;await Client.CancelTaskAsync(TaskId,lifetime.Token);await LoadAsync();}
    private async Task RespondPendingActionAsync(Agentstration.Workplace.Components.PendingActionAnswer answer){if(respondingActionId is not null)return;respondingActionId=answer.PendingActionId.Value;pendingActionError=null;try{await Client.RespondTaskPendingActionAsync(TaskId,answer.PendingActionId.Value,answer.Values,lifetime.Token);await LoadAsync();}catch(Exception exception){pendingActionError=exception.Message;}finally{respondingActionId=null;}}
    private bool CanExecute=>ContextState.HasPermission(AuthorizationPermissions.RunsExecute);
    private string T(string key)=>Localizer[key];private string F(string key,params object[] arguments)=>Localizer[key,arguments];private string Label(string prefix,object value){var raw=value.ToString()??string.Empty;var localized=Localizer[$"{prefix}.{raw}"];return localized.ResourceNotFound?raw:localized.Value;}
    private string OriginalRequest=>detail?.Interaction?.InputValues.TryGetValue("request",out var request)==true?(request.ValueKind==System.Text.Json.JsonValueKind.String?request.GetString()??"—":request.ToString()):detail?.Task.EntryId is null?T("ScheduledAutonomousWork"):"—";
    private string? WorkplaceTaskUrl=>WorkplaceUrl($"tasks/{TaskId}");private string? WorkplaceInteractionUrl=>detail?.Task.InteractionId is null?null:WorkplaceUrl($"?interaction={detail.Task.InteractionId}");
    private string? WorkplaceUrl(string relative)=>string.IsNullOrWhiteSpace(Options.Value.WorkplaceBaseUrl)?null:new Uri(new Uri(Options.Value.WorkplaceBaseUrl.EndsWith('/')?Options.Value.WorkplaceBaseUrl:$"{Options.Value.WorkplaceBaseUrl}/"),relative).ToString();
    private string ArtifactUrl(WorkTaskArtifactResponse value)=>new Uri(new Uri(Options.Value.WorkApi.BaseAddress),value.DownloadUrl.TrimStart('/')).ToString();
    private static string ResourceName(string value)=>value[(value.LastIndexOf('/')+1)..];private string ShortId(Guid? value)=>value is null?T("Autonomous"):value.Value.ToString("N")[..8];private static string ShortId(string? value)=>string.IsNullOrWhiteSpace(value)?"—":value.Length<=12?value:value[..12];
    private static string FormatContent(System.Text.Json.JsonElement value)=>value.ValueKind==System.Text.Json.JsonValueKind.String?value.GetString()??"":System.Text.Json.JsonSerializer.Serialize(value,new System.Text.Json.JsonSerializerOptions{WriteIndented=true});
    private static string FormatSize(long bytes)=>bytes<1024?$"{bytes} B":bytes<1024*1024?$"{bytes/1024d:F1} KB":$"{bytes/1024d/1024d:F1} MB";
    private static string Duration(WorkTaskOperationsSummary task){var end=task.CompletedAt??DateTimeOffset.UtcNow;var start=task.StartedAt??task.CreatedAt;return end<start?"—":$"{end-start:g}";}private string RunDuration(WorkTaskFlowRunResponse run)=>run.StartedAt is null?T("NotStarted"):$"{(run.CompletedAt??DateTimeOffset.UtcNow)-run.StartedAt.Value:g}";
    public void Dispose(){Realtime.Updated-=OnRealtime;Realtime.StateChanged-=OnStateChanged;lifetime.Cancel();lifetime.Dispose();}
}
