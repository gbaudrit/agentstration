@page "/flow-runs/{RunId}"
@implements IDisposable
@inject IFlowApiClient Client
@inject NavigationManager Navigation
@inject Agentstration.Web.Security.ConsoleRealtimeSession RealtimeSession
@inject ILogger<FlowRunDetails> Logger
@inject Microsoft.Extensions.Localization.IStringLocalizer<FlowRunDetailsStrings> Localizer

<PageTitle>@(run is null ? T("FlowRun") : run.Id) · Agentstration</PageTitle>
@if (notFound)
{
    <ErrorState Title="@T("NotFoundTitle")" Message="@T("NotFoundMessage")">
        <a class="button-secondary" href="/flow-runs">@T("BackToRuns")</a>
    </ErrorState>
}
else if (loadError is not null)
{
    <ErrorState Title="@T("UnableToLoad")" Message="@loadError.Message" ErrorId="@loadError.ErrorId" />
}
else if (run is null)
{
    <LoadingState Message="@T("Loading")" />
}
else
{
    <PageHeader Title="@T("FlowRun")" Description="@run.Id">
        <Actions>@if (!run.Status.IsTerminal()) { <button class="button-danger" @onclick="CancelAsync">@T("Cancel")</button> }<a class="button-secondary" href="/tool-governance/flow/@Uri.EscapeDataString(run.Id)">@T("ToolGovernance")</a><a class="button-secondary" href="@ConsoleResourceUrls.Flow(run.FlowId)">@T("FlowDefinition")</a></Actions>
    </PageHeader>
    <section class="run-summary">
        <div><span class="field-label">@T("Status")</span><StatusBadge Text="@StatusLabel(run.Status)" Status="@PlatformDashboardService.ToStatus(run.Status.ToString())" /></div>
        <div><span class="field-label">@T("FlowAndVersion")</span><strong>@run.FlowId.Value · @run.FlowVersion</strong></div>
        <div><span class="field-label">@T("Deployment")</span><strong>@(run.DeploymentResourceId ?? "—")</strong></div>
        <div><span class="field-label">@T("TriggerAndStartedBy")</span><strong>@TriggerLabel(run.Trigger) · @(run.StartedBy ?? "—")</strong></div>
        <div><span class="field-label">@T("CorrelationId")</span><code>@run.CorrelationId</code></div>
    </section>
    @if (run.Error is not null)
    {
        <article class="panel run-error"><strong>@run.Error.Code</strong><p>@run.Error.Message</p><code>@run.Error.Details</code></article>
    }
    @if (pendingInput is not null)
    {
        <article class="panel input-request-panel">
            <div class="panel-header"><h2>@T("InputNeeded")</h2><span>@T("WaitingForResponse")</span></div>
            <p>@pendingInput.Prompt</p>
            @if (pendingInput.Type == InputRequestType.Text)
            {
                <input @bind="responseText" placeholder="@T("ResponsePlaceholder")" disabled="@submittingInput" />
                <button class="button-primary" @onclick="SubmitTextAsync" disabled="@(submittingInput || string.IsNullOrWhiteSpace(responseText))">@T("SendResponse")</button>
            }
            else if (pendingInput.Type == InputRequestType.Choice)
            {
                <select @bind="selectedChoice" disabled="@submittingInput">
                    <option value="">@T("SelectOption")</option>
                    @foreach (var option in pendingInput.Options) { <option value="@option">@option</option> }
                </select>
                <button class="button-primary" @onclick="SubmitChoiceAsync" disabled="@(submittingInput || string.IsNullOrWhiteSpace(selectedChoice))">@T("Continue")</button>
            }
            else
            {
                <div class="button-row">
                    <button class="button-primary" @onclick="() => SubmitConfirmationAsync(true)" disabled="@submittingInput">@T("Confirm")</button>
                    <button class="button-secondary" @onclick="() => SubmitConfirmationAsync(false)" disabled="@submittingInput">@T("Decline")</button>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(inputError)) { <p class="validation-error">@inputError</p> }
        </article>
    }
    <FlowRunTimeline Events="eventBuffer.Snapshot()" IsLive="@(!run.Status.IsTerminal())" InferParticipantHandoffs="IsHandoffRun" />
    @if (realtimeError is not null)
    {
        <div class="panel realtime-warning" role="status"><span>@realtimeError</span><button class="button-secondary" @onclick="ConnectAsync">@T("RetryLiveUpdates")</button></div>
    }
    <section class="designer-layout run-layout @(inspectorVisible ? null : "inspector-collapsed")">
        <div>
            <FlowTopologyViewer Graph="Topology" SelectedKey="selected?.StepName" SelectedKeyChanged="SelectStep"
                                ShowInspectorControl="true" InspectorVisible="inspectorVisible" InspectorVisibleChanged="SetInspectorVisible" />
            <article class="panel io-panel"><div class="panel-header"><h2>@T("RunInputAndOutput")</h2></div><div class="io-grid"><div><span class="field-label">@T("Input")</span><pre>@Pretty(run.Input)</pre></div><div><span class="field-label">@T("Output")</span><pre>@Pretty(run.Output)</pre></div></div></article>
        </div>
        @if (inspectorVisible)
        {
        <article class="panel inspector step-inspector">
            <div class="panel-header"><h2>@T("StepDiagnostic")</h2></div>
            @if (selected is null)
            {
                <p class="muted">@T("SelectStep")</p>
            }
            else
            {
                <dl class="details-list"><dt>@T("Status")</dt><dd>@StepStatusLabel(selected.Status)</dd><dt>@T("Type")</dt><dd>@selected.StepType</dd><dt>@T("Duration")</dt><dd>@Duration(selected.StartedAt, selected.CompletedAt)</dd><dt>@T("Attempt")</dt><dd>@selected.Attempt</dd><dt>@T("Transition")</dt><dd>@(selected.SelectedTransition ?? "—")</dd><dt>@T("Agent")</dt><dd>@(selected.AgentResourceId ?? "—")</dd><dt>@T("AgentVersion")</dt><dd>@(selected.AgentVersion?.ToString() ?? "—")</dd><dt>@T("ModelProfile")</dt><dd>@(selected.ModelProfileResourceId ?? "—")</dd><dt>@T("Provider")</dt><dd>@(selected.Provider ?? "—")</dd><dt>@T("Tokens")</dt><dd>@TokenUsage(selected.Usage)</dd><dt>@T("Tools")</dt><dd>@(selected.Tools.Count == 0 ? "—" : string.Join(", ", selected.Tools))</dd></dl>
                <span class="field-label">@T("DeclaredInput")</span><pre>@Pretty(selected.DeclaredInput)</pre><span class="field-label">@T("ResolvedInput")</span><pre>@Pretty(selected.ResolvedInput)</pre><span class="field-label">@T("Output")</span><pre>@Pretty(selected.Output)</pre><span class="field-label">@T("Logs")</span><pre>@string.Join(Environment.NewLine, selected.Logs)</pre>
                @if (selected.Error is not null) { <div class="error-panel"><strong>@selected.Error.Code</strong><p>@selected.Error.Message</p></div> }
            }
        </article>
        }
    </section>
}

@code {
    [Parameter] public string RunId { get; set; } = string.Empty;
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string StatusLabel(FlowRunStatus value) => Localizer[$"Status.{value}"];
    private string TriggerLabel(FlowRunTrigger value) => Localizer[$"Trigger.{value}"];
    private string StepStatusLabel(FlowStepRunStatus value) => Localizer[$"StepStatus.{value}"];
    private string TokenUsage(FlowStepRunUsage? usage) => usage is null ? "—" : T("TokenUsage", usage.InputTokens ?? 0, usage.OutputTokens ?? 0);
    private readonly CancellationTokenSource cancellation = new();
    private readonly FlowRunEventBuffer eventBuffer = new();
    private FlowRun? run;
    private InputRequest? pendingInput;
    private FlowStepRun? selected;
    private Microsoft.AspNetCore.SignalR.Client.HubConnection? hub;
    private AgentstrationApiException? loadError;
    private bool notFound;
    private string? realtimeError;
    private bool IsHandoffRun => run?.DefinitionSnapshot.Definition is OrchestrationFlowDefinition { Pattern: HandoffOrchestrationPattern };
    private int streamingRenderScheduled;
    private string responseText = string.Empty;
    private string selectedChoice = string.Empty;
    private string? inputError;
    private bool submittingInput;
    private bool inspectorVisible;
    private FlowTopologyGraph Topology => run is null ? new([], [], "horizontal", T("FlowTopology")) : FlowTopologyProjector.Project(run, eventBuffer.Snapshot());

    protected override async Task OnParametersSetAsync()
    {
        notFound = false;
        loadError = null;
        realtimeError = null;
        try
        {
            run = await Client.GetFlowRunAsync(RunId, cancellation.Token);
        }
        catch (AgentstrationApiException exception) when (exception.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            run = null;
            notFound = true;
            return;
        }
        catch (AgentstrationApiException exception)
        {
            run = null;
            loadError = exception;
            return;
        }
        await RefreshInputAsync();
        selected = run.Steps.FirstOrDefault();
        eventBuffer.Clear();
        await ReplayAsync();
        if (!run.Status.IsTerminal()) await ConnectAsync();
    }

    private async Task ConnectAsync()
    {
        if (hub is not null) await hub.DisposeAsync();
        var endpoint = Navigation.ToAbsoluteUri("/hubs/flow-runs");
        hub = new Microsoft.AspNetCore.SignalR.Client.HubConnectionBuilder()
            .WithUrl(endpoint, options => RealtimeSession.Configure(endpoint, options))
            .WithAutomaticReconnect()
            .Build();
        hub.On<FlowRunEvent>("FlowRunEvent", ApplyEventAsync);
        hub.Reconnected += async _ => await SubscribeAndReplayAsync();
        try
        {
            await hub.StartAsync(cancellation.Token);
            await SubscribeAndReplayAsync();
            realtimeError = null;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Flow Run live updates are unavailable for {FlowRunId}", RunId);
            realtimeError = T("LiveUpdatesUnavailable");
            await hub.DisposeAsync();
            hub = null;
            await ReplayAsync();
        }
    }

    private async Task SubscribeAndReplayAsync()
    {
        await hub!.InvokeAsync("SubscribeAsync", RunId, cancellation.Token);
        await ReplayAsync();
    }

    private async Task ReplayAsync()
    {
        var replay = await Client.GetFlowRunEventsAsync(RunId, eventBuffer.LastSequence, cancellation.Token);
        foreach (var runEvent in replay) AddEvent(runEvent);
        if (replay.Count > 0) await RefreshRunAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ApplyEventAsync(FlowRunEvent runEvent)
    {
        if (!AddEvent(runEvent)) return;
        if (runEvent.Type == FlowRunEventType.StepOutputDelta)
        {
            ScheduleStreamingRender();
            return;
        }
        await RefreshRunAsync();
        await InvokeAsync(StateHasChanged);
    }

    private bool AddEvent(FlowRunEvent runEvent)
    {
        return eventBuffer.TryAdd(runEvent);
    }

    private async Task RefreshRunAsync()
    {
        run = await Client.GetFlowRunAsync(RunId, cancellation.Token);
        await RefreshInputAsync();
        if (selected is not null) selected = run.Steps.FirstOrDefault(value => value.StepName == selected.StepName);
    }

    private async Task RefreshInputAsync()
    {
        pendingInput = run?.Status == FlowRunStatus.WaitingForInput
            ? (await Client.GetFlowRunInputsAsync(RunId, cancellation.Token)).FirstOrDefault()
            : null;
    }

    private Task SubmitTextAsync() => SubmitInputAsync(JsonSerializer.SerializeToElement(responseText));
    private Task SubmitChoiceAsync() => SubmitInputAsync(JsonSerializer.SerializeToElement(selectedChoice));
    private Task SubmitConfirmationAsync(bool value) => SubmitInputAsync(JsonSerializer.SerializeToElement(value));

    private async Task SubmitInputAsync(JsonElement value)
    {
        if (pendingInput is null) return;
        try
        {
            submittingInput = true;
            inputError = null;
            await Client.RespondToFlowRunInputAsync(RunId, pendingInput.Id, value, cancellation.Token);
            pendingInput = null;
            await RefreshRunAsync();
        }
        catch (Exception exception) { inputError = exception.Message; }
        finally { submittingInput = false; }
    }

    private void ScheduleStreamingRender()
    {
        if (Interlocked.Exchange(ref streamingRenderScheduled, 1) != 0) return;
        _ = FlushStreamingRenderAsync();
    }

    private async Task FlushStreamingRenderAsync()
    {
        var renderedSequence = eventBuffer.LastSequence;
        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(150), cancellation.Token);
            renderedSequence = eventBuffer.LastSequence;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        finally
        {
            Volatile.Write(ref streamingRenderScheduled, 0);
            if (!cancellation.IsCancellationRequested && eventBuffer.LastSequence > renderedSequence) ScheduleStreamingRender();
        }
    }

    private void SelectStep(string name) => selected = run?.Steps.FirstOrDefault(value => value.StepName == name);
    private void SetInspectorVisible(bool value) => inspectorVisible = value;
    private async Task CancelAsync() => run = await Client.CancelFlowRunAsync(RunId, cancellation.Token);
    private static string Pretty(JsonElement value) => JsonSerializer.Serialize(value, new JsonSerializerOptions { WriteIndented = true });
    private static string Pretty(JsonElement? value) => value is null ? "—" : Pretty(value.Value);
    private static string Duration(DateTimeOffset? start, DateTimeOffset? end) { if (start is null) return "—"; var value = (end ?? DateTimeOffset.UtcNow) - start.Value; return value.TotalSeconds >= 1 ? $"{value.TotalSeconds:0.##} s" : $"{value.TotalMilliseconds:0} ms"; }

    public void Dispose()
    {
        cancellation.Cancel();
        if (hub is not null) _ = hub.DisposeAsync();
        cancellation.Dispose();
    }
}
