@page "/settings/organization"
@inject Agentstration.Management.Core.IdentityAdministrationService Service
@inject Microsoft.Extensions.Localization.IStringLocalizer<OrganizationStrings> Localizer

<PageTitle>@T("Organization") · Agentstration</PageTitle>
<PageHeader Title="@T("Organization")" Description="@T("Organization.Description")" />
<OrganizationSettingsNav />

@if (view is null)
{
    <LoadingState Message="@T("LoadingOrganization")" />
}
else
{
    <section class="dashboard-grid">
        <article class="panel">
            <div class="panel-header"><h2>@view.Tenant.DisplayName</h2><StatusBadge Text="@T($"Status.{view.Tenant.Status}")" Status="UiStatus.Success" /></div>
            <p><strong>@T("TechnicalName"):</strong> @view.Tenant.Name</p>
            <p><strong>@T("TenantId"):</strong> <code>@view.Tenant.Id</code></p>
            <p><strong>@T("Created"):</strong> <time datetime="@view.Tenant.CreatedAt.ToString("O")">@view.Tenant.CreatedAt.ToLocalTime().ToString("g")</time></p>
        </article>
        <article class="panel">
            <div class="panel-header"><h2>@T("Workspaces")</h2></div>
            @foreach (var workspace in view.Workspaces)
            {
                <p><strong>@workspace.DisplayName</strong><br /><small>@workspace.Name · @workspace.Id</small></p>
            }
        </article>
    </section>
    <section class="panel">
        <div class="panel-header"><h2>@T("MembersAndRoles")</h2></div>
        @foreach (var member in view.Members)
        {
            <article>
                <p><strong>@member.Principal.DisplayName</strong> <StatusBadge Text="@T($"Status.{member.Membership.Status}")" Status="UiStatus.Success" /></p>
                @foreach (var role in member.Roles)
                {
                    <p><span>@role.Role.DisplayName</span><br /><small>@role.Scope</small></p>
                }
            </article>
        }
    </section>
}

@code {
    private Agentstration.Management.Core.TenantAdministrationView? view;
    private string T(string key) => Localizer[key].Value;
    protected override async Task OnInitializedAsync() => view = await Service.GetCurrentAsync(CancellationToken.None);
}
