@page "/settings/bootstrap"
@implements IDisposable
@inject BootstrapProfileManagementService Service
@inject ICurrentRequestContext RequestContext
@inject Microsoft.Extensions.Localization.IStringLocalizer<BootstrapProfilesStrings> Localizer

<PageTitle>@T("PageTitle")</PageTitle>
<PageHeader Title="@T("Title")" Description="@T("Description")">
    <Actions><button class="button-secondary" disabled="@busy" @onclick="LoadAsync">@T("RefreshCatalog")</button></Actions>
</PageHeader>

@if (denied)
{
    <ErrorState Title="@T("PlatformAdministratorRequired")" Message="@T("PlatformAdministratorRequiredMessage")" />
}
else if (error is not null)
{
    <ErrorState Message="@error"><button class="button-secondary" @onclick="LoadAsync">@T("Retry")</button></ErrorState>
}
else if (view is null)
{
    <LoadingState Message="@T("LoadingCatalog")" />
}
else
{
    <section class="metric-grid bootstrap-metrics" aria-label="@T("CatalogStatus")">
        <MetricCard Label="@T("Profiles")" Value="@view.Catalog.Profiles.Count.ToString()" Detail="@T("CatalogDirectories")" Status="UiStatus.Info" />
        <MetricCard Label="@T("InitialBootstrap")" Value="@(view.Catalog.InitialBootstrapEnabled ? T("Enabled") : T("Disabled"))" Detail="@T("StartupApplicationOnly")" Status="@(view.Catalog.InitialBootstrapEnabled ? UiStatus.Success : UiStatus.Neutral)" />
        <MetricCard Label="@T("InitialProfiles")" Value="@view.Catalog.InitialProfiles.Count.ToString()" Detail="@InitialProfilesLabel" Status="UiStatus.Info" />
        <MetricCard Label="@T("Applications")" Value="@view.Applications.Count.ToString()" Detail="@T("LatestRetainedRuns")" Status="@(view.Applications.Any(item => item.Definition.Status is BootstrapApplicationStatus.Failed or BootstrapApplicationStatus.PartiallyApplied or BootstrapApplicationStatus.Interrupted) ? UiStatus.Warning : UiStatus.Success)" />
    </section>

    <section class="panel bootstrap-config">
        <div class="panel-header"><div><p class="eyebrow">@T("ServerCatalog")</p><h2>@T("Configuration")</h2></div></div>
        <dl class="resource-details"><dt>@T("Path")</dt><dd><code>@(view.Catalog.Path ?? T("NotConfigured"))</code></dd><dt>@T("Startup")</dt><dd>@(view.Catalog.InitialBootstrapEnabled ? T("Enabled") : T("Disabled"))</dd><dt>@T("InitialOrder")</dt><dd>@InitialProfilesLabel</dd></dl>
        @if (view.Catalog.Error is not null) { <p class="error-panel">@view.Catalog.Error</p> }
    </section>

    <section class="panel">
        <div class="panel-header"><div><p class="eyebrow">@T("Step", 1)</p><h2>@T("SelectProfiles")</h2><p class="muted">@T("SelectProfilesDescription")</p></div></div>
        @if (view.Catalog.Profiles.Count == 0)
        {
            <EmptyState Title="@T("NoBootstrapProfile")" Message="@T("NoBootstrapProfileMessage")" />
        }
        else
        {
            <div class="bootstrap-profile-grid">
                @foreach (var profile in view.Catalog.Profiles)
                {
                    <label class="bootstrap-profile-card @(selectedProfiles.Contains(profile.Name) ? "selected" : null) @(profile.Valid ? null : "invalid")">
                        <input type="checkbox" checked="@selectedProfiles.Contains(profile.Name)" disabled="@(!CanSelect(profile))" @onchange="args => ToggleProfile(profile, args)" />
                        <span><strong>@profile.DisplayName</strong><small><code>@profile.Name</code> · @ScopeLabel(profile.Scope) · @T("ResourceCount", profile.ResourceCount)</small>@if (profile.Description is not null) { <span>@profile.Description</span> }@if (!profile.Valid) { <span class="inline-warning">@profile.Error</span> }</span>
                    </label>
                }
            </div>
        }
        @if (selectedProfiles.Count > 0)
        {
            <ol class="bootstrap-order">
                @for (var index = 0; index < selectedProfiles.Count; index++)
                {
                    var selectedIndex = index;
                    <li><code>@selectedProfiles[index]</code><span><button class="text-button" disabled="@(index == 0)" @onclick="() => Move(selectedIndex, -1)">@T("Up")</button><button class="text-button" disabled="@(index == selectedProfiles.Count - 1)" @onclick="() => Move(selectedIndex, 1)">@T("Down")</button></span></li>
                }
            </ol>
        }
    </section>

    @if (SelectedScope is BootstrapProfileScope.Tenant or BootstrapProfileScope.Workspace)
    {
        <section class="panel">
            <div class="panel-header"><div><p class="eyebrow">@T("Step", 2)</p><h2>@T("ChooseTarget")</h2></div></div>
            @if (SelectedScope == BootstrapProfileScope.Tenant)
            {
                <label class="bootstrap-target"><span>@T("Tenant")</span><select value="@selectedTenantId" @onchange="SelectTenant"><option value="">@T("SelectTenant")</option>@foreach (var tenant in view.Tenants) { <option value="@tenant.Id">@tenant.DisplayName — @tenant.Name</option> }</select></label>
            }
            else
            {
                <label class="bootstrap-target"><span>@T("Workspace")</span><select value="@selectedWorkspaceId" @onchange="SelectWorkspace"><option value="">@T("SelectWorkspace")</option>@foreach (var workspace in view.Workspaces) { <option value="@workspace.WorkspaceId">@workspace.TenantDisplayName / @workspace.WorkspaceDisplayName — @workspace.TenantName/@workspace.WorkspaceName</option> }</select></label>
            }
        </section>
    }

    @if (SelectedBindings.Count > 0)
    {
        <section class="panel">
            <div class="panel-header"><div><p class="eyebrow">@T("Step", 3)</p><h2>@T("ResolveBindings")</h2><p class="muted">@T("ResolveBindingsDescription")</p></div></div>
            <div class="bootstrap-binding-grid">
                @foreach (var item in SelectedBindings)
                {
                    var key = BindingKey(item.Profile, item.Binding.Name);
                    var input = bindingTargets[key];
                    var options = bindingOptions.GetValueOrDefault(item.Binding.TargetKind) ?? [];
                    <fieldset class="bootstrap-binding">
                        <legend>@item.Binding.DisplayName</legend>
                        <p><code>@item.Profile/@item.Binding.Name</code> · @BindingTargetKindLabel(item.Binding.TargetKind)@if (item.Binding.Required) { <span> · @T("Required")</span> }</p>
                        @if (item.Binding.Description is not null) { <p class="muted">@item.Binding.Description</p> }
                        <label><span>@T("Resource")</span><select value="@BindingTargetValue(input)" disabled="@(selectedWorkspaceId is null || busy)" @onchange="args => UpdateBindingTarget(key, args)"><option value="">@T("SelectCompatibleResource")</option>@foreach (var option in options) { <option value="@BindingTargetValue(option)">@option.DisplayName — @option.Namespace/@option.Name@(option.Planned ? $" ({T("Planned")})" : null)</option> }</select></label>
                        @if (selectedWorkspaceId is not null && options.Count == 0) { <p class="inline-warning">@T("NoCompatibleResource", BindingTargetKindLabel(item.Binding.TargetKind))</p> }
                    </fieldset>
                }
            </div>
        </section>
    }

    <section class="panel">
        <div class="panel-header"><div><p class="eyebrow">@T("Step", PreviewStep)</p><h2>@T("Preview")</h2><p class="muted">@T("PreviewDescription")</p></div><button class="button-primary" disabled="@(!CanPreview || busy)" @onclick="PreviewAsync">@(previewing ? T("Previewing") : T("PreviewApplication"))</button></div>
        @if (preview is not null)
        {
            <div class="bootstrap-preview-summary"><StatusBadge Text="@(preview.CanApply ? T("Ready") : T("Invalid"))" Status="@(preview.CanApply ? UiStatus.Success : UiStatus.Danger)" /><span><code>@preview.Digest[..12]</code></span><span>@T("ResourceCount", preview.Resources.Count)</span></div>
            <DataGrid TItem="BootstrapResourcePreview" Items="preview.Resources">
                <Header><tr><th>@T("Profile")</th><th>@T("Resource")</th><th>@T("ExpectedAction")</th><th>@T("Details")</th></tr></Header>
                <Row Context="item"><tr><td><code>@item.Profile</code></td><td><strong>@item.Kind/@item.Name</strong><br /><small>@item.Location</small></td><td><StatusBadge Text="@DispositionLabel(item.Disposition)" Status="@DispositionTone(item.Disposition)" /></td><td>@if (item.Message is not null) { <span class="inline-warning">@item.Message</span> }@if (item.Details is { Count: > 0 }) { <ul class="bootstrap-detail-list">@foreach (var detail in item.Details) { <li><span>@detail.Kind/@detail.Name</span><StatusBadge Text="@DispositionLabel(detail.Disposition)" Status="@DispositionTone(detail.Disposition)" /><small>@detail.Description</small></li> }</ul> }</td></tr></Row>
            </DataGrid>
            <div class="bootstrap-apply"><p>@T("ApplyDescription")</p><button class="button-primary" disabled="@(!preview.CanApply || busy)" @onclick="() => confirmApply = true">@T("ApplyPreview")</button></div>
        }
    </section>

    @if (lastApplication is not null)
    {
        <section class="panel">
            <div class="panel-header"><div><p class="eyebrow">@T("LatestResult")</p><h2>@ApplicationStatusLabel(lastApplication.Definition.Status)</h2></div><StatusBadge Text="@ApplicationStatusLabel(lastApplication.Definition.Status)" Status="@ApplicationTone(lastApplication.Definition.Status)" /></div>
            <div class="bootstrap-preview-summary"><span>@T("CreatedCount", Count(lastApplication, BootstrapResourceDisposition.Create))</span><span>@T("SkippedCount", Count(lastApplication, BootstrapResourceDisposition.Skip))</span><span>@T("ConflictsCount", Count(lastApplication, BootstrapResourceDisposition.Conflict))</span><span>@T("FailedCount", Count(lastApplication, BootstrapResourceDisposition.Failed))</span></div>
        </section>
    }

    <section class="panel">
        <div class="panel-header"><div><p class="eyebrow">@T("AuditTrail")</p><h2>@T("ApplicationHistory")</h2></div></div>
        @if (view.Applications.Count == 0) { <EmptyState Title="@T("NoManualApplication")" Message="@T("NoManualApplicationMessage")" /> }
        else
        {
            <DataGrid TItem="BootstrapApplicationResource" Items="view.Applications">
                <Header><tr><th>@T("Started")</th><th>@T("Profiles")</th><th>@T("Target")</th><th>@T("Status")</th><th>@T("Results")</th><th></th></tr></Header>
                <Row Context="application"><tr><td>@application.Definition.StartedAt.ToLocalTime().ToString("g")</td><td>@string.Join(" → ", application.Definition.Profiles)</td><td>@TargetLabel(application.Definition.Target)</td><td><StatusBadge Text="@ApplicationStatusLabel(application.Definition.Status)" Status="@ApplicationTone(application.Definition.Status)" /></td><td>@application.Definition.Resources.Count</td><td><button class="text-button" disabled="@busy" @onclick="() => ShowApplicationAsync(application.Metadata.Name)">@T("View")</button></td></tr></Row>
            </DataGrid>
        }
    </section>

    @if (selectedApplication is not null)
    {
        <section class="panel" id="bootstrap-application-detail">
            <div class="panel-header"><div><p class="eyebrow">@T("ApplicationDetail")</p><h2>@selectedApplication.Metadata.Name</h2></div><StatusBadge Text="@ApplicationStatusLabel(selectedApplication.Definition.Status)" Status="@ApplicationTone(selectedApplication.Definition.Status)" /></div>
            <dl class="resource-details">
                <dt>@T("Actor")</dt><dd><code>@selectedApplication.Definition.ActorPrincipalId</code></dd>
                <dt>@T("Source")</dt><dd>@selectedApplication.Definition.Source</dd>
                <dt>@T("Target")</dt><dd>@TargetLabel(selectedApplication.Definition.Target)</dd>
                <dt>@T("Profiles")</dt><dd>@string.Join(" → ", selectedApplication.Definition.Profiles)</dd>
                <dt>@T("Bindings")</dt><dd>@(selectedApplication.Definition.Bindings.Count == 0 ? T("None") : string.Join(", ", selectedApplication.Definition.Bindings.Select(BindingLabel)))</dd>
                <dt>@T("Digest")</dt><dd><code>@selectedApplication.Definition.Digest</code></dd>
                <dt>@T("Started")</dt><dd>@selectedApplication.Definition.StartedAt.ToLocalTime().ToString("G")</dd>
                <dt>@T("Completed")</dt><dd>@(selectedApplication.Definition.CompletedAt?.ToLocalTime().ToString("G") ?? T("NotCompleted"))</dd>
            </dl>
            @if (selectedApplication.Definition.Error is not null) { <p class="error-panel">@selectedApplication.Definition.Error</p> }
            @if (selectedApplication.Definition.Resources.Count == 0)
            {
                <EmptyState Title="@T("NoResourceOutcome")" Message="@T("NoResourceOutcomeMessage")" />
            }
            else
            {
                <DataGrid TItem="BootstrapAppliedResource" Items="selectedApplication.Definition.Resources">
                    <Header><tr><th>@T("Profile")</th><th>@T("Resource")</th><th>@T("Outcome")</th><th>@T("Message")</th></tr></Header>
                    <Row Context="item"><tr><td><code>@item.Profile</code></td><td><strong>@item.Kind/@item.Name</strong><br /><small>@item.Location</small></td><td><StatusBadge Text="@DispositionLabel(item.Disposition)" Status="@DispositionTone(item.Disposition)" /></td><td>@item.Message</td></tr></Row>
                </DataGrid>
            }
        </section>
    }
}

@if (confirmApply && preview is not null)
{
    <div class="dialog-backdrop" role="presentation">
        <section class="dialog" role="dialog" aria-modal="true" aria-labelledby="bootstrap-confirm-title">
            <h2 id="bootstrap-confirm-title">@T("ApplyBootstrapProfiles")</h2>
            <p>@T("ApplyConfirmation")</p>
            <p><strong>@string.Join(" → ", selectedProfiles)</strong><br />@CurrentTargetLabel</p>
            <div class="dialog-actions"><button class="button-secondary" disabled="@applying" @onclick="() => confirmApply = false">@T("Cancel")</button><button class="button-primary" disabled="@applying" @onclick="ApplyAsync">@(applying ? T("Applying") : T("ApplyProfiles"))</button></div>
        </section>
    </div>
}

@code {
    private readonly CancellationTokenSource lifetime = new();
    private BootstrapManagementView? view;
    private BootstrapCompositionPreview? preview;
    private BootstrapApplicationResource? lastApplication;
    private BootstrapApplicationResource? selectedApplication;
    private readonly List<string> selectedProfiles = [];
    private readonly Dictionary<string, BindingInput> bindingTargets = new(StringComparer.Ordinal);
    private readonly Dictionary<BootstrapBindingTargetKind, IReadOnlyList<BootstrapBindingTargetOption>> bindingOptions = [];
    private Guid? selectedTenantId;
    private Guid? selectedWorkspaceId;
    private string? error;
    private bool denied;
    private bool busy;
    private bool previewing;
    private bool applying;
    private bool confirmApply;

    private BootstrapProfileScope? SelectedScope => selectedProfiles.Count == 0 ? null : view?.Catalog.Profiles.First(profile => profile.Name == selectedProfiles[0]).Scope;
    private IReadOnlyList<(string Profile, BootstrapProfileBinding Binding)> SelectedBindings => view is null ? [] : selectedProfiles
        .SelectMany(profile => view.Catalog.Profiles.First(value => value.Name == profile).Bindings.Select(binding => (profile, binding))).ToArray();
    private bool CanPreview => selectedProfiles.Count > 0
        && (SelectedScope switch { BootstrapProfileScope.Tenant => selectedTenantId is not null, BootstrapProfileScope.Workspace => selectedWorkspaceId is not null, _ => true })
        && SelectedBindings.All(item => !item.Binding.Required || !string.IsNullOrWhiteSpace(bindingTargets[BindingKey(item.Profile, item.Binding.Name)].Name));
    private int PreviewStep => 2 + (SelectedScope is BootstrapProfileScope.Tenant or BootstrapProfileScope.Workspace ? 1 : 0) + (SelectedBindings.Count > 0 ? 1 : 0);
    private string InitialProfilesLabel => view is null || view.Catalog.InitialProfiles.Count == 0 ? T("None") : string.Join(" → ", view.Catalog.InitialProfiles);
    private string CurrentTargetLabel => SelectedScope switch { BootstrapProfileScope.Instance => T("Instance"), BootstrapProfileScope.Tenant => view?.Tenants.FirstOrDefault(value => value.Id == selectedTenantId)?.DisplayName ?? T("TenantNotSelected"), BootstrapProfileScope.Workspace => view?.Workspaces.FirstOrDefault(value => value.WorkspaceId == selectedWorkspaceId) is { } workspace ? $"{workspace.TenantDisplayName} / {workspace.WorkspaceDisplayName}" : T("WorkspaceNotSelected"), _ => T("NoTarget") };

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        busy = true; error = null;
        try { view = await Service.GetAsync(RequestContext.Current.PrincipalId, lifetime.Token); }
        catch (AuthorizationDeniedException) { denied = true; }
        catch (Exception exception) when (exception is not OperationCanceledException) { error = exception.Message; }
        finally { busy = false; }
    }

    private bool CanSelect(BootstrapProfileSummary profile) => profile.Valid && (SelectedScope is null || selectedProfiles.Contains(profile.Name) || profile.Scope == SelectedScope);
    private void ToggleProfile(BootstrapProfileSummary profile, ChangeEventArgs args)
    {
        if (args.Value is true) selectedProfiles.Add(profile.Name); else selectedProfiles.Remove(profile.Name);
        SyncBindings(); bindingOptions.Clear(); preview = null; lastApplication = null; selectedTenantId = null; selectedWorkspaceId = null;
    }
    private void Move(int index, int offset) { var item = selectedProfiles[index]; selectedProfiles.RemoveAt(index); selectedProfiles.Insert(index + offset, item); preview = null; }
    private void SelectTenant(ChangeEventArgs args) { selectedTenantId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : null; preview = null; }
    private async Task SelectWorkspace(ChangeEventArgs args)
    {
        selectedWorkspaceId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : null;
        selectedTenantId = view?.Workspaces.FirstOrDefault(value => value.WorkspaceId == selectedWorkspaceId)?.TenantId;
        preview = null; error = null; bindingOptions.Clear();
        if (selectedWorkspaceId is null) return;
        busy = true;
        try
        {
            foreach (var kind in SelectedBindings.Select(item => item.Binding.TargetKind).Distinct())
                bindingOptions[kind] = await Service.GetBindingTargetsAsync(
                    Target(),
                    kind,
                    selectedProfiles,
                    RequestContext.Current.PrincipalId,
                    lifetime.Token);
            foreach (var item in SelectedBindings)
            {
                var input = bindingTargets[BindingKey(item.Profile, item.Binding.Name)];
                if (string.IsNullOrWhiteSpace(input.Name)) continue;
                var available = bindingOptions[item.Binding.TargetKind].Any(option =>
                    string.Equals(option.Name, input.Name, StringComparison.Ordinal)
                    && string.Equals(option.Namespace, input.Namespace, StringComparison.Ordinal));
                if (!available) { input.Name = string.Empty; input.Namespace = "default"; }
            }
        }
        catch (Exception exception) when (exception is not OperationCanceledException) { error = exception.Message; }
        finally { busy = false; }
    }
    private BootstrapApplicationTarget? Target() => SelectedScope switch { BootstrapProfileScope.Tenant => new(selectedTenantId), BootstrapProfileScope.Workspace => new(selectedTenantId, selectedWorkspaceId), _ => null };
    private IReadOnlyList<BootstrapBindingSelection> Bindings() => SelectedBindings
        .Where(item => !string.IsNullOrWhiteSpace(bindingTargets[BindingKey(item.Profile, item.Binding.Name)].Name))
        .Select(item =>
        {
            var input = bindingTargets[BindingKey(item.Profile, item.Binding.Name)];
            return new BootstrapBindingSelection(item.Profile, item.Binding.Name, new(input.Name.Trim(), @namespace: new(string.IsNullOrWhiteSpace(input.Namespace) ? "default" : input.Namespace.Trim())));
        }).ToArray();

    private async Task PreviewAsync()
    {
        if (!CanPreview) return;
        busy = previewing = true; error = null; lastApplication = null;
        try { preview = await Service.PreviewAsync(new(selectedProfiles.ToArray(), Target(), Bindings()), RequestContext.Current.PrincipalId, lifetime.Token); }
        catch (Exception exception) when (exception is not OperationCanceledException) { error = exception.Message; }
        finally { busy = previewing = false; }
    }

    private async Task ApplyAsync()
    {
        if (preview is null) return;
        busy = applying = true; error = null;
        try
        {
            lastApplication = await Service.ApplyAsync(new(selectedProfiles.ToArray(), Target(), Bindings()), preview.Digest, RequestContext.Current.PrincipalId, lifetime.Token);
            selectedApplication = lastApplication;
            confirmApply = false; preview = null;
            view = await Service.GetAsync(RequestContext.Current.PrincipalId, lifetime.Token);
        }
        catch (Exception exception) when (exception is not OperationCanceledException) { error = exception.Message; confirmApply = false; }
        finally { busy = applying = false; }
    }

    private async Task ShowApplicationAsync(string applicationId)
    {
        busy = true; error = null;
        try { selectedApplication = await Service.GetApplicationAsync(applicationId, RequestContext.Current.PrincipalId, lifetime.Token); }
        catch (Exception exception) when (exception is not OperationCanceledException) { error = exception.Message; }
        finally { busy = false; }
    }

    private string TargetLabel(BootstrapApplicationTarget? target)
    {
        if (target?.WorkspaceId is { } workspaceId && view?.Workspaces.FirstOrDefault(value => value.WorkspaceId == workspaceId) is { } workspace) return $"{workspace.TenantDisplayName} / {workspace.WorkspaceDisplayName}";
        if (target?.TenantId is { } tenantId && view?.Tenants.FirstOrDefault(value => value.Id == tenantId) is { } tenant) return tenant.DisplayName;
        return T("Instance");
    }
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    private string ScopeLabel(BootstrapProfileScope scope) => T($"Scope.{scope}");
    private string BindingTargetKindLabel(BootstrapBindingTargetKind kind) => T($"BindingTargetKind.{kind}");
    private string DispositionLabel(BootstrapResourceDisposition disposition) => T($"Disposition.{disposition}");
    private string ApplicationStatusLabel(BootstrapApplicationStatus status) => T($"ApplicationStatus.{status}");
    private static int Count(BootstrapApplicationResource application, BootstrapResourceDisposition disposition) => application.Definition.Resources.Count(value => value.Disposition == disposition);
    private static UiStatus DispositionTone(BootstrapResourceDisposition disposition) => disposition switch { BootstrapResourceDisposition.Create => UiStatus.Success, BootstrapResourceDisposition.Skip => UiStatus.Neutral, BootstrapResourceDisposition.Conflict => UiStatus.Warning, _ => UiStatus.Danger };
    private static UiStatus ApplicationTone(BootstrapApplicationStatus status) => status switch { BootstrapApplicationStatus.Succeeded => UiStatus.Success, BootstrapApplicationStatus.PartiallyApplied or BootstrapApplicationStatus.Interrupted => UiStatus.Warning, BootstrapApplicationStatus.Running => UiStatus.Info, _ => UiStatus.Danger };
    private void SyncBindings()
    {
        var active = SelectedBindings.Select(item => BindingKey(item.Profile, item.Binding.Name)).ToHashSet(StringComparer.Ordinal);
        foreach (var key in bindingTargets.Keys.Where(key => !active.Contains(key)).ToArray()) bindingTargets.Remove(key);
        foreach (var item in SelectedBindings)
        {
            var key = BindingKey(item.Profile, item.Binding.Name);
            if (!bindingTargets.ContainsKey(key))
                bindingTargets[key] = new(item.Binding.DefaultTarget?.Name ?? string.Empty, item.Binding.DefaultTarget?.Namespace?.Value ?? "default");
        }
    }
    private void UpdateBindingTarget(string key, ChangeEventArgs args)
    {
        var parts = (args.Value?.ToString() ?? string.Empty).Split('\n', 2);
        bindingTargets[key].Namespace = parts.Length == 2 ? parts[0] : "default";
        bindingTargets[key].Name = parts.Length == 2 ? parts[1] : string.Empty;
        preview = null;
    }
    private static string BindingKey(string profile, string name) => $"{profile}\n{name}";
    private static string BindingTargetValue(BindingInput input) => string.IsNullOrWhiteSpace(input.Name) ? string.Empty : $"{input.Namespace}\n{input.Name}";
    private static string BindingTargetValue(BootstrapBindingTargetOption option) => $"{option.Namespace}\n{option.Name}";
    private static string BindingLabel(BootstrapBindingSelection binding) => $"{binding.Profile}/{binding.Name} → {binding.Target.Namespace?.Value ?? "default"}/{binding.Target.Name}";
    private sealed class BindingInput(string name, string @namespace) { public string Name { get; set; } = name; public string Namespace { get; set; } = @namespace; }
    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); }
}
