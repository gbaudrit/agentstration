@page "/entries/{Name}"
@page "/namespaces/{EntryNamespace}/entries/{Name}"
@using Agentstration.Resources
@rendermode InteractiveServer
@inject IEntryAdministrationApiClient Client
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<WorkplaceStrings> Localizer

<PageTitle>@(IsNew ? T("CreateEntry") : displayName) · Agentstration</PageTitle>
<PageHeader Eyebrow="@T("WorkplaceEntry")" Title="@(IsNew ? T("CreateEntry") : displayName)" Description="@T("Entry.Description")">
    <Actions>
        @if (!IsNew && published is not null) { <a class="button-primary" href="@WorkspaceConfigurationUrl">@T("UseInWorkplace")</a> }
        <a class="button-secondary" href="/entries">@T("BackToEntries")</a>
    </Actions>
</PageHeader>

@if (loading)
{
    <LoadingState Message="@T("LoadingEntry")" />
}
else
{
    <div class="entry-summary-bar" aria-label="@T("EntryStatus")">
        @if (published is null)
        {
            <StatusBadge Text="@T("Draft")" Status="UiStatus.Info" />
            <span>@T("Revision", draftRevision)</span>
        }
        else
        {
            <StatusBadge Text="@T("Published")" Status="UiStatus.Success" />
            <span>@T("Version", published.Version)</span>
        }
    </div>

    @if (!EntryResourceNamespace.IsDefault)
    {
        <p class="muted">@T("NamespacedEntryHelp")</p>
    }

    <div class="entry-tabs">
        <ResourceTabs Label="@T("EntrySections")">
            @foreach (var tab in AvailableTabs)
            {
                <button id="@TabId(tab)" type="button" role="tab" aria-selected="@(activeTab == tab ? "true" : "false")" aria-controls="entry-tab-panel" class="@(activeTab == tab ? "active" : null)" data-testid="@($"entry-tab-{tab.ToString().ToLowerInvariant()}")" @onclick="() => SelectTab(tab)">@TabLabel(tab)</button>
            }
        </ResourceTabs>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="form-alert @(hasError ? "form-alert-danger" : "form-alert-success")" role="@(hasError ? "alert" : "status")">@message</div>
    }

    <main id="entry-tab-panel" role="tabpanel" aria-labelledby="@TabId(activeTab)" tabindex="0">
        @if (activeTab == EntryTab.Overview)
        {
            <section class="entry-overview-grid" aria-label="@T("EntryOverview")">
                <article class="panel entry-overview-card">
                    <p class="eyebrow">@T("Definition")</p>
                    <h2>@T("EntrySummary")</h2>
                    <dl class="entry-facts">
                        <dt>@T("Status")</dt><dd>@T(published is null ? "Draft" : "Published")</dd>
                        <dt>@T("DraftRevision")</dt><dd>@draftRevision</dd>
                        <dt>@T("PublishedVersionLabel")</dt><dd>@(published?.Version.ToString() ?? T("NotPublished"))</dd>
                        <dt>@T("Presentation")</dt><dd>@EnumLabel("Presentation", presentationKind)</dd>
                    </dl>
                </article>
                <article class="panel entry-overview-card">
                    <p class="eyebrow">@T("Execution")</p>
                    <h2>@T("BindingAndResolution")</h2>
                    <dl class="entry-facts">
                        <dt>@T("Binding")</dt><dd>@EnumLabel("Binding", bindingKind)</dd>
                        <dt>@T("Resource")</dt><dd>@BindingResourceName</dd>
                        <dt>@T("ResolvedFlow")</dt><dd>@ResolvedFlowName</dd>
                        <dt>@T("Strategy")</dt><dd>@(published is null ? T("PinnedOnPublication") : T("PinnedVersion", published.ResolvedTarget.Version))</dd>
                    </dl>
                </article>
                <article class="panel entry-overview-card">
                    <p class="eyebrow">@T("Usage")</p>
                    <h2>@T("WorkplaceAvailability")</h2>
                    <dl class="entry-facts">
                        <dt>@T("PublishedDashboards")</dt><dd>@PublishedUsages.Count</dd>
                        <dt>@T("PrimaryIn")</dt><dd>@PrimaryUsages.Count</dd>
                        <dt>@T("Dashboards")</dt><dd>@UsageSummary</dd>
                        <dt>@T("LastPublication")</dt><dd>@FormatDate(published?.PublishedAt)</dd>
                    </dl>
                </article>
            </section>
        }
        else if (activeTab == EntryTab.Definition)
        {
            <div class="entry-definition-toolbar">
                <div><p class="eyebrow">@T("Definition")</p><h2>@(IsPackOwned ? T("PackEntryDefinition") : T("DraftRevisionValue", draftRevision))</h2></div>
                @if (IsPackOwned)
                {
                    <StatusBadge Text="@T("ReadOnly")" Status="UiStatus.Neutral" />
                }
                else
                {
                    <div class="entry-primary-actions" aria-label="@T("EntryActions")">
                        <button class="button-secondary" type="button" @onclick="SaveAsync" disabled="@busy">@T("SaveDraft")</button>
                        <button class="button-secondary" type="button" @onclick="ValidateAsync" disabled="@busy">@T("Validate")</button>
                        <button class="button-primary" type="button" @onclick="PublishAsync" disabled="@busy">@T("PublishPinnedVersion")</button>
                    </div>
                }
            </div>

            @if (validation is not null && !validation.IsValid)
            {
                <div class="form-alert form-alert-danger" role="alert"><strong>@T("ValidationIssues")</strong><ul>@foreach (var issue in validation.Issues) { <li><code>@issue.Code</code> — @issue.Message</li> }</ul></div>
            }

            <fieldset class="entry-definition-fields" disabled="@IsPackOwned" data-testid="entry-definition-fields">

            <section class="panel form-section">
                <div class="panel-header"><div><p class="eyebrow">@T("General")</p><h2>@T("Identity")</h2></div></div>
                <div class="form-grid">
                    <label><span>@T("Name")</span><input @bind="resourceName" disabled="@(!IsNew)" /></label>
                    <label><span>@T("DisplayName")</span><input @bind="displayName" /></label>
                    <label class="form-span-2"><span>@T("Description")</span><textarea @bind="description" rows="2"></textarea></label>
                </div>
            </section>

            <section class="panel form-section">
                <div class="panel-header"><div><p class="eyebrow">@T("Presentation")</p><h2>@T("WorkplaceAppearance")</h2></div></div>
                <div class="form-grid">
                <label><span>@T("Presentation")</span><select data-testid="presentation-kind" @bind="presentationKind"><option value="Prompt">@T("Presentation.Prompt")</option><option value="Form">@T("Presentation.Form")</option></select></label>
                <label><span>@T("Placeholder")</span><input @bind="placeholder" /></label>
                <label><span>@T("Icon")</span><input @bind="icon" placeholder="@T("IconExample")" /></label>
                <label class="entry-toggle"><input type="checkbox" @bind="allowAttachments" /><span>@T("AllowAttachments")</span></label>
                <label class="entry-toggle"><input type="checkbox" @bind="allowVoiceInput" /><span>@T("AllowVoiceInput")</span></label>
                </div>
            </section>

            <section class="panel form-section">
                <div class="panel-header"><div><p class="eyebrow">@T("ExecutionExperience")</p><h2>@T("InteractionPresentation")</h2><p>@T("InteractionHelp")</p></div></div>
                <div class="form-grid">
                    <label><span>@T("Participants")</span><select data-testid="participants-visibility" @bind="participantsVisibility">@foreach (var value in Enum.GetValues<EntryParticipantVisibility>()) { <option value="@value">@EnumLabel("Participants", value)</option> }</select></label>
                    <label><span>@T("Progress")</span><select data-testid="progress-visibility" @bind="progressVisibility">@foreach (var value in Enum.GetValues<EntryProgressVisibility>()) { <option value="@value">@EnumLabel("Progress", value)</option> }</select></label>
                    <label><span>@T("Task")</span><select data-testid="task-display" @bind="taskDisplay">@foreach (var value in Enum.GetValues<EntryTaskDisplay>()) { <option value="@value">@EnumLabel("TaskDisplay", value)</option> }</select></label>
                    <label><span>@T("Results")</span><select data-testid="results-display" @bind="resultDisplay">@foreach (var value in Enum.GetValues<EntryResultDisplay>()) { <option value="@value">@EnumLabel("ResultDisplay", value)</option> }</select></label>
                </div>
            </section>

            <section class="panel form-section">
                <div class="panel-header"><div><p class="eyebrow">@T("Fields")</p><h2>@T("InputSchema")</h2></div><button class="button-secondary" data-testid="add-field" type="button" @onclick="AddField">@T("AddField")</button></div>
                <div class="entry-card-list">
                    @for (var index = 0; index < fields.Count; index++)
                    {
                        var field = fields[index];
                        <article class="entry-field-card" @key="field">
                            <header><div><strong>@FieldTitle(field)</strong><span>@EnumLabel("FieldType", field.Type)</span></div>@if (field.Primary) { <StatusBadge Text="@T("PrimaryInput")" Status="UiStatus.Info" /> }</header>
                            <div class="form-grid">
                                <label><span>@T("Name")</span><input @bind="field.Name" /></label>
                                <label><span>@T("Label")</span><input @bind="field.Label" /></label>
                                <label><span>@T("Description")</span><input @bind="field.Description" /></label>
                                <label><span>@T("Placeholder")</span><input @bind="field.Placeholder" /></label>
                                <label><span>@T("Type")</span><select @bind="field.Type">@foreach (var type in Enum.GetValues<EntryFieldType>()) { <option value="@type">@EnumLabel("FieldType", type)</option> }</select></label>
                                @if (field.Type is EntryFieldType.Choice or EntryFieldType.MultiChoice) { <label><span>@T("OptionsValueLabel")</span><input @bind="field.Options" /></label> }
                                <div class="entry-toggle-group">
                                    <label class="entry-toggle"><input type="checkbox" @bind="field.Required" /><span>@T("Required")</span></label>
                                    <label class="entry-toggle"><input type="radio" name="primary-input" checked="@field.Primary" @onclick="() => SetPrimary(field)" /><span>@T("PrimaryInput")</span></label>
                                </div>
                                <div class="entry-row-actions">
                                    <button type="button" class="button-secondary" title="@T("MoveUp")" aria-label="@T("MoveFieldUp")" @onclick="() => MoveField(field, -1)" disabled="@(index == 0)">↑</button>
                                    <button type="button" class="button-secondary" title="@T("MoveDown")" aria-label="@T("MoveFieldDown")" @onclick="() => MoveField(field, 1)" disabled="@(index == fields.Count - 1)">↓</button>
                                    <button type="button" class="text-button entry-remove" @onclick="() => RemoveField(field)" disabled="@(fields.Count == 1)">@T("Remove")</button>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            </section>

            <section class="panel form-section">
                <div class="panel-header"><div><p class="eyebrow">@T("Execution")</p><h2>@T("BindingAndResolvedTarget")</h2></div></div>
                <div class="form-grid">
                    <label><span>@T("TargetKind")</span><select data-testid="target-kind" value="@bindingKind" @onchange="BindingKindChanged"><option value="Agent">@T("Binding.Agent")</option><option value="Flow">@T("Flow")</option></select></label>
                    <label><span>@T("TargetResource")</span><select data-testid="target-resource" @bind="resourceId"><option value="">@T("SelectTarget", EnumLabel("Binding", bindingKind))</option>@foreach (var resource in resources) { <option value="@ResourceKey(resource)">@resource.Name · @resource.Namespace · @resource.Version · @resource.State</option> }</select></label>
                </div>
                @if (bindingKind == EntryBindingKind.Agent) { <p class="resource-hint">@T("DirectAgentFlowHelp")</p> }
                <div class="entry-resolution-grid">
                    <article><h3>@T("DeclaredBinding")</h3><dl class="entry-facts"><dt>@T("Type")</dt><dd>@EnumLabel("Binding", bindingKind)</dd><dt>@T("Resource")</dt><dd>@BindingResourceName</dd><dt>@T("State")</dt><dd>@(SelectedResource?.State ?? T("NotSelected"))</dd>@if (SelectedModelProfile is not null) { <dt>@T("ModelProfile")</dt><dd>@SelectedModelProfile</dd> }</dl>@if (!string.IsNullOrWhiteSpace(resourceId)) { <details><summary>@T("ResourceId")</summary><code>@resourceId</code></details> }</article>
                    <article><h3>@T("ResolvedTarget")</h3><dl class="entry-facts"><dt>@T("Flow")</dt><dd>@ResolvedFlowName</dd><dt>@T("VersionLabel")</dt><dd>@(published?.ResolvedTarget.Version ?? T("ResolvedOnPublication"))</dd><dt>@T("Strategy")</dt><dd>@T("Pinned")</dd></dl>@if (published is not null) { <details><summary>@T("FlowResourceId")</summary><code>@published.ResolvedTarget.FlowResourceId</code></details> }</article>
                </div>
            </section>

            <section class="panel form-section">
                <div class="panel-header"><div><p class="eyebrow">@T("Behavior")</p><h2>@T("ConversationAndExecution")</h2></div></div>
                <div class="entry-behavior-layout">
                    <label><span>@T("TaskCreation")</span><select @bind="taskMode"><option value="Automatic">@T("TaskCreation.Automatic")</option><option value="OnDemand">@T("TaskCreation.OnDemand")</option><option value="Never">@T("TaskCreation.Never")</option></select></label>
                    <div class="entry-toggle-list">
                        <label class="entry-toggle"><input type="checkbox" @bind="allowConversation" /><span><strong>@T("AllowConversation")</strong><small>@T("AllowConversationHelp")</small></span></label>
                        <label class="entry-toggle"><input type="checkbox" @bind="streamResponse" /><span><strong>@T("StreamResponse")</strong><small>@T("StreamResponseHelp")</small></span></label>
                    </div>
                </div>
            </section>

            <section class="panel form-section">
                <div class="panel-header"><div><p class="eyebrow">@T("Suggestions")</p><h2>@T("PromptStarters")</h2></div><button class="button-secondary" type="button" @onclick="AddSuggestion">@T("AddSuggestion")</button></div>
                @if (suggestions.Count == 0) { <p class="entry-empty-copy">@T("NoPromptStarters")</p> }
                else
                {
                    <div class="entry-card-list">@foreach (var suggestion in suggestions) { <article class="entry-suggestion-card" @key="suggestion"><div class="form-grid"><label><span>@T("Label")</span><input @bind="suggestion.Label" /></label><label><span>@T("Value")</span><input @bind="suggestion.Value" /></label><div class="entry-row-actions form-span-2"><button type="button" class="text-button entry-remove" @onclick="() => RemoveSuggestion(suggestion)">@T("Remove")</button></div></div></article> }</div>
                }
            </section>
            </fieldset>
        }
        else if (activeTab == EntryTab.Preview)
        {
            <section class="panel form-section">
                <div class="panel-header"><div><p class="eyebrow">@T("Preview")</p><h2>@T("WorkplaceRenderer")</h2><p>@T("PreviewHelp")</p></div><StatusBadge Text="@T("NoExecution")" Status="UiStatus.Info" /></div>
                <div class="entry-preview"><Agentstration.Workplace.Components.EntryRenderer Definition="PreviewDefinition" OnSubmit="PreviewSubmitted" Disabled="true" /></div>
            </section>
        }
        else if (activeTab == EntryTab.Usage)
        {
            <section class="entry-usage-grid">
                <article class="panel form-section">
                    <div class="panel-header"><div><p class="eyebrow">@T("DependsOn")</p><h2>@T("ExecutionResources")</h2></div><StatusBadge Text="@dependencies.Count.ToString()" Status="UiStatus.Neutral" /></div>
                    @if (dependencies.Count == 0) { <p class="entry-empty-copy">@T("DependenciesAfterPublication")</p> }
                    else { <div class="entry-card-list">@foreach (var dependency in dependencies) { <article class="entry-usage-card"><strong>@FriendlyResourceName(dependency.ResourceId)</strong><span>@dependency.ResourceType · @FriendlyRelationship(dependency.Relationship)</span><details><summary>@T("ResourceId")</summary><code>@dependency.ResourceId</code></details></article> }</div> }
                </article>
                <article class="panel form-section">
                    <div class="panel-header"><div><p class="eyebrow">@T("UsedBy")</p><h2>@T("PublishedDashboards")</h2></div><StatusBadge Text="@PublishedUsages.Count.ToString()" Status="UiStatus.Neutral" /></div>
                    @if (PublishedUsages.Count == 0) { <p class="entry-empty-copy">@T("NotUsedByDashboard")</p> }
                    else { <div class="entry-card-list">@foreach (var usage in PublishedUsages) { var reference = UsageReference(usage)!; <article class="entry-usage-card"><strong>@usage.Published!.DisplayName</strong><span>@EnumLabel("Role", reference.Role) · @T("Position", reference.Order + 1)</span><details><summary>@T("DashboardResourceId")</summary><code>@usage.Published.Id.Value</code></details></article> }</div> }
                </article>
            </section>
        }
        else if (activeTab == EntryTab.Versions)
        {
            <section class="panel form-section">
                <div class="panel-header"><div><p class="eyebrow">@T("Versions")</p><h2>@T("PublishedEntry")</h2></div></div>
                @if (published is null) { <p class="entry-empty-copy">@T("NoPublishedVersion")</p> }
                else
                {
                    <article class="entry-version-card"><div><StatusBadge Text="@T("Published")" Status="UiStatus.Success" /><strong>@T("Version", published.Version)</strong><span>@T("PublishedAt", FormatDate(published.PublishedAt))</span></div><dl class="entry-facts"><dt>@T("Binding")</dt><dd>@PublishedBindingSummary</dd><dt>@T("ResolvedFlow")</dt><dd>@FriendlyResourceName(published.ResolvedTarget.FlowResourceId)</dd><dt>@T("FlowVersion")</dt><dd>@published.ResolvedTarget.Version · @T("PinnedLower")</dd></dl><details><summary>@T("ResolvedFlowResourceId")</summary><code>@published.ResolvedTarget.FlowResourceId</code></details></article>
                }
            </section>
        }
        else
        {
            <section class="panel form-section" data-testid="entry-yaml-editor">
                <div class="panel-header"><div><p class="eyebrow">@T("RawResource")</p><h2>@T("EntryYaml")</h2><p>@T(IsPackOwned ? "EntryYamlReadOnlyHelp" : "EntryYamlEditableHelp")</p></div>@if (IsPackOwned) { <StatusBadge Text="@T("ReadOnly")" Status="UiStatus.Neutral" /> }</div>
                @if (!string.IsNullOrWhiteSpace(rawError)) { <div class="form-alert form-alert-danger" role="alert">@rawError</div> }
                @if (IsPackOwned)
                {
                    <label class="entry-yaml-field"><span>@T("ResourceManifest")</span><textarea class="form-code-editor runner-json" rows="30" readonly>@rawYaml</textarea></label>
                }
                else
                {
                    <label class="entry-yaml-field"><span>@T("ResourceManifest")</span><textarea class="form-code-editor runner-json" rows="30" @bind="rawYaml" @bind:event="oninput"></textarea></label>
                    <div class="form-actions"><button class="button-secondary" type="button" @onclick="() => { ApplyRawYaml(); }" disabled="@busy">@T("ApplyToForm")</button><button class="button-primary" type="button" @onclick="SaveRawAsync" disabled="@busy">@(busy ? T("Saving") : T("SaveYamlDraft"))</button></div>
                }
            </section>
        }
    </main>
}

@code {
    [Parameter] public string Name { get; set; } = "new";
    [Parameter] public string? EntryNamespace { get; set; }
    [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }
    private static readonly EntryTab[] Tabs = Enum.GetValues<EntryTab>();
    private static readonly EntryTab[] NamespacedTabs = [EntryTab.Overview, EntryTab.Definition, EntryTab.Preview, EntryTab.Usage, EntryTab.Versions, EntryTab.Yaml];
    private bool IsNew => string.Equals(Name, "new", StringComparison.OrdinalIgnoreCase);
    private ResourceNamespace EntryResourceNamespace => string.IsNullOrWhiteSpace(EntryNamespace) ? ResourceNamespace.Default : ResourceNamespace.Parse(EntryNamespace);
    private bool IsPackOwned => !EntryResourceNamespace.IsDefault;
    private IReadOnlyList<EntryTab> AvailableTabs => EntryResourceNamespace.IsDefault ? Tabs : NamespacedTabs;
    private bool loading = true, busy, hasError;
    private long draftRevision = 1;
    private string resourceName = "", displayName = "", description = "", placeholder = "Ask Agentstration", icon = "", resourceId = "", message = "";
    private string rawYaml = "";
    private string? rawError;
    private EntryTab activeTab = EntryTab.Overview;
    private EntryBindingKind bindingKind = EntryBindingKind.Agent;
    private EntryPresentationKind presentationKind = EntryPresentationKind.Prompt;
    private EntryParticipantVisibility participantsVisibility = EntryParticipantVisibility.Hidden;
    private EntryProgressVisibility progressVisibility = EntryProgressVisibility.Compact;
    private EntryTaskDisplay taskDisplay = EntryTaskDisplay.Auto;
    private EntryResultDisplay resultDisplay = EntryResultDisplay.Auto;
    private TaskCreationMode taskMode = TaskCreationMode.Automatic;
    private bool allowConversation = true, streamResponse = true, allowAttachments, allowVoiceInput, rawPublish;
    private readonly List<EditorField> fields = [new() { Name = "request", Label = "Request", Type = EntryFieldType.Prompt, Required = true, Primary = true }];
    private readonly List<EditorSuggestion> suggestions = [];
    private EntryResource? published;
    private EntryBinding? publishedBinding;
    private EntryValidationResponse? validation;
    private IReadOnlyList<ResourcePickerItem> resources = [];
    private IReadOnlyList<EntryDependencyResponse> dependencies = [];
    private IReadOnlyList<WorkplaceWorkspaceResponse> workspaces = [];
    private IReadOnlyList<WorkplaceDashboardDraftResponse> dashboards = [];
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    private string EnumLabel<TValue>(string group, TValue value) where TValue : struct, Enum => T($"{group}.{value}");
    private ResourcePickerItem? SelectedResource => resources.FirstOrDefault(value => ResourceKey(value) == resourceId) ?? resources.FirstOrDefault(value => value.ResourceId == resourceId);
    private string? SelectedModelProfile => SelectedResource?.Details?.GetValueOrDefault("modelProfile");
    private string BindingResourceName => SelectedResource?.Name ?? (string.IsNullOrWhiteSpace(resourceId) ? T("NotSelected") : FriendlyResourceName(resourceId));
    private string ResolvedFlowName => published is null ? T("ResolvedOnPublication") : FriendlyResourceName(published.ResolvedTarget.FlowResourceId);
    private IReadOnlyList<WorkplaceDashboardDraftResponse> PublishedUsages => dashboards.Where(value => UsageReference(value) is not null).ToArray();
    private IReadOnlyList<WorkplaceDashboardDraftResponse> PrimaryUsages => PublishedUsages.Where(value => UsageReference(value)?.Role == DashboardItemRole.Primary).ToArray();
    private string UsageSummary => PublishedUsages.Count == 0 ? T("NotUsed") : string.Join(", ", PublishedUsages.Take(3).Select(value => value.Published!.DisplayName));
    private string WorkspaceConfigurationUrl => $"/workspaces?entry={Uri.EscapeDataString(EntryIdValue)}&entryNamespace={Uri.EscapeDataString(EntryResourceNamespace.Value)}";
    private string PublishedBindingSummary => publishedBinding is null ? T("NotRetained") : $"{EnumLabel("Binding", publishedBinding.Kind)} · {FriendlyResourceName(publishedBinding.ResourceId)}";
    private EntryResource PreviewDefinition => new() { WorkspaceId = CurrentWorkspaceId, Id = new(string.IsNullOrWhiteSpace(resourceName) ? "preview" : resourceName), Name = string.IsNullOrWhiteSpace(resourceName) ? "preview" : resourceName, DisplayName = string.IsNullOrWhiteSpace(displayName) ? "Entry preview" : displayName, Description = description, Presentation = Presentation(), ResolvedTarget = published?.ResolvedTarget ?? new("preview", "1.0.0"), Behavior = Behavior() };

    protected override async Task OnInitializedAsync()
    {
        if (!IsNew)
        {
            var response = await Client.GetEntryAsync(EntryResourceNamespace, Name, default); var draft = response.Value; published = response.Published; rawPublish = published is not null; publishedBinding = draft.PublishedBinding; draftRevision = draft.Revision;
            resourceName = draft.Name; displayName = draft.DisplayName; description = draft.Description ?? ""; placeholder = draft.Presentation.Placeholder ?? ""; icon = draft.Presentation.Icon ?? ""; presentationKind = draft.Presentation.Kind; participantsVisibility = draft.Presentation.Participants.Visibility; progressVisibility = draft.Presentation.Progress.Visibility; taskDisplay = draft.Presentation.Task.Display; resultDisplay = draft.Presentation.Results.Display; bindingKind = draft.Binding.Kind; resourceId = draft.Binding.ResourceId; taskMode = draft.Behavior.TaskCreationMode; allowConversation = draft.Behavior.AllowConversation; streamResponse = draft.Behavior.StreamResponse; allowAttachments = draft.Presentation.AllowAttachments; allowVoiceInput = draft.Presentation.AllowVoiceInput;
            fields.Clear(); fields.AddRange(draft.Presentation.Fields.Select(value => new EditorField { Name = value.Name, Label = value.Label ?? "", Description = value.Description ?? "", Placeholder = value.Placeholder ?? "", Type = value.Type, Required = value.Required, Primary = value.Role == EntryFieldRole.PrimaryInput, Options = string.Join(", ", value.Options.Select(option => $"{option.Value}:{option.Label}")), DefaultValue = value.DefaultValue, Validation = value.Validation }));
            suggestions.Clear(); suggestions.AddRange(draft.Presentation.Suggestions.Select(value => new EditorSuggestion { Label = value.Label, Value = value.Value }));
            dependencies = await Client.GetDependenciesAsync(EntryResourceNamespace, Name, default);
        }
        await LoadDashboardUsagesAsync();
        await LoadResourcesAsync();
        if (string.Equals(View, "definition", StringComparison.OrdinalIgnoreCase)) activeTab = EntryTab.Definition;
        else if (string.Equals(View, "yaml", StringComparison.OrdinalIgnoreCase)) { PrepareRawYaml(); activeTab = EntryTab.Yaml; }
        loading = false;
    }

    private void SelectTab(EntryTab tab) { if (tab == EntryTab.Yaml) PrepareRawYaml(); activeTab = tab; message = ""; }
    private static string TabId(EntryTab tab) => $"entry-tab-{tab.ToString().ToLowerInvariant()}";
    private string TabLabel(EntryTab tab) => T($"Tab.{tab}");
    private DashboardEntryReference? UsageReference(WorkplaceDashboardDraftResponse dashboard) => dashboard.Published?.Entries.FirstOrDefault(value => value.EntryResourceId == new EntryId(EntryIdValue, EntryResourceNamespace));
    private async Task LoadDashboardUsagesAsync()
    {
        workspaces = await Client.GetWorkspacesAsync(default);
        var values = new List<WorkplaceDashboardDraftResponse>();
        foreach (var workspace in workspaces) values.AddRange(await Client.GetDashboardsAsync(workspace.Name, default));
        dashboards = values;
    }
    private string EntryIdValue => resourceName;
    private string FormatDate(DateTimeOffset? value) => value is null || value == default ? T("NotPublished") : value.Value.LocalDateTime.ToString("g");
    private static string FriendlyResourceName(string value) => value[(value.LastIndexOf('/') + 1)..];
    private string FriendlyRelationship(string value) => value == "ResolvedTarget" ? T("ResolvedTarget") : value;
    private string FieldTitle(EditorField field) => string.IsNullOrWhiteSpace(field.Label) ? (string.IsNullOrWhiteSpace(field.Name) ? T("UntitledField") : field.Name) : field.Label;
    private async Task BindingKindChanged(ChangeEventArgs args) { bindingKind = Enum.Parse<EntryBindingKind>(args.Value?.ToString() ?? "Agent"); resourceId = ""; await LoadResourcesAsync(); }
    private async Task LoadResourcesAsync() { resources = await Client.GetResourcesAsync(bindingKind, default); var selected = SelectedResource; if (selected is not null) resourceId = ResourceKey(selected); }
    private static string ResourceKey(ResourcePickerItem resource) => $"{resource.Namespace.Value}:{resource.ResourceId}";
    private void AddField() => fields.Add(new EditorField { Name = $"field{fields.Count + 1}", Label = T("NewField"), Type = EntryFieldType.Text, Primary = fields.Count == 0 });
    private void RemoveField(EditorField field) { fields.Remove(field); if (fields.Count > 0 && fields.All(value => !value.Primary)) fields[0].Primary = true; }
    private void SetPrimary(EditorField field) { foreach (var value in fields) value.Primary = ReferenceEquals(value, field); }
    private void MoveField(EditorField field, int offset) { var index = fields.IndexOf(field); var target = index + offset; if (index < 0 || target < 0 || target >= fields.Count) return; fields.RemoveAt(index); fields.Insert(target, field); }
    private void AddSuggestion() => suggestions.Add(new EditorSuggestion { Label = T("Suggestion"), Value = "" });
    private void RemoveSuggestion(EditorSuggestion suggestion) => suggestions.Remove(suggestion);
    private EntryPresentation Presentation() => new() { Kind = presentationKind, Placeholder = NullIfWhiteSpace(placeholder), Icon = NullIfWhiteSpace(icon), AllowAttachments = allowAttachments, AllowVoiceInput = allowVoiceInput, Participants = new(participantsVisibility), Progress = new(progressVisibility), Task = new(taskDisplay), Results = new(resultDisplay), Fields = fields.Select((value, index) => new EntryFieldDefinition { Name = value.Name.Trim(), Label = NullIfWhiteSpace(value.Label), Description = NullIfWhiteSpace(value.Description), Placeholder = NullIfWhiteSpace(value.Placeholder), Type = value.Type, Required = value.Required, Role = value.Primary ? EntryFieldRole.PrimaryInput : EntryFieldRole.Standard, Order = index, Options = ParseOptions(value.Options), DefaultValue = value.DefaultValue, Validation = value.Validation ?? (value.Type is EntryFieldType.Prompt or EntryFieldType.Text or EntryFieldType.Textarea or EntryFieldType.Conversation ? new EntryFieldValidation(1, 10_000) : null) }).ToArray(), Suggestions = suggestions.Where(value => !string.IsNullOrWhiteSpace(value.Label) && !string.IsNullOrWhiteSpace(value.Value)).Select(value => new EntrySuggestion(value.Label.Trim(), value.Value.Trim())).ToArray() };
    private static IReadOnlyList<EntryFieldOption> ParseOptions(string options) => options.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Select(value => { var parts = value.Split(':', 2, StringSplitOptions.TrimEntries); return new EntryFieldOption(parts[0], parts.Length == 2 ? parts[1] : parts[0]); }).ToArray();
    private EntryBehavior Behavior() => new(taskMode, allowConversation, streamResponse, new EntryConversationBehavior(allowConversation));
    private Agentstration.Resources.WorkspaceId CurrentWorkspaceId => new(workspaces.FirstOrDefault()?.Id ?? published?.WorkspaceId.Value ?? Guid.Empty);
    private EntryDraft Draft() => new() { WorkspaceId = CurrentWorkspaceId, Id = new(EntryIdValue, EntryResourceNamespace), Name = resourceName.Trim(), DisplayName = displayName.Trim(), Description = string.IsNullOrWhiteSpace(description) ? null : description.Trim(), Presentation = Presentation(), Binding = new(bindingKind, SelectedResource?.ResourceId ?? resourceId, SelectedResource?.Namespace), PublishedBinding = publishedBinding, Behavior = Behavior(), Revision = draftRevision };
    private RawEntryResource RawResource() => new() { ApiVersion = ManagementApiVersions.CoreV1, Kind = ResourceKinds.Entry, Metadata = new() { Name = resourceName.Trim() }, Definition = new() { DisplayName = displayName.Trim(), Description = NullIfWhiteSpace(description), Presentation = Presentation(), Binding = new(bindingKind, SelectedResource?.ResourceId ?? resourceId, SelectedResource?.Namespace), Behavior = Behavior(), Publish = rawPublish } };
    private void PrepareRawYaml() { rawError = null; try { rawYaml = ResourceManifestSerializer.ToYaml(RawResource()); } catch (Exception exception) { rawError = exception.Message; } }
    private bool ApplyRawYaml()
    {
        rawError = null;
        try
        {
            var manifest = ResourceManifestSerializer.FromYaml<RawEntryResource>(rawYaml);
            if (!string.Equals(manifest.ApiVersion, ManagementApiVersions.CoreV1, StringComparison.Ordinal)) throw new ArgumentException(T("ApiVersionRequired", ManagementApiVersions.CoreV1));
            if (!string.Equals(manifest.Kind, ResourceKinds.Entry, StringComparison.Ordinal)) throw new ArgumentException(T("KindRequired", ResourceKinds.Entry));
            if (!IsNew && !string.Equals(manifest.Metadata.Name, Name, StringComparison.Ordinal)) throw new ArgumentException(T("EntryNameImmutable"));
            resourceName = manifest.Metadata.Name; displayName = manifest.Definition.DisplayName ?? manifest.Metadata.Name; description = manifest.Definition.Description ?? "";
            var presentation = manifest.Definition.Presentation; presentationKind = presentation.Kind; placeholder = presentation.Placeholder ?? ""; icon = presentation.Icon ?? ""; allowAttachments = presentation.AllowAttachments; allowVoiceInput = presentation.AllowVoiceInput; participantsVisibility = presentation.Participants.Visibility; progressVisibility = presentation.Progress.Visibility; taskDisplay = presentation.Task.Display; resultDisplay = presentation.Results.Display;
            fields.Clear(); fields.AddRange(presentation.Fields.Select(value => new EditorField { Name = value.Name, Label = value.Label ?? "", Description = value.Description ?? "", Placeholder = value.Placeholder ?? "", Type = value.Type, Required = value.Required, Primary = value.Role == EntryFieldRole.PrimaryInput, Options = string.Join(", ", value.Options.Select(option => $"{option.Value}:{option.Label}")), DefaultValue = value.DefaultValue, Validation = value.Validation }));
            suggestions.Clear(); suggestions.AddRange(presentation.Suggestions.Select(value => new EditorSuggestion { Label = value.Label, Value = value.Value }));
            bindingKind = manifest.Definition.Binding.Kind; resourceId = manifest.Definition.Binding.Namespace is { } ns ? $"{ns.Value}:{manifest.Definition.Binding.ResourceId}" : manifest.Definition.Binding.ResourceId; taskMode = manifest.Definition.Behavior.TaskCreationMode; allowConversation = manifest.Definition.Behavior.AllowConversation; streamResponse = manifest.Definition.Behavior.StreamResponse; rawPublish = manifest.Definition.Publish;
            rawYaml = ResourceManifestSerializer.ToYaml(RawResource()); message = T("YamlApplied"); return true;
        }
        catch (Exception exception) { rawError = exception.Message; return false; }
    }
    private async Task SaveRawAsync() { if (!ApplyRawYaml()) return; if (rawPublish) await PublishAsync(); else await SaveAsync(); }
    private static string? NullIfWhiteSpace(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private async Task SaveAsync() { await ExecuteAsync(async () => { var saved = await Client.SaveEntryAsync(EntryResourceNamespace, Draft(), default); draftRevision = saved.Revision; publishedBinding = saved.PublishedBinding; message = T("EntryDraftSaved", saved.Revision); if (IsNew) Navigation.NavigateTo($"/entries/{saved.Name}", forceLoad: true); }); }
    private async Task ValidateAsync() { await ExecuteAsync(async () => { var saved = await Client.SaveEntryAsync(EntryResourceNamespace, Draft(), default); draftRevision = saved.Revision; validation = await Client.ValidateEntryAsync(EntryResourceNamespace, resourceName, default); message = T(validation.IsValid ? "EntryValid" : "ValidationFoundErrors"); hasError = !validation.IsValid; }); }
    private async Task PublishAsync() { await ExecuteAsync(async () => { var saved = await Client.SaveEntryAsync(EntryResourceNamespace, Draft(), default); draftRevision = saved.Revision; validation = await Client.ValidateEntryAsync(EntryResourceNamespace, resourceName, default); if (!validation.IsValid) { hasError = true; message = T("ResolveValidationErrors"); return; } published = await Client.PublishEntryAsync(EntryResourceNamespace, resourceName, default); publishedBinding = saved.Binding; dependencies = await Client.GetDependenciesAsync(EntryResourceNamespace, resourceName, default); await LoadDashboardUsagesAsync(); message = T("EntryPublished", published.Version, published.ResolvedTarget.Version); }); }
    private async Task ExecuteAsync(Func<Task> action) { busy = true; hasError = false; message = ""; try { await action(); } catch (Exception exception) { hasError = true; message = exception.Message; } finally { busy = false; } }
    private Task PreviewSubmitted(IReadOnlyDictionary<string, JsonElement> _) => Task.CompletedTask;
    private enum EntryTab { Overview, Definition, Preview, Usage, Versions, Yaml }
    private sealed class EditorField { public string Name { get; set; } = ""; public string Label { get; set; } = ""; public string Description { get; set; } = ""; public string Placeholder { get; set; } = ""; public string Options { get; set; } = ""; public EntryFieldType Type { get; set; } public bool Required { get; set; } public bool Primary { get; set; } public JsonElement? DefaultValue { get; set; } public EntryFieldValidation? Validation { get; set; } }
    private sealed class EditorSuggestion { public string Label { get; set; } = ""; public string Value { get; set; } = ""; }
    private sealed record RawEntryMetadata { public required string Name { get; init; } }
    private sealed record RawEntryDefinition { public string? DisplayName { get; init; } public string? Description { get; init; } public required EntryPresentation Presentation { get; init; } public required EntryBinding Binding { get; init; } public EntryBehavior Behavior { get; init; } = new(); public bool Publish { get; init; } }
    private sealed record RawEntryResource { public required string ApiVersion { get; init; } public required string Kind { get; init; } public required RawEntryMetadata Metadata { get; init; } public required RawEntryDefinition Definition { get; init; } }
}
