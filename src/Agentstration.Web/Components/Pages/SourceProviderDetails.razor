@page "/sourceproviders/new"
@page "/sourceproviders/{Name}"
@implements IDisposable
@inject ISourceProvidersClient Client
@inject IExtensionsClient ExtensionsClient
@inject NavigationManager Navigation
@inject NotificationState Notifications
@inject Microsoft.Extensions.Localization.IStringLocalizer<SourceProviderDetailsStrings> Localizer

<PageTitle>@(IsNew ? T("CreateProvider") : $"{Name} · {T("SourceProvider")}") · Agentstration</PageTitle>
<PageHeader Title="@(IsNew ? T("CreateProvider") : model?.DisplayName ?? Name)" Description="@T("Description")">
    <Actions>@if (!IsNew) { <button class="button-danger" @onclick="RequestDelete">@T("Delete")</button> }<a class="button-secondary" href="/sourceproviders">@T("Back")</a></Actions>
</PageHeader>

@if (model is null)
{
    <LoadingState Message="@T("Loading")" />
}
else
{
    @if (error is not null) { <div class="form-alert form-alert-danger" role="alert"><strong>@T("ProviderError")</strong><span>@error.Message</span></div> }
    @if (usages.Count > 0) { <div class="form-alert form-alert-warning">@T("UsedWarning", UsageCount(usages.Count))</div> }
    <EditForm Model="model" OnValidSubmit="SaveAsync" FormName="source-provider-editor" class="resource-form">
        <DataAnnotationsValidator /><ValidationSummary />
        <section class="panel form-section">
            <div class="panel-header"><div><p class="eyebrow">@T("Identity")</p><h2>@T("ProviderResource")</h2></div>@if (status is not null) { <StatusBadge Text="@StatusLabel(status.Status)" Status="@ModelManagementUi.Status(status.Status)" /> }</div>
            <div class="form-grid">
                <label><span>@T("Name")</span><InputText @bind-Value="model.Name" disabled="@(!IsNew)" /><ValidationMessage For="() => model.Name" /></label>
                <label><span>@T("Namespace")</span><InputText @bind-Value="model.Namespace" disabled="@(!IsNew)" /><ValidationMessage For="() => model.Namespace" /></label>
                <label><span>@T("DisplayName")</span><InputText @bind-Value="model.DisplayName" /><ValidationMessage For="() => model.DisplayName" /></label>
                <label><span>@T("OwnershipScope")</span><span class="form-readonly"><ResourceScopeBadge ScopeRef="@ResourceScopeRef.Instance" /></span><small>@T("InstanceOnlyHelp")</small></label>
                <label><span>@T("ExtensionRegistration")</span><select value="@model.ExtensionId" @onchange="ExtensionChanged"><option value="">@T("SelectExtension")</option>@foreach (var extension in EligibleExtensions) { <option value="@ExtensionKey(extension)">@extension.RegistrationNamespace/@extension.RegistrationName — @(extension.Extension?.Name ?? extension.RegistrationName)</option> }</select><ValidationMessage For="() => model.ExtensionId" /></label>
                <label><span>@T("Contribution")</span><select @bind="model.ContributionId"><option value="">@T("SelectContribution")</option>@foreach (var contribution in Contributions) { <option value="@contribution.Id">@contribution.Id</option> }</select><ValidationMessage For="() => model.ContributionId" /></label>
            </div>
        </section>
        <section class="panel form-section">
            <div class="panel-header"><div><p class="eyebrow">@T("Connection")</p><h2>@T("ExtensionOwnedEndpoint")</h2><p>@T("ConnectionHelp")</p></div></div>
            @if (SelectedExtension is { } selected)
            {
                <dl class="resource-details"><dt>@T("AepEndpoint")</dt><dd><code>@selected.Endpoint</code></dd><dt>@T("ExtensionId")</dt><dd><code>@(selected.Extension?.Id ?? T("NotObserved"))</code></dd><dt>@T("Source")</dt><dd>@selected.DiscoverySource</dd></dl>
                var optionSets = OptionSets(selected);
                <h3>@T("OptionContracts")</h3>
                @if (optionSets.Count == 0) { <p>@T("NoOptionContracts")</p> }
                else { <ul class="resource-links">@foreach (var optionSet in optionSets) { <li><span><strong>@optionSet.Id</strong><code>@optionSet.PreferredVersion · @optionSet.Scope</code></span></li> }</ul> }
            }
            @if (status is not null) { <p class="@(status.Status == "available" ? "inline-info" : "inline-warning")">@T("LastChecked", status.CheckedAt.ToLocalTime().ToString("g")) — @StatusLabel(status.Status)@if (!string.IsNullOrWhiteSpace(status.Details)) { <span> · @status.Details</span> }</p> }
        </section>
        <div class="form-actions"><a class="button-secondary" href="/sourceproviders">@T("Cancel")</a><button class="button-primary" type="submit" disabled="@saving">@(saving ? T("Saving") : IsNew ? T("CreateProviderAction") : T("SaveChanges"))</button></div>
    </EditForm>

    @if (!IsNew && usages.Count > 0)
    {
        <section class="panel resource-section"><div class="panel-header"><h2>@T("Usages")</h2><span>@UsageCount(usages.Count)</span></div><ul class="resource-links">@foreach (var usage in usages) { <li><a href="@SourceUrl(usage)"><strong>@usage.Publisher/@usage.SourceName</strong><code>@usage.BindingName</code></a></li> }</ul></section>
    }
}

<ConfirmationDialog IsOpen="@confirmDelete" Title="@T("DeleteDialogTitle")" Message="@T("DeleteDialogMessage", Name ?? string.Empty)" ConfirmLabel="@T("DeleteDialogConfirm")" OnConfirm="DeleteAsync" OnCancel="() => confirmDelete = false" />

@code {
    [Parameter] public string? Name { get; set; }
    [SupplyParameterFromQuery(Name = "namespace")] public string? Namespace { get; set; }
    [SupplyParameterFromQuery(Name = "extension")] public string? SuggestedExtension { get; set; }
    [SupplyParameterFromQuery(Name = "extensionNamespace")] public string? SuggestedExtensionNamespace { get; set; }
    [SupplyParameterFromQuery(Name = "contributionId")] public string? SuggestedContributionId { get; set; }
    [SupplyParameterFromQuery(Name = "displayName")] public string? SuggestedDisplayName { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    private readonly CancellationTokenSource cancellation = new();
    private SourceProviderEditorModel? model;
    private IReadOnlyList<ExtensionResponse> extensions = [];
    private IReadOnlyList<ExtensionRegistrationResource> registrations = [];
    private IReadOnlyList<SourceProviderUsageResponse> usages = [];
    private SourceProviderStatusResponse? status;
    private AgentstrationApiException? error;
    private string? etag;
    private bool saving;
    private bool confirmDelete;
    private bool IsNew => string.IsNullOrWhiteSpace(Name);
    private ResourceNamespace SelectedNamespace => ResourceNamespace.Parse(Namespace);
    private IReadOnlyList<ExtensionResponse> EligibleExtensions => extensions.Where(extension =>
        registrations.Any(registration => registration.ScopeRef == ResourceScopeRef.Instance && registration.Namespace.Value == extension.RegistrationNamespace && registration.Name == extension.RegistrationName)
        && (extension.Contributions.Any(value => value.Kind == "source-provider") || !IsNew && model is not null && ExtensionKey(extension) == model.ExtensionId)).ToArray();
    private ExtensionResponse? SelectedExtension => model is null ? null : EligibleExtensions.SingleOrDefault(value => ExtensionKey(value) == model.ExtensionId);
    private IReadOnlyList<ExtensionContributionResponse> Contributions
    {
        get
        {
            var observed = SelectedExtension?.Contributions.Where(value => value.Kind == "source-provider").ToArray() ?? [];
            return observed.Length == 0 && !IsNew && !string.IsNullOrWhiteSpace(model?.ContributionId)
                ? [new("source-provider", model.ContributionId)]
                : observed;
        }
    }
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string UsageCount(int count) => T(count == 1 ? "UsageCount.One" : "UsageCount.Many", count);
    private string StatusLabel(string? value) => Localizer[$"Status.{value?.ToLowerInvariant() switch { "available" => "Available", "disabled" => "Disabled", "unavailable" => "Unavailable", "incompatible" => "Incompatible", _ => "Unknown" }}"];
    protected override Task OnParametersSetAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        error = null;
        try
        {
            var extensionsTask = ExtensionsClient.GetExtensionsAsync(cancellation.Token);
            var registrationsTask = ExtensionsClient.GetRegistrationsAsync(cancellation.Token);
            await Task.WhenAll(extensionsTask, registrationsTask);
            extensions = await extensionsTask; registrations = await registrationsTask;
            if (IsNew)
            {
                var extensionNamespace = SuggestedExtensionNamespace ?? SelectedNamespace.Value;
                model = new() { Namespace = SelectedNamespace.Value, ExtensionId = string.IsNullOrWhiteSpace(SuggestedExtension) ? string.Empty : $"{extensionNamespace}:{SuggestedExtension}", ContributionId = SuggestedContributionId ?? string.Empty, DisplayName = SuggestedDisplayName ?? string.Empty };
                if (SelectedExtension is not null && !Contributions.Any(value => value.Id == model.ContributionId)) model.ContributionId = Contributions.Count == 1 ? Contributions[0].Id : string.Empty;
                return;
            }
            var snapshot = await Client.GetSourceProviderAsync(SelectedNamespace, Name!, cancellation.Token);
            model = SourceProviderEditorModel.FromResource(snapshot.Value); etag = snapshot.ETag;
            status = await Client.GetStatusAsync(SelectedNamespace, Name!, cancellation.Token);
            usages = (await Client.GetUsagesAsync(SelectedNamespace, Name!, cancellation.Token)).Value;
        }
        catch (AgentstrationApiException exception) { error = exception; model ??= new() { Namespace = SelectedNamespace.Value }; }
    }
    private void ExtensionChanged(ChangeEventArgs args) { if (model is null) return; model.ExtensionId = args.Value?.ToString() ?? string.Empty; if (!Contributions.Any(value => value.Id == model.ContributionId)) model.ContributionId = Contributions.Count == 1 ? Contributions[0].Id : string.Empty; }
    private IReadOnlyList<ExtensionOptionSetResponse> OptionSets(ExtensionResponse extension) => extension.OptionSets.Where(value => value.ContributionKind == "source-provider" && value.ContributionId.Equals(model?.ContributionId, StringComparison.OrdinalIgnoreCase) && value.Scope == "source-channel").ToArray();
    private async Task SaveAsync()
    {
        if (model is null || saving) return; saving = true; error = null;
        try
        {
            var wasNew = IsNew; var @namespace = ResourceNamespace.Parse(model.Namespace);
            var snapshot = wasNew ? await Client.CreateSourceProviderAsync(model.ToCreateRequest(), cancellation.Token) : await Client.UpdateSourceProviderAsync(@namespace, model.Name, model.ToPutRequest(), etag!, cancellation.Token);
            Notifications.Add(new(Guid.NewGuid(), wasNew ? T("CreatedNotification") : T("UpdatedNotification"), snapshot.Value.Name, DateTimeOffset.Now, UiStatus.Success));
            if (wasNew && IsSafeReturnUrl(ReturnUrl)) Navigation.NavigateTo(ReturnUrl!);
            else Navigation.NavigateTo(DetailsUrl(snapshot.Value.Namespace, snapshot.Value.Name));
        }
        catch (ArgumentException exception) { error = new(exception.Message, Guid.NewGuid().ToString("N")); }
        catch (AgentstrationApiException exception) { error = exception; }
        finally { saving = false; }
    }
    private void RequestDelete() { if (usages.Count == 0) confirmDelete = true; else error = new(T("UsedWarning", UsageCount(usages.Count)), Guid.NewGuid().ToString("N")); }
    private async Task DeleteAsync() { if (model is null || etag is null) return; confirmDelete = false; try { await Client.DeleteSourceProviderAsync(ResourceNamespace.Parse(model.Namespace), model.Name, etag, cancellation.Token); Navigation.NavigateTo("/sourceproviders"); } catch (AgentstrationApiException exception) { error = exception; } }
    private static bool IsSafeReturnUrl(string? value) => !string.IsNullOrWhiteSpace(value) && value.StartsWith("/", StringComparison.Ordinal) && !value.StartsWith("//", StringComparison.Ordinal);
    private static string DetailsUrl(ResourceNamespace @namespace, string name) => $"/sourceproviders/{Uri.EscapeDataString(name)}?namespace={Uri.EscapeDataString(@namespace.Value)}";
    private static string SourceUrl(SourceProviderUsageResponse usage) => $"/settings/sources/{Uri.EscapeDataString(usage.Publisher)}/{Uri.EscapeDataString(usage.SourceName)}?scopeRef={Uri.EscapeDataString(usage.SourceScopeRef.Value)}";
    private static string ExtensionKey(ExtensionResponse extension) => $"{extension.RegistrationNamespace}:{extension.RegistrationName}";
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
