@page "/entries"
@rendermode InteractiveServer
@inject IEntryAdministrationApiClient Client

<PageTitle>Entries · Agentstration</PageTitle>
<PageHeader Eyebrow="Workplace" Title="Entries" Description="Configure what users can submit, then publish a pinned executable Flow target.">
    <Actions><a class="button-primary entry-create-action" href="/entries/new"><UiIcon Name="plus" />Create entry</a></Actions>
</PageHeader>

@if (loading) { <LoadingState Message="Loading Entries…" /> }
else if (items.Count == 0) { <EmptyState Title="No Entries" Message="Create an Entry and bind it to an Agent or Flow." /> }
else
{
    <section class="entry-catalog" aria-label="Entry catalog">
        <header class="entry-catalog-header">
            <div>
                <p class="eyebrow">Catalog</p>
                <h2>Your Workplace entry points</h2>
                <p>Open an Entry to refine its experience, target, and publication.</p>
            </div>
            <div class="entry-catalog-summary" aria-label="Entry summary">
                <span><strong>@items.Count</strong> total</span>
                <span><strong>@PublishedCount</strong> published</span>
            </div>
        </header>

        <div class="entry-card-list">
            @foreach (var item in items)
            {
                <article class="entry-card @(item.Published is null ? "entry-card-draft" : "entry-card-published")">
                    <a class="entry-card-link" href="@ConsoleResourceUrls.Entry(item.Value.Id)" aria-label="Configure @item.Value.DisplayName">
                        <span class="entry-card-icon" aria-hidden="true"><UiIcon Name="entry" /></span>
                        <span class="entry-card-content">
                            <span class="entry-card-heading">
                                <span>
                                    <span class="entry-kind">@item.Value.Presentation.Kind Entry</span>
                                    <strong>@item.Value.DisplayName</strong>
                                </span>
                                <StatusBadge Text="@(item.Published is null ? "Draft" : $"Published v{item.Published.Version}")" Status="@(item.Published is null ? UiStatus.Warning : UiStatus.Success)" />
                            </span>
                            <span class="entry-description">@(string.IsNullOrWhiteSpace(item.Value.Description) ? $"A Workplace entry point bound to {ResourceName(item.Value.Binding.ResourceId)}." : item.Value.Description)</span>
                            <span class="entry-metadata">
                                <span><UiIcon Name="@(item.Value.Binding.Kind == EntryBindingKind.Agent ? "agent" : "workflow")" />@item.Value.Binding.Kind <strong>@ResourceName(item.Value.Binding.ResourceId)</strong></span>
                                <span><UiIcon Name="layers" />@item.Value.Id.Namespace</span>
                                <span>Draft r@item.Value.Revision</span>
                            </span>
                        </span>
                        <span class="entry-card-action">Configure <span aria-hidden="true">→</span></span>
                    </a>
                </article>
            }
        </div>
    </section>
}

@code {
    private bool loading = true;
    private IReadOnlyList<EntryDraftResponse> items = [];
    private int PublishedCount => items.Count(item => item.Published is not null);

    protected override async Task OnInitializedAsync()
    {
        items = await Client.GetEntriesAsync(default);
        loading = false;
    }

    private static string ResourceName(string id) => id[(id.LastIndexOf('/') + 1)..];
}
