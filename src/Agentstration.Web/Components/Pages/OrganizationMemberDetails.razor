@page "/settings/organization/members/{UserId:guid}"
@inject Agentstration.Management.Core.IdentityAdministrationService Service

<PageTitle>Member access · Agentstration</PageTitle>
@if (member is null) { <LoadingState Message="Loading member access…" /> }
else
{
    <PageHeader Title="@member.User.DisplayName" Description="Effective tenant and workspace access for this member." />
    <OrganizationSettingsNav />
    <section class="dashboard-grid">
        <article class="panel"><div class="panel-header"><h2>Identity</h2><StatusBadge Text="@member.User.Status.ToString()" Status="UiStatus.Success" /></div><p><strong>Subject:</strong> @(member.User.ExternalSubject ?? "—")</p><p><strong>Email:</strong> @(member.User.Email ?? "—")</p><p><strong>User ID:</strong> <code>@member.User.Id</code></p></article>
        <article class="panel"><div class="panel-header"><h2>Membership</h2><StatusBadge Text="@member.Membership.Status.ToString()" Status="UiStatus.Success" /></div><p>Joined @member.Membership.JoinedAt.ToLocalTime().ToString("g")</p></article>
    </section>
    <section class="panel" style="margin-top:18px"><div class="panel-header"><h2>Role assignments</h2></div>@if(member.Roles.Count == 0){<EmptyState Title="No access assigned" Message="Membership alone does not grant workspace access." />}else{@foreach(var assigned in member.Roles){<article><p><strong>@assigned.Role.DisplayName</strong> @if(assigned.Scope.StartsWith("/tenants/",StringComparison.Ordinal)){<StatusBadge Text="Inherited" Status="UiStatus.Info" />}</p><code>@assigned.Scope</code></article>}}</section>
}

@code {
    [Parameter] public Guid UserId { get; set; }
    private Agentstration.Management.Core.MemberAdministrationView? member;
    protected override async Task OnParametersSetAsync() => member = (await Service.GetCurrentAsync(default)).Members.SingleOrDefault(value => value.User.Id == UserId);
}
