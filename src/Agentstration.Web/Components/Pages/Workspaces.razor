@page "/workspaces"
@using Agentstration.Resources
@rendermode InteractiveServer
@inject IEntryAdministrationApiClient Client

<PageTitle>Dashboards · Agentstration</PageTitle>
<PageHeader Eyebrow="Workplace" Title="Dashboard composition" Description="Compose published Entries independently from the Workspace work context." />

@if (loading) { <LoadingState Message="Loading Dashboards…" /> }
else if (workspaces.Count == 0)
{
    <EmptyState Title="No Workspace" Message="Create a Workspace from Organization settings before composing Dashboards." />
    <a class="button-primary" href="/settings/organization/workspaces">Manage Workspaces</a>
}
else
{
    <section class="panel workspace-overview">
        <div class="workspace-picker"><label>Workspace</label><select value="@workspaceName" @onchange="WorkspaceChanged">@foreach (var item in workspaces) { <option value="@item.Id.ToString("D")">@item.DisplayName</option> }</select></div>
        <div class="workspace-picker"><label>Dashboard</label><select value="@dashboardName" @onchange="DashboardChanged">@foreach (var item in dashboards) { <option value="@item.Value.Name">@item.Value.DisplayName@(item.Value.IsDefault ? " · default" : "")</option> }</select></div>
        <button class="button-secondary" type="button" @onclick="NewDashboard">New Dashboard</button>
    </section>

    @if (selected is null) { <EmptyState Title="No Dashboard" Message="Create the first Dashboard for this Workspace." /> }
    else
    {
        <section class="panel form-section">
            <div class="form-grid">
                <label><span>Name</span><input @bind="name" disabled="@(!creating)" /></label>
                <label><span>Display name</span><input @bind="displayName" /></label>
                <label class="form-span-2"><span>Description</span><textarea @bind="description" rows="2"></textarea></label>
                <label class="entry-toggle"><input type="checkbox" @bind="isDefault" /><span>Default Dashboard</span></label>
            </div>
        </section>
        <section class="panel workspace-composition">
            <div class="panel-header"><div><p class="eyebrow">Entries</p><h2>Dashboard composition</h2></div></div>
            <div class="workspace-entry-list">
                @foreach (var entry in entries)
                {
                    var configured = composition.FirstOrDefault(value => value.EntryResourceId == EntryId(entry));
                    <article class="workspace-entry-row @(configured is null ? "excluded" : null)">
                        <label class="workspace-entry-toggle"><input type="checkbox" checked="@(configured is not null)" @onchange="args => ToggleEntry(entry, args)" /><span><strong>@entry.DisplayName</strong><small>@EntryScope(entry) · Entry v@entry.Version</small></span></label>
                        @if (configured is not null)
                        {
                            <div class="workspace-entry-config">
                                <label><span>Role</span><select data-testid="dashboard-entry-role" value="@configured.Role" @onchange="args => ChangeRole(entry, args)"><option>Primary</option><option>Featured</option><option>Standard</option></select></label>
                                <label><span>Order</span><input type="number" min="0" step="10" value="@configured.Order" @onchange="args => ChangeOrder(entry, args)" /></label>
                            </div>
                        }
                    </article>
                }
            </div>
            <div class="form-actions workspace-actions"><button class="button-secondary" @onclick="SaveAsync" disabled="@busy">Save draft</button><button class="button-primary" @onclick="PublishAsync" disabled="@busy">Publish Dashboard</button>@if (!creating && !isDefault) { <button class="text-button" @onclick="DeleteAsync" disabled="@busy">Delete</button> }</div>
            @if (!string.IsNullOrWhiteSpace(message)) { <p class="@(error ? "inline-warning" : "resource-hint")">@message</p> }
        </section>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "entry")] public string? RequestedEntryName { get; set; }
    [SupplyParameterFromQuery(Name = "entryNamespace")] public string? RequestedEntryNamespace { get; set; }
    private bool loading = true, busy, error, creating, isDefault;
    private string workspaceName = "", dashboardName = "", name = "", displayName = "", description = "", message = "";
    private IReadOnlyList<WorkplaceWorkspaceResponse> workspaces = [];
    private IReadOnlyList<WorkplaceDashboardDraftResponse> dashboards = [];
    private IReadOnlyList<EntryResponse> entries = [];
    private WorkplaceDashboardDraftResponse? selected;
    private List<DashboardEntryReference> composition = [];

    protected override async Task OnInitializedAsync()
    {
        workspaces = await Client.GetWorkspacesAsync(default);
        entries = await Client.GetPublishedEntriesAsync(default);
        workspaceName = workspaces.FirstOrDefault()?.Id.ToString("D") ?? "";
        if (workspaces.Count > 0) { await LoadDashboardsAsync(); PreselectRequestedEntry(); }
        loading = false;
    }
    private async Task WorkspaceChanged(ChangeEventArgs args)
    {
        var requestedName = args.Value?.ToString();
        var workspace = workspaces.FirstOrDefault(value => string.Equals(value.Id.ToString("D"), requestedName, StringComparison.OrdinalIgnoreCase));
        if (workspace is null) { ShowWorkspaceSelectionError(); return; }
        workspaceName = workspace.Name;
        await LoadDashboardsAsync();
    }
    private void DashboardChanged(ChangeEventArgs args)
    {
        var requestedName = args.Value?.ToString();
        var value = dashboards.FirstOrDefault(dashboard => string.Equals(dashboard.Value.Name, requestedName, StringComparison.Ordinal));
        if (value is not null) Select(value);
    }
    private async Task LoadDashboardsAsync()
    {
        var workspace = SelectedWorkspace();
        if (workspace is null) { ShowWorkspaceSelectionError(); return; }
        workspaceName = workspace.Name;
        dashboards = await Client.GetDashboardsAsync(workspaceName, default);
        selected = dashboards.FirstOrDefault(value => value.Value.IsDefault) ?? dashboards.FirstOrDefault();
        if (selected is not null) Select(selected); else NewDashboard();
    }
    private void Select(WorkplaceDashboardDraftResponse value) { selected = value; creating = false; dashboardName = name = value.Value.Name; displayName = value.Value.DisplayName; description = value.Value.Description ?? ""; isDefault = value.Value.IsDefault; composition = value.Value.Entries.ToList(); }
    private void NewDashboard()
    {
        var workspace = SelectedWorkspace();
        if (workspace is null) { ShowWorkspaceSelectionError(); return; }
        workspaceName = workspace.Name;
        creating = true; dashboardName = name = ""; displayName = ""; description = ""; isDefault = dashboards.Count == 0; composition = [];
        selected = new(new WorkplaceDashboardDraft { Id = new("new"), WorkspaceId = new(workspace.Id), Name = "new", DisplayName = "New Dashboard", IsDefault = isDefault }, null);
    }
    private void ToggleEntry(EntryResponse entry, ChangeEventArgs args) { var id = EntryId(entry); if (args.Value is true && composition.All(value => value.EntryResourceId != id)) composition.Add(new DashboardEntryReference { EntryResourceId = id, Role = DashboardItemRole.Standard, Order = composition.Count * 10 }); else if (args.Value is not true) composition.RemoveAll(value => value.EntryResourceId == id); }
    private void ChangeRole(EntryResponse entry, ChangeEventArgs args) { var role = Enum.Parse<DashboardItemRole>(args.Value?.ToString() ?? "Standard"); if (role == DashboardItemRole.Primary) for (var i = 0; i < composition.Count; i++) if (composition[i].Role == DashboardItemRole.Primary) composition[i] = composition[i] with { Role = DashboardItemRole.Standard }; Replace(EntryId(entry), value => value with { Role = role }); }
    private void ChangeOrder(EntryResponse entry, ChangeEventArgs args) { _ = int.TryParse(args.Value?.ToString(), out var order); Replace(EntryId(entry), value => value with { Order = order }); }
    private void Replace(EntryId id, Func<DashboardEntryReference, DashboardEntryReference> update) { var index = composition.FindIndex(value => value.EntryResourceId == id); if (index >= 0) composition[index] = update(composition[index]); }
    private void PreselectRequestedEntry() { if (selected is null || string.IsNullOrWhiteSpace(RequestedEntryName)) return; var ns = string.IsNullOrWhiteSpace(RequestedEntryNamespace) ? ResourceNamespace.Default : ResourceNamespace.Parse(RequestedEntryNamespace); var entry = entries.FirstOrDefault(value => value.Id == RequestedEntryName && value.Namespace == ns); if (entry is not null && composition.All(value => value.EntryResourceId != EntryId(entry))) composition.Add(new DashboardEntryReference { EntryResourceId = EntryId(entry), Role = DashboardItemRole.Standard, Order = composition.Count * 10 }); }
    private WorkplaceDashboardDraft Draft() { var value = selected!.Value; var normalized = name.Trim(); return value with { Id = creating ? new DashboardId(normalized) : value.Id, Name = normalized, DisplayName = displayName.Trim(), Description = string.IsNullOrWhiteSpace(description) ? null : description.Trim(), IsDefault = isDefault, Entries = composition.OrderBy(value => value.Order).ToArray() }; }
    private async Task SaveAsync() => await ExecuteAsync(async () => { var saved = await Client.SaveDashboardAsync(Draft(), default); dashboards = await Client.GetDashboardsAsync(workspaceName, default); Select(dashboards.FirstOrDefault(value => value.Value.Name == saved.Name) ?? new(saved, null)); message = $"Dashboard draft revision {saved.Revision} saved."; });
    private async Task PublishAsync() => await ExecuteAsync(async () => { var saved = await Client.SaveDashboardAsync(Draft(), default); var published = await Client.PublishDashboardAsync(workspaceName, saved.Name, default); dashboards = await Client.GetDashboardsAsync(workspaceName, default); Select(dashboards.FirstOrDefault(value => value.Value.Name == saved.Name) ?? new(saved, published)); message = $"Dashboard v{published.Version} published with {published.Entries.Count} Entries."; });
    private async Task DeleteAsync() => await ExecuteAsync(async () => { await Client.DeleteDashboardAsync(workspaceName, name, default); await LoadDashboardsAsync(); message = "Dashboard deleted."; });
    private async Task ExecuteAsync(Func<Task> action) { busy = true; error = false; message = ""; try { await action(); } catch (Exception exception) { error = true; message = exception.Message; } finally { busy = false; } }
    private WorkplaceWorkspaceResponse? SelectedWorkspace() => workspaces.FirstOrDefault(value => string.Equals(value.Id.ToString("D"), workspaceName, StringComparison.OrdinalIgnoreCase)) ?? workspaces.FirstOrDefault();
    private void ShowWorkspaceSelectionError() { dashboards = []; selected = null; error = true; message = "No Workspace is available for Dashboard composition."; }
    private static EntryId EntryId(EntryResponse entry) => new(entry.Id, entry.Namespace);
    private static string EntryScope(EntryResponse entry) => entry.Namespace.IsDefault ? "Local Entry" : $"Pack · {entry.Namespace.Value}";
}
