@page "/workspaces"
@rendermode InteractiveServer
@inject IEntryAdministrationApiClient Client

<PageTitle>Workspaces · Agentstration</PageTitle>
<PageHeader Eyebrow="Workplace" Title="Workspace composition" Description="Choose published Entries, their order, and the unique Primary role. Draft changes reach Workplace only after publication." />

@if (loading) { <LoadingState Message="Loading Workspace composition…" /> }
else if (workspaces.Count == 0) { <EmptyState Title="No Workspace drafts" Message="Seed or create a Workplace Workspace before composing it." /> }
else
{
    <section class="panel form-section">
        <label><span>Workspace</span><select value="@selectedName" @onchange="WorkspaceChanged">@foreach (var workspace in workspaces) { <option value="@workspace.Value.Name">@workspace.Value.DisplayName</option> }</select></label>
        @if (selected is not null)
        {
            <dl class="resource-details"><dt>Draft revision</dt><dd>@selected.Value.Revision</dd><dt>Published version</dt><dd>@(selected.Published?.Version.ToString() ?? "Not published")</dd></dl>
        }
    </section>

    <section class="panel form-section">
        <div class="panel-header"><div><p class="eyebrow">Entries</p><h2>Published composition</h2></div></div>
        @foreach (var entry in entries)
        {
            var configured = composition.FirstOrDefault(value => value.EntryResourceId.Value == entry.Id);
            <article class="row">
                <label><input type="checkbox" checked="@(configured is not null)" @onchange="args => ToggleEntry(entry, args)" /> <strong>@entry.DisplayName</strong><small>v@entry.Version · Flow @entry.ResolvedTarget.Version</small></label>
                @if (configured is not null)
                {
                    <label><span>Role</span><select data-testid="workspace-entry-role" value="@configured.Role" @onchange="args => ChangeRole(entry.Id, args)"><option value="Primary">Primary</option><option value="Featured">Featured</option><option value="Standard">Standard</option></select></label>
                    <label><span>Order</span><input type="number" value="@configured.Order" @onchange="args => ChangeOrder(entry.Id, args)" /></label>
                }
            </article>
        }
        <div class="form-actions"><button class="button-secondary" @onclick="SaveAsync" disabled="@busy">Save draft</button><button class="button-primary" @onclick="PublishAsync" disabled="@busy">Publish Workspace</button></div>
        @if (!string.IsNullOrWhiteSpace(message)) { <p class="@(error ? "inline-warning" : "resource-hint")">@message</p> }
    </section>
}

@code {
    private bool loading = true, busy, error;
    private string selectedName = "", message = "";
    private IReadOnlyList<WorkplaceWorkspaceDraftResponse> workspaces = [];
    private IReadOnlyList<EntryResponse> entries = [];
    private WorkplaceWorkspaceDraftResponse? selected;
    private List<WorkspaceEntryReference> composition = [];

    protected override async Task OnInitializedAsync()
    {
        workspaces = await Client.GetWorkspacesAsync(default); entries = await Client.GetPublishedEntriesAsync(default);
        selected = workspaces.FirstOrDefault(); selectedName = selected?.Value.Name ?? ""; composition = selected?.Value.Entries.ToList() ?? []; loading = false;
    }
    private void WorkspaceChanged(ChangeEventArgs args) { selectedName = args.Value?.ToString() ?? ""; selected = workspaces.First(value => value.Value.Name == selectedName); composition = selected.Value.Entries.ToList(); }
    private void ToggleEntry(EntryResponse entry, ChangeEventArgs args) { if (args.Value is true) composition.Add(new WorkspaceEntryReference { EntryResourceId = new(entry.Id), Role = composition.Count == 0 ? WorkspaceEntryRole.Primary : WorkspaceEntryRole.Standard, Order = composition.Count * 10 }); else composition.RemoveAll(value => value.EntryResourceId.Value == entry.Id); }
    private void ChangeRole(string entryId, ChangeEventArgs args) { var role = Enum.Parse<WorkspaceEntryRole>(args.Value?.ToString() ?? "Standard"); if (role == WorkspaceEntryRole.Primary) for (var i = 0; i < composition.Count; i++) if (composition[i].Role == WorkspaceEntryRole.Primary) composition[i] = composition[i] with { Role = WorkspaceEntryRole.Standard }; Replace(entryId, value => value with { Role = role }); }
    private void ChangeOrder(string entryId, ChangeEventArgs args) { _ = int.TryParse(args.Value?.ToString(), out var order); Replace(entryId, value => value with { Order = order }); }
    private void Replace(string entryId, Func<WorkspaceEntryReference, WorkspaceEntryReference> update) { var index = composition.FindIndex(value => value.EntryResourceId.Value == entryId); if (index >= 0) composition[index] = update(composition[index]); }
    private WorkplaceWorkspaceDraft Draft() => selected!.Value with { Entries = composition.OrderBy(value => value.Order).ToArray() };
    private async Task SaveAsync() => await ExecuteAsync(async () => { var saved = await Client.SaveWorkspaceAsync(Draft(), default); selected = selected! with { Value = saved }; message = $"Workspace draft revision {saved.Revision} saved. Workplace is unchanged."; });
    private async Task PublishAsync() => await ExecuteAsync(async () => { var saved = await Client.SaveWorkspaceAsync(Draft(), default); var published = await Client.PublishWorkspaceAsync(saved.Name, default); selected = new(saved, published); message = $"Workspace v{published.Version} published with {published.Entries.Count} Entries."; });
    private async Task ExecuteAsync(Func<Task> action) { busy = true; error = false; message = ""; try { await action(); } catch (Exception exception) { error = true; message = exception.Message; } finally { busy = false; } }
}
