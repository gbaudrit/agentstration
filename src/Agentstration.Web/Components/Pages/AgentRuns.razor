@page "/agent-runs"
@implements IDisposable
@inject IRuntimeApiClient Client
@inject Microsoft.Extensions.Localization.IStringLocalizer<AgentRunsStrings> Localizer
<PageTitle>@T("PageTitle")</PageTitle><PageHeader Title="@T("Title")" Description="@T("Description")" />
@if(items is null){<LoadingState Message="@T("Loading")"/>}else if(items.Count == 0){<EmptyState Title="@T("EmptyTitle")" Message="@T("EmptyMessage")"/>}else{<DataGrid TItem="ExecutionSummary" Items="items"><Header><tr><th>@T("Run")</th><th>Agent</th><th>@T("Status")</th><th>@T("Started")</th><th>@T("Duration")</th><th>@T("Outcome")</th></tr></Header><Row Context="item"><tr><td><code>@item.Id</code></td><td><strong>@item.Agent</strong></td><td><StatusBadge Text="@item.Status" Status="@PlatformDashboardService.ToStatus(item.Status)" /></td><td>@item.StartedAt.LocalDateTime.ToString("g")</td><td>@(item.Duration?.ToString("g")??T("Live"))</td><td>@(item.Error??item.Result??"—")</td></tr></Row></DataGrid>}
@code{private readonly CancellationTokenSource cancellation=new();private IReadOnlyList<ExecutionSummary>? items;protected override async Task OnInitializedAsync()=>items=await Client.GetExecutionsAsync(cancellation.Token);private string T(string key)=>Localizer[key];public void Dispose(){cancellation.Cancel();cancellation.Dispose();}}
