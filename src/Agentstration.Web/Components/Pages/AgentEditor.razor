@page "/agents/new"
@page "/agents/{ResourceGroup}/{Name}"
@implements IDisposable
@inject IManagementApiClient Client
@inject IAgentsModelClient AgentsModelClient
@inject IAgentRunnerRuntimeClient RuntimeClient
@inject NavigationManager Navigation
@inject NotificationState Notifications

<PageTitle>@(IsNew ? "Create agent" : Name) · Agentstration</PageTitle>

@if (IsNew)
{
    <PageHeader Eyebrow="Agent" Title="Create agent" Description="Define the desired state for a new specialized agent resource.">
        <Actions><a class="button-secondary" href="/agents">Back to agents</a></Actions>
    </PageHeader>
}

@if (loading || model is null)
{
    <LoadingState Message="Loading agent resource…" />
}
else
{
    @if (!IsNew)
    {
        <ResourceHeader ResourceType="Agent" Domain="agent" Icon="◎" Name="@model.DisplayName" Description="@model.Description" StatusText="@HeaderStatus" Status="@HeaderStatusTone">
            <Metadata><span><code>@model.Name</code></span><span>Generation @generation</span><span>@model.Location</span></Metadata>
            <Actions><a class="button-primary" href="@RunUrl">Run</a><button class="button-secondary" type="button" @onclick="ReconcileAsync" disabled="@(saving || isDirty)">Reconcile deployment</button></Actions>
        </ResourceHeader>
        <ResourceTabs Label="Agent sections"><a class="active" href="@OverviewUrl">Overview</a><a href="#definition">Definition</a><span>Deployments</span><a href="@RunUrl">Runs</a><span>Metrics</span><span>Events</span><span>Source</span></ResourceTabs>
        <StateComparison DesiredGeneration="@generation" ActiveGeneration="@ActiveGeneration" DesiredStatus="@(isDirty ? "Modified · not saved" : "Saved definition")" ActiveStatus="@ActiveStatus" RuntimeLabel="@ActiveRuntime" IsSynchronized="@IsStateSynchronized" Summary="@StateSummary">
            <Actions>@if (!IsStateSynchronized && !isDirty) { <button class="button-secondary" type="button" @onclick="ReconcileAsync" disabled="@saving">Apply generation</button> }</Actions>
        </StateComparison>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="form-alert form-alert-danger" role="alert"><strong>Unable to apply</strong><span>@errorMessage</span>@if (!string.IsNullOrWhiteSpace(errorId)) { <code>@errorId</code> }</div>
    }
    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="form-alert form-alert-success" role="status">@successMessage</div>
    }

    <EditForm Model="model" OnValidSubmit="() => SaveAsync(applyRuntimeOnSubmit)" FormName="agent-editor" class="resource-form" @oninput="MarkDirty" @onchange="MarkDirty">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <section class="panel form-section" id="definition">
            <div class="panel-header"><div><p class="eyebrow">Identity</p><h2>Resource coordinates</h2></div>@if (!IsNew) { <StatusBadge Text="@($"Generation {generation}")" Status="UiStatus.Info" /> }</div>
            <div class="form-grid">
                <label><span>Name</span><InputText @bind-Value="model.Name" disabled="@(!IsNew)" /><ValidationMessage For="() => model.Name" /></label>
                <label><span>Resource group</span><InputText @bind-Value="model.ResourceGroup" disabled="@(!IsNew)" /><ValidationMessage For="() => model.ResourceGroup" /></label>
                <label><span>Location</span><InputText @bind-Value="model.Location" /><ValidationMessage For="() => model.Location" /></label>
                <label><span>Display name</span><InputText @bind-Value="model.DisplayName" /><ValidationMessage For="() => model.DisplayName" /></label>
            </div>
            @if (!string.IsNullOrWhiteSpace(resourceId)) { <p class="resource-hint">Resource ID: <code>@resourceId</code></p> }
        </section>

        <section class="panel form-section">
            <div class="panel-header"><div><p class="eyebrow">Definition</p><h2>Behavior and model</h2></div></div>
            <div class="form-grid">
                <label class="form-span-2"><span>Description</span><InputTextArea @bind-Value="model.Description" rows="3" /></label>
                <label><span>Agent type</span>
                    <select value="@model.AgentTypeResourceId" @onchange="AgentTypeChanged">
                        <option value="">Select an agent type</option>
                        @foreach (var type in agentTypes) { <option value="@type.Id">@type.Name · v@type.Properties.Version</option> }
                    </select>
                    <ValidationMessage For="() => model.AgentTypeResourceId" />
                </label>
                <label><span>Agent type version</span><InputNumber @bind-Value="model.AgentTypeVersion" /><ValidationMessage For="() => model.AgentTypeVersion" /></label>
                <div class="form-span-2"><ModelProfilePicker Value="@model.ModelProfileResourceId" ValueChanged="ModelProfileChanged" /><ValidationMessage For="() => model.ModelProfileResourceId" /></div>
                <label class="form-span-2"><span>Additional instructions</span><InputTextArea @bind-Value="model.AdditionalInstructions" rows="6" /></label>
            </div>
        </section>

        @if (!IsNew)
        {
            <section class="panel form-section">
                <div class="panel-header"><div><p class="eyebrow">Model configuration</p><h2>Declared and resolved</h2></div>@if (agentModel is not null) { <StatusBadge Text="@ModelManagementUi.Label(agentModel.Status)" Status="@ModelManagementUi.Status(agentModel.Status)" /> }</div>
                <div class="declaration-resolution-grid">
                    <article><h3>Declared configuration</h3><dl class="resource-details"><dt>Model profile</dt><dd>@(agentModel?.Declared.ModelProfile.DisplayName ?? ResourceName(model.ModelProfileResourceId))</dd><dt>Resource ID</dt><dd><code>@model.ModelProfileResourceId</code></dd></dl>@if (agentModel is not null) { <a class="text-button" href="@ProfileUrl(agentModel)">Open model profile →</a> }</article>
                    <article><h3>Resolved configuration</h3>@if (agentModel is null) { <p class="inline-warning">@modelResolutionWarning</p> } else { <dl class="resource-details"><dt>Provider</dt><dd>@(agentModel.Resolved.Provider?.DisplayName ?? agentModel.Resolved.Provider?.Name ?? "Not resolved")</dd><dt>Provider type</dt><dd>@(agentModel.Resolved.Provider?.ProviderType ?? "Not resolved")</dd><dt>Model</dt><dd><code>@agentModel.Resolved.Model.Name</code></dd><dt>Status</dt><dd>@ModelManagementUi.Label(agentModel.Status)</dd></dl>@if (agentModel.Resolved.Provider is not null) { <a class="text-button" href="@ProviderUrl(agentModel)">Open provider →</a> }}</article>
                </div>
            </section>
        }

        <section class="panel form-section">
            <div class="panel-header"><div><p class="eyebrow">References</p><h2>Tools and tags</h2></div></div>
            <div class="form-grid">
                <label><span>Tool resource IDs</span><InputTextArea @bind-Value="model.ToolResourceIds" rows="7" /><small>One canonical Agentstration.Tools/tools resource ID per line.</small></label>
                <label><span>Tags</span><InputTextArea @bind-Value="model.Tags" rows="7" /><small>One key=value pair per line.</small></label>
            </div>
        </section>

        @if (IsNew)
        {
            <div class="form-actions"><a class="button-secondary" href="/agents">Cancel</a><button class="button-primary" type="submit" @onclick="() => applyRuntimeOnSubmit = true" disabled="@saving">@(saving ? "Creating…" : "Create and deploy")</button></div>
        }
        else
        {
            <UnsavedChangesBar IsVisible="@isDirty">
                <Actions><button class="button-secondary" type="button" @onclick="DiscardAsync" disabled="@saving">Discard</button><button class="button-secondary" type="submit" @onclick="() => applyRuntimeOnSubmit = false" disabled="@saving">Save draft</button><button class="button-primary" type="submit" @onclick="() => applyRuntimeOnSubmit = true" disabled="@saving">@(saving ? "Applying…" : "Save and apply")</button></Actions>
            </UnsavedChangesBar>
        }
    </EditForm>
}

@code {
    [Parameter] public string? ResourceGroup { get; set; }
    [Parameter] public string? Name { get; set; }

    private readonly CancellationTokenSource cancellation = new();
    private AgentEditorModel? model;
    private IReadOnlyList<AgentTypeResource> agentTypes = [];
    private string? etag;
    private string? resourceId;
    private string? errorMessage;
    private string? errorId;
    private string? successMessage;
    private string? modelResolutionWarning;
    private AgentModelResponse? agentModel;
    private AgentRuntimeReadinessResponse? readiness;
    private string provisioningStatus = "Valid";
    private long generation;
    private bool loading = true;
    private bool saving;
    private bool isDirty;
    private bool applyRuntimeOnSubmit = true;
    private bool IsNew => string.IsNullOrWhiteSpace(Name);
    private string OverviewUrl => $"/agents/{Uri.EscapeDataString(ResourceGroup ?? "default")}/{Uri.EscapeDataString(Name ?? string.Empty)}";
    private string RunUrl => $"{OverviewUrl}/run";
    private bool IsStateSynchronized => !isDirty && readiness?.Ready == true && readiness.Generation == generation;
    private long? ActiveGeneration => readiness?.Ready == true ? readiness.Generation : null;
    private string ActiveStatus => readiness?.Ready == true ? StatusPresentation.Label(readiness.State) : readiness?.Error ?? readiness?.State ?? "Not deployed";
    private string? ActiveRuntime => readiness?.RuntimeProfileId is null ? readiness?.DeploymentId : ResourceName(readiness.RuntimeProfileId);
    private string StateSummary => IsStateSynchronized ? $"Generation {generation} is ready." : isDirty ? "Save or apply the modified desired definition." : "The current generation is not active.";
    private string HeaderStatus => readiness?.Ready == true ? "Ready" : StatusPresentation.Label(provisioningStatus);
    private UiStatus HeaderStatusTone => readiness?.Ready == true ? UiStatus.Success : StatusPresentation.Tone(provisioningStatus);

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        errorMessage = null;
        try
        {
            var group = string.IsNullOrWhiteSpace(ResourceGroup) ? "default" : ResourceGroup;
            agentTypes = await Client.GetAgentTypesAsync(group, cancellation.Token);
            if (IsNew)
            {
                model = new AgentEditorModel { ResourceGroup = group };
                if (agentTypes.Count > 0) ApplyAgentType(agentTypes[0]);
            }
            else
            {
                var snapshot = await Client.GetAgentAsync(group, Name!, cancellation.Token);
                model = AgentEditorModel.FromResource(snapshot.Value);
                etag = snapshot.ETag;
                resourceId = snapshot.Value.Id;
                generation = snapshot.Value.Generation;
                provisioningStatus = snapshot.Value.Status.ProvisioningState.ToString();
                await LoadAgentModelAsync(group, Name!);
                await LoadReadinessAsync(group, Name!, generation);
            }
            isDirty = false;
        }
        catch (AgentstrationApiException exception)
        {
            errorMessage = exception.Message;
            errorId = exception.ErrorId;
            model ??= new AgentEditorModel();
        }
        finally { loading = false; }
    }

    private void AgentTypeChanged(ChangeEventArgs args)
    {
        if (model is null) return;
        var id = args.Value?.ToString() ?? string.Empty;
        var selected = agentTypes.FirstOrDefault(type => string.Equals(type.Id, id, StringComparison.Ordinal));
        if (selected is null) model.AgentTypeResourceId = id;
        else ApplyAgentType(selected);
    }

    private Task ModelProfileChanged(string value)
    {
        if (model is not null) { model.ModelProfileResourceId = value; isDirty = true; }
        return Task.CompletedTask;
    }

    private void MarkDirty(EventArgs _) => isDirty = true;
    private Task DiscardAsync() => OnParametersSetAsync();

    private static string ResourceName(string resourceId) => ResourceIdentifier.TryParse(resourceId, out var parsed) ? parsed.Name : resourceId;
    private static string ProfileUrl(AgentModelResponse value)
    {
        var id = ResourceIdentifier.Parse(value.Declared.ModelProfile.ResourceId);
        return $"/modelprofiles/{Uri.EscapeDataString(id.ResourceGroup)}/{Uri.EscapeDataString(id.Name)}";
    }
    private static string ProviderUrl(AgentModelResponse value)
    {
        var id = ResourceIdentifier.Parse(value.Resolved.Provider!.ResourceId);
        return $"/modelproviders/{Uri.EscapeDataString(id.ResourceGroup)}/{Uri.EscapeDataString(id.Name)}";
    }

    private async Task LoadAgentModelAsync(string resourceGroup, string name)
    {
        agentModel = null;
        modelResolutionWarning = null;
        try { agentModel = await AgentsModelClient.GetAgentModelResolutionAsync(resourceGroup, name, cancellation.Token); }
        catch (AgentstrationApiException exception) { modelResolutionWarning = exception.Message; }
    }

    private async Task LoadReadinessAsync(string resourceGroup, string name, long desiredGeneration)
    {
        readiness = null;
        try { readiness = await RuntimeClient.GetAgentReadinessAsync(resourceGroup, name, desiredGeneration, cancellation.Token); }
        catch (AgentstrationApiException) { }
    }

    private void ApplyAgentType(AgentTypeResource type)
    {
        if (model is null) return;
        model.AgentTypeResourceId = type.Id;
        model.AgentTypeVersion = type.Properties.Version;
        if (string.IsNullOrWhiteSpace(model.ModelProfileResourceId))
        {
            model.ModelProfileResourceId = ResourceIdentifier.TryParse(type.Properties.DefaultModelProfileId, out var parsed)
                ? parsed.Value
                : ResourceIdentifier.Create(model.ResourceGroup, AgentstrationProviderNamespaces.Models, "modelProfiles", type.Properties.DefaultModelProfileId).Value;
        }
    }

    private async Task SaveAsync(bool applyRuntime)
    {
        if (model is null) return;
        saving = true;
        errorMessage = null;
        errorId = null;
        successMessage = null;
        try
        {
            var wasNew = IsNew;
            var request = model.ToRequest();
            var snapshot = await Client.PutAgentAsync(request, etag, wasNew, cancellation.Token);
            etag = snapshot.ETag;
            resourceId = snapshot.Value.Id;
            generation = snapshot.Value.Generation;
            provisioningStatus = snapshot.Value.Status.ProvisioningState.ToString();
            model = AgentEditorModel.FromResource(snapshot.Value);
            isDirty = false;
            if (applyRuntime)
            {
                var activation = await RuntimeClient.PrepareAgentAsync(snapshot.Value.ResourceGroup!, snapshot.Value.Name, snapshot.Value.Generation, cancellation.Token);
                if (!string.Equals(activation.State, OperationalState.Ready.ToString(), StringComparison.Ordinal))
                {
                    var message = $"The agent definition was saved, but generation {snapshot.Value.Generation} could not be activated (runtime state: {activation.State}). The previous healthy generation remains active.";
                    Notifications.Add(new NotificationItem(Guid.NewGuid(), "Runtime activation failed", message, DateTimeOffset.Now, UiStatus.Warning));
                    if (wasNew) Navigation.NavigateTo($"/agents/{Uri.EscapeDataString(snapshot.Value.ResourceGroup!)}/{Uri.EscapeDataString(snapshot.Value.Name)}");
                    else { errorMessage = message; await LoadAgentModelAsync(snapshot.Value.ResourceGroup!, snapshot.Value.Name); await LoadReadinessAsync(snapshot.Value.ResourceGroup!, snapshot.Value.Name, snapshot.Value.Generation); }
                    return;
                }
            }

            successMessage = wasNew ? (applyRuntime ? "Agent created and deployed." : "Agent draft created.") : applyRuntime ? $"Agent updated and generation {snapshot.Value.Generation} activated." : $"Desired generation {snapshot.Value.Generation} saved without changing the active deployment.";
            Notifications.Add(new NotificationItem(Guid.NewGuid(), successMessage, snapshot.Value.Name, DateTimeOffset.Now, UiStatus.Success));
            if (wasNew)
                Navigation.NavigateTo($"/agents/{Uri.EscapeDataString(snapshot.Value.ResourceGroup!)}/{Uri.EscapeDataString(snapshot.Value.Name)}");
            else
            {
                await LoadAgentModelAsync(snapshot.Value.ResourceGroup!, snapshot.Value.Name);
                await LoadReadinessAsync(snapshot.Value.ResourceGroup!, snapshot.Value.Name, snapshot.Value.Generation);
            }
        }
        catch (ArgumentException exception) { errorMessage = exception.Message; }
        catch (AgentstrationApiException exception)
        {
            errorMessage = exception.IsConcurrencyConflict ? "This agent changed on the server. Reload the page before saving again." : exception.Message;
            errorId = exception.ErrorId;
        }
        finally { saving = false; }
    }

    private async Task ReconcileAsync()
    {
        if (model is null || IsNew || isDirty) return;
        saving = true;
        errorMessage = null;
        try
        {
            var activation = await RuntimeClient.PrepareAgentAsync(model.ResourceGroup, model.Name, generation, cancellation.Token);
            await LoadReadinessAsync(model.ResourceGroup, model.Name, generation);
            successMessage = string.Equals(activation.State, OperationalState.Ready.ToString(), StringComparison.Ordinal) ? $"Generation {generation} is active." : $"Reconciliation completed with state {activation.State}.";
        }
        catch (AgentstrationApiException exception) { errorMessage = exception.Message; errorId = exception.ErrorId; }
        finally { saving = false; }
    }

    public void Dispose()
    {
        cancellation.Cancel();
        cancellation.Dispose();
    }
}
