@page "/agents/new"
@page "/agents/{Name}"
@implements IDisposable
@inject IManagementApiClient Client
@inject IAgentsModelClient AgentsModelClient
@inject IAgentRunnerRuntimeClient RuntimeClient
@inject IRuntimeProfilesClient RuntimeProfilesClient
@inject IToolsClient ToolsClient
@inject NavigationManager Navigation
@inject NotificationState Notifications
@inject Microsoft.Extensions.Localization.IStringLocalizer<AgentEditorStrings> Localizer

<PageTitle>@(IsNew ? T("CreateAgent") : Name) · Agentstration</PageTitle>

@if (IsNew)
{
    <PageHeader Eyebrow="@T("Agent")" Title="@T("CreateAgent")" Description="@T("CreateDescription")">
        <Actions><a class="button-secondary" href="/agents">@T("BackToAgents")</a></Actions>
    </PageHeader>
}

@if (loading || model is null)
{
    <LoadingState Message="@T("Loading")" />
}
else
{
    @if (!IsNew)
    {
        <ResourceHeader ResourceType="@T("Agent")" Domain="agent" Icon="◎" Name="@model.DisplayName" Description="@model.Description" StatusText="@HeaderStatus" Status="@HeaderStatusTone">
            <Metadata><span><code>@model.Name</code></span><span>@T("Generation", generation)</span></Metadata>
            <Actions><a class="button-primary" href="@RunUrl">@T("Run")</a><button class="button-secondary" type="button" @onclick="ReconcileAsync" disabled="@(saving || isDirty)">@T("ReconcileDeployment")</button></Actions>
        </ResourceHeader>
        <ResourceTabs Label="@T("AgentSections")"><a class="active" href="@OverviewUrl">@T("Overview")</a><a href="#definition">@T("Definition")</a><span>@T("Deployments")</span><a href="@RunUrl">@T("Runs")</a><span>@T("Metrics")</span><span>@T("Events")</span><span>@T("Source")</span></ResourceTabs>
        <StateComparison DesiredGeneration="@generation" ActiveGeneration="@ActiveGeneration" DesiredStatus="@(isDirty ? T("ModifiedNotSaved") : T("SavedDefinition"))" ActiveStatus="@ActiveStatus" RuntimeLabel="@ActiveRuntime" IsSynchronized="@IsStateSynchronized" Summary="@StateSummary">
            <Actions>@if (!IsStateSynchronized && !isDirty) { <button class="button-secondary" type="button" @onclick="ReconcileAsync" disabled="@saving">@T("ApplyGeneration")</button> }</Actions>
        </StateComparison>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="form-alert form-alert-danger" role="alert"><strong>@T("UnableToApply")</strong><span>@errorMessage</span>@if (!string.IsNullOrWhiteSpace(errorId)) { <code>@errorId</code> }</div>
    }
    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="form-alert form-alert-success" role="status">@successMessage</div>
    }

    <EditForm Model="model" OnValidSubmit="() => SaveAsync(applyRuntimeOnSubmit)" FormName="agent-editor" class="resource-form" @oninput="MarkDirty" @onchange="MarkDirty">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <section class="panel form-section" id="definition">
            <div class="panel-header"><div><p class="eyebrow">@T("Identity")</p><h2>@T("ResourceCoordinates")</h2></div>@if (!IsNew) { <StatusBadge Text="@T("Generation", generation)" Status="UiStatus.Info" /> }</div>
            <div class="form-grid">
                <label><span>@T("Name")</span><InputText @bind-Value="model.Name" disabled="@(!IsNew)" /><ValidationMessage For="() => model.Name" /></label>
                <label><span>@T("Handler")</span><InputText @bind-Value="model.Handler" /><ValidationMessage For="() => model.Handler" /></label>
                <label><span>@T("DisplayName")</span><InputText @bind-Value="model.DisplayName" /><ValidationMessage For="() => model.DisplayName" /></label>
            </div>
            @if (!string.IsNullOrWhiteSpace(resourceId)) { <p class="resource-hint">@T("Uid"): <code>@resourceId</code></p> }
        </section>

        <section class="panel form-section">
            <div class="panel-header"><div><p class="eyebrow">@T("Definition")</p><h2>@T("BehaviorAndModel")</h2></div></div>
            <div class="form-grid">
                <label class="form-span-2"><span>@T("Description")</span><InputTextArea @bind-Value="model.Description" rows="3" /></label>
                <div class="form-span-2"><ModelProfilePicker Value="@model.ModelProfileName" Namespace="@model.ModelProfileNamespace" ValueChanged="ModelProfileChanged" SelectedChanged="ModelProfileSelectionChanged" SelectFirstWhenMissing="@IsNew" /><ValidationMessage For="() => model.ModelProfileName" /></div>
                <label class="form-span-2"><span>@T("RuntimeProfile")</span><select value="@RuntimeProfileValue" @onchange="RuntimeProfileChanged">@foreach (var profile in runtimeProfiles) { <option value="@RuntimeProfileValueFor(profile)">@profile.Properties.DisplayName — @profile.Namespace/@profile.Name</option> }</select><small>@T("RuntimeProfileHelp")</small></label>
                <label class="form-span-2"><span>@T("Instructions")</span><InputTextArea @bind-Value="model.Instructions" rows="6" /><ValidationMessage For="() => model.Instructions" /></label>
            </div>
        </section>

        @if (!IsNew)
        {
            <section class="panel form-section">
                <div class="panel-header"><div><p class="eyebrow">@T("ModelConfiguration")</p><h2>@T("DeclaredAndResolved")</h2></div>@if (agentModel is not null) { <StatusBadge Text="@ModelStatusLabel(agentModel.Status)" Status="@ModelManagementUi.Status(agentModel.Status)" /> }</div>
                <div class="declaration-resolution-grid">
                    <article><h3>@T("DeclaredConfiguration")</h3><dl class="resource-details"><dt>@T("ModelProfile")</dt><dd>@(agentModel?.Declared.ModelProfile.DisplayName ?? model.ModelProfileName)</dd><dt>@T("Name")</dt><dd><code>@model.ModelProfileName</code></dd></dl>@if (agentModel is not null) { <a class="text-button" href="@ProfileUrl(agentModel)">@T("OpenModelProfile") →</a> }</article>
                    <article><h3>@T("ResolvedConfiguration")</h3>@if (agentModel is null) { <p class="inline-warning">@modelResolutionWarning</p> } else { <dl class="resource-details"><dt>@T("Provider")</dt><dd>@(agentModel.Resolved.Provider?.DisplayName ?? agentModel.Resolved.Provider?.Name ?? T("NotResolved"))</dd><dt>@T("Contribution")</dt><dd>@(agentModel.Resolved.Provider?.ContributionId ?? T("NotResolved"))</dd><dt>@T("Model")</dt><dd><code>@agentModel.Resolved.Model.Name</code></dd><dt>@T("Status")</dt><dd>@ModelStatusLabel(agentModel.Status)</dd></dl>@if (agentModel.Resolved.Provider is not null) { <a class="text-button" href="@ProviderUrl(agentModel)">@T("OpenProvider") →</a> }}</article>
                </div>
            </section>
        }

        <section class="panel form-section">
            <div class="panel-header"><div><p class="eyebrow">@T("References")</p><h2>@T("ToolsAndTags")</h2></div></div>
            <div class="form-grid">
                <div><span class="field-label">@T("GovernedTools")</span>
                    @if (catalogTools.Count == 0) { <small>@T("NoDiscoveredTools")</small> }
                    @foreach (var tool in catalogTools)
                    {
                        var assigned = IsToolAssigned(tool.Metadata.Name); var usable = tool.Definition.Enabled && tool.Definition.Discovery?.Available == true;
                        <label><input type="checkbox" checked="@assigned" disabled="@(!usable && !assigned)" @onchange="args => ToggleTool(tool.Metadata.Name, (bool)args.Value!)" /> <span>@tool.Definition.DisplayName</span><small>@(tool.Definition.Provider?.Name ?? "—") · @(usable ? T("Available") : assigned ? T("AssignedUnavailable") : T("NotUsable"))</small></label>
                    }
                </div>
                <label><span>@T("Tags")</span><InputTextArea @bind-Value="model.Tags" rows="7" /><small>@T("TagsHelp")</small></label>
            </div>
        </section>

        @if (IsNew)
        {
            <div class="form-actions"><a class="button-secondary" href="/agents">@T("Cancel")</a><button class="button-primary" type="submit" @onclick="() => applyRuntimeOnSubmit = true" disabled="@saving">@(saving ? T("Creating") : T("CreateAndDeploy"))</button></div>
        }
        else
        {
            <UnsavedChangesBar IsVisible="@isDirty">
                <Actions><button class="button-secondary" type="button" @onclick="DiscardAsync" disabled="@saving">@T("Discard")</button><button class="button-secondary" type="submit" @onclick="() => applyRuntimeOnSubmit = false" disabled="@saving">@T("SaveDraft")</button><button class="button-primary" type="submit" @onclick="() => applyRuntimeOnSubmit = true" disabled="@saving">@(saving ? T("Applying") : T("SaveAndApply"))</button></Actions>
            </UnsavedChangesBar>
        }
    </EditForm>
}

@code {
    [Parameter] public string? Name { get; set; }

    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string ModelStatusLabel(string? status) => Localizer[$"Status.{status?.ToLowerInvariant() switch { "available" => "Available", "ready" => "Ready", "succeeded" => "Succeeded", "starting" => "Starting", "providerunavailable" => "ProviderUnavailable", "modelunavailable" => "ModelUnavailable", "unavailable" => "Unavailable", "invalidconfiguration" => "InvalidConfiguration", "incompatible" => "Incompatible", "failed" => "Failed", _ => "Unknown" }}"];

    private readonly CancellationTokenSource cancellation = new();
    private AgentEditorModel? model;
    private IReadOnlyList<ToolResource> catalogTools = [];
    private IReadOnlyList<RuntimeProfileSummaryResponse> runtimeProfiles = [];
    private string? etag;
    private string? resourceId;
    private string? errorMessage;
    private string? errorId;
    private string? successMessage;
    private string? modelResolutionWarning;
    private AgentModelResponse? agentModel;
    private AgentRuntimeReadinessResponse? readiness;
    private string provisioningStatus = "Valid";
    private long generation;
    private bool loading = true;
    private bool saving;
    private bool isDirty;
    private bool applyRuntimeOnSubmit = true;
    private bool IsNew => string.IsNullOrWhiteSpace(Name);
    private string OverviewUrl => $"/agents/{Uri.EscapeDataString(Name ?? string.Empty)}";
    private string RunUrl => $"{OverviewUrl}/run";
    private bool IsStateSynchronized => !isDirty && readiness?.Ready == true && readiness.Generation == generation;
    private long? ActiveGeneration => readiness?.Ready == true ? readiness.Generation : null;
    private string ActiveStatus => readiness?.Ready == true ? StatusPresentation.Label(readiness.State) : readiness?.Error ?? readiness?.State ?? T("NotDeployed");
    private string? ActiveRuntime => readiness?.RuntimeProfileId is null ? readiness?.DeploymentId : ResourceName(readiness.RuntimeProfileId);
    private string StateSummary => IsStateSynchronized ? T("GenerationReady", generation) : isDirty ? T("SaveOrApplyModified") : T("CurrentGenerationNotActive");
    private string HeaderStatus => readiness?.Ready == true ? T("Ready") : StatusPresentation.Label(provisioningStatus);
    private string RuntimeProfileValue => model is null ? string.Empty : $"{model.RuntimeProfileNamespace}:{model.RuntimeProfileName}";
    private UiStatus HeaderStatusTone => readiness?.Ready == true ? UiStatus.Success : StatusPresentation.Tone(provisioningStatus);

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        errorMessage = null;
        try
        {
            catalogTools = await ToolsClient.GetToolsAsync(cancellationToken: cancellation.Token);
            runtimeProfiles = await RuntimeProfilesClient.GetRuntimeProfilesAsync(cancellation.Token);
            if (IsNew)
            {
                model = new AgentEditorModel();
                var runtimeProfile = runtimeProfiles.FirstOrDefault();
                if (runtimeProfile is not null)
                {
                    model.RuntimeProfileName = runtimeProfile.Name;
                    model.RuntimeProfileNamespace = runtimeProfile.Namespace;
                }
            }
            else
            {
                var snapshot = await Client.GetAgentAsync(Name!, cancellation.Token);
                model = AgentEditorModel.FromResource(snapshot.Value);
                etag = snapshot.ETag;
                resourceId = snapshot.Value.Uid.ToString("D");
                generation = snapshot.Value.Generation;
                provisioningStatus = snapshot.Value.Status.ProvisioningState.ToString();
                await LoadAgentModelAsync(Name!);
                await LoadReadinessAsync(Name!, generation);
            }
            isDirty = false;
        }
        catch (AgentstrationApiException exception)
        {
            errorMessage = exception.Message;
            errorId = exception.ErrorId;
            model ??= new AgentEditorModel();
        }
        finally { loading = false; }
    }

    private Task ModelProfileChanged(string value)
    {
        if (model is not null) { model.ModelProfileName = value; isDirty = true; }
        return Task.CompletedTask;
    }

    private Task ModelProfileSelectionChanged(ModelProfileSummaryResponse? profile)
    {
        if (model is not null && profile is not null && model.SelectModelProfile(profile)) isDirty = true;
        return Task.CompletedTask;
    }

    private void MarkDirty(EventArgs _) => isDirty = true;
    private bool IsToolAssigned(string id) => model?.ToolNames.Split(['\r','\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Contains(id, StringComparer.Ordinal) == true;
    private void ToggleTool(string id, bool selected)
    {
        if (model is null) return;
        var values = model.ToolNames.Split(['\r','\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        if (selected && !values.Contains(id, StringComparer.Ordinal)) values.Add(id); else if (!selected) values.RemoveAll(value => value == id);
        model.ToolNames = string.Join(Environment.NewLine, values); isDirty = true;
    }
    private Task DiscardAsync() => OnParametersSetAsync();

    private static string ResourceName(string name) => name;
    private static string ProfileUrl(AgentModelResponse value)
    {
        return ConsoleResourceUrls.ModelProfile(ResourceAddress.Create(ResourceNamespace.Parse(value.Declared.ModelProfile.Namespace), ResourceKinds.ModelProfile, value.Declared.ModelProfile.ResourceId));
    }

    private void RuntimeProfileChanged(ChangeEventArgs args)
    {
        if (model is null) return;
        var parts = args.Value?.ToString()?.Split(':', 2);
        if (parts is not { Length: 2 }) return;
        model.RuntimeProfileNamespace = parts[0];
        model.RuntimeProfileName = parts[1];
        isDirty = true;
    }

    private static string RuntimeProfileValueFor(RuntimeProfileSummaryResponse profile) => $"{profile.Namespace}:{profile.Name}";
    private static string ProviderUrl(AgentModelResponse value)
    {
        var provider = value.Resolved.Provider!;
        return $"/modelproviders/{Uri.EscapeDataString(provider.ResourceId)}?namespace={Uri.EscapeDataString(provider.Namespace)}";
    }

    private async Task LoadAgentModelAsync(string name)
    {
        agentModel = null;
        modelResolutionWarning = null;
        try { agentModel = await AgentsModelClient.GetAgentModelResolutionAsync(name, cancellation.Token); }
        catch (AgentstrationApiException exception) { modelResolutionWarning = exception.Message; }
    }

    private async Task LoadReadinessAsync(string name, long desiredGeneration)
    {
        readiness = null;
        try { readiness = await RuntimeClient.GetAgentReadinessAsync(name, desiredGeneration, cancellation.Token); }
        catch (AgentstrationApiException) { }
    }

    private async Task SaveAsync(bool applyRuntime)
    {
        if (model is null) return;
        saving = true;
        errorMessage = null;
        errorId = null;
        successMessage = null;
        try
        {
            var wasNew = IsNew;
            var request = model.ToRequest();
            var snapshot = await Client.PutAgentAsync(request, etag, wasNew, cancellation.Token);
            etag = snapshot.ETag;
            resourceId = snapshot.Value.Uid.ToString("D");
            generation = snapshot.Value.Generation;
            provisioningStatus = snapshot.Value.Status.ProvisioningState.ToString();
            model = AgentEditorModel.FromResource(snapshot.Value);
            isDirty = false;
            if (applyRuntime)
            {
                var activation = await RuntimeClient.PrepareAgentAsync(snapshot.Value.Name, snapshot.Value.Generation, cancellation.Token);
                if (!string.Equals(activation.State, OperationalState.Ready.ToString(), StringComparison.Ordinal))
                {
                    var message = T("ActivationFailedMessage", snapshot.Value.Generation, activation.State);
                    Notifications.Add(new NotificationItem(Guid.NewGuid(), T("ActivationFailed"), message, DateTimeOffset.Now, UiStatus.Warning));
                    if (wasNew) Navigation.NavigateTo($"/agents/{Uri.EscapeDataString(snapshot.Value.Name)}");
                    else { errorMessage = message; await LoadAgentModelAsync(snapshot.Value.Name); await LoadReadinessAsync(snapshot.Value.Name, snapshot.Value.Generation); }
                    return;
                }
            }

            successMessage = wasNew ? (applyRuntime ? T("AgentCreatedDeployed") : T("AgentDraftCreated")) : applyRuntime ? T("AgentUpdatedActivated", snapshot.Value.Generation) : T("GenerationSavedWithoutDeployment", snapshot.Value.Generation);
            Notifications.Add(new NotificationItem(Guid.NewGuid(), successMessage, snapshot.Value.Name, DateTimeOffset.Now, UiStatus.Success));
            if (wasNew)
                Navigation.NavigateTo($"/agents/{Uri.EscapeDataString(snapshot.Value.Name)}");
            else
            {
                await LoadAgentModelAsync(snapshot.Value.Name);
                await LoadReadinessAsync(snapshot.Value.Name, snapshot.Value.Generation);
            }
        }
        catch (ArgumentException exception) { errorMessage = exception.Message; }
        catch (AgentstrationApiException exception)
        {
            errorMessage = exception.IsConcurrencyConflict ? T("ConcurrencyConflict") : exception.Message;
            errorId = exception.ErrorId;
        }
        finally { saving = false; }
    }

    private async Task ReconcileAsync()
    {
        if (model is null || IsNew || isDirty) return;
        saving = true;
        errorMessage = null;
        try
        {
            var activation = await RuntimeClient.PrepareAgentAsync(model.Name, generation, cancellation.Token);
            await LoadReadinessAsync(model.Name, generation);
            successMessage = string.Equals(activation.State, OperationalState.Ready.ToString(), StringComparison.Ordinal) ? T("GenerationActive", generation) : T("ReconciliationCompleted", activation.State);
        }
        catch (AgentstrationApiException exception) { errorMessage = exception.Message; errorId = exception.ErrorId; }
        finally { saving = false; }
    }

    public void Dispose()
    {
        cancellation.Cancel();
        cancellation.Dispose();
    }
}
