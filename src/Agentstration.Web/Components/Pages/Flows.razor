@page "/flows"
@implements IDisposable
@inject IFlowApiClient Client
<PageTitle>Flows · Agentstration</PageTitle>
<PageHeader Title="Flows" Description="Define orchestrations and inspect every execution from one operational workspace.">
    <Actions><a class="button-primary" href="/flows/new">New flow</a><a class="button-secondary" href="/flow-runs">View all runs</a></Actions>
</PageHeader>
<nav class="section-tabs" aria-label="Flow sections"><a class="active" href="/flows">Definitions</a><a href="/flow-runs">Runs</a><a href="/flows#deployments">Deployments</a></nav>
@if (items is null) { <LoadingState /> }
else if (items.Count == 0) { <EmptyState Title="No Flow definitions" Message="Create and publish a Flow through the API to begin." /> }
else
{
    <DataGrid TItem="FlowSummary" Items="items">
        <Header><tr><th>Flow</th><th>Namespace</th><th>Kind</th><th>Version</th><th>Status</th><th>Updated</th><th></th></tr></Header>
        <Row Context="item"><tr><td><strong>@item.Name</strong><br/><code>@item.Id</code></td><td><code>@item.Namespace.Value</code></td><td>@item.Kind</td><td>@item.Version</td><td><StatusBadge Text="@item.Status" Status="@PlatformDashboardService.ToStatus(item.Status)" /></td><td>@item.UpdatedAt.LocalDateTime.ToString("g")</td><td><a class="text-button" href="@item.DetailsUrl">Open</a></td></tr></Row>
    </DataGrid>
}
@code {
    private readonly CancellationTokenSource cancellation = new();
    private IReadOnlyList<FlowSummary>? items;
    protected override async Task OnInitializedAsync() => items = await Client.GetFlowsAsync(cancellation.Token);
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
