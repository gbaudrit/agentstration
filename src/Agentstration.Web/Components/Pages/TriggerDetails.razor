@page "/triggers/{Name}"
@rendermode InteractiveServer
@using Agentstration.Management.Core
@inject TriggerManagementService Management
@inject TriggerFiringService Firing
@inject NavigationManager Navigation
@inject NotificationState Notifications
@inject ConsoleContextState ContextState
@inject TimeProvider TimeProvider

<PageTitle>Trigger · Agentstration</PageTitle>
@if (loading)
{
    <LoadingState Message="Loading Trigger operations…" />
}
else if (notFound || stored is null)
{
    <EmptyState Title="Trigger not found" Message="The requested Trigger no longer exists."><a class="button-secondary" href="/triggers">Back to Triggers</a></EmptyState>
}
else
{
    var trigger = stored.Value;
    <PageHeader Title="@trigger.Definition.DisplayName" Description="@($"Trigger · {trigger.Namespace.Value}/{trigger.Name}")">
        <Metadata><StatusBadge Text="@(trigger.Definition.Enabled ? "Enabled" : "Disabled")" Status="@(trigger.Definition.Enabled ? UiStatus.Success : UiStatus.Neutral)" /><span>Generation @trigger.Generation</span></Metadata>
        <Actions>
            @if (CanExecute) { <button class="button-primary" disabled="@(!trigger.Definition.Enabled || running)" @onclick="RunNowAsync">@(running ? "Submitting…" : "Run now")</button> }
            @if (CanManage)
            {
                @if (trigger.Definition.Enabled) { <button class="button-secondary" disabled="@changingState" @onclick="DisableAsync">@(changingState ? "Disabling…" : "Disable")</button> }
                else { <button class="button-primary" @onclick="() => confirmEnable = true">Enable</button> }
                <a class="button-secondary" href="@($"/triggers/{Uri.EscapeDataString(trigger.Name)}/edit")">Edit</a>
                <button class="button-danger" @onclick="() => confirmDelete = true">Delete</button>
            }
            <a class="button-secondary" href="/triggers">Back</a>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrWhiteSpace(message)) { <div class="form-alert @(hasError ? "form-alert-danger" : "form-alert-success")" role="@(hasError ? "alert" : "status")">@message</div> }
    @if (trigger.Observed.LastOutcome == TriggerLastOutcome.Failed)
    {
        <section class="panel trigger-attention"><div class="panel-header"><div><p class="eyebrow">Requires attention</p><h2>Last firing failed before Work submission</h2></div><StatusBadge Text="Failed" Status="UiStatus.Danger" /></div><p>@(trigger.Observed.LastErrorCode ?? "Unknown Trigger error")</p></section>
    }

    <div class="trigger-detail-grid">
        <div class="trigger-detail-stack">
            <section class="panel">
                <div class="panel-header"><div><p class="eyebrow">When</p><h2>Schedule</h2></div><StatusBadge Text="@trigger.Definition.Source.Schedule!.Type.ToString()" Status="UiStatus.Info" /></div>
                <dl class="resource-details"><dt>Definition</dt><dd>@TriggerUi.ScheduleLabel(trigger.Definition.Source.Schedule)</dd><dt>Next occurrence</dt><dd>@TriggerUi.FormatDate(trigger.Observed.NextOccurrenceAt)</dd><dt>Last scheduled</dt><dd>@TriggerUi.FormatDate(trigger.Observed.LastScheduledAt)</dd><dt>Last fired</dt><dd>@TriggerUi.FormatDate(trigger.Observed.LastFiredAt)</dd><dt>Misfire</dt><dd>@MisfireLabel(trigger.Definition.MisfirePolicy)</dd><dt>Concurrency</dt><dd>@ConcurrencyLabel(trigger.Definition.ConcurrencyPolicy)</dd></dl>
            </section>
            <section class="panel">
                <div class="panel-header"><div><p class="eyebrow">What</p><h2>Work submission</h2></div></div>
                <dl class="resource-details"><dt>Target kind</dt><dd>Flow</dd><dt>Flow</dt><dd><a href="@FlowUrl(trigger)">@trigger.Definition.Target.Flow!.Name</a></dd><dt>Resolution</dt><dd>@(trigger.Definition.Target.Flow.Version is null ? "Active version at firing, then pinned" : $"Pinned {trigger.Definition.Target.Flow.Version}")</dd><dt>Input</dt><dd><pre class="trigger-input">@PrettyInput(trigger.Definition.Input)</pre></dd></dl>
            </section>
        </div>
        <aside class="trigger-detail-stack">
            <section class="panel">
                <div class="panel-header"><div><p class="eyebrow">Security</p><h2>Execution identity</h2></div></div>
                @if (trigger.Definition.ExecutionScope is { } scope)
                {
                    <dl class="resource-details"><dt>Principal</dt><dd><code>@Short(scope.PrincipalId)</code></dd><dt>Workspace</dt><dd><code>@Short(scope.WorkspaceId)</code></dd><dt>Authorization</dt><dd>Re-evaluated for every firing</dd><dt>Revocation</dt><dd>Fails closed</dd></dl>
                }
                else { <p>No execution identity is captured while this Trigger remains disabled.</p> }
            </section>
            <section class="panel">
                <div class="panel-header"><div><p class="eyebrow">Observed</p><h2>Current status</h2></div><StatusBadge Text="@trigger.Observed.LastOutcome.ToString()" Status="@OutcomeStatus(trigger.Observed.LastOutcome)" /></div>
                <dl class="resource-details"><dt>Enabled</dt><dd>@(trigger.Definition.Enabled ? "Yes" : "No")</dd><dt>Last outcome</dt><dd>@trigger.Observed.LastOutcome</dd><dt>Error code</dt><dd><code>@(trigger.Observed.LastErrorCode ?? "—")</code></dd><dt>UID</dt><dd><code>@Short(trigger.Uid)</code></dd></dl>
            </section>
        </aside>
    </div>

    <section class="panel trigger-history">
        <div class="panel-header"><div><p class="eyebrow">History</p><h2>Trigger occurrences</h2></div><button class="text-button" disabled="@refreshing" @onclick="LoadHistoryAsync">@(refreshing ? "Refreshing…" : "Refresh")</button></div>
        @if (history.Count == 0) { <EmptyState Title="No occurrences" Message="Use Run now or enable the schedule to create the first occurrence." /> }
        else
        {
            <DataGrid TItem="TriggerOccurrence" Items="history">
                <Header><tr><th>Kind</th><th>Scheduled</th><th>Actually fired</th><th>Outcome</th><th>Generation</th><th>Work / details</th></tr></Header>
                <Row Context="occurrence"><tr>
                    <td>@occurrence.Kind</td><td>@TriggerUi.FormatDate(occurrence.ScheduledAt)</td><td>@TriggerUi.FormatDate(occurrence.FiredAt)</td>
                    <td><StatusBadge Text="@occurrence.Outcome.ToString()" Status="@OccurrenceStatus(occurrence.Outcome)" /></td><td>@occurrence.TriggerGeneration</td>
                    <td>@if (TaskUrl(occurrence) is { } taskUrl) { <a class="text-button" href="@taskUrl">Open Task</a> } else if (occurrence.ErrorCode is not null) { <details><summary>@occurrence.ErrorCode</summary><p>@occurrence.ErrorMessage</p></details> } else { <span>—</span> }</td>
                </tr></Row>
            </DataGrid>
        }
    </section>
}

<ConfirmationDialog IsOpen="@confirmEnable" Title="Enable Trigger?" Message="@EnableMessage" ConfirmLabel="Enable Trigger" OnConfirm="EnableAsync" OnCancel="() => confirmEnable = false" />
<ConfirmationDialog IsOpen="@confirmDelete" Title="Delete Trigger?" Message="Deleting the desired Trigger removes its future schedule. Existing Work, Tasks and occurrence history are not changed retroactively." ConfirmLabel="Delete Trigger" OnConfirm="DeleteAsync" OnCancel="() => confirmDelete = false" />

@code {
    [Parameter] public string Name { get; set; } = "";
    private StoredResource<TriggerResource>? stored;
    private IReadOnlyList<TriggerOccurrence> history = [];
    private bool loading = true, notFound, running, changingState, refreshing, confirmEnable, confirmDelete, hasError;
    private string? message;
    private bool CanManage => ContextState.HasPermission(AuthorizationPermissions.ResourcesWrite);
    private bool CanExecute => ContextState.HasPermission(AuthorizationPermissions.RunsExecute);
    private string EnableMessage => stored is null ? "Enable this Trigger?" : $"Enable '{stored.Value.Definition.DisplayName}' and schedule {TriggerUi.ScheduleLabel(stored.Value.Definition.Source.Schedule)} against Flow '{stored.Value.Definition.Target.Flow?.Name}'? Future firings execute as the current principal and re-evaluate authorization.";

    protected override async Task OnParametersSetAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        loading = true; notFound = false; message = null;
        try { stored = await Management.GetAsync(ResourceNamespace.Default, Name, CancellationToken.None); if (stored is null) { notFound = true; return; } await LoadHistoryAsync(); }
        catch (Exception exception) { SetError(exception); }
        finally { loading = false; }
    }
    private async Task LoadHistoryAsync() { if (stored is null) return; refreshing = true; try { history = await Firing.ListHistoryAsync(stored.Value.WorkspaceId, stored.Value.Uid, 100, CancellationToken.None); } catch (Exception exception) { SetError(exception); } finally { refreshing = false; } }
    private async Task RunNowAsync() { if (stored is null || running || !CanExecute) return; running = true; ClearMessage(); try { var occurrence = await Firing.RunNowAsync(stored.Value.Namespace, stored.Value.Name, CancellationToken.None); SetSuccess(occurrence.WorkItemId is null ? $"Run now completed with outcome {occurrence.Outcome}." : $"Work {Short(occurrence.WorkItemId)} submitted."); Notifications.Add(new(Guid.NewGuid(), "Trigger fired", stored.Value.Definition.DisplayName, TimeProvider.GetLocalNow(), UiStatus.Success)); await ReloadAsync(); } catch (Exception exception) { SetError(exception); } finally { running = false; } }
    private async Task EnableAsync() { confirmEnable = false; await SetEnabledAsync(true); }
    private async Task DisableAsync() => await SetEnabledAsync(false);
    private async Task SetEnabledAsync(bool enabled) { if (stored is null || changingState || !CanManage) return; changingState = true; ClearMessage(); try { stored = await Management.UpdateAsync(stored.Value.Namespace, stored.Value.Name, stored.Value.Definition with { Enabled = enabled }, stored.ETag, CancellationToken.None); SetSuccess(enabled ? "Trigger enabled. Future occurrences will be scheduled." : "Trigger disabled. No further scheduled occurrences will fire."); Notifications.Add(new(Guid.NewGuid(), enabled ? "Trigger enabled" : "Trigger disabled", stored.Value.Definition.DisplayName, TimeProvider.GetLocalNow(), enabled ? UiStatus.Success : UiStatus.Neutral)); await LoadHistoryAsync(); } catch (Exception exception) { SetError(exception); } finally { changingState = false; } }
    private async Task DeleteAsync() { if (stored is null || !CanManage) return; confirmDelete = false; try { await Management.DeleteAsync(stored.Value.Namespace, stored.Value.Name, stored.ETag, CancellationToken.None); Notifications.Add(new(Guid.NewGuid(), "Trigger deleted", stored.Value.Definition.DisplayName, TimeProvider.GetLocalNow(), UiStatus.Neutral)); Navigation.NavigateTo("/triggers"); } catch (Exception exception) { SetError(exception); } }
    private async Task ReloadAsync() { if (stored is null) return; stored = await Management.GetAsync(stored.Value.Namespace, stored.Value.Name, CancellationToken.None); await LoadHistoryAsync(); }
    private void ClearMessage() { message = null; hasError = false; }
    private void SetSuccess(string value) { message = value; hasError = false; }
    private void SetError(Exception exception) { message = exception.Message; hasError = true; }
    private static string FlowUrl(TriggerResource value) { var flow = value.Definition.Target.Flow!; return ConsoleResourceUrls.Flow(new FlowId(flow.Name, flow.Namespace ?? value.Namespace)); }
    private static string? TaskUrl(TriggerOccurrence value) => Guid.TryParse(value.WorkItemId, out var taskId) ? $"/tasks/{taskId:D}" : null;
    private static string Short(Guid value) => value.ToString("N")[..12];
    private static string Short(string value) => value.Length <= 12 ? value : value[..12];
    private static string PrettyInput(JsonElement value) => JsonSerializer.Serialize(value, new JsonSerializerOptions { WriteIndented = true });
    private static string MisfireLabel(TriggerMisfirePolicy value) => value == TriggerMisfirePolicy.FireOnce ? "Fire once after recovery" : "Skip missed occurrence";
    private static string ConcurrencyLabel(TriggerConcurrencyPolicy value) => value == TriggerConcurrencyPolicy.Skip ? "Skip while previous Work is active" : "Allow overlapping Work";
    private static UiStatus OutcomeStatus(TriggerLastOutcome value) => value switch { TriggerLastOutcome.Submitted => UiStatus.Success, TriggerLastOutcome.Skipped => UiStatus.Warning, TriggerLastOutcome.Failed => UiStatus.Danger, _ => UiStatus.Neutral };
    private static UiStatus OccurrenceStatus(TriggerOccurrenceOutcome value) => value switch { TriggerOccurrenceOutcome.Submitted => UiStatus.Success, TriggerOccurrenceOutcome.Skipped => UiStatus.Warning, TriggerOccurrenceOutcome.Failed => UiStatus.Danger, TriggerOccurrenceOutcome.Pending => UiStatus.Info, _ => UiStatus.Neutral };
}
