@page "/settings"
@using Agentstration.Web.Configuration
@using Microsoft.Extensions.Options
@inject IOptions<AgentstrationWebOptions> Options
@inject Microsoft.Extensions.Localization.IStringLocalizer<SettingsStrings> Localizer
<PageTitle>@T("PageTitle")</PageTitle><PageHeader Title="@T("ConsoleSettings")" Description="@T("PageDescription")" />
<section class="dashboard-grid"><article class="panel"><div class="panel-header"><h2>@T("DataSource")</h2><StatusBadge Text="@T("CanonicalHttpApis")" Status="UiStatus.Success" /></div><p>@T("DataSourceDescription")</p></article><article class="panel"><div class="panel-header"><h2>@T("Authentication")</h2></div><HealthIndicator Label="@T("CurrentMode")" StatusText="@Options.Value.Authentication.Mode" Status="@(Options.Value.Authentication.Mode == AuthenticationOptions.Development ? UiStatus.Warning : UiStatus.Success)" /><p>@T("AuthenticationDescription")</p></article></section>
<article class="panel" style="margin-top:18px"><div class="panel-header"><h2>@T("ApiEndpoints")</h2></div><DataGrid TItem="(string Name,string Address)" Items="Endpoints"><Header><tr><th>@T("Plane")</th><th>@T("BaseAddress")</th></tr></Header><Row Context="item"><tr><td>@item.Name</td><td><code>@item.Address</code></td></tr></Row></DataGrid></article>
@code{private IReadOnlyList<(string Name,string Address)> Endpoints=>[("Management",Options.Value.ManagementApi.BaseAddress),("Runtime",Options.Value.RuntimeApi.BaseAddress),("Work",Options.Value.WorkApi.BaseAddress),("Flow",Options.Value.FlowApi.BaseAddress)];}
@code{private string T(string key)=>Localizer[key];}
