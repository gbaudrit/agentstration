@page "/settings"
@using Agentstration.Web.Configuration
@using Microsoft.Extensions.Options
@inject IOptions<AgentstrationWebOptions> Options
<PageTitle>Settings · Agentstration</PageTitle><PageHeader Title="Console settings" Description="Web preferences, API connections and authentication posture. Secrets remain server-side." />
<section class="dashboard-grid"><article class="panel"><div class="panel-header"><h2>Data source</h2><StatusBadge Text="@(Options.Value.UseSimulatedData?"Simulated":"HTTP APIs")" Status="@(Options.Value.UseSimulatedData?UiStatus.Warning:UiStatus.Success)" /></div><p>@(Options.Value.UseSimulatedData?"Development data is isolated behind the same API client abstractions used by the console.":"Typed HTTP clients connect to the configured public Agentstration APIs.")</p></article><article class="panel"><div class="panel-header"><h2>Authentication</h2></div><HealthIndicator Label="Current mode" StatusText="@Options.Value.Authentication.Mode" Status="@(Options.Value.Authentication.Mode == AuthenticationOptions.Development ? UiStatus.Warning : UiStatus.Success)" /><p>Local accounts use ASP.NET Core Identity; external identities use OIDC. Both resolve to the same Agentstration Principal and Workspace authorization model.</p></article></section>
<article class="panel" style="margin-top:18px"><div class="panel-header"><h2>API endpoints</h2></div><DataGrid TItem="(string Name,string Address)" Items="Endpoints"><Header><tr><th>Plane</th><th>Base address</th></tr></Header><Row Context="item"><tr><td>@item.Name</td><td><code>@item.Address</code></td></tr></Row></DataGrid></article>
@code{private IReadOnlyList<(string Name,string Address)> Endpoints=>[("Management",Options.Value.ManagementApi.BaseAddress),("Runtime",Options.Value.RuntimeApi.BaseAddress),("Work",Options.Value.WorkApi.BaseAddress),("Flow",Options.Value.FlowApi.BaseAddress)];}
