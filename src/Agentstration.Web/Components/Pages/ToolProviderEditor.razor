@page "/tools/providers/new"
@page "/tools/providers/{Name}"
@inject IToolsClient Client
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<ToolProviderEditorStrings> Localizer

<PageTitle>@(IsNew ? T("AddProvider") : displayName) · Agentstration</PageTitle>
<PageHeader Title="@(IsNew ? T("AddProvider") : displayName)" Description="@T("Description")"><Actions><a class="button-secondary" href="/tools/providers">@T("Back")</a>@if (!IsNew) { <button class="button-secondary" @onclick="TestAsync" disabled="@busy">@T("TestConnection")</button><button class="button-primary" @onclick="RefreshAsync" disabled="@busy">@T("RefreshDiscovery")</button> }</Actions></PageHeader>

@if (loading) { <LoadingState Message="@T("Loading")" /> }
else
{
    @if (message is not null) { <div class="form-alert @(failed ? "form-alert-danger" : "form-alert-success")">@message</div> }
    @if (!IsNew) { <ResourceTabs Label="@T("SectionsLabel")"><a class="active" href="@SectionUrl("overview")">@T("Overview")</a><a href="@SectionUrl("tools")">@T("Tools")</a><a href="@SectionUrl("connection")">@T("Connection")</a></ResourceTabs> }
    <section class="panel form-section" id="overview"><div class="panel-header"><h2>@T("Overview")</h2></div><div class="form-grid">
        <label><span>@T("Name")</span><input @bind="name" disabled="@(!IsNew)" /></label><label><span>@T("DisplayName")</span><input @bind="displayName" /></label>
        <label><span>@T("ProviderType")</span><select @bind="providerType" disabled="@(!IsNew)"><option value="Mcp">MCP</option><option value="Aep">AEP</option></select></label>
        <label><span>@T("Enabled")</span><input type="checkbox" @bind="enabled" /></label>
        @if (!IsNew) { <div><span class="field-label">@T("Status")</span><p>@StatusLabel(provider?.Definition.Discovery.Status)</p></div><div><span class="field-label">@T("LastDiscovery")</span><p>@(provider?.Definition.Discovery.LastDiscoveryAt?.ToString("g") ?? T("Never"))</p></div> }
    </div></section>
    <section class="panel form-section" id="connection"><div class="panel-header"><h2>@T("Connection")</h2></div><div class="form-grid">
        @if (providerType == ToolProviderType.Aep) { <label class="form-span-2"><span>@T("AepExtensionId")</span><input @bind="extensionId" /></label> }
        else { <label><span>@T("Transport")</span><select @bind="transport"><option value="Stdio">STDIO</option><option value="StreamableHttp">Streamable HTTP</option></select></label>
            @if (transport == McpToolProviderTransport.Stdio) { <label><span>@T("Command")</span><input @bind="command" placeholder="npx" /></label><label class="form-span-2"><span>@T("Arguments")</span><textarea @bind="arguments" rows="4"></textarea></label><label><span>@T("WorkingDirectory")</span><input @bind="workingDirectory" /></label><label><span>@T("EnvironmentReferences")</span><textarea @bind="environmentReferences" rows="4" placeholder="TOKEN=Secrets:Mcp:Token"></textarea><small>@T("EnvironmentReferencesHelp")</small></label> }
            else { <label class="form-span-2"><span>@T("Endpoint")</span><input @bind="endpoint" placeholder="https://server.example/mcp" /></label> }
        }
    </div></section>
    <div class="form-actions"><button class="button-primary" @onclick="SaveAsync" disabled="@busy">@(busy ? T("Saving") : T("SaveProvider"))</button></div>

    @if (!IsNew) { <section class="panel" id="tools"><div class="panel-header"><div><h2>@T("Tools")</h2><p>@T("ToolsDiscovered", ToolCount(tools.Count))</p></div></div>
        @if (tools.Count == 0) { <EmptyState Title="@T("NoToolsTitle")" Message="@T("NoToolsMessage")" /> }
        else { <DataGrid TItem="ToolResource" Items="tools"><Header><tr><th>@T("Name")</th><th>@T("Status")</th><th>@T("Enabled")</th><th></th></tr></Header><Row Context="tool"><tr><td><strong>@tool.Definition.DisplayName</strong><br/><code>@tool.Definition.ExternalId</code></td><td>@AvailabilityLabel(tool.Definition.Discovery?.Available == true)</td><td><input type="checkbox" checked="@tool.Definition.Enabled" @onchange="args => EnableAsync(tool, (bool)args.Value!)" /></td><td><a class="text-button" href="@($"/tools/{Uri.EscapeDataString(tool.Name)}")">@T("Inspect")</a></td></tr></Row></DataGrid> }
    </section> }
}

@code {
    [Parameter] public string? Name { get; set; }
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string ToolCount(int count) => T(count == 1 ? "ToolCount.One" : "ToolCount.Many", count);
    private string AvailabilityLabel(bool available) => T(available ? "Available" : "Unavailable");
    private string StatusLabel(string? status) { if (status is null) return "—"; var value = Localizer[$"Status.{status}"]; return value.ResourceNotFound ? status : value.Value; }
    private bool IsNew => string.IsNullOrWhiteSpace(Name); private bool loading = true, busy, failed; private string? message, etag; private ToolProviderResource? provider; private IReadOnlyList<ToolResource> tools = [];
    private string name = "", displayName = "", extensionId = "", command = "", arguments = "", workingDirectory = "", endpoint = "", environmentReferences = ""; private bool enabled = true; private ToolProviderType providerType = ToolProviderType.Mcp; private McpToolProviderTransport transport = McpToolProviderTransport.Stdio;
    protected override async Task OnParametersSetAsync() { loading = true; if (!IsNew) { var snapshot = await Client.GetProviderAsync(Name!, default); provider = snapshot.Value; etag = snapshot.ETag; From(provider); tools = await Client.GetToolsAsync(provider.Name); } loading = false; }
    private void From(ToolProviderResource value) { name=value.Name; displayName=value.Definition.DisplayName; enabled=value.Definition.Enabled; providerType=value.Definition.ProviderType; extensionId=value.Definition.Aep?.ExtensionId??""; transport=value.Definition.Mcp?.Transport??McpToolProviderTransport.Stdio; command=value.Definition.Mcp?.Command??""; arguments=string.Join(Environment.NewLine,value.Definition.Mcp?.Arguments??[]); workingDirectory=value.Definition.Mcp?.WorkingDirectory??""; endpoint=value.Definition.Mcp?.Endpoint?.ToString()??""; environmentReferences=string.Join(Environment.NewLine,(value.Definition.Mcp?.EnvironmentReferences??new Dictionary<string,string>()).Select(x=>$"{x.Key}={x.Value}")); }
    private ToolProviderProperties Properties() => new() { DisplayName=displayName, ProviderType=providerType, Enabled=enabled, Aep=providerType==ToolProviderType.Aep?new AepToolProviderConfiguration{ExtensionId=extensionId}:null, Mcp=providerType==ToolProviderType.Mcp?new McpToolProviderConfiguration{Transport=transport,Command=Null(command),Arguments=Lines(arguments),WorkingDirectory=Null(workingDirectory),Endpoint=Uri.TryCreate(endpoint,UriKind.Absolute,out var uri)?uri:null,EnvironmentReferences=Pairs(environmentReferences)}:null };
    private async Task SaveAsync() { busy=true; failed=false; message=null; try { if(IsNew){var saved=await Client.CreateProviderAsync(new(name,Properties()),default); Navigation.NavigateTo($"/tools/providers/{Uri.EscapeDataString(saved.Value.Name)}");}else{var saved=await Client.UpdateProviderAsync(Name!,new(Properties()),etag!,default);provider=saved.Value;etag=saved.ETag;tools=await Client.GetToolsAsync(provider.Name);message=provider.Definition.Discovery.Status=="connected"?T("SavedAndRefreshed"):T("SavedWithStatus",StatusLabel(provider.Definition.Discovery.Status));}}catch(Exception ex){failed=true;message=ex.Message;}finally{busy=false;} }
    private async Task TestAsync(){busy=true;try{var result=await Client.TestAsync(Name!,default);failed=false;message=T("ConnectionSucceeded",ToolCount(result.ToolCount));}catch(Exception ex){failed=true;message=ex.Message;}finally{busy=false;}}
    private async Task RefreshAsync(){busy=true;try{var diff=await Client.RefreshAsync(Name!,default);tools=await Client.GetToolsAsync(Name!);failed=false;message=T("DiscoverySummary",diff.Unchanged,diff.New,diff.Changed,diff.Unavailable);}catch(Exception ex){failed=true;message=ex.Message;}finally{busy=false;}}
    private async Task EnableAsync(ToolResource tool,bool value){await Client.SetEnabledAsync(tool.Name,value,null,default);tools=await Client.GetToolsAsync(Name!);}
    private string SectionUrl(string section) => $"/tools/providers/{Uri.EscapeDataString(Name!)}#{section}";
    private static string? Null(string value)=>string.IsNullOrWhiteSpace(value)?null:value.Trim(); private static string[] Lines(string value)=>value.Split(['\r','\n'],StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries); private static IReadOnlyDictionary<string,string> Pairs(string value)=>Lines(value).Select(line=>line.Split('=',2)).Where(x=>x.Length==2).ToDictionary(x=>x[0].Trim(),x=>x[1].Trim(),StringComparer.Ordinal);
}
