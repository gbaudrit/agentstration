@page "/missions"
@rendermode InteractiveServer
@inject IPlatformStore Store
@inject MissionService Service
<PageTitle>Missions</PageTitle><h1>Monitoring missions</h1>
<div class="form"><label>Workspace <select @bind="workspace"><option value="">Select</option>@foreach(var value in workspaces){<option value="@value.Id">@value.Name</option>}</select></label><label>Name <input @bind="name" /></label><label>Threshold <input type="number" @bind="threshold" /></label><button @onclick="CreateAsync">Create demo mission</button><span>@message</span></div>
@foreach(var mission in missions){<article class="row"><div><strong>@mission.Name</strong><small>@mission.Source · next @mission.NextRunAt.LocalDateTime</small></div><button @onclick="() => RunAsync(mission)">Run now</button></article>}
@code { private IReadOnlyList<Agentstration.Domain.Workspace> workspaces=[]; private IReadOnlyList<Mission> missions=[]; private string workspace="",name="Price watch",message="";private decimal? threshold=300; protected override async Task OnInitializedAsync(){workspaces=await Store.ListWorkspacesAsync(default);workspace=workspaces.FirstOrDefault()?.Id.ToString()??"";await ReloadAsync();} private async Task ReloadAsync(){if(Guid.TryParse(workspace,out var id))missions=await Service.ListAsync(new WorkspaceId(id),default);} private async Task CreateAsync(){if(!Guid.TryParse(workspace,out var id))return;var result=await Service.CreateAsync(new WorkspaceId(id),new CreateMissionRequest(name,"Notify when the deterministic price falls below the threshold","demo://product/coffee-machine",360,threshold),default);message=result.Error?.Message??"Created";await ReloadAsync();} private async Task RunAsync(Mission mission){var result=await Service.RunAsync(mission.WorkspaceId,mission.Id,default);message=result.IsSuccess?$"Observed {result.Value!.Observation}":result.Error!.Message;await ReloadAsync();} }
