@page "/tools"
@inject IToolsClient Client

<PageTitle>Tools · Agentstration</PageTitle>
<PageHeader Title="Tools" Description="Govern provider-backed capabilities before assigning them to agents.">
    <Actions><a class="button-secondary" href="/tools/providers">Providers</a><button class="button-secondary" @onclick="LoadAsync">Refresh</button></Actions>
</PageHeader>
<ResourceTabs Label="Tool sections"><a class="active" href="/tools">Catalog</a><a href="/tools/providers">Providers</a></ResourceTabs>

@if (loading) { <LoadingState Message="Loading tool catalog…" /> }
else if (error is not null) { <ErrorState Message="@error" /> }
else if (tools.Count == 0) { <EmptyState Title="No discovered tools" Message="Create a Tool Provider and refresh discovery. Newly discovered tools remain disabled by default." /> }
else
{
    <DataGrid TItem="ToolResource" Items="tools">
        <Header><tr><th>Tool</th><th>Provider</th><th>Availability</th><th>Enabled</th><th></th></tr></Header>
        <Row Context="tool"><tr><td><strong>@tool.Properties.DisplayName</strong><br /><code>@tool.Properties.ExternalId</code></td><td>@ResourceName(tool.Properties.Provider?.ResourceId)</td><td><StatusBadge Text="@(tool.Properties.Discovery?.Available == true ? "Available" : "Unavailable")" Status="@(tool.Properties.Discovery?.Available == true ? UiStatus.Success : UiStatus.Warning)" /></td><td>@(tool.Properties.Enabled ? "Yes" : "No")</td><td><a class="text-button" href="@($"/tools/{Uri.EscapeDataString(tool.ResourceGroup!)}/{Uri.EscapeDataString(tool.Name)}")">Details →</a></td></tr></Row>
    </DataGrid>
}

@code {
    private IReadOnlyList<ToolResource> tools = []; private bool loading = true; private string? error;
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync() { loading = true; error = null; try { tools = await Client.GetToolsAsync("default"); } catch (Exception ex) { error = ex.Message; } finally { loading = false; } }
    private static string ResourceName(string? id) => id is not null && ResourceIdentifier.TryParse(id, out var value) ? value.Name : "—";
}
