@page "/triggers"
@rendermode InteractiveServer
@using Agentstration.Management.Abstractions
@using Agentstration.Management.Core
@using Agentstration.Resources
@inject TriggerManagementService Management
@inject ConsoleContextState ContextState
@inject Microsoft.Extensions.Localization.IStringLocalizer<TriggerStrings> Localizer

<PageTitle>@T("Triggers") · Agentstration</PageTitle>
<PageHeader Title="@T("Triggers")" Description="@T("List.Description")">
    <Metadata><span>@T(Filtered.Count == 1 ? "TriggerCount.One" : "TriggerCount.Many", Filtered.Count)</span><span>@T("EnabledCount", EnabledCount)</span><span>@T("AttentionCount", AttentionCount)</span></Metadata>
    <Actions>@if (CanManage) { <a class="button-primary" href="/triggers/new">@T("NewTrigger")</a> }</Actions>
</PageHeader>

@if (loading)
{
    <LoadingState Message="@T("LoadingTriggers")" />
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <ErrorState Title="@T("TriggersUnavailable")" Message="@error" OnRetry="LoadAsync" />
}
else
{
    <div class="filter-bar">
        <SearchBox @bind-Value="search" Placeholder="@T("SearchPlaceholder")" />
        <select @bind="state" aria-label="@T("FilterStateAriaLabel")">
            <option value="">@T("State.All")</option><option value="enabled">@T("Enabled")</option><option value="disabled">@T("Disabled")</option><option value="attention">@T("RequiresAttention")</option>
        </select>
        <select @bind="scheduleType" aria-label="@T("FilterScheduleAriaLabel")">
            <option value="">@T("Schedule.All")</option><option value="once">@T("ScheduleType.Once")</option><option value="interval">@T("ScheduleType.Interval")</option><option value="cron">@T("ScheduleType.Cron")</option>
        </select>
    </div>

    @if (items.Count == 0)
    {
        <EmptyState Title="@T("EmptyTitle")" Message="@T("EmptyMessage")">@if (CanManage) { <a class="button-primary" href="/triggers/new">@T("CreateTrigger")</a> }</EmptyState>
    }
    else if (Filtered.Count == 0)
    {
        <EmptyState Title="@T("NoMatchesTitle")" Message="@T("NoMatchesMessage")" />
    }
    else
    {
        <DataGrid TItem="StoredResource<TriggerResource>" Items="Filtered">
            <Header><tr><th>@T("Trigger")</th><th>@T("State")</th><th>@T("Schedule")</th><th>@T("Target")</th><th>@T("NextOccurrence")</th><th>@T("LastOutcome")</th><th></th></tr></Header>
            <Row Context="stored"><tr>
                <td><strong><a href="@DetailsUrl(stored.Value)">@stored.Value.Definition.DisplayName</a></strong><small class="table-secondary">@stored.Value.Namespace.Value/@stored.Value.Name</small></td>
                <td><StatusBadge Text="@(stored.Value.Definition.Enabled ? T("Enabled") : T("Disabled"))" Status="@(stored.Value.Definition.Enabled ? UiStatus.Success : UiStatus.Neutral)" /></td>
                <td>@TriggerUi.ScheduleLabel(stored.Value.Definition.Source.Schedule, Localizer)</td>
                <td><a class="text-button" href="@FlowUrl(stored.Value)">@stored.Value.Definition.Target.Flow?.Name</a></td>
                <td>@TriggerUi.FormatDate(stored.Value.Observed.NextOccurrenceAt)</td>
                <td><StatusBadge Text="@T($"Outcome.{stored.Value.Observed.LastOutcome}")" Status="@OutcomeStatus(stored.Value.Observed.LastOutcome)" />@if (stored.Value.Observed.LastErrorCode is { } errorCode) { <small class="table-secondary">@errorCode</small> }</td>
                <td><a class="text-button" href="@DetailsUrl(stored.Value)">@T("Open")</a>@if (CanManage) { <a class="text-button" href="@EditUrl(stored.Value)">@T("Edit")</a> }</td>
            </tr></Row>
        </DataGrid>
    }
}

@code {
    private IReadOnlyList<StoredResource<TriggerResource>> items = [];
    private bool loading = true;
    private string? error;
    private string search = "", state = "", scheduleType = "";
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    private bool CanManage => ContextState.HasPermission(AuthorizationPermissions.ResourcesWrite);
    private int EnabledCount => items.Count(value => value.Value.Definition.Enabled);
    private int AttentionCount => items.Count(value => value.Value.Observed.LastOutcome == TriggerLastOutcome.Failed);
    private IReadOnlyList<StoredResource<TriggerResource>> Filtered => items
        .Where(value => string.IsNullOrWhiteSpace(search) || value.Value.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || value.Value.Definition.DisplayName.Contains(search, StringComparison.OrdinalIgnoreCase) || (value.Value.Definition.Target.Flow?.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false))
        .Where(value => state switch { "enabled" => value.Value.Definition.Enabled, "disabled" => !value.Value.Definition.Enabled, "attention" => value.Value.Observed.LastOutcome == TriggerLastOutcome.Failed, _ => true })
        .Where(value => string.IsNullOrWhiteSpace(scheduleType) || string.Equals(value.Value.Definition.Source.Schedule?.Type.ToString(), scheduleType, StringComparison.OrdinalIgnoreCase))
        .OrderBy(value => value.Value.Observed.NextOccurrenceAt ?? DateTimeOffset.MaxValue).ThenBy(value => value.Value.Definition.DisplayName, StringComparer.OrdinalIgnoreCase).ToArray();

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() { loading = true; error = null; try { items = await Management.ListAsync(CancellationToken.None); } catch (Exception exception) { error = exception.Message; } finally { loading = false; } }
    private static string DetailsUrl(TriggerResource value) => $"/triggers/{Uri.EscapeDataString(value.Name)}";
    private static string EditUrl(TriggerResource value) => $"{DetailsUrl(value)}/edit";
    private static string FlowUrl(TriggerResource value) { var flow = value.Definition.Target.Flow!; return ConsoleResourceUrls.Flow(new FlowId(flow.Name, flow.Namespace ?? value.Namespace)); }
    private static UiStatus OutcomeStatus(TriggerLastOutcome outcome) => outcome switch { TriggerLastOutcome.Submitted => UiStatus.Success, TriggerLastOutcome.Skipped => UiStatus.Warning, TriggerLastOutcome.Failed => UiStatus.Danger, _ => UiStatus.Neutral };
}
