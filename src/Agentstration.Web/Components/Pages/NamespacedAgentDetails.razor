@page "/namespaces/{AgentNamespace}/agents/{Name}"
@using Agentstration.Resources
@implements IDisposable
@inject IManagementApiClient Client
@inject IPacksClient PacksClient
@inject IAgentRunnerRuntimeClient RuntimeClient
@inject Microsoft.Extensions.Localization.IStringLocalizer<NamespacedAgentDetailsStrings> Localizer

<PageTitle>@(agent?.Definition.DisplayName ?? Name) · Agentstration</PageTitle>

@if (loading)
{
    <LoadingState Message="@T("Loading")" />
}
else if (error is not null)
{
    <ErrorState Message="@error.Message" ErrorId="@error.ErrorId" />
}
else if (agent is not null)
{
    <ResourceHeader ResourceType="@T("Agent")" Domain="agent" Icon="◎" Name="@agent.Definition.DisplayName" Description="@agent.Definition.Description" StatusText="@StatusPresentation.Label(agent.Status.ProvisioningState.ToString())" Status="@StatusPresentation.Tone(agent.Status.ProvisioningState.ToString())">
        <Metadata><span><code>@AgentResourceNamespace.Value/@agent.Metadata.Name</code></span><span>@T("Generation", agent.Generation)</span></Metadata>
        <Actions><button class="button-primary" type="button" @onclick="PrepareRuntimeAsync" disabled="@deploying">@DeploymentActionLabel</button><a class="button-secondary" href="/agents">@T("BackToAgents")</a></Actions>
    </ResourceHeader>
    <nav class="section-tabs namespaced-agent-tabs" role="tablist" aria-label="@T("AgentDetails")">
        @foreach (var tab in Enum.GetValues<PageTab>())
        {
            <button id="@TabId(tab)" type="button" role="tab" aria-selected="@(activeTab == tab ? "true" : "false")" aria-controls="agent-tab-panel" class="@(activeTab == tab ? "active" : null)" @onclick="() => activeTab = tab">@TabLabel(tab)</button>
        }
    </nav>
    <main id="agent-tab-panel" role="tabpanel" aria-labelledby="@TabId(activeTab)" tabindex="0">
        @if (activeTab == PageTab.Overview)
        {
            <section class="metric-grid namespaced-agent-metrics" aria-label="@T("AgentStatusOverview")">
                <MetricCard Label="@T("GenerationLabel")" Value="@agent.Generation.ToString()" Detail="@AgentStatus" HelpText="@T("GenerationHelp")" Status="@AgentStatusTone" />
                <MetricCard Label="@T("ModelProfile")" Value="@ModelBindingStatus" Detail="@ModelBindingDetail" HelpText="@ModelBindingHelp" Status="@ModelBindingTone" />
                <MetricCard Label="@T("RuntimeProfile")" Value="@RuntimeBindingStatus" Detail="@RuntimeBindingDetail" HelpText="@RuntimeBindingHelp" Status="@RuntimeBindingTone" />
                <MetricCard Label="@T("Deployment")" Value="@DeploymentOverviewStatus" Detail="@DeploymentOverviewDetail" HelpText="@T("DeploymentHelp")" Status="@DeploymentTone" />
            </section>
            <p class="muted namespaced-agent-provenance">@T("NamespacedProvenance")</p>
            <article class="panel definition-grid">
                <div><span class="field-label">@T("Namespace")</span><code>@AgentResourceNamespace.Value</code></div>
                <div><span class="field-label">@T("ResourceName")</span><code>@agent.Metadata.Name</code></div>
                <div><span class="field-label">@T("Handler")</span><strong>@agent.Definition.Handler</strong></div>
                <div><span class="field-label">@T("ModelProfile")</span><a class="text-button" href="@ModelProfileUrl"><code>@ModelProfileAddress</code></a></div>
                <div><span class="field-label">@T("RuntimeProfile")</span><a class="text-button" href="@RuntimeProfileUrl"><code>@RuntimeProfileAddress</code></a></div>
                <div><span class="field-label">@T("Capabilities")</span><strong>@Capabilities</strong></div>
                <div><span class="field-label">@T("Status")</span><strong>@AgentStatus</strong></div>
            </article>
        }
        else if (activeTab == PageTab.Model)
        {
            <section class="panel form-section namespaced-binding-panel">
                <div class="panel-header"><div><p class="eyebrow">@T("InstallationConfiguration")</p><h2>@T("ModelBinding")</h2></div>@if (modelBindings.Count > 0) { <StatusBadge Text="@T("BoundByPack")" Status="UiStatus.Info" /> }</div>
                @if (ownerPack is null)
                {
                    <p class="muted">@T("ModelNoPackPrefix") <a class="text-button" href="@ModelProfileUrl"><code>@ModelProfileAddress</code></a>. @T("NoPackProvenance")</p>
                }
                else if (modelBindings.Count == 0)
                {
                    <p>@T("ContainedModelReference")</p>
                    <dl class="resource-details"><dt>@T("EffectiveProfile")</dt><dd><a class="text-button" href="@ModelProfileUrl"><code>@ModelProfileAddress</code></a></dd><dt>@T("ManagedBy")</dt><dd><code>@PackIdentity</code></dd></dl>
                    <div class="namespaced-agent-actions"><a class="button-secondary" href="@PackUrl">@T("OpenPackInstallation")</a></div>
                }
                else
                {
                    <p>@T("LogicalModelRequirement")</p>
                    <dl class="resource-details">
                        @foreach (var binding in modelBindings)
                        {
                            <dt>@T("Binding")</dt><dd><code>@binding.Name</code></dd>
                            <dt>@T("EffectiveProfile")</dt><dd><a class="text-button" href="@ModelProfileUrl"><code>@BindingTarget(binding.Target)</code></a></dd>
                        }
                        <dt>@T("ManagedBy")</dt><dd><code>@PackIdentity</code></dd>
                    </dl>
                    <p class="resource-hint">@T("BindingReadOnlyHelp")</p>
                    <div class="namespaced-agent-actions"><a class="button-primary" href="@ModelProfileUrl">@T("OpenEffectiveModelProfile")</a><a class="button-secondary" href="@PackUrl">@T("OpenPackInstallation")</a></div>
                }
            </section>
        }
        else if (activeTab == PageTab.Runtime)
        {
            <section class="panel form-section namespaced-binding-panel">
                <div class="panel-header"><div><p class="eyebrow">@T("LocalDeployment")</p><h2>@T("RuntimeBinding")</h2></div><div class="namespaced-agent-status">@if (runtimeBindings.Count > 0) { <StatusBadge Text="@T("BoundByPack")" Status="UiStatus.Info" /> }<StatusBadge Text="@DeploymentStatus" Status="@DeploymentTone" /></div></div>
                @if (ownerPack is null)
                {
                    <p class="muted">@T("RuntimeNoPackPrefix") <a class="text-button" href="@RuntimeProfileUrl"><code>@RuntimeProfileAddress</code></a>. @T("NoPackProvenance")</p>
                }
                else if (runtimeBindings.Count == 0)
                {
                    <p>@T("ContainedRuntimeReference")</p>
                    <dl class="resource-details"><dt>@T("EffectiveRuntime")</dt><dd><a class="text-button" href="@RuntimeProfileUrl"><code>@RuntimeProfileAddress</code></a></dd><dt>@T("ManagedBy")</dt><dd><code>@PackIdentity</code></dd></dl>
                }
                else
                {
                    <p>@T("LogicalRuntimeRequirement")</p>
                    <dl class="resource-details">
                        @foreach (var binding in runtimeBindings)
                        {
                            <dt>@T("Binding")</dt><dd><code>@binding.Name</code></dd>
                            <dt>@T("EffectiveRuntime")</dt><dd><a class="text-button" href="@RuntimeProfileUrl"><code>@BindingTarget(binding.Target)</code></a></dd>
                        }
                        <dt>@T("ManagedBy")</dt><dd><code>@PackIdentity</code></dd>
                    </dl>
                }
                <dl class="resource-details namespaced-deployment-details">
                    <dt>@T("DesiredGeneration")</dt><dd>@agent.Generation</dd>
                    <dt>@T("Deployment")</dt><dd>@(readiness?.DeploymentId ?? T("NotPrepared"))</dd>
                    @if (!string.IsNullOrWhiteSpace(readiness?.RevisionId)) { <dt>@T("Revision")</dt><dd><code>@readiness.RevisionId</code></dd> }
                </dl>
                @if (!string.IsNullOrWhiteSpace(deploymentError)) { <div class="form-alert form-alert-danger" role="alert"><strong>@T("DeploymentFailed")</strong><span>@deploymentError</span></div> }
                @if (!string.IsNullOrWhiteSpace(deploymentMessage)) { <div class="form-alert form-alert-success" role="status"><strong>@T("DeploymentReady")</strong><span>@deploymentMessage</span></div> }
                <div class="namespaced-agent-actions"><button class="button-primary" type="button" @onclick="PrepareRuntimeAsync" disabled="@deploying">@DeploymentActionLabel</button><a class="button-secondary" href="@RuntimeProfileUrl">@T("OpenEffectiveRuntimeProfile")</a>@if (ownerPack is not null) { <a class="button-secondary" href="@PackUrl">@T("OpenPackInstallation")</a> }</div>
            </section>
        }
        else
        {
            <section class="panel namespaced-instructions">
                <div class="panel-header"><div><p class="eyebrow">@T("Definition")</p><h2>@T("Instructions")</h2></div></div>
                <div class="namespaced-instructions-copy">@agent.Definition.Instructions</div>
            </section>
        }
    </main>
}

@code {
    [Parameter] public string AgentNamespace { get; set; } = string.Empty;
    [Parameter] public string Name { get; set; } = string.Empty;
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private readonly CancellationTokenSource cancellation = new();
    private AgentResource? agent;
    private InstalledPackResource? ownerPack;
    private IReadOnlyList<PackBindingResolution> modelBindings = [];
    private IReadOnlyList<PackBindingResolution> runtimeBindings = [];
    private AgentRuntimeReadinessResponse? readiness;
    private AgentstrationApiException? error;
    private string? deploymentError;
    private string? deploymentMessage;
    private bool loading = true;
    private bool deploying;
    private PageTab activeTab;
    private ResourceNamespace AgentResourceNamespace => ResourceNamespace.Parse(AgentNamespace);
    private ResourceAddress ModelProfileAddress => agent?.Definition.ModelProfile.Resolve(AgentResourceNamespace, ResourceKinds.ModelProfile)
        ?? ResourceAddress.Create(ResourceNamespace.Default, ResourceKinds.ModelProfile, "unavailable");
    private string ModelProfileUrl => ConsoleResourceUrls.ModelProfile(ModelProfileAddress);
    private ResourceAddress RuntimeProfileAddress => agent?.Definition.RuntimeProfile.Resolve(AgentResourceNamespace, ResourceKinds.RuntimeProfile)
        ?? ResourceAddress.Create(ResourceNamespace.Default, ResourceKinds.RuntimeProfile, "unavailable");
    private string RuntimeProfileUrl => ConsoleResourceUrls.RuntimeProfile(RuntimeProfileAddress);
    private string PackIdentity => ownerPack is null ? T("UnknownPack") : $"{ownerPack.Definition.Publisher}/{ownerPack.Definition.PackName}";
    private string PackUrl => ownerPack is null ? "/packs" : $"/packs?publisher={Uri.EscapeDataString(ownerPack.Definition.Publisher)}&name={Uri.EscapeDataString(ownerPack.Definition.PackName)}";
    private string Capabilities => agent is null || agent.Definition.Behaviors.Count == 0 ? "—" : string.Join(", ", agent.Definition.Behaviors);
    private string DeploymentStatus => readiness?.Ready == true ? T("Ready") : readiness?.State ?? T("NotDeployed");
    private UiStatus DeploymentTone => readiness?.Ready == true ? UiStatus.Success : UiStatus.Warning;
    private string DeploymentOverviewStatus => readiness?.Ready == true ? T("Ready") : T("NotReady");
    private string DeploymentOverviewDetail => readiness?.Ready == true ? readiness.DeploymentId ?? T("ActiveDeployment") : DeploymentStatus;
    private string DeploymentActionLabel => deploying ? T("Deploying") : readiness?.Ready == true ? T("ReconcileDeployment") : T("DeployGeneration", agent?.Generation ?? 0);
    private string AgentStatus => agent is null ? T("Unknown") : StatusPresentation.Label(agent.Status.ProvisioningState.ToString());
    private UiStatus AgentStatusTone => agent is null ? UiStatus.Neutral : StatusPresentation.Tone(agent.Status.ProvisioningState.ToString());
    private bool ModelIsPackResource => ownerPack is not null && ModelProfileAddress.Namespace == AgentResourceNamespace;
    private string ModelBindingStatus => modelBindings.Count > 0 ? T("InstallationBinding") : ModelIsPackResource ? T("PackResource") : T("DirectReference");
    private string ModelBindingDetail => modelBindings.Count > 0 ? string.Join(", ", modelBindings.Select(binding => $"{binding.Name} → {BindingTarget(binding.Target)}")) : ModelProfileAddress.ToString();
    private string ModelBindingHelp => modelBindings.Count > 0
        ? T("ModelBindingHelp")
        : ModelIsPackResource
            ? T("PackResourceHelp")
            : T("DirectModelReferenceHelp");
    private UiStatus ModelBindingTone => modelBindings.Count > 0 ? UiStatus.Info : ownerPack is null ? UiStatus.Warning : UiStatus.Neutral;
    private bool RuntimeIsPackResource => ownerPack is not null && RuntimeProfileAddress.Namespace == AgentResourceNamespace;
    private string RuntimeBindingStatus => runtimeBindings.Count > 0 ? T("InstallationBinding") : RuntimeIsPackResource ? T("PackResource") : T("DirectReference");
    private string RuntimeBindingDetail => runtimeBindings.Count > 0 ? string.Join(", ", runtimeBindings.Select(binding => $"{binding.Name} → {BindingTarget(binding.Target)}")) : RuntimeProfileAddress.ToString();
    private string RuntimeBindingHelp => runtimeBindings.Count > 0
        ? T("RuntimeBindingHelp")
        : RuntimeIsPackResource
            ? T("PackResourceHelp")
            : T("DirectRuntimeReferenceHelp");
    private UiStatus RuntimeBindingTone => runtimeBindings.Count > 0 ? UiStatus.Info : ownerPack is null ? UiStatus.Warning : UiStatus.Neutral;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        error = null;
        try
        {
            agent = (await Client.GetAgentAsync(AgentResourceNamespace, Name, cancellation.Token)).Value;
            await Task.WhenAll(LoadPackContextAsync(), LoadReadinessAsync());
        }
        catch (AgentstrationApiException exception) { error = exception; }
        finally { loading = false; }
    }

    private async Task LoadReadinessAsync()
    {
        readiness = null;
        if (agent is null) return;
        try { readiness = await RuntimeClient.GetAgentReadinessAsync(AgentResourceNamespace, agent.Metadata.Name, agent.Generation, cancellation.Token); }
        catch (AgentstrationApiException exception) { deploymentError = exception.Message; }
    }

    private async Task PrepareRuntimeAsync()
    {
        if (agent is null || deploying) return;
        deploying = true;
        deploymentError = null;
        deploymentMessage = null;
        try
        {
            var prepared = await RuntimeClient.PrepareAgentAsync(AgentResourceNamespace, agent.Metadata.Name, agent.Generation, cancellation.Token);
            await LoadReadinessAsync();
            if (string.Equals(prepared.State, OperationalState.Ready.ToString(), StringComparison.Ordinal))
                deploymentMessage = T("GenerationActiveThroughDeployment", prepared.Generation, prepared.DeploymentId);
            else
                deploymentError = T("RuntimePreparationCompleted", prepared.State);
        }
        catch (AgentstrationApiException exception) { deploymentError = exception.Message; }
        finally { deploying = false; }
    }

    private async Task LoadPackContextAsync()
    {
        ownerPack = null;
        modelBindings = [];
        runtimeBindings = [];
        if (agent is null
            || !agent.Metadata.Annotations.TryGetValue(PackProvenanceAnnotations.Publisher, out var publisher)
            || !agent.Metadata.Annotations.TryGetValue(PackProvenanceAnnotations.Name, out var packName)) return;

        try
        {
            ownerPack = (await PacksClient.GetPackAsync(publisher, packName, cancellation.Token)).Value;
            modelBindings = ownerPack.Definition.Bindings
                .Where(binding => binding.TargetKind == PackBindingTargetKind.ModelProfile
                    && binding.Target.Resolve(ResourceNamespace.Default, ResourceKinds.ModelProfile) == ModelProfileAddress)
                .ToArray();
            runtimeBindings = ownerPack.Definition.Bindings
                .Where(binding => binding.TargetKind == PackBindingTargetKind.RuntimeProfile
                    && binding.Target.Resolve(ResourceNamespace.Default, ResourceKinds.RuntimeProfile) == RuntimeProfileAddress)
                .ToArray();
        }
        catch (AgentstrationApiException) { }
    }

    private static string BindingTarget(ResourceReference target) => $"{(target.Namespace ?? ResourceNamespace.Default).Value}/{target.Name}";
    private static string TabId(PageTab tab) => $"agent-{tab.ToString().ToLowerInvariant()}-tab";
    private string TabLabel(PageTab tab) => Localizer[$"Tab.{tab}"];

    private enum PageTab { Overview, Model, Runtime, Instructions }

    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
