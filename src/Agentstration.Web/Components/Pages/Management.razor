@page "/management"
@implements IDisposable
@inject IManagementApiClient Client
<PageTitle>Management · Agentstration</PageTitle>
<PageHeader Title="Management plane" Description="Govern definitions, versions, capabilities, policies and desired state." />
@if (summary is null) { <LoadingState Message="Loading management resources…" /> }
else {
<section class="metric-grid"><MetricCard Label="Agent types" Value="@summary.AgentTypes.ToString()" Status="UiStatus.Info" /><MetricCard Label="Configurations" Value="@summary.Configurations.ToString()" /><MetricCard Label="Revisions" Value="@summary.Revisions.ToString()" /><MetricCard Label="Policies" Value="@summary.Policies.ToString()" /><MetricCard Label="Desired state" Value="@summary.DesiredState" Status="UiStatus.Success" /></section>
<section class="dashboard-grid"><article class="panel"><div class="panel-header"><h2>Governance resources</h2><a href="/agents">Manage agents →</a></div><div class="health-list"><HealthIndicator Label="Agent resources" StatusText="CRUD with optimistic concurrency" Status="UiStatus.Success" /><HealthIndicator Label="Agent types" StatusText="Canonical references available to editors" Status="UiStatus.Success" /><HealthIndicator Label="Model profiles" StatusText="Canonical inference configuration" Status="UiStatus.Success" /><HealthIndicator Label="Runtime profiles" StatusText="Execution and streaming defaults" Status="UiStatus.Success" /><HealthIndicator Label="Model providers" StatusText="Read-only status and dynamic model discovery" Status="UiStatus.Success" /></div><div class="management-links"><a class="button-secondary" href="/modelprofiles">Model profiles</a><a class="button-secondary" href="/runtimeprofiles">Runtime profiles</a><a class="button-secondary" href="/modelproviders">Model providers</a></div></article><article class="panel"><div class="panel-header"><h2>Control plane</h2></div><p>Agentstration remains the source of truth for immutable revisions, deployments and desired state.</p><StatusBadge Text="SQLite · local" Status="UiStatus.Info" /></article></section> }
@code { private readonly CancellationTokenSource cancellation = new(); private ManagementSummary? summary; protected override async Task OnInitializedAsync() => summary = await Client.GetSummaryAsync(cancellation.Token); public void Dispose(){ cancellation.Cancel(); cancellation.Dispose(); } }
