@page "/secrets"
@implements IDisposable
@inject ISecretsClient Client

<PageTitle>Secrets · Agentstration</PageTitle>
<PageHeader Title="Secrets" Description="Manage write-only credentials referenced by Agentstration resources."><Actions><button class="button-secondary" @onclick="LoadAsync">Refresh</button><a class="button-primary" href="/secrets/new">Create Secret</a></Actions></PageHeader>
<ResourceTabs Label="Secret management"><a class="active" href="/secrets">Secrets</a><a href="/vaults">Vaults</a></ResourceTabs>
<div class="toolbar"><input @bind="search" @bind:event="oninput" placeholder="Search Secrets…" aria-label="Search Secrets"/><select @bind="vaultFilter" aria-label="Filter by Vault"><option value="">All Vaults</option>@foreach(var vault in vaults){<option value="@vault">@vault</option>}</select><select @bind="statusFilter" aria-label="Filter by status"><option value="">All statuses</option><option>Configured</option><option>Missing</option><option>Unavailable</option><option>VaultUnavailable</option></select></div>
@if(loading){<LoadingState Message="Loading Secrets…"/>}else if(error is not null){<div class="form-alert form-alert-danger">@error.Message</div>}else if(Filtered.Count==0){<EmptyState Title="No Secrets" Message="Create a Secret to reference credentials without embedding their values."/>}else{<DataGrid TItem="SecretResponse" Items="Filtered"><Header><tr><th>Name</th><th>Vault</th><th>Type</th><th>Status</th><th></th></tr></Header><Row Context="item"><tr><td><strong>@item.Resource.Definition.DisplayName</strong><br/><code>@item.Resource.Name</code></td><td>@item.Resource.Definition.Vault.Name</td><td>@item.Resource.Definition.SecretType</td><td><StatusBadge Text="@item.ValueStatus" Status="@Tone(item.ValueStatus)"/></td><td><a class="text-button" href="@($"/secrets/{Uri.EscapeDataString(item.Resource.Name)}")">Manage →</a></td></tr></Row></DataGrid>}
@code { private readonly CancellationTokenSource cancellation=new(); private IReadOnlyList<SecretResponse> items=[];private bool loading=true;private Exception? error;private string search="",vaultFilter="",statusFilter="";private IReadOnlyList<string> vaults=>items.Select(x=>x.Resource.Definition.Vault.Name).Distinct().Order().ToArray();private IReadOnlyList<SecretResponse> Filtered=>items.Where(x=>(string.IsNullOrWhiteSpace(search)||x.Resource.Name.Contains(search,StringComparison.OrdinalIgnoreCase)||x.Resource.Definition.DisplayName.Contains(search,StringComparison.OrdinalIgnoreCase))&&(vaultFilter.Length==0||x.Resource.Definition.Vault.Name==vaultFilter)&&(statusFilter.Length==0||x.ValueStatus.Equals(statusFilter,StringComparison.OrdinalIgnoreCase))).ToArray();protected override Task OnInitializedAsync()=>LoadAsync();private async Task LoadAsync(){loading=true;error=null;try{items=await Client.GetSecretsAsync(cancellation.Token);}catch(Exception ex){error=ex;}finally{loading=false;}}private static UiStatus Tone(string value)=>value.Equals("Configured",StringComparison.OrdinalIgnoreCase)?UiStatus.Success:value.Equals("Missing",StringComparison.OrdinalIgnoreCase)?UiStatus.Warning:UiStatus.Danger;public void Dispose(){cancellation.Cancel();cancellation.Dispose();}}
