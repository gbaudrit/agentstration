<DataGrid TItem="FlowRun" Items="Runs"><Header><tr><th>Status</th><th>Flow</th><th>Started</th><th>Duration</th><th>Version</th><th>Deployment</th><th>Trigger</th><th>Started by</th><th></th></tr></Header><Row Context="run"><tr><td><StatusBadge Text="@run.Status.ToString()" Status="@PlatformDashboardService.ToStatus(run.Status.ToString())" /></td><td><strong>@run.FlowId.Value</strong><br/><code>@ShortId(run.Id)</code></td><td>@(run.StartedAt?.LocalDateTime.ToString("g") ?? "Pending")</td><td>@Duration(run)</td><td>@run.FlowVersion</td><td>@(run.DeploymentResourceId ?? "—")</td><td>@run.Trigger</td><td>@(run.StartedBy ?? "—")</td><td><a class="text-button" href="/flowruns/@Uri.EscapeDataString(run.Id)">Inspect</a></td></tr></Row></DataGrid>
@code {
    [Parameter,EditorRequired] public IReadOnlyList<FlowRun> Runs {get;set;}=[];
    private static string ShortId(string id)=>id.Length>18?$"{id[..18]}…":id;
    private static string Duration(FlowRun run){if(run.StartedAt is null)return "—";var end=run.CompletedAt??DateTimeOffset.UtcNow;var value=end-run.StartedAt.Value;return value.TotalSeconds>=1?$"{value.TotalSeconds:0.##} s":$"{value.TotalMilliseconds:0} ms";}
}
