@using System.Globalization
@using System.Text
@inject Microsoft.Extensions.Localization.IStringLocalizer<Agentstration.Web.Components.Pages.FlowRunDetailsStrings> Localizer

<article class="panel flow-run-timeline">
    <div class="flow-timeline-header">
        <div><p class="eyebrow">@T("ExecutionTrace")</p><h2>@T("ExecutionTimeline")</h2></div>
        <div class="flow-timeline-summary">
            @if (IsLive) { <span class="flow-live-indicator"><span></span>@T("Live")</span> }
            <span>@EventCount(Events.Count)</span>
        </div>
    </div>
    <div class="flow-timeline-tabs" role="tablist" aria-label="@T("TimelineViewsAriaLabel")">
        <button type="button" role="tab" aria-selected="@(activeView == TimelineView.Activity)" class="@(activeView == TimelineView.Activity ? "active" : null)" @onclick="() => activeView = TimelineView.Activity">@T("Activity")</button>
        <button type="button" role="tab" aria-selected="@(activeView == TimelineView.Raw)" class="@(activeView == TimelineView.Raw ? "active" : null)" @onclick="() => activeView = TimelineView.Raw">@T("RawEvents")</button>
    </div>
    @if (Events.Count == 0)
    {
        <div class="flow-timeline-empty">@T("WaitingForEvents")</div>
    }
    else if (activeView == TimelineView.Activity)
    {
        <ol class="flow-timeline-list" aria-live="polite">
            @foreach (var item in Activity)
            {
                <li class="flow-timeline-item @Tone(item.Type)">
                    <time datetime="@item.Timestamp.ToString("O", CultureInfo.InvariantCulture)">@item.Timestamp.ToLocalTime().ToString("T", CultureInfo.CurrentCulture)</time>
                    <span class="flow-timeline-node"></span>
                    <div class="flow-timeline-content">
                        <strong>@Title(item)</strong>
                        @if (item.IsStream)
                        {
                            <pre class="flow-stream-output">@(string.IsNullOrEmpty(item.Text) ? T("WaitingForOutput") : item.Text)</pre>
                            <small>@DeltaCount(item.Count) · #@item.FirstSequence–@item.LastSequence</small>
                        }
                        else
                        {
                            @if (!string.IsNullOrWhiteSpace(item.Detail)) { <p>@item.Detail</p> }
                            <small>#@item.FirstSequence · @EventTypeLabel(item.Type)</small>
                        }
                    </div>
                </li>
            }
        </ol>
    }
    else
    {
        <div class="flow-raw-toolbar">
            <label><span class="sr-only">@T("FilterEventType")</span><select @bind="rawType"><option value="">@T("AllEventTypes")</option>@foreach (var type in Enum.GetValues<FlowRunEventType>()) { <option value="@type">@EventTypeLabel(type)</option> }</select></label>
            <span>@T("ShowingEvents", VisibleRawEvents.Count, FilteredRawEvents.Count)</span>
        </div>
        <ol class="flow-raw-events">
            @foreach (var runEvent in VisibleRawEvents)
            {
                <li><time>@runEvent.Timestamp.ToLocalTime().ToString("T", CultureInfo.CurrentCulture)</time><strong>@(runEvent.StepId is null ? EventTypeLabel(runEvent.Type) : $"{runEvent.StepId} · {EventTypeLabel(runEvent.Type)}")</strong><code>#@runEvent.Sequence</code><span>@Payload(runEvent.Payload)</span></li>
            }
        </ol>
        @if (VisibleRawEvents.Count < FilteredRawEvents.Count)
        {
            <button type="button" class="button-secondary flow-load-events" @onclick="LoadMoreRawEvents">@T("LoadOlderEvents", RawPageSize)</button>
        }
    }
</article>

@code {
    private const int RawPageSize = 200;
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string EventCount(int count) => T(count == 1 ? "EventCount.One" : "EventCount.Many", count);
    private string DeltaCount(int count) => T(count == 1 ? "DeltaCount.One" : "DeltaCount.Many", count);
    private string EventTypeLabel(FlowRunEventType value) => Localizer[$"EventType.{value}"];
    private TimelineView activeView;
    private string rawType = string.Empty;
    private int rawLimit = RawPageSize;

    [Parameter] public IReadOnlyList<FlowRunEvent> Events { get; set; } = [];
    [Parameter] public bool IsLive { get; set; }

    private IReadOnlyList<TimelineItem> Activity => BuildActivity(Events);
    private IReadOnlyList<FlowRunEvent> FilteredRawEvents => Events.Where(value => string.IsNullOrEmpty(rawType) || string.Equals(value.Type.ToString(), rawType, StringComparison.Ordinal)).OrderBy(value => value.Sequence).ToArray();
    private IReadOnlyList<FlowRunEvent> VisibleRawEvents => FilteredRawEvents.TakeLast(rawLimit).ToArray();

    private void LoadMoreRawEvents() => rawLimit += RawPageSize;

    private static IReadOnlyList<TimelineItem> BuildActivity(IReadOnlyList<FlowRunEvent> events)
    {
        var activity = new List<TimelineItem>();
        foreach (var runEvent in events.OrderBy(value => value.Sequence))
        {
            if (runEvent.Type == FlowRunEventType.StepOutputDelta)
            {
                var text = DeltaText(runEvent.Payload);
                if (activity.LastOrDefault() is { IsStream: true } current && string.Equals(current.StepId, runEvent.StepId, StringComparison.Ordinal)) current.Append(text, runEvent.Sequence);
                else activity.Add(TimelineItem.Stream(runEvent, text));
                continue;
            }
            activity.Add(TimelineItem.Event(runEvent, Payload(runEvent.Payload)));
        }
        return activity;
    }

    private string Title(TimelineItem item)
    {
        if (item.IsStream) return T("StreamingOutput", item.StepId ?? T("Step"));
        var subject = item.Type is FlowRunEventType.ParticipantTurnStarted or FlowRunEventType.ParticipantTurnCompleted
            ? item.StepId ?? T("Participant")
            : item.StepId ?? T("Step");
        return T($"Event.{item.Type}", subject);
    }

    private static string Tone(FlowRunEventType type) => type switch
    {
        FlowRunEventType.FlowRunCompleted or FlowRunEventType.StepRunCompleted => "flow-timeline-success",
        FlowRunEventType.FlowRunFailed or FlowRunEventType.StepRunFailed => "flow-timeline-danger",
        FlowRunEventType.FlowRunCancelled or FlowRunEventType.FlowRunTimedOut or FlowRunEventType.InputExpired => "flow-timeline-warning",
        FlowRunEventType.FlowRunStarted or FlowRunEventType.FlowRunResumed or FlowRunEventType.InputRequested or FlowRunEventType.InputReceived or FlowRunEventType.StepRunStarted or FlowRunEventType.ParticipantTurnStarted or FlowRunEventType.StepOutputDelta => "flow-timeline-info",
        _ => string.Empty
    };

    private static string DeltaText(JsonElement? payload)
    {
        if (payload is null) return string.Empty;
        var value = payload.Value;
        if (value.ValueKind == JsonValueKind.String) return value.GetString() ?? string.Empty;
        if (value.ValueKind == JsonValueKind.Object)
        {
            foreach (var property in value.EnumerateObject())
            {
                if (property.Value.ValueKind == JsonValueKind.String && property.Name is "delta" or "text" or "content" or "value") return property.Value.GetString() ?? string.Empty;
            }
        }
        return Payload(payload);
    }

    private static string Payload(JsonElement? payload)
    {
        if (payload is null) return string.Empty;
        var value = payload.Value;
        return value.ValueKind == JsonValueKind.String ? value.GetString() ?? string.Empty : value.GetRawText();
    }

    private enum TimelineView { Activity, Raw }

    private sealed class TimelineItem
    {
        private readonly StringBuilder text = new();
        private TimelineItem(FlowRunEvent runEvent, bool isStream, string initialText) { Type = runEvent.Type; StepId = runEvent.StepId; Timestamp = runEvent.Timestamp; FirstSequence = runEvent.Sequence; LastSequence = runEvent.Sequence; IsStream = isStream; text.Append(initialText); Detail = isStream ? string.Empty : initialText; }
        public FlowRunEventType Type { get; }
        public string? StepId { get; }
        public DateTimeOffset Timestamp { get; }
        public long FirstSequence { get; }
        public long LastSequence { get; private set; }
        public bool IsStream { get; }
        public string Text => text.ToString();
        public string Detail { get; }
        public int Count { get; private set; } = 1;
        public static TimelineItem Stream(FlowRunEvent runEvent, string text) => new(runEvent, true, text);
        public static TimelineItem Event(FlowRunEvent runEvent, string detail) => new(runEvent, false, detail);
        public void Append(string value, long sequence) { text.Append(value); LastSequence = sequence; Count++; }
    }
}
