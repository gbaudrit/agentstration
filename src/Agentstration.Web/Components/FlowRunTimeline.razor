@using System.Globalization
@using System.Text
@inject Microsoft.Extensions.Localization.IStringLocalizer<Agentstration.Web.Components.Pages.FlowRunDetailsStrings> Localizer

<section class="@(Embedded ? "flow-run-timeline flow-run-timeline-embedded" : "panel flow-run-timeline")">
    @if (ShowHeader)
    {
    <div class="flow-timeline-header">
        <div><p class="eyebrow">@T("ExecutionTrace")</p><h2>@T("ExecutionTimeline")</h2></div>
        <div class="flow-timeline-summary">
            @if (IsLive) { <span class="flow-live-indicator"><span></span>@T("Live")</span> }
            <span>@EventCount(Events.Count)</span>
        </div>
    </div>
    }
    @if (ShowNavigation)
    {
    <div class="flow-timeline-tabs" role="tablist" aria-label="@T("TimelineViewsAriaLabel")">
        <button type="button" role="tab" aria-selected="@(CurrentView == TimelineView.Summary ? "true" : "false")" class="@(CurrentView == TimelineView.Summary ? "active" : null)" @onclick="() => activeView = TimelineView.Summary">@T("Summary")</button>
        <button type="button" role="tab" aria-selected="@(CurrentView == TimelineView.Activity ? "true" : "false")" class="@(CurrentView == TimelineView.Activity ? "active" : null)" @onclick="() => activeView = TimelineView.Activity">@T("Activity")</button>
        @if (HasHandoffView)
        {
            <button type="button" role="tab" aria-selected="@(CurrentView == TimelineView.Handoffs ? "true" : "false")" class="@(CurrentView == TimelineView.Handoffs ? "active" : null)" @onclick="() => activeView = TimelineView.Handoffs">@T("Handoffs")</button>
        }
        <button type="button" role="tab" aria-selected="@(CurrentView == TimelineView.Raw ? "true" : "false")" class="@(CurrentView == TimelineView.Raw ? "active" : null)" @onclick="() => activeView = TimelineView.Raw">@T("RawEvents")</button>
    </div>
    }
    @if (Events.Count == 0)
    {
        <div class="flow-timeline-empty">@T("WaitingForEvents")</div>
    }
    else if (CurrentView == TimelineView.Summary)
    {
        <section class="flow-execution-summary" aria-label="@T("Summary")">
            <div class="flow-summary-metrics">
                <div><span>@T("SummaryDuration")</span><strong>@Elapsed</strong></div>
                <div><span>@T("SummaryCompletedSteps")</span><strong>@CompletedStepCount</strong></div>
                <div><span>@T("SummaryTurns")</span><strong>@TurnCount</strong></div>
                <div><span>@T("SummaryParticipants")</span><strong>@Participants.Count</strong></div>
                <div><span>@T("SummaryHandoffs")</span><strong>@Handoffs.Count</strong></div>
            </div>
            @if (ParticipantPath.Count > 0)
            {
                <div class="flow-participant-path">
                    <strong>@T("ParticipantPath")</strong>
                    <ol>
                        @for (var index = 0; index < ParticipantPath.Count; index++)
                        {
                            <li>@if (index > 0) { <b aria-hidden="true">→</b> }<span>@ParticipantPath[index]</span></li>
                        }
                    </ol>
                </div>
            }
        </section>
    }
    else if (CurrentView == TimelineView.Activity)
    {
        <ol class="flow-timeline-list" aria-live="polite">
            @foreach (var item in Activity)
            {
                <li class="flow-timeline-item @Tone(item)">
                    <time datetime="@item.Timestamp.ToString("O", CultureInfo.InvariantCulture)">@item.Timestamp.ToLocalTime().ToString("T", CultureInfo.CurrentCulture)</time>
                    <span class="flow-timeline-node"></span>
                    <div class="flow-timeline-content">
                        <strong>@Title(item)</strong>
                        @if (item.IsTurn)
                        {
                            <div class="flow-turn-message @(item.IsCompleted ? "completed" : "streaming")">
                                <div><span>@T("ParticipantMessage")</span><em>@T(item.IsCompleted ? "Completed" : "Streaming")</em></div>
                                <pre>@(string.IsNullOrWhiteSpace(item.Text) ? T(item.IsCompleted ? "NoVisibleTextOutput" : "WaitingForParticipantResponse") : item.Text)</pre>
                            </div>
                            <small>@DeltaCount(item.DeltaCount) · #@item.FirstSequence–@item.LastSequence</small>
                        }
                        else if (item.IsStream)
                        {
                            <pre class="flow-stream-output">@(string.IsNullOrEmpty(item.Text) ? T("WaitingForOutput") : item.Text)</pre>
                            <small>@DeltaCount(item.DeltaCount) · #@item.FirstSequence–@item.LastSequence</small>
                        }
                        else
                        {
                            @if (item.Type == FlowRunEventType.ParticipantHandoff && item.HandoffFrom is not null && item.HandoffTo is not null)
                            {
                                <div class="flow-handoff-route" aria-label="@T("HandoffAriaLabel", item.HandoffFrom, item.HandoffTo)">
                                    <span>@item.HandoffFrom</span><b aria-hidden="true">→</b><span>@item.HandoffTo</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Detail)) { <p>@item.Detail</p> }
                            <small>#@item.FirstSequence · @EventTypeLabel(item.Type)</small>
                        }
                    </div>
                </li>
            }
        </ol>
    }
    else if (CurrentView == TimelineView.Handoffs)
    {
        <section class="flow-handoff-summary" aria-label="@T("Handoffs")">
            <div class="flow-handoff-summary-header">
                <strong>@T("ObservedPath")</strong>
                <span>@HandoffCount(Handoffs.Count)</span>
            </div>
            @if (Handoffs.Count == 0)
            {
                <p class="flow-handoff-empty">@T("NoHandoffs")</p>
            }
            else
            {
                <ol class="flow-handoff-list">
                    @for (var index = 0; index < Handoffs.Count; index++)
                    {
                        var handoff = Handoffs[index];
                        <li>
                            <div class="flow-handoff-order"><b>#@(index + 1)</b><time datetime="@handoff.Timestamp.ToString("O", CultureInfo.InvariantCulture)">@handoff.Timestamp.ToLocalTime().ToString("T", CultureInfo.CurrentCulture)</time></div>
                            <div class="flow-handoff-participants" aria-label="@T("HandoffAriaLabel", handoff.HandoffFrom!, handoff.HandoffTo!)">
                                <span>@handoff.HandoffFrom</span><b aria-hidden="true">→</b><span>@handoff.HandoffTo</span>
                            </div>
                            <small>#@handoff.FirstSequence</small>
                        </li>
                    }
                </ol>
            }
        </section>
    }
    else
    {
        <div class="flow-raw-toolbar">
            <label><span class="sr-only">@T("FilterEventType")</span><select @bind="rawType"><option value="">@T("AllEventTypes")</option>@foreach (var type in Enum.GetValues<FlowRunEventType>()) { <option value="@type">@EventTypeLabel(type)</option> }</select></label>
            <span>@T("ShowingEvents", VisibleRawEvents.Count, FilteredRawEvents.Count)</span>
        </div>
        <ol class="flow-raw-events">
            @foreach (var runEvent in VisibleRawEvents)
            {
                <li><time>@runEvent.Timestamp.ToLocalTime().ToString("T", CultureInfo.CurrentCulture)</time><strong>@(runEvent.StepId is null ? EventTypeLabel(runEvent.Type) : $"{runEvent.StepId} · {EventTypeLabel(runEvent.Type)}")</strong><code>#@runEvent.Sequence</code><span>@Payload(runEvent.Payload)</span></li>
            }
        </ol>
        @if (VisibleRawEvents.Count < FilteredRawEvents.Count)
        {
            <button type="button" class="button-secondary flow-load-events" @onclick="LoadMoreRawEvents">@T("LoadOlderEvents", RawPageSize)</button>
        }
    }
</section>

@code {
    private const int RawPageSize = 200;
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    private string EventCount(int count) => T(count == 1 ? "EventCount.One" : "EventCount.Many", count);
    private string DeltaCount(int count) => T(count == 1 ? "DeltaCount.One" : "DeltaCount.Many", count);
    private string HandoffCount(int count) => T(count == 1 ? "HandoffCount.One" : "HandoffCount.Many", count);
    private string EventTypeLabel(FlowRunEventType value) => Localizer[$"EventType.{value}"];
    private TimelineView activeView;
    private string rawType = string.Empty;
    private int rawLimit = RawPageSize;

    [Parameter] public IReadOnlyList<FlowRunEvent> Events { get; set; } = [];
    [Parameter] public bool IsLive { get; set; }
    [Parameter] public bool InferParticipantHandoffs { get; set; }
    [Parameter] public TimelineView? View { get; set; }
    [Parameter] public bool ShowHeader { get; set; } = true;
    [Parameter] public bool ShowNavigation { get; set; } = true;
    [Parameter] public bool Embedded { get; set; }

    private TimelineView CurrentView => View ?? activeView;
    private IReadOnlyList<TimelineItem> Activity => BuildActivity(Events, InferParticipantHandoffs);
    private IReadOnlyList<TimelineItem> Handoffs => Activity.Where(value => value.Type == FlowRunEventType.ParticipantHandoff && value.HandoffFrom is not null && value.HandoffTo is not null).ToArray();
    private bool HasHandoffView => InferParticipantHandoffs || Events.Any(value => value.Type == FlowRunEventType.ParticipantHandoff);
    private int CompletedStepCount => Events.Count(value => value.Type == FlowRunEventType.StepRunCompleted);
    private int TurnCount => Events.Count(value => value.Type == FlowRunEventType.ParticipantTurnCompleted);
    private IReadOnlyList<string> Participants => ParticipantNames();
    private IReadOnlyList<string> ParticipantPath => BuildParticipantPath();
    private string Elapsed => Events.Count < 2 ? "—" : FormatElapsed(Events.Max(value => value.Timestamp) - Events.Min(value => value.Timestamp));
    private IReadOnlyList<FlowRunEvent> FilteredRawEvents => Events.Where(value => string.IsNullOrEmpty(rawType) || string.Equals(value.Type.ToString(), rawType, StringComparison.Ordinal)).OrderBy(value => value.Sequence).ToArray();
    private IReadOnlyList<FlowRunEvent> VisibleRawEvents => FilteredRawEvents.TakeLast(rawLimit).ToArray();

    private void LoadMoreRawEvents() => rawLimit += RawPageSize;

    protected override void OnParametersSet()
    {
        if (View is null && !HasHandoffView && activeView == TimelineView.Handoffs) activeView = TimelineView.Activity;
    }

    private IReadOnlyList<string> ParticipantNames() => Activity
        .Where(value => value.IsTurn && value.StepId is not null)
        .Select(value => value.StepId!)
        .Concat(Handoffs.SelectMany(value => new[] { value.HandoffFrom!, value.HandoffTo! }))
        .Distinct(StringComparer.Ordinal)
        .ToArray();

    private IReadOnlyList<string> BuildParticipantPath()
    {
        if (Handoffs.Count > 0)
        {
            var path = new List<string> { Handoffs[0].HandoffFrom! };
            path.AddRange(Handoffs.Select(value => value.HandoffTo!));
            return path;
        }

        var result = new List<string>();
        foreach (var participant in Activity.Where(value => value.IsTurn && value.StepId is not null).Select(value => value.StepId!))
        {
            if (result.Count == 0 || !string.Equals(result[^1], participant, StringComparison.Ordinal)) result.Add(participant);
        }
        return result;
    }

    private static string FormatElapsed(TimeSpan value) => value.TotalSeconds >= 1
        ? $"{value.TotalSeconds.ToString("0.##", CultureInfo.CurrentCulture)} s"
        : $"{value.TotalMilliseconds.ToString("0", CultureInfo.CurrentCulture)} ms";

    private static IReadOnlyList<TimelineItem> BuildActivity(IReadOnlyList<FlowRunEvent> events, bool inferParticipantHandoffs)
    {
        var activity = new List<TimelineItem>();
        var activeTurns = new Dictionary<string, TimelineItem>(StringComparer.Ordinal);
        var inferHandoffs = inferParticipantHandoffs && !events.Any(value => value.Type == FlowRunEventType.ParticipantHandoff);
        string? lastParticipant = null;
        foreach (var runEvent in events.OrderBy(value => value.Sequence))
        {
            if (runEvent.Type == FlowRunEventType.ParticipantTurnStarted && runEvent.StepId is not null)
            {
                if (inferHandoffs
                    && lastParticipant is not null
                    && !string.Equals(lastParticipant, runEvent.StepId, StringComparison.Ordinal))
                {
                    var inferred = runEvent with
                    {
                        Type = FlowRunEventType.ParticipantHandoff,
                        StepId = lastParticipant,
                        Payload = JsonSerializer.SerializeToElement(new { from = lastParticipant, to = runEvent.StepId })
                    };
                    activity.Add(TimelineItem.Event(inferred, string.Empty));
                }
                lastParticipant = runEvent.StepId;
                var turn = TimelineItem.ParticipantTurn(runEvent);
                activeTurns[runEvent.StepId] = turn;
                activity.Add(turn);
                continue;
            }
            if (runEvent.Type == FlowRunEventType.StepOutputDelta)
            {
                var text = DeltaText(runEvent.Payload);
                if (runEvent.StepId is not null && activeTurns.TryGetValue(runEvent.StepId, out var activeTurn)) activeTurn.Append(text, runEvent.Sequence);
                else if (activity.LastOrDefault() is { IsStream: true } current && string.Equals(current.StepId, runEvent.StepId, StringComparison.Ordinal)) current.Append(text, runEvent.Sequence);
                else activity.Add(TimelineItem.Stream(runEvent, text));
                continue;
            }
            if (runEvent.Type == FlowRunEventType.ParticipantTurnCompleted
                && runEvent.StepId is not null
                && activeTurns.Remove(runEvent.StepId, out var completedTurn))
            {
                completedTurn.Complete(runEvent.Sequence);
                continue;
            }
            if (runEvent.Type == FlowRunEventType.StepRunCompleted
                && runEvent.StepId is not null
                && activeTurns.Remove(runEvent.StepId, out var finalTurn))
            {
                if (finalTurn.DeltaCount == 0) activity.Remove(finalTurn);
                else finalTurn.Complete(runEvent.Sequence);
            }
            if (runEvent.Type == FlowRunEventType.FlowRunCompleted && activeTurns.Count > 0)
            {
                foreach (var activeTurn in activeTurns.Values)
                {
                    if (activeTurn.DeltaCount == 0) activity.Remove(activeTurn);
                    else activeTurn.Complete(runEvent.Sequence);
                }
                activeTurns.Clear();
            }
            activity.Add(TimelineItem.Event(runEvent, runEvent.Type == FlowRunEventType.ParticipantHandoff ? string.Empty : Payload(runEvent.Payload)));
        }
        return activity;
    }

    private string Title(TimelineItem item)
    {
        if (item.IsTurn)
            return T(item.IsCompleted ? "ParticipantTurnCompleted" : "ParticipantTurnStarted",
                item.StepId ?? T("Participant"), item.Turn?.ToString(CultureInfo.InvariantCulture) ?? "—");
        if (item.IsStream) return T("StreamingOutput", item.StepId ?? T("Step"));
        if (item.Type == FlowRunEventType.ParticipantHandoff)
            return T("Event.ParticipantHandoff", item.HandoffFrom ?? item.StepId ?? T("Participant"), item.HandoffTo ?? T("Participant"));
        var subject = item.Type is FlowRunEventType.ParticipantTurnStarted or FlowRunEventType.ParticipantTurnCompleted
            ? item.StepId ?? T("Participant")
            : item.StepId ?? T("Step");
        return T($"Event.{item.Type}", subject);
    }

    private static string Tone(TimelineItem item) => item.IsTurn
        ? item.IsCompleted ? "flow-timeline-success" : "flow-timeline-info"
        : item.Type switch
    {
        FlowRunEventType.FlowRunCompleted or FlowRunEventType.StepRunCompleted => "flow-timeline-success",
        FlowRunEventType.FlowRunFailed or FlowRunEventType.StepRunFailed => "flow-timeline-danger",
        FlowRunEventType.FlowRunCancelled or FlowRunEventType.FlowRunTimedOut or FlowRunEventType.InputExpired => "flow-timeline-warning",
        FlowRunEventType.ParticipantHandoff => "flow-timeline-handoff",
        FlowRunEventType.FlowRunStarted or FlowRunEventType.FlowRunResumed or FlowRunEventType.InputRequested or FlowRunEventType.InputReceived or FlowRunEventType.StepRunStarted or FlowRunEventType.ParticipantTurnStarted or FlowRunEventType.StepOutputDelta => "flow-timeline-info",
        _ => string.Empty
    };

    private static string DeltaText(JsonElement? payload)
    {
        if (payload is null) return string.Empty;
        var value = payload.Value;
        if (value.ValueKind == JsonValueKind.String) return value.GetString() ?? string.Empty;
        if (value.ValueKind == JsonValueKind.Object)
        {
            foreach (var property in value.EnumerateObject())
            {
                if (property.Value.ValueKind == JsonValueKind.String && property.Name is "delta" or "text" or "content" or "value") return property.Value.GetString() ?? string.Empty;
            }
        }
        return Payload(payload);
    }

    private static string Payload(JsonElement? payload)
    {
        if (payload is null) return string.Empty;
        var value = payload.Value;
        return value.ValueKind == JsonValueKind.String ? value.GetString() ?? string.Empty : value.GetRawText();
    }

    private static string? PayloadString(JsonElement? payload, string propertyName) =>
        payload is { ValueKind: JsonValueKind.Object } value
        && value.TryGetProperty(propertyName, out var property)
        && property.ValueKind == JsonValueKind.String
            ? property.GetString()
            : null;

    private static int? PayloadInt(JsonElement? payload, string propertyName) =>
        payload is { ValueKind: JsonValueKind.Object } value
        && value.TryGetProperty(propertyName, out var property)
        && property.TryGetInt32(out var result)
            ? result
            : null;

    public enum TimelineView { Summary, Activity, Handoffs, Raw }

    private sealed class TimelineItem
    {
        private readonly StringBuilder text = new();
        private TimelineItem(FlowRunEvent runEvent, bool isStream, bool isTurn, string initialText) { Type = runEvent.Type; StepId = runEvent.StepId; Timestamp = runEvent.Timestamp; FirstSequence = runEvent.Sequence; LastSequence = runEvent.Sequence; IsStream = isStream; IsTurn = isTurn; Turn = isTurn ? PayloadInt(runEvent.Payload, "turn") : null; text.Append(initialText); Detail = isStream || isTurn ? string.Empty : initialText; HandoffFrom = PayloadString(runEvent.Payload, "from") ?? (runEvent.Type == FlowRunEventType.ParticipantHandoff ? runEvent.StepId : null); HandoffTo = PayloadString(runEvent.Payload, "to"); DeltaCount = isStream ? 1 : 0; }
        public FlowRunEventType Type { get; }
        public string? StepId { get; }
        public DateTimeOffset Timestamp { get; }
        public long FirstSequence { get; }
        public long LastSequence { get; private set; }
        public bool IsStream { get; }
        public bool IsTurn { get; }
        public bool IsCompleted { get; private set; }
        public int? Turn { get; }
        public string Text => text.ToString();
        public string Detail { get; }
        public string? HandoffFrom { get; }
        public string? HandoffTo { get; }
        public int DeltaCount { get; private set; }
        public static TimelineItem Stream(FlowRunEvent runEvent, string text) => new(runEvent, true, false, text);
        public static TimelineItem ParticipantTurn(FlowRunEvent runEvent) => new(runEvent, false, true, string.Empty);
        public static TimelineItem Event(FlowRunEvent runEvent, string detail) => new(runEvent, false, false, detail);
        public void Append(string value, long sequence) { text.Append(value); LastSequence = sequence; DeltaCount++; }
        public void Complete(long sequence) { LastSequence = sequence; IsCompleted = true; }
    }
}
