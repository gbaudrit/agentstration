@inject Microsoft.Extensions.Localization.IStringLocalizer<Agentstration.Web.Components.Pages.FlowOrchestrationEditorStrings> Localizer
<div class="orchestration-preview-layout @(SelectedNode is not null ? "has-details" : null)">
    <div>
        <FlowTopologyViewer Graph="Topology" SelectedKey="selectedKey" SelectedKeyChanged="SelectNode" InitiallyFit="true" />
        @if (SelectedNode is null)
        {
            <p class="muted orchestration-preview-hint">@T("SelectNodePreview")</p>
        }
    </div>
    @if (SelectedNode is not null)
    {
        <aside class="orchestration-node-details" aria-live="polite">
            <div class="panel-header">
                <h3>@SelectedNode.Label</h3>
                <button type="button" @onclick="ClearSelection" aria-label="@T("CloseNodeDetails")">×</button>
            </div>
            <dl class="details-list">
                <dt>@T("Type")</dt><dd>@SelectedNode.Type</dd>
                @if (SelectedNode.Subtitle is not null) { <dt>@T("Role")</dt><dd>@SelectedNode.Subtitle</dd> }
                @if (SelectedNode.IsInitial) { <dt>@T("Entry")</dt><dd>@T("InitialParticipant")</dd> }
                @if (SelectedAgent is not null)
                {
                    <dt>@T("Resource")</dt><dd><code>@SelectedAgent.Id</code></dd>
                    <dt>@T("ModelProfile")</dt><dd>@SelectedAgent.ModelProfile</dd>
                    <dt>@T("Status")</dt><dd>@SelectedAgent.Status</dd>
                    @if (SelectedAgent.Capabilities.Count > 0) { <dt>@T("Capabilities")</dt><dd>@string.Join(", ", SelectedAgent.Capabilities)</dd> }
                }
            </dl>
        </aside>
    }
</div>

@code {
    [Parameter, EditorRequired] public OrchestrationEditorModel Model { get; set; } = null!;
    private string T(string key, params object[] arguments) => Localizer[key, arguments];
    [Parameter] public IReadOnlyList<AgentSummary> Agents { get; set; } = [];
    private string? selectedKey;
    private FlowTopologyGraph Topology => FlowTopologyProjector.Project(Model.CreatePreviewDefinition());
    private FlowTopologyNode? SelectedNode => Topology.FindBySelection(selectedKey);
    private AgentSummary? SelectedAgent => SelectedNode?.Type == "agent"
        ? Agents.FirstOrDefault(agent => agent.Id == SelectedNode.SelectionKey)
        : null;

    private void SelectNode(string key) => selectedKey = key;
    private void ClearSelection() => selectedKey = null;
}
