@namespace Agentstration.Web.Components
@implements IDisposable
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedUiStrings> Localizer

@if (targets is null)
{
    <label>
        <span>@Localizer["ResourceScope.Label"] <HelpTooltip Text="@Localizer["ResourceScope.Help"]" /></span>
        <select disabled><option>@Localizer["ResourceScope.Loading"]</option></select>
    </label>
}
else if (targets.Count == 0)
{
    <label>
        <span>@Localizer["ResourceScope.Label"] <HelpTooltip Text="@Localizer["ResourceScope.Help"]" /></span>
        <select disabled><option>@Localizer["ResourceScope.Unavailable"]</option></select>
    </label>
}
else
{
    <ResourceScopePicker Targets="targets" Value="currentValue" ValueChanged="ChangeAsync" Disabled="Disabled" />
}

@code {
    [Parameter, EditorRequired] public string ResourceKind { get; set; } = string.Empty;
    [Parameter] public ResourceScopeRef? Value { get; set; }
    [Parameter] public EventCallback<ResourceScopeRef?> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public ResourceScopeKind? RequiredKind { get; set; }

    private readonly CancellationTokenSource cancellation = new();
    private IReadOnlyList<ResourceScopeTargetResponse>? targets;
    private string? loadedKind;
    private ResourceScopeRef? currentValue;

    protected override async Task OnParametersSetAsync()
    {
        if (Value is not null) currentValue = Value;
        if (string.Equals(loadedKind, ResourceKind, StringComparison.Ordinal)) return;
        var client = Services.GetService(typeof(IResourceScopeInventoryClient)) as IResourceScopeInventoryClient;
        if (client is null)
        {
            targets = [];
            loadedKind = ResourceKind;
            return;
        }
        try
        {
            var available = await client.GetTargetsAsync(ResourceKind, cancellation.Token);
            targets = RequiredKind is null ? available : available.Where(target => target.Kind == RequiredKind).ToArray();
            loadedKind = ResourceKind;
            if (currentValue is not null) return;
            var selected = targets.FirstOrDefault(target => target.Kind == ResourceScopeKind.Workspace && target.CanWrite)
                ?? targets.FirstOrDefault(target => target.CanWrite);
            if (selected is not null)
            {
                currentValue = selected.ScopeRef;
                await ValueChanged.InvokeAsync(selected.ScopeRef);
            }
        }
        catch (AgentstrationApiException)
        {
            targets = [];
        }
    }

    private Task ChangeAsync(ResourceScopeRef? value)
    {
        currentValue = value;
        return ValueChanged.InvokeAsync(value);
    }
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
