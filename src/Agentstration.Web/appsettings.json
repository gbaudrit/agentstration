{
  "Data": { "Path": ".agentstration/data.json", "ControlPlanePath": ".agentstration/control-plane.db", "WorkPlanePath": ".agentstration/work-plane.db", "FlowPath": ".agentstration/flow-plane.db" },
  "Management": { "ReconciliationIntervalSeconds": 10 },
  "AI": { "Provider": "Deterministic", "Endpoint": "http://localhost:11434/v1", "Model": "phi4-mini" },
  "Agentstration": {
    "UseSimulatedData": true,
    "ManagementApi": { "BaseAddress": "http://localhost:5080/", "TimeoutSeconds": 15 },
    "RuntimeApi": { "BaseAddress": "http://localhost:5080/", "TimeoutSeconds": 15 },
    "WorkApi": { "BaseAddress": "http://localhost:5080/", "TimeoutSeconds": 15 },
    "FlowApi": { "BaseAddress": "http://localhost:5080/", "TimeoutSeconds": 15 },
    "Authentication": { "DevelopmentMode": false },
    "ModelProviders": {
      "Providers": {
        "ollama-local": {
          "ProviderType": "ollama",
          "DisplayName": "Ollama local",
          "ManagementMode": "aspire",
          "ConnectionName": "local-chat",
          "EndpointDisplayName": "ollama",
          "Endpoint": "http://localhost:11434",
          "Capabilities": [ "chat" ]
        }
      },
      "Deployments": {
        "local-reasoning": {
          "ProviderName": "ollama-local",
          "ModelName": "qwen3:1.7b"
        }
      },
      "Profiles": {
        "reasoning-default": {
          "DeploymentName": "local-reasoning",
          "Generation": { "Temperature": 0.2, "MaxOutputTokens": 1000 }
        },
        "router-default": {
          "DeploymentName": "local-reasoning",
          "Generation": { "Temperature": 0, "MaxOutputTokens": 500 }
        }
      }
    }
  },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "localhost"
}
