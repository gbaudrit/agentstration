{
  "Agentstration": {
    "Authentication": {
      "Mode": "Development"
    },
    "Testing": {
      "HostedServicesEnabled": false,
      "OpenTelemetryEnabled": false
    }
  },
  "AI": {
    "Provider": "Deterministic",
    "Endpoint": "http://localhost/",
    "Model": "deterministic"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "None"
      }
    }
  }
}
