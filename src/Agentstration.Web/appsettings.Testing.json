{
  "Agentstration": {
    "Authentication": {
      "Mode": "Development"
    },
    "Testing": {
      "HostedServicesEnabled": false,
      "OpenTelemetryEnabled": false
    },
    "Extensions": {
      "DiscoverOnStartup": true,
      "Agentstration.Extensions.Ollama": { "RegistrationName": "ollama-extension", "DisplayName": "Ollama AEP extension", "Endpoint": "http://localhost:5260/" },
      "Agentstration.Extensions.LocalAI": { "RegistrationName": "localai-extension", "DisplayName": "LocalAI AEP extension", "Endpoint": "http://localhost:5280/" },
      "Agentstration.Extensions.Git": { "RegistrationName": "git-source-extension", "DisplayName": "Git Source Provider AEP extension", "Endpoint": "http://localhost:5290/" },
      "Agentstration.Extensions.Utilities": { "RegistrationName": "utilities-extension", "DisplayName": "Utilities AEP extension", "Endpoint": "http://localhost:5270/" }
    }
  },
  "AI": {
    "Provider": "Deterministic",
    "Endpoint": "http://localhost/",
    "Model": "deterministic"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "None"
      }
    }
  }
}
