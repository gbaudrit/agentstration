@namespace Agentstration.Web.SystemExplorer
@using Agentstration.SystemGraph.Contracts
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
<div @ref="element" style="@(FillContainer ? "height:100%;min-height:0;width:100%" : "height:min(65vh,640px);min-height:320px;width:100%")" role="region" aria-label="@Label"></div>
@if (ViewportLabels is not null)
{
    <div role="group" aria-label="@ViewportLabels["controls"]" style="display:flex;gap:.5rem;margin:.5rem 0">
        <button type="button" class="button-secondary" aria-label="@ViewportLabels["in"]" @onclick='() => ChangeViewportAsync("in")'>+</button>
        <button type="button" class="button-secondary" aria-label="@ViewportLabels["out"]" @onclick='() => ChangeViewportAsync("out")'>−</button>
        <button type="button" class="button-secondary" @onclick='() => ChangeViewportAsync("fit")'>@ViewportLabels["fit"]</button>
    </div>
}
@code {
    [Parameter, EditorRequired] public SystemGraphPage Page { get; set; } = default!;
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public IReadOnlyDictionary<string, string> RelationshipLabels { get; set; } = new Dictionary<string, string>();
    [Parameter] public IReadOnlyDictionary<string, string>? OverlayNotes { get; set; }
    [Parameter] public IReadOnlyDictionary<string, string>? ViewportLabels { get; set; }
    [Parameter] public SystemGraphDiagramOptions? Options { get; set; }
    [Parameter] public EventCallback<string> LinkSelected { get; set; }
    [Parameter] public EventCallback<string> Selected { get; set; }
    [Parameter] public EventCallback Failed { get; set; }
    [Parameter] public EventCallback<bool> LoadingChanged { get; set; }
    [Parameter] public bool FillContainer { get; set; }
    private ElementReference element;
    private IJSObjectReference? module;
    private DotNetObjectReference<SystemGraphDiagram>? callback;
    private SystemGraphPage? rendered;
    private bool disposed;
    private IReadOnlyDictionary<string, string>? renderedNotes;
    private SystemGraphDiagramOptions? renderedOptions;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed || ReferenceEquals(rendered, Page) && ReferenceEquals(renderedNotes, OverlayNotes) && ReferenceEquals(renderedOptions, Options)) return;
        var page = Page;
        rendered = page;
        var notes = renderedNotes = OverlayNotes;
        var options = renderedOptions = Options;
        try
        {
            await LoadingChanged.InvokeAsync(true);
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Agentstration.Web.SystemExplorer/system-explorer.js");
            if (disposed) { await module.DisposeAsync(); module = null; return; }
            callback ??= DotNetObjectReference.Create(this);
            var success = await module.InvokeAsync<bool>("render", element, page, RelationshipLabels, callback, notes, options);
            if (!disposed && ReferenceEquals(page, Page) && ReferenceEquals(notes, OverlayNotes) && ReferenceEquals(options, Options))
            {
                await LoadingChanged.InvokeAsync(false);
                if (!success) await Failed.InvokeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) when (disposed) { }
        catch (JSException) { if (!disposed) await Failed.InvokeAsync(); }
    }
    private async Task ChangeViewportAsync(string action)
    {
        if (disposed || module is null) return;
        try { await module.InvokeVoidAsync("viewport", element, action); }
        catch (JSDisconnectedException) { }
        catch (JSException) { if (!disposed) await Failed.InvokeAsync(); }
        catch (ObjectDisposedException) when (disposed) { }
    }
    public Task ZoomInAsync() => ChangeViewportAsync("in");
    public Task ZoomOutAsync() => ChangeViewportAsync("out");
    public Task FitAsync() => ChangeViewportAsync("fit");
    public Task FocusRootAsync() => ChangeViewportAsync("focus");
    [JSInvokable] public Task SelectNode(string id) => !disposed && Page.Nodes.Any(node => node.Id == id) ? Selected.InvokeAsync(id) : Task.CompletedTask;
    [JSInvokable] public Task SelectLink(string id) => !disposed && Page.Relations.Any(edge => edge.Kind == id && id.StartsWith("summary:", StringComparison.Ordinal)) ? LinkSelected.InvokeAsync(id) : Task.CompletedTask;
    public async ValueTask DisposeAsync()
    {
        disposed = true;
        if (module is not null)
        {
            try { await module.InvokeVoidAsync("dispose", element); await module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        callback?.Dispose();
    }
}
