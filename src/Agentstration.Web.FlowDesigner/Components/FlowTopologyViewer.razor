@using Microsoft.AspNetCore.Components.Web
@inject IStringLocalizer<FlowDesignerStrings> Localizer

<div class="topology-shell @(expanded ? "expanded" : null)" data-layout="@Graph.Layout">
    <div class="topology-toolbar">
        <span class="topology-description">@Graph.Description</span>
        <div class="topology-toolbar-actions">
            <span class="topology-legend"><i class="declared"></i>@Localizer["Declared"] <i class="observed"></i>@Localizer["Observed"] <i class="inactive"></i>@Localizer["NotSelected"]</span>
            @if (ShowInspectorControl)
            {
                <button class="topology-tool-button inspector-toggle" type="button" aria-pressed="@InspectorVisible" @onclick="ToggleInspectorAsync">
                    <span aria-hidden="true">▥</span> @Localizer[InspectorVisible ? "HideInfo" : "ShowInfo"]
                </button>
            }
            <div class="topology-zoom-controls" role="group" aria-label="@Localizer["TopologyZoomControls"]">
                <button type="button" @onclick="ZoomOut" aria-label="@Localizer["ZoomOut"]">−</button>
                <span aria-live="polite">@ZoomPercent%</span>
                <button type="button" @onclick="ZoomIn" aria-label="@Localizer["ZoomIn"]">+</button>
                <button type="button" @onclick="Fit">@Localizer["Fit"]</button>
            </div>
            <button class="topology-tool-button expand-toggle" type="button" aria-pressed="@expanded" @onclick="ToggleExpanded">
                <span aria-hidden="true">@(expanded ? "↙" : "↗")</span> @Localizer[expanded ? "ReduceTopology" : "ExpandTopology"]
            </button>
        </div>
    </div>
    <div class="topology-stage">
        @if (Graph.Nodes.Count == 0)
        {
            <div class="topology-empty">@Localizer["NoTopology"]</div>
        }
        else
        {
            <div class="topology-viewport">
            <svg class="topology-canvas @(fitToViewport ? "fit" : null)" style="@CanvasStyle" viewBox="0 0 @CanvasWidth @CanvasHeight" role="img" aria-label="@Graph.Description">
                <defs>
                    <marker id="@DeclaredMarker" markerWidth="10" markerHeight="10" refX="9" refY="5" orient="auto" markerUnits="userSpaceOnUse"><path d="M0,0 L10,5 L0,10 z" /></marker>
                    <marker id="@ObservedMarker" class="observed-marker" markerWidth="10" markerHeight="10" refX="9" refY="5" orient="auto" markerUnits="userSpaceOnUse"><path d="M0,0 L10,5 L0,10 z" /></marker>
                    <marker id="@InactiveMarker" class="inactive-marker" markerWidth="10" markerHeight="10" refX="9" refY="5" orient="auto" markerUnits="userSpaceOnUse"><path d="M0,0 L10,5 L0,10 z" /></marker>
                </defs>
                <g class="topology-edges">
                    @foreach (var edge in Edges)
                    {
                        <path class="topology-edge @EdgeClass(edge.Edge)" data-edge-id="@edge.Edge.Id" d="@edge.Path" marker-end="url(#@Marker(edge.Edge.State))" marker-start="@(edge.Edge.Bidirectional ? $"url(#{Marker(edge.Edge.State)})" : null)">
                            <title>@EdgeDescription(edge.Edge)</title>
                        </path>
                        @if (ShowLabel(edge.Edge))
                        {
                            <foreignObject class="edge-label-wrap" x="@(edge.LabelX - (edge.LabelWidth / 2))" y="@(edge.LabelY - 11)" width="@edge.LabelWidth" height="22">
                                <div class="edge-label">@edge.Edge.Label</div>
                            </foreignObject>
                        }
                    }
                </g>
                <g class="topology-nodes">
                    @foreach (var node in Nodes)
                    {
                        <g class="topology-node @NodeClass(node.Node) @(SelectedKey == node.Node.SelectionKey ? "selected" : null)"
                           transform="translate(@node.X @node.Y)" role="button" tabindex="0"
                           aria-label="@NodeDescription(node.Node)"
                           @onclick="() => SelectAsync(node.Node.SelectionKey)"
                            @onkeydown="eventArgs => OnNodeKeyDownAsync(eventArgs, node.Node.SelectionKey)">
                            <rect width="@FlowTopologyGeometry.NodeWidth" height="@FlowTopologyGeometry.NodeHeight" rx="11" />
                            <foreignObject x="8" y="8" width="156" height="62">
                                <div class="node-content">
                                    <span class="node-icon">@Icon(node.Node.Type)</span>
                                    <span class="node-copy"><strong>@Trim(node.Node.Label, 22)</strong><small>@node.Node.Type</small></span>
                                    <span class="turn-badge">@(node.Node.TurnCount == 0 ? null : T(node.Node.TurnCount == 1 ? "TurnCount.One" : "TurnCount.Many", node.Node.TurnCount))</span>
                                    <small class="node-subtitle">@(node.Node.Subtitle is null ? null : Trim(node.Node.Subtitle, 28))</small>
                                </div>
                            </foreignObject>
                            <title>@NodeDescription(node.Node)</title>
                        </g>
                    }
                </g>
            </svg>
            </div>
        }
    </div>
</div>

@code {
    private readonly string markerPrefix = $"topology-{Guid.NewGuid():N}";
    private IReadOnlyList<FlowTopologyPositionedNode> Nodes { get; set; } = [];
    private IReadOnlyList<FlowTopologyPositionedEdge> Edges { get; set; } = [];
    private double CanvasWidth { get; set; } = 600;
    private double CanvasHeight { get; set; } = 260;
    private double Zoom { get; set; } = 1;
    private bool expanded;
    private bool fitToViewport;
    private int ZoomPercent => (int)Math.Round(Zoom * 100);
    private string CanvasStyle => fitToViewport
        ? "width:100%;min-width:0"
        : $"width:{(CanvasWidth * Zoom).ToString(System.Globalization.CultureInfo.InvariantCulture)}px;min-width:{(CanvasWidth * Zoom).ToString(System.Globalization.CultureInfo.InvariantCulture)}px";

    [Parameter, EditorRequired] public FlowTopologyGraph Graph { get; set; } = new([], [], "horizontal", "Flow topology");
    [Parameter] public string? SelectedKey { get; set; }
    [Parameter] public EventCallback<string> SelectedKeyChanged { get; set; }
    [Parameter] public bool ShowInspectorControl { get; set; }
    [Parameter] public bool InspectorVisible { get; set; }
    [Parameter] public EventCallback<bool> InspectorVisibleChanged { get; set; }

    private string DeclaredMarker => $"{markerPrefix}-declared";
    private string ObservedMarker => $"{markerPrefix}-observed";
    private string InactiveMarker => $"{markerPrefix}-inactive";

    protected override void OnParametersSet()
    {
        var geometry = FlowTopologyGeometry.Calculate(Graph);
        Nodes = geometry.Nodes;
        Edges = geometry.Edges;
        CanvasWidth = geometry.CanvasWidth;
        CanvasHeight = geometry.CanvasHeight;
    }

    private Task SelectAsync(string key) => SelectedKeyChanged.InvokeAsync(key);

    private void ZoomIn()
    {
        fitToViewport = false;
        Zoom = Math.Min(2.5, Zoom + 0.15);
    }

    private void ZoomOut()
    {
        fitToViewport = false;
        Zoom = Math.Max(0.5, Zoom - 0.15);
    }

    private void Fit()
    {
        Zoom = 1;
        fitToViewport = true;
    }

    private void ToggleExpanded() => expanded = !expanded;

    private Task ToggleInspectorAsync() => InspectorVisibleChanged.InvokeAsync(!InspectorVisible);

    private Task OnNodeKeyDownAsync(KeyboardEventArgs eventArgs, string key) =>
        eventArgs.Key is "Enter" or " " ? SelectAsync(key) : Task.CompletedTask;

    private string Marker(FlowTopologyEdgeState state) => state switch
    {
        FlowTopologyEdgeState.Observed => ObservedMarker,
        FlowTopologyEdgeState.Inactive => InactiveMarker,
        _ => DeclaredMarker
    };

    private static string EdgeClass(FlowTopologyEdge edge) => $"{edge.Kind.ToString().ToLowerInvariant()} {edge.State.ToString().ToLowerInvariant()}";

    private static bool ShowLabel(FlowTopologyEdge edge) =>
        !string.IsNullOrWhiteSpace(edge.Label) && edge.Label is not "handoff" and not "terminal";

    private static string NodeClass(FlowTopologyNode node)
    {
        var status = node.Status?.ToLowerInvariant() ?? "declared";
        return $"{node.Type.ToLowerInvariant()} status-{status}{(node.IsCoordinator ? " coordinator" : null)}{(node.IsInitial ? " initial" : null)}";
    }

    private string NodeDescription(FlowTopologyNode node)
    {
        var parts = new List<string> { node.Label, node.Type };
        if (node.IsInitial) parts.Add(T("InitialParticipant"));
        if (node.Status is not null) parts.Add(node.Status);
        if (node.TurnCount > 0) parts.Add(T(node.TurnCount == 1 ? "TurnCount.One" : "TurnCount.Many", node.TurnCount));
        return string.Join(", ", parts);
    }

    private string EdgeDescription(FlowTopologyEdge edge) =>
        T("EdgeDescription", edge.From, edge.To, edge.Label is null ? string.Empty : $", {edge.Label}", T($"EdgeState.{edge.State}"));

    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;

    private static string Icon(string type) => type.ToLowerInvariant() switch
    {
        "agent" => "◎",
        "router" => "◇",
        "condition" => "?",
        "transform" => "ƒ",
        "output" => "□",
        "failure" => "!",
        "manager" => "M",
        "conversation" => "↔",
        "flow" => "F",
        _ => "●"
    };

    private static string Trim(string value, int length) => value.Length <= length ? value : $"{value[..(length - 1)]}…";

}
