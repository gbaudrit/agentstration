@using static Agentstration.Web.FlowDesigner.Components.FlowInspectorPresentation
@inject IStringLocalizer<FlowDesignerStrings> Localizer

@if (ActiveTab == FlowStepSettingsTab.Configuration)
{
    <FormField Label="@T("LeftValue")"><ChildContent><ClearableText Disabled="@ReadOnly" Value="@Step.Left" ValueChanged="changed => UpdateSelectedAsync.InvokeAsync(Step with { Left = Text(new ChangeEventArgs { Value = changed }) })" /></ChildContent></FormField>
    <FormField Label="@T("Operator")"><ChildContent><ClearableText Disabled="@ReadOnly" Value="@Step.Operator" ValueChanged="changed => UpdateSelectedAsync.InvokeAsync(Step with { Operator = Text(new ChangeEventArgs { Value = changed }) })" /></ChildContent></FormField>
    <FormField Label="@T("RightValue")"><ChildContent><ClearableText Disabled="@ReadOnly" Value="@Step.Right" ValueChanged="changed => UpdateSelectedAsync.InvokeAsync(Step with { Right = Text(new ChangeEventArgs { Value = changed }) })" /></ChildContent></FormField>
}

@code {
    [Parameter, EditorRequired] public ConditionFlowStepDefinition Step { get; set; } = default!;
    [Parameter] public FlowStepSettingsTab ActiveTab { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback<FlowStepDefinition> UpdateSelectedAsync { get; set; }

    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
}
