@inject IStringLocalizer<FlowDesignerStrings> Localizer

<section class="source-editor">
    <header><h2>@Localizer["YamlDefinition"]</h2><button class="button-secondary" disabled="@IsReadOnly" @onclick="Apply">@Localizer["ApplyValidYaml"]</button></header>
    <StandaloneCodeEditor @ref="editor" Id="flow-source-monaco" ConstructionOptions="Options" OnDidChangeModelContent="Changed" />
    @if (Error is not null) { <p class="error-panel">@Error</p> }
    <p class="muted">@Localizer["InvalidSourceHelp"]</p>
</section>

@code {
    private StandaloneCodeEditor? editor;
    private string initialValue = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool IsReadOnly { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public EventCallback<string> ApplyRequested { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (editor is not null && Value != initialValue)
        {
            initialValue = Value;
            await editor.SetValue(Value);
        }
    }

    private StandaloneEditorConstructionOptions Options(StandaloneCodeEditor _) => new()
    {
        AutomaticLayout = true,
        Language = "yaml",
        Value = initialValue = Value,
        ReadOnly = IsReadOnly,
        Minimap = new EditorMinimapOptions { Enabled = false },
        WordWrap = "on"
    };

    private async Task Changed(ModelContentChangedEvent _)
    {
        if (IsReadOnly) return;
        if (editor is not null) await ValueChanged.InvokeAsync(await editor.GetValue());
    }

    private async Task Apply()
    {
        if (IsReadOnly) return;
        var value = editor is null ? Value : await editor.GetValue();
        await ApplyRequested.InvokeAsync(value);
    }
}
