@using static Agentstration.Web.FlowDesigner.Components.FlowInspectorPresentation
@inject IStringLocalizer<FlowDesignerStrings> Localizer

@if (ActiveTab == FlowStepSettingsTab.Configuration)
{
    <div class="inspector-details-group inspector-resource-details">
        <h3>@T("CalledResource")</h3>
        <div class="inspector-resource-field">
            <div class="inspector-resource-heading">
                <label for="flow-agent-reference">@T("CalledAgent")</label>
                @if (SelectedAgent is { } selectedAgent)
                {
                    <a class="inspector-resource-link" href="@AgentUrl(selectedAgent)" target="_blank" rel="noopener noreferrer" aria-label="@T("OpenAgentInNewTab")"><UiIcon Name="external-link" />@T("OpenAgent")</a>
                }
            </div>
            <ClearableSelect TValue="string" id="flow-agent-reference" disabled="@ReadOnly" Value="@Convert.ToString(SelectionValue, System.Globalization.CultureInfo.InvariantCulture)" ValueChanged="changed => UpdateAgentAsync.InvokeAsync(new ChangeEventArgs { Value = changed })">
                <option value="${steps.route-request.output.selectedAgent}">@T("RouterOutput")</option>
                @if (SelectedAgent is null && !Step.Agent.ResourceId.StartsWith("${", StringComparison.Ordinal))
                {
                    <option value="@SelectionValue">@(Step.Agent.ResourceId == "unconfigured"
                        ? T("AgentNotSelected")
                        : T("UnavailableReference", ResourceIdentity(Step.Agent.ScopeRef, Step.Agent.Namespace ?? Namespace, Step.Agent.ResourceId)))</option>
                }
                @foreach (var item in Agents) { <option value="@ResourceKey(item.ScopeRef, item.Namespace, item.Name)">@ResourceOptionLabel(Localizer, item.DisplayName, item.Namespace, item.ScopeRef)</option> }
            </ClearableSelect>
        </div>
        @if (SelectedAgent is { } referencedAgent)
        {
            <p class="inspector-resource-id">@T("AgentId") <code>@referencedAgent.Name</code></p>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public AgentFlowStepDefinition Step { get; set; } = default!;
    [Parameter] public FlowStepSettingsTab ActiveTab { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public FlowDesignerAgent? SelectedAgent { get; set; }
    [Parameter] public IReadOnlyList<FlowDesignerAgent> Agents { get; set; } = [];
    [Parameter] public string SelectionValue { get; set; } = string.Empty;
    [Parameter] public ResourceNamespace Namespace { get; set; } = ResourceNamespace.Default;
    [Parameter] public EventCallback<ChangeEventArgs> UpdateAgentAsync { get; set; }

    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
}
