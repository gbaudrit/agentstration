@inject IStringLocalizer<FlowDesignerStrings> Localizer

@if (ActiveTab == FlowStepSettingsTab.Configuration)
{
    <p class="muted">@T("ArtifactProcessingHelp")</p>
    <FormField Label="@T("ArtifactProcessingMode")">
        <ClearableSelect TValue="string" AllowClear="false" data-testid="artifact-processing-mode" disabled="@ReadOnly" Value="@Step.Mode.ToString()" ValueChanged="value => ModeChangedAsync(new ChangeEventArgs { Value = value })">
            <option value="Content">@T("ArtifactProcessingMode.Content")</option>
            <option value="Access">@T("ArtifactProcessingMode.Access")</option>
        </ClearableSelect>
    </FormField>
    <p class="muted">@T(Step.Mode == ArtifactProcessingMode.Content ? "ArtifactContentHelp" : "ArtifactAccessHelp")</p>
    <FormField Label="@T("ProcessConcurrency")" Help="@T("ProcessConcurrency.Help")"><ClearableText UpdateOnInput="false" data-testid="artifact-process-concurrency" Type="number" min="1" max="16" Disabled="@ReadOnly" Value="@((Step.MaximumConcurrency ?? 1).ToString(System.Globalization.CultureInfo.InvariantCulture))" ValueChanged="value => ConcurrencyChangedAsync(new ChangeEventArgs { Value = value })" /></FormField>
    <FormField Label="@T("ArtifactMaximumCount")"><ClearableText UpdateOnInput="false" Type="number" min="1" max="128" Disabled="@ReadOnly" Value="@Step.MaximumArtifacts.ToString(System.Globalization.CultureInfo.InvariantCulture)" ValueChanged="value => LimitChangedAsync(new ChangeEventArgs { Value = value }, true)" /></FormField>
    <FormField Label="@T("ArtifactMaximumInput")"><ClearableText UpdateOnInput="false" Type="number" min="1" Disabled="@ReadOnly" Value="@Step.MaximumContentBytes.ToString(System.Globalization.CultureInfo.InvariantCulture)" ValueChanged="value => LimitChangedAsync(new ChangeEventArgs { Value = value }, false)" /></FormField>
    <FormField Label="@T("ArtifactMaximumOutput")"><ClearableText UpdateOnInput="false" Type="number" min="1" Disabled="@ReadOnly" Value="@Step.MaximumOutputBytes.ToString(System.Globalization.CultureInfo.InvariantCulture)" ValueChanged="value => OutputLimitChangedAsync(new ChangeEventArgs { Value = value })" /></FormField>
    <FormField Label="@T("ArtifactOutputName")"><ClearableText UpdateOnInput="false" Disabled="@ReadOnly" Value="@Step.OutputFileName" ValueChanged="value => Changed.InvokeAsync(Step with { OutputFileName = Optional(new ChangeEventArgs { Value = value }) })" /></FormField>
    <FormField Label="@T("ArtifactOutputMediaType")" Help="@T("ArtifactOutputMediaTypeHelp")"><ClearableText UpdateOnInput="false" list="@mediaTypesId" data-testid="artifact-output-media-type" Disabled="@ReadOnly" Value="@Step.OutputMediaType" ValueChanged="value => Changed.InvokeAsync(Step with { OutputMediaType = Optional(new ChangeEventArgs { Value = value }) })" /></FormField>
    <datalist id="@mediaTypesId">@foreach (var media in SuggestedMediaTypes) { <option value="@media"></option> }</datalist>
}
@if (ActiveTab == FlowStepSettingsTab.Input)
{
    <ContractHeading Direction="Input" Source="@T("ContractSource.ArtifactEnvelope")" />
    <SchemaDocumentEditor Value="ArtifactTransformContracts.Input" ReadOnly="true" />
    <p class="muted">@T("ArtifactInputContentContract")</p>
    <FormField Label="@T("ArtifactManifestMapping")"><ClearableText UpdateOnInput="false" Multiline="true" data-testid="artifact-manifest-mapping" Disabled="@ReadOnly" Value="@(Step.ArtifactsMapping?.GetRawText() ?? "null")" ValueChanged="value => MappingChangedAsync(new ChangeEventArgs { Value = value }, 0)" /></FormField>
    <FormField Label="@T("ArtifactProcessingInputMapping")"><ClearableText UpdateOnInput="false" Multiline="true" data-testid="artifact-input-mapping" Disabled="@ReadOnly" Value="@(Step.ProcessingInputMapping?.GetRawText() ?? "null")" ValueChanged="value => MappingChangedAsync(new ChangeEventArgs { Value = value }, 1)" /></FormField>
    <p class="muted">@T("ArtifactProcessingInputHelp")</p>
}
@if (ActiveTab == FlowStepSettingsTab.Output)
{
    <ContractHeading Direction="Output" Source="@T("ContractSource.ArtifactEnvelope")" />
    <SchemaDocumentEditor Value="ArtifactTransformContracts.Manifest" ReadOnly="true" />
    <FormField Label="@T("ArtifactResultMapping")"><ClearableText UpdateOnInput="false" Multiline="true" data-testid="artifact-result-mapping" Disabled="@ReadOnly" Value="@(Step.ResultMapping?.GetRawText() ?? "null")" ValueChanged="value => MappingChangedAsync(new ChangeEventArgs { Value = value }, 2)" /></FormField>
    <p class="muted">@T("ArtifactResultHelp")</p>
    <FormField Label="@T("DataContractMode")">
        <ClearableSelect TValue="string" AllowClear="false" disabled="@ReadOnly" Value="@((Step.OutputContract?.Mode ?? DataContractMode.Absent).ToString())" ValueChanged="value => ContractModeChangedAsync(new ChangeEventArgs { Value = value })">
            @foreach (var mode in Enum.GetValues<DataContractMode>()) { <option value="@mode">@T($"DataContractMode.{mode}")</option> }
        </ClearableSelect>
    </FormField>
    <p class="muted">@T("ArtifactContractHelp")</p>
    @if (Step.OutputContract is { Mode: DataContractMode.Fixed } fixedContract)
    {
        <FormField Label="@T("ArtifactDataSchema")"><ClearableText UpdateOnInput="false" Multiline="true" Disabled="@ReadOnly" Value="@(fixedContract.Schema?.GetRawText() ?? "{}")" ValueChanged="value => ContractSchemaChangedAsync(new ChangeEventArgs { Value = value })" /></FormField>
    }
    @if (Step.OutputContract is { Mode: DataContractMode.Dynamic } dynamicContract)
    {
        <FormField Label="@T("ContractSource")"><ClearableSelect TValue="string" AllowClear="false" disabled="@ReadOnly" Value="@dynamicContract.Source" ValueChanged="value => ContractSourceChangedAsync(new ChangeEventArgs { Value = value })">
            <option value="input">@T("ContractSource.Input")</option><option value="parent">@T("ContractSource.Parent")</option>
        </ClearableSelect></FormField>
    }
}
@if (invalidJson) { <p class="validation-error" role="alert">@T("InvalidJson")</p> }

@code {
    [Parameter, EditorRequired] public ForeachArtifactsFlowStepDefinition Step { get; set; } = default!;
    [Parameter] public FlowStepSettingsTab ActiveTab { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback<FlowStepDefinition> Changed { get; set; }
    private Task ContractSourceChangedAsync(ChangeEventArgs args) => Changed.InvokeAsync(Step with { OutputContract = Step.OutputContract! with { Source = args.Value?.ToString() ?? "input" } });
    private Task ContractModeChangedAsync(ChangeEventArgs args) => Enum.TryParse<DataContractMode>(args.Value?.ToString(), out var mode)
        ? Changed.InvokeAsync(Step with { OutputContract = mode == DataContractMode.Absent ? null : new() { Mode = mode,
            Schema = mode == DataContractMode.Fixed ? JsonSerializer.SerializeToElement(new { }) : null } }) : Task.CompletedTask;
    private async Task ContractSchemaChangedAsync(ChangeEventArgs args)
    {
        try
        {
            var schema = JsonSerializer.Deserialize<JsonElement>(args.Value?.ToString() ?? "{}");
            DataContracts.ValidateDefinition(new() { Schema = schema }, "artifact-output");
            invalidJson = false;
            await Changed.InvokeAsync(Step with { OutputContract = new() { Schema = schema } });
        }
        catch (Exception exception) when (exception is JsonException or DataContractException) { invalidJson = true; }
    }
    private bool invalidJson;
    private readonly string mediaTypesId = "artifact-media-types-" + Guid.NewGuid().ToString("N");
    private static readonly string[] SuggestedMediaTypes = ["text/plain", "application/json", "text/markdown", "text/csv", "text/html", "text/xml", "application/ld+json", "application/geo+json"];
    private string T(string key) => Localizer[key].Value;
    private static string? Optional(ChangeEventArgs args) => string.IsNullOrWhiteSpace(args.Value?.ToString()) ? null : args.Value.ToString();
    private Task ModeChangedAsync(ChangeEventArgs args) => Enum.TryParse<ArtifactProcessingMode>(args.Value?.ToString(), out var mode)
        ? Changed.InvokeAsync(Step with { Mode = mode }) : Task.CompletedTask;
    private Task LimitChangedAsync(ChangeEventArgs args, bool count) => int.TryParse(args.Value?.ToString(), out var limit)
        ? Changed.InvokeAsync(count ? Step with { MaximumArtifacts = limit } : Step with { MaximumContentBytes = limit }) : Task.CompletedTask;
    private Task ConcurrencyChangedAsync(ChangeEventArgs args) => int.TryParse(args.Value?.ToString(), out var value)
        ? Changed.InvokeAsync(Step with { MaximumConcurrency = value }) : Task.CompletedTask;
    private Task OutputLimitChangedAsync(ChangeEventArgs args) => int.TryParse(args.Value?.ToString(), out var limit)
        ? Changed.InvokeAsync(Step with { MaximumOutputBytes = limit }) : Task.CompletedTask;
    private async Task MappingChangedAsync(ChangeEventArgs args, int field)
    {
        try
        {
            var value = JsonSerializer.Deserialize<JsonElement>(args.Value?.ToString() ?? "null");
            JsonElement? mapping = value.ValueKind == JsonValueKind.Null ? null : value;
            invalidJson = false;
            await Changed.InvokeAsync(field switch { 0 => Step with { ArtifactsMapping = mapping },
                1 => Step with { ProcessingInputMapping = mapping }, _ => Step with { ResultMapping = mapping } });
        }
        catch (JsonException) { invalidJson = true; }
    }
}
