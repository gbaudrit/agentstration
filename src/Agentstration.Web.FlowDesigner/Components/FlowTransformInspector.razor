@using Agentstration.Web.FlowDesigner.Backend
@using Agentstration.Functions.Contracts
@using static Agentstration.Web.FlowDesigner.Components.FlowInspectorPresentation
@inject IStringLocalizer<FlowDesignerStrings> Localizer

@if (ActiveTab == FlowStepSettingsTab.Configuration)
{
    <label>@T("TransformFunction")<select value="@(Step.Function is null ? string.Empty : FunctionKey(Step.Function))" @onchange="SelectFunctionAsync" disabled="@ReadOnly" data-testid="transform-function">
        <option value="">@T("TransformMappingOnly")</option>
        @if (Step.Function is { } saved && Functions.All(choice => FunctionKey(choice.Function.Reference) != FunctionKey(saved))) { <option value="@FunctionKey(saved)">@saved.Name · @saved.Version</option> }
        @foreach (var choice in Functions) { <option value="@FunctionKey(choice.Function.Reference)">@choice.DisplayName</option> }
    </select></label>
    <label>@T("TransformMapping")<textarea data-testid="transform-mapping" disabled="@ReadOnly" value="@JsonText(Step.Mapping)" @onchange="UpdateTransformMappingAsync"></textarea></label>
}
@if (ActiveTab == FlowStepSettingsTab.Input)
{
    <section class="step-contract-section">
        <ContractHeading Direction="Input" Source="@T("ContractSource.IncomingTransition")" />
        @if (EffectiveIncomingSchema is { } incomingSchema)
        {
            <SchemaDocumentEditor Value="incomingSchema" ReadOnly="true" />
        }
        else
        {
            <p class="step-contract-empty muted">@IncomingContractUnavailableText</p>
        }
    </section>
}
@if (ActiveTab == FlowStepSettingsTab.Output)
{
    <section class="step-contract-section">
        <ContractHeading Direction="Output" Source="@T("ContractSource.Step")" />
        <SchemaBindingEditor Title="@T("OutputSchema")" TestId="transform-output-schema"
            Binding="@Step.SchemaBinding" LegacySchema="@Step.Schema" SchemaVersions="SchemaVersions"
            ValueChanged="UpdateTransformSchemaBindingAsync" ReadOnly="ReadOnly"
            DefinitionValidator="ValidateSchemaDefinitionAsync" InstanceValidator="ValidateSchemaInstanceAsync" />
    </section>
}

@code {
    [Parameter] public IReadOnlyList<FlowDesignerFunction> Functions { get; set; } = [];
    [Parameter, EditorRequired] public TransformFlowStepDefinition Step { get; set; } = default!;
    [Parameter] public FlowStepSettingsTab ActiveTab { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback<FlowStepDefinition> Changed { get; set; }
    [Parameter] public JsonElement? EffectiveIncomingSchema { get; set; }
    [Parameter] public string IncomingContractUnavailableText { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<FlowDesignerSchemaVersion> SchemaVersions { get; set; } = [];
    [Parameter] public EventCallback<ChangeEventArgs> UpdateTransformMappingAsync { get; set; }
    [Parameter] public EventCallback<SchemaBindingEditorValue> UpdateTransformSchemaBindingAsync { get; set; }
    [Parameter] public Func<ValidateSchemaDefinitionRequest, Task<SchemaFormatValidationResult>>? ValidateSchemaDefinitionAsync { get; set; }
    [Parameter] public Func<ValidateSchemaInstanceRequest, Task<SchemaFormatValidationResult>>? ValidateSchemaInstanceAsync { get; set; }

    private static string FunctionKey(FunctionReference reference) => $"{reference.ScopeRef}|{reference.Namespace}|{reference.Name}|{reference.Version}";
    private Task SelectFunctionAsync(ChangeEventArgs args)
    {
        if (ReadOnly) return Task.CompletedTask;
        var selected = Functions.FirstOrDefault(choice => FunctionKey(choice.Function.Reference) == args.Value?.ToString());
        return Changed.InvokeAsync(Step with { Function = selected?.Function.Reference, FunctionInputSchema = selected?.Function.InputSchema, Schema = selected?.Function.OutputSchema,
            Mapping = selected is null ? Step.Mapping : JsonSerializer.SerializeToElement(new { value = "${transition.output}" }) });
    }
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
}
