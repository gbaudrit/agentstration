@implements IAsyncDisposable
@inject IFlowDesignerBackend Backend
@inject IFlowDesignerResourceProvider Resources
@inject FlowEditorStore Editor
@inject NavigationManager Navigation

@if (Editor.State.Draft is null && error is not null)
{
    <section class="error-panel designer-error"><strong>Flow Designer unavailable</strong><p>@error</p></section>
}
else if (Editor.State.Draft is null)
{
    <LoadingState />
}
else
{
    <header class="designer-toolbar">
        <div>
            <p class="eyebrow"><a href="/flows">Flows</a> / @ResourceId / Draft</p>
            <h1>@Editor.State.Draft.DisplayName</h1>
            <span class="save-state @Editor.State.SaveState.ToString().ToLowerInvariant()">@SaveText</span>
            <span class="draft-revision">Revision @Editor.State.Draft.Revision</span>
            @if (IsReadOnly) { <span class="read-only-badge">Read only</span> }
        </div>
        <div class="designer-modes">
            @foreach (var mode in Enum.GetValues<FlowEditorMode>())
            {
                <button class="@(Editor.State.Mode == mode ? "active" : null)" @onclick="() => Editor.SetMode(mode)">@mode</button>
            }
        </div>
        <div class="designer-actions">
            <button class="button-secondary" disabled="@(!Editor.CanUndo || IsReadOnly)" @onclick="Undo">Undo</button>
            <button class="button-secondary" disabled="@(!Editor.CanRedo || IsReadOnly)" @onclick="Redo">Redo</button>
            <button class="button-secondary" @onclick="ValidateAsync">Validate</button>
            <button class="button-secondary" disabled="@IsReadOnly" @onclick="OpenRun">Run draft</button>
            <button class="button-primary" disabled="@(saving || IsReadOnly)" @onclick="SaveAsync">Save</button>
            <label class="publish-version">Version<input aria-label="Publish version" disabled="@IsReadOnly" @bind="publishVersion" /></label>
            <button class="button-primary" disabled="@IsReadOnly" @onclick="PublishAsync">Publish</button>
        </div>
    </header>

    @if (error is not null) { <p class="error-panel designer-error">@error</p> }

    <section class="flow-editor-shell @Editor.State.Mode.ToString().ToLowerInvariant()">
        @if (Editor.State.Mode is FlowEditorMode.Designer or FlowEditorMode.Split)
        {
            <aside class="step-palette">
                <h2>Steps</h2>
                @foreach (var entry in Palette)
                {
                    <button disabled="@IsReadOnly" @onclick="() => AddStepAsync(entry.Type)"><span>@entry.Icon</span> @entry.Label</button>
                }
                <hr />
                <button disabled="@IsReadOnly" @onclick="() => LayoutAsync(false)">Horizontal layout</button>
                <button disabled="@IsReadOnly" @onclick="() => LayoutAsync(true)">Vertical layout</button>
                <button @onclick="Center">Center</button>
            </aside>

            <div class="flow-canvas-wrap">
                <FlowCanvas @ref="canvas" Document="Editor.State.Diagram" Revision="Editor.State.LocalRevision" FitRevision="layoutRevision"
                            IsReadOnly="IsReadOnly" SelectedStepChanged="Editor.SelectStep"
                            StepMoved="MoveStepAsync" TransitionCreated="CreateTransitionAsync"
                            TransitionRemoved="RemoveTransitionAsync" />
            </div>

            <aside class="flow-inspector">
                <h2>Inspector</h2>
                @if (SelectedStep is null)
                {
                    <p class="muted">Select a step to edit it.</p>
                }
                else
                {
                    <label>Display name<input disabled="@IsReadOnly" value="@(SelectedStep.DisplayName ?? SelectedStep.Name)" @onchange="UpdateDisplayNameAsync" /></label>
                    <label>Technical name<input value="@SelectedStep.Name" readonly /></label>
                    <label>Type<input value="@SelectedStep.Type()" readonly /></label>
                    @if (SelectedStep is AgentFlowStepDefinition agent)
                    {
                        <label>Agent<select disabled="@IsReadOnly" value="@agent.Agent.ResourceId" @onchange="UpdateAgentAsync">
                            <option value="${steps.route-request.output.selectedAgent}">Router output</option>
                            @foreach (var item in agents) { <option value="@item.Name">@item.DisplayName</option> }
                        </select></label>
                    }
                    else if (SelectedStep is RouterFlowStepDefinition router)
                    {
                        <section class="router-editor">
                            <div class="router-group-picker">
                                <button class="button-secondary" @onclick="LoadAgentsAsync">Load agents</button>
                                <button class="button-secondary" disabled="@(IsReadOnly || loadingAgents)" @onclick="AddAllRouterAgentsAsync">Add all</button>
                            </div>
                            <p class="muted">@routerAgents.Count agent(s) available. Routes are explicit and remain immutable references when published.</p>
                            <div class="route-cards">
                                @for (var index = 0; index < router.Candidates.Count; index++)
                                {
                                    var routeIndex = index;
                                    var candidate = router.Candidates[index];
                                    <article class="route-card">
                                        <header><span class="route-key-badge">@candidate.Route</span><button disabled="@IsReadOnly" @onclick="() => RemoveRouterCandidateAsync(routeIndex)">×</button></header>
                                        <label>Route key<input disabled="@IsReadOnly" value="@candidate.Route" @onchange="e => UpdateRouterCandidateAsync(routeIndex, c => c with { Route = Text(e) })" /></label>
                                        <label>Agent<select disabled="@IsReadOnly" value="@candidate.Agent.ResourceId" @onchange="e => UpdateRouterCandidateAsync(routeIndex, c => c with { Agent = new(Text(e)) })">
                                            <option value="@candidate.Agent.ResourceId">@AgentLabel(candidate.Agent.ResourceId)</option>
                                            @foreach (var item in routerAgents.Where(item => item.Name != candidate.Agent.ResourceId)) { <option value="@item.Name">@item.DisplayName</option> }
                                        </select></label>
                                        <label>Description<input disabled="@IsReadOnly" value="@candidate.Description" @onchange="e => UpdateRouterCandidateAsync(routeIndex, c => c with { Description = EmptyToNull(Text(e)) })" /></label>
                                        <label>Examples<input disabled="@IsReadOnly" value="@string.Join(", ", candidate.Examples ?? [])" @onchange="e => UpdateRouterCandidateAsync(routeIndex, c => c with { Examples = Text(e).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) })" /></label>
                                    </article>
                                }
                            </div>
                            <button class="button-secondary" disabled="@IsReadOnly" @onclick="AddRouterCandidateAsync">＋ Add route</button>
                        </section>
                    }
                    else if (SelectedStep is ConditionFlowStepDefinition condition)
                    {
                        <label>Left value<input disabled="@IsReadOnly" value="@condition.Left" @onchange="e => UpdateSelectedAsync(condition with { Left = Text(e) })" /></label>
                        <label>Operator<input disabled="@IsReadOnly" value="@condition.Operator" @onchange="e => UpdateSelectedAsync(condition with { Operator = Text(e) })" /></label>
                        <label>Right value<input disabled="@IsReadOnly" value="@condition.Right" @onchange="e => UpdateSelectedAsync(condition with { Right = Text(e) })" /></label>
                    }
                    else if (SelectedStep is FailureFlowStepDefinition failure)
                    {
                        <label>Error code<input disabled="@IsReadOnly" value="@failure.Code" @onchange="e => UpdateSelectedAsync(failure with { Code = Text(e) })" /></label>
                        <label>Message<textarea disabled="@IsReadOnly" value="@failure.Message" @onchange="e => UpdateSelectedAsync(failure with { Message = Text(e) })"></textarea></label>
                    }
                    <button class="button-danger" disabled="@(IsReadOnly || SelectedStep.Name == Editor.State.Draft.Definition.EntryStep)" @onclick="RemoveSelectedAsync">Delete step</button>
                }

                <hr /><h3>Transitions</h3>
                <label>From<select disabled="@IsReadOnly" @bind="transitionFrom">@foreach (var node in Editor.State.Diagram.Nodes) { <option value="@node.Name">@node.Name</option> }</select></label>
                <label>Event<input disabled="@IsReadOnly" @bind="transitionEvent" /></label>
                <label>To<select disabled="@IsReadOnly" @bind="transitionTo">@foreach (var node in Editor.State.Diagram.Nodes) { <option value="@node.Name">@node.Name</option> }</select></label>
                <button class="button-secondary" disabled="@IsReadOnly" @onclick="AddTransitionAsync">Add transition</button>
                <ul class="transition-list">@foreach (var transition in Editor.State.Draft.Definition.Transitions) { <li><button @onclick="() => Editor.SelectTransition(transition.Id)">@transition.FromStep —@transition.Event→ @transition.ToStep</button><button disabled="@IsReadOnly" @onclick="() => RemoveTransitionAsync(transition.Id)">×</button></li> }</ul>
            </aside>
        }

        @if (Editor.State.Mode is FlowEditorMode.Definition or FlowEditorMode.Split)
        {
            <FlowSourceEditor Value="sourceText" ValueChanged="SourceChanged" Error="Editor.State.SourceError"
                              IsReadOnly="IsReadOnly" ApplyRequested="ApplySourceAsync" />
        }
    </section>

    <section class="validation-dock">
        <header><strong>Validation</strong><span>@Editor.State.Issues.Count issue(s)</span></header>
        @if (Editor.State.Issues.Count == 0) { <p class="muted">Validate the Draft to check structure, reachability, expressions and resources.</p> }
        else { <ul>@foreach (var issue in Editor.State.Issues) { <li class="@issue.Severity.ToString().ToLowerInvariant()"><button @onclick="() => SelectIssue(issue)"><strong>@issue.Severity</strong> @issue.Message <code>@issue.Code</code></button></li> }</ul> }
    </section>

    @if (showRun)
    {
        <div class="dialog-backdrop"><section class="dialog run-dialog"><h2>Run Draft revision @Editor.State.Draft.Revision</h2><label>Input JSON<textarea rows="10" @bind="runInput"></textarea></label><div class="dialog-actions"><button class="button-secondary" @onclick="() => showRun = false">Cancel</button><button class="button-primary" @onclick="RunDraftAsync">Run draft</button></div></section></div>
    }
}

@code {
    private static readonly (string Type, string Label, string Icon)[] Palette = [("input", "Input", "●"), ("agent", "Agent", "◎"), ("router", "Router", "◇"), ("condition", "Condition", "?"), ("transform", "Transform", "ƒ"), ("output", "Output", "□"), ("failure", "Failure", "!")];
    private readonly CancellationTokenSource cancellation = new();
    private CancellationTokenSource? autosave;
    private FlowCanvas? canvas;
    private IReadOnlyList<FlowDesignerAgent> agents = [];
    private IReadOnlyList<FlowDesignerAgent> routerAgents = [];
    private string? loadedResource;
    private string sourceText = string.Empty;
    private string transitionFrom = string.Empty;
    private string transitionTo = string.Empty;
    private string transitionEvent = "completed";
    private string publishVersion = "1.0.0";
    private string runInput = "{\n  \"prompt\": \"How can I optimize this SQL query?\"\n}";
    private string? error;
    private bool saving;
    private bool showRun;
    private bool loadingAgents;
    private long layoutRevision;

    [Parameter, EditorRequired] public string ResourceId { get; set; } = string.Empty;
    [Parameter] public bool IsReadOnly { get; set; }

    private FlowStepDefinition? SelectedStep => Editor.State.Draft?.Definition.Steps.FirstOrDefault(step => step.Name == Editor.State.Selection.StepName);
    private string SaveText => Editor.State.SaveState switch { FlowSaveState.Saving => "Saving…", FlowSaveState.UnsavedChanges => "Unsaved changes", FlowSaveState.SaveFailed => "Save failed", _ => "Saved" };

    protected override async Task OnParametersSetAsync()
    {
        if (loadedResource == ResourceId) return;
        loadedResource = ResourceId;
        Editor.StateChanged += EditorChanged;
        try
        {
            error = null;
            var draft = await Backend.GetDraftAsync(ResourceId, cancellation.Token);
            sourceText = (await Backend.GetSourceAsync(ResourceId, cancellation.Token)).Source;
            Editor.Load(draft, sourceText);
            agents = routerAgents = await Resources.GetAgentsAsync(cancellation.Token);
            transitionFrom = draft.Value.Definition.EntryStep;
            transitionTo = draft.Value.Definition.Steps.Skip(1).FirstOrDefault()?.Name ?? transitionFrom;
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            error = exception.Message;
        }
    }

    private async Task DispatchAsync(IFlowEditorCommand command)
    {
        if (IsReadOnly) return;
        await Editor.DispatchAsync(command, cancellation.Token);
        ScheduleAutosave();
    }

    private Task MoveStepAsync(MoveStepCommand command) => DispatchAsync(command);
    private Task CreateTransitionAsync(FlowTransitionDefinition transition) => DispatchAsync(new AddTransitionCommand(transition));
    private Task RemoveTransitionAsync(string id) => DispatchAsync(new RemoveTransitionCommand(id));
    private async Task LayoutAsync(bool vertical)
    {
        await DispatchAsync(new ApplyAutoLayoutCommand(vertical));
        layoutRevision++;
    }
    private void Center() => canvas?.Center();
    private void EditorChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);
    private void SourceChanged(string source) { sourceText = source; Editor.SetSource(source, Editor.State.SourceError); }

    private async Task SaveAsync()
    {
        if (IsReadOnly || Editor.State.Draft is null || Editor.State.ETag is null || !Editor.State.IsDirty) return;
        try
        {
            saving = true; error = null; Editor.MarkSaving();
            var draft = Editor.State.Draft;
            var saved = await Backend.SaveDraftAsync(ResourceId, new(draft.DisplayName, draft.Description, draft.Tags, draft.Definition), Editor.State.ETag, cancellation.Token);
            var source = await Backend.GetSourceAsync(ResourceId, cancellation.Token);
            sourceText = source.Source; Editor.MarkSaved(saved, source.Source);
        }
        catch (Exception exception) { error = exception.Message; Editor.MarkSaveFailed(); }
        finally { saving = false; }
    }

    private async Task ValidateAsync() => Editor.SetIssues((await Backend.ValidateAsync(ResourceId, cancellation.Token)).Issues);
    private async Task PublishAsync() { await SaveAsync(); try { var version = await Backend.PublishAsync(ResourceId, new(publishVersion), cancellation.Token); publishVersion = NextVersion(version.Version); await ValidateAsync(); } catch (Exception exception) { error = exception.Message; } }
    private void OpenRun() { showRun = true; error = null; }
    private async Task RunDraftAsync() { try { await SaveAsync(); using var json = JsonDocument.Parse(runInput); var run = await Backend.RunDraftAsync(ResourceId, new(json.RootElement.Clone(), Trigger: FlowRunTrigger.Manual), cancellation.Token); Navigation.NavigateTo($"/flow-runs/{run.Id}"); } catch (Exception exception) { error = exception.Message; } }
    private async Task ApplySourceAsync(string source) { try { var saved = await Backend.ReplaceSourceAsync(ResourceId, new(source), Editor.State.ETag!, cancellation.Token); var canonical = await Backend.GetSourceAsync(ResourceId, cancellation.Token); sourceText = canonical.Source; Editor.MarkSaved(saved, canonical.Source); } catch (Exception exception) { sourceText = source; Editor.SetSource(source, exception.Message); } }

    private async Task AddStepAsync(string type)
    {
        var index = Editor.State.Draft!.Definition.Steps.Count; var name = Unique(type);
        FlowStepDefinition step = type switch
        {
            "input" => new InputFlowStepDefinition { Name = name, DisplayName = "Input" },
            "agent" => new AgentFlowStepDefinition { Name = name, DisplayName = "Agent", Agent = new(agents.FirstOrDefault()?.Name ?? UnconfiguredAgent) },
            "router" => new RouterFlowStepDefinition { Name = name, DisplayName = "Router" },
            "condition" => new ConditionFlowStepDefinition { Name = name, DisplayName = "Condition", Left = "${input.prompt}", Right = "" },
            "transform" => new TransformFlowStepDefinition { Name = name, DisplayName = "Transform", Mapping = JsonSerializer.SerializeToElement(new { }) },
            "output" => new OutputFlowStepDefinition { Name = name, DisplayName = "Output", OutputMapping = JsonSerializer.SerializeToElement("${input}") },
            _ => new FailureFlowStepDefinition { Name = name, DisplayName = "Failure" }
        };
        await DispatchAsync(new AddStepCommand(step, new(40 + index * 180, 250))); Editor.SelectStep(name);
    }

    private async Task AddTransitionAsync() { if (!string.IsNullOrWhiteSpace(transitionFrom) && !string.IsNullOrWhiteSpace(transitionTo)) await CreateTransitionAsync(new($"{transitionFrom}-{transitionEvent}-{transitionTo}", transitionFrom, transitionEvent, transitionTo)); }
    private async Task RemoveSelectedAsync() { if (SelectedStep is not null) { await DispatchAsync(new RemoveStepCommand(SelectedStep.Name)); Editor.SelectStep(null); } }
    private Task UpdateDisplayNameAsync(ChangeEventArgs e) => UpdateSelectedAsync(SelectedStep! with { DisplayName = Text(e) });
    private Task UpdateAgentAsync(ChangeEventArgs e) => UpdateSelectedAsync(((AgentFlowStepDefinition)SelectedStep!) with { Agent = new(Text(e)) });
    private Task UpdateSelectedAsync(FlowStepDefinition step) => DispatchAsync(new UpdateStepCommand(step));

    private async Task LoadAgentsAsync() { try { loadingAgents = true; routerAgents = await Resources.GetAgentsAsync(cancellation.Token); } catch (Exception exception) { error = exception.Message; } finally { loadingAgents = false; } }
    private async Task AddAllRouterAgentsAsync() { await LoadAgentsAsync(); if (SelectedStep is not RouterFlowStepDefinition router) return; var candidates = router.Candidates.ToList(); foreach (var item in routerAgents.Where(item => candidates.All(candidate => candidate.Agent.ResourceId != item.Name))) candidates.Add(new(UniqueRoute(RouteKey(item.DisplayName), candidates), new(item.Name), $"Agent {item.DisplayName}.")); await UpdateSelectedAsync(router with { Candidates = candidates }); }
    private Task AddRouterCandidateAsync() { var router = (RouterFlowStepDefinition)SelectedStep!; var candidates = router.Candidates.ToList(); candidates.Add(new(UniqueRoute("route", candidates), new(routerAgents.FirstOrDefault()?.Name ?? agents.FirstOrDefault()?.Name ?? UnconfiguredAgent))); return UpdateSelectedAsync(router with { Candidates = candidates }); }
    private Task RemoveRouterCandidateAsync(int index) { var router = (RouterFlowStepDefinition)SelectedStep!; return UpdateSelectedAsync(router with { Candidates = router.Candidates.Where((_, i) => i != index).ToArray() }); }
    private Task UpdateRouterCandidateAsync(int index, Func<FlowRouterCandidate, FlowRouterCandidate> update) { var router = (RouterFlowStepDefinition)SelectedStep!; var candidates = router.Candidates.ToArray(); candidates[index] = update(candidates[index]); return UpdateSelectedAsync(router with { Candidates = candidates }); }

    private void Undo() { Editor.Undo(); ScheduleAutosave(); }
    private void Redo() { Editor.Redo(); ScheduleAutosave(); }
    private void SelectIssue(FlowValidationIssue issue) { if (issue.StepId is not null) Editor.SelectStep(issue.StepId); }
    private void ScheduleAutosave() { if (IsReadOnly) return; autosave?.Cancel(); autosave?.Dispose(); autosave = CancellationTokenSource.CreateLinkedTokenSource(cancellation.Token); _ = AutosaveAsync(autosave.Token); }
    private async Task AutosaveAsync(CancellationToken token) { try { await Task.Delay(TimeSpan.FromSeconds(1.5), token); await SaveAsync(); } catch (OperationCanceledException) { } }
    private string Unique(string prefix) { var name = prefix; var i = 1; while (Editor.State.Draft!.Definition.Steps.Any(step => step.Name == name)) name = $"{prefix}-{++i}"; return name; }
    private static string UniqueRoute(string prefix, IReadOnlyCollection<FlowRouterCandidate> candidates) { var route = prefix; var i = 1; while (candidates.Any(candidate => candidate.Route == route)) route = $"{prefix}-{++i}"; return route; }
    private static string RouteKey(string value) { var result = new string(value.Trim().ToLowerInvariant().Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray()).Trim('-'); return string.IsNullOrWhiteSpace(result) ? "route" : result; }
    private string AgentLabel(string name) => routerAgents.Concat(agents).FirstOrDefault(item => item.Name == name)?.DisplayName ?? name;
    private static string Text(ChangeEventArgs e) => e.Value?.ToString()?.Trim() ?? string.Empty;
    private static string? EmptyToNull(string value) => string.IsNullOrWhiteSpace(value) ? null : value;
    private static string NextVersion(string value) { var parts = value.Split('.'); return parts.Length == 3 && int.TryParse(parts[2], out var patch) ? $"{parts[0]}.{parts[1]}.{patch + 1}" : "1.0.0"; }
    private const string UnconfiguredAgent = "unconfigured";

    public ValueTask DisposeAsync()
    {
        Editor.StateChanged -= EditorChanged;
        autosave?.Cancel(); autosave?.Dispose(); cancellation.Cancel(); cancellation.Dispose();
        return ValueTask.CompletedTask;
    }
}
