@implements IAsyncDisposable
@inject IFlowDesignerBackend Backend
@inject IFlowDesignerResourceProvider Resources
@inject FlowEditorStore Editor
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IStringLocalizer<FlowDesignerStrings> Localizer

@if (Editor.State.Resource is null && error is not null)
{
    <section class="error-panel designer-error"><strong>@T("Unavailable")</strong><p>@error</p></section>
}
else if (Editor.State.Resource is null)
{
    <LoadingState />
}
else
{
    <header class="designer-toolbar @(focusMode ? "designer-focus" : null)">
        <div>
            <p class="eyebrow"><a href="/flows">@T("Flows")</a> / <code>@Editor.State.Namespace.Value</code> / @ResourceId / @(ReadOnly ? T("Published", Editor.State.PublishedVersion ?? string.Empty) : T("Draft"))</p>
            <h1>@Editor.State.Resource.DisplayName</h1>
            @if (!ReadOnly)
            {
                <span class="save-state @Editor.State.SaveState.ToString().ToLowerInvariant()">@SaveText</span>
                <span class="draft-revision">@T("Revision", Editor.State.Resource.DraftRevision?.ToString(System.Globalization.CultureInfo.CurrentCulture) ?? "—")</span>
            }
            else
            {
                <span class="draft-revision">@T("PublishedVersion", Editor.State.PublishedVersion ?? string.Empty)</span>
                <span class="read-only-badge">@T("ReadOnly")</span>
            }
        </div>
        <div class="designer-modes">
            @foreach (var mode in Enum.GetValues<FlowEditorMode>())
            {
                <button class="@(Editor.State.Mode == mode ? "active" : null)" @onclick="() => Editor.SetMode(mode)">@T($"Mode.{mode}")</button>
            }
        </div>
        <div class="designer-actions">
            @if (!ReadOnly)
            {
                <button class="button-secondary" @onclick="OpenRun">@T("RunDraft")</button>
                <button class="button-primary" data-testid="flow-designer-save" disabled="@saving" @onclick="SaveAsync">@T("Save")</button>
                <div class="designer-more-actions @(moreActionsOpen ? "open" : null)">
                    <button type="button" class="button-secondary designer-more-toggle" aria-label="@T("MoreActions")" aria-expanded="@moreActionsOpen" @onclick="() => moreActionsOpen = !moreActionsOpen"><UiIcon Name="dots" /><span>@T("MoreActions")</span></button>
                    <div class="designer-more-menu">
                        <button class="button-secondary" disabled="@(!Editor.CanUndo)" @onclick="Undo">@T("Undo")</button>
                        <button class="button-secondary" disabled="@(!Editor.CanRedo)" @onclick="Redo">@T("Redo")</button>
                        <label class="publish-version">@T("Version")<input aria-label="@T("PublishVersion")" @bind="publishVersion" /></label>
                        <button class="button-primary" data-testid="flow-designer-publish" disabled="@publishing" aria-busy="@publishing" @onclick="PublishAsync">@T(publishing ? "Publishing" : "Publish")</button>
                    </div>
                </div>
            }
        </div>
    </header>

    @if (focusMode)
    {
        <nav class="designer-focus-toolbar" aria-label="@T("EditorModes")">
            <div class="focus-workspace-controls" role="group" aria-label="@T("WorkspaceControls")">
                @if (Editor.State.Mode is FlowEditorMode.Designer or FlowEditorMode.Split)
                {
                    <button type="button" class="desktop-panel-toggle" aria-label="@T(paletteVisibility is false ? "ShowStepPalette" : "HideStepPalette")" aria-pressed="@(paletteVisibility is not false)" @onclick="ToggleDesktopPalette"><UiIcon Name="layout-sidebar-right" Class="panel-icon-left" /></button>
                    <button type="button" class="compact-panel-toggle" aria-label="@T(paletteVisibility is true ? "HideStepPalette" : "ShowStepPalette")" aria-pressed="@(paletteVisibility is true)" @onclick="ToggleCompactPalette"><UiIcon Name="layout-sidebar-right" Class="panel-icon-left" /></button>
                    <button type="button" class="desktop-panel-toggle" aria-label="@T(inspectorVisibility is false ? "ShowInspector" : "HideInspector")" aria-pressed="@(inspectorVisibility is not false)" @onclick="ToggleDesktopInspector"><UiIcon Name="layout-sidebar-right" /></button>
                    <button type="button" class="compact-panel-toggle" aria-label="@T(inspectorVisibility is true ? "HideInspector" : "ShowInspector")" aria-pressed="@(inspectorVisibility is true)" @onclick="ToggleCompactInspector"><UiIcon Name="layout-sidebar-right" /></button>
                }
                <button type="button" class="focus-exit" aria-label="@T("ExitFocusMode")" aria-keyshortcuts="Escape" @onclick="ToggleFocusMode"><UiIcon Name="minimize" /></button>
            </div>
            @foreach (var mode in Enum.GetValues<FlowEditorMode>())
            {
                <button type="button" class="@(Editor.State.Mode == mode ? "active" : null)" aria-pressed="@(Editor.State.Mode == mode)" @onclick="() => Editor.SetMode(mode)">@T($"Mode.{mode}")</button>
            }
        </nav>
    }

    @if (error is not null)
    {
        <div class="designer-feedback" role="alert">
            <span class="designer-feedback-icon" aria-hidden="true">!</span>
            <div><strong>@T("ActionFailed")</strong><p>@error</p></div>
            <button aria-label="@T("DismissError")" @onclick="() => error = null">×</button>
        </div>
    }

    <section class="flow-editor-shell @WorkspaceClasses">
        @if (Editor.State.Mode is FlowEditorMode.Designer or FlowEditorMode.Split)
        {
            <aside class="step-palette">
                <header class="designer-drawer-header"><strong>@T("StepPalette")</strong><button type="button" aria-label="@T("CloseStepPalette")" @onclick="ClosePaletteDrawer"><UiIcon Name="x" /></button></header>
                <section class="step-palette-group" aria-labelledby="palette-steps-heading">
                    <h2 id="palette-steps-heading">@T("Steps")</h2>
                    @foreach (var entry in Palette)
                    {
                        <button data-testid="@($"flow-palette-{entry}")" disabled="@ReadOnly" @onclick="() => AddStepAsync(entry)"><span class="step-palette-icon" aria-hidden="true"><UiIcon Name="@FlowStepIcons.Name(entry)" /></span><span>@T($"Step.{entry}")</span></button>
                    }
                </section>
                <section class="step-palette-group palette-view" aria-labelledby="palette-view-heading">
                    <h2 id="palette-view-heading">@T("ViewControls")</h2>
                    <button disabled="@ReadOnly" @onclick="() => LayoutAsync(false)"><span class="step-palette-icon" aria-hidden="true"><UiIcon Name="layout-distribute-horizontal" /></span><span>@T("HorizontalLayout")</span></button>
                    <button disabled="@ReadOnly" @onclick="() => LayoutAsync(true)"><span class="step-palette-icon" aria-hidden="true"><UiIcon Name="layout-distribute-vertical" /></span><span>@T("VerticalLayout")</span></button>
                    <button @onclick="Center"><span class="step-palette-icon" aria-hidden="true"><UiIcon Name="focus-centered" /></span><span>@T("Center")</span></button>
                    <button aria-pressed="@showAllErrorTransitions" @onclick="ToggleErrorTransitions"><span class="step-palette-icon" aria-hidden="true"><UiIcon Name="alert-triangle" /></span><span>@T(showAllErrorTransitions ? "HideErrorTransitions" : "ShowErrorTransitions")</span></button>
                </section>
            </aside>

            <div class="flow-canvas-wrap">
                <div class="designer-view-controls" role="toolbar" aria-label="@T("WorkspaceControls")">
                    <button type="button" class="desktop-panel-toggle" aria-label="@T(paletteVisibility is false ? "ShowStepPalette" : "HideStepPalette")" aria-pressed="@(paletteVisibility is not false)" @onclick="ToggleDesktopPalette"><UiIcon Name="layout-sidebar-right" Class="panel-icon-left" /></button>
                    <button type="button" class="compact-panel-toggle" aria-label="@T(paletteVisibility is true ? "HideStepPalette" : "ShowStepPalette")" aria-pressed="@(paletteVisibility is true)" @onclick="ToggleCompactPalette"><UiIcon Name="layout-sidebar-right" Class="panel-icon-left" /></button>
                    <button type="button" class="desktop-panel-toggle" aria-label="@T(inspectorVisibility is false ? "ShowInspector" : "HideInspector")" aria-pressed="@(inspectorVisibility is not false)" @onclick="ToggleDesktopInspector"><UiIcon Name="layout-sidebar-right" /></button>
                    <button type="button" class="compact-panel-toggle" aria-label="@T(inspectorVisibility is true ? "HideInspector" : "ShowInspector")" aria-pressed="@(inspectorVisibility is true)" @onclick="ToggleCompactInspector"><UiIcon Name="layout-sidebar-right" /></button>
                    <button type="button" aria-label="@T(focusMode ? "ExitFocusMode" : "EnterFocusMode")" aria-pressed="@focusMode" @onclick="ToggleFocusMode"><UiIcon Name="@(focusMode ? "minimize" : "maximize")" /></button>
                </div>
                <FlowCanvas @ref="canvas" Document="Editor.State.Diagram" Revision="Editor.State.LocalRevision" ResolvedOutputsRevision="flowCallRenderRevision" FitRevision="layoutRevision"
                            IsReadOnly="ReadOnly" EntryStep="@Editor.State.Resource.Definition.EntryStep" SelectedStepName="@Editor.State.Selection.StepName"
                            SelectedTransitionId="@Editor.State.Selection.TransitionId" ShowAllErrorTransitions="showAllErrorTransitions" SelectedStepChanged="SelectStepAsync"
                            StepSettingsRequested="OpenStepSettingsAsync"
                            SelectedTransitionChanged="SelectTransitionAsync"
                            StepMoved="MoveStepAsync" StepRemoved="RemoveStepAsync" TransitionCreated="CreateTransitionAsync"
                            TransitionReconnected="ReconnectTransitionAsync"
                            TransitionRemoved="RemoveTransitionAsync" />
            </div>

            <aside class="flow-inspector">
                <header class="designer-drawer-header"><strong>@T("Inspector")</strong><button type="button" aria-label="@T("CloseInspector")" @onclick="CloseInspectorDrawer"><UiIcon Name="x" /></button></header>
                <h2>@T("Inspector")</h2>
                @if (SelectedStep is null)
                {
                    <p class="muted">@T("SelectStep")</p>
                }
                else
                {
                    <article class="inspector-step-summary">
                        <span class="inspector-step-summary-icon" aria-hidden="true"><UiIcon Name="@FlowStepIcons.Name(SelectedStep.Type())" /></span>
                        <span class="inspector-step-summary-copy">
                            <strong>@(SelectedStep.DisplayName ?? SelectedStep.Name)</strong>
                            <small>@T($"Step.{SelectedStep.Type()}")</small>
                            <code>@SelectedStep.Name</code>
                        </span>
                    </article>
                    <button type="button" class="button-primary inspector-configure-step" data-testid="configure-selected-step" @onclick="OpenSelectedStepSettings">
                        <UiIcon Name="settings" />
                        <span>@T("ConfigureStep")</span>
                    </button>
                    @if (showStepSettings)
                    {
                    <div class="step-settings-backdrop" @onclick="CloseStepSettings">
                        <section class="step-settings-dialog" role="dialog" aria-modal="true" aria-labelledby="step-settings-title" data-testid="step-settings-dialog" @onclick:stopPropagation="true">
                            <header class="step-settings-header">
                                <div>
                                    <span class="eyebrow">@T($"Step.{SelectedStep.Type()}")</span>
                                    <h2 id="step-settings-title">@T("ConfigureStepTitle", SelectedStep.DisplayName ?? SelectedStep.Name)</h2>
                                    <code>@SelectedStep.Name</code>
                                </div>
                                <button type="button" class="step-settings-close" aria-label="@T("CloseStepSettings")" @onclick="CloseStepSettings"><UiIcon Name="x" /></button>
                            </header>
                            <nav class="step-settings-tabs" role="tablist" aria-label="@T("StepSettingsSections")">
                                @foreach (var tab in Enum.GetValues<StepSettingsTab>())
                                {
                                    <button type="button" role="tab" aria-selected="@(activeStepSettingsTab == tab)" class="@(activeStepSettingsTab == tab ? "active" : null)"
                                            data-testid="@($"step-settings-tab-{tab.ToString().ToLowerInvariant()}")" @onclick="() => activeStepSettingsTab = tab">@T($"StepSettingsTab.{tab}")</button>
                                }
                            </nav>
                            <div class="step-settings-body">
                                <div class="step-settings-form">
                    @if (activeStepSettingsTab == StepSettingsTab.General)
                    {
                    <div class="inspector-details-group">
                        <div class="inspector-details-heading"><h3>@T("StepDetails")</h3><span class="inspector-step-type">@T($"Step.{SelectedStep.Type()}")</span></div>
                        <label>@T("StepDisplayName")<input data-testid="step-display-name" disabled="@ReadOnly" value="@(SelectedStep.DisplayName ?? SelectedStep.Name)" @onchange="UpdateDisplayNameAsync" /></label>
                        <label>@T("StepId")<input data-testid="step-name" disabled="@(ReadOnly || SelectedStep is not OutputFlowStepDefinition)" value="@SelectedStep.Name" @onchange="UpdateOutputNameAsync" /></label>
                    </div>
                    }
                    @if (SelectedStep is InputFlowStepDefinition input)
                    {
                        @if (activeStepSettingsTab == StepSettingsTab.Input)
                        {
                            <section class="step-contract-section">
                                <ContractHeading Direction="Input" Source="@T("ContractSource.Flow")" />
                                <SchemaBindingEditor Title="@T("InputSchema")" TestId="flow-input-schema"
                                    Binding="@input.SchemaBinding" LegacySchema="@(input.Schema ?? Editor.State.Resource.Definition.InputSchema)"
                                    SchemaVersions="schemaVersions" ValueChanged="UpdateInputSchemaAsync" ReadOnly="ReadOnly"
                                    DefinitionValidator="ValidateSchemaDefinitionAsync" InstanceValidator="ValidateSchemaInstanceAsync" />
                            </section>
                        }
                        @if (activeStepSettingsTab == StepSettingsTab.Output)
                        {
                            <section class="step-contract-section" data-testid="input-output-contract">
                                <ContractHeading Direction="Output" Source="@T("ContractSource.SameAsInput")" />
                                @if (EffectiveInputSchema is { } inputOutputSchema)
                                {
                                    <SchemaDocumentEditor Value="inputOutputSchema" ReadOnly="true" />
                                }
                                else
                                {
                                    <p class="step-contract-empty muted">@T("NoInputContract")</p>
                                }
                            </section>
                        }
                    }
                    else if (SelectedStep is AgentFlowStepDefinition agent)
                    {
                        @if (activeStepSettingsTab == StepSettingsTab.Configuration)
                        {
                        <div class="inspector-details-group inspector-resource-details">
                            <h3>@T("CalledResource")</h3>
                        <div class="inspector-resource-field">
                            <div class="inspector-resource-heading">
                                <label for="flow-agent-reference">@T("CalledAgent")</label>
                                @if (SelectedAgent is { } selectedAgent)
                                {
                                    <a class="inspector-resource-link" href="@AgentUrl(selectedAgent)" target="_blank" rel="noopener noreferrer" aria-label="@T("OpenAgentInNewTab")"><UiIcon Name="external-link" />@T("OpenAgent")</a>
                                }
                            </div>
                            <select id="flow-agent-reference" disabled="@ReadOnly" value="@AgentSelectionValue(agent.Agent)" @onchange="UpdateAgentAsync">
                                <option value="${steps.route-request.output.selectedAgent}">@T("RouterOutput")</option>
                                @foreach (var item in agents) { <option value="@FlowKey(item.Namespace, item.Name)">@(item.Namespace.IsDefault ? item.DisplayName : $"{item.DisplayName} ({item.Namespace.Value})")</option> }
                            </select>
                        </div>
                        @if (SelectedAgent is { } referencedAgent)
                        {
                            <p class="inspector-resource-id">@T("AgentId") <code>@referencedAgent.Name</code></p>
                        }
                        </div>
                        }
                    }
                    else if (SelectedStep is FlowCallStepDefinition flowCall)
                    {
                        @if (activeStepSettingsTab == StepSettingsTab.Configuration)
                        {
                        <div class="inspector-details-group inspector-resource-details">
                            <h3>@T("CalledResource")</h3>
                        <div class="inspector-resource-field">
                            <div class="inspector-resource-heading">
                                <label for="flow-call-reference">@T("CalledFlow")</label>
                                @if (SelectedFlow is { } selectedFlow)
                                {
                                    <a class="inspector-resource-link" href="@FlowUrl(selectedFlow)" target="_blank" rel="noopener noreferrer" aria-label="@T("OpenFlowInNewTab")"><UiIcon Name="external-link" />@T("OpenFlow")</a>
                                }
                            </div>
                            <input id="flow-call-reference" data-testid="flow-call-reference" disabled="@ReadOnly" list="flow-targets" value="@FlowKey(flowCall.Flow)" @onchange="UpdateFlowTargetAsync" />
                            <datalist id="flow-targets">
                                @foreach (var item in flows.Where(item => item.Name != ResourceId || item.Namespace != Namespace))
                                {
                                    <option value="@FlowKey(item.Namespace, item.Name)">@item.DisplayName (@item.Namespace.Value)</option>
                                }
                            </datalist>
                        </div>
                        @if (SelectedFlow is { } referencedFlow)
                        {
                            <p class="inspector-resource-id">@T("FlowId") <code>@referencedFlow.Name</code></p>
                        }
                        </div>
                        <label>@T("VersionStrategy")<select data-testid="flow-call-version-strategy" disabled="@ReadOnly" value="@flowCall.Flow.VersionStrategy" @onchange="UpdateFlowVersionStrategyAsync">
                            <option value="@FlowCallVersionStrategy.Active">@T("VersionStrategy.Active")</option>
                            <option value="@FlowCallVersionStrategy.Exact">@T("VersionStrategy.Exact")</option>
                        </select></label>
                        @if (flowCall.Flow.VersionStrategy == FlowCallVersionStrategy.Exact)
                        {
                            <label>@T("ExactVersion")<select data-testid="flow-call-exact-version" disabled="@ReadOnly" value="@flowCall.Flow.Version" @onchange="UpdateFlowExactVersionAsync">
                                @foreach (var version in flowVersions) { <option value="@version.Version">@version.Version</option> }
                            </select></label>
                        }
                        }
                        @if (activeStepSettingsTab == StepSettingsTab.Input)
                        {
                            <section class="step-contract-section">
                            <ContractHeading Direction="Input" Source="@T("ContractSource.CalledFlow")" />
                        @if (SelectedFlowVersion is not null)
                        {
                            @if (FlowCallReceivesParentInput(flowCall) && SelectedFlowVersion.InputSchemaReference is { } sharedInputReference)
                            {
                                <aside class="shared-contract-reuse" data-testid="flow-call-shared-input-contract">
                                    <div>
                                        <strong>@T("CalledFlowSharedInputTitle")</strong>
                                        <p>@T("CalledFlowSharedInputHelp")</p>
                                        <code>@SchemaReferenceLabel(sharedInputReference)</code>
                                    </div>
                                    @if (ParentInputHasExplicitContract)
                                    {
                                        <span class="inspector-step-type">@T("ParentInputContractAlreadyDefined")</span>
                                    }
                                    else if (!ReadOnly)
                                    {
                                        <button type="button" class="button-secondary" data-testid="use-called-flow-shared-input" @onclick="UseCalledFlowSharedInputAsync">@T("UseCalledFlowSharedInput")</button>
                                    }
                                </aside>
                            }
                            else if (FlowCallReceivesParentInput(flowCall)
                                && SelectedFlowVersion.InputSchema is not null
                                && SelectedFlowVersion.InputSchemaReference is null)
                            {
                                <aside class="shared-contract-reuse" data-testid="flow-call-inline-input-contract">
                                    <div>
                                        <strong>@T("CalledFlowInlineInputTitle")</strong>
                                        <p>@T("CalledFlowInlineInputHelp")</p>
                                    </div>
                                    @if (ParentInputHasExplicitContract)
                                    {
                                        <span class="inspector-step-type">@T("ParentInputContractAlreadyDefined")</span>
                                    }
                                    else if (!ReadOnly)
                                    {
                                        <button type="button" class="button-secondary" data-testid="copy-called-flow-inline-input" @onclick="CopyCalledFlowInlineInputAsync">@T("CopyCalledFlowInlineInput")</button>
                                    }
                                </aside>
                            }
                            <fieldset class="flow-mapping-editor"><legend>@T("InputMapping")</legend>
                                <label class="flow-checkbox-field"><input data-testid="flow-pass-transition-output" type="checkbox" disabled="@ReadOnly" checked="@PassesIncomingTransitionOutput(flowCall.InputMapping)" @onchange="UpdateFlowTransitionPassthroughAsync" />@T("PassIncomingTransitionOutput")</label>
                                <small>@T("PassIncomingTransitionOutputHelp")</small>
                                @if (!PassesIncomingTransitionOutput(flowCall.InputMapping)
                                    && SelectedFlowVersion.InputSchema is { ValueKind: JsonValueKind.Object } inputSchema
                                    && inputSchema.TryGetProperty("properties", out var inputProperties)
                                    && inputProperties.ValueKind == JsonValueKind.Object)
                                {
                                    @foreach (var property in inputProperties.EnumerateObject())
                                    {
                                        var propertyName = property.Name;
                                        <label>@propertyName<input disabled="@ReadOnly" value="@MappingValue(flowCall.InputMapping, propertyName)" @onchange="e => UpdateFlowMappingAsync(propertyName, e)" /></label>
                                    }
                                }
                            </fieldset>
                            @if (SelectedFlowVersion.InputSchema is { } calledFlowInputSchema)
                            {
                                <SchemaDocumentEditor Value="calledFlowInputSchema" ReadOnly="true" />
                            }
                            else
                            {
                                <p class="step-contract-empty muted">@T("NoInputContract")</p>
                            }
                        }
                        else
                        {
                            <p class="step-contract-empty muted">@T("SelectFlowVersionForContract")</p>
                        }
                            </section>
                        }
                        @if (activeStepSettingsTab == StepSettingsTab.Output)
                        {
                            <section class="step-contract-section">
                                <ContractHeading Direction="Output" Source="@T("ContractSource.CalledFlow")" />
                                @if (SelectedFlowVersion is { NamedOutputs.Count: > 0 } calledFlowVersion)
                                {
                                    <div class="called-flow-outputs">
                                    @foreach (var namedOutput in calledFlowVersion.NamedOutputs)
                                    {
                                        <article class="called-flow-output" data-testid="called-flow-output-contract">
                                            <header><strong>@(namedOutput.DisplayName ?? namedOutput.Name)</strong><code>@namedOutput.Name</code><span class="inspector-step-type">@T($"OutputOutcome.{namedOutput.Outcome}")</span></header>
                                            @if (namedOutput.Schema is { } namedOutputSchema)
                                            {
                                                <SchemaDocumentEditor Value="namedOutputSchema" ReadOnly="true" />
                                            }
                                            else
                                            {
                                                <p class="step-contract-empty muted">@T("NamedOutputContractUnavailable", namedOutput.Name)</p>
                                            }
                                        </article>
                                    }
                                    </div>
                                }
                                else if (SelectedFlowVersion?.OutputSchema is { } calledFlowOutputSchema)
                                {
                                    <SchemaDocumentEditor Value="calledFlowOutputSchema" ReadOnly="true" />
                                }
                                else
                                {
                                    <p class="step-contract-empty muted">@T("NoOutputContract")</p>
                                }
                            </section>
                        }
                    }
                    else if (SelectedStep is ToolFlowStepDefinition toolStep)
                    {
                        @if (activeStepSettingsTab == StepSettingsTab.Configuration)
                        {
                        <div class="inspector-details-group inspector-resource-details">
                            <h3>@T("CalledResource")</h3>
                            <div class="inspector-resource-field">
                                <div class="inspector-resource-heading"><span>@T("CalledTool")</span></div>
                                @if (ReadOnly)
                                {
                                    <div class="tool-picker-trigger is-readonly"><UiIcon Name="wrench" /><span>@(SelectedTool?.DisplayName ?? T("CurrentToolUnavailable"))</span></div>
                                }
                                else
                                {
                                    <details class="tool-picker" @key="toolPickerRevision" @onkeydown="HandleToolPickerKeyDown">
                                        <summary class="tool-picker-trigger"><UiIcon Name="wrench" /><span>@(SelectedTool?.DisplayName ?? T("CurrentToolUnavailable"))</span><UiIcon Name="chevron-down" /></summary>
                                        <div class="tool-picker-menu">
                                            <div class="tool-picker-search"><UiIcon Name="search" /><input aria-label="@T("SearchTools")" placeholder="@T("SearchTools")" @bind="toolSearch" @bind:event="oninput" /></div>
                                            <div class="tool-picker-options">
                                                @foreach (var item in VisibleTools)
                                                {
                                                    <button type="button" class="tool-picker-option" aria-pressed="@(ToolKey(item.Namespace, item.Name) == ToolKey(toolStep.Tool) ? "true" : "false")" @onclick="() => SelectToolAsync(item)">
                                                        <span class="tool-picker-option-icon"><UiIcon Name="wrench" /></span>
                                                        <span class="tool-picker-option-copy"><strong>@item.DisplayName</strong><small>@item.Namespace.Value / @item.Name</small></span>
                                                        @if (ToolKey(item.Namespace, item.Name) == ToolKey(toolStep.Tool)) { <UiIcon Name="check" /> }
                                                    </button>
                                                }
                                                @if (!VisibleTools.Any()) { <p class="tool-picker-empty">@T("NoMatchingTools")</p> }
                                            </div>
                                        </div>
                                    </details>
                                }
                            </div>
                            <p class="inspector-resource-id">@T("ToolId") <code>@toolStep.Tool.ResourceId</code></p>
                        </div>
                        @if (SelectedTool is { } selectedTool)
                        {
                            @if (!selectedTool.Enabled || !selectedTool.Available || selectedTool.RequiresApproval)
                            {
                                <p class="muted">@ToolState(selectedTool)</p>
                            }
                            }
                        }
                        @if (activeStepSettingsTab == StepSettingsTab.Input)
                        {
                            <section class="step-contract-section">
                                <ContractHeading Direction="Input" Source="@T("ContractSource.CalledTool")" />
                            @if (SelectedTool is { } selectedTool)
                            {
                            @if (selectedTool.InputSchema.ValueKind == JsonValueKind.Object
                                && selectedTool.InputSchema.TryGetProperty("properties", out var toolProperties)
                                && toolProperties.ValueKind == JsonValueKind.Object)
                            {
                                <fieldset class="flow-mapping-editor"><legend>@T("ArgumentsMapping")</legend>
                                    @foreach (var property in toolProperties.EnumerateObject())
                                    {
                                        var propertyName = property.Name;
                                        <label>@propertyName<input disabled="@ReadOnly" value="@MappingValue(toolStep.ArgumentsMapping, propertyName)" @onchange="e => UpdateToolMappingAsync(propertyName, e)" /></label>
                                    }
                                </fieldset>
                            }
                                <SchemaDocumentEditor Value="selectedTool.InputSchema" ReadOnly="true" />
                            }
                            else
                            {
                                <p class="step-contract-empty muted">@T("SelectToolForContract")</p>
                            }
                            </section>
                        }
                        @if (activeStepSettingsTab == StepSettingsTab.Output)
                        {
                            <section class="step-contract-section">
                                <ContractHeading Direction="Output" Source="@T("ContractSource.CalledTool")" />
                                @if (SelectedTool?.OutputSchema is { } toolOutputSchema)
                                {
                                    <SchemaDocumentEditor Value="toolOutputSchema" ReadOnly="true" />
                                }
                                else
                                {
                                    <p class="step-contract-empty muted">@T("NoOutputContract")</p>
                                }
                            </section>
                        }
                    }
                    else if (SelectedStep is RouterFlowStepDefinition router)
                    {
                        @if (activeStepSettingsTab == StepSettingsTab.Configuration)
                        {
                        <section class="router-editor">
                            <div class="router-group-picker">
                                <button class="button-secondary" @onclick="LoadAgentsAsync">@T("LoadAgents")</button>
                                <button class="button-secondary" disabled="@(ReadOnly || loadingAgents)" @onclick="AddAllRouterAgentsAsync">@T("AddAll")</button>
                            </div>
                            <p class="muted">@T(routerAgents.Count == 1 ? "AvailableAgents.One" : "AvailableAgents.Many", routerAgents.Count)</p>
                            <div class="route-cards">
                                @for (var index = 0; index < router.Candidates.Count; index++)
                                {
                                    var routeIndex = index;
                                    var candidate = router.Candidates[index];
                                    <article class="route-card">
                                        <header><span class="route-key-badge">@candidate.Route</span><button disabled="@ReadOnly" @onclick="() => RemoveRouterCandidateAsync(routeIndex)">×</button></header>
                                        <label>@T("RouteKey")<input disabled="@ReadOnly" value="@candidate.Route" @onchange="e => UpdateRouterCandidateAsync(routeIndex, c => c with { Route = Text(e) })" /></label>
                                        <label>@T("Agent")<select disabled="@ReadOnly" value="@candidate.Agent.ResourceId" @onchange="e => UpdateRouterCandidateAsync(routeIndex, c => c with { Agent = new(Text(e)) })">
                                            <option value="@candidate.Agent.ResourceId">@AgentLabel(candidate.Agent.ResourceId)</option>
                                            @foreach (var item in routerAgents.Where(item => item.Name != candidate.Agent.ResourceId)) { <option value="@item.Name">@item.DisplayName</option> }
                                        </select></label>
                                        <label>@T("Description")<input disabled="@ReadOnly" value="@candidate.Description" @onchange="e => UpdateRouterCandidateAsync(routeIndex, c => c with { Description = EmptyToNull(Text(e)) })" /></label>
                                        <label>@T("Examples")<input disabled="@ReadOnly" value="@string.Join(", ", candidate.Examples ?? [])" @onchange="e => UpdateRouterCandidateAsync(routeIndex, c => c with { Examples = Text(e).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) })" /></label>
                                    </article>
                                }
                            </div>
                            <button class="button-secondary" disabled="@ReadOnly" @onclick="AddRouterCandidateAsync">＋ @T("AddRoute")</button>
                        </section>
                        }
                    }
                    else if (SelectedStep is TransformFlowStepDefinition transform)
                    {
                        @if (activeStepSettingsTab == StepSettingsTab.Configuration)
                        {
                            <label>@T("TransformMapping")<textarea data-testid="transform-mapping" disabled="@ReadOnly" value="@JsonText(transform.Mapping)" @onchange="UpdateTransformMappingAsync"></textarea></label>
                        }
                        @if (activeStepSettingsTab == StepSettingsTab.Input)
                        {
                            <section class="step-contract-section">
                                <ContractHeading Direction="Input" Source="@T("ContractSource.IncomingTransition")" />
                                @if (EffectiveIncomingSchema is { } incomingSchema)
                                {
                                    <SchemaDocumentEditor Value="incomingSchema" ReadOnly="true" />
                                }
                                else
                                {
                                    <p class="step-contract-empty muted">@IncomingContractUnavailableText()</p>
                                }
                            </section>
                        }
                        @if (activeStepSettingsTab == StepSettingsTab.Output)
                        {
                            <section class="step-contract-section">
                                <ContractHeading Direction="Output" Source="@T("ContractSource.Step")" />
                                <SchemaBindingEditor Title="@T("OutputSchema")" TestId="transform-output-schema"
                                    Binding="@transform.SchemaBinding" LegacySchema="@transform.Schema" SchemaVersions="schemaVersions"
                                    ValueChanged="UpdateTransformSchemaBindingAsync" ReadOnly="ReadOnly"
                                    DefinitionValidator="ValidateSchemaDefinitionAsync" InstanceValidator="ValidateSchemaInstanceAsync" />
                            </section>
                        }
                    }
                    else if (SelectedStep is ConditionFlowStepDefinition condition)
                    {
                        @if (activeStepSettingsTab == StepSettingsTab.Configuration)
                        {
                        <label>@T("LeftValue")<input disabled="@ReadOnly" value="@condition.Left" @onchange="e => UpdateSelectedAsync(condition with { Left = Text(e) })" /></label>
                        <label>@T("Operator")<input disabled="@ReadOnly" value="@condition.Operator" @onchange="e => UpdateSelectedAsync(condition with { Operator = Text(e) })" /></label>
                        <label>@T("RightValue")<input disabled="@ReadOnly" value="@condition.Right" @onchange="e => UpdateSelectedAsync(condition with { Right = Text(e) })" /></label>
                        }
                    }
                    else if (SelectedStep is OutputFlowStepDefinition output)
                    {
                        @if (activeStepSettingsTab == StepSettingsTab.Input)
                        {
                            <section class="step-contract-section">
                                <ContractHeading Direction="Input" Source="@T("ContractSource.IncomingTransition")" />
                                @if (EffectiveIncomingSchema is { } incomingSchema)
                                {
                                    <SchemaDocumentEditor Value="incomingSchema" ReadOnly="true" />
                                }
                                else
                                {
                                    <p class="step-contract-empty muted">@IncomingContractUnavailableText()</p>
                                }
                            </section>
                        }
                        @if (activeStepSettingsTab == StepSettingsTab.Configuration)
                        {
                        <label>@T("OutputOutcome")<select data-testid="output-outcome" disabled="@ReadOnly" value="@(output.Outcome ?? FlowOutputOutcome.Success)" @onchange="UpdateOutputOutcomeAsync"><option value="@FlowOutputOutcome.Success">@T("OutputOutcome.Success")</option><option value="@FlowOutputOutcome.Error">@T("OutputOutcome.Error")</option></select></label>
                        @if ((output.Outcome ?? FlowOutputOutcome.Success) == FlowOutputOutcome.Error)
                        {
                            <label>@T("ErrorCode")<input data-testid="output-error-code" disabled="@ReadOnly" value="@output.Code" @onchange="e => UpdateSelectedAsync(output with { Code = EmptyToNull(Text(e)) })" /></label>
                            <label>@T("Message")<textarea data-testid="output-error-message" disabled="@ReadOnly" value="@output.Message" @onchange="e => UpdateSelectedAsync(output with { Message = EmptyToNull(Text(e)) })"></textarea></label>
                            <label>@T("ErrorDetailsExpression")<input data-testid="output-error-details" disabled="@ReadOnly" value="@output.DetailsExpression" @onchange="e => UpdateSelectedAsync(output with { DetailsExpression = EmptyToNull(Text(e)) })" /></label>
                        }
                        }
                        @if (activeStepSettingsTab == StepSettingsTab.Output)
                        {
                            <section class="step-contract-section" data-testid="terminal-output-contract">
                                <ContractHeading Direction="Output" Source="@(EffectiveIncomingSchema is null && ResolveSchema(output.SchemaBinding, output.Schema) is not null ? T("ContractSource.LegacyOutput") : T("ContractSource.SameAsInput"))" />
                                <div class="output-passthrough" data-testid="output-mapping">
                                    <span class="output-passthrough-icon" aria-hidden="true"><UiIcon Name="arrow-right" /></span>
                                    <span class="output-passthrough-copy"><strong>@T("IncomingTransitionOutput")</strong><small>@T("OutputMappingHelp")</small></span>
                                    <details class="output-passthrough-technical"><summary>@T("TechnicalDetail")</summary><code>@OutputMappingExpression(output)</code></details>
                                </div>
                                @if (EffectiveIncomingSchema is { } incomingSchema)
                                {
                                    <SchemaDocumentEditor Value="incomingSchema" ReadOnly="true" />
                                }
                                else if (ResolveSchema(output.SchemaBinding, output.Schema) is { } legacyOutputSchema)
                                {
                                    <SchemaDocumentEditor Value="legacyOutputSchema" ReadOnly="true" />
                                }
                                else
                                {
                                    <p class="step-contract-empty muted">@IncomingContractUnavailableText()</p>
                                }
                            </section>
                        }
                    }
                    else if (SelectedStep is FailureFlowStepDefinition failure)
                    {
                        @if (activeStepSettingsTab == StepSettingsTab.Configuration)
                        {
                        <label>@T("ErrorCode")<input disabled="@ReadOnly" value="@failure.Code" @onchange="e => UpdateSelectedAsync(failure with { Code = Text(e) })" /></label>
                        <label>@T("Message")<textarea disabled="@ReadOnly" value="@failure.Message" @onchange="e => UpdateSelectedAsync(failure with { Message = Text(e) })"></textarea></label>
                        }
                    }
                    @if (activeStepSettingsTab == StepSettingsTab.Configuration && SelectedStep is InputFlowStepDefinition)
                    {
                        <div class="step-settings-empty"><UiIcon Name="adjustments" /><h3>@T("NoStepConfiguration")</h3><p class="muted">@T("NoStepConfigurationHelp")</p></div>
                    }
                    @if (activeStepSettingsTab == StepSettingsTab.Input && SelectedStep is not InputFlowStepDefinition and not FlowCallStepDefinition and not ToolFlowStepDefinition and not TransformFlowStepDefinition and not OutputFlowStepDefinition)
                    {
                        <div class="step-settings-empty"><UiIcon Name="arrow-bar-to-right" /><h3>@T("NoInputContract")</h3><p class="muted">@T("NoInputContractHelp")</p></div>
                    }
                    @if (activeStepSettingsTab == StepSettingsTab.Output && SelectedStep is not InputFlowStepDefinition and not OutputFlowStepDefinition and not FlowCallStepDefinition and not ToolFlowStepDefinition and not TransformFlowStepDefinition)
                    {
                        <div class="step-settings-empty"><UiIcon Name="arrow-bar-left" /><h3>@T("NoOutputContract")</h3><p class="muted">@T("NoOutputContractHelp")</p></div>
                    }
                    @if (activeStepSettingsTab == StepSettingsTab.General)
                    {
                        <button class="button-danger" disabled="@(ReadOnly || SelectedStep.Name == Editor.State.Resource.Definition.EntryStep)" @onclick="RemoveSelectedAsync">@T("DeleteStep")</button>
                    }
                                </div>
                            </div>
                            <footer class="step-settings-footer">
                                <button type="button" class="button-primary" @onclick="CloseStepSettings">@T("Done")</button>
                            </footer>
                        </section>
                    </div>
                    }
                }

                <hr /><h3>@T("Transitions")</h3>
                @if (SelectedTransition is { } selectedTransition)
                {
                    <section class="transition-editor" data-testid="selected-transition-editor">
                        <h4>@T("TransitionDetails")</h4>
                        <label>@T("TransitionId")<input value="@selectedTransition.Id" readonly /></label>
                        <label>@T("From")<select data-testid="transition-from" disabled="@ReadOnly" value="@selectedTransition.FromStep" @onchange="UpdateTransitionFromAsync">@foreach (var node in Editor.State.Diagram.Nodes) { <option value="@node.Name">@node.Name</option> }</select></label>
                        <label>@T("Event")@if (TransitionEvents(selectedTransition) is { Count: > 0 } events)
                        { <select data-testid="transition-event" disabled="@ReadOnly" value="@selectedTransition.Event" @onchange="UpdateTransitionEventAsync">@foreach (var item in events) { <option value="@item">@item</option> }</select> }
                        else { <input data-testid="transition-event" disabled="@ReadOnly" value="@selectedTransition.Event" @onchange="UpdateTransitionEventAsync" /> }</label>
                        <label>@T("To")<select data-testid="transition-to" disabled="@ReadOnly" value="@selectedTransition.ToStep" @onchange="UpdateTransitionToAsync">@foreach (var node in Editor.State.Diagram.Nodes) { <option value="@node.Name">@node.Name</option> }</select></label>
                        <label>@T("TransitionCondition")<input data-testid="transition-condition" disabled="@ReadOnly" value="@selectedTransition.Condition" @onchange="UpdateTransitionConditionAsync" /></label>
                        <label>@T("TransitionPriority")<input data-testid="transition-priority" disabled="@ReadOnly" type="number" value="@selectedTransition.Priority" @onchange="UpdateTransitionPriorityAsync" /></label>
                        <button class="button-danger" disabled="@ReadOnly" @onclick="() => RemoveTransitionAsync(selectedTransition.Id)">@T("DeleteTransition")</button>
                    </section>
                }
                <label>@T("From")<select data-testid="transition-new-from" disabled="@ReadOnly" @bind="transitionFrom">@foreach (var node in Editor.State.Diagram.Nodes) { <option value="@node.Name">@node.Name</option> }</select></label>
                <label>@T("Event")<input data-testid="transition-new-event" disabled="@ReadOnly" @bind="transitionEvent" /></label>
                <label>@T("To")<select data-testid="transition-new-to" disabled="@ReadOnly" @bind="transitionTo">@foreach (var node in Editor.State.Diagram.Nodes) { <option value="@node.Name">@node.Name</option> }</select></label>
                <button class="button-secondary" data-testid="transition-new-add" disabled="@ReadOnly" @onclick="AddTransitionAsync">@T("AddTransition")</button>
                <ul class="transition-list">@foreach (var transition in Editor.State.Resource.Definition.Transitions) { <li><button class="@(Editor.State.Selection.TransitionId == transition.Id ? "selected" : null)" @onclick="() => SelectTransitionAsync(transition.Id)">@transition.FromStep —@transition.Event→ @transition.ToStep</button><button disabled="@ReadOnly" aria-label="@T("DeleteTransitionNamed", transition.Id)" @onclick="() => RemoveTransitionAsync(transition.Id)">×</button></li> }</ul>
            </aside>
        }

        @if (Editor.State.Mode is FlowEditorMode.Definition or FlowEditorMode.Split)
        {
            <FlowSourceEditor Value="@sourceText" ValueChanged="SourceChanged" Error="@Editor.State.SourceError"
                              IsReadOnly="ReadOnly" ApplyRequested="ApplySourceAsync" />
        }
    </section>

    <section class="validation-dock @(validationExpanded ? "expanded" : null)">
        <header class="validation-header">
            <button type="button" class="validation-summary" aria-expanded="@validationExpanded" @onclick="ToggleValidation"><strong>@T("Validation")</strong></button>
            @if (!ReadOnly)
            {
                <button type="button" class="button-secondary validation-run" data-testid="flow-designer-validation-run" @onclick="ValidateAsync"><UiIcon Name="check" /><span>@T("RunValidation")</span></button>
            }
            <span class="validation-count">@T(Editor.State.Issues.Count == 1 ? "IssueCount.One" : "IssueCount.Many", Editor.State.Issues.Count)</span>
            <button type="button" class="validation-toggle" aria-label="@T(validationExpanded ? "HideValidationDetails" : "ShowValidationDetails")" aria-expanded="@validationExpanded" @onclick="ToggleValidation"><UiIcon Name="chevron-down" /></button>
        </header>
        @if (validationExpanded)
        {
            @if (Editor.State.Issues.Count == 0) { <p class="muted">@(ReadOnly ? T("PublishedDefinitionHelp") : T("ValidationHelp"))</p> }
            else { <ul>@foreach (var issue in Editor.State.Issues) { <li class="@issue.Severity.ToString().ToLowerInvariant()"><button @onclick="() => SelectIssue(issue)"><strong>@issue.Severity</strong> @issue.Message <code>@issue.Code</code></button></li> }</ul> }
        }
    </section>

    @if (showRun)
    {
        <div class="dialog-backdrop"><section class="dialog run-dialog" role="dialog" aria-modal="true" aria-labelledby="run-draft-title" data-testid="flow-designer-run-dialog"><h2 id="run-draft-title">@T("RunDraftRevision", Editor.State.Resource.DraftRevision?.ToString(System.Globalization.CultureInfo.CurrentCulture) ?? "—")</h2><div class="flow-run-input"><h3>@T("InputJson")</h3><JsonSchemaInputEditor Schema="EffectiveInputSchema" Value="runInput" ValueChanged="value => runInput = value" ValidationChanged="UpdateRunInputValidation" Disabled="runningDraft" /></div>@if (runError is not null) { <p class="error-panel" role="alert">@runError</p> }<div class="dialog-actions"><button class="button-secondary" disabled="@runningDraft" @onclick="() => showRun = false">@T("Cancel")</button><button class="button-primary" disabled="@(runningDraft || !runInputValid)" data-testid="flow-designer-run-submit" @onclick="RunDraftAsync">@(runningDraft ? T("RunningDraft") : T("RunDraft"))</button></div></section></div>
    }
    @if (connectionContractPrompt is { } contractPrompt)
    {
        <div class="dialog-backdrop" role="presentation" @onclick="DismissConnectionContractPrompt">
            <section class="dialog connection-contract-dialog" role="dialog" aria-modal="true" aria-labelledby="connection-contract-title" data-testid="connection-contract-dialog" @onclick:stopPropagation="true">
                <span class="eyebrow">@T("InputContract")</span>
                <h2 id="connection-contract-title">@T("ConnectionContractTitle")</h2>
                <p>@T("ConnectionContractHelp", contractPrompt.FlowDisplayName)</p>
                @if (contractPrompt.Version.InputSchemaReference is { } promptReference)
                {
                    <article class="connection-contract-choice">
                        <strong>@T("CalledFlowSharedInputTitle")</strong>
                        <p>@T("CalledFlowSharedInputHelp")</p>
                        <code>@SchemaReferenceLabel(promptReference)</code>
                    </article>
                }
                else
                {
                    <article class="connection-contract-choice">
                        <strong>@T("CalledFlowInlineInputTitle")</strong>
                        <p>@T("CalledFlowInlineInputHelp")</p>
                    </article>
                }
                <div class="dialog-actions">
                    <button type="button" class="button-secondary" data-testid="connection-contract-later" @onclick="DismissConnectionContractPrompt">@T("ConfigureContractLater")</button>
                    <button type="button" class="button-primary" data-testid="connection-contract-apply" @onclick="ApplyConnectionContractAsync">@(contractPrompt.Version.InputSchemaReference is not null ? T("UseCalledFlowSharedInput") : T("CopyCalledFlowInlineInput"))</button>
                </div>
            </section>
        </div>
    }
}

@code {
    private static readonly string[] Palette = ["input", "agent", "flow", "tool", "router", "condition", "transform", "output"];
    private readonly CancellationTokenSource cancellation = new();
    private CancellationTokenSource? autosave;
    private FlowCanvas? canvas;
    private IJSObjectReference? workspaceModule;
    private IJSObjectReference? keyboardRegistration;
    private DotNetObjectReference<FlowDesigner>? selfReference;
    private IReadOnlyList<FlowDesignerAgent> agents = [];
    private IReadOnlyList<FlowDesignerAgent> routerAgents = [];
    private IReadOnlyList<FlowDesignerFlow> flows = [];
    private IReadOnlyList<FlowDesignerFlowVersion> flowVersions = [];
    private IReadOnlyList<FlowDesignerTool> tools = [];
    private IReadOnlyList<FlowDesignerSchemaVersion> schemaVersions = [];
    private string? loadedResource;
    private string sourceText = string.Empty;
    private string transitionFrom = string.Empty;
    private string transitionTo = string.Empty;
    private string transitionEvent = "completed";
    private string publishVersion = "1.0.0";
    private bool showAllErrorTransitions;
    private JsonElement runInput = JsonSerializer.SerializeToElement(new { prompt = "How can I optimize this SQL query?" });
    private string? error;
    private string? runError;
    private bool saving;
    private bool publishing;
    private bool showRun;
    private ConnectionContractPrompt? connectionContractPrompt;
    private bool runningDraft;
    private bool runInputValid = true;
    private bool loadingAgents;
    private bool focusMode;
    private bool validationExpanded;
    private bool moreActionsOpen;
    private bool? paletteVisibility;
    private bool? inspectorVisibility;
    private bool showStepSettings;
    private StepSettingsTab activeStepSettingsTab = StepSettingsTab.General;
    private long layoutRevision;
    private long flowCallRenderRevision;
    private int toolPickerRevision;
    private string toolSearch = string.Empty;

    private FlowTransitionDefinition? SelectedTransition => Editor.State.Resource?.Definition.Transitions
        .FirstOrDefault(transition => transition.Id == Editor.State.Selection.TransitionId);

    [Parameter, EditorRequired] public string ResourceId { get; set; } = string.Empty;
    [Parameter] public bool IsReadOnly { get; set; }
    [Parameter] public ResourceNamespace Namespace { get; set; } = ResourceNamespace.Default;

    private string WorkspaceClasses => string.Join(' ', new[]
    {
        Editor.State.Mode.ToString().ToLowerInvariant(),
        paletteVisibility is true ? "palette-open" : paletteVisibility is false ? "palette-closed" : null,
        inspectorVisibility is true ? "inspector-open" : inspectorVisibility is false ? "inspector-closed" : null,
        focusMode ? "focus-mode" : null
    }.Where(value => value is not null));

    private FlowStepDefinition? SelectedStep => Editor.State.Resource?.Definition.Steps.FirstOrDefault(step => step.Name == Editor.State.Selection.StepName);
    private FlowDesignerAgent? SelectedAgent => SelectedStep is AgentFlowStepDefinition step
        ? agents.FirstOrDefault(agent => agent.Name == step.Agent.ResourceId && agent.Namespace == (step.Agent.Namespace ?? Namespace))
        : null;
    private FlowDesignerFlow? SelectedFlow => SelectedStep is FlowCallStepDefinition step
        ? flows.FirstOrDefault(flow => flow.Name == step.Flow.ResourceId && flow.Namespace == (step.Flow.Namespace ?? Namespace))
        : null;
    private FlowDesignerFlowVersion? SelectedFlowVersion => SelectedStep is FlowCallStepDefinition call ? FlowVersion(call) : null;
    private FlowDesignerFlowVersion? FlowVersion(FlowCallStepDefinition call)
        => flowVersions.FirstOrDefault(version => version.Version == (call.Flow.VersionStrategy == FlowCallVersionStrategy.Exact
            ? call.Flow.Version
            : flows.FirstOrDefault(flow => FlowKey(flow.Namespace, flow.Name) == FlowKey(call.Flow))?.ActiveVersion));
    private FlowDesignerTool? SelectedTool => SelectedStep is ToolFlowStepDefinition tool
        ? tools.FirstOrDefault(item => ToolKey(item.Namespace, item.Name) == ToolKey(tool.Tool))
        : null;
    private InputFlowStepDefinition? ParentInputStep => Editor.State.Resource?.Definition.Steps.OfType<InputFlowStepDefinition>().SingleOrDefault();
    private bool ParentInputHasExplicitContract => ParentInputStep is { Schema: not null } or { SchemaBinding: not null }
        || Editor.State.Resource?.Definition is { InputSchema: not null } or { InputSchemaBinding: not null };
    private JsonElement? EffectiveInputSchema
    {
        get
        {
            if (Editor.State.Resource is not { } resource) return null;
            var input = resource.Definition.Steps.OfType<InputFlowStepDefinition>().FirstOrDefault();
            return ResolveSchema(input?.SchemaBinding, input?.Schema)
                ?? ResolveSchema(resource.Definition.InputSchemaBinding, resource.Definition.InputSchema);
        }
    }
    private JsonElement? EffectiveIncomingSchema
    {
        get
        {
            if (Editor.State.Resource is not { } resource || SelectedStep is null) return null;
            var candidates = resource.Definition.Transitions
                .Where(transition => transition.ToStep == SelectedStep.Name)
                .Select(ResolveTransitionOutputSchema)
                .Where(schema => schema is not null)
                .Select(schema => schema!.Value)
                .ToArray();
            var distinct = new List<JsonElement>();
            foreach (var candidate in candidates)
                if (!distinct.Any(existing => JsonElement.DeepEquals(existing, candidate))) distinct.Add(candidate);
            return distinct.Count == 1 ? distinct[0] : null;
        }
    }
    private IEnumerable<FlowDesignerTool> VisibleTools => string.IsNullOrWhiteSpace(toolSearch)
        ? tools
        : tools.Where(item => item.DisplayName.Contains(toolSearch, StringComparison.CurrentCultureIgnoreCase)
            || item.Name.Contains(toolSearch, StringComparison.OrdinalIgnoreCase)
            || item.Namespace.Value.Contains(toolSearch, StringComparison.OrdinalIgnoreCase));
    private string SaveText => T($"SaveState.{Editor.State.SaveState}");
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    private FlowDesignerTarget Target => new(Namespace, ResourceId);
    private bool ReadOnly => IsReadOnly || Editor.State.IsReadOnly;

    protected override async Task OnParametersSetAsync()
    {
        var targetKey = $"{Namespace.Value}/{ResourceId}";
        if (loadedResource == targetKey) return;
        loadedResource = targetKey;
        Editor.StateChanged += EditorChanged;
        try
        {
            error = null;
            var loaded = await Backend.LoadAsync(Target, cancellation.Token);
            sourceText = loaded.Source;
            Editor.Load(loaded, Target);
            agents = routerAgents = await Resources.GetAgentsAsync(cancellation.Token);
            flows = await Resources.GetFlowsAsync(cancellation.Token);
            tools = await Resources.GetToolsAsync(cancellation.Token);
            schemaVersions = await Resources.GetSchemaVersionsAsync(cancellation.Token);
            await RefreshFlowCallOutputsAsync(loaded.Resource.Definition);
            if (!ReadOnly)
                publishVersion = SuggestedPublishVersion(await Resources.GetFlowVersionsAsync(Namespace, ResourceId, cancellation.Token));
            transitionFrom = loaded.Resource.Definition.EntryStep;
            transitionTo = loaded.Resource.Definition.Steps.Skip(1).FirstOrDefault()?.Name ?? transitionFrom;
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            error = exception.Message;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        workspaceModule = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./_content/Agentstration.Web.FlowDesigner/js/flow-designer-workspace.js?v=20261013-1");
        selfReference = DotNetObjectReference.Create(this);
        keyboardRegistration = await workspaceModule.InvokeAsync<IJSObjectReference>("registerKeyboardShortcuts", selfReference);
    }

    private async Task DispatchAsync(IFlowEditorCommand command)
    {
        if (ReadOnly) return;
        await Editor.DispatchAsync(command, cancellation.Token);
        ScheduleAutosave();
    }

    private Task MoveStepAsync(MoveStepCommand command) => DispatchAsync(command);
    private async Task CreateTransitionAsync(FlowTransitionDefinition transition)
    {
        await DispatchAsync(new AddTransitionCommand(transition));
        Editor.SelectTransition(transition.Id);
        await OfferCalledFlowInputContractAsync(transition);
    }
    private async Task ReconnectTransitionAsync(ReconnectTransitionCommand command)
    {
        await DispatchAsync(command);
        if (Editor.State.Resource?.Definition.Transitions.FirstOrDefault(transition => transition.Id == command.Id) is { } transition)
            await OfferCalledFlowInputContractAsync(transition);
    }
    private async Task RemoveTransitionAsync(string id)
    {
        await DispatchAsync(new RemoveTransitionCommand(id));
        if (Editor.State.Selection.TransitionId == id) Editor.SelectTransition(null);
    }
    private Task SelectTransitionAsync(string? id)
    {
        Editor.SelectTransition(id);
        return Task.CompletedTask;
    }
    private async Task SelectStepAsync(string? name)
    {
        Editor.SelectStep(name);
        if (name is not null)
        {
            inspectorVisibility = true;
            paletteVisibility = null;
        }
        toolSearch = string.Empty;
        toolPickerRevision++;
        if (!ReadOnly && SelectedStep is AgentFlowStepDefinition agent
            && (string.IsNullOrWhiteSpace(agent.DisplayName) || agent.DisplayName == "Agent")
            && SelectedAgent is { } selectedAgent)
            await UpdateSelectedAsync(agent with { DisplayName = selectedAgent.DisplayName });
        if (SelectedStep is FlowCallStepDefinition call) await LoadFlowVersionsAsync(call);
    }
    private async Task OpenStepSettingsAsync(string name)
    {
        await SelectStepAsync(name);
        activeStepSettingsTab = StepSettingsTab.General;
        showStepSettings = SelectedStep is not null;
    }
    private void OpenSelectedStepSettings()
    {
        activeStepSettingsTab = StepSettingsTab.General;
        showStepSettings = SelectedStep is not null;
    }
    private void CloseStepSettings() => showStepSettings = false;
