@implements IAsyncDisposable
@inject IFlowDesignerBackend Backend
@inject IFlowDesignerResourceProvider Resources
@inject FlowEditorStore Editor
@inject NavigationManager Navigation
@inject IStringLocalizer<FlowDesignerStrings> Localizer

@if (Editor.State.Resource is null && error is not null)
{
    <section class="error-panel designer-error"><strong>@T("Unavailable")</strong><p>@error</p></section>
}
else if (Editor.State.Resource is null)
{
    <LoadingState />
}
else
{
    <header class="designer-toolbar">
        <div>
            <p class="eyebrow"><a href="/flows">@T("Flows")</a> / <code>@Editor.State.Namespace.Value</code> / @ResourceId / @(ReadOnly ? T("Published", Editor.State.PublishedVersion ?? string.Empty) : T("Draft"))</p>
            <h1>@Editor.State.Resource.DisplayName</h1>
            @if (!ReadOnly)
            {
                <span class="save-state @Editor.State.SaveState.ToString().ToLowerInvariant()">@SaveText</span>
                <span class="draft-revision">@T("Revision", Editor.State.Resource.DraftRevision?.ToString(System.Globalization.CultureInfo.CurrentCulture) ?? "—")</span>
            }
            else
            {
                <span class="draft-revision">@T("PublishedVersion", Editor.State.PublishedVersion ?? string.Empty)</span>
                <span class="read-only-badge">@T("ReadOnly")</span>
            }
        </div>
        <div class="designer-modes">
            @foreach (var mode in Enum.GetValues<FlowEditorMode>())
            {
                <button class="@(Editor.State.Mode == mode ? "active" : null)" @onclick="() => Editor.SetMode(mode)">@T($"Mode.{mode}")</button>
            }
        </div>
        <div class="designer-actions">
            @if (!ReadOnly)
            {
                <button class="button-secondary" disabled="@(!Editor.CanUndo)" @onclick="Undo">@T("Undo")</button>
                <button class="button-secondary" disabled="@(!Editor.CanRedo)" @onclick="Redo">@T("Redo")</button>
                <button class="button-secondary" @onclick="ValidateAsync">@T("Validate")</button>
                <button class="button-secondary" @onclick="OpenRun">@T("RunDraft")</button>
                <button class="button-primary" disabled="@saving" @onclick="SaveAsync">@T("Save")</button>
                <label class="publish-version">@T("Version")<input aria-label="@T("PublishVersion")" @bind="publishVersion" /></label>
                <button class="button-primary" @onclick="PublishAsync">@T("Publish")</button>
            }
        </div>
    </header>

    @if (error is not null) { <p class="error-panel designer-error">@error</p> }

    <section class="flow-editor-shell @Editor.State.Mode.ToString().ToLowerInvariant()">
        @if (Editor.State.Mode is FlowEditorMode.Designer or FlowEditorMode.Split)
        {
            <aside class="step-palette">
                <h2>@T("Steps")</h2>
                @foreach (var entry in Palette)
                {
                    <button disabled="@ReadOnly" @onclick="() => AddStepAsync(entry.Type)"><span>@entry.Icon</span> @T($"Step.{entry.Type}")</button>
                }
                <hr />
                <button disabled="@ReadOnly" @onclick="() => LayoutAsync(false)">@T("HorizontalLayout")</button>
                <button disabled="@ReadOnly" @onclick="() => LayoutAsync(true)">@T("VerticalLayout")</button>
                <button @onclick="Center">@T("Center")</button>
            </aside>

            <div class="flow-canvas-wrap">
                <FlowCanvas @ref="canvas" Document="Editor.State.Diagram" Revision="Editor.State.LocalRevision" FitRevision="layoutRevision"
                            IsReadOnly="ReadOnly" SelectedStepChanged="Editor.SelectStep"
                            StepMoved="MoveStepAsync" TransitionCreated="CreateTransitionAsync"
                            TransitionRemoved="RemoveTransitionAsync" />
            </div>

            <aside class="flow-inspector">
                <h2>@T("Inspector")</h2>
                @if (SelectedStep is null)
                {
                    <p class="muted">@T("SelectStep")</p>
                }
                else
                {
                    <label>@T("DisplayName")<input disabled="@ReadOnly" value="@(SelectedStep.DisplayName ?? SelectedStep.Name)" @onchange="UpdateDisplayNameAsync" /></label>
                    <label>@T("TechnicalName")<input value="@SelectedStep.Name" readonly /></label>
                    <label>@T("Type")<input value="@SelectedStep.Type()" readonly /></label>
                    @if (SelectedStep is AgentFlowStepDefinition agent)
                    {
                        <label>@T("Agent")<select disabled="@ReadOnly" value="@agent.Agent.ResourceId" @onchange="UpdateAgentAsync">
                            <option value="${steps.route-request.output.selectedAgent}">@T("RouterOutput")</option>
                            @foreach (var item in agents) { <option value="@item.Name">@item.DisplayName</option> }
                        </select></label>
                    }
                    else if (SelectedStep is RouterFlowStepDefinition router)
                    {
                        <section class="router-editor">
                            <div class="router-group-picker">
                                <button class="button-secondary" @onclick="LoadAgentsAsync">@T("LoadAgents")</button>
                                <button class="button-secondary" disabled="@(ReadOnly || loadingAgents)" @onclick="AddAllRouterAgentsAsync">@T("AddAll")</button>
                            </div>
                            <p class="muted">@T(routerAgents.Count == 1 ? "AvailableAgents.One" : "AvailableAgents.Many", routerAgents.Count)</p>
                            <div class="route-cards">
                                @for (var index = 0; index < router.Candidates.Count; index++)
                                {
                                    var routeIndex = index;
                                    var candidate = router.Candidates[index];
                                    <article class="route-card">
                                        <header><span class="route-key-badge">@candidate.Route</span><button disabled="@ReadOnly" @onclick="() => RemoveRouterCandidateAsync(routeIndex)">×</button></header>
                                        <label>@T("RouteKey")<input disabled="@ReadOnly" value="@candidate.Route" @onchange="e => UpdateRouterCandidateAsync(routeIndex, c => c with { Route = Text(e) })" /></label>
                                        <label>@T("Agent")<select disabled="@ReadOnly" value="@candidate.Agent.ResourceId" @onchange="e => UpdateRouterCandidateAsync(routeIndex, c => c with { Agent = new(Text(e)) })">
                                            <option value="@candidate.Agent.ResourceId">@AgentLabel(candidate.Agent.ResourceId)</option>
                                            @foreach (var item in routerAgents.Where(item => item.Name != candidate.Agent.ResourceId)) { <option value="@item.Name">@item.DisplayName</option> }
                                        </select></label>
                                        <label>@T("Description")<input disabled="@ReadOnly" value="@candidate.Description" @onchange="e => UpdateRouterCandidateAsync(routeIndex, c => c with { Description = EmptyToNull(Text(e)) })" /></label>
                                        <label>@T("Examples")<input disabled="@ReadOnly" value="@string.Join(", ", candidate.Examples ?? [])" @onchange="e => UpdateRouterCandidateAsync(routeIndex, c => c with { Examples = Text(e).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) })" /></label>
                                    </article>
                                }
                            </div>
                            <button class="button-secondary" disabled="@ReadOnly" @onclick="AddRouterCandidateAsync">＋ @T("AddRoute")</button>
                        </section>
                    }
                    else if (SelectedStep is ConditionFlowStepDefinition condition)
                    {
                        <label>@T("LeftValue")<input disabled="@ReadOnly" value="@condition.Left" @onchange="e => UpdateSelectedAsync(condition with { Left = Text(e) })" /></label>
                        <label>@T("Operator")<input disabled="@ReadOnly" value="@condition.Operator" @onchange="e => UpdateSelectedAsync(condition with { Operator = Text(e) })" /></label>
                        <label>@T("RightValue")<input disabled="@ReadOnly" value="@condition.Right" @onchange="e => UpdateSelectedAsync(condition with { Right = Text(e) })" /></label>
                    }
                    else if (SelectedStep is FailureFlowStepDefinition failure)
                    {
                        <label>@T("ErrorCode")<input disabled="@ReadOnly" value="@failure.Code" @onchange="e => UpdateSelectedAsync(failure with { Code = Text(e) })" /></label>
                        <label>@T("Message")<textarea disabled="@ReadOnly" value="@failure.Message" @onchange="e => UpdateSelectedAsync(failure with { Message = Text(e) })"></textarea></label>
                    }
                    <button class="button-danger" disabled="@(ReadOnly || SelectedStep.Name == Editor.State.Resource.Definition.EntryStep)" @onclick="RemoveSelectedAsync">@T("DeleteStep")</button>
                }

                <hr /><h3>@T("Transitions")</h3>
                <label>@T("From")<select disabled="@ReadOnly" @bind="transitionFrom">@foreach (var node in Editor.State.Diagram.Nodes) { <option value="@node.Name">@node.Name</option> }</select></label>
                <label>@T("Event")<input disabled="@ReadOnly" @bind="transitionEvent" /></label>
                <label>@T("To")<select disabled="@ReadOnly" @bind="transitionTo">@foreach (var node in Editor.State.Diagram.Nodes) { <option value="@node.Name">@node.Name</option> }</select></label>
                <button class="button-secondary" disabled="@ReadOnly" @onclick="AddTransitionAsync">@T("AddTransition")</button>
                <ul class="transition-list">@foreach (var transition in Editor.State.Resource.Definition.Transitions) { <li><button @onclick="() => Editor.SelectTransition(transition.Id)">@transition.FromStep —@transition.Event→ @transition.ToStep</button><button disabled="@ReadOnly" @onclick="() => RemoveTransitionAsync(transition.Id)">×</button></li> }</ul>
            </aside>
        }

        @if (Editor.State.Mode is FlowEditorMode.Definition or FlowEditorMode.Split)
        {
            <FlowSourceEditor Value="sourceText" ValueChanged="SourceChanged" Error="Editor.State.SourceError"
                              IsReadOnly="ReadOnly" ApplyRequested="ApplySourceAsync" />
        }
    </section>

    <section class="validation-dock">
        <header><strong>@T("Validation")</strong><span>@T(Editor.State.Issues.Count == 1 ? "IssueCount.One" : "IssueCount.Many", Editor.State.Issues.Count)</span></header>
        @if (Editor.State.Issues.Count == 0) { <p class="muted">@(ReadOnly ? T("PublishedDefinitionHelp") : T("ValidationHelp"))</p> }
        else { <ul>@foreach (var issue in Editor.State.Issues) { <li class="@issue.Severity.ToString().ToLowerInvariant()"><button @onclick="() => SelectIssue(issue)"><strong>@issue.Severity</strong> @issue.Message <code>@issue.Code</code></button></li> }</ul> }
    </section>

    @if (showRun)
    {
        <div class="dialog-backdrop"><section class="dialog run-dialog"><h2>@T("RunDraftRevision", Editor.State.Resource.DraftRevision?.ToString(System.Globalization.CultureInfo.CurrentCulture) ?? "—")</h2><label>@T("InputJson")<textarea rows="10" @bind="runInput"></textarea></label><div class="dialog-actions"><button class="button-secondary" @onclick="() => showRun = false">@T("Cancel")</button><button class="button-primary" @onclick="RunDraftAsync">@T("RunDraft")</button></div></section></div>
    }
}

@code {
    private static readonly (string Type, string Icon)[] Palette = [("input", "●"), ("agent", "◎"), ("router", "◇"), ("condition", "?"), ("transform", "ƒ"), ("output", "□"), ("failure", "!")];
    private readonly CancellationTokenSource cancellation = new();
    private CancellationTokenSource? autosave;
    private FlowCanvas? canvas;
    private IReadOnlyList<FlowDesignerAgent> agents = [];
    private IReadOnlyList<FlowDesignerAgent> routerAgents = [];
    private string? loadedResource;
    private string sourceText = string.Empty;
    private string transitionFrom = string.Empty;
    private string transitionTo = string.Empty;
    private string transitionEvent = "completed";
    private string publishVersion = "1.0.0";
    private string runInput = "{\n  \"prompt\": \"How can I optimize this SQL query?\"\n}";
    private string? error;
    private bool saving;
    private bool showRun;
    private bool loadingAgents;
    private long layoutRevision;

    [Parameter, EditorRequired] public string ResourceId { get; set; } = string.Empty;
    [Parameter] public bool IsReadOnly { get; set; }
    [Parameter] public ResourceNamespace Namespace { get; set; } = ResourceNamespace.Default;

    private FlowStepDefinition? SelectedStep => Editor.State.Resource?.Definition.Steps.FirstOrDefault(step => step.Name == Editor.State.Selection.StepName);
    private string SaveText => T($"SaveState.{Editor.State.SaveState}");
    private string T(string key, params object[] arguments) => Localizer[key, arguments].Value;
    private FlowDesignerTarget Target => new(Namespace, ResourceId);
    private bool ReadOnly => IsReadOnly || Target.IsReadOnly || Editor.State.IsReadOnly;

    protected override async Task OnParametersSetAsync()
    {
        var targetKey = $"{Namespace.Value}/{ResourceId}";
        if (loadedResource == targetKey) return;
        loadedResource = targetKey;
        Editor.StateChanged += EditorChanged;
        try
        {
            error = null;
            var loaded = await Backend.LoadAsync(Target, cancellation.Token);
            sourceText = loaded.Source;
            Editor.Load(loaded, Target);
            agents = routerAgents = await Resources.GetAgentsAsync(cancellation.Token);
            transitionFrom = loaded.Resource.Definition.EntryStep;
            transitionTo = loaded.Resource.Definition.Steps.Skip(1).FirstOrDefault()?.Name ?? transitionFrom;
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            error = exception.Message;
        }
    }

    private async Task DispatchAsync(IFlowEditorCommand command)
    {
        if (ReadOnly) return;
        await Editor.DispatchAsync(command, cancellation.Token);
        ScheduleAutosave();
    }

    private Task MoveStepAsync(MoveStepCommand command) => DispatchAsync(command);
    private Task CreateTransitionAsync(FlowTransitionDefinition transition) => DispatchAsync(new AddTransitionCommand(transition));
    private Task RemoveTransitionAsync(string id) => DispatchAsync(new RemoveTransitionCommand(id));
    private async Task LayoutAsync(bool vertical)
    {
        await DispatchAsync(new ApplyAutoLayoutCommand(vertical));
        layoutRevision++;
    }
    private void Center() => canvas?.Center();
    private void EditorChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);
    private void SourceChanged(string source) { if (ReadOnly) return; sourceText = source; Editor.SetSource(source, Editor.State.SourceError); }

    private async Task SaveAsync()
    {
        if (ReadOnly || Editor.State.Resource is null || Editor.State.ETag is null || !Editor.State.IsDirty) return;
        try
        {
            saving = true; error = null; Editor.MarkSaving();
            var resource = Editor.State.Resource;
            var saved = await Backend.SaveDraftAsync(Target, new(resource.DisplayName, resource.Description, resource.Tags, resource.Definition), Editor.State.ETag, cancellation.Token);
            var source = await Backend.GetSourceAsync(Target, cancellation.Token);
            sourceText = source.Source; Editor.MarkSaved(saved, source.Source);
        }
        catch (Exception exception) { error = exception.Message; Editor.MarkSaveFailed(); }
        finally { saving = false; }
    }

    private async Task ValidateAsync() { if (ReadOnly) return; Editor.SetIssues((await Backend.ValidateAsync(Target, cancellation.Token)).Issues); }
    private async Task PublishAsync() { if (ReadOnly) return; await SaveAsync(); try { var version = await Backend.PublishAsync(Target, new(publishVersion), cancellation.Token); publishVersion = NextVersion(version.Version); await ValidateAsync(); } catch (Exception exception) { error = exception.Message; } }
    private void OpenRun() { if (ReadOnly) return; showRun = true; error = null; }
    private async Task RunDraftAsync() { if (ReadOnly) return; try { await SaveAsync(); using var json = JsonDocument.Parse(runInput); var run = await Backend.RunDraftAsync(Target, new(json.RootElement.Clone(), Trigger: FlowRunTrigger.Manual), cancellation.Token); Navigation.NavigateTo($"/flow-runs/{run.Id}"); } catch (Exception exception) { error = exception.Message; } }
    private async Task ApplySourceAsync(string source) { if (ReadOnly) return; try { var saved = await Backend.ReplaceSourceAsync(Target, new(source), Editor.State.ETag!, cancellation.Token); var canonical = await Backend.GetSourceAsync(Target, cancellation.Token); sourceText = canonical.Source; Editor.MarkSaved(saved, canonical.Source); } catch (Exception exception) { sourceText = source; Editor.SetSource(source, exception.Message); } }

    private async Task AddStepAsync(string type)
    {
        var index = Editor.State.Resource!.Definition.Steps.Count; var name = Unique(type);
        FlowStepDefinition step = type switch
        {
            "input" => new InputFlowStepDefinition { Name = name, DisplayName = "Input" },
            "agent" => new AgentFlowStepDefinition { Name = name, DisplayName = "Agent", Agent = new(agents.FirstOrDefault()?.Name ?? UnconfiguredAgent) },
            "router" => new RouterFlowStepDefinition { Name = name, DisplayName = "Router" },
            "condition" => new ConditionFlowStepDefinition { Name = name, DisplayName = "Condition", Left = "${input.prompt}", Right = "" },
            "transform" => new TransformFlowStepDefinition { Name = name, DisplayName = "Transform", Mapping = JsonSerializer.SerializeToElement(new { }) },
            "output" => new OutputFlowStepDefinition { Name = name, DisplayName = "Output", OutputMapping = JsonSerializer.SerializeToElement("${input}") },
            _ => new FailureFlowStepDefinition { Name = name, DisplayName = "Failure" }
        };
        await DispatchAsync(new AddStepCommand(step, new(40 + index * 180, 250))); Editor.SelectStep(name);
    }

    private async Task AddTransitionAsync() { if (!string.IsNullOrWhiteSpace(transitionFrom) && !string.IsNullOrWhiteSpace(transitionTo)) await CreateTransitionAsync(new($"{transitionFrom}-{transitionEvent}-{transitionTo}", transitionFrom, transitionEvent, transitionTo)); }
    private async Task RemoveSelectedAsync() { if (SelectedStep is not null) { await DispatchAsync(new RemoveStepCommand(SelectedStep.Name)); Editor.SelectStep(null); } }
    private Task UpdateDisplayNameAsync(ChangeEventArgs e) => UpdateSelectedAsync(SelectedStep! with { DisplayName = Text(e) });
    private Task UpdateAgentAsync(ChangeEventArgs e) => UpdateSelectedAsync(((AgentFlowStepDefinition)SelectedStep!) with { Agent = new(Text(e)) });
    private Task UpdateSelectedAsync(FlowStepDefinition step) => DispatchAsync(new UpdateStepCommand(step));

    private async Task LoadAgentsAsync() { try { loadingAgents = true; routerAgents = await Resources.GetAgentsAsync(cancellation.Token); } catch (Exception exception) { error = exception.Message; } finally { loadingAgents = false; } }
    private async Task AddAllRouterAgentsAsync() { await LoadAgentsAsync(); if (SelectedStep is not RouterFlowStepDefinition router) return; var candidates = router.Candidates.ToList(); foreach (var item in routerAgents.Where(item => candidates.All(candidate => candidate.Agent.ResourceId != item.Name))) candidates.Add(new(UniqueRoute(RouteKey(item.DisplayName), candidates), new(item.Name), $"Agent {item.DisplayName}.")); await UpdateSelectedAsync(router with { Candidates = candidates }); }
    private Task AddRouterCandidateAsync() { var router = (RouterFlowStepDefinition)SelectedStep!; var candidates = router.Candidates.ToList(); candidates.Add(new(UniqueRoute("route", candidates), new(routerAgents.FirstOrDefault()?.Name ?? agents.FirstOrDefault()?.Name ?? UnconfiguredAgent))); return UpdateSelectedAsync(router with { Candidates = candidates }); }
    private Task RemoveRouterCandidateAsync(int index) { var router = (RouterFlowStepDefinition)SelectedStep!; return UpdateSelectedAsync(router with { Candidates = router.Candidates.Where((_, i) => i != index).ToArray() }); }
    private Task UpdateRouterCandidateAsync(int index, Func<FlowRouterCandidate, FlowRouterCandidate> update) { var router = (RouterFlowStepDefinition)SelectedStep!; var candidates = router.Candidates.ToArray(); candidates[index] = update(candidates[index]); return UpdateSelectedAsync(router with { Candidates = candidates }); }

    private void Undo() { if (ReadOnly) return; Editor.Undo(); ScheduleAutosave(); }
    private void Redo() { if (ReadOnly) return; Editor.Redo(); ScheduleAutosave(); }
    private void SelectIssue(FlowValidationIssue issue) { if (issue.StepId is not null) Editor.SelectStep(issue.StepId); }
    private void ScheduleAutosave() { if (ReadOnly) return; autosave?.Cancel(); autosave?.Dispose(); autosave = CancellationTokenSource.CreateLinkedTokenSource(cancellation.Token); _ = AutosaveAsync(autosave.Token); }
    private async Task AutosaveAsync(CancellationToken token) { try { await Task.Delay(TimeSpan.FromSeconds(1.5), token); await SaveAsync(); } catch (OperationCanceledException) { } }
    private string Unique(string prefix) { var name = prefix; var i = 1; while (Editor.State.Resource!.Definition.Steps.Any(step => step.Name == name)) name = $"{prefix}-{++i}"; return name; }
    private static string UniqueRoute(string prefix, IReadOnlyCollection<FlowRouterCandidate> candidates) { var route = prefix; var i = 1; while (candidates.Any(candidate => candidate.Route == route)) route = $"{prefix}-{++i}"; return route; }
    private static string RouteKey(string value) { var result = new string(value.Trim().ToLowerInvariant().Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray()).Trim('-'); return string.IsNullOrWhiteSpace(result) ? "route" : result; }
    private string AgentLabel(string name) => routerAgents.Concat(agents).FirstOrDefault(item => item.Name == name)?.DisplayName ?? name;
    private static string Text(ChangeEventArgs e) => e.Value?.ToString()?.Trim() ?? string.Empty;
    private static string? EmptyToNull(string value) => string.IsNullOrWhiteSpace(value) ? null : value;
    private static string NextVersion(string value) { var parts = value.Split('.'); return parts.Length == 3 && int.TryParse(parts[2], out var patch) ? $"{parts[0]}.{parts[1]}.{patch + 1}" : "1.0.0"; }
    private const string UnconfiguredAgent = "unconfigured";

    public ValueTask DisposeAsync()
    {
        Editor.StateChanged -= EditorChanged;
        autosave?.Cancel(); autosave?.Dispose(); cancellation.Cancel(); cancellation.Dispose();
        return ValueTask.CompletedTask;
    }
}
