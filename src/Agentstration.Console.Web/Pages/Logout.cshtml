@page "/logout"
@model LogoutModel
@{
    ViewData["Title"] = Auth["SignOut"];
}

<header class="auth-heading">
    <p class="eyebrow">@Auth["CurrentSession"]</p>
    <h1>@Auth["SignOutQuestion"]</h1>
    <p>@Auth["SignOutDescription"]</p>
</header>

<form method="post" class="auth-actions">
    <button type="submit" class="primary-action">@Auth["SignOut"]</button>
    <a href="/" class="secondary-action">@Auth["Cancel"]</a>
</form>
