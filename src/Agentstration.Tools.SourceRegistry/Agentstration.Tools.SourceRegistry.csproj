<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>agentstration-source-registry</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>agentstration-source-registry</ToolCommandName>
    <PackageId>Agentstration.SourceRegistry.Tool</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Offline validation and canonical digest tooling for Agentstration Source Version and Source Registry publications.</Description>
    <PackageTags>agentstration;source;registry;manifest;validation</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Agentstration.Management.Contracts/Agentstration.Management.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
