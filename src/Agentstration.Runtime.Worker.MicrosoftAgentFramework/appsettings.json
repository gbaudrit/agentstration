{
  "Observability": {
    "Http": {
      "Enabled": false,
      "LogMetadata": true,
      "CaptureRequestBody": false,
      "CaptureResponseBody": false,
      "MaximumBodyBytes": 16384,
      "ExcludedPaths": [
        "/health",
        "/_blazor",
        "/hubs"
      ]
    }
  },
  "Agentstration": {
    "RuntimeWorker": {
      "AuthorityUrl": "http://localhost:5100",
      "InstanceId": "local",
      "MaximumConcurrentAssignments": 1,
      "ClaimWaitSeconds": 20,
      "TransientRetryCount": 3,
      "LeaseSafetyMarginSeconds": 8,
      "AllowInsecureHttp": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
