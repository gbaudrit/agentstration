@implements IAsyncDisposable
@inject IJSRuntime JavaScript

<section class="interaction-view" aria-labelledby="interaction-title" data-testid="workplace-interaction">
    <header class="interaction-header">
        <div><h2 id="interaction-title">@Localizer["Conversation"]</h2>@if (!string.IsNullOrWhiteSpace(Task?.Title)) { <p class="interaction-context">@Task.Title</p> }</div>
        <div class="interaction-actions"><button class="button-secondary" type="button" aria-label="@Localizer["NewRequest"]" title="@Localizer["NewRequest"]" @onclick="OnNewRequest" data-testid="workplace-new-request"><UiIcon Name="message-plus" /> <span>@Localizer["NewRequest"]</span></button></div>
    </header>

    <div class="conversation-thread" aria-live="polite" @ref="conversationThread" data-testid="workplace-conversation-thread">
        @foreach (var item in Timeline)
        {
            @switch (item.Value)
            {
                case ConversationMessage message:
                    <ConversationMessageView Message="message" />
                    break;
                case WorkTaskActivity activity:
                    <TaskActivityView Activity="activity" ParticipantVisibility="Presentation.Participants.Visibility" />
                    break;
                case WorkplaceAction action when action is RequestChoiceAction or RequestConfirmationAction or RequestInputAction:
                    <div class="inline-pending"><PendingActionPanel @key="(PendingId(action), ResponseAcknowledgement)" Action="action" Busy="Busy" SubmitDisabled="PendingSubmitDisabled" OnSubmit="OnPendingAction" ConversationMode="true" DraftChanged="PendingDraftChangedAsync" /></div>
                    break;
                case WorkTaskResponse task:
                    <InlineTaskCard Task="task" DetailsUrl="@TaskDetailsUrl(task)" />
                    break;
                case WorkTaskResult result:
                    <TaskResultView Result="result" />
                    break;
                case ResultDiagnosticsItem:
                    <div class="result-diagnostics">
                        <button class="result-diagnostics-toggle" type="button" aria-expanded="@diagnosticsExpanded.ToString().ToLowerInvariant()" @onclick="ToggleDiagnostics"><UiIcon Name="document" /> @Localizer["ExecutionDetails"] <small>@Localizer["Development"]</small></button>
                        @if (diagnosticsExpanded)
                        {
                            <div class="result-diagnostics-content">
                                @foreach (var result in Results.OrderBy(value => value.Sequence))
                                {
                                    <TaskResultView Result="result" />
                                }
                            </div>
                        }
                    </div>
                    break;
                case WorkTaskArtifact artifact:
                    <ArtifactCard Artifact="artifact" ContentUrl="@ArtifactContentUrl(artifact)" />
                    break;
                case ProcessingItem:
                    <div class="processing-feedback" role="status"><span></span>@Localizer["ProcessingRequest"]</div>
                    break;
                case AssistantResponseItem response:
                    <article class="assistant-response" data-testid="workplace-assistant-response"><span><UiIcon Name="sparkle" /></span><div><strong>Agentstration</strong><p>@response.Content</p></div></article>
                    break;
            }
        }
        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <p class="interaction-error" role="alert">@Error</p>
        }
    </div>
    <ConversationComposer Busy="Busy" DisabledReason="@ComposerDisabledReason" OnSubmit="OnMessage" TrySubmit="TrySendMessage" DraftChanged="ComposerDraftChangedAsync" />
</section>

@code {
    [Parameter] public IReadOnlyList<ConversationMessage> Messages { get; set; } = [];
    [Parameter] public WorkplaceAction? Action { get; set; }
    [Parameter] public PendingActionContract? PendingAction { get; set; }
    [Parameter] public DateTimeOffset? ActionTimestamp { get; set; }
    [Parameter] public EntryPresentation Presentation { get; set; } = new();
    [Parameter] public WorkTaskResponse? Task { get; set; }
    [Parameter] public IReadOnlyList<WorkTaskActivity> Activities { get; set; } = [];
    [Parameter] public IReadOnlyList<WorkTaskResult> Results { get; set; } = [];
    [Parameter] public IReadOnlyList<WorkTaskArtifact> Artifacts { get; set; } = [];
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool DiagnosticsEnabled { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public InteractionStatus Status { get; set; } = InteractionStatus.Active;
    [Parameter] public EventCallback<PendingActionAnswer> OnPendingAction { get; set; }
    [Parameter] public EventCallback<string> OnMessage { get; set; }
    [Parameter] public EventCallback OnNewRequest { get; set; }
    [Parameter, EditorRequired] public required Func<WorkTaskArtifact, string> ArtifactContentUrl { get; set; }
    [Parameter] public Func<WorkTaskResponse, string> TaskDetailsUrl { get; set; } = task => $"/tasks/{task.Id}";

    [Parameter] public EventCallback<bool> DraftChanged { get; set; }
    [Parameter] public Func<string, Task<bool>>? TrySendMessage { get; set; }
    [Parameter] public long ResponseAcknowledgement { get; set; }
    [Parameter] public bool PendingSubmitDisabled { get; set; }
    [Parameter] public string? SubmitDisabledReason { get; set; }
    private bool pendingDraft, composerDraft, reportedDraft, disposed;
    public bool HasPendingDraft => pendingDraft;
    public bool HasMessageDraft => composerDraft;
    private Task pendingInitialization = System.Threading.Tasks.Task.CompletedTask;
    private PendingActionId? draftPendingId;
    private long acknowledgedResponse;
    private static PendingActionId? PendingId(WorkplaceAction? value) => value switch { RequestInputAction input => input.PendingActionId, RequestChoiceAction choice => choice.PendingActionId, RequestConfirmationAction confirmation => confirmation.PendingActionId, _ => null };
    private async Task PendingDraftChangedAsync(bool value) { pendingDraft = value; await ReportDraftAsync(); }
    private async Task ComposerDraftChangedAsync(bool value) { composerDraft = value; await ReportDraftAsync(); }
    private Task ReportDraftAsync() { var value = pendingDraft || composerDraft; if (value == reportedDraft) return System.Threading.Tasks.Task.CompletedTask; reportedDraft = value; return DraftChanged.InvokeAsync(value); }
    private IReadOnlyList<TimelineItem> Timeline
    {
        get
        {
            var items = new List<TimelineItem>();
            items.AddRange(Messages.Where(ShowMessage).Select(value => new TimelineItem(value.CreatedAt, 0, value.Id.ToString("N"), value)));
            if (Action is RespondAction response && !Messages.Any(value => value.Role == ConversationRole.Agentstration && value.Content == response.Content))
                items.Add(new(ActionTimestamp ?? DateTimeOffset.MaxValue, 0, "response", new AssistantResponseItem(response.Content)));
            if (Action is RequestChoiceAction or RequestConfirmationAction or RequestInputAction)
                items.Add(new(PendingAction?.CreatedAt ?? ActionTimestamp ?? DateTimeOffset.MaxValue, 2, "pending", Action));
            IReadOnlyList<WorkTaskActivity> progress = Presentation.Progress.Visibility switch
            {
                EntryProgressVisibility.Detailed => Activities,
                EntryProgressVisibility.Compact => CompactProgress(),
                _ => []
            };
            items.AddRange(progress.Select(value => new TimelineItem(value.CreatedAt, 1, value.Id.ToString(), value)));
            if (Task is not null && ShowTask(Task)) items.Add(new(Task.CreatedAt, 3, Task.Id.ToString(), Task));
            items.AddRange(Results.Where(ShowResult).Select(value => new TimelineItem(value.CreatedAt, 4, value.Id.ToString(), value)));
            if (DiagnosticsEnabled && Presentation.Results.Display == EntryResultDisplay.Auto && Results.Count > 0)
                items.Add(new(Results.Max(value => value.CreatedAt), 4, "result-diagnostics", ResultDiagnosticsItem.Instance));
            items.AddRange(Artifacts.Select(value => new TimelineItem(value.CreatedAt, 5, value.Id.ToString(), value)));
            if (Presentation.Progress.Visibility != EntryProgressVisibility.Hidden
                && Task is not null && Task.Status is WorkTaskStatus.Running or WorkTaskStatus.Pending && progress.Count == 0)
                items.Add(new(Task.UpdatedAt, 1, "processing", ProcessingItem.Instance));
            return items.OrderBy(value => value.Timestamp).ThenBy(value => value.Order).ThenBy(value => value.Key, StringComparer.Ordinal).ToArray();
        }
    }

    private bool ShowMessage(ConversationMessage message) => Presentation.Participants.Visibility == EntryParticipantVisibility.Visible
        || message.Metadata?.ContainsKey("participantId") != true;
    private IReadOnlyList<WorkTaskActivity> CompactProgress()
    {
        var latest = Activities.OrderByDescending(value => value.CreatedAt).FirstOrDefault();
        if (latest is null) return [];
        if (latest.Type == WorkTaskActivityType.ActionRequired
            && Action is RequestChoiceAction or RequestConfirmationAction or RequestInputAction)
            return [];
        if (latest.Type == WorkTaskActivityType.TaskCompleted
            && (Results.Any(result => result.CreatedAt >= latest.CreatedAt)
                || Artifacts.Any(artifact => artifact.CreatedAt >= latest.CreatedAt)
                || Messages.Any(message => message.Role == ConversationRole.Agentstration && message.CreatedAt >= latest.CreatedAt)))
            return [];
        if (latest.Type == WorkTaskActivityType.ProgressCompleted
            && latest.Metadata?.GetValueOrDefault("flowEventSequence") is { } sequence
            && Messages.Any(message => message.Metadata?.GetValueOrDefault("flowEventSequence") == sequence))
            return [];
        if (latest.Type == WorkTaskActivityType.ResultProduced && Results.Count > 0) return [];
        if (latest.Type == WorkTaskActivityType.ArtifactProduced && Artifacts.Count > 0) return [];
        return [latest];
    }
    private static readonly TimeSpan AutoTaskDuration = TimeSpan.FromMinutes(1);

    private bool ShowTask(WorkTaskResponse task) => Presentation.Task.Display switch
    {
        EntryTaskDisplay.Visible => true,
        EntryTaskDisplay.Hidden => false,
        _ => IsMaterialTask(task)
    };
    private bool IsMaterialTask(WorkTaskResponse task)
    {
        if (task.Status is WorkTaskStatus.ActionRequired or WorkTaskStatus.Paused or WorkTaskStatus.Failed or WorkTaskStatus.Cancelled)
            return true;

        var lastObservedAt = Activities.Select(value => value.CreatedAt)
            .Concat(Results.Select(value => value.CreatedAt))
            .Concat(Artifacts.Select(value => value.CreatedAt))
            .Append(task.UpdatedAt)
            .Max();
        var completedMilestones = Activities.Count(value => value.Type == WorkTaskActivityType.ProgressCompleted);
        var deliverables = Results.Count + Artifacts.Count;
        return lastObservedAt - task.CreatedAt >= AutoTaskDuration || completedMilestones >= 2 || deliverables >= 2;
    }
    private bool ShowResult(WorkTaskResult _) => Presentation.Results.Display == EntryResultDisplay.Visible;
    private void ToggleDiagnostics() => diagnosticsExpanded = !diagnosticsExpanded;
    private bool diagnosticsExpanded;
    private Guid? diagnosticsTaskId;
    private ElementReference conversationThread;
    private IJSObjectReference? autoScrollModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed) return;
        if (firstRender) await (pendingInitialization = InitializeScrollAsync());
        if (!disposed) await ReportDraftAsync();
    }

    private async Task InitializeScrollAsync()
    {
        try
        {
            autoScrollModule = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./_content/Agentstration.Workplace.Components/conversation-auto-scroll.js");
            if (!disposed) await autoScrollModule.InvokeVoidAsync("initialize", conversationThread);
        }
        catch (JSDisconnectedException) when (disposed) { }
    }
    protected override void OnParametersSet()
    {
        var pendingId = PendingId(Action);
        if (draftPendingId != pendingId || acknowledgedResponse != ResponseAcknowledgement) { draftPendingId = pendingId; acknowledgedResponse = ResponseAcknowledgement; pendingDraft = false; }
        var taskId = Task?.Id ?? Results.FirstOrDefault()?.WorkTaskId.Value;
        if (taskId == diagnosticsTaskId) return;
        diagnosticsTaskId = taskId;
        diagnosticsExpanded = false;
    }
    private string? ComposerDisabledReason => !string.IsNullOrWhiteSpace(SubmitDisabledReason) ? SubmitDisabledReason : Action is RequestChoiceAction or RequestConfirmationAction or RequestInputAction || Status == InteractionStatus.WaitingForUser
        ? Localizer["AnswerPendingQuestion"].Value
        : Status == InteractionStatus.Closed ? Localizer["ConversationClosed"].Value
        : !string.IsNullOrWhiteSpace(Error) ? Localizer["ConversationReconnect"].Value
        : null;
    private sealed record TimelineItem(DateTimeOffset Timestamp, int Order, string Key, object Value);
    private sealed record AssistantResponseItem(string Content);
    private sealed class ProcessingItem { public static readonly ProcessingItem Instance = new(); }
    private sealed class ResultDiagnosticsItem { public static readonly ResultDiagnosticsItem Instance = new(); }

    public async ValueTask DisposeAsync()
    {
        if (disposed) return;
        disposed = true;
        try
        {
            await pendingInitialization;
            if (autoScrollModule is not null) { await autoScrollModule.InvokeVoidAsync("dispose", conversationThread); await autoScrollModule.DisposeAsync(); }
        }
        catch (JSDisconnectedException) { }
        GC.SuppressFinalize(this);
    }
}
