<div class="conversation-composer" aria-busy="@(Busy || submitting)">
    <form @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
        <label class="sr-only" for="conversation-message">@Localizer["ContinueConversation"]</label>
        <textarea id="conversation-message" @ref="composer" @bind="message" @bind:event="oninput" @onkeydown="HandleKeyDown" placeholder="@EffectivePlaceholder" disabled="@IsDisabled" aria-describedby="composer-help composer-reason"></textarea>
        <button type="submit" disabled="@(IsDisabled || string.IsNullOrWhiteSpace(message))" aria-label="@Localizer["SendMessage"]"><UiIcon Name="send" /><span>@(Busy || submitting ? Localizer["Sending"] : Localizer["Send"])</span></button>
    </form>
    <div class="composer-meta">
        @if (!string.IsNullOrWhiteSpace(DisabledReason)) { <small id="composer-reason" role="status">@DisabledReason</small> }
        else { <small id="composer-help">@Localizer["ComposerHelp"]</small> }
    </div>
</div>

@code {
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? DisabledReason { get; set; }
    [Parameter] public EventCallback<string> OnSubmit { get; set; }
    private string message = string.Empty;
    private bool submitting;
    private ElementReference composer;
    private bool IsDisabled => Busy || submitting || !string.IsNullOrWhiteSpace(DisabledReason);
    private string EffectivePlaceholder => Placeholder ?? Localizer["ComposerPlaceholder"];

    private async Task HandleKeyDown(KeyboardEventArgs args) { if ((args.CtrlKey || args.MetaKey) && args.Key == "Enter") await SubmitAsync(); }
    private async Task SubmitAsync()
    {
        if (IsDisabled || string.IsNullOrWhiteSpace(message)) return;
        submitting = true;
        var content = message.Trim();
        try { await OnSubmit.InvokeAsync(content); message = string.Empty; }
        finally { submitting = false; }
        await composer.FocusAsync();
    }
}
