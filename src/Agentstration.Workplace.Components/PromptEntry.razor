<form class="prompt-entry" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true" aria-busy="@(Busy || submitting)">
    <div class="entry-heading">
        <div>
            <h2>@Definition.DisplayName</h2>
            @if (Definition.Description is not null) { <p>@Definition.Description</p> }
        </div>
    </div>
    <div class="prompt-composer">
        <span class="composer-core" aria-hidden="true"><svg class="composer-symbol" viewBox="0 0 100 100" focusable="false"><defs><linearGradient id="composer-a-gradient" x1="14" y1="12" x2="84" y2="90" gradientUnits="userSpaceOnUse"><stop stop-color="#39d7ff"/><stop offset=".52" stop-color="#4f63ff"/><stop offset="1" stop-color="#a54cff"/></linearGradient></defs><path fill="url(#composer-a-gradient)" d="M50 8 89 78c3 6-1 11-7 11H70L50 51 30 89H18c-6 0-10-5-7-11L50 8Z"/><path fill="url(#composer-a-gradient)" d="M24 94c10-12 18-20 26-26 8 6 16 14 26 26-12-6-20-11-26-16-6 5-14 10-26 16Z"/></svg></span>
        <textarea @bind="request" @bind:event="oninput" @onkeydown="HandleKeyDown" placeholder="@Definition.Presentation.Placeholder" aria-label="@Definition.DisplayName" aria-describedby="prompt-help prompt-error" disabled="@(Disabled || Busy || submitting)"></textarea>
        <button class="prompt-submit" type="submit" aria-label="@Localizer["SendRequest"]" disabled="@(Disabled || Busy || submitting || string.IsNullOrWhiteSpace(request))">
            <UiIcon Name="send" /><span>@(Busy || submitting ? Localizer["Sending"] : Localizer["SendRequest"])</span>
        </button>
    </div>
    @if (Definition.Presentation.Suggestions.Count > 0)
    {
        <div class="entry-suggestions" aria-label="@Localizer["Suggestions"]">
            @foreach (var suggestion in Definition.Presentation.Suggestions)
            {
                <button type="button" disabled="@(Disabled || Busy || submitting)" @onclick="() => request = suggestion.Value"><span class="suggestion-icon"><UiIcon Name="sparkle" /></span><span>@suggestion.Label</span></button>
            }
        </div>
    }
    <div class="prompt-meta">
        <small id="prompt-help">@Localizer["PromptHelp"]</small>
        @if (error is not null) { <small id="prompt-error" class="entry-error" role="alert">@error</small> }
    </div>
</form>

@code {
    [Parameter, EditorRequired] public required EntryResource Definition { get; set; }
    [Parameter, EditorRequired] public required EventCallback<IReadOnlyDictionary<string, JsonElement>> OnSubmit { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Busy { get; set; }
    private string request = string.Empty;
    private string? error;
    private bool submitting;

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if ((args.CtrlKey || args.MetaKey) && args.Key == "Enter") await SubmitAsync();
    }

    private async Task SubmitAsync()
    {
        if (Disabled || Busy || submitting) return;
        var field = Definition.Presentation.Fields.FirstOrDefault(value => value.Name == "request");
        var minimum = field?.Validation?.MinimumLength ?? 1;
        if (request.Trim().Length < minimum) { error = Localizer["MinimumCharacters", minimum]; return; }
        error = null;
        submitting = true;
        try { await OnSubmit.InvokeAsync(new Dictionary<string, JsonElement> { ["request"] = JsonSerializer.SerializeToElement(request.Trim()) }); }
        finally { submitting = false; }
    }
}
