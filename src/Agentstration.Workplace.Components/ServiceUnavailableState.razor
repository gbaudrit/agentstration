<section class="service-unavailable" role="alert">
    <span class="service-unavailable-icon" aria-hidden="true"><UiIcon Name="offline" /></span>
    <div class="service-unavailable-copy"><span class="service-unavailable-kicker">Connection interrupted</span><h2>Workplace is temporarily unavailable</h2><p>@Message</p></div>
    <form method="get" action="@Navigation.Uri" data-enhance="false">
        <button class="button-primary" type="submit"><UiIcon Name="refresh" /> Try again</button>
    </form>
</section>
@code {
    [Inject] private NavigationManager Navigation { get; set; } = null!;
    [Parameter] public string Message { get; set; } = "Check that the local Work API is running, then retry.";
}
