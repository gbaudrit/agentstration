<section class="entry-renderer" data-entry-role="@Role.ToString().ToLowerInvariant()" data-testid="workplace-entry" data-entry-id="@Definition.Id.Value" data-entry-namespace="@Definition.Id.Namespace.Value">
    @if (Definition.Presentation.Kind == EntryPresentationKind.Prompt)
    {
        <PromptEntry Definition="Definition" InitialValue="@PrimaryInitialValue" OnSubmit="OnSubmit" Disabled="Disabled" Busy="Busy" />
    }
    else if (Definition.Presentation.Kind == EntryPresentationKind.Form)
    {
        <FormEntry Definition="Definition" InitialValues="InitialValues" OnSubmit="OnSubmit" Disabled="Disabled" Busy="Busy" />
    }
    else
    {
        <p role="alert">@Localizer["EntryPresentationUnavailable"]</p>
    }
</section>

@code {
    [Parameter, EditorRequired] public required EntryResource Definition { get; set; }
    [Parameter] public DashboardItemRole Role { get; set; } = DashboardItemRole.Standard;
    [Parameter, EditorRequired] public required EventCallback<IReadOnlyDictionary<string, JsonElement>> OnSubmit { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public IReadOnlyDictionary<string, JsonElement> InitialValues { get; set; } = new Dictionary<string, JsonElement>();
    private string? PrimaryInitialValue
    {
        get
        {
            var primaryField = Definition.Presentation.Fields.SingleOrDefault(value => value.Role == EntryFieldRole.PrimaryInput);
            return primaryField is not null
                && InitialValues.TryGetValue(primaryField.Name, out var value)
                && value.ValueKind == JsonValueKind.String
                    ? value.GetString()
                    : null;
        }
    }
}
