<section class="panel"><div class="panel-header"><h2>Conversation</h2></div><div class="conversation">@foreach(var message in Messages){<article class="message role-@message.Role.ToString().ToLowerInvariant()"><strong>@message.Role</strong><p>@message.Content</p><time>@message.CreatedAt.LocalDateTime.ToString("g")</time></article>}</div></section>
@code { [Parameter] public IReadOnlyList<ConversationMessage> Messages{get;set;}=[]; }
