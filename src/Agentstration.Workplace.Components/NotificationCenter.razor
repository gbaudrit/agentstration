<section class="panel">
    <div class="panel-header">
        <div>
            <p class="eyebrow">@Localizer["Activity"]</p>
            <h2>@Localizer["Notifications"]</h2>
        </div>
        @if (Notifications.Any(value => value.ReadAt is null))
        {
            <button class="text-button" @onclick="OnMarkAllRead">@Localizer["MarkAllRead"]</button>
        }
    </div>

    @if (Notifications.Count == 0)
    {
        <div class="compact-empty"><EmptyState Title="@Localizer["AllQuiet"]" Message="@Localizer["TaskUpdatesAppearHere"]" /></div>
    }
    else
    {
        @foreach (var item in Notifications.OrderBy(value => value.ReadAt is not null).ThenByDescending(value => value.CreatedAt))
        {
            <article class="notification-row @(item.ReadAt is null ? "unread" : null)">
                <div>
                    <strong>@NotificationTitle(item)</strong>
                    <p>@NotificationMessage(item)</p>
                    <time>@item.CreatedAt.LocalDateTime.ToString("g")</time>
                </div>
                @if (item.ReadAt is null)
                {
                    <button class="text-button" @onclick="() => OnMarkRead.InvokeAsync(item.Id)">@Localizer["MarkRead"]</button>
                }
            </article>
        }
    }
</section>

@code {
    [Parameter]
    public IReadOnlyList<WorkNotification> Notifications { get; set; } = [];

    [Parameter]
    public EventCallback<WorkNotificationId> OnMarkRead { get; set; }

    [Parameter]
    public EventCallback OnMarkAllRead { get; set; }

    private string NotificationTitle(WorkNotification notification) => notification.Kind switch
    {
        WorkNotificationKind.TaskCompleted => Localizer["TaskCompletedNotification"],
        WorkNotificationKind.TaskFailed => Localizer["TaskFailedNotification"],
        _ => notification.Title
    };

    private string NotificationMessage(WorkNotification notification) => notification.Kind == WorkNotificationKind.TaskCompleted
        ? Localizer["ResultReadyNotification"]
        : notification.Message;
}
