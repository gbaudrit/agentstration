<section class="panel">
    <div class="panel-header">
        <div>
            <p class="eyebrow">@Localizer["Activity"]</p>
            <h2>@Localizer["Notifications"]</h2>
        </div>
        @if (Notifications.Any(value => value.ReadAt is null))
        {
            <button class="text-button" @onclick="OnMarkAllRead" data-testid="workplace-notifications-mark-all-read">@Localizer["MarkAllRead"]</button>
        }
    </div>

    @if (Notifications.Count == 0)
    {
        <div class="compact-empty"><EmptyState Title="@Localizer["AllQuiet"]" Message="@Localizer["TaskUpdatesAppearHere"]" /></div>
    }
    else
    {
        @foreach (var item in Notifications.OrderBy(value => value.ReadAt is not null).ThenByDescending(value => value.CreatedAt))
        {
            <article class="notification-row @(item.ReadAt is null ? "unread" : null)" data-testid="workplace-notification" data-notification-id="@item.Id" data-read="@(item.ReadAt is not null ? "true" : "false")">
                <div>
                    <CollectionIdentity DisplayName="@NotificationTitle(item)" Name="@item.Id.ToString()" IconName="bell" ><IconBadges><ResourceScopeBadge ScopeRef="@Agentstration.Resources.ResourceScopeRef.Workspace(item.WorkspaceId.Value)" IconOnly /><StatusBadge Text="@Localizer[item.ReadAt is null ? "Unread" : "Read"]" Status="@(item.ReadAt is null ? Agentstration.Web.Components.Models.UiStatus.Info : Agentstration.Web.Components.Models.UiStatus.Neutral)" IconOnly /></IconBadges></CollectionIdentity>
                    <p>@NotificationMessage(item)</p>
                    <time>@item.CreatedAt.LocalDateTime.ToString("g")</time>
                </div>
                @if (item.ReadAt is null)
                {
                    <CollectionActions ResourceName="@NotificationTitle(item)"><button class="text-button" @onclick="() => OnMarkRead.InvokeAsync(item.Id)" data-testid="workplace-notification-mark-read">@Localizer["MarkRead"]</button></CollectionActions>
                }
            </article>
        }
    }
</section>

@code {
    [Parameter]
    public IReadOnlyList<WorkNotification> Notifications { get; set; } = [];

    [Parameter]
    public EventCallback<WorkNotificationId> OnMarkRead { get; set; }

    [Parameter]
    public EventCallback OnMarkAllRead { get; set; }

    private string NotificationTitle(WorkNotification notification) => notification.Kind switch
    {
        WorkNotificationKind.TaskCompleted => Localizer["TaskCompletedNotification"],
        WorkNotificationKind.TaskFailed => Localizer["TaskFailedNotification"],
        _ => notification.Title
    };

    private string NotificationMessage(WorkNotification notification) => notification.Kind == WorkNotificationKind.TaskCompleted
        ? Localizer["ResultReadyNotification"]
        : notification.Message;
}
