<FormField Label="@(Definition.Label ?? Definition.Name)" Required="@Definition.Required" Help="@Definition.Description" Class="entry-field" data-testid="workplace-form-input" data-field-name="@Definition.Name" data-field-type="@Definition.Type">
    @if (Definition.Type is EntryFieldType.Textarea or EntryFieldType.Prompt)
    {
        <ClearableText Multiline="true" Value="@StringValue" placeholder="@Definition.Placeholder" Disabled="@Disabled" ValueChanged="changed => ChangeString(new ChangeEventArgs { Value = changed })"></ClearableText>
    }
    else if (Definition.Type == EntryFieldType.Choice)
    {
        <ClearableSelect TValue="string" Value="@Convert.ToString(StringValue, System.Globalization.CultureInfo.InvariantCulture)" disabled="@Disabled" ValueChanged="changed => ChangeString(new ChangeEventArgs { Value = changed })"><option value="">@Localizer["SelectOption"]</option>@foreach (var option in Definition.Options) { <option value="@option.Value">@option.Label</option> }</ClearableSelect>
    }
    else if (Definition.Type == EntryFieldType.Boolean)
    {
        <FormCheckbox Value="@BooleanValue" disabled="@Disabled" ValueChanged="changed => ChangeBoolean(new ChangeEventArgs { Value = changed })" />
    }
    else
    {
        <ClearableText Type="@(Definition.Type == EntryFieldType.Date ? "date" : Definition.Type == EntryFieldType.Number ? "number" : "text")" Value="@StringValue" placeholder="@Definition.Placeholder" Disabled="@Disabled" ValueChanged="changed => ChangeString(new ChangeEventArgs { Value = changed })" />
    }
</FormField>
@code {
    [Parameter, EditorRequired] public required EntryFieldDefinition Definition { get; set; }
    [Parameter] public JsonElement Value { get; set; }
    [Parameter] public EventCallback<JsonElement> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private string StringValue => Value.ValueKind == JsonValueKind.String ? Value.GetString() ?? string.Empty : string.Empty;
    private bool BooleanValue => Value.ValueKind is JsonValueKind.True or JsonValueKind.False && Value.GetBoolean();
    private Task ChangeString(ChangeEventArgs args) => ValueChanged.InvokeAsync(JsonSerializer.SerializeToElement(args.Value?.ToString() ?? string.Empty));
    private Task ChangeBoolean(ChangeEventArgs args) => ValueChanged.InvokeAsync(JsonSerializer.SerializeToElement(bool.TryParse(args.Value?.ToString(), out var value) && value));
}
