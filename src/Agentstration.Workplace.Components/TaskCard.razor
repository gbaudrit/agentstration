<a class="task-card" href="@($"/tasks/{Task.Id}")">
    <span class="task-status status-@Task.Status.ToString().ToLowerInvariant()">@Label(Task.Status)</span>
    <strong>@Task.Title</strong>
    <small>@Localizer["UpdatedAt", Task.UpdatedAt.LocalDateTime.ToString("g")]</small>
</a>
@code {
    [Parameter, EditorRequired] public required WorkTask Task { get; set; }
    private string Label(WorkTaskStatus status) => Localizer[$"TaskStatus.{status}"];
}
