<article class="inline-task-card">
    <CollectionIdentity DisplayName="@Task.Title" Name="@Task.Id.ToString()" Href="@DetailsUrl" IconName="tasks" class="resource-name-link inline-task-link" data-testid="workplace-inline-task" data-task-id="@Task.Id" data-task-status="@Task.Status" />
    <ResourceScopeBadge ScopeRef="@Agentstration.Resources.ResourceScopeRef.Workspace(Task.WorkspaceId)" />
    <small class="task-card-kind">@Localizer["Task"]</small>
    <TaskStatusBadge Value="Task.Status" />
    <small>@Localizer["UpdatedAt", Task.UpdatedAt.LocalDateTime.ToString("g")]</small>
    <CollectionActions ResourceName="@Task.Title"><a href="@DetailsUrl">@Localizer["ViewTaskDetails", Task.Title]</a></CollectionActions>
</article>
@code {
    [Parameter, EditorRequired] public required WorkTaskResponse Task { get; set; }
    [Parameter, EditorRequired] public required string DetailsUrl { get; set; }
    private string StatusLabel => Localizer[$"TaskStatus.{Task.Status}"];
}
