@inherits LayoutComponentBase
@implements IAsyncDisposable
@using Agentstration.Web.Components.Localization
@inject NavigationManager Navigation
@inject UserPreferencesState Preferences
@inject IJSRuntime JS
@inject Microsoft.Extensions.Localization.IStringLocalizer<WorkplaceLayoutStrings> Localizer
<div class="app-shell @(Preferences.IsDarkTheme ? "theme-dark" : "theme-light") workplace-shell">
    <aside class="sidebar" aria-label="@T("WorkplaceNavigation")">
        <a class="brand-lockup" href="@HomeUrl" aria-label="@T("WorkplaceHome")"><span class="brand-mark"><img src="_content/Agentstration.Web.Components/images/agentstration-mark.png" alt="" /></span><span><strong>Agentstration</strong><small>Workplace</small></span></a>
        <nav class="side-nav">
            <NavLink href="@HomeUrl" Match="NavLinkMatch.All"><UiIcon Name="home" /><span class="nav-label">@T("Home")</span></NavLink>
            @if (CurrentWorkspace is null)
            {
                <a class="side-nav-disabled" aria-disabled="true" tabindex="-1"><UiIcon Name="tasks" /><span class="nav-label">@T("Tasks")</span></a>
                <a class="side-nav-disabled" aria-disabled="true" tabindex="-1"><UiIcon Name="notifications" /><span class="nav-label">@T("Notifications")</span></a>
            }
            else
            {
                <NavLink href="@TasksUrl"><UiIcon Name="tasks" /><span class="nav-label">@T("Tasks")</span></NavLink>
                <NavLink href="@NotificationsUrl"><UiIcon Name="notifications" /><span class="nav-label">@T("Notifications")</span></NavLink>
            }
        </nav>
        <div class="sidebar-footer"><strong>@(CurrentWorkspace ?? "Workplace")</strong><small>@T("LocalMode")</small></div>
    </aside>
    <div class="workspace">
        <header class="mobile-appbar">
            <a class="mobile-brand" href="@HomeUrl" aria-label="@T("WorkplaceHome")"><img src="_content/Agentstration.Web.Components/images/agentstration-mark.png" alt="" /><span><small>Agentstration</small><strong>Workplace</strong></span></a>
            <a class="mobile-notifications" href="@NotificationsUrl" aria-label="@T("OpenNotifications")"><UiIcon Name="notifications" /></a>
        </header>
        <header class="topbar"><div class="topbar-start"><nav class="breadcrumb"><a href="@HomeUrl">@(CurrentWorkspace is null ? T("MyWorkplace") : F("NamedWorkplace", CurrentWorkspace))</a></nav></div><div class="topbar-actions"><span class="environment-chip">LOCAL</span><button class="icon-button" @onclick="ToggleThemeAsync" disabled="@Preferences.IsSaving" aria-label="@T("ToggleColorTheme")" title="@(Preferences.Error ?? F("ThemeValue", Preferences.Theme))"><UiIcon Name="@(Preferences.IsDarkTheme ? "theme-light" : "theme-dark")" /></button><a class="icon-button" href="@NotificationsUrl" aria-label="@T("OpenNotifications")"><UiIcon Name="notifications" /></a></div></header><main class="content">@Body</main>
    </div>
</div>

@code {
    private readonly CancellationTokenSource lifetimeCancellation = new();
    private IJSObjectReference? themeModule;

    protected override async Task OnInitializedAsync()
    {
        Preferences.Changed += OnPreferencesChanged;
        await Preferences.LoadAsync(lifetimeCancellation.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        themeModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Agentstration.Web.Components/theme-preferences.js");
        Preferences.SetSystemTheme(await themeModule.InvokeAsync<bool>("prefersDarkTheme"));
        CultureNavigation.NavigateToPreferredCulture(Navigation, Preferences.Language);
    }

    private Task ToggleThemeAsync() => Preferences.ToggleThemeAsync(lifetimeCancellation.Token);
    private void OnPreferencesChanged() => _ = InvokeAsync(StateHasChanged);

    private string? CurrentWorkspace
    {
        get
        {
            var segments = Navigation.ToBaseRelativePath(Navigation.Uri).Split('/', StringSplitOptions.RemoveEmptyEntries);
            return segments.Length >= 2 && string.Equals(segments[0], "w", StringComparison.Ordinal)
                ? Uri.UnescapeDataString(segments[1])
                : null;
        }
    }
    private string HomeUrl => CurrentWorkspace is null ? "/" : $"/w/{Uri.EscapeDataString(CurrentWorkspace)}";
    private string TasksUrl => CurrentWorkspace is null ? "/" : $"/w/{Uri.EscapeDataString(CurrentWorkspace)}/tasks";
    private string NotificationsUrl => CurrentWorkspace is null ? "/" : $"/w/{Uri.EscapeDataString(CurrentWorkspace)}/notifications";
    private string T(string key) => Localizer[key];
    private string F(string key, params object[] arguments) => Localizer[key, arguments];

    public async ValueTask DisposeAsync()
    {
        Preferences.Changed -= OnPreferencesChanged;
        lifetimeCancellation.Cancel();
        lifetimeCancellation.Dispose();
        if (themeModule is not null)
        {
            try { await themeModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
