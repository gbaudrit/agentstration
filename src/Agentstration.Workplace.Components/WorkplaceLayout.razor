@inherits LayoutComponentBase
@inject NavigationManager Navigation
<div class="app-shell theme-light workplace-shell">
    <aside class="sidebar" aria-label="Workplace navigation">
        <a class="brand-lockup" href="@HomeUrl" aria-label="Agentstration Workplace home"><span class="brand-mark"><img src="_content/Agentstration.Web.Components/images/agentstration-mark.png" alt="" /></span><span><strong>Agentstration</strong><small>Workplace</small></span></a>
        <nav class="side-nav"><NavLink href="@HomeUrl"><UiIcon Name="home" /><span class="nav-label">Home</span></NavLink><NavLink href="@TasksUrl"><UiIcon Name="tasks" /><span class="nav-label">Tasks</span></NavLink><NavLink href="@NotificationsUrl"><UiIcon Name="notifications" /><span class="nav-label">Notifications</span></NavLink></nav>
        <div class="sidebar-footer"><strong>@(CurrentWorkspace ?? "Workplace")</strong><small>Local mode</small></div>
    </aside>
    <div class="workspace">
        <header class="mobile-appbar">
            <a class="mobile-brand" href="@HomeUrl" aria-label="Agentstration Workplace home"><img src="_content/Agentstration.Web.Components/images/agentstration-mark.png" alt="" /><span><small>Agentstration</small><strong>Workplace</strong></span></a>
            <a class="mobile-notifications" href="@NotificationsUrl" aria-label="Open notifications"><UiIcon Name="notifications" /></a>
        </header>
        <header class="topbar"><div class="topbar-start"><nav class="breadcrumb"><a href="@HomeUrl">@((CurrentWorkspace ?? "My") + " Workplace")</a></nav></div><div class="topbar-actions"><span class="environment-chip">LOCAL</span><a class="icon-button" href="@NotificationsUrl" aria-label="Open notifications"><UiIcon Name="notifications" /></a></div></header><main class="content">@Body</main>
    </div>
</div>

@code {
    private string? CurrentWorkspace
    {
        get
        {
            var segments = Navigation.ToBaseRelativePath(Navigation.Uri).Split('/', StringSplitOptions.RemoveEmptyEntries);
            return segments.Length >= 2 && string.Equals(segments[0], "w", StringComparison.Ordinal)
                ? Uri.UnescapeDataString(segments[1])
                : null;
        }
    }
    private string HomeUrl => CurrentWorkspace is null ? "/" : $"/w/{Uri.EscapeDataString(CurrentWorkspace)}";
    private string TasksUrl => CurrentWorkspace is null ? "/" : $"/w/{Uri.EscapeDataString(CurrentWorkspace)}/tasks";
    private string NotificationsUrl => CurrentWorkspace is null ? "/" : $"/w/{Uri.EscapeDataString(CurrentWorkspace)}/notifications";
}
