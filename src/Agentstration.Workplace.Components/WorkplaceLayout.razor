@inherits LayoutComponentBase
@implements IAsyncDisposable
@using Agentstration.Web.Components.Localization
@inject NavigationManager Navigation
@inject UserPreferencesState Preferences
@inject WorkplaceContextState WorkplaceContext
@inject IRecentConversationNavigationProvider RecentConversationNavigation
@inject IJSRuntime JS
<div class="app-shell @(Preferences.IsDarkTheme ? "theme-dark" : "theme-light") workplace-shell">
    <aside class="sidebar" aria-label="@T("WorkplaceNavigation")">
        <a class="brand-lockup workplace-brand-lockup" href="@HomeUrl" aria-label="@T("WorkplaceHome")">
            <img class="brand-lockup-logo" src="_content/Agentstration.Web.Components/images/agentstration-workplace-lockup-dark.png" alt="" />
        </a>
        <nav class="side-nav">
            <section class="navigation-group" aria-label="@T("Overview")">
                <NavLink href="@HomeUrl" Match="NavLinkMatch.All">
                    <span class="nav-icon" aria-hidden="true"><UiIcon Name="home" /></span><span class="nav-label">@T("Home")</span>
                </NavLink>
            </section>
            <section class="navigation-group" aria-label="@T("Work")">
                <h2>@T("Work")</h2>
                @if (CurrentWorkspace is null)
                {
                    <a class="side-nav-disabled" aria-disabled="true" tabindex="-1">
                        <span class="nav-icon nav-icon-desktop" aria-hidden="true"><UiIcon Name="tasks" /></span><span class="nav-icon nav-icon-mobile" aria-hidden="true"><UiIcon Name="activity" /></span><span class="nav-label">@T("Activity")</span>
                    </a>
                }
                else
                {
                    <NavLink href="@TasksUrl">
                        <span class="nav-icon nav-icon-desktop" aria-hidden="true"><UiIcon Name="tasks" /></span><span class="nav-icon nav-icon-mobile" aria-hidden="true"><UiIcon Name="activity" /></span><span class="nav-label">@T("Activity")</span>
                    </NavLink>
                }
                @if (recentConversations.Count > 0)
                {
                    <div class="recent-conversation-navigation">
                        <h3>@T("RecentConversations")</h3>
                        @foreach (var conversation in recentConversations)
                        {
                            <NavLink href="@conversation.Url"><span aria-hidden="true"><UiIcon Name="message" /></span><span>@conversation.Title</span></NavLink>
                        }
                    </div>
                }
            </section>
            <span class="mobile-profile" aria-label="@F("ProfileFor", UserDisplayName)" title="@UserDisplayName"><span aria-hidden="true">@UserInitials</span></span>
        </nav>
        <div class="sidebar-footer"><strong>@WorkspaceDisplayName</strong><small>@OrganizationDisplayName</small></div>
    </aside>
    <div class="workspace">
        <header class="mobile-appbar">
            <a class="mobile-brand" href="@HomeUrl" aria-label="@T("WorkplaceHome")">
                <img class="mobile-brand-logo" src="_content/Agentstration.Web.Components/images/agentstration-workplace-lockup-white-transparent.png" alt="" />
            </a>
            <a class="mobile-notifications" href="@NotificationsUrl" aria-label="@T("OpenNotifications")"><UiIcon Name="notifications" /></a>
        </header>
        <header class="topbar"><div class="topbar-start"><nav class="breadcrumb" aria-label="@T("CurrentOrganizationWorkspace")"><span>@OrganizationDisplayName</span><span>/</span><a href="@HomeUrl">@F("NamedWorkplace", WorkspaceDisplayName)</a></nav></div><div class="topbar-actions"><button class="icon-button" @onclick="ToggleThemeAsync" disabled="@Preferences.IsSaving" aria-label="@T("ToggleColorTheme")" title="@(Preferences.Error ?? F("ThemeValue", Preferences.Theme))"><UiIcon Name="@(Preferences.IsDarkTheme ? "theme-light" : "theme-dark")" /></button><a class="icon-button" href="@NotificationsUrl" aria-label="@T("OpenNotifications")"><UiIcon Name="notifications" /></a></div></header><main class="content">@Body</main>
    </div>
</div>

@code {
    private readonly CancellationTokenSource lifetimeCancellation = new();
    private IJSObjectReference? themeModule;
    private IReadOnlyList<RecentConversationNavigationItem> recentConversations = [];

    protected override async Task OnInitializedAsync()
    {
        Preferences.Changed += OnPreferencesChanged;
        WorkplaceContext.Changed += OnWorkplaceContextChanged;
        Navigation.LocationChanged += OnLocationChanged;
        await Preferences.LoadAsync(lifetimeCancellation.Token);
        await LoadRecentConversationsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        themeModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Agentstration.Web.Components/theme-preferences.js");
        Preferences.SetSystemTheme(await themeModule.InvokeAsync<bool>("prefersDarkTheme"));
        CultureNavigation.NavigateToPreferredCulture(Navigation, Preferences.Language);
    }

    private Task ToggleThemeAsync() => Preferences.ToggleThemeAsync(lifetimeCancellation.Token);
    private void OnPreferencesChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnWorkplaceContextChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args) =>
        _ = InvokeAsync(LoadRecentConversationsAsync);

    private async Task LoadRecentConversationsAsync()
    {
        var workspaceName = CurrentWorkspace;
        if (workspaceName is null)
        {
            recentConversations = [];
            return;
        }

        try
        {
            recentConversations = await RecentConversationNavigation.ListAsync(
                workspaceName,
                CurrentDashboard,
                lifetimeCancellation.Token);
        }
        catch when (!lifetimeCancellation.IsCancellationRequested)
        {
            recentConversations = [];
        }

        StateHasChanged();
    }

    private string? CurrentWorkspace
    {
        get
        {
            var segments = Navigation.ToBaseRelativePath(Navigation.Uri).Split('/', StringSplitOptions.RemoveEmptyEntries);
            return segments.Length >= 2 && string.Equals(segments[0], "w", StringComparison.Ordinal)
                ? Uri.UnescapeDataString(segments[1])
                : null;
        }
    }
    private string HomeUrl => CurrentWorkspace is null ? "/" : $"/w/{Uri.EscapeDataString(CurrentWorkspace)}";
    private string? CurrentDashboard
    {
        get
        {
            var segments = Navigation.ToBaseRelativePath(Navigation.Uri).Split('/', StringSplitOptions.RemoveEmptyEntries);
            return segments.Length >= 4 && string.Equals(segments[2], "d", StringComparison.Ordinal)
                ? Uri.UnescapeDataString(segments[3])
                : null;
        }
    }
    private string TasksUrl => CurrentWorkspace is null ? "/" : $"/w/{Uri.EscapeDataString(CurrentWorkspace)}/tasks";
    private string NotificationsUrl => CurrentWorkspace is null ? "/" : $"/w/{Uri.EscapeDataString(CurrentWorkspace)}/notifications";
    private string T(string key) => Localizer[key];
    private string F(string key, params object[] arguments) => Localizer[key, arguments];
    private string WorkspaceDisplayName
    {
        get
        {
            var workspaceName = CurrentWorkspace;
            var context = WorkplaceContext.Current;
            if (workspaceName is not null && context is not null
                && string.Equals(context.WorkspaceName, workspaceName, StringComparison.Ordinal))
                return context.WorkspaceDisplayName;

            return workspaceName is { Length: > 0 }
                ? char.ToUpperInvariant(workspaceName[0]) + workspaceName[1..].Replace('-', ' ')
                : T("My");
        }
    }
    private string OrganizationDisplayName => WorkplaceContext.Current?.OrganizationDisplayName is { Length: > 0 } displayName
        ? displayName
        : T("Organization");
    private string UserDisplayName => WorkplaceContext.Current?.UserDisplayName is { Length: > 0 } displayName
        ? displayName
        : T("User");
    private string UserInitials => string.Concat(UserDisplayName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(part => char.ToUpperInvariant(part[0])));

    public async ValueTask DisposeAsync()
    {
        Preferences.Changed -= OnPreferencesChanged;
        WorkplaceContext.Changed -= OnWorkplaceContextChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        lifetimeCancellation.Cancel();
        lifetimeCancellation.Dispose();
        if (themeModule is not null)
        {
            try { await themeModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
