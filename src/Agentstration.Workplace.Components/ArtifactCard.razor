<article class="artifact-card">
    <CollectionIdentity DisplayName="@Artifact.Name" Name="@Artifact.Id.ToString()" Href="@ContentUrl" IconName="document" ><IconBadges><ResourceScopeBadge ScopeRef="@Agentstration.Resources.ResourceScopeRef.Workspace(Artifact.WorkspaceId.Value)" IconOnly /></IconBadges></CollectionIdentity>
    <small>@Localizer["Version", Artifact.Sequence] · @Artifact.CreatedAt.LocalDateTime.ToString("g") · @FormatType(Artifact.ContentType) · @FormatSize(Artifact.Length)</small>
    <CollectionActions ResourceName="@Artifact.Name"><a class="artifact-download" href="@ContentUrl" download aria-label="@Localizer["DownloadArtifact", Artifact.Name]"><UiIcon Name="download" /><span>@Localizer["Download"]</span></a></CollectionActions>
</article>

@code {
    [Parameter, EditorRequired] public required WorkTaskArtifact Artifact { get; set; }
    [Parameter, EditorRequired] public required string ContentUrl { get; set; }
    private string FormatType(string value) => value switch { "text/markdown" => "Markdown", "application/pdf" => "PDF", "text/plain" => Localizer["Text"], _ => value };
    private static string FormatSize(long bytes) => bytes < 1024 ? $"{bytes} B" : bytes < 1024 * 1024 ? $"{bytes / 1024d:0.#} KB" : $"{bytes / 1024d / 1024d:0.#} MB";
}
