<section class="primary-entry-container" aria-labelledby="primary-entry-heading">
    <div class="primary-entry-copy">
        <span class="primary-entry-mark"><UiIcon Name="sparkle" /></span>
        <div>
            <p class="eyebrow">Start here</p>
            <h2 id="primary-entry-heading"><span class="primary-title-desktop">@Title</span><span class="primary-title-mobile">@MobileTitle</span></h2>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p>@Description</p>
            }
        </div>
    </div>
    <div class="primary-entry-content" aria-busy="@Busy">@ChildContent</div>
</section>

@code {
    [Parameter] public string Title { get; set; } = "What would you like to accomplish?";
    [Parameter] public string MobileTitle { get; set; } = "What would you like to do?";
    [Parameter] public string? Description { get; set; } = "Describe the outcome. Agentstration will ask only for the details it needs.";
    [Parameter] public bool Busy { get; set; }
    [Parameter, EditorRequired] public required RenderFragment ChildContent { get; set; }
}
