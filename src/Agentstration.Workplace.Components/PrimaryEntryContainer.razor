<section class="primary-entry-container" aria-labelledby="primary-entry-heading">
    <div class="primary-entry-visual" aria-hidden="true">
        <span class="orbit orbit-outer"></span>
        <span class="orbit orbit-inner"></span>
        <span class="orbit-node node-one"></span>
        <span class="orbit-node node-two"></span>
        <img src="_content/Agentstration.Web.Components/images/agentstration-mark.png" alt="" />
    </div>
    <div class="primary-entry-copy">
        <span class="primary-entry-mark"><UiIcon Name="sparkle" /></span>
        <div>
            <p class="eyebrow">@Localizer["StartHere"]</p>
            <h2 id="primary-entry-heading"><span class="primary-title-desktop">@EffectiveTitle</span><span class="primary-title-mobile">@EffectiveMobileTitle</span></h2>
            @if (!string.IsNullOrWhiteSpace(EffectiveDescription))
            {
                <p>@EffectiveDescription</p>
            }
        </div>
    </div>
    <div class="primary-entry-content" aria-busy="@Busy">@ChildContent</div>
</section>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? MobileTitle { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter, EditorRequired] public required RenderFragment ChildContent { get; set; }
    private string EffectiveTitle => Title ?? Localizer["PrimaryTitle"];
    private string EffectiveMobileTitle => MobileTitle ?? Localizer["PrimaryMobileTitle"];
    private string EffectiveDescription => Description ?? Localizer["PrimaryDescription"];
}
