<article class="timeline-activity activity-@Activity.Type.ToString().ToLowerInvariant()">
    @if (ShowMarker) { <span class="activity-marker"><UiIcon Name="@Icon" /></span> }
    <div>
        <div class="activity-heading">
            <strong>@Title</strong>
            <time datetime="@Activity.CreatedAt.ToString("O")">@Activity.CreatedAt.ToLocalTime().ToString("HH:mm")</time>
        </div>
        @if (!string.IsNullOrWhiteSpace(Activity.Description)) { <p>@Activity.Description</p> }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public required WorkTaskActivity Activity { get; set; }
    [Parameter] public EntryParticipantVisibility ParticipantVisibility { get; set; } = EntryParticipantVisibility.Hidden;
    private bool ShowMarker => Activity.Type is not (WorkTaskActivityType.TaskStarted or WorkTaskActivityType.ProgressStarted);
    private string Title
    {
        get
        {
            if (ParticipantVisibility == EntryParticipantVisibility.Visible
                && Activity.Metadata?.GetValueOrDefault("participantId") is { Length: > 0 } participant)
            {
                return Activity.Type switch
                {
                    WorkTaskActivityType.ProgressStarted => Localizer["ParticipantPreparing", Humanize(participant)],
                    WorkTaskActivityType.ProgressCompleted => Localizer["ParticipantResponded", Humanize(participant)],
                    _ => WorkplaceActivityTitles.Get(Localizer, Activity)
                };
            }

            return WorkplaceActivityTitles.Get(Localizer, Activity);
        }
    }
    private string Icon => Activity.Type switch
    {
        WorkTaskActivityType.TaskFailed => "warning",
        WorkTaskActivityType.ActionRequired => "info",
        _ => "check"
    };
    private static string Humanize(string value) => System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(value.Replace('-', ' ').Replace('_', ' '));
}
