# Copy to the ignored .env.foundry file and supply values only on your machine.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_INFERENCE_ENDPOINT=
FOUNDRY_AUTHENTICATION_MODE=ApiKeyEnvironment
FOUNDRY_API_KEY=
# Required for ApiKeyBinding in Compose: trusted HTTPS URL of the Agentstration host,
# reachable from foundry-extension. Keep the callback on a restricted network path.
AEP_SECRET_ACCESS_PUBLIC_BASE_URL=
# Set only for a configured private endpoint DNS host.
FOUNDRY_ALLOWED_PRIVATE_HOSTS=
